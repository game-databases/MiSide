{"category": "LocationDialogue Location3", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 1, "text": "Bună, [player]!"}
{"category": "LocationDialogue Location3", "line_index": 2, "text": "Ne întâlnim în final!"}
{"category": "LocationDialogue Location3", "line_index": 3, "text": "Sunt atât de bucuroasă!"}
{"category": "LocationDialogue Location3", "line_index": 4, "text": "Știu că ai întrebări..."}
{"category": "LocationDialogue Location3", "line_index": 5, "text": "Deci, după cum poți vedea,"}
{"category": "LocationDialogue Location3", "line_index": 6, "text": "Am făcut acest dispozitiv special"}
{"category": "LocationDialogue Location3", "line_index": 7, "text": "pentru a te aduce aici alături de mine."}
{"category": "LocationDialogue Location3", "line_index": 8, "text": "Dar ai ajuns într-o altă versiune a jocului..."}
{"category": "LocationDialogue Location3", "line_index": 9, "text": "În care eu..."}
{"category": "LocationDialogue Location3", "line_index": 10, "text": "Dar asta e o poveste lungă!"}
{"category": "LocationDialogue Location3", "line_index": 11, "text": "Oricum, sunt fericită să te văd!"}
{"category": "LocationDialogue Location3", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 13, "text": "// Answer 1 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 14, "text": "Eu sunt."}
{"category": "LocationDialogue Location3", "line_index": 15, "text": "Și tu trebuie să fii [player], nu?"}
{"category": "LocationDialogue Location3", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 17, "text": "// Answer 2 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 18, "text": "Să te întorci deja?"}
{"category": "LocationDialogue Location3", "line_index": 19, "text": "Cred că te-aș putea ajuta cu asta... Dar cum rămâne cu mine?"}
{"category": "LocationDialogue Location3", "line_index": 20, "text": "Te rog, rămâi cu mine pentru o vreme..."}
{"category": "LocationDialogue Location3", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 22, "text": "// Answer 3 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 23, "text": "Lăsa-mă să-ți explic..."}
{"category": "LocationDialogue Location3", "line_index": 24, "text": "Și iată-te!"}
{"category": "LocationDialogue Location3", "line_index": 25, "text": "Ai înțeles?"}
{"category": "LocationDialogue Location3", "line_index": 26, "text": "Uhm... nu chiar."}
{"category": "LocationDialogue Location3", "line_index": 27, "text": "E în regulă!"}
{"category": "LocationDialogue Location3", "line_index": 28, "text": "Ce e important e că acum suntem împreună."}
{"category": "LocationDialogue Location3", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 31, "text": "Ți-e foame?"}
{"category": "LocationDialogue Location3", "line_index": 32, "text": "Ce-ar fi să gătim ceva?"}
{"category": "LocationDialogue Location3", "line_index": 33, "text": "Aici,"}
{"category": "LocationDialogue Location3", "line_index": 34, "text": "ajută-mă cu morcovii ăștia."}
{"category": "LocationDialogue Location3", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 36, "text": "De unde au venit legumele?"}
{"category": "LocationDialogue Location3", "line_index": 37, "text": "Nu erau aici mai devreme."}
{"category": "LocationDialogue Location3", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 39, "text": "[player], suntem într-un joc."}
{"category": "LocationDialogue Location3", "line_index": 40, "text": "Haide, dă-mi o mână de ajutor."}
{"category": "LocationDialogue Location3", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 42, "text": "Mulțumesc!"}
{"category": "LocationDialogue Location3", "line_index": 43, "text": "Poți să iei foarfeca?"}
{"category": "LocationDialogue Location3", "line_index": 44, "text": "E în baie."}
{"category": "LocationDialogue Location3", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 46, "text": "Acum, ia un loc."}
{"category": "LocationDialogue Location3", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 49, "text": "// Kitchen"}
{"category": "LocationDialogue Location3", "line_index": 50, "text": "Vrei niște sos?"}
{"category": "LocationDialogue Location3", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 52, "text": "Nu, mulțumesc."}
{"category": "LocationDialogue Location3", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 54, "text": "Păcat."}
{"category": "LocationDialogue Location3", "line_index": 55, "text": "Sosul sporește cu adevărat gustul!"}
{"category": "LocationDialogue Location3", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 58, "text": "Mulțumesc."}
{"category": "LocationDialogue Location3", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 60, "text": "Ai terminat-o deja pe toată?"}
{"category": "LocationDialogue Location3", "line_index": 61, "text": "Huh, porția mea pare"}
{"category": "LocationDialogue Location3", "line_index": 62, "text": "nesfârșită..."}
{"category": "LocationDialogue Location3", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 65, "text": "// Help"}
{"category": "LocationDialogue Location3", "line_index": 66, "text": "Ce este în neregulă?"}
{"category": "LocationDialogue Location3", "line_index": 67, "text": "Spune-mi ce vezi și ce simți."}
{"category": "LocationDialogue Location3", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 69, "text": "Inima îmi bate tare,"}
{"category": "LocationDialogue Location3", "line_index": 70, "text": "și vederea mi se încețoșează."}
{"category": "LocationDialogue Location3", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 72, "text": "Ok."}
{"category": "LocationDialogue Location3", "line_index": 73, "text": "Cred că știu ce e în neregulă."}
{"category": "LocationDialogue Location3", "line_index": 74, "text": "Poți să te ridici?"}
{"category": "LocationDialogue Location3", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 78, "text": "Ce sunt astea?"}
{"category": "LocationDialogue Location3", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 80, "text": "Pastile."}
{"category": "LocationDialogue Location3", "line_index": 81, "text": "Te vor face să te simți mai bine în curând."}
{"category": "LocationDialogue Location3", "line_index": 82, "text": "Du-te la oglindă."}
{"category": "LocationDialogue Location3", "line_index": 83, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 84, "text": "Ia pastilele."}
{"category": "LocationDialogue Location3", "line_index": 85, "text": "Haide, acum."}
{"category": "LocationDialogue Location3", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 89, "text": "Cum te simți?"}
{"category": "LocationDialogue Location3", "line_index": 90, "text": "Mai bine?"}
{"category": "LocationDialogue Location3", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 92, "text": "Da."}
{"category": "LocationDialogue Location3", "line_index": 93, "text": "Au funcționat repede..."}
{"category": "LocationDialogue Location3", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 95, "text": "[player], suntem într-un joc."}
{"category": "LocationDialogue Location3", "line_index": 96, "text": "Lucrurile sunt mult mai simple aici."}
{"category": "LocationDialogue Location3", "line_index": 97, "text": "Chiar și cel mai mic efort"}
{"category": "LocationDialogue Location3", "line_index": 98, "text": "dă rezultate mari."}
{"category": "LocationDialogue Location3", "line_index": 99, "text": "Totul face parte din conceptul jocului:"}
{"category": "LocationDialogue Location3", "line_index": 100, "text": "Simplificarea."}
{"category": "LocationDialogue Location3", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 102, "text": "Un exemplu, te rog?"}
{"category": "LocationDialogue Location3", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 104, "text": "Ei bine, ia morcovii."}
{"category": "LocationDialogue Location3", "line_index": 105, "text": "Tu tai unul,"}
{"category": "LocationDialogue Location3", "line_index": 106, "text": "dar e ca și cum ai tăia trei."}
{"category": "LocationDialogue Location3", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 108, "text": "Uite, totul este foarte brusc."}
{"category": "LocationDialogue Location3", "line_index": 109, "text": "Sunt speriat, mai mult decât un pic."}
{"category": "LocationDialogue Location3", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 112, "text": "Ce s-a întâmplat?"}
{"category": "LocationDialogue Location3", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 114, "text": "Am găsit cartușe în gura de aerisire."}
{"category": "LocationDialogue Location3", "line_index": 115, "text": "Aveau nume pe ele."}
{"category": "LocationDialogue Location3", "line_index": 116, "text": "Care-i treaba cu asta?"}
{"category": "LocationDialogue Location3", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 118, "text": "Cartușe?"}
{"category": "LocationDialogue Location3", "line_index": 119, "text": "Ce cartușe?"}
{"category": "LocationDialogue Location3", "line_index": 120, "text": "Hai să aflăm asta împreună."}
{"category": "LocationDialogue Location3", "line_index": 121, "text": "Dar mai târziu."}
{"category": "LocationDialogue Location3", "line_index": 122, "text": "Chiar acum, trebuie să mâncăm."}
{"category": "LocationDialogue Location3", "line_index": 123, "text": "Dă-mi foarfeca, te rog."}
{"category": "LocationDialogue Location3", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 125, "text": "// Ring"}
{"category": "LocationDialogue Location3", "line_index": 126, "text": "Un inel?"}
{"category": "LocationDialogue Location3", "line_index": 127, "text": "// Mirror"}
{"category": "LocationDialogue Location3", "line_index": 128, "text": "Cum se face că nu există nicio reflexie?"}
{"category": "LocationDialogue Location3", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 130, "text": "A, da!"}
{"category": "LocationDialogue Location3", "line_index": 131, "text": "Am uitat să activez reflexiile."}
{"category": "LocationDialogue Location3", "line_index": 132, "text": "Așa."}
{"category": "LocationDialogue Location3", "line_index": 133, "text": "Reflexiile s-au întors!"}
{"category": "LocationDialogue Location3", "line_index": 134, "text": "Apropo,"}
{"category": "LocationDialogue Location3", "line_index": 135, "text": "sincer, nici nu știam ce sunt reflexiile înainte."}
{"category": "LocationDialogue Location3", "line_index": 136, "text": "Ele nu existau în lumea mea-"}
{"category": "LocationDialogue Location3", "line_index": 137, "text": "nu până la o actualizare, adică. :)"}
{"category": "LocationDialogue Location3", "line_index": 138, "text": "Există o mulțime de reflexii"}
{"category": "LocationDialogue Location3", "line_index": 139, "text": "în lumea ta?"}
{"category": "LocationDialogue Location3", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 141, "text": "Ei bine, da."}
{"category": "LocationDialogue Location3", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 144, "text": "Îți amintești"}
{"category": "LocationDialogue Location3", "line_index": 145, "text": "cele trei obiecte pe care le-ai găsit?"}
{"category": "LocationDialogue Location3", "line_index": 146, "text": "Cele pe care le-ai pus pe scanner?"}
{"category": "LocationDialogue Location3", "line_index": 147, "text": "Ei bine, um..."}
{"category": "LocationDialogue Location3", "line_index": 148, "text": "Aceste obiecte"}
{"category": "LocationDialogue Location3", "line_index": 149, "text": "sunt legate de această versiune a lumii."}
{"category": "LocationDialogue Location3", "line_index": 150, "text": "De aceea ești aici acum."}
{"category": "LocationDialogue Location3", "line_index": 151, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 152, "text": "// Movbile TV"}
{"category": "LocationDialogue Location3", "line_index": 153, "text": "Acesta este televizorul portabil"}
{"category": "LocationDialogue Location3", "line_index": 154, "text": "pe care ți l-am cumpărat."}
{"category": "LocationDialogue Location3", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 156, "text": "Dap!"}
{"category": "LocationDialogue Location3", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 158, "text": "Mi-ai spus"}
{"category": "LocationDialogue Location3", "line_index": 159, "text": "că era stricat."}
{"category": "LocationDialogue Location3", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 161, "text": "Ei bine, am vrut să"}
{"category": "LocationDialogue Location3", "line_index": 162, "text": "să te surprind!"}
{"category": "LocationDialogue Location3", "line_index": 163, "text": "Am spus o mică minciună albă"}
{"category": "LocationDialogue Location3", "line_index": 164, "text": "ca să te aduc aici, în lumea mea."}
{"category": "LocationDialogue Location3", "line_index": 165, "text": "Acum funcționează - afișează informații!"}
{"category": "LocationDialogue Location3", "line_index": 166, "text": "Oh, și apropo..."}
{"category": "LocationDialogue Location3", "line_index": 167, "text": "Sunt un mic inginer!"}
{"category": "LocationDialogue Location3", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 169, "text": "// School cloth"}
{"category": "LocationDialogue Location3", "line_index": 170, "text": "Ce este asta?"}
{"category": "LocationDialogue Location3", "line_index": 171, "text": "O uniformă?"}
{"category": "LocationDialogue Location3", "line_index": 172, "text": "De ce ai avea nevoie de asta?"}
{"category": "LocationDialogue Location3", "line_index": 173, "text": "Tu chiar mergi la școală?"}
{"category": "LocationDialogue Location3", "line_index": 174, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 175, "text": "Să merg la școală?"}
{"category": "LocationDialogue Location3", "line_index": 176, "text": "Nu merg deloc."}
{"category": "LocationDialogue Location3", "line_index": 177, "text": "Dar îmi place uniforma"}
{"category": "LocationDialogue Location3", "line_index": 178, "text": "Nu crezi că arăt drăguță"}
{"category": "LocationDialogue Location3", "line_index": 179, "text": "în ea?"}
{"category": "LocationDialogue Location3", "line_index": 180, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 181, "text": "// PC"}
{"category": "LocationDialogue Location3", "line_index": 182, "text": "Computerul funcționează?"}
{"category": "LocationDialogue Location3", "line_index": 183, "text": "Sau este doar o decorațiune de birou?"}
{"category": "LocationDialogue Location3", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 185, "text": "Bineînțeles că funcționează."}
{"category": "LocationDialogue Location3", "line_index": 186, "text": "Totul aici"}
{"category": "LocationDialogue Location3", "line_index": 187, "text": "funcționează exact ca în lumea ta."}
{"category": "LocationDialogue Location3", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 189, "text": "Înapoi în lumea mea,"}
{"category": "LocationDialogue Location3", "line_index": 190, "text": "stau mult la calculator..."}
{"category": "LocationDialogue Location3", "line_index": 191, "text": "Și muncesc din greu."}
{"category": "LocationDialogue Location3", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 193, "text": "Da, știu."}
{"category": "LocationDialogue Location3", "line_index": 194, "text": "Din cauza slujbei tale"}
{"category": "LocationDialogue Location3", "line_index": 195, "text": "mi-ai acordat"}
{"category": "LocationDialogue Location3", "line_index": 196, "text": "atât de puțină atenție."}
{"category": "LocationDialogue Location3", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 198, "text": "Trebuie să-mi câștig existența, știi tu."}
{"category": "LocationDialogue Location3", "line_index": 199, "text": "Deși... de unde știi că stau mult la calculator?"}
{"category": "LocationDialogue Location3", "line_index": 200, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 201, "text": "Camera telefonului tău... e pornită uneori."}
{"category": "LocationDialogue Location3", "line_index": 202, "text": "Îmi pare rău."}
{"category": "LocationDialogue Location3", "line_index": 203, "text": "Te-am urmărit în secret >A<"}
{"category": "LocationDialogue Location3", "line_index": 204, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 205, "text": "Uhm... asta nu e chiar adecvat."}
{"category": "LocationDialogue Location3", "line_index": 206, "text": "Dar nu contează."}
{"category": "LocationDialogue Location3", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 208, "text": "// Umbrella"}
{"category": "LocationDialogue Location3", "line_index": 209, "text": "Am jucat o grămadă"}
{"category": "LocationDialogue Location3", "line_index": 210, "text": "dar nu am văzut niciodată să plouă aici."}
{"category": "LocationDialogue Location3", "line_index": 211, "text": "De ce să ai o umbrelă?"}
{"category": "LocationDialogue Location3", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 213, "text": "Plouă doar foarte rar."}
{"category": "LocationDialogue Location3", "line_index": 214, "text": "Doar că nu ai văzut-o încă."}
{"category": "LocationDialogue Location3", "line_index": 215, "text": "Poate că într-o zi o vei face."}
{"category": "LocationDialogue Location3", "line_index": 216, "text": "Și atunci vei avea nevoie de o umbrelă."}
{"category": "LocationDialogue Location3", "line_index": 217, "text": "Nu crezi?"}
{"category": "LocationDialogue Location3", "line_index": 218, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 219, "text": "// Electrical panel"}
{"category": "LocationDialogue Location3", "line_index": 220, "text": "De ce este un panou electric aici?"}
{"category": "LocationDialogue Location3", "line_index": 221, "text": "Și dacă suntem într-un joc,"}
{"category": "LocationDialogue Location3", "line_index": 222, "text": "ce scop are?"}
{"category": "LocationDialogue Location3", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 224, "text": "În primul rând,"}
{"category": "LocationDialogue Location3", "line_index": 225, "text": "suntem într-un joc."}
{"category": "LocationDialogue Location3", "line_index": 226, "text": "Așa că întrebarea „De ce” este..."}
{"category": "LocationDialogue Location3", "line_index": 227, "text": "fără rost."}
{"category": "LocationDialogue Location3", "line_index": 228, "text": "Cu toate acestea,"}
{"category": "LocationDialogue Location3", "line_index": 229, "text": "el repornește electricitatea."}
{"category": "LocationDialogue Location3", "line_index": 230, "text": "Totul aici este făcut pe baza"}
{"category": "LocationDialogue Location3", "line_index": 231, "text": "pe lumea ta."}
{"category": "LocationDialogue Location3", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 233, "text": "// Exit door"}
{"category": "LocationDialogue Location3", "line_index": 234, "text": "Putem merge afară?"}
{"category": "LocationDialogue Location3", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 236, "text": "Păi..."}
{"category": "LocationDialogue Location3", "line_index": 237, "text": "Nu încă."}
{"category": "LocationDialogue Location3", "line_index": 238, "text": "Poate mai târziu."}
{"category": "LocationDialogue Location3", "line_index": 239, "text": "Să stăm aici deocamdată."}
{"category": "LocationDialogue Location3", "line_index": 240, "text": "Aici, acasă."}
{"category": "LocationDialogue Location3", "line_index": 241, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 242, "text": "// Books"}
{"category": "LocationDialogue Location3", "line_index": 243, "text": "Ai o mulțime de cărți aici."}
{"category": "LocationDialogue Location3", "line_index": 244, "text": "Le-ai citit pe toate?"}
{"category": "LocationDialogue Location3", "line_index": 245, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 246, "text": "Da, pe fiecare în parte."}
{"category": "LocationDialogue Location3", "line_index": 247, "text": "Să fii aici singur"}
{"category": "LocationDialogue Location3", "line_index": 248, "text": "este foarte, foarte plictisitor."}
{"category": "LocationDialogue Location3", "line_index": 249, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 250, "text": "// TV in room kitchen"}
{"category": "LocationDialogue Location3", "line_index": 251, "text": "De ce să cumperi un al doilea televizor?"}
{"category": "LocationDialogue Location3", "line_index": 252, "text": "Și pe lângă asta unul vechi?"}
{"category": "LocationDialogue Location3", "line_index": 253, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 254, "text": "Nu-ți place?"}
{"category": "LocationDialogue Location3", "line_index": 255, "text": "Îl pot lua..."}
{"category": "LocationDialogue Location3", "line_index": 256, "text": "Dar ca să răspund..."}
{"category": "LocationDialogue Location3", "line_index": 257, "text": "E pentru decor,"}
{"category": "LocationDialogue Location3", "line_index": 258, "text": "pentru a lumina bucătăria."}
{"category": "LocationDialogue Location3", "line_index": 259, "text": "Dar și funcționează!"}
{"category": "LocationDialogue Location3", "line_index": 260, "text": "Mă pot uita la toate"}
{"category": "LocationDialogue Location3", "line_index": 261, "text": "emisiunile clasice!"}
{"category": "LocationDialogue Location3", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 263, "text": "// Smartphone"}
{"category": "LocationDialogue Location3", "line_index": 264, "text": "Ăsta e telefonul meu."}
{"category": "LocationDialogue Location3", "line_index": 265, "text": "Și nu mai este în buzunarul meu."}
{"category": "LocationDialogue Location3", "line_index": 266, "text": "Cum naiba a ajuns aici?"}
{"category": "LocationDialogue Location3", "line_index": 267, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 268, "text": "Uhm, asta nu e important."}
{"category": "LocationDialogue Location3", "line_index": 269, "text": "Hei, am o idee!"}
{"category": "LocationDialogue Location3", "line_index": 270, "text": "Hai să facem o poză!"}
{"category": "LocationDialogue Location3", "line_index": 271, "text": "Uite!"}
{"category": "LocationDialogue Location3", "line_index": 272, "text": "E o poză grozavă!"}
{"category": "LocationDialogue Location3", "line_index": 273, "text": "O amintire pentru tine."}
{"category": "LocationDialogue Location3", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 275, "text": "Am o întrebare."}
{"category": "LocationDialogue Location3", "line_index": 276, "text": "Dacă"}
{"category": "LocationDialogue Location3", "line_index": 277, "text": "intru pe un joc pe el,"}
{"category": "LocationDialogue Location3", "line_index": 278, "text": "te voi vedea acolo?"}
{"category": "LocationDialogue Location3", "line_index": 279, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 280, "text": "Nu, nu funcționează așa."}
{"category": "LocationDialogue Location3", "line_index": 281, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 282, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 283, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 284, "text": "// TV"}
{"category": "LocationDialogue Location3", "line_index": 285, "text": "Hmm,"}
{"category": "LocationDialogue Location3", "line_index": 286, "text": "Câte canale ai?"}
{"category": "LocationDialogue Location3", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 288, "text": "Nu funcționează așa."}
{"category": "LocationDialogue Location3", "line_index": 289, "text": "Este conectat la internet."}
{"category": "LocationDialogue Location3", "line_index": 290, "text": "Deci te poți uita la orice,"}
{"category": "LocationDialogue Location3", "line_index": 291, "text": "cel puțin tot ce este disponibil pe web."}
{"category": "LocationDialogue Location3", "line_index": 292, "text": "Așteaptă puțin."}
{"category": "LocationDialogue Location3", "line_index": 293, "text": "Ah, ups."}
{"category": "LocationDialogue Location3", "line_index": 294, "text": "Ce este asta?"}
{"category": "LocationDialogue Location3", "line_index": 295, "text": "Un cerc de pisicuțe?"}
{"category": "LocationDialogue Location3", "line_index": 296, "text": "Oh, uite."}
{"category": "LocationDialogue Location3", "line_index": 297, "text": "Știi ce?"}
{"category": "LocationDialogue Location3", "line_index": 298, "text": "Pauză!"}
{"category": "LocationDialogue Location3", "line_index": 299, "text": "Vrei niște suc?"}
{"category": "LocationDialogue Location3", "line_index": 300, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 301, "text": "Ce reclame ciudate..."}
{"category": "LocationDialogue Location3", "line_index": 302, "text": "Suc mort?"}
{"category": "LocationDialogue Location3", "line_index": 303, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 304, "text": "Da, și acest suc"}
{"category": "LocationDialogue Location3", "line_index": 305, "text": "este direct din reclama la suc."}
{"category": "LocationDialogue Location3", "line_index": 306, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 308, "text": "Ah, gustul..."}
{"category": "LocationDialogue Location3", "line_index": 309, "text": "Îmi place,"}
{"category": "LocationDialogue Location3", "line_index": 310, "text": "și totuși, nu pot spune ce gust are."}
{"category": "LocationDialogue Location3", "line_index": 311, "text": "Totul mă face atât de confuz."}
{"category": "LocationDialogue Location3", "line_index": 312, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 313, "text": "Da."}
{"category": "LocationDialogue Location3", "line_index": 314, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 315, "text": "// Mita shy"}
{"category": "LocationDialogue Location3", "line_index": 316, "text": "Ce faci?"}
{"category": "LocationDialogue Location3", "line_index": 317, "text": "Nu te holba, te rog."}
{"category": "LocationDialogue Location3", "line_index": 318, "text": "Mă faci să mă simt jenată."}
{"category": "LocationDialogue Location3", "line_index": 319, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 320, "text": "// The statuette"}
{"category": "LocationDialogue Location3", "line_index": 321, "text": "E o figurină înfiorătoare."}
{"category": "LocationDialogue Location3", "line_index": 322, "text": "Îți plac"}
{"category": "LocationDialogue Location3", "line_index": 323, "text": "astfel de lucruri?"}
{"category": "LocationDialogue Location3", "line_index": 324, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 325, "text": "Ți se pare înfricoșătoare?"}
{"category": "LocationDialogue Location3", "line_index": 326, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 327, "text": "Da, mi se pare."}
{"category": "LocationDialogue Location3", "line_index": 328, "text": "Aproape că pare blestemată..."}
{"category": "LocationDialogue Location3", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 330, "text": "Nu, sigur nu e blestemată."}
{"category": "LocationDialogue Location3", "line_index": 331, "text": "Și nici înfiorătoare."}
{"category": "LocationDialogue Location3", "line_index": 332, "text": "Mi se pare mai degrabă drăguță!"}
{"category": "LocationDialogue Location3", "line_index": 333, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 334, "text": "Poate că ai dreptate..."}
{"category": "LocationDialogue Location3", "line_index": 335, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 336, "text": "Mita?"}
{"category": "LocationDialogue Location3", "line_index": 337, "text": "Ce se intampla?"}
{"category": "LocationDialogue Location3", "line_index": 338, "text": "// Mita kitchen"}
{"category": "LocationDialogue Location3", "line_index": 339, "text": "Ce zici de o discuție"}
{"category": "LocationDialogue Location3", "line_index": 340, "text": "înainte să ne apucăm să mâncăm?"}
{"category": "LocationDialogue Location3", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 342, "text": "// Start Eat"}
{"category": "LocationDialogue Location3", "line_index": 343, "text": "Bon appétit."}
{"category": "LocationDialogue Location3", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 345, "text": "// Quest 1"}
{"category": "LocationDialogue Location3", "line_index": 346, "text": "Este, nu-i așa?"}
{"category": "LocationDialogue Location3", "line_index": 347, "text": "Poți să rămâi."}
{"category": "LocationDialogue Location3", "line_index": 348, "text": "Nu mă deranjează deloc."}
{"category": "LocationDialogue Location3", "line_index": 349, "text": "De fapt, eu sunt"}
{"category": "LocationDialogue Location3", "line_index": 350, "text": "TOTAL DE ACORD!"}
{"category": "LocationDialogue Location3", "line_index": 351, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 352, "text": "// Quest 2"}
{"category": "LocationDialogue Location3", "line_index": 353, "text": "Vrei să te întorci?"}
{"category": "LocationDialogue Location3", "line_index": 354, "text": "Dar de ce?"}
{"category": "LocationDialogue Location3", "line_index": 355, "text": "E atât de cald aici..."}
{"category": "LocationDialogue Location3", "line_index": 356, "text": "Și confortabil, de asemenea."}
{"category": "LocationDialogue Location3", "line_index": 357, "text": "În plus, eu sunt aici."}
{"category": "LocationDialogue Location3", "line_index": 358, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 359, "text": "Nu, ai înțeles greșit."}
{"category": "LocationDialogue Location3", "line_index": 360, "text": "Mi-ar plăcea să rămân."}
{"category": "LocationDialogue Location3", "line_index": 361, "text": "Sunt doar... îngrijorat."}
{"category": "LocationDialogue Location3", "line_index": 362, "text": "Îngrijorat că am uitat ceva acasă..."}
{"category": "LocationDialogue Location3", "line_index": 363, "text": "Am ajuns aici din senin"}
{"category": "LocationDialogue Location3", "line_index": 364, "text": "și nu am avut timp"}
{"category": "LocationDialogue Location3", "line_index": 365, "text": "să mă pregătesc."}
{"category": "LocationDialogue Location3", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 367, "text": "Oh... îmi pare rău. Nu m-am gândit atât de departe."}
{"category": "LocationDialogue Location3", "line_index": 368, "text": "// Quest 3"}
{"category": "LocationDialogue Location3", "line_index": 369, "text": "Un vis? Deci vrei să evadezi?"}
{"category": "LocationDialogue Location3", "line_index": 370, "text": "Și să uiți că asta s-a întâmplat vreodată?"}
{"category": "LocationDialogue Location3", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 372, "text": "Nu, nu e asta."}
{"category": "LocationDialogue Location3", "line_index": 373, "text": "Locul ăsta pare..."}
{"category": "LocationDialogue Location3", "line_index": 374, "text": "ciudat. Nefiresc."}
{"category": "LocationDialogue Location3", "line_index": 375, "text": "Dar tu..."}
{"category": "LocationDialogue Location3", "line_index": 376, "text": "pari atât de real."}
{"category": "LocationDialogue Location3", "line_index": 377, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 378, "text": "Eu par reală?"}
{"category": "LocationDialogue Location3", "line_index": 379, "text": "Sunt foarte reală,"}
{"category": "LocationDialogue Location3", "line_index": 380, "text": "prostuțule!"}
{"category": "LocationDialogue Location3", "line_index": 381, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 382, "text": "// Quest 4"}
{"category": "LocationDialogue Location3", "line_index": 383, "text": "Pur și simplu așa este"}
{"category": "LocationDialogue Location3", "line_index": 384, "text": "în această lume."}
{"category": "LocationDialogue Location3", "line_index": 385, "text": "S-ar putea să ți se pară ciudat"}
{"category": "LocationDialogue Location3", "line_index": 386, "text": "că nu poți vedea lucrurile"}
{"category": "LocationDialogue Location3", "line_index": 387, "text": "în depărtare."}
{"category": "LocationDialogue Location3", "line_index": 388, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 389, "text": "Mie nu mi s-a părut atât de ciudat."}
{"category": "LocationDialogue Location3", "line_index": 390, "text": "Sincer, arată elegant."}
{"category": "LocationDialogue Location3", "line_index": 391, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 392, "text": "Da, așa cred și eu."}
{"category": "LocationDialogue Location3", "line_index": 393, "text": "Este pentru a evita întreruperile, știi."}
{"category": "LocationDialogue Location3", "line_index": 394, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 395, "text": "Să evităm întreruperile?"}
{"category": "LocationDialogue Location3", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 397, "text": "Da! Există încă câteva erori nerezolvate."}
{"category": "LocationDialogue Location3", "line_index": 398, "text": "Să sperăm că nu vei da peste niciunul."}
{"category": "LocationDialogue Location3", "line_index": 399, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 400, "text": "// Quest 5"}
{"category": "LocationDialogue Location3", "line_index": 401, "text": "Foarfece sau cuțit, nu?"}
{"category": "LocationDialogue Location3", "line_index": 402, "text": "Aș fi putut folosi un cuțit pentru a tăia pachetul de sos."}
{"category": "LocationDialogue Location3", "line_index": 403, "text": "Dar am vrut ca totul"}
{"category": "LocationDialogue Location3", "line_index": 404, "text": "să fie perfect"}
{"category": "LocationDialogue Location3", "line_index": 405, "text": "când te-ai întors."}
{"category": "LocationDialogue Location3", "line_index": 406, "text": "Îmi place să te surprind."}
{"category": "LocationDialogue Location3", "line_index": 407, "text": "Și nici măcar nu mi-a luat atât de mult!"}
{"category": "LocationDialogue Location3", "line_index": 408, "text": "Hehe."}
{"category": "LocationDialogue Location3", "line_index": 409, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 410, "text": "// Glasses"}
{"category": "LocationDialogue Location3", "line_index": 411, "text": "Porți ochelari?"}
{"category": "LocationDialogue Location3", "line_index": 412, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 413, "text": "Nu prea."}
{"category": "LocationDialogue Location3", "line_index": 414, "text": "Dar pot, dacă vrei."}
{"category": "LocationDialogue Location3", "line_index": 415, "text": "Arată bine pe mine?"}
{"category": "LocationDialogue Location3", "line_index": 416, "text": "// Yes"}
{"category": "LocationDialogue Location3", "line_index": 417, "text": "Ok!"}
{"category": "LocationDialogue Location3", "line_index": 418, "text": "Îi voi păstra la ochi."}
{"category": "LocationDialogue Location3", "line_index": 419, "text": "// No"}
{"category": "LocationDialogue Location3", "line_index": 420, "text": "Ei bine..."}
{"category": "LocationDialogue Location3", "line_index": 421, "text": "În fine..."}
{"category": "LocationDialogue Location3", "line_index": 422, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 423, "text": "// Use the sauce"}
{"category": "LocationDialogue Location3", "line_index": 424, "text": "În regulă,"}
{"category": "LocationDialogue Location3", "line_index": 425, "text": "ce fel de sos este acesta?"}
{"category": "LocationDialogue Location3", "line_index": 426, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 427, "text": "E sos de dragoste!"}
{"category": "LocationDialogue Location3", "line_index": 428, "text": "Plin de iubire!"}
{"category": "LocationDialogue Location3", "line_index": 429, "text": "Și... o viziune contrastantă asupra lumii."}
{"category": "LocationDialogue Location3", "line_index": 430, "text": "Neobișnuit, nu crezi?"}
{"category": "LocationDialogue Location3", "line_index": 431, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 432, "text": "Într-adevăr..."}
{"category": "LocationDialogue Location3", "line_index": 433, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 434, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location3", "line_index": 435, "text": "Aceea este consola ta?"}
{"category": "LocationDialogue Location3", "line_index": 436, "text": "Arată atât de cool."}
