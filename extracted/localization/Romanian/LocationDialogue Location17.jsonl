{"category": "LocationDialogue Location17", "line_index": 0, "text": "// Player thinks + Make coffee"}
{"category": "LocationDialogue Location17", "line_index": 1, "text": "Am nevoie de ajutor."}
{"category": "LocationDialogue Location17", "line_index": 2, "text": "Sper că Mita asta nu mușcă..."}
{"category": "LocationDialogue Location17", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 4, "text": "Pe ce îmi irosesc timpul..."}
{"category": "LocationDialogue Location17", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 9, "text": "// Player tries to wake up MitaDreamer"}
{"category": "LocationDialogue Location17", "line_index": 10, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 11, "text": "Mita, trezește-te!"}
{"category": "LocationDialogue Location17", "line_index": 12, "text": "Mita!"}
{"category": "LocationDialogue Location17", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 14, "text": "Mita, neațaaa!"}
{"category": "LocationDialogue Location17", "line_index": 15, "text": "Am nevoie de ajutorul tău."}
{"category": "LocationDialogue Location17", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 17, "text": "Cine eștiiii?"}
{"category": "LocationDialogue Location17", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 19, "text": "Ajută-mă cu manetele."}
{"category": "LocationDialogue Location17", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 21, "text": "Ce manete?"}
{"category": "LocationDialogue Location17", "line_index": 22, "text": "Lasă-mă să dorm..."}
{"category": "LocationDialogue Location17", "line_index": 23, "text": "Sau fă-mi o cafea."}
{"category": "LocationDialogue Location17", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 25, "text": "Mașina de cafea e chiar acolo."}
{"category": "LocationDialogue Location17", "line_index": 26, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 27, "text": "Mi-ita!"}
{"category": "LocationDialogue Location17", "line_index": 28, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 31, "text": "// Player gives away the coffee"}
{"category": "LocationDialogue Location17", "line_index": 32, "text": "Mita,"}
{"category": "LocationDialogue Location17", "line_index": 33, "text": "uite-ți cafeaua."}
{"category": "LocationDialogue Location17", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 37, "text": "// MitaDreamer exercise"}
{"category": "LocationDialogue Location17", "line_index": 38, "text": "Manete"}
{"category": "LocationDialogue Location17", "line_index": 39, "text": "zici?"}
{"category": "LocationDialogue Location17", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 41, "text": "Da."}
{"category": "LocationDialogue Location17", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 43, "text": "De unde știi de ele?"}
{"category": "LocationDialogue Location17", "line_index": 44, "text": "Totuși, de ce întreb măcar..."}
{"category": "LocationDialogue Location17", "line_index": 45, "text": "Considerând că ești deja aici,"}
{"category": "LocationDialogue Location17", "line_index": 46, "text": "știi deja destule..."}
{"category": "LocationDialogue Location17", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 48, "text": "O secundă,"}
{"category": "LocationDialogue Location17", "line_index": 49, "text": "Trebuie să stau jos."}
{"category": "LocationDialogue Location17", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 51, "text": "Și?"}
{"category": "LocationDialogue Location17", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 53, "text": "Nu știu ce să zic..."}
{"category": "LocationDialogue Location17", "line_index": 54, "text": "Dar trebuie să continui,"}
{"category": "LocationDialogue Location17", "line_index": 55, "text": "să urmăresc în continuare instrucțiunile inelului."}
{"category": "LocationDialogue Location17", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 57, "text": "Îi ai inelul?"}
{"category": "LocationDialogue Location17", "line_index": 58, "text": "Nu mă miră"}
{"category": "LocationDialogue Location17", "line_index": 59, "text": "că ai găsit locul asta."}
{"category": "LocationDialogue Location17", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 61, "text": "Dap."}
{"category": "LocationDialogue Location17", "line_index": 62, "text": "Deci, mă poți ajuta cu manetele?"}
{"category": "LocationDialogue Location17", "line_index": 63, "text": "Cu manetele?"}
{"category": "LocationDialogue Location17", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 65, "text": "Sigur."}
{"category": "LocationDialogue Location17", "line_index": 66, "text": "Te ajut."}
{"category": "LocationDialogue Location17", "line_index": 67, "text": "Cu manetele..."}
{"category": "LocationDialogue Location17", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 70, "text": "Mita, haide o dată..."}
{"category": "LocationDialogue Location17", "line_index": 71, "text": "Să mergem odată."}
{"category": "LocationDialogue Location17", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 73, "text": "Uh?"}
{"category": "LocationDialogue Location17", "line_index": 74, "text": "În regulă."}
{"category": "LocationDialogue Location17", "line_index": 75, "text": "Hai."}
{"category": "LocationDialogue Location17", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 78, "text": "// MitaDreamer fall"}
{"category": "LocationDialogue Location17", "line_index": 79, "text": "Ridică-te."}
{"category": "LocationDialogue Location17", "line_index": 80, "text": "Îți e chiar atât de somn?"}
{"category": "LocationDialogue Location17", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 82, "text": "// MitaDreamer again sleep"}
{"category": "LocationDialogue Location17", "line_index": 83, "text": "Trezește-te."}
{"category": "LocationDialogue Location17", "line_index": 84, "text": "Am ajuns."}
{"category": "LocationDialogue Location17", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 87, "text": "// Switches"}
{"category": "LocationDialogue Location17", "line_index": 88, "text": "Ok,"}
{"category": "LocationDialogue Location17", "line_index": 89, "text": "Sunt gata."}
{"category": "LocationDialogue Location17", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 91, "text": "Și eu."}
{"category": "LocationDialogue Location17", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 93, "text": "Ei bine."}
{"category": "LocationDialogue Location17", "line_index": 94, "text": "Voi începe"}
{"category": "LocationDialogue Location17", "line_index": 95, "text": "numărătoarea."}
{"category": "LocationDialogue Location17", "line_index": 96, "text": "Și vom trage în același timp."}
{"category": "LocationDialogue Location17", "line_index": 97, "text": "Ok?"}
{"category": "LocationDialogue Location17", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 99, "text": "Doar rămâi trează, OK!"}
{"category": "LocationDialogue Location17", "line_index": 100, "text": "Hai."}
{"category": "LocationDialogue Location17", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 103, "text": "3"}
{"category": "LocationDialogue Location17", "line_index": 104, "text": "2"}
{"category": "LocationDialogue Location17", "line_index": 105, "text": "1"}
{"category": "LocationDialogue Location17", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 107, "text": "// Player lose 1"}
{"category": "LocationDialogue Location17", "line_index": 108, "text": "Ești cu capul în nori?"}
{"category": "LocationDialogue Location17", "line_index": 109, "text": "Haide,"}
{"category": "LocationDialogue Location17", "line_index": 110, "text": "mai încercăm o dată..."}
{"category": "LocationDialogue Location17", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 112, "text": "// Player lose 2"}
{"category": "LocationDialogue Location17", "line_index": 113, "text": "Încă o încercare?"}
{"category": "LocationDialogue Location17", "line_index": 114, "text": "Haide,"}
{"category": "LocationDialogue Location17", "line_index": 115, "text": "Eu..."}
{"category": "LocationDialogue Location17", "line_index": 116, "text": "Eu cred că adorm aici..."}
{"category": "LocationDialogue Location17", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 118, "text": "// Player lose 3"}
{"category": "LocationDialogue Location17", "line_index": 119, "text": "Aproape că am adormit..."}
{"category": "LocationDialogue Location17", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 122, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 123, "text": "Minunat,"}
{"category": "LocationDialogue Location17", "line_index": 124, "text": "mulțumesc, Mita."}
{"category": "LocationDialogue Location17", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 126, "text": "Mm-hmm."}
{"category": "LocationDialogue Location17", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 129, "text": "Ușile..."}
{"category": "LocationDialogue Location17", "line_index": 130, "text": "așa..."}
{"category": "LocationDialogue Location17", "line_index": 131, "text": "încete..."}
{"category": "LocationDialogue Location17", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 134, "text": "Eu mă culc..."}
{"category": "LocationDialogue Location17", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 136, "text": "// Why kitchen?"}
{"category": "LocationDialogue Location17", "line_index": 137, "text": "De ce am mers la bucătărie?"}
{"category": "LocationDialogue Location17", "line_index": 138, "text": "Dacă adorm pe podeaua rece,"}
{"category": "LocationDialogue Location17", "line_index": 139, "text": "e doar vina ta."}
{"category": "LocationDialogue Location17", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 141, "text": "// Why bathroom?"}
{"category": "LocationDialogue Location17", "line_index": 142, "text": "Nu înțeleg..."}
{"category": "LocationDialogue Location17", "line_index": 143, "text": "Cu ce manete ai nevoie de ajutor aici?"}
{"category": "LocationDialogue Location17", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 145, "text": "// Put button"}
{"category": "LocationDialogue Location17", "line_index": 146, "text": "Nu s-a întâmplat nimic?"}
{"category": "LocationDialogue Location17", "line_index": 147, "text": "Atunci ce caută butonul ăsta aici?"}
{"category": "LocationDialogue Location17", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 149, "text": "// Cofee"}
{"category": "LocationDialogue Location17", "line_index": 150, "text": "Mai multă cafea?"}
{"category": "LocationDialogue Location17", "line_index": 151, "text": "Sau vei adormi iar."}
{"category": "LocationDialogue Location17", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 153, "text": "Ce?"}
{"category": "LocationDialogue Location17", "line_index": 154, "text": "Nuuu..."}
{"category": "LocationDialogue Location17", "line_index": 155, "text": "Cafeaua asta e oribilă..."}
{"category": "LocationDialogue Location17", "line_index": 156, "text": "Sunt ok..."}
{"category": "LocationDialogue Location17", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 158, "text": "// Button"}
{"category": "LocationDialogue Location17", "line_index": 159, "text": "Mita? Butonul nu funcționează... mă auzi?"}
{"category": "LocationDialogue Location17", "line_index": 160, "text": "Alo?"}
