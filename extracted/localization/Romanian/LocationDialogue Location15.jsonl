{"category": "LocationDialogue Location15", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Aici erai!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "De ce ai plecat din nucleu?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Ți-am spus să mă aștepți!"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Am crezut că vei fi plecată pentru mai mult timp..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Ei bine, în regulă..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Cred că am găsit ceva..."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Cred că e un index..."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Va trebui să vedem dacă funcționează!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Hai să plecăm de aici."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "Mita cea nebună..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Cred că e ocupată cu un nou jucător."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Așa că să sperăm că e prea ocupată ca să ne bage în seamă..."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Mita?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Așteaptă-mă."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Ți-a căzut ceva?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Întâlnește-o din nou!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Mita..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Prinde!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Cum se face că..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Cine esti tu?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Ești... ești în viață!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Nu-ți amintești?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Te cunosc eu?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Ce se întâmplă..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Ce ar trebui să fac acum?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Nu pot ieși..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "Cum adică, „să ies”?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Așteaptă..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "Acela e inelul..."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "Și asta?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Habar n-am ce e."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "E un index!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Tu l-ai găsit!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Nu știu ce să spun."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Trebuie să ne întoarcem la nucleu."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "Și tu..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Poate ar trebui să vii cu mine..."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Um, ce?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Sigur..."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Așteaptă aici."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Mm-hmm."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Voi sta chiar aici."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "La naiba..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "A fost la limită."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "Deci... am făcut-o?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "E bine."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Sunt în versiunea corectă."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Bună!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Ești un jucător, nu-i așa?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Cum te cheamă?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Vreau să plec din locul ăsta..."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Vrei să pleci așa de repede?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "Cum ai ajuns aici, în primul rând?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Ei, bine..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Bine, poți pleca..."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Doar încearcă ușa."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Succes cu asta!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Un perete?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Hmm, totul este greșit."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Poate..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "este ceva în subsol care te va ajuta."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Am descoperit recent"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "o ușă în dulapul meu..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Se pare că duce la un subsol."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Dar e plin de gunoaie,"}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "gunoaie și o tonă de echipamente sofisticate."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Trebuie să introduci un fel de cod sau ceva de genul ăsta."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Nu prea înțeleg."}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "Și nu-mi pasă."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "E și cam incomod, adică foarte incomod."}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Vrei să arunci o privire?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Um, bine."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Nu cred că"}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "că-și amintește ceva..."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Am reușit?"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "Am repornit-o?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Atunci tot ce trebuie să fac este"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "să ies din jocul ăsta nenorocit..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Nu așa de repede."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Aș vrea să te îmbrățișez."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Ce?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Mi-a făcut plăcere să te văd."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Ahh..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "este mare păcat"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "că tu și cu mine"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "să petrecem atât de puțin timp împreună."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Um..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "Despre ce vorbești?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Adică,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "ai fi putut rămâne cu mine..."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "E numai vina mea..."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Dulapul ăla și... sunetele."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Trebuia să o OMOR mai devreme!"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Stai un pic,"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "Nu ai...?"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Cum îți poți aminti ceva din toate astea?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "HA!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Chiar ai crezut că va fi atât de ușor?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Ești doar un prost..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "La fel ca toți ceilalți jucători..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Ne-am descurcat foarte bine, uite!"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "Tu cel adevărat"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "e inutil,"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "nu mai e nevoie de el."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Îmi pare rău, hehe."}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Nu pot să cred..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Am eșuat...?"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Nu... Te-am repornit, sunt sigur de asta..."}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Tu tot nu înțelegi..."}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Ha-ha-ha-ha!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Sunt o actriță atât de bună!"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Ar fi trebuit să-ți vezi fața, scumpule!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "E atât de distractiv!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "De ce ești așa?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Ce e în neregulă cu tine?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Da..."}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Ce e în neregulă cu mine?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Habar n-am..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "De ce nu-mi spui de ce sunt așa?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "De ce nu voi fi niciodată o Mita adevărată?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Versiunea mea,"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "nu a existat în primul rând!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Eu doar îi jupoi pe acești proști naivi,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "ascunzându-mă sub pielea lor..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Nu ai cum să"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "să mă repornești!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Nu..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Tu..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "Nu ei sunt problema!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "Tu ești cea care nu ar trebui să existe!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "Și tu..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Doare să te aud spunând asta."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "Și totuși!"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "E timpul să pleci!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Ne vom revedea curând!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Toată lumea e pregătită!"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "E timpul"}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "timpul să te scoatem din consolă!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "Ne vedem mai târziu!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Vei fi cartușul meu preferat..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Un jucător cu un nume interesant."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Probabil că nu este așa."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Nici asta nu e bine."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Nu, greșit."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Asta nu e."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Trebuie să găsesc opțiunea de resetare a caracterului."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "Aceasta este versiunea greșită."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Oops, greșeala mea."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Nu e asta."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "O să am nevoie de alta."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Ceva nu este în regulă"}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "cu indexul."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Trebuie să schimb indexul,"}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "nu se potrivește."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Ți-e foame?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Mă pricep la tăiat morcovi :)"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Ah, cred că"}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "ai vrut să intri singur?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "De ce ne învârtim în cerc?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "De ce să ne întoarcem aici?"}
