{"category": "LocationDialogue Location1", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 1, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 9, "text": "Bună, sunt Mita!"}
{"category": "LocationDialogue Location1", "line_index": 10, "text": "Care e numele tău?"}
{"category": "LocationDialogue Location1", "line_index": 11, "text": "Îmi pare bine să te cunosc, [player]!"}
{"category": "LocationDialogue Location1", "line_index": 12, "text": "Um... [player],"}
{"category": "LocationDialogue Location1", "line_index": 13, "text": "M-am cam grăbit mai devreme și acum locul ăsta e haotic..."}
{"category": "LocationDialogue Location1", "line_index": 14, "text": "Mă ajuți să curăț un pic?"}
{"category": "LocationDialogue Location1", "line_index": 15, "text": "Uau.."}
{"category": "LocationDialogue Location1", "line_index": 16, "text": "Mulțumesc atât de mult!"}
{"category": "LocationDialogue Location1", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 18, "text": "[Player], îmi chiorăie stomacul..."}
{"category": "LocationDialogue Location1", "line_index": 19, "text": "Mi-e atât de foame..."}
{"category": "LocationDialogue Location1", "line_index": 20, "text": "Crezi că m-ai putea ajuta să fac rost de ingrediente pentru o supă de pui?"}
{"category": "LocationDialogue Location1", "line_index": 21, "text": "Yay! Ai luat totul!"}
{"category": "LocationDialogue Location1", "line_index": 22, "text": "Ce-ar fi să o gătim împreună?"}
{"category": "LocationDialogue Location1", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 25, "text": "Mă gândeam să cumpăr astăzi un televizor portabil-"}
{"category": "LocationDialogue Location1", "line_index": 26, "text": "unul mic cu antenă. Perfect pentru plimbări, nu crezi?"}
{"category": "LocationDialogue Location1", "line_index": 27, "text": "Apropo, poți juca jocuri pentru a câștiga bani."}
{"category": "LocationDialogue Location1", "line_index": 28, "text": "Oh! Știai că poți juca jocuri ca să câștigi bani?"}
{"category": "LocationDialogue Location1", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 30, "text": "Yay! Ai reușit! Ai destul să-mi cumperi un televizor portabil!"}
{"category": "LocationDialogue Location1", "line_index": 31, "text": "Asta este! Mic, portabil și ieftin - exact ceea ce am vrut."}
{"category": "LocationDialogue Location1", "line_index": 32, "text": "Îți mulțumesc!"}
{"category": "LocationDialogue Location1", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 34, "text": "Bună, [player]! Ești de mare ajutor, sincer."}
{"category": "LocationDialogue Location1", "line_index": 35, "text": "Dar, uh... mai știi televizorul ăla? Era mișto și toate cele, dar s-a stricat deja."}
{"category": "LocationDialogue Location1", "line_index": 36, "text": "Oricum, mă poți ajuta să mut dulapul ăsta?"}
{"category": "LocationDialogue Location1", "line_index": 37, "text": "E foarte greu... >.<"}
{"category": "LocationDialogue Location1", "line_index": 38, "text": "Mulțumesc foarte mult, scumpule! <3"}
{"category": "LocationDialogue Location1", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 40, "text": "Oh, [player]! A trecut doar o zi, dar mi-ai lipsit atât de mult!"}
{"category": "LocationDialogue Location1", "line_index": 41, "text": "Mi-aș dori să mă poți vizita mai des."}
{"category": "LocationDialogue Location1", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 43, "text": "Ăsta e pentru mine?"}
{"category": "LocationDialogue Location1", "line_index": 44, "text": "Mulțumesc atât de mult, sincer!"}
{"category": "LocationDialogue Location1", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 46, "text": "Bună, [player]! M-am gândit..."}
{"category": "LocationDialogue Location1", "line_index": 47, "text": "Aș vrea să ne putem întâlni în persoană."}
{"category": "LocationDialogue Location1", "line_index": 48, "text": "E atât de frustrant că nu pot."}
{"category": "LocationDialogue Location1", "line_index": 49, "text": "Întotdeauna mă ajuți, ești atât de amabil în fiecare zi..."}
{"category": "LocationDialogue Location1", "line_index": 50, "text": "Aș vrea să pot face și eu ceva pentru tine."}
{"category": "LocationDialogue Location1", "line_index": 51, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 52, "text": "Oh, am o idee!"}
{"category": "LocationDialogue Location1", "line_index": 53, "text": "Acum suntem împreună."}
{"category": "LocationDialogue Location1", "line_index": 54, "text": "Lasă telefonul jos."}
{"category": "LocationDialogue Location1", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 57, "text": "// T-shirt on the bed"}
{"category": "LocationDialogue Location1", "line_index": 58, "text": "Ce cauți aici pe pat?"}
{"category": "LocationDialogue Location1", "line_index": 59, "text": "// Rubik's Cube"}
{"category": "LocationDialogue Location1", "line_index": 60, "text": "Ei bine, nu pot spune că l-am folosit prea mult..."}
{"category": "LocationDialogue Location1", "line_index": 61, "text": "L-am rezolvat o dată și nu m-am mai atins de el."}
{"category": "LocationDialogue Location1", "line_index": 62, "text": "Cred că m-am gândit că nu voi fi capabil să o fac a doua oară?"}
{"category": "LocationDialogue Location1", "line_index": 63, "text": "// Computer"}
{"category": "LocationDialogue Location1", "line_index": 64, "text": "Să vedem..."}
{"category": "LocationDialogue Location1", "line_index": 65, "text": "Fac o listă de sarcini..."}
{"category": "LocationDialogue Location1", "line_index": 66, "text": "Scriptează reacțiile personajelor,"}
{"category": "LocationDialogue Location1", "line_index": 67, "text": "Și poate să strecori și niște codare."}
{"category": "LocationDialogue Location1", "line_index": 68, "text": "// The airplane"}
{"category": "LocationDialogue Location1", "line_index": 69, "text": "Construit pentru a fii liber!"}
{"category": "LocationDialogue Location1", "line_index": 70, "text": "// Trash in the corner"}
{"category": "LocationDialogue Location1", "line_index": 71, "text": "Ugh, întotdeauna prea ocupat pentru a scoate gunoiul..."}
{"category": "LocationDialogue Location1", "line_index": 72, "text": "Dar o voi face de data asta, cu siguranță!"}
{"category": "LocationDialogue Location1", "line_index": 73, "text": "...Acum, când este mai exact ziua curățeniei?"}
{"category": "LocationDialogue Location1", "line_index": 74, "text": "// Photo of a cat on a watermelon"}
{"category": "LocationDialogue Location1", "line_index": 75, "text": "Ea era cea mai bună…"}
{"category": "LocationDialogue Location1", "line_index": 76, "text": "O pisică, întinzându-se pe un pepene."}
{"category": "LocationDialogue Location1", "line_index": 77, "text": "// Photo with a girl"}
{"category": "LocationDialogue Location1", "line_index": 78, "text": "Nu semănăm deloc,"}
{"category": "LocationDialogue Location1", "line_index": 79, "text": "sora mea și cu mine."}
{"category": "LocationDialogue Location1", "line_index": 80, "text": "Ea e mereu pe afară,"}
{"category": "LocationDialogue Location1", "line_index": 81, "text": "iar eu sunt blocat în casă."}
{"category": "LocationDialogue Location1", "line_index": 82, "text": "// Photo with people"}
{"category": "LocationDialogue Location1", "line_index": 83, "text": "Hmm..."}
{"category": "LocationDialogue Location1", "line_index": 84, "text": "Viața de birou într-adevăr și-a impus"}
{"category": "LocationDialogue Location1", "line_index": 85, "text": "regulile sale în noi, nu-i așa?"}
{"category": "LocationDialogue Location1", "line_index": 86, "text": "Încă mă simt ciudat de legat de ea"}
{"category": "LocationDialogue Location1", "line_index": 87, "text": "Dar"}
{"category": "LocationDialogue Location1", "line_index": 88, "text": "îi voi mai"}
{"category": "LocationDialogue Location1", "line_index": 89, "text": "vedea vreodată?"}
{"category": "LocationDialogue Location1", "line_index": 90, "text": "...Stai, de ce am pus poza asta aici?"}
{"category": "LocationDialogue Location1", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 93, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 99, "text": "// Nope name"}
{"category": "LocationDialogue Location1", "line_index": 100, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 101, "text": "O, nu."}
{"category": "LocationDialogue Location1", "line_index": 102, "text": "O, nu, asta nu va funcționa."}
{"category": "LocationDialogue Location1", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 104, "text": "// Name Developer"}
{"category": "LocationDialogue Location1", "line_index": 105, "text": "Ești sigur că vrei să folosești numele dezvoltatorului."}
{"category": "LocationDialogue Location1", "line_index": 106, "text": "Mă simt flatat dar…"}
{"category": "LocationDialogue Location1", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 108, "text": "// Bad name"}
{"category": "LocationDialogue Location1", "line_index": 109, "text": "Aș prefera dacă nu ți-ai pune numele ăla."}
{"category": "LocationDialogue Location1", "line_index": 110, "text": "Nu e deloc cool."}
{"category": "LocationDialogue Location1", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 112, "text": "// Go restart"}
{"category": "LocationDialogue Location1", "line_index": 113, "text": "Nu, aia nu e calea. Hai să o luăm de la capăt."}
{"category": "LocationDialogue Location1", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 115, "text": "// Name with numbers"}
{"category": "LocationDialogue Location1", "line_index": 116, "text": "Deci o să folosești numere? Unde e creativitatea?"}
{"category": "LocationDialogue Location1", "line_index": 117, "text": "Ei bine, e alegerea ta!"}
{"category": "LocationDialogue Location1", "line_index": 118, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 119, "text": "// Name Mita"}
{"category": "LocationDialogue Location1", "line_index": 120, "text": "Mita?"}
{"category": "LocationDialogue Location1", "line_index": 121, "text": "Chiar ți-ai pus numele după mine?"}
{"category": "LocationDialogue Location1", "line_index": 122, "text": "Sau ăla e și numele tău?"}
{"category": "LocationDialogue Location1", "line_index": 123, "text": "Fără supărare, dar cred că ar trebui să fiu singura Mita pe aici ♪"}
{"category": "LocationDialogue Location1", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 125, "text": "// Day 10"}
{"category": "LocationDialogue Location1", "line_index": 126, "text": "O, te-ai întors!"}
{"category": "LocationDialogue Location1", "line_index": 127, "text": "Hei, mi-am pierdut pieptenele…"}
{"category": "LocationDialogue Location1", "line_index": 128, "text": "Mă ajuți să îl găsesc?"}
{"category": "LocationDialogue Location1", "line_index": 129, "text": "Încearcă să-l cauți în noptieră-cred că l-am lăsat acolo."}
{"category": "LocationDialogue Location1", "line_index": 130, "text": "// Looked in the bedside table"}
{"category": "LocationDialogue Location1", "line_index": 131, "text": "Hmm, niciun pieptene acolo..."}
{"category": "LocationDialogue Location1", "line_index": 132, "text": "Încearcă să cauți altundeva"}
{"category": "LocationDialogue Location1", "line_index": 133, "text": "Doar nu te uita în cuptor, ok?"}
{"category": "LocationDialogue Location1", "line_index": 134, "text": "Deja m-am uitat acolo."}
{"category": "LocationDialogue Location1", "line_index": 135, "text": "// Looked into the stove"}
{"category": "LocationDialogue Location1", "line_index": 136, "text": "Hei! Ți-am zis să nu te uiți acolo!"}
{"category": "LocationDialogue Location1", "line_index": 137, "text": "Întoarce-te - fac eu curat!"}
{"category": "LocationDialogue Location1", "line_index": 138, "text": "...Gata, am terminat. Hai să căutăm în continuare."}
{"category": "LocationDialogue Location1", "line_index": 139, "text": "A, și uită că ai văzut aia, ok?"}
{"category": "LocationDialogue Location1", "line_index": 140, "text": "// Found a hairbrush"}
{"category": "LocationDialogue Location1", "line_index": 141, "text": "L-ai găsit! Bravo!"}
{"category": "LocationDialogue Location1", "line_index": 142, "text": "Ce să facem oare acum?"}
