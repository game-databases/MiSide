{"category": "LocationDialogue Location20", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Mila! Nu! Ești nebună!"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Ha-ha! CE-I ASTA?"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "Văd o expresie nouă?"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "Haide, lasă-mă să văd mai mult!"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "Să privesc același chip vechi devine atât de plictisitor!"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\""}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "Ce mai faci, micul meu rătăcitor neliniștit?"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "Încă mai alergi? Nu ți-a ajuns încă?"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Ce i-ai făcut Milei?"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "O, deci nu ești obosit încă!"}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Perfect! Hai să mai jucăm un joc!"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "Tu..."}
{"category": "LocationDialogue Location20", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "Să începem cu un mic test!"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "Să-ți testăm coordonarea!"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "Acum abilitatea ta de a acționa!"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "Dacă e ceva în neregulă cu tine!?"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "Dacă nici măcar nu meriți acea PIELE"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "pe care ești atât de mândru să o porți!?"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "Ia uită-te puțin..."}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "Care îți atrage atenția?"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "Cel din dreapta?"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "Sau"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "cel din stânga?"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "Oh, serios?"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "Are vreo importanță?"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "Doar mă jucam cu tine!"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "Înjunghierile sunt știri vechi, oricum."}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "În fine!"}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "Am plănuit jocuri mult mai bune,"}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "cum ar fi..."}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "Fii atent la asta!"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Avem nevoie de niște muzică!"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "Ce părere ai de melodia asta?"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "Îmi face sângele să pompeze!"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "Voi începe"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "cu regulile!"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rules"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "În timp ce melodia este redată,"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "te poți mișca."}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "Dar când muzica se oprește,"}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "SĂ NU TE MIȘTI!"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "Sau ești mort. Ai înțeles?"}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "E simplu: ajungi la sfârșit"}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "înainte ca melodia să se termine."}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "Să începem!"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "Încă mai stai pe aici, eh?"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Fugi, scumpule, fugi!"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "Oh!"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Uită-te la tine! Atât de ascultător!"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Un mic specimen perfect."}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Te vreau pentru mine!"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "Asta a fost mult prea ușor, nu-i așa?"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "Lasă-mă să plec!"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "Nu te simți prea confortabil!"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "Mai avem multe jocuri de jucat!"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "Iată-l pe următorul:"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Am să închid ochii..."}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "Și când îi voi deschide,"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "ai face bine să fi plecat!"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "Ai înțeles?"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "Dacă te văd, te pedepsesc!"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Bun! Să începem!"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "Asta nu are sens..."}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "Ai reușit!"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Te descurci grozav - devine interesant!"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "Dar acum va deveni mai greu."}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "FOARTE greu."}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Ascunde-te, fugi, învârte-te-"}
{"category": "LocationDialogue Location20", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "Ah, să te ia naiba!"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Player falls"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "Cred că am scăpat..."}
