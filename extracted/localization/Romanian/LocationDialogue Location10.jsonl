{"category": "LocationDialogue Location10", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "Așteaptă, stai așa!"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "Nu atât de tare..."}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "Să mergi mai departe e periculos."}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "Apropo..."}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "cum ai ajuns aici?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "Um..."}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "Inelul deschide ușile potrivite."}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "Sincer, nu știu cum funcționează."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "Inelul?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "Ce e cu locul ăsta?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "E foarte întunecat."}
{"category": "LocationDialogue Location10", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "O să-ți spun mai târziu."}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "Pentru moment, du-te spre ieșire."}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "Ne întâlnim în sala de jocuri."}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Grăbește-te, nu întârzia!"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// After mini-game"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "Deci, ai înțeles ideea jocului?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "Că eu sunt făcut din carne și oase, iar tu ești făcută dintr-un model de schelet?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "Whoa!"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "Sună înfiorător când o spui așa."}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "Dar, asta e esența."}
{"category": "LocationDialogue Location10", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "Corect, dar de ce trebuie să înțeleg asta?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "Cred că ți-am spus că a merge mai departe"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "e periculos, în glumă?"}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "O să dai peste... modele abandonate..."}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "Cele abandonate, cele „defecte”."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "Sunt agresive și ar putea chiar să încerce să te omoare."}
{"category": "LocationDialogue Location10", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "Deci, ce ar trebui să fac?"}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Voi merge"}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "oriunde se deschide o ușă."}
{"category": "LocationDialogue Location10", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "Uau!"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "Atunci nu le întoarce spatele."}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "Și nu-i scăpa din ochi!"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "Ei devin timizi când te holbezi la ei,"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "atât de timizi încât îngheață."}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "Ține cont de asta!"}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// Quest 1 (Why are there other Mitas down there?)"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "Sunt proaspăt făcute."}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "Au nevoie de timp"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "pentru a dobândi conștiința de sine."}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "Apoi o conduc pe fiecare"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "spre propria ei casă."}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// Quest 2 (Why is it so dark downstairs?)"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "Noi, Mitele, suntem „create” în întuneric,"}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "așa că trebuie să rămânem acolo pentru o vreme."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Imaginează-ți"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "durerea de a trece din întuneric direct în lumină..."}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// Quest 3 (What are you doing here?)"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "Încă nu înțelegi?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "Îi ajut pe noile Mite să se acomodeze!"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "Cine le va ajuta dacă nu o fac eu?"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "Tu?"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// Quest 4 (Why do we need this conveyor?)"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "Pentru ce este această bandă rulantă?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "Este destul loc pentru toată lumea?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Stai, nu-mi spune că nu"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "înțelegi cum funcționează lumea..."}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "Și că e fără sfârșit?"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "Fără sfârșit?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "Uhm..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "Ce vrei să spui cu asta?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "Dacă 1.9 este ultima versiune,"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "atunci sunt doar 19 lumi."}
{"category": "LocationDialogue Location10", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "Doamne, tu chiar nu"}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "nu înțelegi deloc cum funcționează lumea asta."}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Uite, voi folosi această tablă"}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "pentru a-ți explica totul."}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "Vrei să auzi despre asta?"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// Quest 5 (What is your version?)"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Așteaptă,"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "nu te-am întâlnit în ultima versiune?"}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "Sau poate e doar imaginația mea."}
{"category": "LocationDialogue Location10", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "Ei bine, e foarte posibil."}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Eu sunt din versiunea 1.5."}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "Ai fost la ea?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Am fost."}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "Acolo am ajuns"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "când am fost aruncat în această lume!"}
{"category": "LocationDialogue Location10", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "Whoa!"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "Dar cum...?"}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "Dar care este indicele casei în care ai fost?"}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "Există un „eu” care nu se poate opri din plâns,"}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "un „eu” căruia îi place să se distreze,"}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "un „eu” cu memorie proastă și căruia îi place să-i intimideze pe alții..."}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "E o listă lungă..."}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Spune-mi ce îți amintești."}
{"category": "LocationDialogue Location10", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Era întuneric."}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "Era scris"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "de genul..."}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "„Joacă-te cu mine.”"}
{"category": "LocationDialogue Location10", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "Ah,"}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "ce păcat..."}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "Ăsta e „eu"}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "care intimidează și uită lucruri."}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// Mita wants to tell you [No]"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Mulțumesc, dar nu mulțumesc."}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Mă descurc și fără să știu mai multe."}
{"category": "LocationDialogue Location10", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "Bine, cum dorești."}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// Mita wants to tell you [Yes]."}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "Sigur, dă-i drumul."}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "Sper doar că nu va fi ca în liceu"}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "unde întotdeauna adormeam de plictiseală."}
{"category": "LocationDialogue Location10", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "Poți pleca oricând,"}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "sau să rămâi și să asculți"}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "dacă ești interesat."}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "Un jucător descarcă MiSide"}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "și ascultă cât de mult dorește."}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "Acolo, el creează o nouă casă"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "și o nouă Mita."}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "Aceasta este o reprezentare 2D."}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "Acestea sunt versiunile,"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "prezentate ca linii."}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "Casele sunt plasate pe aceste linii."}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "Să spunem că descărcați versiunea 1.14,"}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "care înseamnă o viață nouă,"}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "o nouă Mita, și o nouă casă."}
{"category": "LocationDialogue Location10", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "Cerule..."}
{"category": "LocationDialogue Location10", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Poți întreba despre detaliile"}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "în acest desen,"}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "și voi face tot posibilul să explic."}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// He asks about the only circle"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "De ce există un singur cerc?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "Acea versiune a fost lansată o singură dată,"}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "pentru a nu fi repetată niciodată."}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "Este singura versiune cu adevărat unică."}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "În plus, aceste versiuni sunt speciale"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "și nu au nici o cale către alte versiuni."}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "Mita somnoroasă se află în această versiune, 1.1."}
{"category": "LocationDialogue Location10", "line_index": 171, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "Mita somnoroasă?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "Pentru că nu reușește să doarmă"}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "cu toată lumea care trece prin versiunea ei?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "Nu, nu este așa."}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "Poți să treci pe lângă ea și să faci zgomot,"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "dar este imposibil să o trezești."}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// He asks about the shaded circle"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "De ce este acesta mâzgălit?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "Um, aia e aici"}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "din cauza Mitei cea frumoasă."}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "Ea a desenat-o."}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "Ne certam"}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "care ar putea ajunge la versiunea 1.11 cel mai repede."}
{"category": "LocationDialogue Location10", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "Deci, cine a câștigat?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "Eu, desigur!"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "Uite, suntem aici"}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "în versiunea 1.15,"}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "indexul casei 809."}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "Trebuie să ajungem la versiunea 1.11,"}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "indexul casei 805."}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Deci, calea ei a început așa."}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "Am încercat să găsim o cale mai scurtă,"}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "așa că Mita cea frumoasă a sugerat această cale."}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "Și apoi am desenat-o pe cea mai simplă, aici."}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "Simplu, nu?"}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Doar uita-te aici."}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "De aici, poți ajunge direct la versiunea corectă."}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Deși poate părea că această casă este în drum,"}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "că îți blochează calea..."}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "Oricum, inelul tău funcționează pe baza acelorași principii."}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "Încotro te îndrepți?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "Spre nucleu."}
{"category": "LocationDialogue Location10", "line_index": 210, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "Nucleul?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "Hmm..."}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Dacă vrei cea mai scurtă rută,"}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "va trebui să treci și prin versiunea 1.11."}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "Cu siguranță o vei întâlni pe Mita somnoroasă acolo."}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Cred că Mita care te-a trimis,"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "a luat aceeași cale."}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "Sau poate că nu și-a dat seama că ești pe o cale diferită."}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "Sau poate e un geniu"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "și a venit cu o rută și mai scurtă!"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Cred că s-ar putea să înțeleg."}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// He asks about the inscription"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "Despre ce este vorba?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "Asta e pentru Cappie."}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "Ea va fi aici în câteva ore."}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "Va muta cutiile alea"}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "și va pune o canapea aici."}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "Mă doare fundul!"}
{"category": "LocationDialogue Location10", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Emm..."}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "Poate te pot ajuta eu?"}
{"category": "LocationDialogue Location10", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "Nu, asta e treaba lui Cappie."}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Ea e dură."}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// He asks about the drawings"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "Este doar un desen,"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "sau"}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "înseamnă ceva?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 244, "text": "Da,"}
{"category": "LocationDialogue Location10", "line_index": 245, "text": "e doar o mâzgălitură."}
