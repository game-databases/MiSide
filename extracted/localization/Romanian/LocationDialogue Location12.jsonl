{"category": "LocationDialogue Location12", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Stai aici."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Cred că mi-a căzut ceva. O să mă întorc imediat."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "Apoi vom merge în altă lume..."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Ok."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Hai să ne jucăm!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Îmi vreau ursulețul!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "L-am pierdut..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "GĂSEȘTE-L!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Hei..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "la ce te uiți?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Quest 1 (Who are you?)"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Sunt Mita."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "Cea mai bună Mita."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "Prima Mita."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "Asta a spus Mita, Mita mea."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Quest 2 (Why do you look like that?)"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "Cum arăt?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "Cum arăt?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "Cum arăt?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "Mita mea spune că sunt frumoasă și originală."}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "Asta sunt eu!"}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Quest 3 (What was Mita doing here?)"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Ea mă va lua."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Vom trăii într-o altă lume."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "Mita mea m-a invitat."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Ea mă va lua. Și ne vom juca."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Quest 4 (Why do you need a teddy bear?)"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "Ești un ursuleț drăgălaș,"}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "și ești pierdut,"}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "la fel ca ursulețul meu drăgălaș."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Quest 5 (Why is Mita angry?)"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "Mita..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "mea."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Vrea să se joace."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Ea mă vrea numai"}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "pe mine."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Suntem unice,"}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "singurele."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Mita și Mita mea,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0.8A și 8I54*."}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Quest 6 (Do you believe Mita?)"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "Mita mea."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "Prietena mea cea mai bună."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "Mita mea."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "Singura mea prietenă."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "Tu ești!"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Hei."}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Hai să ne jucăm!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "O să îți arăt eu cum."}
