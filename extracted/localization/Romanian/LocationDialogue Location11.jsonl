{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Bună!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Ups!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Scuze,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "aproape te-am omorât."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Um..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "Frigiderul, adică... frigiderul aproape te-a omorât."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Nu am avut nimic de-a face cu asta,"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "Jur!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Sincer!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Sigur, te cred!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Dar sincer,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "locul ăsta e periculos..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "în special pentru tine."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "Nu ești un laș, nu?"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Uitându-mă la tine"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "cum treci prin"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "aceste locuri este distractiv..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Fugi, dovlecel, fugi!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "O să te ajung din urmă!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Bun băiat!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Woah, asta e distractiv!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Te-am văzut îndreptându-te spre telecabină."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "Asta e cea mai lungă cale"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "între versiuni..."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Mă întreb cum te vei descurca"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "cu cei care trăiesc acolo"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "în acea ceață."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Ce crezi că faci?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Te rog..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Nu te uita!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Prostuțule!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Ești un mare prostuț..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Um, ok..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Mult noroc!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Cine e acolo?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Pot să te simt..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Ascultă-mă,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "ești un jucător,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "nu-i așa?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Ajută-mă să găsesc..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "să găsesc un..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "Lasă-mă să mă gândesc..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "mintea mea e goală..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Ce naiba se întâmplă aici?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Am vrut să uit totul..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Am spart fiecare oglindă,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "am distrus fotografiile..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "dar acum..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "tot ce simt este regret."}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "Cât de proastă am fost..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Toată lumea face greșeli, sigur..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Dar ce te faci"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "când consecințele sunt catastrofice?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Aș vrea să pot da timpul înapoi..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Se spune că timpul vindecă toate rănile..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Dar ce este timpul?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Eu nu mai cred în nimic..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Dar dacă timpul poate vindeca,"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "sau măcar să mă ducă departe,"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "departe de această lume..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "Atunci, te implor, te rog"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "grăbește timpul."}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "Astfel încât să mă poată ucide"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "odată pentru totdeauna."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Ea a iubit..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Am iubit și eu, odată?"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Dar dragostea mea e diferită;"}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "dragostea ei e vibrantă,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "disprețuitoare..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "arzătoare..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "implacabilă..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "invidioasă..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "furioasă..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "nebună..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Mi-au spus că sunt emotivă..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "Îți faci prea multe griji, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "Vei trece peste asta, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "Nu ești singură, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Mi-au spus toate astea. Dar ce a rămas?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Tristețea,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "disperarea..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "și frica."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Inutil..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Nu-mi pot aminti..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "Absolut nimic..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Doar ecourile nesfârșite..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Nu pot face față faptului"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "că sunt prins aici..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Întotdeauna am fost aici,"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "dar de ce?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Nu-mi pot aminti..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Se va termina vreodată?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Nu știu..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Acesta este..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "un desen..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Îmi amintesc acum,"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "mulțumesc..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Dar fața mea..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "Nu am o față..."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "Totul e al EI."}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Ea a luat o parte din mine..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "a aruncat-o..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Ea e puternică..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "și isteață."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Nu am niciun drept să te opresc, jucătorule."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Uită-te în șifonier..."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Hei!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Ești în calea mea!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Ai de gând să stai acolo?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Dă-te la o parte!"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Lasă-mă să trec!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Doar pentru că ești mare nu înseamnă că ești atotputernic!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "De ce mă urmărești!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Dispari!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - radio voice"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Stai puțin... Jucător?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "Ce faci aici?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Cine e acolo?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Un alt jucător."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Eu sunt Mitaphone."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Stau aici și controlez telecabinele."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Îți dai seama"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "că te îndrepți spre moartea ta chiar acum?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Poate că da,"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "dar e singura cale pe care o am."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Ai dreptate."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Apasă butonul și treci în spatele tunului."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "Tunul?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Mhm."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Credeai că o să treci direct prin el?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Trebuie să treci de acest mini-joc Monster-slap,"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "așa că pregătește-te să tragi."}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "În regula, e timpul să plecăm."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Bravo!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Ai reușit."}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Hei, fugi de aici."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Cât mai repede!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "De ce ești încă aici?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Ți-am zis să te cari."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Nu înțeleg..."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "De ce doar stai acolo?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Ce? O consolă?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Fra...pe bune?"}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Pa."}
