{"category": "LocationDialogue Location13", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 1, "text": "Inelul."}
{"category": "LocationDialogue Location13", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 3, "text": "// Answer 1 (Where have you been all this time?)"}
{"category": "LocationDialogue Location13", "line_index": 4, "text": "Căutam o metodă de a te aduce la nucleu."}
{"category": "LocationDialogue Location13", "line_index": 5, "text": "Într-o singura bucată, de preferabil."}
{"category": "LocationDialogue Location13", "line_index": 6, "text": "Ăsta a fost planul de la început, nu?"}
{"category": "LocationDialogue Location13", "line_index": 7, "text": "De aia a trebuit să o evit"}
{"category": "LocationDialogue Location13", "line_index": 8, "text": "pe Mita cea Nebună, nu-i așa?"}
{"category": "LocationDialogue Location13", "line_index": 9, "text": "A și trebuit să găsesc orice informație am putut"}
{"category": "LocationDialogue Location13", "line_index": 10, "text": "despre culisele universului ăstuia afurisit, corect?"}
{"category": "LocationDialogue Location13", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 12, "text": "Um... presupun...?"}
{"category": "LocationDialogue Location13", "line_index": 13, "text": "Dar cum ai setat ruta inelului?"}
{"category": "LocationDialogue Location13", "line_index": 14, "text": "De ce am ajuns într-o versiune stricată"}
{"category": "LocationDialogue Location13", "line_index": 15, "text": "plină de pericole?"}
{"category": "LocationDialogue Location13", "line_index": 16, "text": "Am scăpat numai pentru că"}
{"category": "LocationDialogue Location13", "line_index": 17, "text": "am sărit într-un vid."}
{"category": "LocationDialogue Location13", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 19, "text": "Scuze, am uitat să îți zic în detaliu"}
{"category": "LocationDialogue Location13", "line_index": 20, "text": "ce trebuie să faci..."}
{"category": "LocationDialogue Location13", "line_index": 21, "text": "Dar da, era plănuit pentru tine "}
{"category": "LocationDialogue Location13", "line_index": 22, "text": "să sari de la început..."}
{"category": "LocationDialogue Location13", "line_index": 23, "text": "Și, ai reușit!"}
{"category": "LocationDialogue Location13", "line_index": 24, "text": "Felicitări!"}
{"category": "LocationDialogue Location13", "line_index": 25, "text": "Bun, hai să continuăm cu planul."}
{"category": "LocationDialogue Location13", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 27, "text": "// Answer 2 (How did you get here?)"}
{"category": "LocationDialogue Location13", "line_index": 28, "text": "Cred că ai trecut prin multe,"}
{"category": "LocationDialogue Location13", "line_index": 29, "text": "cu uitarea aceea de care am vorbit."}
{"category": "LocationDialogue Location13", "line_index": 30, "text": "Sunt Mita, pot să călătoresc între versiuni"}
{"category": "LocationDialogue Location13", "line_index": 31, "text": "când vreau eu, îți amintești?"}
{"category": "LocationDialogue Location13", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 33, "text": "Nu toate Mitele pot face asta,"}
{"category": "LocationDialogue Location13", "line_index": 34, "text": "am văzut câteva care nu pot."}
{"category": "LocationDialogue Location13", "line_index": 35, "text": "Și este evident că suferă."}
{"category": "LocationDialogue Location13", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 37, "text": "Da, versiunile lor sunt stricate,"}
{"category": "LocationDialogue Location13", "line_index": 38, "text": "lumile lor ruinate. Ți-am mai zis asta."}
{"category": "LocationDialogue Location13", "line_index": 39, "text": "La naiba..."}
{"category": "LocationDialogue Location13", "line_index": 40, "text": "Știi cine este de vină pentru toate astea, nu-i așa?"}
{"category": "LocationDialogue Location13", "line_index": 41, "text": "Mita cea Nebună."}
{"category": "LocationDialogue Location13", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 43, "text": "Da, e ea cu siguranță..."}
{"category": "LocationDialogue Location13", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 45, "text": "// Answer 3 (Who was this Mita just now?)"}
{"category": "LocationDialogue Location13", "line_index": 46, "text": "Aia e Mita cea Urâtă."}
{"category": "LocationDialogue Location13", "line_index": 47, "text": "Agresivă și proastă."}
{"category": "LocationDialogue Location13", "line_index": 48, "text": "Nu poți să îi bați mințile în cap,"}
{"category": "LocationDialogue Location13", "line_index": 49, "text": "Mita cea Nebună e ca o zeiță pentru ea."}
{"category": "LocationDialogue Location13", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 51, "text": "Da, am observat."}
{"category": "LocationDialogue Location13", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 53, "text": "Haide, trebuie să ajungem la nucleu."}
{"category": "LocationDialogue Location13", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 55, "text": "// Answer 4 (How does the ring work?)"}
{"category": "LocationDialogue Location13", "line_index": 56, "text": "Și inelul,"}
{"category": "LocationDialogue Location13", "line_index": 57, "text": "este singura cale către nucleu?"}
{"category": "LocationDialogue Location13", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 59, "text": "Da."}
{"category": "LocationDialogue Location13", "line_index": 60, "text": "Normal, dacă aveam portalul "}
{"category": "LocationDialogue Location13", "line_index": 61, "text": "aș fi putut să te teleportez "}
{"category": "LocationDialogue Location13", "line_index": 62, "text": "fix aici."}
{"category": "LocationDialogue Location13", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 64, "text": "Are vreun avantaj inelul?"}
{"category": "LocationDialogue Location13", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 66, "text": "Normal!"}
{"category": "LocationDialogue Location13", "line_index": 67, "text": "E ușor de purtat,"}
{"category": "LocationDialogue Location13", "line_index": 68, "text": "și ține minte versiunile"}
{"category": "LocationDialogue Location13", "line_index": 69, "text": "pe care le-ai vizitat,"}
{"category": "LocationDialogue Location13", "line_index": 70, "text": "ca să te poți întoarce ușor la ele."}
{"category": "LocationDialogue Location13", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 72, "text": "// Answer 5 (Why does Mad Mita need me?)"}
{"category": "LocationDialogue Location13", "line_index": 73, "text": "De ce nu mă poate lăsa în pace Mita cea Nebună?"}
{"category": "LocationDialogue Location13", "line_index": 74, "text": "M-a tras în jocul ei periculos,"}
{"category": "LocationDialogue Location13", "line_index": 75, "text": "și totuși sunt încă în viață..."}
{"category": "LocationDialogue Location13", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 77, "text": "Părerea mea"}
{"category": "LocationDialogue Location13", "line_index": 78, "text": "este că își caută un jucător potrivit..."}
{"category": "LocationDialogue Location13", "line_index": 79, "text": "Unul care să o accepte așa cum e."}
{"category": "LocationDialogue Location13", "line_index": 80, "text": "Până la urmă, Mita e Mita!"}
{"category": "LocationDialogue Location13", "line_index": 81, "text": "Deoarece este evident că acest lucru nu se va întâmpla niciodată,"}
{"category": "LocationDialogue Location13", "line_index": 82, "text": "îi transformă pe jucători în cartușe,"}
{"category": "LocationDialogue Location13", "line_index": 83, "text": "astfel încât nimeni să nu poată fugi..."}
{"category": "LocationDialogue Location13", "line_index": 84, "text": "Cel puțin asta cred eu."}
{"category": "LocationDialogue Location13", "line_index": 85, "text": "În fine, hai să ne axăm pe ceea ce e important."}
{"category": "LocationDialogue Location13", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 87, "text": "// Answer 6 (Is this the core?)"}
{"category": "LocationDialogue Location13", "line_index": 88, "text": "Ăsta este?"}
{"category": "LocationDialogue Location13", "line_index": 89, "text": "Nucleul?"}
{"category": "LocationDialogue Location13", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 91, "text": "Într-adevăr. Nucleul."}
{"category": "LocationDialogue Location13", "line_index": 92, "text": "Am încercat să vă explic,"}
{"category": "LocationDialogue Location13", "line_index": 93, "text": "voi jucătorii nu sunteți cu adevărat parte din lumea aceasta..."}
{"category": "LocationDialogue Location13", "line_index": 94, "text": "Însemnând, că nu aveți nevoie de o permisiune specială ca să intrați."}
{"category": "LocationDialogue Location13", "line_index": 95, "text": "Sau, cel puțin, asta cred eu."}
{"category": "LocationDialogue Location13", "line_index": 96, "text": "Oricum, sunt mai mult ca sigură"}
{"category": "LocationDialogue Location13", "line_index": 97, "text": "că soluția tuturor problemelor noastre"}
{"category": "LocationDialogue Location13", "line_index": 98, "text": "se găsește înăuntru!"}
{"category": "LocationDialogue Location13", "line_index": 99, "text": "[player], du-te înăuntru."}
{"category": "LocationDialogue Location13", "line_index": 100, "text": "Chiar ai reușit..."}
{"category": "LocationDialogue Location13", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 102, "text": "// Look on CoreMita"}
{"category": "LocationDialogue Location13", "line_index": 103, "text": "Ai grijă, [player]."}
{"category": "LocationDialogue Location13", "line_index": 104, "text": "Se uită la tine."}
{"category": "LocationDialogue Location13", "line_index": 105, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 106, "text": "Cine?"}
{"category": "LocationDialogue Location13", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 108, "text": "Nici eu nu știu..."}
{"category": "LocationDialogue Location13", "line_index": 109, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 110, "text": "Fain..."}
{"category": "LocationDialogue Location13", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 113, "text": "Ce e aia?"}
{"category": "LocationDialogue Location13", "line_index": 114, "text": "Hei!"}
{"category": "LocationDialogue Location13", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 116, "text": "Cred că am găsit-o!"}
{"category": "LocationDialogue Location13", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 118, "text": "Genial! Bravo!"}
{"category": "LocationDialogue Location13", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 120, "text": "Dar trebuie să specific versiunea."}
{"category": "LocationDialogue Location13", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 122, "text": "Corect, versiunea ei e..."}
{"category": "LocationDialogue Location13", "line_index": 123, "text": "00.98"}
{"category": "LocationDialogue Location13", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 125, "text": "Bingo!"}
{"category": "LocationDialogue Location13", "line_index": 126, "text": "Ok, care este indexul?"}
{"category": "LocationDialogue Location13", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 128, "text": "Uh, indexul?"}
{"category": "LocationDialogue Location13", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 130, "text": "Am nevoie de index."}
{"category": "LocationDialogue Location13", "line_index": 131, "text": "Stai, nu îmi spune că nu îl știi...?"}
{"category": "LocationDialogue Location13", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 134, "text": "Hmm, are sens totuși..."}
{"category": "LocationDialogue Location13", "line_index": 135, "text": "Fiecare Mita are un index,"}
{"category": "LocationDialogue Location13", "line_index": 136, "text": "ca să nu poți reporni o întreagă versiune..."}
{"category": "LocationDialogue Location13", "line_index": 137, "text": "Aia ar cauza o nebunie totală!"}
{"category": "LocationDialogue Location13", "line_index": 138, "text": "Nu îmi vine să cred că nu m-am gândit la asta..."}
{"category": "LocationDialogue Location13", "line_index": 139, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 144, "text": "// Answer 1 (What's wrong with you?)"}
{"category": "LocationDialogue Location13", "line_index": 145, "text": "Salvarea pentru toate problemele noastre,"}
{"category": "LocationDialogue Location13", "line_index": 146, "text": "nu am nimic."}
{"category": "LocationDialogue Location13", "line_index": 147, "text": "Totul e în regulă, dar multe s-au schimbat..."}
{"category": "LocationDialogue Location13", "line_index": 148, "text": "Trebuie să mă gândesc."}
{"category": "LocationDialogue Location13", "line_index": 149, "text": "Asta-i tot."}
{"category": "LocationDialogue Location13", "line_index": 150, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 151, "text": "// Answer 2 (Maybe there's a way to get to know him?)"}
{"category": "LocationDialogue Location13", "line_index": 152, "text": "Eu..."}
{"category": "LocationDialogue Location13", "line_index": 153, "text": "Eu cred... E nebunie curată!"}
{"category": "LocationDialogue Location13", "line_index": 154, "text": "E nebunie, hah!"}
{"category": "LocationDialogue Location13", "line_index": 155, "text": "E ca și cum ai căuta un ac într-o..."}
{"category": "LocationDialogue Location13", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 157, "text": "Ce faci?"}
{"category": "LocationDialogue Location13", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 159, "text": "Unele obstacole se erodează odată cu informația,"}
{"category": "LocationDialogue Location13", "line_index": 160, "text": "știi tu, ca și cum lumea ar avea mațele smulse!"}
{"category": "LocationDialogue Location13", "line_index": 161, "text": "Jurnale, jurnale, jurnale, date?"}
{"category": "LocationDialogue Location13", "line_index": 162, "text": "Dar dacă ăsta e răspunsul?"}
{"category": "LocationDialogue Location13", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 164, "text": "Huh? Care e problema?"}
{"category": "LocationDialogue Location13", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 166, "text": "Știu un loc!"}
{"category": "LocationDialogue Location13", "line_index": 167, "text": "Așteaptă aici."}
{"category": "LocationDialogue Location13", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 169, "text": "Unde te duci?"}
{"category": "LocationDialogue Location13", "line_index": 170, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 171, "text": "// Answer 3 (What if we attack Mad Mita?)"}
{"category": "LocationDialogue Location13", "line_index": 172, "text": "Ai spus că orice Mita"}
{"category": "LocationDialogue Location13", "line_index": 173, "text": "se resetează din fabrică la moarte..."}
{"category": "LocationDialogue Location13", "line_index": 174, "text": "Ce-ar fi dacă..."}
{"category": "LocationDialogue Location13", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 176, "text": "o omorâm pe Mita cea Nebună?"}
{"category": "LocationDialogue Location13", "line_index": 177, "text": "Vorbești serios?"}
{"category": "LocationDialogue Location13", "line_index": 178, "text": "Și cum te vei confrunta cu o nebună cu drujba?"}
{"category": "LocationDialogue Location13", "line_index": 179, "text": "Ea taie morcovi cu mai mult decât cuțite!"}
{"category": "LocationDialogue Location13", "line_index": 180, "text": "Și pentru nu știu ce motiv, e înspăimântător de puternică!"}
{"category": "LocationDialogue Location13", "line_index": 181, "text": "E un miracol că încă suntem în viață..."}
{"category": "LocationDialogue Location13", "line_index": 182, "text": "Haide, trebuie să ajungem la nucleu."}
{"category": "LocationDialogue Location13", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 185, "text": "// core console entry"}
{"category": "LocationDialogue Location13", "line_index": 186, "text": "Trebuie să introducem un cod..."}
{"category": "LocationDialogue Location13", "line_index": 187, "text": "Dar de unde îl aflu?"}
{"category": "LocationDialogue Location13", "line_index": 188, "text": "Mita, ai tu vreo idee?"}
{"category": "LocationDialogue Location13", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 190, "text": "Poate e listat pe acolo pe undeva?"}
{"category": "LocationDialogue Location13", "line_index": 191, "text": "Încearcă să îl cauți."}
{"category": "LocationDialogue Location13", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 193, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location13", "line_index": 194, "text": "Nu cred că e ăla."}
{"category": "LocationDialogue Location13", "line_index": 195, "text": "Nici ăla nu e corect."}
{"category": "LocationDialogue Location13", "line_index": 196, "text": "Nup, greșit."}
{"category": "LocationDialogue Location13", "line_index": 197, "text": "Nu e ăla."}
{"category": "LocationDialogue Location13", "line_index": 198, "text": "Trebuie să găsesc opțiunea de resetare a caracterului."}
{"category": "LocationDialogue Location13", "line_index": 199, "text": "// core console - nope version"}
{"category": "LocationDialogue Location13", "line_index": 200, "text": "Aia e versiunea greșită."}
{"category": "LocationDialogue Location13", "line_index": 201, "text": "Oops, greșeala mea."}
{"category": "LocationDialogue Location13", "line_index": 202, "text": "Nu e aia."}
{"category": "LocationDialogue Location13", "line_index": 203, "text": "O să am nevoie de încă una."}
{"category": "LocationDialogue Location13", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location13", "line_index": 205, "text": "Ceva e în neregulă"}
{"category": "LocationDialogue Location13", "line_index": 206, "text": "cu indexul."}
{"category": "LocationDialogue Location13", "line_index": 207, "text": "Trebuie să schimb indexul,"}
{"category": "LocationDialogue Location13", "line_index": 208, "text": "nu se potrivește."}
{"category": "LocationDialogue Location13", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 210, "text": "// Answer 4 (Little people - Chibi)"}
{"category": "LocationDialogue Location13", "line_index": 211, "text": "Ascultă, am întâlnit o grămadă de"}
{"category": "LocationDialogue Location13", "line_index": 212, "text": "mini-oamenii pe drum..."}
{"category": "LocationDialogue Location13", "line_index": 213, "text": "Ce sunt aceia?"}
{"category": "LocationDialogue Location13", "line_index": 214, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 215, "text": "Cei Chibi?"}
{"category": "LocationDialogue Location13", "line_index": 216, "text": "Uh, cum să îți explic...?"}
{"category": "LocationDialogue Location13", "line_index": 217, "text": "E un fenomen aici..."}
{"category": "LocationDialogue Location13", "line_index": 218, "text": "Fiecare Mita are o proiecție Chibi,"}
{"category": "LocationDialogue Location13", "line_index": 219, "text": "până și jucătorii îi pot avea..."}
{"category": "LocationDialogue Location13", "line_index": 220, "text": "Știai că noi Mitele le putem invoca?"}
{"category": "LocationDialogue Location13", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 222, "text": "Huh, cum?"}
{"category": "LocationDialogue Location13", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 224, "text": "Uită-te la asta!"}
{"category": "LocationDialogue Location13", "line_index": 225, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 226, "text": "Exact ca prin magie..."}
{"category": "LocationDialogue Location13", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 228, "text": "Dar ceva e în neregulă cu Chibi-urile mele,"}
{"category": "LocationDialogue Location13", "line_index": 229, "text": "majoritatea se nasc moarte."}
{"category": "LocationDialogue Location13", "line_index": 230, "text": "E asta totuși..."}
{"category": "LocationDialogue Location13", "line_index": 231, "text": "Sau bine,"}
{"category": "LocationDialogue Location13", "line_index": 232, "text": "ea doar aleargă în cercuri."}
