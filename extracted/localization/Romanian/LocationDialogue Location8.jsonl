{"category": "LocationDialogue Location8", "line_index": 0, "text": "// The first meeting"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "Cine ești?"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "Ce s-a întâmplat?"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "Nu poți vorbi?"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "Stai..."}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "Vrei să pleci, nu-i așa?"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "Da..."}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "Trebuie să mă întorc "}
{"category": "LocationDialogue Location8", "line_index": 11, "text": "la versiunea anterioară."}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "Versiunea anterioară?"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "De ce să pleci"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "altundeva?"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "De ce nu rămâi aici"}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "și să-mi fi"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "al doilea prieten?"}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Skipping all dialogs"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "Ok..."}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Standing by the window (Random)"}
{"category": "LocationDialogue Location8", "line_index": 24, "text": "Nu vei găsi calea prin uși."}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "Se pare că te grăbești..."}
{"category": "LocationDialogue Location8", "line_index": 26, "text": "Alergând în cercuri nu te va salva."}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "Atât de dornic să evadezi?"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "Uite-te pe fereastră..."}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Aren't you Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "Jucător... ești un jucător, nu-i așa?"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": "Ne putem juca împreună."}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "Daca îmi pot aduna puterile,"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": "tot ce trebuie să facem este să ne jucăm."}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (What happened to you?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "Nu sunt sigură, și să fiu sinceră nu am nicio idee..."}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "Nu cred că s-a întâmplat ceva râu..."}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "Dar parcă toate lucrurile bune dispar..."}
{"category": "LocationDialogue Location8", "line_index": 41, "text": "Totuși, măcar am un prieten."}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "De ce m-au părăsit?"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "Nu am fost de ajuns?"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "Mi-e frică..."}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Quest 3 (Become a second friend?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "Prieteni..."}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "Nu mai am mulți."}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "Numai unul mai este..."}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "Sunt tristă, jucătorule."}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "Vrei să fim prieteni?"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "Mi-ar plăcea,"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "dar trebuie să plec..."}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "Mă doare inima..."}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Is this your house?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "Acasă?"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "Jucătorule...te-ai schimbat..."}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "Mâinile tale sunt mai scurte, și nu mai ești atât de nervos..."}
{"category": "LocationDialogue Location8", "line_index": 62, "text": "Jucătorule, ai devenit mai blând, mai amabil."}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "Nu sunt sigur..."}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "ce înseamnă aia."}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "E în regulă..."}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "pentru că nu voi mai suferi, nu-i așa?"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (How do I leave this place?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "Chiar mă vei părăsi?"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "Poate că acesta este doar..."}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "destinul meu?"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "Eu..."}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": "Ușile nu te vor ajuta."}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Hold player (Random)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "De ce să pleci?"}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "Stai aici..."}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "Joacă-te cu mine..."}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "Jucătorule..."}
