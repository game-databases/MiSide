{"category": "LocationDialogue Location6", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "Mita?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "Cum naiba ai ajuns aici?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Ești Mita nu?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Dar ceva este diferit..."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "Ești perspicace din câte văd."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "Și ai dreptate."}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "Nu sunt aceeași Mita de mai devreme."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Ai grijă, plănuiește "}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "ceva sinistru."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "Huh, ceva sinistru?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "N-am timp să-ți explic:"}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "Dacă asta funcționează, îți voi spune totul."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Ia cheia. E lângă canapea."}
{"category": "LocationDialogue Location6", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Dar..."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "Întrebările să aștepte!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Dă-mi cheia."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Ia inelul ăsta."}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "Ce?"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Vrei să scapi de aici, nu?"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "Uhm, da..."}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Atunci puneți-l."}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "E un artefact folositor,"}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "o să îți fie folositor in curând."}
{"category": "LocationDialogue Location6", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Ok..."}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "Apropo, eu sunt"}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Mmm,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "Sunt... Mita."}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// MitaKind quest 1"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "Vezi aia"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "consola? Ia-o."}
{"category": "LocationDialogue Location6", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "Privim o înregistrare?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "Cine e acolo cu ea?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "Asta se întâmplă chiar în secunda asta."}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "E un alt jucător."}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Ea îl folosește."}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Va încerca să te transforme"}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "și pe tine într-un cartuș."}
{"category": "LocationDialogue Location6", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "Trebuie să scap de aici imediat."}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "Și tu la fel."}
{"category": "LocationDialogue Location6", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "Da, ai dreptate."}
{"category": "LocationDialogue Location6", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "Deci vrei să spui"}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "că se folosește de el."}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "Dacă scot cartușul ce se va întâmpla?"}
{"category": "LocationDialogue Location6", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "Aia va"}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "distruge cartușul complet."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "Ceea ce ar însemna..."}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "jucătorul ar muri."}
{"category": "LocationDialogue Location6", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "..."}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "Ce dacă îl opresc?"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "Asta ar putea funcționa..."}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Merită încercat. E un buton roșu!"}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Îl vezi?"}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "L-ai găsit."}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "Apasă-l."}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// MitaKind quest 2"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Trebuie să rămân."}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "Sunt întrebări pe care trebuie să i le pun"}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "să aflu mai multe despre ea."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "Cu toate că e puțin probabil ca ea să..."}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// MitaKind quest 3"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "Să-ți spun adevărul, asta este versiunea mea."}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "Îi țineam companie unui jucător,"}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "când ceva s-a schimbat brusc."}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "Apoi a apărut ea..."}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "și a transformat jucătorul într-un cartuș"}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "și m-a încuiat."}
{"category": "LocationDialogue Location6", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Stai, ea l-a transformat într-un cartuș?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "Chiar poate face asta?"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "Dar de ce?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "Pentru ce are nevoie de jucători?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "E clar că e nebună..."}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Se joacă cu noi și ne folosește pentru propriile ei mașinării!"}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "Transformă jucătorii în cartușe..."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Unii nici nu și-au dat seama ce li se întâmplă..."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "Iar unii care și-au dat seama, nici măcar nu au ripostat... Uf!"}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "Asta e o întorsătură întunecată..."}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "Tu trebuie să ne ajuți!"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "Eu? Dar cum?"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "Am nevoie de tine!"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "Dacă ne ajuți, te voi ajuta și eu!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Asta ar putea fi singura noastră șansă."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "Inelul te va duce la versiunea corectă."}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "Ne întâlnim acolo."}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// MitaKind quest 4"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "Încă nu prea înțeleg"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "ce am văzut acolo sus..."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Acea Mita..."}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "Încerca să mă omoare?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "Să te omoare?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Are pregătită o soartă mai rea decât asta pentru tine..."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "Trebuie să te grăbești."}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Hide!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "La naiba! Ascunde-te!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Stai, ce...?"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Grăbește-te, vine!"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "Urmărește inelul - te va duce la siguranță!"}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "Ei bine, bine, o să-mi spui unde e?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "De ce aș face-o?"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "Nu-l vei omorî, nu-i așa?"}
{"category": "LocationDialogue Location6", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Ah, deci refuzi să-mi spui."}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Eh, îmi plac provocările."}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "Știu că e undeva pe aici."}
{"category": "LocationDialogue Location6", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "De ce ești atât de rea cu noi?"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "Nici măcar nu vrei să-mi spui ce se întâmplă!"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "În plus..."}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "de ce ai nevoie de jucători?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "Nu sunt jucării!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "Ce te-a apucat?!"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "Ajunge! Ține-ți gura închisă, păpușă!"}
