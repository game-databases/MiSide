{"category": "LocationDialogue Location9", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Hei, tu!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Bună!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Vrei să scapi?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Atunci ajută-mă să găsesc cheia!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Of! Nicio cheie aici!"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Nimic aici-"}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "zero, zip, nada!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Am găsit-o!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// The usual conversation"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Huh, am crezut că ești mai scund!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "Ești înalt-"}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "exact ca sora mea!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "Sora ta? Ce-i cu ea?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Da, sora mea."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Să nu spui că n-ai întâlnit-o niciodată!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Uh... Am întâlnit-o... Cred că da?"}
{"category": "LocationDialogue Location9", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Ești un bufon?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "Erm..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "Se pare că ești..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "Haide, ajută-mă să găsesc cheia!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// Next work"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Vino."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Pune fierul în țeavă!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Mulțumesc!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "Acum adu-mi lemnul ăla!"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Mulțumesc!"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Mai ajută-mă, te rog!"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Gata! Acum..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "uau, e frumos."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Apasă-l, haide!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Fii gata..."}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "acolo, ia-o!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "Cheia este a ta!"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// Quest 1 (Are you Mita?)"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Eu sunt ChibiMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Tone de linii,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "cele mai simple modele, și-"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "cel mai bun din toate - un păr superb!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// Quest 2 (Have we seen each other yet?)"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Prostuțule!"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "Ești destul de drăguț, să știi,"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "ca să pui întrebări prostești ca asta."}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Totuși,"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "aceasta este prima dată când te întâlnesc!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Dar ascultă..."}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Dacă îmi furi privirea minunată,"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "o să te fac să regreți!"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// Quest 3 (Why are you here?)"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Nu înțelegi?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "Acesta este un punct de control-"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "un test al inteligenței tale!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "Acum, haide!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Sunt aici pentru a-i ghida pe cei pierduți fără speranță!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// Quest 4 (Why are you helping me?)"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "Ce te face atât de special?"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "De ce să nu te ajut oricum?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "De ce?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Atât de prostesc..."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Ai apărut de nicăieri!"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Nu trebuia să fii aici,"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "așa că, te ajut!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Pa-pa, prostuțule!"}
