{"category": "LocationDialogue Location4", "line_index": 0, "text": "Mita?"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "Te-ai trezit deja?"}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "Cum ai ajuns aici?"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": "Doar ce erai lângă mine."}
{"category": "LocationDialogue Location4", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 5, "text": "Nu, nu eram."}
{"category": "LocationDialogue Location4", "line_index": 6, "text": "Ai înghețat în fața oglinzii."}
{"category": "LocationDialogue Location4", "line_index": 7, "text": "Așa că am plecat."}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "De ce s-au schimbat camerele?"}
{"category": "LocationDialogue Location4", "line_index": 9, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "Am rearanjat locul"}
{"category": "LocationDialogue Location4", "line_index": 11, "text": "ca să te simți ca și cum ai fi acasă "}
{"category": "LocationDialogue Location4", "line_index": 12, "text": "Aici,"}
{"category": "LocationDialogue Location4", "line_index": 13, "text": "putem schimba camerele "}
{"category": "LocationDialogue Location4", "line_index": 14, "text": "cum vrem noi."}
{"category": "LocationDialogue Location4", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 16, "text": "Nu trebuia."}
{"category": "LocationDialogue Location4", "line_index": 17, "text": "Începusem să mă obișnuiesc cu aranjamentul."}
{"category": "LocationDialogue Location4", "line_index": 18, "text": "În orice caz, cred că te vei simți mai în largul tău așa."}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Mita card game"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "Bun,"}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "putem începe?"}
{"category": "LocationDialogue Location4", "line_index": 22, "text": "Astea sunt regulile jocului:"}
{"category": "LocationDialogue Location4", "line_index": 23, "text": "Acest jeton indică un tip,"}
{"category": "LocationDialogue Location4", "line_index": 24, "text": "de exemplu viața."}
{"category": "LocationDialogue Location4", "line_index": 25, "text": "Amândoi jucăm o carte,"}
{"category": "LocationDialogue Location4", "line_index": 26, "text": "dacă cartea ta"}
{"category": "LocationDialogue Location4", "line_index": 27, "text": "are mai multă viață "}
{"category": "LocationDialogue Location4", "line_index": 28, "text": "decât cartea mea,"}
{"category": "LocationDialogue Location4", "line_index": 29, "text": "câștigi. "}
{"category": "LocationDialogue Location4", "line_index": 30, "text": "Trage-ți cărțile. "}
{"category": "LocationDialogue Location4", "line_index": 31, "text": "E rândul meu acum. "}
{"category": "LocationDialogue Location4", "line_index": 32, "text": "Uau!"}
{"category": "LocationDialogue Location4", "line_index": 33, "text": "Ce mână bună am!"}
{"category": "LocationDialogue Location4", "line_index": 34, "text": "Eu sunt prima!"}
{"category": "LocationDialogue Location4", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 44, "text": "OK!"}
{"category": "LocationDialogue Location4", "line_index": 45, "text": "Rândul tău!"}
{"category": "LocationDialogue Location4", "line_index": 46, "text": "Aha."}
{"category": "LocationDialogue Location4", "line_index": 47, "text": "Rândul tău!"}
{"category": "LocationDialogue Location4", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 49, "text": "Cea mai mare viață câștigă!"}
{"category": "LocationDialogue Location4", "line_index": 50, "text": "Numai atacul contează!"}
{"category": "LocationDialogue Location4", "line_index": 51, "text": "Focusează-te pe defensivă!"}
{"category": "LocationDialogue Location4", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 54, "text": "Ai câștigat!"}
{"category": "LocationDialogue Location4", "line_index": 55, "text": "Ai câștigat!"}
{"category": "LocationDialogue Location4", "line_index": 56, "text": "M-ai luat."}
{"category": "LocationDialogue Location4", "line_index": 57, "text": "Tu..."}
{"category": "LocationDialogue Location4", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 59, "text": "Am câștigat!"}
{"category": "LocationDialogue Location4", "line_index": 60, "text": "Eu sunt câștigătoarea!"}
{"category": "LocationDialogue Location4", "line_index": 61, "text": "Am câștigat!"}
{"category": "LocationDialogue Location4", "line_index": 62, "text": "Ha, te-am luat!"}
{"category": "LocationDialogue Location4", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 64, "text": "E o remiză."}
{"category": "LocationDialogue Location4", "line_index": 65, "text": "Suntem egali!"}
{"category": "LocationDialogue Location4", "line_index": 66, "text": "Aia e o remiză!"}
{"category": "LocationDialogue Location4", "line_index": 67, "text": "Aceeași valoare..."}
{"category": "LocationDialogue Location4", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 79, "text": "// The card game is interrupted"}
{"category": "LocationDialogue Location4", "line_index": 80, "text": "Ce e sunetul ăla?"}
{"category": "LocationDialogue Location4", "line_index": 81, "text": "Vine dinspre dulap."}
{"category": "LocationDialogue Location4", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 83, "text": "Sunet?"}
{"category": "LocationDialogue Location4", "line_index": 84, "text": "Ce sunet?"}
{"category": "LocationDialogue Location4", "line_index": 85, "text": "Nu am auzit nimic."}
{"category": "LocationDialogue Location4", "line_index": 86, "text": "Ce crezi ca ai auzit?"}
{"category": "LocationDialogue Location4", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 88, "text": "Ca și cum cineva ciocăne."}
{"category": "LocationDialogue Location4", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 90, "text": "Dar..."}
{"category": "LocationDialogue Location4", "line_index": 91, "text": "Nu e nimeni acolo..."}
{"category": "LocationDialogue Location4", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 93, "text": "Aș dori să verific."}
{"category": "LocationDialogue Location4", "line_index": 94, "text": "Sunt un pic speriat."}
{"category": "LocationDialogue Location4", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 96, "text": "Dar de ce...?"}
{"category": "LocationDialogue Location4", "line_index": 97, "text": "Din nou asta..."}
{"category": "LocationDialogue Location4", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 105, "text": "Ce e cu tine!?"}
{"category": "LocationDialogue Location4", "line_index": 106, "text": "E un simplu dulap..."}
{"category": "LocationDialogue Location4", "line_index": 107, "text": "Am lenjerie acolo...!"}
{"category": "LocationDialogue Location4", "line_index": 108, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 109, "text": "Ascunzi ceva de mine?"}
{"category": "LocationDialogue Location4", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 111, "text": "De ce nu mă crezi? "}
{"category": "LocationDialogue Location4", "line_index": 112, "text": "Ce fac greșit?"}
{"category": "LocationDialogue Location4", "line_index": 113, "text": "Tot ce vreau..."}
{"category": "LocationDialogue Location4", "line_index": 114, "text": "este ca tu să fi cu mine."}
{"category": "LocationDialogue Location4", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 116, "text": "Și eu vreau asta, dar totuși...?"}
{"category": "LocationDialogue Location4", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 118, "text": "De ce ești așa de obsedat de dulapul ăsta?!"}
{"category": "LocationDialogue Location4", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 120, "text": "Vreau să aflu ce naiba a fost acel ciocănit!"}
{"category": "LocationDialogue Location4", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 122, "text": "E cumva din cauza că"}
{"category": "LocationDialogue Location4", "line_index": 123, "text": "lumea aceasta"}
{"category": "LocationDialogue Location4", "line_index": 124, "text": "are doar patru camere?"}
{"category": "LocationDialogue Location4", "line_index": 125, "text": "Nu e destul pentru tine? "}
{"category": "LocationDialogue Location4", "line_index": 126, "text": "De ce nu poți rămâne cu mine?"}
{"category": "LocationDialogue Location4", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 129, "text": "// Don't stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 130, "text": "Înțeleg."}
{"category": "LocationDialogue Location4", "line_index": 131, "text": "Asta din nou..."}
{"category": "LocationDialogue Location4", "line_index": 132, "text": "Dacă vrei sa verifici ce e în dulap,"}
{"category": "LocationDialogue Location4", "line_index": 133, "text": "atunci fă-o,"}
{"category": "LocationDialogue Location4", "line_index": 134, "text": "și află ce e înăuntru!"}
{"category": "LocationDialogue Location4", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 139, "text": "Ce naiba..."}
{"category": "LocationDialogue Location4", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 141, "text": "Se mai întâmplă din când în când."}
{"category": "LocationDialogue Location4", "line_index": 142, "text": "Camera s-a blocat încărcându-se."}
{"category": "LocationDialogue Location4", "line_index": 143, "text": "Doar așteaptă un pic."}
{"category": "LocationDialogue Location4", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 145, "text": "Asta e așa de ciudat."}
{"category": "LocationDialogue Location4", "line_index": 146, "text": "Suntem in telefonul cuiva?"}
{"category": "LocationDialogue Location4", "line_index": 147, "text": "Poate unul mai slab cu încărcări mai lungi?"}
{"category": "LocationDialogue Location4", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 149, "text": "Deloc."}
{"category": "LocationDialogue Location4", "line_index": 150, "text": "Dar nu totul e perfect"}
{"category": "LocationDialogue Location4", "line_index": 151, "text": "în lumea asta..."}
{"category": "LocationDialogue Location4", "line_index": 152, "text": "Suntem încărcați "}
{"category": "LocationDialogue Location4", "line_index": 153, "text": "împreună cu nucleul lumii."}
{"category": "LocationDialogue Location4", "line_index": 154, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 155, "text": "Nucleul lumii?"}
{"category": "LocationDialogue Location4", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 157, "text": "Tipic, nu crezi?"}
{"category": "LocationDialogue Location4", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 159, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 161, "text": "În fine,"}
{"category": "LocationDialogue Location4", "line_index": 162, "text": "putem să ne jucăm pe consolă"}
{"category": "LocationDialogue Location4", "line_index": 163, "text": "sau cărți."}
{"category": "LocationDialogue Location4", "line_index": 164, "text": "Tu alegi."}
{"category": "LocationDialogue Location4", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 167, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 168, "text": "// Mita play fight"}
{"category": "LocationDialogue Location4", "line_index": 169, "text": "Vrei să ne batem?"}
{"category": "LocationDialogue Location4", "line_index": 170, "text": "Trebuie să câștigi "}
{"category": "LocationDialogue Location4", "line_index": 171, "text": "de patru ori. "}
{"category": "LocationDialogue Location4", "line_index": 172, "text": "Hai să începem."}
{"category": "LocationDialogue Location4", "line_index": 173, "text": "Nu îți face griji,"}
{"category": "LocationDialogue Location4", "line_index": 174, "text": "o voi lăsa mai ușor la început."}
{"category": "LocationDialogue Location4", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 176, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 177, "text": "Ce băiat bun ești."}
{"category": "LocationDialogue Location4", "line_index": 178, "text": "Ai face bine să te concentrezi!"}
{"category": "LocationDialogue Location4", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 180, "text": "Ua!"}
{"category": "LocationDialogue Location4", "line_index": 181, "text": "Ok, bun."}
{"category": "LocationDialogue Location4", "line_index": 182, "text": "Voi deveni serioasă acum."}
{"category": "LocationDialogue Location4", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 184, "text": "Uau!"}
{"category": "LocationDialogue Location4", "line_index": 185, "text": "Hai să vedem "}
{"category": "LocationDialogue Location4", "line_index": 186, "text": "dacă mă poți învinge acum!"}
{"category": "LocationDialogue Location4", "line_index": 187, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 188, "text": "Ești"}
{"category": "LocationDialogue Location4", "line_index": 189, "text": "pur și simplu"}
{"category": "LocationDialogue Location4", "line_index": 190, "text": "incredibil! Ești un talent înnăscut!"}
{"category": "LocationDialogue Location4", "line_index": 191, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 193, "text": "Ce s-a întâmplat?"}
{"category": "LocationDialogue Location4", "line_index": 194, "text": "Huh, asta e plictisitor."}
{"category": "LocationDialogue Location4", "line_index": 195, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 196, "text": "Păi,"}
{"category": "LocationDialogue Location4", "line_index": 197, "text": "asta e. Crezi în soartă?"}
{"category": "LocationDialogue Location4", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 199, "text": "Atunci,"}
{"category": "LocationDialogue Location4", "line_index": 200, "text": "revino-ți sau vei fi un pierzător pentru totdeauna!"}
{"category": "LocationDialogue Location4", "line_index": 201, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 202, "text": "Ce ai pățit astăzi?"}
{"category": "LocationDialogue Location4", "line_index": 203, "text": "Am spălat pe jos cu tine. "}
{"category": "LocationDialogue Location4", "line_index": 204, "text": "Nu ți-ai dat deloc silința-"}
{"category": "LocationDialogue Location4", "line_index": 205, "text": "de aceea am câștigat!"}
{"category": "LocationDialogue Location4", "line_index": 206, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 208, "text": "Bun, atunci."}
{"category": "LocationDialogue Location4", "line_index": 209, "text": "Ce-ar fi să jucăm niște cărți?"}
{"category": "LocationDialogue Location4", "line_index": 210, "text": "Sunt în dormitor."}
{"category": "LocationDialogue Location4", "line_index": 211, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 214, "text": "// Door > [ERROR]"}
{"category": "LocationDialogue Location4", "line_index": 215, "text": "Huh, ce se întâmplă?"}
{"category": "LocationDialogue Location4", "line_index": 216, "text": "Unde e..."}
{"category": "LocationDialogue Location4", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 218, "text": "Uh-oh."}
{"category": "LocationDialogue Location4", "line_index": 219, "text": "Scuze..."}
{"category": "LocationDialogue Location4", "line_index": 220, "text": "Am descărcat "}
{"category": "LocationDialogue Location4", "line_index": 221, "text": "ceva de pe net."}
{"category": "LocationDialogue Location4", "line_index": 222, "text": "Am vrut să"}
{"category": "LocationDialogue Location4", "line_index": 223, "text": "înfrumusețez umpic exteriorul."}
{"category": "LocationDialogue Location4", "line_index": 224, "text": "Dar se pare că, "}
{"category": "LocationDialogue Location4", "line_index": 225, "text": "ceva era în neregulă cu fișierul. "}
{"category": "LocationDialogue Location4", "line_index": 226, "text": "Îl voi repara mai târziu."}
{"category": "LocationDialogue Location4", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 228, "text": "De aia nu putem ieși din casă? "}
{"category": "LocationDialogue Location4", "line_index": 229, "text": "Exact."}
{"category": "LocationDialogue Location4", "line_index": 230, "text": "// Mita shy"}
{"category": "LocationDialogue Location4", "line_index": 231, "text": "Hei..."}
{"category": "LocationDialogue Location4", "line_index": 232, "text": "Ce se întâmplă cu tine?"}
{"category": "LocationDialogue Location4", "line_index": 233, "text": "Vrei ceva?"}
{"category": "LocationDialogue Location4", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 236, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 237, "text": "// Wall Clock"}
{"category": "LocationDialogue Location4", "line_index": 238, "text": "Ăsta aici ceas,"}
{"category": "LocationDialogue Location4", "line_index": 239, "text": "ce oră arată?"}
{"category": "LocationDialogue Location4", "line_index": 240, "text": "Ora actuală din joc?"}
{"category": "LocationDialogue Location4", "line_index": 241, "text": "Sau este sincronizată cu telefonul meu?"}
{"category": "LocationDialogue Location4", "line_index": 242, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 243, "text": "Păi, uhh..."}
{"category": "LocationDialogue Location4", "line_index": 244, "text": "Sincer habar n-am."}
{"category": "LocationDialogue Location4", "line_index": 245, "text": "Dar timpul nu are rost aici..."}
{"category": "LocationDialogue Location4", "line_index": 246, "text": "Fie că este târziu sau devreme,"}
{"category": "LocationDialogue Location4", "line_index": 247, "text": "o fată puternică ca și mine "}
{"category": "LocationDialogue Location4", "line_index": 248, "text": "este mereu plină de energie—"}
{"category": "LocationDialogue Location4", "line_index": 249, "text": "nu obosesc niciodată!"}
{"category": "LocationDialogue Location4", "line_index": 250, "text": "Putem avea o primăvară eternă,"}
{"category": "LocationDialogue Location4", "line_index": 251, "text": "sau o după-amiază nesfârșită!"}
{"category": "LocationDialogue Location4", "line_index": 252, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 253, "text": "Interesant..."}
{"category": "LocationDialogue Location4", "line_index": 254, "text": "dar și umpic înspăimântător."}
{"category": "LocationDialogue Location4", "line_index": 255, "text": "Blocat in același moment, pentru totdeauna..."}
{"category": "LocationDialogue Location4", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 258, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 259, "text": "// Photos of Mita"}
{"category": "LocationDialogue Location4", "line_index": 260, "text": "Faine poze."}
{"category": "LocationDialogue Location4", "line_index": 261, "text": "Presupun ca tu ești in ele?"}
{"category": "LocationDialogue Location4", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 263, "text": "Dap."}
{"category": "LocationDialogue Location4", "line_index": 264, "text": "Și mie îmi plac."}
{"category": "LocationDialogue Location4", "line_index": 265, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 266, "text": "Cine le-a făcut?"}
{"category": "LocationDialogue Location4", "line_index": 267, "text": "Sunt și alții în lumea asta?"}
{"category": "LocationDialogue Location4", "line_index": 268, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 269, "text": "Ai putea spune asta."}
{"category": "LocationDialogue Location4", "line_index": 270, "text": "O să faci cunoștință și cu ele eventual."}
{"category": "LocationDialogue Location4", "line_index": 271, "text": "Dar nu acum."}
{"category": "LocationDialogue Location4", "line_index": 272, "text": "Momentan, aș vrea să fi doar cu mine."}
{"category": "LocationDialogue Location4", "line_index": 273, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 275, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 276, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 277, "text": "// Portal"}
{"category": "LocationDialogue Location4", "line_index": 278, "text": "Unde a dispărut portalul?"}
{"category": "LocationDialogue Location4", "line_index": 279, "text": "Sau cum l-ai numit tu?"}
{"category": "LocationDialogue Location4", "line_index": 280, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 281, "text": "Am folosit"}
{"category": "LocationDialogue Location4", "line_index": 282, "text": "umpic de magie"}
{"category": "LocationDialogue Location4", "line_index": 283, "text": "și l-am mutat"}
{"category": "LocationDialogue Location4", "line_index": 284, "text": "altundeva."}
{"category": "LocationDialogue Location4", "line_index": 285, "text": "Nu mai avem nevoie de el."}
{"category": "LocationDialogue Location4", "line_index": 286, "text": "Doar ne-ar încurca."}
{"category": "LocationDialogue Location4", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 288, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 289, "text": "// Mirror in the bedroom"}
{"category": "LocationDialogue Location4", "line_index": 290, "text": "Uitându-mă într-o oglindă "}
{"category": "LocationDialogue Location4", "line_index": 291, "text": "fără să mă pot vedea—e dubios."}
{"category": "LocationDialogue Location4", "line_index": 292, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 293, "text": "Putem să activăm reflexiile, "}
{"category": "LocationDialogue Location4", "line_index": 294, "text": "dacă vrei neapărat."}
{"category": "LocationDialogue Location4", "line_index": 295, "text": "Dar, chiar avem nevoie de ele?"}
{"category": "LocationDialogue Location4", "line_index": 296, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 297, "text": "Normal că avem nevoie de ele."}
{"category": "LocationDialogue Location4", "line_index": 298, "text": "Sau... pornirea lor va aduce consecințe?"}
{"category": "LocationDialogue Location4", "line_index": 299, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 300, "text": "Da."}
{"category": "LocationDialogue Location4", "line_index": 301, "text": "Ne vom întrerupe și ne vom mișca mai încet."}
{"category": "LocationDialogue Location4", "line_index": 302, "text": "Ai văzut vreodată un desen animat în puține cadre pe secundă?"}
{"category": "LocationDialogue Location4", "line_index": 303, "text": "Așa va fi pentru noi, constant."}
{"category": "LocationDialogue Location4", "line_index": 304, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 305, "text": "Am înțeles."}
{"category": "LocationDialogue Location4", "line_index": 306, "text": "Atunci am face bine să ținem reflexiile dezactivate..."}
{"category": "LocationDialogue Location4", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 308, "text": "Hei, [player], "}
{"category": "LocationDialogue Location4", "line_index": 309, "text": "chiar iți plac oglinzile, nu-i așa?"}
{"category": "LocationDialogue Location4", "line_index": 310, "text": "Ție frică să zâmbești?"}
{"category": "LocationDialogue Location4", "line_index": 311, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 312, "text": "Huh? Nu chiar..."}
{"category": "LocationDialogue Location4", "line_index": 313, "text": "Sunt doar obosit"}
{"category": "LocationDialogue Location4", "line_index": 314, "text": "după toată munca de azi."}
{"category": "LocationDialogue Location4", "line_index": 315, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 316, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 317, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 318, "text": "// Blue sneakers"}
{"category": "LocationDialogue Location4", "line_index": 319, "text": "Ăștia sunt ai tăi?"}
{"category": "LocationDialogue Location4", "line_index": 320, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 321, "text": "Nup, sunt ai tăi."}
{"category": "LocationDialogue Location4", "line_index": 322, "text": "Nu îți amintești?"}
{"category": "LocationDialogue Location4", "line_index": 323, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 324, "text": "Nu-mi amintesc să fi avut astfel de adidași."}
{"category": "LocationDialogue Location4", "line_index": 325, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 326, "text": "Acum ai."}
{"category": "LocationDialogue Location4", "line_index": 327, "text": "Îi poți purta "}
{"category": "LocationDialogue Location4", "line_index": 328, "text": "când mergem afară."}
{"category": "LocationDialogue Location4", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 330, "text": "Cum rămâne cu hainele?"}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "Tot ce am în lumea asta"}
{"category": "LocationDialogue Location4", "line_index": 332, "text": "sunt hainele pe care le port."}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "Este vreo metodă prin care pot face rost de unele noi?"}
{"category": "LocationDialogue Location4", "line_index": 334, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 335, "text": "Normal că există."}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "Totuși, am văzut ce tip de haine porți—"}
{"category": "LocationDialogue Location4", "line_index": 337, "text": "și să fiu sinceră, gusturile tale nu sunt prea grozave."}
{"category": "LocationDialogue Location4", "line_index": 338, "text": "Oricum, te voi ajuta să îți găsești niște haine."}
{"category": "LocationDialogue Location4", "line_index": 339, "text": "Nu acum totuși."}
{"category": "LocationDialogue Location4", "line_index": 340, "text": "Promit."}
{"category": "LocationDialogue Location4", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 342, "text": "Ok."}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Games on TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "Ce vrei să ne jucăm?"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Game milk"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "Acesta este un joc de luptă!"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "Hai să vedem cine se va acri primul!"}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "Ce mai joc!"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": "Am băut destul lapte momentan, hai să facem altceva."}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Game penguins"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "În jocul ăsta, ești un pinguin,"}
{"category": "LocationDialogue Location4", "line_index": 354, "text": "care alunecă."}
{"category": "LocationDialogue Location4", "line_index": 355, "text": "Mda, ăla e jocul."}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "Huh, ce?"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "Pe bune? Credeam că vei..."}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "Sunt plină de fericire!"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "Și umpic confuză..."}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "Dar..."}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "Te rog rămâi cu mine—"}
{"category": "LocationDialogue Location4", "line_index": 364, "text": "pentru totdeauna."}
{"category": "LocationDialogue Location4", "line_index": 365, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 367, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 368, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 369, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 370, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 372, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 373, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 374, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 375, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 376, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 377, "text": "// A game about penguins"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "E foarte simplu:"}
{"category": "LocationDialogue Location4", "line_index": 379, "text": "doar adună bulgării."}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "Cel care adună cei mai mulți, câștigă!"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "Hai să jucăm două runde, ok?"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// The first map"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "Uau, cum ai strâns așa de multe?"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "Hihi! Am strâns cei mai mulți bulgări!"}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "Ai face bine să mă prinzi din urmă!"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "Ha, 1:1!"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// The second map"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "Ești un pinguin înnăscut!"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "Ar trebui să te ducem pe gheață adevărată!"}
{"category": "LocationDialogue Location4", "line_index": 390, "text": "Pfft, ești așa de lent."}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "Încă te mai gândești la ultima rundă?"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "Uau, o remiză! Aia e rară!"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// The game is over"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "Bun, vrei să ne jucăm altceva?"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "Sau te-ai săturat?"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "La ce îți trebuie aia?"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "Atât de gamer ești?"}
