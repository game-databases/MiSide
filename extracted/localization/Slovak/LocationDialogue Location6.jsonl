{"category": "LocationDialogue Location6", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "Mita?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "Ako si sa sem dostal?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Ty si Mita, však?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Ale... iná..."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "Pozorný, vidím."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "A máš pravdu."}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "Nie som Mita, s ktorou si sa stretol predtým."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Pozor, chystá niečo "}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "zlovestné."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "Hm, niečo zlovestné?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "Sakra!"}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "Ak všetko pôjde, všetko ti poviem."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Získaj kľúč. Je to vedľa pohovky."}
{"category": "LocationDialogue Location6", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Ale..."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "Všetky otázky neskôr!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Daj mi ten kľúč."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "A zober si tento prsteň."}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "Huh?"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Chceš sa odtiaľto dostať, však?"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "Uhm, áno..."}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Tak si ho nasaď."}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "Je to užitočný artefakt,"}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "budeš ho potrebovať."}
{"category": "LocationDialogue Location6", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Dobre..."}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "Mimochodom, Ja som"}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Dobre pre teba,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "A ja som... Mita."}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// MitaKind quest 1"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "Vidíš túto"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "konzolu? Zober ju."}
{"category": "LocationDialogue Location6", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "Je to nahrávka?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "Kto to je s ňou?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "Toto sa deje teraz."}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "Je to iný hráč."}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Ona ho len využíva."}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Mohla by sa pokúsiť"}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "ťa tiež premeniť na kazetu."}
{"category": "LocationDialogue Location6", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "Potrebujem sa odtiaľto čo najrýchlejšie dostať."}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "A ty tiež."}
{"category": "LocationDialogue Location6", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "Áno, potrebujeme."}
{"category": "LocationDialogue Location6", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "Takže, hovoríš,"}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "že ho využíva."}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "Ak by som vytiahol kazetu, čo by sa stalo?"}
{"category": "LocationDialogue Location6", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "To môže veľmi dobre"}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "nenávratne poškodiť kazetu."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "To znamená..."}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "že hráč by mohol zomrieť."}
{"category": "LocationDialogue Location6", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "..."}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "Čo ak by som to len vypol?"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "To by mohlo fungovať..."}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Oplatí sa to vyskúšať. Je tam červené tlačidlo napájania!"}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Vidíš ho?"}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "Našiel som ho."}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "Stlač ho."}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// MitaKind quest 2"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Musím zostať trochu dlhšie."}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "Mám otázky ktoré sa jej potrebujem spýtať"}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "aby som sa viac o nej dozvedela."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "Je však nepravdepodobné, že bude hrať loptu..."}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// MitaKind quest 3"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "Poviem ti pravdu, toto je moja verzia."}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "Bola som tu s iným hráčom,"}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "keď sa niečo náhle zmenilo."}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "Potom sa ukázala..."}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "a premenila hráča na kazetu"}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "a zamkla ma tu."}
{"category": "LocationDialogue Location6", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Počkať, ona ho zmenila na kazetu?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "Môže to vôbec urobiť?"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "Ale prečo?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "Načo potrebuje hráčov?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "Očividne sa zbláznila..."}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Len sa s nami hrá, baví sa!"}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "Premena hráčov na kazety..."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Niektorí si ani neuvedomili, čo sa s nimi deje..."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "A niektorí, ktorí áno, sa ani nebránia..."}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "To sa mi vôbec nepáči."}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "Počúvaj, musíš nám pomôcť!"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "Ja? Ale ako?"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "Potrebujem ťa, hráč!"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "Ak nám pomôžeš, pokúsim sa ti pomôcť späť!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Toto môže byť naša jediná šanca."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "Prsteň ťa privedie k správnej verzii."}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "Stretneme sa tam."}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// MitaKind quest 4"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "Stále celkom nerozumiem"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "čo som tam videl..."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Tá Mita..."}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "Chce, aby som zomrel?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "Zomrel?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Obávam sa, že má pre teba v pláne horší osud..."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "Preto sa treba poponáhľať."}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Hide!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "Ach, sakra! Skry sa!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Počkaj, čo...?"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Poponáhľaj sa, prichádza!"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "Nasleduj prsteň – dovedie ťa do bezpečia!"}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "No, dobre, povieš mi, kde je?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "Prečo by som?"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "Nechystáš sa ho zabiť, však?"}
{"category": "LocationDialogue Location6", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Aha, takže mi to odmietaš povedať."}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Hah, mám rada výzvy."}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "Viem, že je niekde tu."}
{"category": "LocationDialogue Location6", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "Prečo si na nás taká zlá?"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "Ani mi nepovieš, čo sa deje!"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "Okrem toho..."}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "na čo potrebuješ hráčov?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "Nie sú to hračky!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "Čo to do teba vošlo?!"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "Dosť! Drž hubu, bábika!"}
