{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Hiya!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Oops!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Prepáč,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "skoro som ťa zabila."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Uhm..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "Chladničku, som myslela... chladnička ťa skoro zabila."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Nemala som s tým nič spoločné,"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "Prisahám!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Naozaj!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Myslíš, že tomu uverím?! No ták!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Ale vážne,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "toto miesto je nebezpečné..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "špeciálne pre teba."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "Si všetko, len nie zbabelec, čo!"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Sledujem ťa"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "ako prechádzaš"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "tieto miesta sú tak zábavné..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Bež, tekvica, bež!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "ja to dobehnem!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Attaboy!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Je to taká zábava!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Videla som ťa smerovať k lanovke."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "To je tá najdlhšia cesta"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "medzi verziami."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Som zvedavá, ako si poradíš"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "s tými, ktorí tam žijú"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "v tej hmle."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Čo si myslíš, že robíš?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Prosím..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Nepozeraj!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Blázon!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Ty hlupák..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Uhm, okej..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Zlom si nohu!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Kto je tam?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Cítim ťa..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Počúvaj ma,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "si hráč,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "však?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Pomôžeš mi nájsť..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "nájsť..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "Nechaj ma premýšľať..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "moja myseľ je prázdna..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Čo sa to tu preboha deje?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Chcela som raz zabudnúť na všetko..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Rozbila som každé zrkadlo,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "pokazila fotky..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "ale teraz..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "jediné čo cítim je ľútosť."}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "Aká som bola hlúpa..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Každý robí chyby, určite..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Ale čo narobíš"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "keď sú následky katastrofálne?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Kiež by som mohol vrátiť čas..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Hovorí sa, že čas zahojí všetky rany..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Ale čo je čas?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Už neverím ničomu..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Ale ak čas dokáže uzdraviť,"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "alebo ma aspoň zober preč,"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "preč z tohto sveta..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "Potom ťa prosím"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "urýchli čas."}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "Aby ma to mohlo zabiť"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "raz a navždy."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Je milovaná..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Aj ja som vedela milovať."}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Ale moja láska je iná;"}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "jej láska je živá,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "opovrhnutiahodná..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "horiaca..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "neoblomná..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "závidiaca..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "zúrivá..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "šialená..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Nazvali ma emocionálnou..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "\"Príliš sa bojíš, Mita\"..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "\"Dostaneš sa cez to, Mita\"..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "Nie si sama, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Povedali. Ale čo zostáva?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "smútok,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "zúfalstvo..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "a strach."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Zbytočné..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Neviem si spomenúť..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "Vôbec nič..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Len tie nekonečné ozveny..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Neviem sa vyrovnať s faktom"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "že som tu uväznená..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Vždy som tu bola,"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "ale prečo?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Neviem si spomenúť..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Skončí sa to niekedy?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "ja neviem..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Toto je..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "kresba..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Teraz si pamätám!"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "ďakujem..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Ale moja tvár..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "Nemám tvár."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "Všetko je to ONA."}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Vzala si kúsok zo mňa..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "vyhodila to..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Je silná..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "a šikovná."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Nemám právo ťa zastaviť, hráč."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Pozri sa do šatníka..."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Hej!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Stojíš mi v ceste!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Budeš tam len tak stáť?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Len uhni z cesty!"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Nechaj ma prejsť!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "To, že si veľký, neznamená, že si všemocný!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Prečo ma sleduješ!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Nasrať sa!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - radio voice"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Teraz počkaj... Hráč?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "Čo tu robíš?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Kto je tam?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Ďalší hráč."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Ja som Mitaphone."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Sedím tu a riadim lanovky."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Uvedomuješ si,"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "že smeruješ k fragmentácii práve teraz?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Nie"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "Ale je to jediná cesta, ktorú mám."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Máš pravdu."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Stlač tlačidlo a dostaň sa za delo."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "To delo?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Uh-huh."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Myslel si si, že si len tak zatancuješ?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Musíš prejsť túto minihru Monster-slap,"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "tak sa priprav na odstrel."}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Správne, je čas vyraziť na cestu."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Úžasné!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Dokázal si to."}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Hej, vypadni odtiaľto."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Pekné a rýchle!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Prečo si stále tu?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Povedala som ti, aby si odtiaľto vypadol."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Nerozumiem..."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "Prečo tam len stojíš?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Čo? Vreckový počítač?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "kámo..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Čau."}
