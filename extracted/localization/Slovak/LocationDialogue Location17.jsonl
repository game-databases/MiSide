{"category": "LocationDialogue Location17", "line_index": 0, "text": "// Player thinks + Make coffee"}
{"category": "LocationDialogue Location17", "line_index": 1, "text": "Tu budem potrebovať niekoho pomoc."}
{"category": "LocationDialogue Location17", "line_index": 2, "text": "Dúfam, že tu Mita nehryzie..."}
{"category": "LocationDialogue Location17", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 4, "text": "Na čo strácam čas..."}
{"category": "LocationDialogue Location17", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 9, "text": "// Player tries to wake up MitaDreamer"}
{"category": "LocationDialogue Location17", "line_index": 10, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 11, "text": "Mita, zobuď sa."}
{"category": "LocationDialogue Location17", "line_index": 12, "text": "Mi-ita!"}
{"category": "LocationDialogue Location17", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 14, "text": "Mita, zobuď sa!"}
{"category": "LocationDialogue Location17", "line_index": 15, "text": "Potrebujem tvoju pomoc."}
{"category": "LocationDialogue Location17", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 17, "text": "Kto si?"}
{"category": "LocationDialogue Location17", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 19, "text": "Pomôž mi s prepínačmi."}
{"category": "LocationDialogue Location17", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 21, "text": "Aké spínače?"}
{"category": "LocationDialogue Location17", "line_index": 22, "text": "Nechaj ma spať..."}
{"category": "LocationDialogue Location17", "line_index": 23, "text": "Alebo mi daj kávu."}
{"category": "LocationDialogue Location17", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 25, "text": "Poď, nie je to tak ďaleko..."}
{"category": "LocationDialogue Location17", "line_index": 26, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 27, "text": "Mi-ita!"}
{"category": "LocationDialogue Location17", "line_index": 28, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 31, "text": "// Player gives away the coffee"}
{"category": "LocationDialogue Location17", "line_index": 32, "text": "Mita,"}
{"category": "LocationDialogue Location17", "line_index": 33, "text": "tu je tvoja káva."}
{"category": "LocationDialogue Location17", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 37, "text": "// MitaDreamer exercise"}
{"category": "LocationDialogue Location17", "line_index": 38, "text": "Prepínače,"}
{"category": "LocationDialogue Location17", "line_index": 39, "text": "si povedal?"}
{"category": "LocationDialogue Location17", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 41, "text": "Áno."}
{"category": "LocationDialogue Location17", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 43, "text": "Ako to, že o nich vieš?"}
{"category": "LocationDialogue Location17", "line_index": 44, "text": "Aj keď, prečo sa vôbec pýtam..."}
{"category": "LocationDialogue Location17", "line_index": 45, "text": "Vzhľadom na to, že si tu,"}
{"category": "LocationDialogue Location17", "line_index": 46, "text": "už by si toho mal veľa vedieť..."}
{"category": "LocationDialogue Location17", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 48, "text": "Len chvíľku,"}
{"category": "LocationDialogue Location17", "line_index": 49, "text": "Musím si sadnúť."}
{"category": "LocationDialogue Location17", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 51, "text": "A?"}
{"category": "LocationDialogue Location17", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 53, "text": "Neviem čo povedať..."}
{"category": "LocationDialogue Location17", "line_index": 54, "text": "Ale musím pokračovať,"}
{"category": "LocationDialogue Location17", "line_index": 55, "text": "pokračovať po ceste, ktorú pre mňa robí prsteň."}
{"category": "LocationDialogue Location17", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 57, "text": "Máš jej prsteň?"}
{"category": "LocationDialogue Location17", "line_index": 58, "text": "Nečudo"}
{"category": "LocationDialogue Location17", "line_index": 59, "text": "že si našiel toto miesto."}
{"category": "LocationDialogue Location17", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 61, "text": "Presne tak."}
{"category": "LocationDialogue Location17", "line_index": 62, "text": "Takže, môžeš mi pomôcť?"}
{"category": "LocationDialogue Location17", "line_index": 63, "text": "S prepínačmi?"}
{"category": "LocationDialogue Location17", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 65, "text": "Jasné."}
{"category": "LocationDialogue Location17", "line_index": 66, "text": "Pôjdem."}
{"category": "LocationDialogue Location17", "line_index": 67, "text": "S prepínačmi..."}
{"category": "LocationDialogue Location17", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 70, "text": "Mita, no tak..."}
{"category": "LocationDialogue Location17", "line_index": 71, "text": "Poďme už."}
{"category": "LocationDialogue Location17", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 73, "text": "Uh?"}
{"category": "LocationDialogue Location17", "line_index": 74, "text": "V poriadku."}
{"category": "LocationDialogue Location17", "line_index": 75, "text": "Poďme."}
{"category": "LocationDialogue Location17", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 78, "text": "// MitaDreamer fall"}
{"category": "LocationDialogue Location17", "line_index": 79, "text": "Vstaň."}
{"category": "LocationDialogue Location17", "line_index": 80, "text": "Si taká ospalá?"}
{"category": "LocationDialogue Location17", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 82, "text": "// MitaDreamer again sleep"}
{"category": "LocationDialogue Location17", "line_index": 83, "text": "Zobuď sa."}
{"category": "LocationDialogue Location17", "line_index": 84, "text": "Sme tam."}
{"category": "LocationDialogue Location17", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 87, "text": "// Switches"}
{"category": "LocationDialogue Location17", "line_index": 88, "text": "Dobre,"}
{"category": "LocationDialogue Location17", "line_index": 89, "text": "Som pripravená."}
{"category": "LocationDialogue Location17", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 91, "text": "Aj ja som pripravený."}
{"category": "LocationDialogue Location17", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 93, "text": "Dobre."}
{"category": "LocationDialogue Location17", "line_index": 94, "text": "začnem"}
{"category": "LocationDialogue Location17", "line_index": 95, "text": "odpočítavať."}
{"category": "LocationDialogue Location17", "line_index": 96, "text": "A spolu stiahneme vypínače."}
{"category": "LocationDialogue Location17", "line_index": 97, "text": "Dobre?"}
{"category": "LocationDialogue Location17", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 99, "text": "Len buď hore, OK!"}
{"category": "LocationDialogue Location17", "line_index": 100, "text": "Choď."}
{"category": "LocationDialogue Location17", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 103, "text": "3"}
{"category": "LocationDialogue Location17", "line_index": 104, "text": "2"}
{"category": "LocationDialogue Location17", "line_index": 105, "text": "1"}
{"category": "LocationDialogue Location17", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 107, "text": "// Player lose 1"}
{"category": "LocationDialogue Location17", "line_index": 108, "text": "Dávaš si odstup?"}
{"category": "LocationDialogue Location17", "line_index": 109, "text": "No tak,"}
{"category": "LocationDialogue Location17", "line_index": 110, "text": "skúsme to znova..."}
{"category": "LocationDialogue Location17", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 112, "text": "// Player lose 2"}
{"category": "LocationDialogue Location17", "line_index": 113, "text": "Ešte jeden pokus?"}
{"category": "LocationDialogue Location17", "line_index": 114, "text": "no tak"}
{"category": "LocationDialogue Location17", "line_index": 115, "text": "ja..."}
{"category": "LocationDialogue Location17", "line_index": 116, "text": "ja tu zaspávam..."}
{"category": "LocationDialogue Location17", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 118, "text": "// Player lose 3"}
{"category": "LocationDialogue Location17", "line_index": 119, "text": "Už skoro zaspávam..."}
{"category": "LocationDialogue Location17", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 122, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 123, "text": "Úžasné,"}
{"category": "LocationDialogue Location17", "line_index": 124, "text": "ďakujem, Mita."}
{"category": "LocationDialogue Location17", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 126, "text": "Mm-hmm."}
{"category": "LocationDialogue Location17", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 129, "text": "Dvere..."}
{"category": "LocationDialogue Location17", "line_index": 130, "text": "takže..."}
{"category": "LocationDialogue Location17", "line_index": 131, "text": "pomaly..."}
{"category": "LocationDialogue Location17", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 134, "text": "Idem spať..."}
{"category": "LocationDialogue Location17", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 136, "text": "// Why kitchen?"}
{"category": "LocationDialogue Location17", "line_index": 137, "text": "Prečo ísť do kuchyne?"}
{"category": "LocationDialogue Location17", "line_index": 138, "text": "Ak zaspím na studenej podlahe,"}
{"category": "LocationDialogue Location17", "line_index": 139, "text": "bude to tvoja chyba."}
{"category": "LocationDialogue Location17", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 141, "text": "// Why bathroom?"}
{"category": "LocationDialogue Location17", "line_index": 142, "text": "Nerozumiem..."}
{"category": "LocationDialogue Location17", "line_index": 143, "text": "s akými prepínačmi tu potrebuješ pomoc?"}
{"category": "LocationDialogue Location17", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 145, "text": "// Put button"}
{"category": "LocationDialogue Location17", "line_index": 146, "text": "Nič sa nestalo?"}
{"category": "LocationDialogue Location17", "line_index": 147, "text": "Čo tu potom robí toto tlačidlo?"}
{"category": "LocationDialogue Location17", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 149, "text": "// Cofee"}
{"category": "LocationDialogue Location17", "line_index": 150, "text": "Ešte chceš kávu?"}
{"category": "LocationDialogue Location17", "line_index": 151, "text": "Alebo znova zaspíš."}
{"category": "LocationDialogue Location17", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 153, "text": "Čo?"}
{"category": "LocationDialogue Location17", "line_index": 154, "text": "Nieee..."}
{"category": "LocationDialogue Location17", "line_index": 155, "text": "Táto káva chutí hrozne..."}
{"category": "LocationDialogue Location17", "line_index": 156, "text": "Som úplne v pohode..."}
{"category": "LocationDialogue Location17", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 158, "text": "// Button"}
{"category": "LocationDialogue Location17", "line_index": 159, "text": "Mita? Tlačidlo nefunguje... Počuješ ma?"}
{"category": "LocationDialogue Location17", "line_index": 160, "text": "Halooo?"}
