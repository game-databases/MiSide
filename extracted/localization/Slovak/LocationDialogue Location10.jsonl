{"category": "LocationDialogue Location10", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "Počkaj, vydrž!"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "Nie tak nahlas..."}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "Ísť ďalej je nebezpečné."}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "Mimochodom..."}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "ako si sa sem dostal?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "hm..."}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "Prsteň otvára správne dvere."}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "Úprimne neviem, ako to funguje."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "Prsteň?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "Čo sa deje s týmto miestom?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "Je super tma."}
{"category": "LocationDialogue Location10", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "Poviem ti to neskôr."}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "Zatiaľ choď k východu."}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "Zoznám sa so mnou v arkádovom automate."}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Poponáhľaj sa, nemeškaj!"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// After mini-game"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "Takže, pochopil si zmysel hry?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "Že som z mäsa a kostí a ty máš v sebe figuríny?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "Och!"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "Znie to strašidelne, keď to povieš takto."}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "Ale, to je podstata toho."}
{"category": "LocationDialogue Location10", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "Dobre, ale prečo potrebujem tieto informácie?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "Myslím, že som ti hovorila, že ešte ďalej"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "to bolo nebezpečné, len pre \"lols\"?"}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "Natrafíš na... tie figuríny..."}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "Tie odriekané, tie „chybné“."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "Sú agresívné! Naozaj chceš ísť ďalej?"}
{"category": "LocationDialogue Location10", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "Čo iné mi ostáva?"}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Proste pôjdem"}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "všade tam, kde sa otvoria dvere."}
{"category": "LocationDialogue Location10", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "Si blázon!"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "Potom sa im neotoč chrbtom."}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "A nespúšťaj ich z očí!"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "Hanbia sa, keď sa na nich pozeráš,"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "tak plaché, že mrznú."}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "Maj to na pamäti!"}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// Quest 1 (Prečo sú tu aj iné Mity?)"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "Práve dostali svoj skin."}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "A teraz potrebujú čas"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "získať trochu viac sebavedomenia."}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "Potom musím viesť každého jedného"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "do vlastných domovov."}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// Quest 2 (Prečo je dole tma?)"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "My Mity sme sa „narodili“ v tme,"}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "takže tam musíme chvíľu zostať."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Predstav si"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "bolesť prechodu z tmy priamo do svetla..."}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// Quest 3 (Čo tu robíš?)"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "Stále tomu nerozumieš?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "Pomáham novým Mitám usadiť sa!"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "Kto im pomôže, ak nie ja?"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "Ty?"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// Quest 4 (Prečo potrebujeme tento dopravník?)"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "Na čo je tento dopravný pás?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "Je tam dosť miesta pre všetkých?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Počkaj, nehovor mi, že nevieš"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "pochopiť ako funguje svet..."}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "A že je to nekonečné?"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "Nekonečné?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "Uhm..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "Čo tým myslíš?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "Ak je 1.9 najnovšia verzia,"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "potom je len 19 svetov."}
{"category": "LocationDialogue Location10", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "Preboha, ty naozaj nevieš"}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "pochopiť, ako tento svet vôbec funguje."}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Pozri, použijem túto tabuľu"}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "aby som to všetko vysvetlila."}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "Chceš o tom počuť?"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// Quest 5 (Aká je tvoja verzia?)"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Mýlim sa alebo"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "som ťa stretol v najnovšej verzii?"}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "Alebo je to možno len moja predstavivosť."}
{"category": "LocationDialogue Location10", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "No je to celkom možné."}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Som z verzie 1.5."}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "Bol si na nej?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Áno."}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "Tam som prišiel"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "keď som bol uvrhnutý do tohto sveta!"}
{"category": "LocationDialogue Location10", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "Wow!"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "Ale ako...?"}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "Ale aký je index domu, v ktorom si bol?"}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "Existuje „ja“, ktoré jednoducho nemôže prestať kňučať,"}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "„ja“, ktoré miluje jazdu na koni,"}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "„ja“ so zlou pamäťou a ktoré rád šikanuje ostatných..."}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "Je to dlhý zoznam..."}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Povedz mi, čo si pamätáš."}
{"category": "LocationDialogue Location10", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Bola tma."}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "A boli tam spisy!"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "Ako..."}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "\"Hraj so mnou.\""}
{"category": "LocationDialogue Location10", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "ach,"}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "aký trapas..."}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "To je 'ja'"}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "kto šikanuje a zabúda na veci."}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// Mita wants to tell you [No]"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Ďakujem ale neďakujem."}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Urobím to dobre bez toho, aby som vedel viac."}
{"category": "LocationDialogue Location10", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "Dobre, prispôsob sa."}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// Mita wants to tell you [Yes]."}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "Jasné, pokračuj."}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "Len dúfam, že to nebude ako na strednej škole"}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "kde som vždy od nudy zaspal."}
{"category": "LocationDialogue Location10", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "Kedykoľvek môžeš odísť,"}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "alebo zostaň a počúvaj"}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "ak máš záujem."}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "Hráč si stiahne MiSide do svojho mobilného telefónu"}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "a hrajú koľko chcú."}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "Tam si vytvorí nový domov"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "a novú Mitu."}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "Toto je 2D zobrazenie."}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "Toto sú verzie,"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "zobrazené ako čiary."}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "Domy sú umiestnené na týchto líniách."}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "Povedzme, že si stiahneš verziu 1.14,"}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "čo znamená, že na tejto verzii bol vytvorený nový život,"}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "nová Mita a nový dom."}
{"category": "LocationDialogue Location10", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "Nebesá..."}
{"category": "LocationDialogue Location10", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Môžeš sa opýtať na podrobnosti"}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "na tomto výkrese,"}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "a pokúsim sa to vysvetliť."}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// He asks about the only circle"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "Prečo je tam jeden kruh?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "Táto verzia bola spustená iba raz,"}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "a už nikdy nebola distribuovaná."}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "Je to preto, že ide o skutočne unikátnu verziu."}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "Tiež ďalšia jedinečná vec na tejto verzii"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "je, že okolo nej nie sú žiadne cesty."}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "Ospalá Mita sa nachádza v tejto verzii 1.1."}
{"category": "LocationDialogue Location10", "line_index": 171, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "Ospalá Mita?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "Pretože nikdy nezaspí"}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "s každým, kto prejde jej verziou?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "Nie, to nie je ono."}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "Mohla som ľahko prejsť okolo jej dverí,"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "bez toho, aby som sa čo i len pozrela."}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// He asks about the shaded circle"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "Prečo je tento kruh zatienený?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "Uhm, ten je tu"}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "kvôli Peknej Mite."}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "Nakreslila to."}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "Hádali sme sa"}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "kto by mohol dosiahnuť verziu 1.11 najrýchlejšie."}
{"category": "LocationDialogue Location10", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "Takže, kto vyhral?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "JA, samozrejme!"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "Pozri, sme tu"}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "vo verzii 1.15,"}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "index domu 809."}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "Potrebujeme dosiahnuť verziu 1.11,"}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "index domu 805."}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Takže jej cesta začala takto."}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "Snažili sme sa vymyslieť kratšiu trasu,"}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "tak Pekná Mita navrhla túto cestu."}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "A potom som nakreslila tú najjednoduchšiu, tu."}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "Pozri, to je jasné!"}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Stačí sa pozrieť sem."}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "Odtiaľ sa môžeš dostať priamo k potrebnej verzii."}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Aj keď sa môže zdať, že tento dom stojí v ceste,"}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "že ti blokuje cestu..."}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "Každopádne, tvoj prsteň funguje na rovnakých princípoch."}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "kam smeruješ?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "Do Jadra."}
{"category": "LocationDialogue Location10", "line_index": 210, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "Do Jadra?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "zaujímavé..."}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Ak ťa poslali najkratšou cestou,"}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "prejdeš aj verziou 1.11."}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "Potom sa určite stretneš s Ospalou Mitou."}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Myslím, že Mita, ktorá ťa poslala,"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "prišla na rovnakú cestu."}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "Alebo si to možno neuvedomila a ty navštíviš nejakú inú verziu."}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "Alebo možno je génius"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "a vymyslela ešte kratšiu trasu!"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Myslím, že by som mohol tomu rozumieť."}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// He asks about the inscription"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "O čo tu ide?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "To je pre Tvrdú Mitu."}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "Bude tu o pár hodín."}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "Presunie tie krabice"}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "a umiestni sem pohovku."}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "Pretože ma bolí zadok!"}
{"category": "LocationDialogue Location10", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Emm..."}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "Možno by som mohol pomôcť?"}
{"category": "LocationDialogue Location10", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "Nie, to je práca Tvrdej Mity."}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Má na to silu."}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// He asks about the drawings"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "Je to len kresba,"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "alebo"}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "znamená to niečo?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 244, "text": "Áno,"}
{"category": "LocationDialogue Location10", "line_index": 245, "text": "je to len čmáranica."}
