{"category": "LocationDialogue Location12", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Zostaň tu."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Myslím, že som niečo stratila. Hneď sa vrátim."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "Potom pôjdeme do iného nového sveta..."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Dobre."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Poďme sa zahrať!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Chcem môjho macika!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "Stratila som ho..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "Nájdi HO!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Hej..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "Na čo sa pozeráš?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Quest 1 (Kto si?)"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Ja som Mita."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "Najlepšia Mita."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "Prvá Mita."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "To je to čo Mita povedala, moja Mita."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Quest 2 (Prečo takto vyzeráš?)"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "Ako vyzerám?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "Ako vyzerám?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "Ako vyzerám?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "Moja Mita povedala že som krásna a originálna."}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "To je ako vyzerám!"}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Quest 3 (Čo tu robí Mita?)"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Ona ma vezme preč."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "My budeme žiť v inom svete."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "Moja Mita ma pozvala."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Ona ma vezme preč. A budeme sa hrať."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Quest 4 (Prečo potrebuješ mededíka?)"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "Si plyšový medvedík,"}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "a si stratený,"}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "presne ako môj plyšový medvedík."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Quest 5 (Prečo je Mita nahnevaná?)"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "Moja..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "Mita."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Ona sa chce hrať."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Ja som jediná"}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "koho chce zobrať so sebou."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "My sme jedinečné,"}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "jediné."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Mita a moja Mita,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0.8A a 8Ě54*."}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Quest 6 (Veríš Mite?)"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "Moja Mita."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "Moja najlepšia kamarátka."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "Moja Mita."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "Moja jediná kamarátka."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "To si ty!"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Hej."}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Poďme sa zahrať!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Ukážem ti ako."}
