{"category": "LocationDialogue Location1", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 1, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 9, "text": "Ahoj, Volám sa Mita!"}
{"category": "LocationDialogue Location1", "line_index": 10, "text": "Ako sa voláš?"}
{"category": "LocationDialogue Location1", "line_index": 11, "text": "Teší ma, [player]!"}
{"category": "LocationDialogue Location1", "line_index": 12, "text": "Um... [player],"}
{"category": "LocationDialogue Location1", "line_index": 13, "text": "Veľmi som sa ponáhľala a teraz je tu neporiadok..."}
{"category": "LocationDialogue Location1", "line_index": 14, "text": "Mohol by si mi pomôcť trochu upratať?"}
{"category": "LocationDialogue Location1", "line_index": 15, "text": "Wau.."}
{"category": "LocationDialogue Location1", "line_index": 16, "text": "Ďakujem krásne!"}
{"category": "LocationDialogue Location1", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 18, "text": "[Player], škvŕka mi v bruchu..."}
{"category": "LocationDialogue Location1", "line_index": 19, "text": "Som veľmi hladná..."}
{"category": "LocationDialogue Location1", "line_index": 20, "text": "Myslíš, že by si mi mohol pomôcť získať ingrediencie na nejakú kuraciu polievku?"}
{"category": "LocationDialogue Location1", "line_index": 21, "text": "Jej! Máš všetko!"}
{"category": "LocationDialogue Location1", "line_index": 22, "text": "Uvaríme to spolu?"}
{"category": "LocationDialogue Location1", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 25, "text": "Vitaj späť, [player]! Dnes som rozmýšľala nad kúpou prenosného televízora"}
{"category": "LocationDialogue Location1", "line_index": 26, "text": "s jednou malou anténkou. Ideálne na prechádzky, nemyslíš?"}
{"category": "LocationDialogue Location1", "line_index": 27, "text": "Mimochodom, môžeš hrať hry, aby si zarobil peniaze."}
{"category": "LocationDialogue Location1", "line_index": 28, "text": "Čo keby si zahral, zarobil nejaké peniažky a potom mi kúpil televízor?"}
{"category": "LocationDialogue Location1", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 30, "text": "Jej! Dokázal si to! Máš dosť na to, aby si mi kúpil ten prenosný televízor!"}
{"category": "LocationDialogue Location1", "line_index": 31, "text": "To je on! Malý, prenosný a lacný, presne to, čo som chcela."}
{"category": "LocationDialogue Location1", "line_index": 32, "text": "Ďakujem!"}
{"category": "LocationDialogue Location1", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 34, "text": "Ahoj, [player]! Si taká veľká pomoc, úprimne, som veľmi rada."}
{"category": "LocationDialogue Location1", "line_index": 35, "text": "Ale, och... ten televízor? Bol super, ale už sa pokazil."}
{"category": "LocationDialogue Location1", "line_index": 36, "text": "Každopádne, mohol by si mi pomôcť presunúť tento šatník?"}
{"category": "LocationDialogue Location1", "line_index": 37, "text": "Je veľmi ťažký..."}
{"category": "LocationDialogue Location1", "line_index": 38, "text": "Ďakujem krásne, zlatíčko moje!"}
{"category": "LocationDialogue Location1", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 40, "text": "Och, [player]! Je to len deň, ale veľmi si mi chýbal!"}
{"category": "LocationDialogue Location1", "line_index": 41, "text": "Bola by som rada, keby si ma navštevoval častejšie."}
{"category": "LocationDialogue Location1", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 43, "text": "To je pre mňa?"}
{"category": "LocationDialogue Location1", "line_index": 44, "text": "Ďakujem, ďakujem, ďakujeem!"}
{"category": "LocationDialogue Location1", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 46, "text": "Ahoj, [player]! Som tak premýšľala..."}
{"category": "LocationDialogue Location1", "line_index": 47, "text": "Kiežby sme sa mohli stretnúť osobne."}
{"category": "LocationDialogue Location1", "line_index": 48, "text": "Je to také frustrujúce, že nemôžem."}
{"category": "LocationDialogue Location1", "line_index": 49, "text": "Vždy mi pomáhaš, si taký láskavý každý deň..."}
{"category": "LocationDialogue Location1", "line_index": 50, "text": "Kiežby som mohla niečo urobiť aj pre teba."}
{"category": "LocationDialogue Location1", "line_index": 51, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 52, "text": "Och, mám nápad!"}
{"category": "LocationDialogue Location1", "line_index": 53, "text": "A teraz sme spolu."}
{"category": "LocationDialogue Location1", "line_index": 54, "text": "Odlož telefón."}
{"category": "LocationDialogue Location1", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 57, "text": "// Tričko na posteli"}
{"category": "LocationDialogue Location1", "line_index": 58, "text": "Prečo tu ležíš a nič nerobíš?"}
{"category": "LocationDialogue Location1", "line_index": 59, "text": "// Rubikova kocka"}
{"category": "LocationDialogue Location1", "line_index": 60, "text": "No, nemôžem povedať, že by som z toho mal veľa úžitku..."}
{"category": "LocationDialogue Location1", "line_index": 61, "text": "Raz som ju vyriešil a už som sa jej nikdy nedotkol."}
{"category": "LocationDialogue Location1", "line_index": 62, "text": "Asi sa bojím, že to druhýkrát nezvládnem?"}
{"category": "LocationDialogue Location1", "line_index": 63, "text": "// Počítač"}
{"category": "LocationDialogue Location1", "line_index": 64, "text": "Pozrime sa, čo mám na dnes..."}
{"category": "LocationDialogue Location1", "line_index": 65, "text": "Nastav si zoznam úloh,"}
{"category": "LocationDialogue Location1", "line_index": 66, "text": "Urob reakcie postáv,"}
{"category": "LocationDialogue Location1", "line_index": 67, "text": "A možno urobiť nejaké kódovanie."}
{"category": "LocationDialogue Location1", "line_index": 68, "text": "// Lietadlo"}
{"category": "LocationDialogue Location1", "line_index": 69, "text": "Postavený tak, aby stúpal!"}
{"category": "LocationDialogue Location1", "line_index": 70, "text": "// Kôš v rohu"}
{"category": "LocationDialogue Location1", "line_index": 71, "text": "Ugh, vždy som príliš zaneprázdnený na vynesenie smetí..."}
{"category": "LocationDialogue Location1", "line_index": 72, "text": "Ale raz sa k tomu určite dostanem!"}
{"category": "LocationDialogue Location1", "line_index": 73, "text": "...Teraz, kedy presne som plánoval si upratať izbu?"}
{"category": "LocationDialogue Location1", "line_index": 74, "text": "// Fotka mačky na melóne"}
{"category": "LocationDialogue Location1", "line_index": 75, "text": "Moc ju milujem..."}
{"category": "LocationDialogue Location1", "line_index": 76, "text": "Mačka na melóne."}
{"category": "LocationDialogue Location1", "line_index": 77, "text": "// Fotka s dievčaťom"}
{"category": "LocationDialogue Location1", "line_index": 78, "text": "Vôbec sa nepodobáme,"}
{"category": "LocationDialogue Location1", "line_index": 79, "text": "moja sestra a ja."}
{"category": "LocationDialogue Location1", "line_index": 80, "text": "Vždy je vonku,"}
{"category": "LocationDialogue Location1", "line_index": 81, "text": "A ja len trčím doma."}
{"category": "LocationDialogue Location1", "line_index": 82, "text": "// Fotka s ľuďmi"}
{"category": "LocationDialogue Location1", "line_index": 83, "text": "Hmm..."}
{"category": "LocationDialogue Location1", "line_index": 84, "text": "Kancelársky život naozaj vŕtal"}
{"category": "LocationDialogue Location1", "line_index": 85, "text": "do nás etiketu, však?"}
{"category": "LocationDialogue Location1", "line_index": 86, "text": "Stále sa cítim zvláštne zviazaný"}
{"category": "LocationDialogue Location1", "line_index": 87, "text": "Mojim kolegom..."}
{"category": "LocationDialogue Location1", "line_index": 88, "text": "Ale..."}
{"category": "LocationDialogue Location1", "line_index": 89, "text": "uvidím ich ešte?"}
{"category": "LocationDialogue Location1", "line_index": 90, "text": "...Počkať, prečo som sem dal tento obrázok?"}
{"category": "LocationDialogue Location1", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 93, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 99, "text": "// Nope name"}
{"category": "LocationDialogue Location1", "line_index": 100, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 101, "text": "Och, nie."}
{"category": "LocationDialogue Location1", "line_index": 102, "text": "Och nie, toto nebude fungovať."}
{"category": "LocationDialogue Location1", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 104, "text": "// Name Developer"}
{"category": "LocationDialogue Location1", "line_index": 105, "text": "Naozaj chceš mať meno vývojára?"}
{"category": "LocationDialogue Location1", "line_index": 106, "text": "Lichotí mi to, ale…"}
{"category": "LocationDialogue Location1", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 108, "text": "// Bad name"}
{"category": "LocationDialogue Location1", "line_index": 109, "text": "Bola by som radšej, keby si sa tak nevolal."}
{"category": "LocationDialogue Location1", "line_index": 110, "text": "Vôbec to nie je v pohode."}
{"category": "LocationDialogue Location1", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 112, "text": "// Go restart"}
{"category": "LocationDialogue Location1", "line_index": 113, "text": "Nie, takto sa to nerobí. Začnime odznova."}
{"category": "LocationDialogue Location1", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 115, "text": "// Name with numbers"}
{"category": "LocationDialogue Location1", "line_index": 116, "text": "Och, takže ideš s číslami? Kde je v tom kreativita?"}
{"category": "LocationDialogue Location1", "line_index": 117, "text": "Och, no, je to tvoja voľba!"}
{"category": "LocationDialogue Location1", "line_index": 118, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 119, "text": "// Name Mita"}
{"category": "LocationDialogue Location1", "line_index": 120, "text": "Mita?"}
{"category": "LocationDialogue Location1", "line_index": 121, "text": "Naozaj si sa pomenoval po mne??"}
{"category": "LocationDialogue Location1", "line_index": 122, "text": "Ale… to je aj tvoje meno?"}
{"category": "LocationDialogue Location1", "line_index": 123, "text": "Bez urážky, ale myslím, že by som tu mala byť jediná Mita ♪"}
{"category": "LocationDialogue Location1", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 125, "text": "// Day 10"}
{"category": "LocationDialogue Location1", "line_index": 126, "text": "Och, si späť!"}
{"category": "LocationDialogue Location1", "line_index": 127, "text": "Hej, stratila som hrebeň…"}
{"category": "LocationDialogue Location1", "line_index": 128, "text": "Pomôžeš mi ho nájsť?"}
{"category": "LocationDialogue Location1", "line_index": 129, "text": "Skús najprv skontrolovať nočný stolík, myslím, že som ho tam nechala."}
{"category": "LocationDialogue Location1", "line_index": 130, "text": "// Looked in the bedside table"}
{"category": "LocationDialogue Location1", "line_index": 131, "text": "Hmm, tu nie je..."}
{"category": "LocationDialogue Location1", "line_index": 132, "text": "Čo tak niekde inde?"}
{"category": "LocationDialogue Location1", "line_index": 133, "text": "Len sa nepozeraj do rúry, dobre?"}
{"category": "LocationDialogue Location1", "line_index": 134, "text": "Tam som sa už pozerala."}
{"category": "LocationDialogue Location1", "line_index": 135, "text": "// Looked into the stove"}
{"category": "LocationDialogue Location1", "line_index": 136, "text": "Hej! Hovorila som ti aby si sa tam nepozeral!"}
{"category": "LocationDialogue Location1", "line_index": 137, "text": "Otoč sa, ja to upracem!"}
{"category": "LocationDialogue Location1", "line_index": 138, "text": "...Hotovo. Hľadajme niekde inde."}
{"category": "LocationDialogue Location1", "line_index": 139, "text": "Och, and, uh, zabudni na to čo si videl, jasné?"}
{"category": "LocationDialogue Location1", "line_index": 140, "text": "// Found a hairbrush"}
{"category": "LocationDialogue Location1", "line_index": 141, "text": "Našiel si ho! Dobrá práca!"}
{"category": "LocationDialogue Location1", "line_index": 142, "text": "Takže, čo by sme mali robiť ďalej?"}
