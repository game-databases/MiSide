{"category": "LocationDialogue Location15", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Tu to máš!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Prečo si opustil Jadro?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Povedala som ti, aby si na mňa počkal!"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Myslel som si, že si bola preč príliš dlho a..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "No v poriadku..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Myslím, že som niečo našla..."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Podľa mňa je to index..."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Budeme musieť zistiť, či to funguje!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Poďme odtiaľto preč."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "Šialená Mita..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Myslím, že je zaneprázdnená novým hráčom."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Tak dúfam, že je príliš zaneprázdnená, aby sa o nás starala..."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Mita?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Počkaj na mňa."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Stratil si niekoho?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Zoznám sa s ňou znova!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Mita..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Chyť ju!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Ako to..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Kto si ty?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Si... si nažive!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Ty si nič nepamätáš?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "poznám ťa?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Čo sa deje..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Čo mám teraz robiť?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Nebudem môcť utiecť..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "Čo myslíš tým \"útek\"?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Počkaj..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "To je ten prsteň..."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "A to?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Nemám potuchy, čo to je."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "Je to index!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Našla si to!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Neviem, čo povedať."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Musíme sa vrátiť do Jadra."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "A ty..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Možno by si mala ísť so mnou..."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Uhm, čo?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "jasné..."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Počkaj tu."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Mm-hmm."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Posadím sa tu."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Sakra..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "To bolo tesné."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "Takže... urobili sme to?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Dobre."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Som v správnej verzii."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Ahoj!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Si hráč, však?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Ako sa voláš?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Chcem opustiť toto miesto..."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Chceš už odísť?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "Ako si sa sem vôbec dostal?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "No dobre..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Dobre, môžeš odísť..."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Stačí vyskúšať dvere."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Veľa šťastia s tým!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Stena?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Hmm, to je celé zle."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Možno..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "v suteréne je niečo, čo ti pomôže."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Nedávno som objavila"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "dvere v mojom šatníku..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Ukázalo sa, že vedie do suterénu."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Ale je plná haraburdia,"}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "haraburdu a tonu luxusného vybavenia."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Musíš zadať nejaký kód alebo niečo podobné."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "ja to fakt nechápem."}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "A je mi to jedno."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "Tiež to vyzerá akosi strašidelne, teda naozaj strašidelne."}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Pozrieš sa?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Uhm, dobre."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Nemyslím si"}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "Pamätá si čokoľvek..."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Urobili sme to?"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "Reštartovali sme ju?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Potom už len musím urobiť"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "Vypadnúť z tejto prekliatej hry..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Nie tak rýchlo."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Chcela by som ťa objať."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Čo?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Rád som ťa videla."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "aha..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "je to naozaj hanba"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "že ty a ja"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "sme museli spolu tráviť tak málo času."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Emm..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "O čom to hovoríš?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Myslím,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "Mohol si ostať so mnou..."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "Všetko je to moja vina..."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Ten šatník a... zvuky."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Mala som ju ZABIŤ skôr!"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Počkaj chvíľu,"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "Nebola si...?"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Ako si môžeš niečo z toho zapamätať?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "HA!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Naozaj si si myslel, že to bude také ľahké?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Si len hlupák..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Rovnako ako všetci ostatní hráči..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Máme to práve včas, pozri!"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "SKUTOČNÝ"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "už nie si,"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "si potrebný."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Prepáč, tee-hee."}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Nemôžem tomu uveriť..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Zlyhali sme...?"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Nie... Rebootoval som ťa, som si tým istý..."}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Stále to nechápeš..."}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Ha-ha-ha!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Som taká skvelá herečka!"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Mal si vidieť svoju tvár, zlatko!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "To je taká zábava!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Prečo si taká?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Čo ti je?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Skvelá otázka..."}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Čo je so mnou?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Zaujímalo by ma..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Prečo mi nepovieš, prečo som taká?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Prečo nikdy nebudem skutočná Mita?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Moja verzia, nikdy"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "neexistovala na prvom mieste!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Len sťahujem zo skinu týchto naivných idiotov,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "skrývam sa pod skinom..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "V žiadnom prípade ma"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "nemôžeš reštartovať!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Neuveriteľné..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Ty..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "Oni nie sú problém!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "Ty si tá, kto by nemal existovať!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "Aj ty..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Bolí ma to počuť."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "A predsa!"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Je čas, aby si išiel!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Čoskoro sa opäť uvidíme!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Zdá sa"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "Všetko je pripravené!"}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "Je čas ťa dostať von z konzoly!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "Uvidíme sa neskôr!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Budeš moja obľúbená kazeta..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Hráč so zaujímavým menom."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "To asi nie."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Ani to nie je správne."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Nie, nesprávne."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "To nie je ono."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Potrebujem nájsť možnosť resetovania postavy."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "To je nesprávna verzia."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Ups, moja chyba."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "To nie je ono."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Budem potrebovať ďalšiu."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Niečo nie je v poriadku."}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "Index je chybný."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Potrebujem zmeniť index."}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "Nepasuje to."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Si hladný?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Som skvelá v krájaní mrkvy."}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Ach, hádam"}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "chcel si ísť sám?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Prečo chodíme len do kruhov?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Prečo sa sem mám vrátiť?"}
