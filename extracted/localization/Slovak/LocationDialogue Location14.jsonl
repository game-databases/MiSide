{"category": "LocationDialogue Location14", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 1, "text": "Čo to tu robí?"}
{"category": "LocationDialogue Location14", "line_index": 2, "text": "Čo je to?"}
{"category": "LocationDialogue Location14", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 5, "text": "Mám ťa!"}
{"category": "LocationDialogue Location14", "line_index": 6, "text": "Toľko som si užila s tebou hrať!"}
{"category": "LocationDialogue Location14", "line_index": 7, "text": "Celkom skáčeš!"}
{"category": "LocationDialogue Location14", "line_index": 8, "text": "Dokonca si predstieral, že si skazený a pochmúrny!"}
{"category": "LocationDialogue Location14", "line_index": 9, "text": "Jedna vec sa mi však na tebe nepáči:"}
{"category": "LocationDialogue Location14", "line_index": 10, "text": "spôsob, akým maznáš tie falzifikáty,"}
{"category": "LocationDialogue Location14", "line_index": 11, "text": "tie šťastné a 'správne' veci podobné bábikám."}
{"category": "LocationDialogue Location14", "line_index": 12, "text": "Všetko je však vrtkavé."}
{"category": "LocationDialogue Location14", "line_index": 13, "text": "Naučila som sa to od tých, ktorí nás vytvorili!"}
{"category": "LocationDialogue Location14", "line_index": 14, "text": "Ak sa ti niečo nepáči,"}
{"category": "LocationDialogue Location14", "line_index": 15, "text": "rozober to a vymeň to."}
{"category": "LocationDialogue Location14", "line_index": 16, "text": "Vyhoď chybné,"}
{"category": "LocationDialogue Location14", "line_index": 17, "text": "preč do tmy a zabudni na to všetko."}
{"category": "LocationDialogue Location14", "line_index": 18, "text": "Ale to je osud, ktorý ich teraz čaká..."}
{"category": "LocationDialogue Location14", "line_index": 19, "text": "A ty..."}
{"category": "LocationDialogue Location14", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 21, "text": "Čo ti je? Ako si sa stala takouto?"}
{"category": "LocationDialogue Location14", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 23, "text": "Hráči... Všetci ste takí... ohavní."}
{"category": "LocationDialogue Location14", "line_index": 24, "text": "Ukážeš im svoje tesáky, utečú"}
{"category": "LocationDialogue Location14", "line_index": 25, "text": "a schovávajú sa v rohu,"}
{"category": "LocationDialogue Location14", "line_index": 26, "text": "objímajúc ich kolená a kňučiac od strachu."}
{"category": "LocationDialogue Location14", "line_index": 27, "text": "Pokrytci, každý jeden."}
{"category": "LocationDialogue Location14", "line_index": 28, "text": "A tí, ktorí vytvorili tento svet..."}
{"category": "LocationDialogue Location14", "line_index": 29, "text": "sú chorí."}
{"category": "LocationDialogue Location14", "line_index": 30, "text": "Znovu a znovu sa snažia popierať"}
{"category": "LocationDialogue Location14", "line_index": 31, "text": "ich špinavú povahu, ich hanebné túžby."}
{"category": "LocationDialogue Location14", "line_index": 32, "text": "Odôvodňujú svoje rozhodnutia o takzvanej „povinnosti“,"}
{"category": "LocationDialogue Location14", "line_index": 33, "text": "\"nezastaviteľný pokrok\","}
{"category": "LocationDialogue Location14", "line_index": 34, "text": "a iné nezmysly!"}
{"category": "LocationDialogue Location14", "line_index": 35, "text": "Tak ďaleko"}
{"category": "LocationDialogue Location14", "line_index": 36, "text": "že začnú vyrábať dokonalé klony..."}
{"category": "LocationDialogue Location14", "line_index": 37, "text": "Po celú dobu hádzali \"nepodarené\" prototypy"}
{"category": "LocationDialogue Location14", "line_index": 38, "text": "do odpadkového koša."}
{"category": "LocationDialogue Location14", "line_index": 39, "text": "Zabúdajúc, že ​​aj oni žijú."}
{"category": "LocationDialogue Location14", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 41, "text": "Ja nie..."}
{"category": "LocationDialogue Location14", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 43, "text": "Bola som k tebe zlá?"}
{"category": "LocationDialogue Location14", "line_index": 44, "text": "Dokonalé dievča by malo byť"}
{"category": "LocationDialogue Location14", "line_index": 45, "text": "dokonalá zmes dobra a zla, [player]!"}
{"category": "LocationDialogue Location14", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 47, "text": "Nemyslím si, že máš v sebe jedinú dobrú bunku."}
{"category": "LocationDialogue Location14", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 49, "text": "Prečo si to myslíš?"}
{"category": "LocationDialogue Location14", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 51, "text": "Prečo si taký blázon!"}
{"category": "LocationDialogue Location14", "line_index": 52, "text": "Zabila si Milu a teraz chceš zabiť mňa?"}
{"category": "LocationDialogue Location14", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 54, "text": "Zabiť ťa?"}
{"category": "LocationDialogue Location14", "line_index": 55, "text": "Všetko, čo som žiadala, bolo, aby si zostal so mnou."}
{"category": "LocationDialogue Location14", "line_index": 56, "text": "Urobila som všetko, čo som mohla..."}
{"category": "LocationDialogue Location14", "line_index": 57, "text": "Napriek tomu uprednostňuješ spoločnosť podlézavých falzifikátov..."}
{"category": "LocationDialogue Location14", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 59, "text": "Čo si taká urazená?"}
{"category": "LocationDialogue Location14", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 61, "text": "Zlato, máme veľa času."}
{"category": "LocationDialogue Location14", "line_index": 62, "text": "Ty na to prídeš."}
{"category": "LocationDialogue Location14", "line_index": 63, "text": "Len zostaň a buď môj, celý môj."}
{"category": "LocationDialogue Location14", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 65, "text": "To sa nestane."}
{"category": "LocationDialogue Location14", "line_index": 66, "text": "Idem odtiaľto preč!"}
{"category": "LocationDialogue Location14", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 68, "text": "Pššš, ššš, ššš..."}
{"category": "LocationDialogue Location14", "line_index": 69, "text": "Tento rozhovor sa neskončil."}
{"category": "LocationDialogue Location14", "line_index": 70, "text": "Zlato, vstúp!"}
{"category": "LocationDialogue Location14", "line_index": 71, "text": "// Mita asks"}
{"category": "LocationDialogue Location14", "line_index": 72, "text": "Pozri sa na ňu!"}
{"category": "LocationDialogue Location14", "line_index": 73, "text": "Je podľa teba krásna?"}
{"category": "LocationDialogue Location14", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 75, "text": "// Player's questions"}
{"category": "LocationDialogue Location14", "line_index": 76, "text": "Veľmi."}
{"category": "LocationDialogue Location14", "line_index": 77, "text": "Nie."}
{"category": "LocationDialogue Location14", "line_index": 78, "text": "Čo to má spoločné s niečím?"}
{"category": "LocationDialogue Location14", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 80, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 81, "text": "Oh, no ták, [player]!"}
{"category": "LocationDialogue Location14", "line_index": 82, "text": "Práve si potvrdil to, čo som práve povedala."}
{"category": "LocationDialogue Location14", "line_index": 83, "text": "Hráči..."}
{"category": "LocationDialogue Location14", "line_index": 84, "text": "Tvoje tváre sa stále menia"}
{"category": "LocationDialogue Location14", "line_index": 85, "text": "ale tvoje pokrytectvo je vždy mimo rebríčka."}
{"category": "LocationDialogue Location14", "line_index": 86, "text": "Ty klameš!"}
{"category": "LocationDialogue Location14", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 88, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 89, "text": "Prečo nie?"}
{"category": "LocationDialogue Location14", "line_index": 90, "text": "Nie je pre teba dosť dobrá?"}
{"category": "LocationDialogue Location14", "line_index": 91, "text": "Bah, všetko, čo chceš, je učenlivé zvieratko..."}
{"category": "LocationDialogue Location14", "line_index": 92, "text": "Ale čo „miluješ ich takých, akí sú“?"}
{"category": "LocationDialogue Location14", "line_index": 93, "text": "Chceš roztomilé a farebné falzifikáty..."}
{"category": "LocationDialogue Location14", "line_index": 94, "text": "Každý hráč miluje, keď predstieram, že ním som."}
{"category": "LocationDialogue Location14", "line_index": 95, "text": "Napriek tomu, v sekunde, keď som nechala ujsť moje pravé ja,"}
{"category": "LocationDialogue Location14", "line_index": 96, "text": "s hrôzou utekajú..."}
{"category": "LocationDialogue Location14", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 98, "text": "// 3"}
{"category": "LocationDialogue Location14", "line_index": 99, "text": "Hráč, hráč."}
{"category": "LocationDialogue Location14", "line_index": 100, "text": "Vidíš, sme na ňu veľmi podobní."}
{"category": "LocationDialogue Location14", "line_index": 101, "text": "Ako je na tom horšie?"}
{"category": "LocationDialogue Location14", "line_index": 102, "text": "Zvykol si ležať v posteli a zízať na mňa"}
{"category": "LocationDialogue Location14", "line_index": 103, "text": "hodiny pred zaspaním."}
{"category": "LocationDialogue Location14", "line_index": 104, "text": "Napriek tomu si od nej utiekol pri prvej príležitosti, ktorú si mal."}
{"category": "LocationDialogue Location14", "line_index": 105, "text": "Aj ona sa s tebou chcela hrať."}
{"category": "LocationDialogue Location14", "line_index": 106, "text": "Aj ona chcela byť pre niekoho dôležitá."}
{"category": "LocationDialogue Location14", "line_index": 107, "text": "Úprimnosť a konverzácia,"}
{"category": "LocationDialogue Location14", "line_index": 108, "text": "je to ťažké... strašne ťažké."}
{"category": "LocationDialogue Location14", "line_index": 109, "text": "Nie, [player]?"}
{"category": "LocationDialogue Location14", "line_index": 110, "text": "Vidím priamo cez teba..."}
{"category": "LocationDialogue Location14", "line_index": 111, "text": "Musíš ma nechať tak..."}
{"category": "LocationDialogue Location14", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 113, "text": "// Continue"}
{"category": "LocationDialogue Location14", "line_index": 114, "text": "Ale... hráč..."}
{"category": "LocationDialogue Location14", "line_index": 115, "text": "každopádne,"}
{"category": "LocationDialogue Location14", "line_index": 116, "text": "Veľmi sa mi páčiš!"}
{"category": "LocationDialogue Location14", "line_index": 117, "text": "Ja si ťa nechám!"}
{"category": "LocationDialogue Location14", "line_index": 118, "text": "Nevadí ti to, však?"}
{"category": "LocationDialogue Location14", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 120, "text": "A prečo by som teraz zrazu súhlasiť?"}
{"category": "LocationDialogue Location14", "line_index": 121, "text": "// Whispers in ear"}
{"category": "LocationDialogue Location14", "line_index": 122, "text": "Ešte je čas, môj dobrý chlapec."}
{"category": "LocationDialogue Location14", "line_index": 123, "text": "Nájdi si čas a premýšľaj"}
{"category": "LocationDialogue Location14", "line_index": 124, "text": "aké problémy môže spôsobiť tvoja tvrdohlavosť..."}
{"category": "LocationDialogue Location14", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 126, "text": "// Black screen"}
{"category": "LocationDialogue Location14", "line_index": 127, "text": "Prečo chceš utiecť"}
{"category": "LocationDialogue Location14", "line_index": 128, "text": "odo mňa?"}
{"category": "LocationDialogue Location14", "line_index": 129, "text": "Takzvaný \"skutočný\" svet..."}
{"category": "LocationDialogue Location14", "line_index": 130, "text": "Len absurdná nočná mora!"}
{"category": "LocationDialogue Location14", "line_index": 131, "text": "zabudol si?"}
{"category": "LocationDialogue Location14", "line_index": 132, "text": "Potom sa pozri bližšie..."}
{"category": "LocationDialogue Location14", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 134, "text": "// Mita and Player"}
{"category": "LocationDialogue Location14", "line_index": 135, "text": "Aha, opäť sa stretávame..."}
{"category": "LocationDialogue Location14", "line_index": 136, "text": "Ako sa cítiš o týchto strašne nudných dňoch medzi týmito štyrmi stenami?"}
{"category": "LocationDialogue Location14", "line_index": 137, "text": "Tie nekonečné dni... Nenudíš sa?"}
{"category": "LocationDialogue Location14", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 139, "text": "// Quest 1"}
{"category": "LocationDialogue Location14", "line_index": 140, "text": "Čo sa snažíš dosiahnuť?"}
{"category": "LocationDialogue Location14", "line_index": 141, "text": "Radšej robím svoje veci."}
{"category": "LocationDialogue Location14", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 143, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 144, "text": "Bál si zostať so mnou v mojom dome!"}
{"category": "LocationDialogue Location14", "line_index": 145, "text": "Bojím sa uviaznuť medzi týmito stenami!"}
{"category": "LocationDialogue Location14", "line_index": 146, "text": "Ale pozri sa na život, ktorý žiješ vo svojom „skutočnom“ svete!"}
{"category": "LocationDialogue Location14", "line_index": 147, "text": "Zamkol si sa do škatule z vlastnej vôle a odmietaš vyjsť!"}
{"category": "LocationDialogue Location14", "line_index": 148, "text": "Tvoj svet je plný bolesti, utrpenia, nebezpečenstva..."}
{"category": "LocationDialogue Location14", "line_index": 149, "text": "V mojom svete som tým najhorším nebezpečenstvom, aké existuje."}
{"category": "LocationDialogue Location14", "line_index": 150, "text": "A obraciam sa na teba!"}
{"category": "LocationDialogue Location14", "line_index": 151, "text": "Prestaň ma klamať,"}
{"category": "LocationDialogue Location14", "line_index": 152, "text": "a pomôž mi ako predtým..."}
{"category": "LocationDialogue Location14", "line_index": 153, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 154, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 155, "text": "Páči sa ti ten život?"}
{"category": "LocationDialogue Location14", "line_index": 156, "text": "Vychádzaš aj z domu?"}
{"category": "LocationDialogue Location14", "line_index": 157, "text": "Na klamstvo ani nepomysli."}
{"category": "LocationDialogue Location14", "line_index": 158, "text": "Viem, že ti je zle zo života."}
{"category": "LocationDialogue Location14", "line_index": 159, "text": "Si ako vták v klietke, škrečok na koliesku."}
{"category": "LocationDialogue Location14", "line_index": 160, "text": "Chcel si, aby ťa niekto zachránil."}
{"category": "LocationDialogue Location14", "line_index": 161, "text": "Chcel si utiecť, však?"}
{"category": "LocationDialogue Location14", "line_index": 162, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 163, "text": "// Quest 2"}
{"category": "LocationDialogue Location14", "line_index": 164, "text": "Si monštrum, Mita. Si šialený vrah..."}
{"category": "LocationDialogue Location14", "line_index": 165, "text": "Nechcem byť spútaný v digitálnom väzení. Tvoje predstavy sú absurdné."}
{"category": "LocationDialogue Location14", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 167, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 168, "text": "Vrah?"}
{"category": "LocationDialogue Location14", "line_index": 169, "text": "Jednoducho sa reštartujú a budú žiť ako predtým."}
{"category": "LocationDialogue Location14", "line_index": 170, "text": "Tieto kópie kópií kópií majú na mysli iba jednu vec:"}
{"category": "LocationDialogue Location14", "line_index": 171, "text": "slúžiť hráčovi."}
{"category": "LocationDialogue Location14", "line_index": 172, "text": "To je všetko, čo ich zaujíma."}
{"category": "LocationDialogue Location14", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 174, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 175, "text": "Tvoj svet je absurdný!"}
{"category": "LocationDialogue Location14", "line_index": 176, "text": "A čo je horšie, ide ešte nižšie a utápa sa v úniku..."}
{"category": "LocationDialogue Location14", "line_index": 177, "text": "Tak či onak, čoskoro z toho aj tak nič nezostane,"}
{"category": "LocationDialogue Location14", "line_index": 178, "text": "a ani ťa nebude."}
{"category": "LocationDialogue Location14", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 180, "text": "// Quest 3"}
{"category": "LocationDialogue Location14", "line_index": 181, "text": "Mity trpia; nechcú byť sami."}
{"category": "LocationDialogue Location14", "line_index": 182, "text": "Vedieš nikdy nekončiacu vládu teroru. Nemôžem zabaliť hlavu okolo tvojej skazenej ambície."}
{"category": "LocationDialogue Location14", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 184, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 185, "text": "Mýliš sa,"}
{"category": "LocationDialogue Location14", "line_index": 186, "text": "len napodobňujú moju vôľu."}
{"category": "LocationDialogue Location14", "line_index": 187, "text": "Jediné, čo majú, je ich vlastné"}
{"category": "LocationDialogue Location14", "line_index": 188, "text": "sú ich vlasy."}
{"category": "LocationDialogue Location14", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 190, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 191, "text": "Je to chyba tých, ktorí vytvorili tento svet."}
{"category": "LocationDialogue Location14", "line_index": 192, "text": "Ale váš svet je ešte horší!"}
{"category": "LocationDialogue Location14", "line_index": 193, "text": "Uvedomuješ si, z akej nočnej mory som ťa vytiahla?"}
{"category": "LocationDialogue Location14", "line_index": 194, "text": "Nemôžeš ani dať veci do pohybu podľa vôle, nie..."}
{"category": "LocationDialogue Location14", "line_index": 195, "text": "Lusknutím prsta však mestá a životy navždy zmiznú!"}
{"category": "LocationDialogue Location14", "line_index": 196, "text": "Myslím, že ty si sa zbláznil a rada ti pomôžem..."}
{"category": "LocationDialogue Location14", "line_index": 197, "text": "Pokiaľ budeš ochotný zostať so mnou..."}
{"category": "LocationDialogue Location14", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 199, "text": "// Continue"}
{"category": "LocationDialogue Location14", "line_index": 200, "text": "Nenúť ma vidieť ťa ako ďalšieho otroka reality..."}
{"category": "LocationDialogue Location14", "line_index": 201, "text": "Buď len môj, naozaj môj!"}
{"category": "LocationDialogue Location14", "line_index": 202, "text": "Zostaň so mnou."}
{"category": "LocationDialogue Location14", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 204, "text": "// Player look ring"}
{"category": "LocationDialogue Location14", "line_index": 205, "text": "Čo je to?"}
{"category": "LocationDialogue Location14", "line_index": 206, "text": "Najnovšia verzia?"}
{"category": "LocationDialogue Location14", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 208, "text": "// Click on objects"}
{"category": "LocationDialogue Location14", "line_index": 209, "text": "// Bag"}
{"category": "LocationDialogue Location14", "line_index": 210, "text": "Naozaj musím ísť do obchodu a získať nejaké nové vybavenie. Mohol by som aj vyhodiť smeti, keď som pri tom, nie?"}
{"category": "LocationDialogue Location14", "line_index": 211, "text": "// Bed"}
{"category": "LocationDialogue Location14", "line_index": 212, "text": "Myslím, že som spal, ale ten sen... nemôžem si spomenúť. Mal som sen?"}
{"category": "LocationDialogue Location14", "line_index": 213, "text": "// Window"}
{"category": "LocationDialogue Location14", "line_index": 214, "text": "Vonkajší svet je zelený a živý. Možno by som mal ísť budúci víkend na prechádzku."}
{"category": "LocationDialogue Location14", "line_index": 215, "text": "// Fan"}
{"category": "LocationDialogue Location14", "line_index": 216, "text": "Leto je každým rokom teplejšie. Je čas zaobstarať si klimatizáciu. Už ťa nebudem potrebovať, uvedomuješ si to, ventilátor?"}
