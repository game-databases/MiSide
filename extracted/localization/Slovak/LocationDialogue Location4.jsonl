{"category": "LocationDialogue Location4", "line_index": 0, "text": "Mita?"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "Aha, už si hore?"}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "ako si sa sem dostala?"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": "Práve si bola hneď vedľa mňa."}
{"category": "LocationDialogue Location4", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 5, "text": "Nie, nebola som."}
{"category": "LocationDialogue Location4", "line_index": 6, "text": "Zamrzol si pred zrkadlom."}
{"category": "LocationDialogue Location4", "line_index": 7, "text": "Tak som odišla."}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "Prečo sa izby zmenili?"}
{"category": "LocationDialogue Location4", "line_index": 9, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "Prerobila som miesto"}
{"category": "LocationDialogue Location4", "line_index": 11, "text": "aby si sa cítil viac ako doma."}
{"category": "LocationDialogue Location4", "line_index": 12, "text": "myslím,"}
{"category": "LocationDialogue Location4", "line_index": 13, "text": "štyri izby v rade -"}
{"category": "LocationDialogue Location4", "line_index": 14, "text": "to sa veľmi často nevidí."}
{"category": "LocationDialogue Location4", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 16, "text": "To si nemusela."}
{"category": "LocationDialogue Location4", "line_index": 17, "text": "Zvykal som si na rozloženie."}
{"category": "LocationDialogue Location4", "line_index": 18, "text": "V každom prípade si myslím, že s týmto rozložením sa budeš cítiť pohodlnejšie."}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Kartová hra Mita"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "Okej,"}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "začneme?"}
{"category": "LocationDialogue Location4", "line_index": 22, "text": "Aby som bola krátka,"}
{"category": "LocationDialogue Location4", "line_index": 23, "text": "tento čip označuje typ poškodenia."}
{"category": "LocationDialogue Location4", "line_index": 24, "text": "Napríklad zdravie."}
{"category": "LocationDialogue Location4", "line_index": 25, "text": "Každý hráme kartu,"}
{"category": "LocationDialogue Location4", "line_index": 26, "text": "a ak má tvoja karta vyššiu"}
{"category": "LocationDialogue Location4", "line_index": 27, "text": "zdravie"}
{"category": "LocationDialogue Location4", "line_index": 28, "text": "než moja,"}
{"category": "LocationDialogue Location4", "line_index": 29, "text": "vyhrávaš."}
{"category": "LocationDialogue Location4", "line_index": 30, "text": "Zober si karty."}
{"category": "LocationDialogue Location4", "line_index": 31, "text": "Ja som na rade."}
{"category": "LocationDialogue Location4", "line_index": 32, "text": "Och!"}
{"category": "LocationDialogue Location4", "line_index": 33, "text": "Dostala som dobrú ruku!"}
{"category": "LocationDialogue Location4", "line_index": 34, "text": "Idem prvá!"}
{"category": "LocationDialogue Location4", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 44, "text": "OK!"}
{"category": "LocationDialogue Location4", "line_index": 45, "text": "Si na rade!"}
{"category": "LocationDialogue Location4", "line_index": 46, "text": "Uh-huh."}
{"category": "LocationDialogue Location4", "line_index": 47, "text": "Si na rade!"}
{"category": "LocationDialogue Location4", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 49, "text": "Vyhráva najvyšší zdravotný stav!"}
{"category": "LocationDialogue Location4", "line_index": 50, "text": "Všetko je o sile!"}
{"category": "LocationDialogue Location4", "line_index": 51, "text": "Sústreď sa len na obranu!"}
{"category": "LocationDialogue Location4", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 54, "text": "Vyhral si!"}
{"category": "LocationDialogue Location4", "line_index": 55, "text": "Vyhral si!"}
{"category": "LocationDialogue Location4", "line_index": 56, "text": "Dostal si ma."}
{"category": "LocationDialogue Location4", "line_index": 57, "text": "Ach ty..."}
{"category": "LocationDialogue Location4", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 59, "text": "Vyhrávam!"}
{"category": "LocationDialogue Location4", "line_index": 60, "text": "Som víťazka!"}
{"category": "LocationDialogue Location4", "line_index": 61, "text": "Vyhrala som!"}
{"category": "LocationDialogue Location4", "line_index": 62, "text": "Hah, rozumiem!"}
{"category": "LocationDialogue Location4", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 64, "text": "To je remíza."}
{"category": "LocationDialogue Location4", "line_index": 65, "text": "Všetci rovnakí!"}
{"category": "LocationDialogue Location4", "line_index": 66, "text": "Teraz je to remíza!"}
{"category": "LocationDialogue Location4", "line_index": 67, "text": "Rovnaká hodnota..."}
{"category": "LocationDialogue Location4", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 79, "text": "// Kartová hra je prerušená"}
{"category": "LocationDialogue Location4", "line_index": 80, "text": "Čo je to za zvuk?"}
{"category": "LocationDialogue Location4", "line_index": 81, "text": "Ide to zo šatníka."}
{"category": "LocationDialogue Location4", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 83, "text": "Zvuk?"}
{"category": "LocationDialogue Location4", "line_index": 84, "text": "Aký zvuk?"}
{"category": "LocationDialogue Location4", "line_index": 85, "text": "Neboli tam žiadne zvuky."}
{"category": "LocationDialogue Location4", "line_index": 86, "text": "Čo si si myslel, že si počul?"}
{"category": "LocationDialogue Location4", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 88, "text": "Klepanie, akoby tam niekto bol."}
{"category": "LocationDialogue Location4", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 90, "text": "Ale..."}
{"category": "LocationDialogue Location4", "line_index": 91, "text": "Nikto tam nie je..."}
{"category": "LocationDialogue Location4", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 93, "text": "Chcel by som to otvoriť a skontrolovať."}
{"category": "LocationDialogue Location4", "line_index": 94, "text": "Som trochu vydesený."}
{"category": "LocationDialogue Location4", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 96, "text": "Ale prečo...?"}
{"category": "LocationDialogue Location4", "line_index": 97, "text": "Znovu..."}
{"category": "LocationDialogue Location4", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 105, "text": "Čo je s tebou!?"}
{"category": "LocationDialogue Location4", "line_index": 106, "text": "Ide o šatník..."}
{"category": "LocationDialogue Location4", "line_index": 107, "text": "Mám tam spodnú bielizeň...!"}
{"category": "LocationDialogue Location4", "line_index": 108, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 109, "text": "Ty predo mnou niečo tajíš?"}
{"category": "LocationDialogue Location4", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 111, "text": "Prečo mi jednoducho neveríš?"}
{"category": "LocationDialogue Location4", "line_index": 112, "text": "čo robím zle?"}
{"category": "LocationDialogue Location4", "line_index": 113, "text": "Čo chcem..."}
{"category": "LocationDialogue Location4", "line_index": 114, "text": "všetko čo chcem je aby si bol so mnou."}
{"category": "LocationDialogue Location4", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 116, "text": "Rád by som to sľúbil, ale čo bude ďalej?"}
{"category": "LocationDialogue Location4", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 118, "text": "Prečo si taký prilepený na tom šatníku?!"}
{"category": "LocationDialogue Location4", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 120, "text": "Chcem vedieť, čo to preboha bolo za klopanie!"}
{"category": "LocationDialogue Location4", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 122, "text": "Je to len..."}
{"category": "LocationDialogue Location4", "line_index": 123, "text": "Tento svet"}
{"category": "LocationDialogue Location4", "line_index": 124, "text": "sú len tieto štyri izby."}
{"category": "LocationDialogue Location4", "line_index": 125, "text": "To ti nestačí, však?"}
{"category": "LocationDialogue Location4", "line_index": 126, "text": "Prečo jednoducho neskúsiš zostať so mnou?"}
{"category": "LocationDialogue Location4", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 129, "text": "// Nezostávaj s Mitou"}
{"category": "LocationDialogue Location4", "line_index": 130, "text": "Chápem to."}
{"category": "LocationDialogue Location4", "line_index": 131, "text": "Znovu..."}
{"category": "LocationDialogue Location4", "line_index": 132, "text": "Ak chceš skontrolovať šatník,"}
{"category": "LocationDialogue Location4", "line_index": 133, "text": "potom to urob."}
{"category": "LocationDialogue Location4", "line_index": 134, "text": "Choď, zisti to!"}
{"category": "LocationDialogue Location4", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 139, "text": "Čo to..."}
{"category": "LocationDialogue Location4", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 141, "text": "To sa niekedy stáva."}
{"category": "LocationDialogue Location4", "line_index": 142, "text": "Miestnosť sa zasekla pri načítavaní."}
{"category": "LocationDialogue Location4", "line_index": 143, "text": "Počkaj chvíľu."}
{"category": "LocationDialogue Location4", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 145, "text": "Toto je také zvláštne."}
{"category": "LocationDialogue Location4", "line_index": 146, "text": "Sme vnútri niekoho telefónu?"}
{"category": "LocationDialogue Location4", "line_index": 147, "text": "Možno pomalý s dlhými časmi načítania?"}
{"category": "LocationDialogue Location4", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 149, "text": "Vôbec nie."}
{"category": "LocationDialogue Location4", "line_index": 150, "text": "Ale nie všetko je dokonalé"}
{"category": "LocationDialogue Location4", "line_index": 151, "text": "v tomto svete..."}
{"category": "LocationDialogue Location4", "line_index": 152, "text": "Nakladajú nás"}
{"category": "LocationDialogue Location4", "line_index": 153, "text": "jadrom sveta."}
{"category": "LocationDialogue Location4", "line_index": 154, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 155, "text": "Jadro sveta?"}
{"category": "LocationDialogue Location4", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 157, "text": "Typické, nemyslíš?"}
{"category": "LocationDialogue Location4", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 159, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 161, "text": "Každopádne môžeme"}
{"category": "LocationDialogue Location4", "line_index": 162, "text": "hrať konzolovú hru"}
{"category": "LocationDialogue Location4", "line_index": 163, "text": "alebo len karty."}
{"category": "LocationDialogue Location4", "line_index": 164, "text": "Vyber si."}
{"category": "LocationDialogue Location4", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 167, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 168, "text": "// Mita hrať boj"}
{"category": "LocationDialogue Location4", "line_index": 169, "text": "Chceš bojovať?"}
{"category": "LocationDialogue Location4", "line_index": 170, "text": "Musíš vyhrať"}
{"category": "LocationDialogue Location4", "line_index": 171, "text": "štyrikrát."}
{"category": "LocationDialogue Location4", "line_index": 172, "text": "He-he"}
{"category": "LocationDialogue Location4", "line_index": 173, "text": "Neboj sa,"}
{"category": "LocationDialogue Location4", "line_index": 174, "text": "pôjdem najprv pokojne."}
{"category": "LocationDialogue Location4", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 176, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 177, "text": "To je dobrý chlapec."}
{"category": "LocationDialogue Location4", "line_index": 178, "text": "Radšej sa sústreď!"}
{"category": "LocationDialogue Location4", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 180, "text": "Och!"}
{"category": "LocationDialogue Location4", "line_index": 181, "text": "Dobre, dobre."}
{"category": "LocationDialogue Location4", "line_index": 182, "text": "Myslím to vážne."}
{"category": "LocationDialogue Location4", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 184, "text": "Páni!"}
{"category": "LocationDialogue Location4", "line_index": 185, "text": "Uvidíme, či ma"}
{"category": "LocationDialogue Location4", "line_index": 186, "text": "teraz porazíš!"}
{"category": "LocationDialogue Location4", "line_index": 187, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 188, "text": "si"}
{"category": "LocationDialogue Location4", "line_index": 189, "text": "jednoducho"}
{"category": "LocationDialogue Location4", "line_index": 190, "text": "neuveriteľný! Tvoje prsty sú úžasné!"}
{"category": "LocationDialogue Location4", "line_index": 191, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 193, "text": "Hej, čo sa deje?"}
{"category": "LocationDialogue Location4", "line_index": 194, "text": "To je otrepané."}
{"category": "LocationDialogue Location4", "line_index": 195, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 196, "text": "No, to je všetko."}
{"category": "LocationDialogue Location4", "line_index": 197, "text": "Smrteľnosť, ak si si to nevšimol."}
{"category": "LocationDialogue Location4", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 199, "text": "Hej,"}
{"category": "LocationDialogue Location4", "line_index": 200, "text": "daj sa dokopy alebo zostaň navždy porazeným!"}
{"category": "LocationDialogue Location4", "line_index": 201, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 202, "text": "Čo je s tebou dnes?"}
{"category": "LocationDialogue Location4", "line_index": 203, "text": "Vymlátila som z teba všetku bielu tekutinu."}
{"category": "LocationDialogue Location4", "line_index": 204, "text": "Nedal si do toho všetko..."}
{"category": "LocationDialogue Location4", "line_index": 205, "text": "preto som vyhrala!"}
{"category": "LocationDialogue Location4", "line_index": 206, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 208, "text": "Dobre teda."}
{"category": "LocationDialogue Location4", "line_index": 209, "text": "Čo keby sme si zahrali karty?"}
{"category": "LocationDialogue Location4", "line_index": 210, "text": "V mojej spálni."}
{"category": "LocationDialogue Location4", "line_index": 211, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 214, "text": "// Door > [CHYBA]"}
{"category": "LocationDialogue Location4", "line_index": 215, "text": "Čo sa deje?"}
{"category": "LocationDialogue Location4", "line_index": 216, "text": "Kde je..."}
{"category": "LocationDialogue Location4", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 218, "text": "Och."}
{"category": "LocationDialogue Location4", "line_index": 219, "text": "prepáč..."}
{"category": "LocationDialogue Location4", "line_index": 220, "text": "Niečo som si stiahla"}
{"category": "LocationDialogue Location4", "line_index": 221, "text": "z netu."}
{"category": "LocationDialogue Location4", "line_index": 222, "text": "Chcela som šmrk"}
{"category": "LocationDialogue Location4", "line_index": 223, "text": "trochu zvonku."}
{"category": "LocationDialogue Location4", "line_index": 224, "text": "Ale ukazuje sa"}
{"category": "LocationDialogue Location4", "line_index": 225, "text": "so súborom nebolo niečo v poriadku."}
{"category": "LocationDialogue Location4", "line_index": 226, "text": "Opravím to neskôr."}
{"category": "LocationDialogue Location4", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 228, "text": "Preto nemôžeme vyjsť z domu?"}
{"category": "LocationDialogue Location4", "line_index": 229, "text": "Áno, práve preto."}
{"category": "LocationDialogue Location4", "line_index": 230, "text": "// Mita hanblivý"}
{"category": "LocationDialogue Location4", "line_index": 231, "text": "hej..."}
{"category": "LocationDialogue Location4", "line_index": 232, "text": "Čo je to s tebou?"}
{"category": "LocationDialogue Location4", "line_index": 233, "text": "chceš niečo?"}
{"category": "LocationDialogue Location4", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 236, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 237, "text": "// Nástenné hodiny"}
{"category": "LocationDialogue Location4", "line_index": 238, "text": "Tieto hodiny,"}
{"category": "LocationDialogue Location4", "line_index": 239, "text": "koľko ukazujú čas?"}
{"category": "LocationDialogue Location4", "line_index": 240, "text": "Herný čas?"}
{"category": "LocationDialogue Location4", "line_index": 241, "text": "Alebo je to synchronizované s mojím telefónom?"}
{"category": "LocationDialogue Location4", "line_index": 242, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 243, "text": "No ako by som to mohla povedať..."}
{"category": "LocationDialogue Location4", "line_index": 244, "text": "úprimne,"}
{"category": "LocationDialogue Location4", "line_index": 245, "text": "Je jedno koľko je hodín..."}
{"category": "LocationDialogue Location4", "line_index": 246, "text": "Či už je neskoro alebo skoro,"}
{"category": "LocationDialogue Location4", "line_index": 247, "text": "silné dievča ako ja"}
{"category": "LocationDialogue Location4", "line_index": 248, "text": "je vždy plný energie -"}
{"category": "LocationDialogue Location4", "line_index": 249, "text": "Nikdy sa neunavím!"}
{"category": "LocationDialogue Location4", "line_index": 250, "text": "Môžeme mať večnú jar,"}
{"category": "LocationDialogue Location4", "line_index": 251, "text": "alebo nekonečné popoludnie!"}
{"category": "LocationDialogue Location4", "line_index": 252, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 253, "text": "zaujímavé..."}
{"category": "LocationDialogue Location4", "line_index": 254, "text": "ale aj trochu strašidelné."}
{"category": "LocationDialogue Location4", "line_index": 255, "text": "Zaseknutý v rovnakom momente, navždy..."}
{"category": "LocationDialogue Location4", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 258, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 259, "text": "// Fotky Mita"}
{"category": "LocationDialogue Location4", "line_index": 260, "text": "Pekné fotky."}
{"category": "LocationDialogue Location4", "line_index": 261, "text": "Hádam sú to od teba?"}
{"category": "LocationDialogue Location4", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 263, "text": "Áno."}
{"category": "LocationDialogue Location4", "line_index": 264, "text": "Aj ja ich mám rada."}
{"category": "LocationDialogue Location4", "line_index": 265, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 266, "text": "Kto ich vzal?"}
{"category": "LocationDialogue Location4", "line_index": 267, "text": "Sú na tomto svete aj iní?"}
{"category": "LocationDialogue Location4", "line_index": 268, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 269, "text": "Dalo by sa to povedať."}
{"category": "LocationDialogue Location4", "line_index": 270, "text": "Nakoniec ťa predstavím."}
{"category": "LocationDialogue Location4", "line_index": 271, "text": "Len ešte nie."}
{"category": "LocationDialogue Location4", "line_index": 272, "text": "Zatiaľ chcem byť len s tebou sama."}
{"category": "LocationDialogue Location4", "line_index": 273, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 275, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 276, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 277, "text": "// Portál"}
{"category": "LocationDialogue Location4", "line_index": 278, "text": "Kam sa podel portál?"}
{"category": "LocationDialogue Location4", "line_index": 279, "text": "Alebo ako si to nazvala?"}
{"category": "LocationDialogue Location4", "line_index": 280, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 281, "text": "Použila som"}
{"category": "LocationDialogue Location4", "line_index": 282, "text": "malú mágiu"}
{"category": "LocationDialogue Location4", "line_index": 283, "text": "a presunula ho"}
{"category": "LocationDialogue Location4", "line_index": 284, "text": "niekde inde."}
{"category": "LocationDialogue Location4", "line_index": 285, "text": "Už to nepotrebujeme."}
{"category": "LocationDialogue Location4", "line_index": 286, "text": "Len by to prekážalo."}
{"category": "LocationDialogue Location4", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 288, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 289, "text": "// Zrkadlo v spálni"}
{"category": "LocationDialogue Location4", "line_index": 290, "text": "Pohľad do zrkadla bez"}
{"category": "LocationDialogue Location4", "line_index": 291, "text": "odrazu je strašidelné."}
{"category": "LocationDialogue Location4", "line_index": 292, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 293, "text": "Môžeme zapnúť odrazy"}
{"category": "LocationDialogue Location4", "line_index": 294, "text": "ak naozaj chceš."}
{"category": "LocationDialogue Location4", "line_index": 295, "text": "Ale, naozaj ich potrebujeme?"}
{"category": "LocationDialogue Location4", "line_index": 296, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 297, "text": "Samozrejme, že áno."}
{"category": "LocationDialogue Location4", "line_index": 298, "text": "Alebo... bude mať ich zapnutie následky?"}
{"category": "LocationDialogue Location4", "line_index": 299, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 300, "text": "áno."}
{"category": "LocationDialogue Location4", "line_index": 301, "text": "Zakoktáme sa a budeme sa pohybovať pomalšie."}
{"category": "LocationDialogue Location4", "line_index": 302, "text": "Videl si niekedy karikatúru s nízkym počtom snímok za sekundu?"}
{"category": "LocationDialogue Location4", "line_index": 303, "text": "U nás to tak bude stále."}
{"category": "LocationDialogue Location4", "line_index": 304, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 305, "text": "Dobre."}
{"category": "LocationDialogue Location4", "line_index": 306, "text": "Potom možno radšej necháme odrazy vypnuté..."}
{"category": "LocationDialogue Location4", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 308, "text": "Ahoj, [hráč],"}
{"category": "LocationDialogue Location4", "line_index": 309, "text": "určite máš rád zrkadlá, však?"}
{"category": "LocationDialogue Location4", "line_index": 310, "text": "Bojíš sa vidieť úsmev na tvojej tvári?"}
{"category": "LocationDialogue Location4", "line_index": 311, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 312, "text": "Čo? Nie naozaj..."}
{"category": "LocationDialogue Location4", "line_index": 313, "text": "Som len unavený"}
{"category": "LocationDialogue Location4", "line_index": 314, "text": "po všetkej práci."}
{"category": "LocationDialogue Location4", "line_index": 315, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 316, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 317, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 318, "text": "// Modré tenisky"}
{"category": "LocationDialogue Location4", "line_index": 319, "text": "To sú tvoje?"}
{"category": "LocationDialogue Location4", "line_index": 320, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 321, "text": "Nie, sú tvoje."}
{"category": "LocationDialogue Location4", "line_index": 322, "text": "nepamätáš?"}
{"category": "LocationDialogue Location4", "line_index": 323, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 324, "text": "Nepamätám si, že by som mal také tenisky."}
{"category": "LocationDialogue Location4", "line_index": 325, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 326, "text": "Teraz áno."}
{"category": "LocationDialogue Location4", "line_index": 327, "text": "Môžeš ich nosiť"}
{"category": "LocationDialogue Location4", "line_index": 328, "text": "keď ideme von."}
{"category": "LocationDialogue Location4", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 330, "text": "A čo oblečenie?"}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "Všetko, čo mám na tomto svete"}
{"category": "LocationDialogue Location4", "line_index": 332, "text": "sú šaty, ktoré mám na sebe."}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "Mám nejaký spôsob, ako získať nové?"}
{"category": "LocationDialogue Location4", "line_index": 334, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 335, "text": "Samozrejme, že existujú."}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "Aj keď som videla, čo nosíš..."}
{"category": "LocationDialogue Location4", "line_index": 337, "text": "a úprimne, tvoj vkus nie je skvelý."}
{"category": "LocationDialogue Location4", "line_index": 338, "text": "Tak či onak, pomôžem ti nejaké získať."}
{"category": "LocationDialogue Location4", "line_index": 339, "text": "Len nie práve teraz."}
{"category": "LocationDialogue Location4", "line_index": 340, "text": "Je to prísľub."}
{"category": "LocationDialogue Location4", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 342, "text": "Dobre."}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Hry v TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "Čo chceš hrať?"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Mlieko z diviny"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "Toto je bojová hra!"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "Pozrime sa, kto zakysne ako prvý!"}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "Aká hra!"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": "Mlieka máme zatiaľ dosť, poďme robiť niečo iné."}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Hra tučniakov"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "V tejto hre sa tučniak"}
{"category": "LocationDialogue Location4", "line_index": 354, "text": "šmýka."}
{"category": "LocationDialogue Location4", "line_index": 355, "text": "To sme už hrali."}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Zostaň s Mitou"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "Čo?"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "To myslíš vážne? Myslela som, že si..."}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "Som nesmierne šťastná!"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "A trochu zmätená..."}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "Ale..."}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "Prosím, zostaň so mnou -"}
{"category": "LocationDialogue Location4", "line_index": 364, "text": "vždy a navždy."}
{"category": "LocationDialogue Location4", "line_index": 365, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 367, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 368, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 369, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 370, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 372, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 373, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 374, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 375, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 376, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 377, "text": "// Hra o tučniakoch"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "Je to super jednoduché:"}
{"category": "LocationDialogue Location4", "line_index": 379, "text": "len zbierať snehové gule."}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "Ten, kto nazbiera viac, vyhráva!"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "Poďme hrať dve kolá, dobre?!"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// Prvá mapa"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "Wow, ako si ich získal toľko?"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "Tee-hee! Mám najviac snehových gúľ!"}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "Lepšie dohnať!"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "Ha, 1:1!"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// Druhá mapa"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "Si prirodzený tučniak!"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "Mala by som ťa dostať na skutočný ľad!"}
{"category": "LocationDialogue Location4", "line_index": 390, "text": "Pfft, si taký pomalý."}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "Stále myslíš na posledné kolo?"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "Wow, remíza! Teraz je to zriedkavé!"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// Hra sa skončila"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "Dobre, chceš hrať niečo iné?"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "Alebo si skončil?"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "Načo to potrebuješ?"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "Toľký hráč?"}
