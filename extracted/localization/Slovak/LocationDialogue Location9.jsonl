{"category": "LocationDialogue Location9", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Hej, ty!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Dobrý deň!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Chceš sa dostať von?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Potom mi pomôž nájsť kľúč!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Pána! Nie je tu žiadny kľúč!"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Nič tu "}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "Absolútne nič!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Našila som ho!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// The usual conversation"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Hm, myslela som, že budeš kratší!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "Si vysoký"}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "presne ako moja sestra!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "Tvoja sestra?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Áno, moja sestra."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Nehovor, že si ju nikdy nestretol!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Uh... stretol som ju... myslím?"}
{"category": "LocationDialogue Location9", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Si hlupák?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "ehm..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "Ukázalo sa, že si..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "Poď, pomôž mi už nájsť kľúč!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// Next work"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Poď."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Daj železo do potrubia!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Ďakujem!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "Teraz mi daj to drevo!"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Ďakujem!"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Ešte nejakú pomoc, prosím!"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Hotovo! Teraz..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "Wow, to je nádhera."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Stlač, no ták!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Pekne!"}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "Tak, vezmi si to!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "Kľúč je tvoj!"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// Quest 1 (Ty si Mita?)"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Ja som ChibiMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Tony čiar,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "najjednoduchšia armatúra a "}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "najlepšie zo všetkého - nádherné vlasy!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// Quest 2 (Videli sme sa už?)"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Pán hlupák!"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "Si roztomilý, vieš,"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "dávať takéto hlúpe otázky."}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "hoci,"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "toto je prvýkrát, čo sa s tebou stretávam!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Ale počúvaj..."}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Ak niekto ukradol môj úžasný pohľad,"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "Nechám ich to ľutovať!"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// Quest 3 (Prečo si tu?)"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Nechápeš to?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "Toto je kontrolný bod"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "skúška tvojho rozumu!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "Teraz poď!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Som tu, aby som viedla beznádejne stratených!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// Quest 4 (Prečo mi pomáhaš?)"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "Čo ťa robí tak výnimočným,"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "NEZAslúžiš si pomoc?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "Čo?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Tak hlúpe..."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Práve si sa objavil z ničoho nič!"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Nemal by si tu byť,"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "tak ja ti pomáham!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Zbohom, hlupák!"}
