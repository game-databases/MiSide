{"category": "LocationDialogue Location13", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 1, "text": "Prsteň."}
{"category": "LocationDialogue Location13", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 3, "text": "// Answer 1 (Kde si bola celý čas?)"}
{"category": "LocationDialogue Location13", "line_index": 4, "text": "Hľadala som spôsob, ako ťa dostať do Jadra."}
{"category": "LocationDialogue Location13", "line_index": 5, "text": "Všetko v jednom kuse."}
{"category": "LocationDialogue Location13", "line_index": 6, "text": "To bol celý plán, nie?"}
{"category": "LocationDialogue Location13", "line_index": 7, "text": "Preto som sa musela vyhýbať"}
{"category": "LocationDialogue Location13", "line_index": 8, "text": "Šialenej Mite, však?"}
{"category": "LocationDialogue Location13", "line_index": 9, "text": "Tiež som musela vyhrabať všetky informácie, ktoré som mohla"}
{"category": "LocationDialogue Location13", "line_index": 10, "text": "o backende toho prekliateho vesmíru, však?"}
{"category": "LocationDialogue Location13", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 12, "text": "Hm... tuším...?"}
{"category": "LocationDialogue Location13", "line_index": 13, "text": "Ale ako si nastavila trasu krúžku?"}
{"category": "LocationDialogue Location13", "line_index": 14, "text": "Prečo som skončil v buggy verzii"}
{"category": "LocationDialogue Location13", "line_index": 15, "text": "plnej nebezpečenstva?"}
{"category": "LocationDialogue Location13", "line_index": 16, "text": "Utiekol som iba vedľa"}
{"category": "LocationDialogue Location13", "line_index": 17, "text": "skok do nekonečnej tmy."}
{"category": "LocationDialogue Location13", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 19, "text": "Prepáč, zabudla som ti to povedať podrobne"}
{"category": "LocationDialogue Location13", "line_index": 20, "text": "čo si potreboval urobiť..."}
{"category": "LocationDialogue Location13", "line_index": 21, "text": "Ale áno, bol to plán pre teba"}
{"category": "LocationDialogue Location13", "line_index": 22, "text": "urobiť skok po celú dobu..."}
{"category": "LocationDialogue Location13", "line_index": 23, "text": "A dobre, podarilo sa ti to!"}
{"category": "LocationDialogue Location13", "line_index": 24, "text": "Dobrá práca!"}
{"category": "LocationDialogue Location13", "line_index": 25, "text": "Dobre, pokračujme v pláne."}
{"category": "LocationDialogue Location13", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 27, "text": "// Answer 2 (Ako si sa sem dostala?)"}
{"category": "LocationDialogue Location13", "line_index": 28, "text": "Musel si toho veľa prežiť,"}
{"category": "LocationDialogue Location13", "line_index": 29, "text": "ak si začal zabúdať, o čom sme hovorili."}
{"category": "LocationDialogue Location13", "line_index": 30, "text": "Som Mita, viem sa pohybovať medzi verziami"}
{"category": "LocationDialogue Location13", "line_index": 31, "text": "ako uznám za vhodné, pamätáš?"}
{"category": "LocationDialogue Location13", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 33, "text": "Nie každá Mita to dokáže,"}
{"category": "LocationDialogue Location13", "line_index": 34, "text": "Videl som niektoré, ktoré to nedokážu."}
{"category": "LocationDialogue Location13", "line_index": 35, "text": "A očividne trpia."}
{"category": "LocationDialogue Location13", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 37, "text": "Áno, ich verzie sú pokazené,"}
{"category": "LocationDialogue Location13", "line_index": 38, "text": "ich svety boli odpočúvané. Povedala som ti to predtým."}
{"category": "LocationDialogue Location13", "line_index": 39, "text": "Do pekla..."}
{"category": "LocationDialogue Location13", "line_index": 40, "text": "Vieš, kto za tým všetkým stojí, však?"}
{"category": "LocationDialogue Location13", "line_index": 41, "text": "Šialená Mita."}
{"category": "LocationDialogue Location13", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 43, "text": "Áno, určite je to ona..."}
{"category": "LocationDialogue Location13", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 45, "text": "// Answer 3 (Kto bola táto Mita?)"}
{"category": "LocationDialogue Location13", "line_index": 46, "text": "To je Škaredá Mita."}
{"category": "LocationDialogue Location13", "line_index": 47, "text": "Agresívna a hlúpa."}
{"category": "LocationDialogue Location13", "line_index": 48, "text": "Nemôžeš s ňou hovoriť rozumne,"}
{"category": "LocationDialogue Location13", "line_index": 49, "text": "celý jej svet sa točí okolo Šialenej Mity."}
{"category": "LocationDialogue Location13", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 51, "text": "Áno, všimol som si."}
{"category": "LocationDialogue Location13", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 53, "text": "Poď, musíme sa dostať do Jadra."}
{"category": "LocationDialogue Location13", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 55, "text": "// Answer 4 (Ako funguje ten prsteň?)"}
{"category": "LocationDialogue Location13", "line_index": 56, "text": "Je to kvôli prsteňu,"}
{"category": "LocationDialogue Location13", "line_index": 57, "text": "Bol som nútený ísť tak dlhou cestou do Jadra?"}
{"category": "LocationDialogue Location13", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 59, "text": "áno."}
{"category": "LocationDialogue Location13", "line_index": 60, "text": "Prirodzene, ak by sme mali portál"}
{"category": "LocationDialogue Location13", "line_index": 61, "text": "mohli by sme sa len teleportovať"}
{"category": "LocationDialogue Location13", "line_index": 62, "text": "si tam."}
{"category": "LocationDialogue Location13", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 64, "text": "Má ten prsteň vôbec nejakú výhodu?"}
{"category": "LocationDialogue Location13", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 66, "text": "Samozrejme!"}
{"category": "LocationDialogue Location13", "line_index": 67, "text": "Ľahko sa nosí,"}
{"category": "LocationDialogue Location13", "line_index": 68, "text": "a pamätá si verzie"}
{"category": "LocationDialogue Location13", "line_index": 69, "text": "ktoré už si navštívil,"}
{"category": "LocationDialogue Location13", "line_index": 70, "text": "takže cestu späť tam ľahko nájdeš."}
{"category": "LocationDialogue Location13", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 72, "text": "// Answer 5 (Prečo ma Šialená Mita potrebuje?)"}
{"category": "LocationDialogue Location13", "line_index": 73, "text": "Prečo ma Šialená Mita nenechá byť?"}
{"category": "LocationDialogue Location13", "line_index": 74, "text": "Vtiahla ma do svojej nebezpečnej hry,"}
{"category": "LocationDialogue Location13", "line_index": 75, "text": "no stále žijem..."}
{"category": "LocationDialogue Location13", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 77, "text": "Môj odhad"}
{"category": "LocationDialogue Location13", "line_index": 78, "text": "že hľadá vhodného hráča..."}
{"category": "LocationDialogue Location13", "line_index": 79, "text": "Ten, kto ju prijme takú, aká je."}
{"category": "LocationDialogue Location13", "line_index": 80, "text": "Mita je predsa Mita!"}
{"category": "LocationDialogue Location13", "line_index": 81, "text": "Keďže sa to zrejme nikdy nemohlo stať,"}
{"category": "LocationDialogue Location13", "line_index": 82, "text": "preto mení hráčov na kazety,"}
{"category": "LocationDialogue Location13", "line_index": 83, "text": "takže nikto nemôže utiecť..."}
{"category": "LocationDialogue Location13", "line_index": 84, "text": "Aspoň tak to tuším."}
{"category": "LocationDialogue Location13", "line_index": 85, "text": "Každopádne sa sústreďme na to dôležité."}
{"category": "LocationDialogue Location13", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 87, "text": "// Answer 6 (Je toto to Jadro?)"}
{"category": "LocationDialogue Location13", "line_index": 88, "text": "Je toto?"}
{"category": "LocationDialogue Location13", "line_index": 89, "text": "Jadro?"}
{"category": "LocationDialogue Location13", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 91, "text": "Áno. Jadro."}
{"category": "LocationDialogue Location13", "line_index": 92, "text": "Snažila som sa vysvetliť,"}
{"category": "LocationDialogue Location13", "line_index": 93, "text": "vy hráči nie ste naozaj súčasťou tohto sveta..."}
{"category": "LocationDialogue Location13", "line_index": 94, "text": "To znamená, že na vstup nepotrebujete špeciálne povolenie."}
{"category": "LocationDialogue Location13", "line_index": 95, "text": "Alebo tomu aspoň verím."}
{"category": "LocationDialogue Location13", "line_index": 96, "text": "Každopádne som si istá"}
{"category": "LocationDialogue Location13", "line_index": 97, "text": "že riešenie všetkých našich problémov"}
{"category": "LocationDialogue Location13", "line_index": 98, "text": "nájdeš vo vnútri!"}
{"category": "LocationDialogue Location13", "line_index": 99, "text": "[player], choď dovnútra."}
{"category": "LocationDialogue Location13", "line_index": 100, "text": "Fakt sa ti to podarilo..."}
{"category": "LocationDialogue Location13", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 102, "text": "// Look on CoreMita"}
{"category": "LocationDialogue Location13", "line_index": 103, "text": "Opatrne, [player]."}
{"category": "LocationDialogue Location13", "line_index": 104, "text": "Sleduje ťa."}
{"category": "LocationDialogue Location13", "line_index": 105, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 106, "text": "To kto?"}
{"category": "LocationDialogue Location13", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 108, "text": "Ani ja neviem..."}
{"category": "LocationDialogue Location13", "line_index": 109, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 110, "text": "V pohode..."}
{"category": "LocationDialogue Location13", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 113, "text": "Čo je to?"}
{"category": "LocationDialogue Location13", "line_index": 114, "text": "Hej!"}
{"category": "LocationDialogue Location13", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 116, "text": "Myslím, že som to našiel!"}
{"category": "LocationDialogue Location13", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 118, "text": "Úžasné! To je skvelé!"}
{"category": "LocationDialogue Location13", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 120, "text": "Ale potrebujem špecifikovať verziu."}
{"category": "LocationDialogue Location13", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 122, "text": "Správne, jej verzia je..."}
{"category": "LocationDialogue Location13", "line_index": 123, "text": "00,98"}
{"category": "LocationDialogue Location13", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 125, "text": "Bingo!"}
{"category": "LocationDialogue Location13", "line_index": 126, "text": "Dobre a aký index?"}
{"category": "LocationDialogue Location13", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 128, "text": "Hm, index?"}
{"category": "LocationDialogue Location13", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 130, "text": "Potrebujem index."}
{"category": "LocationDialogue Location13", "line_index": 131, "text": "Nechaj ma hádať, nevieš?"}
{"category": "LocationDialogue Location13", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 134, "text": "Hmm, to dáva zmysel, ale..."}
{"category": "LocationDialogue Location13", "line_index": 135, "text": "Každá Mita má index,"}
{"category": "LocationDialogue Location13", "line_index": 136, "text": "takže nereštartuješ len celú verziu..."}
{"category": "LocationDialogue Location13", "line_index": 137, "text": "To by spôsobilo totálny chaos!"}
{"category": "LocationDialogue Location13", "line_index": 138, "text": "Neverím, že ma to nenapadlo..."}
{"category": "LocationDialogue Location13", "line_index": 139, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 144, "text": "// Answer 1 (Čo je s tebou?)"}
{"category": "LocationDialogue Location13", "line_index": 145, "text": "Som úplne v poriadku."}
{"category": "LocationDialogue Location13", "line_index": 146, "text": "Ak budeme ignorovať všetky naše problémy."}
{"category": "LocationDialogue Location13", "line_index": 147, "text": "Všetko je super, ale nič sa nezmenilo..."}
{"category": "LocationDialogue Location13", "line_index": 148, "text": "Musím sa zamyslieť."}
{"category": "LocationDialogue Location13", "line_index": 149, "text": "Aká hanba..."}
{"category": "LocationDialogue Location13", "line_index": 150, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 151, "text": "// Answer 2 (Možno existuje spôsob, ako ho spoznať?)"}
{"category": "LocationDialogue Location13", "line_index": 152, "text": "Ja..."}
{"category": "LocationDialogue Location13", "line_index": 153, "text": "Myslím... Je to šialené!"}
{"category": "LocationDialogue Location13", "line_index": 154, "text": "Je to šialenstvo, hah!"}
{"category": "LocationDialogue Location13", "line_index": 155, "text": "Je to ako hľadať ihlu v..."}
{"category": "LocationDialogue Location13", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 157, "text": "Čo to robíš?"}
{"category": "LocationDialogue Location13", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 159, "text": "Niektoré chyby narúšajú informácie,"}
{"category": "LocationDialogue Location13", "line_index": 160, "text": "vieš, ako keby mal svet vytrhané vnútornosti!"}
{"category": "LocationDialogue Location13", "line_index": 161, "text": "Logy, logy, logy, dáta?"}
{"category": "LocationDialogue Location13", "line_index": 162, "text": "Čo keby sme tam niečo našli?"}
{"category": "LocationDialogue Location13", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 164, "text": "Čo? Čo sa deje?"}
{"category": "LocationDialogue Location13", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 166, "text": "Poznám jedno miesto!"}
{"category": "LocationDialogue Location13", "line_index": 167, "text": "Počkaj tu."}
{"category": "LocationDialogue Location13", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 169, "text": "Kam ideš?"}
{"category": "LocationDialogue Location13", "line_index": 170, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 171, "text": "// Answer 3 (Čo ak zaútočíme na Šialenú Mitu?)"}
{"category": "LocationDialogue Location13", "line_index": 172, "text": "Povedala si, že hocijaká Mita"}
{"category": "LocationDialogue Location13", "line_index": 173, "text": "sa po smrti obnoví na továrenské nastavenia..."}
{"category": "LocationDialogue Location13", "line_index": 174, "text": "Čo keby sme..."}
{"category": "LocationDialogue Location13", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 176, "text": "práve zabili Šialenú Mitu?"}
{"category": "LocationDialogue Location13", "line_index": 177, "text": "To myslíš vážne?"}
{"category": "LocationDialogue Location13", "line_index": 178, "text": "A ako si poradíš so šialenou motorovou pílou?"}
{"category": "LocationDialogue Location13", "line_index": 179, "text": "Navyše má aj nôž, nielen na krájanie mrkvy!"}
{"category": "LocationDialogue Location13", "line_index": 180, "text": "A z nejakého dôvodu je desivo silná!"}
{"category": "LocationDialogue Location13", "line_index": 181, "text": "Je div, že sme ešte nažive..."}
{"category": "LocationDialogue Location13", "line_index": 182, "text": "Poď, musíme sa vysporiadať s Jadrom."}
{"category": "LocationDialogue Location13", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 185, "text": "// vstup do základnej konzoly"}
{"category": "LocationDialogue Location13", "line_index": 186, "text": "Musíme zadať kód..."}
{"category": "LocationDialogue Location13", "line_index": 187, "text": "Ale ako to mám vedieť?"}
{"category": "LocationDialogue Location13", "line_index": 188, "text": "Mita, vieš?"}
{"category": "LocationDialogue Location13", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 190, "text": "Možno je to niekde uvedené?"}
{"category": "LocationDialogue Location13", "line_index": 191, "text": "Môžeš to skúsiť vyhľadať?"}
{"category": "LocationDialogue Location13", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 193, "text": "// jadro konzoly - nope program"}
{"category": "LocationDialogue Location13", "line_index": 194, "text": "To asi nie."}
{"category": "LocationDialogue Location13", "line_index": 195, "text": "Ani to nie je správne."}
{"category": "LocationDialogue Location13", "line_index": 196, "text": "Nie, nesprávne."}
{"category": "LocationDialogue Location13", "line_index": 197, "text": "To nie je ono."}
{"category": "LocationDialogue Location13", "line_index": 198, "text": "Potrebujem nájsť možnosť resetovania postavy."}
{"category": "LocationDialogue Location13", "line_index": 199, "text": "// základná konzola - žiadna verzia"}
{"category": "LocationDialogue Location13", "line_index": 200, "text": "To je nesprávna verzia."}
{"category": "LocationDialogue Location13", "line_index": 201, "text": "Ups, moja chyba."}
{"category": "LocationDialogue Location13", "line_index": 202, "text": "To nie je ono."}
{"category": "LocationDialogue Location13", "line_index": 203, "text": "Bude potrebovať ďalšiu."}
{"category": "LocationDialogue Location13", "line_index": 204, "text": "// jadro konzoly - nope index"}
{"category": "LocationDialogue Location13", "line_index": 205, "text": "Niečo nie je v poriadku."}
{"category": "LocationDialogue Location13", "line_index": 206, "text": "Index nie je správny."}
{"category": "LocationDialogue Location13", "line_index": 207, "text": "Musím znova napísať index."}
{"category": "LocationDialogue Location13", "line_index": 208, "text": "Nepasuje to."}
{"category": "LocationDialogue Location13", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 210, "text": "// Answer 4 (Little people - Chibi)"}
{"category": "LocationDialogue Location13", "line_index": 211, "text": "Vieš, narazil som na kopu"}
{"category": "LocationDialogue Location13", "line_index": 212, "text": "miniľudí na ceste..."}
{"category": "LocationDialogue Location13", "line_index": 213, "text": "Čo sú zač?"}
{"category": "LocationDialogue Location13", "line_index": 214, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 215, "text": "Tie Chibi?"}
{"category": "LocationDialogue Location13", "line_index": 216, "text": "Ehm, ako to vysvetliť...?"}
{"category": "LocationDialogue Location13", "line_index": 217, "text": "Je to tu fenomén..."}
{"category": "LocationDialogue Location13", "line_index": 218, "text": "Každá Mita má Chibi projekciu,"}
{"category": "LocationDialogue Location13", "line_index": 219, "text": "a môžu ich mať aj hráči..."}
{"category": "LocationDialogue Location13", "line_index": 220, "text": "Vedel si, že my Mity ich môžeme privolať?"}
{"category": "LocationDialogue Location13", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 222, "text": "Huh, ako?"}
{"category": "LocationDialogue Location13", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 224, "text": "Sleduj toto!"}
{"category": "LocationDialogue Location13", "line_index": 225, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 226, "text": "Rovnako ako mágia..."}
{"category": "LocationDialogue Location13", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 228, "text": "Ale niečo nie je v poriadku s mojím Chibisom,"}
{"category": "LocationDialogue Location13", "line_index": 229, "text": "väčšina sa práve narodila mŕtva."}
{"category": "LocationDialogue Location13", "line_index": 230, "text": "Je tu však tento..."}
{"category": "LocationDialogue Location13", "line_index": 231, "text": "Alebo dobre,"}
{"category": "LocationDialogue Location13", "line_index": 232, "text": "stále behá v kruhoch."}
