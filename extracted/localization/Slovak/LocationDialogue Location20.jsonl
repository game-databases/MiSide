{"category": "LocationDialogue Location20", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Mila! Nie! Si šialená!"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Ha-ha! ČO JE TOTO?"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "Je to nový výraz, ktorý vidím?"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "Pokračuj, uvidím viac!"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "Pozerať sa na tú istú starú tvár je tak nudné!"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\""}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "Ako sa máš, môj neposedný malý tulák?"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "Stále beháš? Ešte nemáš dosť?"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Čo si urobila Mile?"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "Aha, takže ešte nie si unavený!"}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Perfektné! Poďme hrať ďalšiu hru!"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "Ty..."}
{"category": "LocationDialogue Location20", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "Začnime to malým testom!"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "Poďme otestovať tvoju koordináciu!"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "Tvoja schopnosť konať!"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "Čo ak je s tebou niečo!?"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "Čo ak si ani ten SKIN nezaslúžiš"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "si taký hrdý na to, že nosíš!?"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "Pozri sa..."}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "Ktorá ti padne do oka?"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "Tá pravá?"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "Alebo"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "ľavá?"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "Oh, vážne?"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "Záleží vôbec na tom?"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "Len som sa s tebou bavila!"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "Bodné rany sú staré správy."}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "No čo už!"}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "Mám naplánované oveľa lepšie hry,"}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "ako..."}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "Pozri si toto!"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Potrebujeme hudbu!"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "Čo si myslíš o tejto melódii?"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "Rozprúdi mi to krv!"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "Ja začnem"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "s pravidlami!"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rules"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "Zatiaľ čo melódia hrá,"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "môžeš sa hýbať."}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "Ale keď hudba prestane,"}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "NEHÝB SA!"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "Alebo si mŕtvy!"}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "Je to jednoduché: dostať sa na koniec."}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "Ak to stihneš"}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "Budeme pokračovať!"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "Stále tu stojíš, však?"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Bež, miláčik, bež!"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "Oh!"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Pozri sa na seba! Tak poslušný!"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Dokonalý malý exemplár."}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Chcem ťa pre seba!"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "To bolo až príliš jednoduché, však?"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "Pusti ma!"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "Nenechaj sa príliš pohodlne!"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "Máme veľa ďalších hier, ktoré môžeme hrať!"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "Tu je ďalšia:"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Idem zavrieť oči..."}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "A keď ich otvorím,"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "radšej sa skry!"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "rozumieš?"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "Ak ťa uvidím, potrestám ťa!"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Dobre! Začnime!"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "Toto je nezmysel..."}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "Podarilo sa ti to!"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Ide ti to skvele – začína to byť vzrušujúce!"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "Teraz to však bude ťažšie."}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "VEĽMI ťažšie."}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Skry sa, utekaj, toč sa -"}
{"category": "LocationDialogue Location20", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "Gah, sakra do pekla!"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Player falls"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "Myslím, že som ušiel..."}
