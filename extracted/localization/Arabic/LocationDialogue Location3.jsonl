{"category": "LocationDialogue Location3", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 345, "text": "// Quest 1"}
{"category": "LocationDialogue Location3", "line_index": 346, "text": "،ﻚﻟﺬﻛ ﻪﻧﺇ"}
{"category": "LocationDialogue Location3", "line_index": 347, "text": ".ﺀﺎﻘﺒﻟﺍ ﻚﻨﻜﻤﻳ"}
{"category": "LocationDialogue Location3", "line_index": 348, "text": ".ﻕﻼﻃﻹﺍ ﻰﻠﻋ ﻊﻧﺎﻣﺃ ﻻ"}
{"category": "LocationDialogue Location3", "line_index": 349, "text": "ﺎﻧﺃ ،ﻊﻗﺍﻮﻟﺍ ﻲﻓ"}
{"category": "LocationDialogue Location3", "line_index": 350, "text": "!ﺎﻣﺎﻤﺗ ﺔﻴﺿﺍﺭ"}
{"category": "LocationDialogue Location3", "line_index": 351, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 352, "text": "// Quest 2"}
