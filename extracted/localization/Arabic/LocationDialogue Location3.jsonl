{"category": "LocationDialogue Location3", "line_index": 317, "text": ".ﻚﻠﻀﻓ ﻦﻣ ﻕﺪﺤﺗ ﻻ"}
{"category": "LocationDialogue Location3", "line_index": 318, "text": ".ﺝﺮﺤﻟﺎﺑ ﺮﻌﺷﺃ ﻲﻨﻠﻌﺠﺗ ﻚﻧﺇ"}
{"category": "LocationDialogue Location3", "line_index": 319, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 320, "text": "// The statuette"}
{"category": "LocationDialogue Location3", "line_index": 321, "text": ".ﻒﻴﺨﻣ ﻝﺎﺜﻤﺗ ﺍﺬﻫ"}
{"category": "LocationDialogue Location3", "line_index": 322, "text": "ﺖﻧﺃ ﻞﻫ"}
{"category": "LocationDialogue Location3", "line_index": 323, "text": "؟ﺀﺎﻴﺷﻷﺍ ﻩﺬﻫ ﻦﻴﺒﺤﺗ"}
{"category": "LocationDialogue Location3", "line_index": 324, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 325, "text": "؟ﻒﻴﺨﻣ"}
{"category": "LocationDialogue Location3", "line_index": 326, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 327, "text": ".ﻢﻌﻧ"}
{"category": "LocationDialogue Location3", "line_index": 328, "text": "...ﺎًﺒﻳﺮﻘﺗ ﻥﻮﻌﻠﻣ ﻪﻧﺄﻛﻭ ﻭﺪﺒﻳ"}
{"category": "LocationDialogue Location3", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 330, "text": ".ﺎًﻧﻮﻌﻠﻣ ﺲﻴﻟ ﺪﻴﻛﺄﺘﻟﺎﺑ ،ﻻ"}
{"category": "LocationDialogue Location3", "line_index": 331, "text": ".ﺎًﻀﻳﺃ ﺎًﻔﻴﺨﻣ ﻻﻭ"}
{"category": "LocationDialogue Location3", "line_index": 332, "text": "!ﺎﻣ ﺪﺣ ﻰﻟﺇ ﺎًﻔﻴﻄﻟ ﻩﺪﺟﺃ"}
{"category": "LocationDialogue Location3", "line_index": 333, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 334, "text": "...ﻖﺣ ﻰﻠﻋ ﻦﻴﻧﻮﻜﺗ ﺎﻤﺑﺭ"}
