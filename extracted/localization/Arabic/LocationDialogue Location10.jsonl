{"category": "LocationDialogue Location10", "line_index": 59, "text": "// Quest 1 (Why are there other Mitas down there?)"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": ".ﻮﺘﻠﻟ ﻢﻫﺩﻮﻠﺟ ﻰﻠﻋ ﺍﻮﻠﺼﺣ ﺪﻘﻟ"}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "ﺖﻗﻮﻟﺍ ﺾﻌﺑ ﻥﻮﺟﺎﺘﺤﻳ"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": ".ﻲﺗﺍﺬﻟﺍ ﻲﻋﻮﻟﺍ ﺍﻮﺒﺴﺘﻜﻴﻟ"}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "ﺓﺪﺣﺍﻭ ﻞﻛ ﺪﺷﺭﺄﺳ ﻢﺛ"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": ".ﺹﺎﺨﻟﺍ ﺎﻬﻟﺰﻨﻣ ﻰﻟﺇ"}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// Quest 2 (Why is it so dark downstairs?)"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "،ﻡﻼﻈﻟﺍ ﻲﻓ \"ﻥﻭﺩﻮﻟﻮﻣ\" ﺕﺎﺘﻴﻤﻟﺍ ﻦﺤﻧ"}
{"category": "LocationDialogue Location10", "line_index": 68, "text": ".ﺖﻗﻮﻟﺍ ﻦﻣ ﺓﺮﺘﻔﻟ ﻙﺎﻨﻫ ﺀﺎﻘﺒﻟﺍ ﺎﻨﻴﻠﻋ ﻚﻟﺬﻟ"}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "ﻞﻴﺨﺗ"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "...ﺓﺮﺷﺎﺒﻣ ﺭﻮﻨﻟﺍ ﻰﻟﺇ ﺔﻤﻠﻠﻈﻟﺍ ﻦﻣ ﻝﺎﻘﺘﻧﻻﺍ ﺪﻨﻋ ﻪﺑ ﺮﻌﺸﻧ ﻱﺬﻟﺍ ﻢﻟﻷﺍ"}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// Quest 3 (What are you doing here?)"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "؟ﻢﻬﻔﺗ ﻻ ﺖﻟﺯ ﻻ"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "!ﻢﻠﻗﺄﺘﻟﺍ ﻰﻠﻋ ﺩﺪﺠﻟﺍ ﺱﺎﺘﻴﻣ ﺪﻋﺎﺳﺃ ﺎﻧﺃ"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "؟ﻞﻌﻓﺃ ﻢﻟ ﺍﺫﺇ ﻢﻫﺪﻋﺎﺴﻴﺳ ﻦﻣ"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "؟ﺖﻧﺃ"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// Quest 4 (Why do we need this conveyor?)"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "؟ﺓﺮﺜﻜﺑ ﺕﺎﺘﻴﻤﻟﺍ ﻊﻨﺼﺗ ﺍﺫﺎﻤﻟ"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "؟ﻦﻬﻌﻴﻤﺠﻟ ﺔﻴﻓﺎﻛ ﺔﺣﺎﺴﻣ ﻙﺎﻨﻫﺃ"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "ﻢﻬﻔﺗ ﻻ ﻚﻧﺃ ﻲﻟ ﻞﻘﺗ ﻻ ،ﺔﻈﺤﻟ"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "...ﻢﻟﺎﻌﻟﺍ ﺍﺬﻫ ﻞﻤﻌﻳ ﻒﻴﻛ"}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "؟ﻲﺋﺎﻬﻧ ﻻ ﻪﻧﺃﻭ"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "؟ﻲﺋﺎﻬﻧ ﻻ"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "...ﻢﻤﻣﺃ"}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "؟ﻦﻳﺪﺼﻘﺗ ﺍﺫﺎﻣ"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "،ﺙﺪﺣﻷﺍ ﺭﺍﺪﺻﻹﺍ ﻮﻫ 9.1 ﺭﺍﺪﺻﻹﺍ ﻥﺎﻛ ﺍﺫﺇ"}
