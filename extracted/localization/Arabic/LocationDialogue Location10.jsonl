{"category": "LocationDialogue Location10", "line_index": 111, "text": "!ﻩﺎﻫ"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "؟...ﻒﻴﻛ ﻦﻜﻟﻭ"}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "...ﻝﺰﻨﻤﻟﺍ ﻚﻟﺫ ﻢﻗﺭ ﻦﻋ ﻞﺋﺎﺴﺗﺃ"}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "،ﺮﻣﺬﺘﻟﺍ ﻦﻋ ﻒﻗﻮﺘﻟﺍ ﻊﻴﻄﺘﺴﺗ ﻻ \"ﺎﻧﺃ\" ﻙﺎﻨﻫ"}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "،ﻊﻜﺴﺘﻟﺍ ﺐﺤﺗ \"ﺎﻧﺃ\" ﻭ"}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "...ﻦﻳﺮﺧﻵﺍ ﺐﻠﻘﻤﺗ ﻥﺍ ﺐﺤﺗ ,ﺓﺮﻛﺍﺬﻟﺍ ﺔﻔﻴﻌﺿ \"ﺎﻧﺃ\" ﻭ"}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "...ﺔﻠﻳﻮﻃ ﺔﻤﺋﺎﻗ ﺎﻬﻧﺇ"}
{"category": "LocationDialogue Location10", "line_index": 118, "text": ".ﻩﺮﻛﺬﺘﺗ ﺎﻤﺑ ﻲﻧﺮﺒﺧﺃ"}
{"category": "LocationDialogue Location10", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 120, "text": ".ﺎًﻤﻠﻈﻣ ﻮﺠﻟﺍ ﻥﺎﻛ"}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "ﺔﺑﺎﺘﻛ ﻙﺎﻨﻫ ﻥﺎﻛﻭ"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "...ﻞﺜﻣ"}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "\".ﻲﻌﻣ ﺐﻌﻟﺍ\""}
{"category": "LocationDialogue Location10", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "،ﻩﺁ"}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "...ﺝﺎﻋﺯﺃ ﻦﻣ ﻪﻟ ﺎﻳ"}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "....\"ﺎﻧﺃ\" ﻲﻫ ﻚﻠﺗ"}
{"category": "LocationDialogue Location10", "line_index": 128, "text": ".ﺐﻟﺎﻘﻤﻟﺍ ﺔﺒﺤﻣ ﻭ ﺓﺮﻛﺍﺬﻟﺍ ﺔﻔﻴﻌﺿ"}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// Mita wants to tell you [No]"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "!ﺍًﺮﻜﺷ !ﻻ ﻦﻜﻟﻭ !ﺍًﺮﻜﺷ"}
