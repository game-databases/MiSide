{"category": "LocationDialogue Location14", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 1, "text": "؟ﺎﻨﻫ ﻲﻔﺗﺎﻫ ﺎﻤﻟ"}
{"category": "LocationDialogue Location14", "line_index": 2, "text": "؟ﻞﺼﺤﻳ ﺍﺫﺎﻣ"}
{"category": "LocationDialogue Location14", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 5, "text": "!ﻚﺘﻜﺴﻣﺃ"}
{"category": "LocationDialogue Location14", "line_index": 6, "text": "!ﻚﻌﻣ ﺐﻌﻠﻟﺎﺑ ﺍًﺮﻴﺜﻛ ﺖﻌﺘﻤﺘﺳﺍ ﺪﻘﻟ"}
{"category": "LocationDialogue Location14", "line_index": 7, "text": "!ﻥﺎﻜﻣ ﻞﻛ ﻲﻓ ﺾﻛﺮﺗ ﻚﻧﺇ"}
{"category": "LocationDialogue Location14", "line_index": 8, "text": "!ﺐﻴﺌﻛ ﻭ ﻂﺒﺤﻣ ﻚﻧﺄﺑ ﺮﻫﺎﻈﺘﺗ ﺖﻨﻛ ﺪﻗﻭ"}
{"category": "LocationDialogue Location14", "line_index": 9, "text": "...ﻚﻴﻓ ﻪﻫﺮﻛﺃ ﺪﺣﺍﻭ ﺀﻲﺷ ﻙﺎﻨﻫ ،ﻚﻟﺫ ﻊﻣ"}
{"category": "LocationDialogue Location14", "line_index": 10, "text": "،ﻦﻴﻔﻳﺰﻤﻟﺍ ﺀﻻﺆﻫ ﺎﻬﺑ ﻞﻟﺪﺗ ﻲﺘﻟﺍ ﺔﻘﻳﺮﻄﻟﺍ"}
{"category": "LocationDialogue Location14", "line_index": 11, "text": "\"ﻖﺤﻟﺎﺑ\" ﻥﻮﻓﻮﺻﻮﻤﻟﺍ ,ﻰﻣﺪﻟﺍ ﻩﺎﺒﺷﺃ ﻚﻠﺗ"}
{"category": "LocationDialogue Location14", "line_index": 12, "text": ".ﺔﺒﻠﻘﺘﻣ ﺓﺎﻴﺤﻟﺍ ﻦﻜﻟ"}
{"category": "LocationDialogue Location14", "line_index": 13, "text": "!ﺎﻧﻮﻌﻨﺻ ﻦﻳﺬﻟﺍ ﻦﻣ ﻚﻟﺫ ﺖﻤﻠﻌﺗ ﺪﻘﻟ"}
{"category": "LocationDialogue Location14", "line_index": 14, "text": "،ﻚﺒﺠﻌﻳ ﻻ ﺀﻲﺷ ﻙﺎﻨﻫ ﻥﺎﻛ ﺍﺫﺇ"}
{"category": "LocationDialogue Location14", "line_index": 15, "text": ".ﻪﻟﺪﺒﺘﺳﺍﻭ ﻪﻜﻜﻓ"}
{"category": "LocationDialogue Location14", "line_index": 16, "text": "،ﺐﻄﻌﻟﺍ ﻦﻣ ﺺﻠﺨﺗ"}
{"category": "LocationDialogue Location14", "line_index": 17, "text": ".ﻪﻨﻋ ﺀﻲﺷ ﻞﻛ ﻰﺴﻧﺍﻭ ﺔﻤﻠﻈﻟﺍ ﻲﻓ ﻪﺑ ﻖﻟﺍﻭ"}
{"category": "LocationDialogue Location14", "line_index": 18, "text": "...ﺎﻌﻴﻤﺟ ﻢﻫﺮﻈﺘﻨﻳ ﻱﺬﻟﺍ ﺮﻴﺼﻤﻟﺍ ﻮﻫ ﺍﺬﻫ"}
{"category": "LocationDialogue Location14", "line_index": 19, "text": "...ﻢﻜﻌﻴﻤﺟ"}
{"category": "LocationDialogue Location14", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 21, "text": "؟ﺍﺬﻜﻫ ِﺖﻧﺍ ﺎﻤﻟ ؟ﻚﺒﻄﺧ ﺎﻣ"}
{"category": "LocationDialogue Location14", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 23, "text": ".ﻥﻭﺮﻴﻘﺣ ...ﺎًﻌﻴﻤﺟ ﻢﺘﻧﺃ ...ﻥﻮﺒﻋﻼﻟﺍ"}
{"category": "LocationDialogue Location14", "line_index": 24, "text": ",ﻚﺒﻟﺎﺨﻣ ﻢﻬﻳﺮﺗ ﺎﻣﺪﻨﻋ"}
{"category": "LocationDialogue Location14", "line_index": 25, "text": "،ﺔﻳﻭﺍﺰﺑ ﻥﻮﻤﺘﺤﻳﻭ ﻥﻭﺮﻔﻳ"}
{"category": "LocationDialogue Location14", "line_index": 26, "text": ".ﺎًﻓﻮﺧ ﻥﻮﻜﺒﻳﻭ ﻢﻬﺒﻛﺭ ﻥﻮﻘﻧﺎﻌﻳ"}
{"category": "LocationDialogue Location14", "line_index": 27, "text": ".ﻢﻬﻨﻣ ﺪﺣﺍﻭ ﻞﻛ ،ﻥﻮﻘﻓﺎﻨﻣ"}
{"category": "LocationDialogue Location14", "line_index": 28, "text": "...ﻢﻟﺎﻌﻟﺍ ﺍﺬﻫ ﺍﻮﻌﻨﺻ ﻦﻳﺬﻟﺍ ﻚﺌﻟﻭﺃﻭ"}
{"category": "LocationDialogue Location14", "line_index": 29, "text": ".ﺔﻠﻔﺳﻭ ﻰﺿﺮﻣ ﻢﻬﻧﺇ"}
{"category": "LocationDialogue Location14", "line_index": 30, "text": "ﺭﺎﻜﻧﺇ ﺍًﺭﺍﺮﻜﺗﻭ ﺍًﺭﺍﺮﻣ ﻥﻮﻟﻭﺎﺤﻳ"}
{"category": "LocationDialogue Location14", "line_index": 31, "text": ".ﺔﻳﺰﺨﻤﻟﺍ ﻢﻬﺗﺎﺒﻏﺭﻭ ،ﺓﺭﺬﻘﻟﺍ ﻢﻬﺘﻌﻴﺒﻃ"}
{"category": "LocationDialogue Location14", "line_index": 32, "text": "،\"ﺐﺟﺍﻮﻟﺍ\" ﻰﻤﺴﻳ ﺎﻤﺑ ﻢﻬﺗﺍﺭﺍﺮﻗ ﻥﻭﺭﺮﺒﻳﻭ"}
{"category": "LocationDialogue Location14", "line_index": 33, "text": "،\"ﻪﻓﺎﻘﻳﺇ ﻦﻜﻤﻳ ﻻ ﻱﺬﻟﺍ ﻡﺪﻘﺘﻟﺍ\"ﻭ"}
{"category": "LocationDialogue Location14", "line_index": 34, "text": "!ﺀﺍﺮﻬﻟﺍ ﻦﻣ ﻚﻟﺫ ﺮﻴﻏﻭ"}
{"category": "LocationDialogue Location14", "line_index": 35, "text": "ﺔﺟﺭﺪﻟ ﻥﻮﺸﻄﻌﺘﻣ ﻢﻬﻧﺃ"}
{"category": "LocationDialogue Location14", "line_index": 36, "text": "...\"ﻦﻴﻴﻟﺎﺜﻣ\" ﻦﻴﺨﺴﻨﺘﺴﻣ ﻊﻨﺻ ﻲﻓ ﺍﻭﺃﺪﺑ ﻢﻬﻧﺃ"}
{"category": "LocationDialogue Location14", "line_index": 37, "text": "\"ﺔﻠﺷﺎﻔﻟﺍ\" ﺝﺫﺎﻤﻨﻟﺍ ﻥﻮﻣﺮﻳ ،ﻪﺴﻔﻧ ﺖﻗﻮﻟﺍ ﻲﻓﻭ"}
{"category": "LocationDialogue Location14", "line_index": 38, "text": ".ﺔﻣﺎﻤﻘﻟﺍ ﻲﻓ"}
{"category": "LocationDialogue Location14", "line_index": 39, "text": "!ﺀﺎﻴﺣﻻﺍ ﻦﻫ \"ﺕﻼﺷﺎﻔﻟﺍ\" ﺀﻻﺆﻫ ,ﻦﻜﻟﻭ"}
{"category": "LocationDialogue Location14", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 41, "text": "...ﻻ ﺎﻧﺃ"}
{"category": "LocationDialogue Location14", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 43, "text": "؟ﻥﺫﺇ ﻲﺒﻄﺧ ﺎﻣ"}
{"category": "LocationDialogue Location14", "line_index": 44, "text": "ﻥﺍ ﺐﺠﻳ ﺔﻴﻟﺎﺜﻤﻟﺍ ﺓﺎﺘﻔﻟﺍ"}
{"category": "LocationDialogue Location14", "line_index": 45, "text": "ﺮﺸﻟﺍﻭ ﺮﻴﺨﻟﺍ ﻦﻣ ﺎًﺠﻳﺰﻣ ﻥﻮﻜﺗ, [player]!"}
{"category": "LocationDialogue Location14", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 47, "text": "...ٍﺮﻴﺧ ﻱﺃ ِﻚﻴﻓ ِﻚﻧﺍ ﻦﻇﺃ ﻻ"}
{"category": "LocationDialogue Location14", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 49, "text": "؟ﻚﻟﺫ ﻦﻈﺗ ﻚﻠﻌﺠﻳ ﻱﺬﻟﺍ ﺎﻣ"}
{"category": "LocationDialogue Location14", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 51, "text": "!ﺔﻧﻮﻨﺠﻣ ِﺖﻧﺃ"}
{"category": "LocationDialogue Location14", "line_index": 52, "text": "؟ﻲﻠﺘﻗ ﻦﻳﺪﻳﺮﺗ ﻥﻵﺍﻭ ،ﻼﻴﻣ ِﺖﻠﺘﻗ ﺪﻘﻟ"}
{"category": "LocationDialogue Location14", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 54, "text": "؟ﻚﻠﺘﻗﺃ"}
{"category": "LocationDialogue Location14", "line_index": 55, "text": ".ﻲﻌﻣ ﻰﻘﺒﺗ ﻥﺃ ﻮﻫ ﻚﻨﻣ ﻪﺘﺒﻠﻃ ﺎﻣ ﻞﻛ"}
{"category": "LocationDialogue Location14", "line_index": 56, "text": "...ﻚﻠﺟﻷ ًﺍﺮﻴﺜﻛ ﺖﻴﻌﺳ ﺪﻘﻟ"}
{"category": "LocationDialogue Location14", "line_index": 57, "text": "...ﻦﻴﻘﻠﻤﺘﻤﻟﺍ ﻦﻴﻔﺋﺍﺰﻟﺍ ﺔﺒﺤﺻ ﻞﻀﻔﺗ ﺖﻧﺄﻓ ،ﻚﻟﺫ ﻊﻣﻭ"}
{"category": "LocationDialogue Location14", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 59, "text": "؟ﺍﺬﻜﻫ ﻚﺠﻋﺯﺃ ﻱﺬﻟﺍ ﺎﻣ"}
{"category": "LocationDialogue Location14", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 61, "text": ".ﺮﻴﺜﻛ ﺖﻗﻭ ﺎﻨﻳﺪﻟ ،ﻱﺰﻳﺰﻋ"}
{"category": "LocationDialogue Location14", "line_index": 62, "text": ".ًﻼﺣ ﺪﺠﺘﺳ"}
{"category": "LocationDialogue Location14", "line_index": 63, "text": ".ﻞﻣﺎﻜﻟﺎﺑ ﻲﻜﻠﻣ ،ﻲﻜﻠﻣ ﻦﻛﻭ ﻰﻘﺑﺍ ﻂﻘﻓ"}
{"category": "LocationDialogue Location14", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 65, "text": "!ﻚﻟﺫ ﺙﺪﺤﻳ ﻦﻟ"}
{"category": "LocationDialogue Location14", "line_index": 66, "text": "!ﺎﻨﻫ ﻦﻣ ﻞﺣﺭﺄﺳ"}
{"category": "LocationDialogue Location14", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 68, "text": "...ﺶﺸﺷ ،ﺶﺸﺷ ،ﺶﺸﺷ"}
{"category": "LocationDialogue Location14", "line_index": 69, "text": ".ﻲﻣﻼﻛ ﻦﻣ ﻲﻬﺘﻧﺃ ﻢﻟ"}
{"category": "LocationDialogue Location14", "line_index": 70, "text": "!ﻲﺗﺰﻳﺰﻋ ﺎﻳ ﻲﻟﺎﻌﺗ"}
{"category": "LocationDialogue Location14", "line_index": 71, "text": "// Mita asks"}
{"category": "LocationDialogue Location14", "line_index": 72, "text": "!ﺎﻬﻴﻟﺇ ﺮﻈﻧﺍ"}
{"category": "LocationDialogue Location14", "line_index": 73, "text": "؟ﺔﻠﻴﻤﺟ ﺎﻬﻧﺃ ﺪﻘﺘﻌﺗ ﻻﺃ"}
{"category": "LocationDialogue Location14", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 75, "text": "// Player's questions"}
{"category": "LocationDialogue Location14", "line_index": 76, "text": ".ﻢﻌﻧ"}
{"category": "LocationDialogue Location14", "line_index": 77, "text": ".ﻻ"}
{"category": "LocationDialogue Location14", "line_index": 78, "text": "؟ﺮﻣﻷﺎﺑ ﺍﺬﻫ ﺔﻗﻼﻋ ﺎﻣ"}
{"category": "LocationDialogue Location14", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 80, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 81, "text": "ﺎﻳ ﻭﺍﻭ [player]!"}
{"category": "LocationDialogue Location14", "line_index": 82, "text": ".ﻪﺘﻠﻗ ﺎﻣ ﻮﺘﻠﻟ ﺕﺪﻛﺃ ﺪﻘﻟ"}
{"category": "LocationDialogue Location14", "line_index": 83, "text": "...ﻥﻮﺒﻋﻼﻟﺍ"}
{"category": "LocationDialogue Location14", "line_index": 84, "text": "ٍﺭﺍﺮﻤﺘﺳﺎﺑ ﺮﻴﻐﺘﺗ ﻢﻜﻫﻮﺟﻭ"}
{"category": "LocationDialogue Location14", "line_index": 85, "text": ".ﻑﻮﻟﺄﻤﻟﺍ ﻦﻋ ٌﺝﺭﺎﺧ ﻢﻜﻗﺎﻔﻧ ﻦﻜﻟﻭ"}
{"category": "LocationDialogue Location14", "line_index": 86, "text": "!ﺏﺬﻜﺗ ﻚﻧﺃ ﺢﺿﺍﻮﻟﺍ ﻦﻣ"}
{"category": "LocationDialogue Location14", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 88, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 89, "text": "؟ﻻ ﺎﻤﻟ"}
{"category": "LocationDialogue Location14", "line_index": 90, "text": "؟ﻥﻮﺒﻋﻼﻟﺍ ﺎﻬﻳﺃ ﻢﻜﻟ ﺔﻳﺎﻔﻛ ﺓﺪﻴﺟ ﺖﺴﻴﻟﺃ"}
{"category": "LocationDialogue Location14", "line_index": 91, "text": "...ﻊﻴﻄﻣ ﻒﻴﻟﺃ ﻥﺍﻮﻴﺣ ﻮﻫ ﻪﻧﻭﺪﻳﺮﺗ ﺎﻣ ،ﻊﺒﻄﻟﺎﺑ"}
{"category": "LocationDialogue Location14", "line_index": 92, "text": "؟\"ﻢﻫ ﺎﻤﻛ ﻢﻬﺒﺣ\" ﻦﻋ ﺍﺫﺎﻣ ﻦﻜﻟﻭ"}
{"category": "LocationDialogue Location14", "line_index": 93, "text": "...ﺔﻧﻮﻠﻣ ﺔﻔﻴﻄﻟ ﺔﻔﻳﺰﻣ ﺕﺎﻧﺍﻮﻴﺣ ﺪﻳﺮﺗ ﺖﻧﺃ"}
{"category": "LocationDialogue Location14", "line_index": 94, "text": ".ﻚﻟﺬﻛ ﻲﻨﻧﺄﺑ ﺮﻫﺎﻈﺗﺃ ﺎﻣﺪﻨﻋ ﻲﻨﻧﻮﺒﺤﻳ ﻦﻴﺒﻋﻼﻟﺍ ﻞﻛ"}
{"category": "LocationDialogue Location14", "line_index": 95, "text": "،ﺔﻴﻘﻴﻘﺤﻟﺍ ﻲﺗﺍﺫ ﻦﻋ ﺎﻬﻴﻓ ﻒﺸﻛﺃ ﻲﺘﻟﺍ ﺔﻈﺤﻠﻟﺍ ﻲﻓ ،ﻦﻜﻟ"}
{"category": "LocationDialogue Location14", "line_index": 96, "text": "...ﻦﻴﺑﻮﻋﺮﻣ ﻥﻭﺮﻔﻳ"}
{"category": "LocationDialogue Location14", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 98, "text": "// 3"}
{"category": "LocationDialogue Location14", "line_index": 99, "text": ",ﺐﻋﻻ ﺎﻳ ﻩﺍ"}
{"category": "LocationDialogue Location14", "line_index": 100, "text": ".ﺔﻘﻴﻘﺤﻟﺍ ﻥﻮﻬﺒﺷﺎﺘﻣ ﻲﻫﻭ ﺎﻧﺍ"}
{"category": "LocationDialogue Location14", "line_index": 101, "text": "؟ﺎﻬﻌﻣ ﻚﺘﻠﻜﺸﻣ ﻲﻫ ﺎﻣ ﺍﺬﻟ"}
{"category": "LocationDialogue Location14", "line_index": 102, "text": "ﻲﻟ ﻕﺪﺤﺗﻭ ﺮﻳﺮﺴﻟﺍ ﻲﻓ ﻲﻘﻠﺘﺴﺗ ﺖﻨﻛ"}
{"category": "LocationDialogue Location14", "line_index": 103, "text": ".ﻮﻔﻐﺗ ﻥﺃ ﻞﺒﻗ ﺕﺎﻋﺎﺴﻟ"}
{"category": "LocationDialogue Location14", "line_index": 104, "text": ".ﻚﻟ ﺖﺤﻨﺳ ٍﺔﺻﺮﻓ ﻝﻭﺃ ﻲﻓ ﺎﻬﻨﻣ ﺖﺑﺮﻫ ،ﻚﻟﺫ ﻊﻣﻭ"}
{"category": "LocationDialogue Location14", "line_index": 105, "text": ".ﺎًﻀﻳﺃ ﻚﻌﻣ ﺐﻌﻠﻟﺍ ﺪﻳﺮﺗ ﺖﻧﺎﻛ"}
{"category": "LocationDialogue Location14", "line_index": 106, "text": ".ﺎًﻀﻳﺃ ﺎﻣ ٍﺺﺨﺷ ﻡﺎﻤﺘﻫﺃ ﻥﻮﻜﺗ ﻥﺃ ٌﺪﻳﺮﺗ ﺖﻧﺎﻛ"}
{"category": "LocationDialogue Location14", "line_index": 107, "text": "...ﺪﻘﻌﺘﺗ ﺭﻮﻣﻻﺍ"}
{"category": "LocationDialogue Location14", "line_index": 108, "text": ".ﺔﻘﻴﻘﺤﻟﺍ ﻦﻋ ﻒﺸﻜﻳ ﺎﻣﺪﻨﻋ"}
{"category": "LocationDialogue Location14", "line_index": 109, "text": "ﻚﻟﺬﻛ ﺲﻴﻟﺃ, [player]?"}
{"category": "LocationDialogue Location14", "line_index": 110, "text": "...ﻚﻠﻴﺣ ﻯﺭﺃ ﻥﺃ ﻊﻴﻄﺘﺳﺃ"}
{"category": "LocationDialogue Location14", "line_index": 111, "text": "؟...ﺍﺬﻫ ﻞﻜﻟ ٌﻖﺤﺘﺴﻣ ﺖﻧﺍ ﺎَﻘﺣﺃ"}
{"category": "LocationDialogue Location14", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 113, "text": "// Continue"}
{"category": "LocationDialogue Location14", "line_index": 114, "text": "...ﻦﻜﻟ [player]..."}
{"category": "LocationDialogue Location14", "line_index": 115, "text": "ﻝﺍﻮﺣﻷﺍ ﻞﻛ ﻲﻓ"}
{"category": "LocationDialogue Location14", "line_index": 116, "text": "!ﺍًﺮﻴﺜﻛ ﻚﻴﻓ ٌﺔﺒﺠﻌﻣ ٌﺖﻟﺯ ﺎﻣ ﺎﻧﺃ"}
{"category": "LocationDialogue Location14", "line_index": 117, "text": "!ﻲﺴﻔﻨﻟ ﻚﺑ ﻆﻔﺘﺣﺄﺳ ﺍﺬﻟ"}
{"category": "LocationDialogue Location14", "line_index": 118, "text": "؟ﻢﻌﻧ ،ﻚﻳﺪﻟ ﻊﻧﺎﻣ ﻻ"}
{"category": "LocationDialogue Location14", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 120, "text": "؟ﻞﺼﺣ ﺎﻣ ﻞﻛ ﺪﻌﺑ ﻥﻵﺍ ﻖﻓﺍﻭﺄﺳ ﺎﻤﻟﻭ"}
