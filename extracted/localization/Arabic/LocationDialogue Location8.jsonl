{"category": "LocationDialogue Location8", "line_index": 0, "text": "// The first meeting"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "؟ﺖﻧﺃ ﻦﻣ"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "؟ﺮﻣﻷﺍ ﺎﻣ"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "؟ﺙﺪﺤﺘﻟﺍ ﻚﻨﻜﻤﻳ ﻻﺃ"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "...ﺮﻈﺘﻧﺍ"}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "؟ﺢﻴﺤﺻ ،ﺓﺭﺩﺎﻐﻤﻟﺍ ﺪﻳﺮﺗ"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "...ﻢﻌﻧ"}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "ﺓﺩﻮﻌﻠﻟ ﺝﺎﺘﺣﺃ"}
{"category": "LocationDialogue Location8", "line_index": 11, "text": ".ﻖﺑﺎﺴﻟﺍ ﺭﺍﺪﺻﻹﺍ ﻰﻟﺇ"}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "؟ﻖﺑﺎﺴﻟﺍ ﺭﺍﺪﺻﻹﺍ"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "ﺐﻫﺬﺗﻭ ﺭﺩﺎﻐﺗ ﺍﺫﺎﻤﻟ"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "؟ﺮﺧﺁ ﻥﺎﻜﻤﻟ"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "ﺎﻨﻫ ﻰﻘﺒﺗ ﻻ ﺎﻤﻟ"}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "ﻲﻟ ﻥﻮﻜﺗﻭ"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "؟ًﺎﻴﻧﺎﺛ ًﺎﻘﻳﺪﺻ"}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Skipping all dialogs"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "... ﺎًﻨﺴﺣ"}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Standing by the window (Random)"}
{"category": "LocationDialogue Location8", "line_index": 24, "text": ".ﺏﺍﻮﺑﻷﺍ ﻝﻼﺧ ﻦﻣ ﻖﻳﺮﻃ ﺪﺠﺗ ﻦﻟ"}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "...ﺔﻠﺠﻋ ﻲﻓ ﻚﻧﺃ ﻭﺪﺒﻳ"}
{"category": "LocationDialogue Location8", "line_index": 26, "text": ".ﻙﺬﻘﻨﻳ ﻦﻟ ﺮﺋﺍﻭﺩ ﻲﻓ ﺾﻛﺮﻟﺍ"}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "؟ﺏﻭﺮﻬﻠﻟ ﺖﻧﺃ ﻒﻬﻠﺘﻣ"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "...ﺬﻓﺍﻮﻨﻟﺍ ﺝﺭﺎﺧ ﺮﻈﻧﺍ"}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Aren't you Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "؟ﻢﻌﻧ ،ﺐﻋﻻ ﺖﻧﺃ ...ﺐﻋﻻ"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": ".ﺎًﻌﻣ ﺐﻌﻠﻟﺍ ﺎﻨﻨﻜﻤﻳ"}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "،ﺾﻬﻧﻻ ﻲﻔﻜﻳ ﺎﻤﺑ ﺔﻳﻮﻗ ِﺖﻨﻛ ﻥﺇ"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": ".ﺐﻌﻠﻨﺳ ,ٍﺬﺋﺪﻨﻋ"}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (What happened to you?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "...ﻢﻠﻋﺃ ﺖﺴﻟ ﻭﺍ ،ﺓﺪﻛﺄﺘﻣ ﺖﺴﻟ"}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "...ﺀﻲﺳ ﺀﻲﺷ ﺙﺪﺤﻳ ﻢﻟ ﻪﻧﺃ ﺪﻘﺘﻋﺃ"}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "...ﻚﻟﺬﻛ ﺍﺮﺧﺆﻣ ﺪﻴﺟ ﺀﻲﺷ ﺙﺪﺤﻳ ﻢﻟ ﻦﻜﻟ"}
{"category": "LocationDialogue Location8", "line_index": 41, "text": ".ﻖﻳﺪﺻ ﻱﺪﻨﻋ ﻥﺎﻛ ,ﻞﻗﻷﺍ ﻰﻠﻋ"}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "؟ﻦﻴﺒﻋﻼﻟﺍ ﻲﻨﻛﺮﺗ ﺎﻤﻟ"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "؟ﺔﻴﻓﺎﻛ ﺖﺴﻟﺃ"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "...ﺔﻔﺋﺎﺧ ﺎﻧﺃ"}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Quest 3 (Become a second friend?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "...ﻲﺋﺎﻗﺪﺻﺃ"}
{"category": "LocationDialogue Location8", "line_index": 48, "text": ".ﻥﻵﺍ ﺍًﺪﺟ ﻞﻴﻠﻗ ﻲﻘﺑ"}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "...ﻂﻘﻓ ﺪﺣﺍﻭ ﻰﻘﺒﺗ"}
{"category": "LocationDialogue Location8", "line_index": 50, "text": ".ﺐﻋﻼﻟﺍ ﺎﻳ ،ﺔﻨﻳﺰﺣ ﺎﻧﺃ"}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "؟ﻲﻨﻗﺩﺎﺼﺘﺳ ﻞﻫ"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "،ﻚﻟﺫ ﺩﻭﺃ"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "...ﺮﻤﺘﺳﺃ ﻥﺃ ّﻲﻠﻋ ﻦﻜﻟ"}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "...ﻢﻟﺄﺘﻳ ﻲﺒﻠﻗ"}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Is this your house?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "؟ﻝﺰﻨﻤﻟﺍ"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "...ﻒﻠﺘﺨﻣ ﻭﺪﺒﺗ ...ﺐﻋﻻ"}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "...ًﺎﻴﺒﺼﻋ ﻭﺪﺒﺗ ﻻﻭ ،ﺮﺼﻗﺃ ﻚﻴﻋﺍﺭﺫ"}
{"category": "LocationDialogue Location8", "line_index": 62, "text": ".ﺎًﻔﻄﻟﻭ ﺔﻧﻮﻴﻟ ﺮﺜﻛﺃ ﺖﺤﺒﺻﺃ ﺪﻘﻟ ،ﺐﻋﻼﻟﺍ ﺎﻬﻳﺃ"}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "...ﺍًﺪﻛﺄﺘﻣ ﺖﺴﻟ"}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "...ﻦﻳﺪﺼﻘﺗ ﺎﻤﺑ"}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "...ﺱﺄﺑ ﻻ"}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "؟ﻚﻟﺫ ﺢﻴﺤﺻ ،ﻥﻵﺍ ﺪﻌﺑ ﺪﺣﺃ ﻲﻨﻳﺫﺆﻳ ﻦﻟ"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (How do I leave this place?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "؟ﺎًﻘﺣ ﻲﻨﻛﺮﺘﺘﺳ"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "...ﻮﻫ ﺍﺬﻫ ﺎﻤﺑﺭ"}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "؟ﻱﺭﺪﻗ"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "...ﺎﻧﺃ"}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": ".ﻚﻌﻔﻨﺗ ﻦﻟ ﺏﺍﻮﺑﻷﺍ"}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Hold player (Random)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "؟ﻞﺣﺮﺗ ﺎﻤﻟ"}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "...ﺎﻨﻫ ﻖﺑﺍ"}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "...ﻲﻌﻣ ﺐﻌﻟﺍ"}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "...ﺐﻋﻼﻟﺍ ﺎﻳ"}
