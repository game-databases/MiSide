{"category": "LocationDialogue Location11", "line_index": 160, "text": ".ﻊﻓﺪﻤﻟﺍ ﻚﺴﻣﺍﻭ ﺭﺰﻟﺍ ﻂﻐﺿﺍ"}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "؟ﻊﻓﺪﻤﻟﺍ"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": ".ﻰﻠﺑ"}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "؟ﺐﺴﺤﻓ ﺮﺒﻌﺘﺳ ﻚﻧﺍ ﺖﻨﻨﻇﺃ"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "!ﺵﻮﺣﻮﻟﺍ ﻊﻔﺻ ﺔﺒﻌﻟ ﺯﺎﻴﺘﺟﺍ ﻚﻴﻠﻋ"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": ".ﻕﻼﻃﻸﻟ ﺪﻌﺘﺳﺍ ﺍﺬﻟ"}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": ".ﻥﺫﺃ ﻙﺮﺤﺘﻨﻟ ,ٌﺪﻴﺟ"}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "!ٌﻊﺋﺍﺭ"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": ".ﺎﻬﺘﻠﻌﻓ ﺪﻘﻟ "}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": ".ﺎﻨﻫ ﻦﻣ ﺝﺮﺧﺍ ،ﺎًﻴﻫ"}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "!ﻉﺮﺳﺃ"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "؟ﺎﻨﻫ ﺖﻟﺯ ﺎﻣ ﺍﺫﺎﻤﻟ"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "!ﺎﻨﻫ ﻦﻣ ﺝﻭﺮﺨﻟﺎﺑ ﻚﺗﺮﻣﺃ ﺪﻘﻟ"}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "...ﻢﻬﻓﺃ ﻻ"}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "؟ﻙﺎﻨﻫ ﺎﻔﻗﺍﻭ ﻞﻀﺘﺳﺃ"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "؟ﻝﻮﻤﺤﻣ ٌﺯﺎﻬﺟ ؟ﻩﺎﻫ"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "...ﻞﺟﺭ ﺎﻳ"}
