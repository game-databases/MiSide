{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Games on TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "؟ﺐﻌﻠﻧ ﻥﺃ ﺪﻳﺮﺗ ﺍﺫﺎﻣ"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Game milk"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "!ﻝﺎﺘﻗ ﺔﺒﻌﻟ ﻩﺬﻫ"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "!ًﻻﻭﺃ ﺾﻤﺤﻴﺳ ﻦﻣ ﻯﺮﻧ ﺎﻧﻮﻋﺩ"}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "!ﺔﺒﻌﻟ ﻦﻣ ﺎﻬﻟ ﺎﻳ"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": ".ﺮﺧﺁ ﺎًﺌﻴﺷ ﻞﻌﻔﻨﻟ ،ﻥﻵﺍ ﺐﻴﻠﺤﻟﺍ ﻦﻣ ﺔﻳﺎﻔﻛ ﺎﻨﺑﺮﺷ ﺪﻘﻟ"}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Game penguins"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "ﻖﻳﺮﻄﺑ ﺖﻧﺃ ،ﺔﺒﻌﻠﻟﺍ ﻩﺬﻫ ﻲﻓ"}
{"category": "LocationDialogue Location4", "line_index": 354, "text": ".ﺀﺎﺟﺭﻻﺎﺑ ﻖﻟﺰﺘﻳ"}
{"category": "LocationDialogue Location4", "line_index": 355, "text": ".ﺔﺒﻌﻠﻟﺍ ﻲﻫ ﻩﺬﻫ ,ﻡﺎﻤﺗ"}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "؟ﺍﺫﺎﻣ ،ﻩﺎﻫ"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "...ﻚﻧﺃ ﺪﻘﺘﻋﺃ ﺖﻨﻛ ؟ﺩﺎﺟ ﺖﻧﺃ"}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "!ﺔﻳﺎﻐﻠﻟ ﺓﺪﻴﻌﺳ ﺎﻧﺃ"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "...ﺎﻣ ﺎًﻋﻮﻧ ﺔﻜﺒﺗﺮﻣﻭ"}
