{"category": "LocationDialogue Location4", "line_index": 379, "text": ".ﺞﻠﺜﻟﺍ ﺕﺍﺮﻛ ﻊﻤﺟ ﻯﻮﺳ ﻚﻴﻠﻋ ﺎﻣ"}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "!ﺯﻮﻔﻳ ﺞﻠﺜﻟﺍ ﺕﺍﺮﻛ ﻦﻣ ﺮﺒﻛﺃ ﺍًﺩﺪﻋ ﻊﻤﺠﻳ ﻱﺬﻟﺍ ﺺﺨﺸﻟﺍ"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "!؟ﻚﻟﺬﻛ ﺲﻴﻟﺃ ،ﻦﻴﺘﻟﻮﺟ ﺐﻌﻠﻨﻟ"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// The first map"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "؟ﺩﺪﻌﻟﺍ ﺍﺬﻫ ﻰﻠﻋ ﺖﻠﺼﺣ ﻒﻴﻛ ،ﻭﺍﻭ"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "!ﺞﻠﺜﻟﺍ ﺕﺍﺮﻛ ﻦﻣ ﺩﺪﻋ ﺮﺒﻛﺃ ﻰﻠﻋ ﺖﻠﺼﺣ ﺪﻘﻟ !ﻲﻬﻴﺗ"}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "!ﻲﺑ ﻖﺤﻠﺗ ﻥﺃ ﻞﻀﻓﻷﺍ ﻦﻣ"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "ﻩﺍ, 1:1!"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// The second map"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "!ﻲﻌﻴﺒﻃ ﻖﻳﺮﻄﺑ ﺖﻧﺃ"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "!ﺪﻴﻠﺠﻟﺍ ﻰﻠﻋ ﺞﻟﺰﺘﺗ ﻚﻠﻌﺠﻧ ﻥﺃ ﺐﺠﻳ"}
{"category": "LocationDialogue Location4", "line_index": 390, "text": ".ﺔﻳﺎﻐﻠﻟ ﺀﻲﻄﺑ ﺖﻧﺃ ،ﻲﻬﻟﺇ ﺎﻳ"}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "؟ﺓﺮﻴﺧﻷﺍ ﺔﻟﻮﺠﻟﺍ ﻲﻓ ﺮﻜﻔﺗ ﺖﻟﺯ ﺎﻣ ﻞﻫ"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "!ﺙﻭﺪﺤﻟﺍ ﺭﺩﺎﻧ ﺮﻣﺃ ﺍﺬﻫ !ﻝﺩﺎﻌﺘﻟﺍ ،ﻲﻬﻟﺇ ﺎﻳ"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// The game is over"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "؟ﺮﺧﺁ ﺀﻲﺷ ﺐﻌﻟ ﺪﻳﺮﺗ ﻞﻫ ،ﺎًﻨﺴﺣ"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "؟ﺖﻴﻬﺘﻧﺍ ﻚﻧﺃ ﻡﺃ"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "؟ﻚﻟﺫ ﻰﻟﺇ ﺝﺎﺘﺤﺗ ﺍﺫﺎﻤﻟ"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "؟ﺪﺤﻟﺍ ﺍﺬﻫ ﻰﻟﺇ ﺏﺎﻌﻟﻷﺍ ﻲﺒﺤﻣ ﻦﻣ ﺖﻧﺃ ﻞﻫ"}
