{"category": "LocationDialogue Location20", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "!ﺔﻧﻮﻨﺠﻣ ﺖﻧﺃ !ﺍﺍﺍﻻ !ﻼﻴﻣ"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "؟ﺍﺬﻫ ﺎﻣ !ﺎﻫ-ﺎﻫ"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "؟ﻩﺍﺭﺃ ﺪﻳﺪﺟ ﻝﺎﻌﻔﻧﺍ ﺍﺬﻫﺃ"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "!ﺪﻳﺰﻤﻟﺍ ﻯﺭﺃ ﻲﻨﻋﺩ ،ﺎﻴﻫ"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "!ﻚﺗﺪﻫﺎﺸﻣ ﺩﺮﺠﻣ ﻦﻣ ﺖﻣﺄﺳ ﺪﻘﻟ"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\""}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "؟ﺏﺮﻄﻀﻤﻟﺍ ﺮﻴﻐﺼﻟﺍ ﻲﻟﺎﺣﺭ ﺎﻳ ,ﻚﻌﺿﻭ ﻒﻴﻛ"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "؟ﺪﻌﺑ ﺐﻌﺘﺗ ﻢﻟﺃ ؟ﺾﻛﺮﺗ ﺖﻟﺯ ﻻ"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "؟ﻼﻴﻤﺑ ِﺖﻠﻌﻓ ﺍﺫﺎﻣ"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "!ﺔﻗﺎﻃ ﻚﻴﻓ ﻝﺍﺯ ﺎﻣ ,ﺍًﺫﺇ"}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "!ﻯﺮﺧﺃ ﺔﺒﻌﻟ ﺐﻌﻠﻨﻟ !ﺯﺎﺘﻤﻣ"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "...ِﺖﻧﺃ"}
{"category": "LocationDialogue Location20", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "!ﺮﻴﻐﺻ ﺭﺎﺒﺘﺧﺎﺑ ﺽﺮﻌﻟﺍ ﺃﺪﺘﺒﻨﻟ"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "!ﻚﺗﺍﺭﺎﻬﻣ ﻖﺳﺎﻨﺗ ﺮﺒﺘﺨﻨﻟ"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "!ﻚﻟﺬﻛ ﻚﺑﻮﻠﺳﺃ ﺮﺒﺘﺨﻨﺳﻭ"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "؟!ﻚﻴﻓ ﺔﻠﻜﺸﻣ ﻙﺎﻨﻫ ﻥﺎﻛ ﻮﻟ ﺍﺫﺎﻣ"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "ﺪﻠﺠﻟﺍ ﻚﻟﺫ ﻖﺤﺘﺴﺗ ﻻ ﻰﺘﺣ ﺖﻨﻛ ﻮﻟ ﺍﺫﺎﻣ"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "؟!ﻪﺋﺍﺪﺗﺭﺎﺑ ﺮﺨﺘﻔﺗ ﻱﺬﻟﺍ"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "...ﺓﺮﻈﻧ ِﻖﻟﺃ"}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "؟ﻚﻫﺎﺒﺘﻧﺍ ﺖﻔﻠﺗ ﺎﻤﻬﺘﻳﺃ"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "؟ﻰﻨﻤﻴﻟﺍ"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "ﻡﺃ"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "؟ﻯﺮﺴﻴﻟﺍ"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "؟ﻱﺪﺟ ﺖﻧﺃ"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "؟ﺎﻤﻬﻓﻼﺘﺧﺃ ﺎﻣ"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "!ﺐﺴﺤﻓ ﻚﺒﻋﺍﺩﺃ ﺖﻨﻛ"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": ".ًﻼﺻﺃ ﻱﺩﺎﻴﺘﻋﺍ ﻦﻴﻛﺎﻜﺴﻟﺎﺑ ﺐﻌﻠﻟﺍ"}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "!ﻚﻟﺫ ﻞﻛ ﻰﺴﻧﺍ"}
{"category": "LocationDialogue Location20", "line_index": 39, "text": ",ﺮﻴﺜﻜﺑ ﻞﻀﻓﺃ ﻮﻫ ﺎﻣ ﺕﺰﻬﺟ"}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "...ﻞﺜﻣ"}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "!ﺍﺬﻫ ﺪﻫﺎﺷ"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "!ﻰﻘﻴﺳﻮﻤﻟﺍ ﺾﻌﺑ ﻰﻟﺇ ﺔﺟﺎﺤﺑ ﻦﺤﻧ"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "؟ﺔﻤﻐﻨﻟﺍ ﺍﺬﻫ ﻲﻓ ﻚﻳﺃﺭ ﺎﻣ"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "!ﻲﻨﺴﻤﺤﺗ ﺎﻬﻧﺇ"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "ﺃﺪﺑﺄﺳ"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "!ﺪﻋﺍﻮﻘﻟﺎﺑ"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rules"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "،ﺔﻠﻐﺸﻣ ﻰﻘﻴﺳﻮﻤﻟﺍ ﺎﻤﻨﻴﺑ"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": ".ﻙﺮﺤﺘﻟﺍ ﻚﻨﻜﻤﻳ"}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "،ﻰﻘﻴﺳﻮﻤﻟﺍ ﻒﻗﻮﺘﺗ ﺎﻣﺪﻨﻋ ﻦﻜﻟﻭ"}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "!ﻙﺮﺤﺘﺗ ﻻ"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "؟ﺖﻤﻬﻓ .ﺕﻮﻤﺘﺳ ﻻﺃ ﻭ"}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "ﺔﻳﺎﻬﻨﻟﺍ ﻰﻟﺇ ﻝﻮﺻﻮﻟﺍ ﻰﻠﻋ ﺹﺮﺣﺍ :ﻂﻴﺴﺑ ﺮﻣﻷﺍ"}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "ﻚﻟﺫ ﻊﻴﻄﺘﺴﺗ ﻥﺎﻛ ﻥﺍ"}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "!ﺃﺪﺒﻨﻟ"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "؟ﺎًﻔﻗﺍﻭ ﺖﻟﺯ ﺎﻣ ﺎﻤﻟ"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "!ﺾﻛﺭﺍ ،ﺮﻜﺳ ﺎﻳ ﺾﻛﺭﺍ"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "!ﻩﻭﺃ"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "!ﺔﻳﺎﻐﻠﻟ ﻊﻴﻄﻣ !ﻚﻴﻟﺇ ﺮﻈﻧﺍ"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": ".ﺓﺮﻴﻐﺻ ﺔﻴﻟﺎﺜﻣ ﺔﻨﻴﻋ"}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "!ﻲﺴﻔﻨﻟ ﻙﺪﻳﺭﺃ"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "؟ﻚﻟﺬﻛ ﺲﻴﻟﺃ ،ﺔﻳﺎﻐﻠﻟ ًﻼﻬﺳ ﻚﻟﺫ ﻥﺎﻛ"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "!ﺐﻫﺫﺃ ﻲﻨﻴﻋﺩ"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "!ﻥﻻﺍ ﻲﺧﺮﺘﺴﺗ ﻻ"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "!ﺎﻬﺒﻌﻠﻨﻟ ﺏﺎﻌﻟﻷﺍ ﻦﻣ ﺮﻴﺜﻜﻟﺍ ﺎﻨﻳﺪﻟ"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": ":ﻲﻟﺎﺘﻟﺍ"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "...ﻲﻨﻴﻋ ﺾﻤﻏﺄﺳ"}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "،ﺎﻤﻬﺤﺘﻓﺃ ﺎﻣﺪﻨﻋﻭ"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "!ﻙﺍﺭﺃ ﻻ ﻥﺃ ﻞﻀﻓﻷﺍ ﻦﻣ"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "؟ﺖﻤﻬﻓ"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "!ﻚﺒﻗﺎﻋﺄﺳ ،ﻚﺘﻳﺃﺭ ﺍﺫﺇ"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "!ﺃﺪﺒﻨﻟ !ﺎًﻨﺴﺣ"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "...ﺍﺬﻫ ﻦﻣ ﻯﻭﺪﺟ ﻻ"}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "!ﺖﺤﺠﻧ ﺪﻘﻟ"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "!ﺍًﺮﻴﺜﻣ ﺮﻣﻷﺍ ﺢﺒﺻﺃ ﺪﻘﻟ ،ﻊﺋﺍﺭ ﻞﻤﻌﺑ ﻡﻮﻘﺗ ﺖﻧﺃ"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": ".ﺐﻌﺻﺃ ﺮﻣﻷﺍ ﺢﺒﺼﻴﺳ ﻥﻵﺍ ﻦﻜﻟﻭ"}
{"category": "LocationDialogue Location20", "line_index": 85, "text": ".ﺮﻴﺜﻜﺑ ﺐﻌﺻﺃ"}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "!ﺭﺩ ،ﺾﻛﺭﺍ ،ﺊﺒﺘﺧﺍ"}
{"category": "LocationDialogue Location20", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "!ﺔﻨﻌﻠﻟﺍ ﻚﻴﻠﻋ ،ﻩﺎﻋ"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
