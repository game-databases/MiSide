{"category": "LocationDialogue Location12", "line_index": 0, "text": "// Mita"}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Сиди тутъ."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Я, кажется, что-то обронила. Скоро вернусь."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "Потомъ мы отправимся за очереднымъ новенькимъ ​міромъ​."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": "// MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Хорошо."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": "// MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Давай играть!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Хочу медвѣжонка!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "Я потеряла его..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "Найди его!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": "// MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Ты..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "Ну что уставился?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Answer 1 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Я Мита."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "Лучшая Мита."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "Первая Мита."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "Такъ сказала Мита. Моя Мита."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Answer 2 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "Какъ я выгляжу?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "Какъ я выгляжу?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "Какъ я выгляжу?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "Моя Мита говоритъ, что я красивая и оригинальная. "}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "Такъ я выгляжу."}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Answer 3 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Она заберетъ меня."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Мы будемъ жить въ новомъ ​мірѣ​."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "Моя Мита пригласила меня."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Она заберетъ меня. Мы будемъ играть."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Answer 4 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "Медвѣжонокъ — это ты."}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "И ты потерялся,"}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "Какъ мой медвѣжонокъ."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Answer 5 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "Моя..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "Мита."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Хочетъ играть."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Она хочетъ забрать"}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "Только меня."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Мы ​оригинальныя​."}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "Мы ​единственныя​."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Мита и моя Мита,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0.8A и 8МЪ54*"}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Answer 6 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "Моя Мита..."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "Моя лучшая подруга..."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "Моя Мита."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "Мой единственный другъ."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": "// MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "Это — ты!"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Смотри."}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Давай играть!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Я покажу какъ. "}
