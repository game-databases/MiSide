{"category": "LocationDialogue Location9", "line_index": 0, "text": "// Mita Chibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Эй, ты!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Привѣтъ!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Хочешь выбраться?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Тогда помоги мнѣ найти ключъ!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search - MitaChibi  - [not]"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Блинъ! Здѣсь нѣтъ ключа!"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Тутъ пусто!"}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "Абсолютное ничего!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Нашла!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Я думала, ты пониже будешь!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "А ты вонъ какой большой!"}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "Какъ сестренка!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "Эмъ… Сестренка?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Да, сестренка."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Будто не встрѣчалъ ​ее​!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Встрѣчалъ? Слабо сказано."}
{"category": "LocationDialogue Location9", "line_index": 22, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Ты дуракъ?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "Эмъ-м..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "Дуракъ, получается..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "Давай, покажи, гдѣ искать ключъ!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Вотъ."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Забрось желѣзо въ трубу!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Спасибо!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "А теперь опусти дрова для меня!"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Благодарю!"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Теперь помоги тутъ!"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Готово! Сейчасъ..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "Смотри, какъ красиво..."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Нажимай давай!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Хоба!"}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "Ну всё, забирай!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "Ключикъ твой!"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// quest 1 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Я ChibiMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Съ кучкой строкъ,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "Простѣйшей арматурой,"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "И съ прекраснѣйшими волосами!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// quest 2 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Мистеръ большой дурачокъ,"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "Ты очень мило выглядишь,"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "Задавая ​глупые​ вопросы.)"}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Однако,"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "Я вижу тебя впервые!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Но... // Player"}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Если кто-то и укралъ мой чудесный образъ, // MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "То это будетъ на его совѣсти!"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// quest 3 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Ты не понялъ?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "Это пропускной пунктъ!"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "Предъявите свои извилины!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "Проходите!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Я провожаю заблудшихъ по глупости потеряшекъ!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// quest 4 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "А кто ты такой,"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "Чтобы НЕ помогать тебѣ?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "Что?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Дурашливый."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Вывалился откуда-то!"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Тебѣ тутъ быть не слѣдуетъ,"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "Вотъ и помогаю!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Пока-пока, глупышъ!) // Mita [not] "}
