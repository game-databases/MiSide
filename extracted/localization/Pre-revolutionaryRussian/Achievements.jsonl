{"category": "Achievements", "line_index": 0, "text": "Кислое молоко."}
{"category": "Achievements", "line_index": 1, "text": "Щелчокъ тьмы."}
{"category": "Achievements", "line_index": 2, "text": "Мёртвый сокъ."}
{"category": "Achievements", "line_index": 3, "text": "Пингвинобѣда!"}
{"category": "Achievements", "line_index": 4, "text": "Сейфъ жизни."}
{"category": "Achievements", "line_index": 5, "text": "Побѣда мухи."}
{"category": "Achievements", "line_index": 6, "text": "О великая Мита!"}
{"category": "Achievements", "line_index": 7, "text": "Я нашёлъ тебя!"}
{"category": "Achievements", "line_index": 8, "text": "Вкусная любовь."}
{"category": "Achievements", "line_index": 9, "text": "Условія выполнены."}
{"category": "Achievements", "line_index": 10, "text": "Разгоняйся!"}
{"category": "Achievements", "line_index": 11, "text": "Шлёпъ по головѣ!"}
{"category": "Achievements", "line_index": 12, "text": "Всѣ игроки у меня."}
{"category": "Achievements", "line_index": 13, "text": "Привѣтъ, Мита."}
{"category": "Achievements", "line_index": 14, "text": "Это конецъ?"}
{"category": "Achievements", "line_index": 15, "text": "Разогнался до предѣла!"}
{"category": "Achievements", "line_index": 16, "text": "Какое-то достиженіе?"}
{"category": "Achievements", "line_index": 17, "text": "Великій танецъ."}
{"category": "Achievements", "line_index": 18, "text": "Длинный хвостъ."}
{"category": "Achievements", "line_index": 19, "text": "Ты не пройдешь!"}
{"category": "Achievements", "line_index": 20, "text": "Логи первой фазы."}
{"category": "Achievements", "line_index": 21, "text": "Логи второй фазы."}
{"category": "Achievements", "line_index": 22, "text": "Адская побѣда."}
{"category": "Achievements", "line_index": 23, "text": "И безъ урона?!"}
{"category": "Achievements", "line_index": 24, "text": "Морковка."}
{"category": "Achievements", "line_index": 25, "text": "Задротище."}
