{"category": "LocationDialogue Location11", "line_index": 0, "text": "// Mita"}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Привѣтъ!)"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Ой!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Прости,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "Чуть не убила тебя..."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Ой..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "То ​есть​ холодильникъ чуть не убилъ тебя."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Я тутъ ни при чёмъ)"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "Точно-точно тебѣ говорю!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Честно!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Вотъ такъ взялъ и повѣрилъ!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": "// Mita"}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Ну, вообще-то,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "Тутъ опасно находиться..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "Особенно тебѣ."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "А ты не изъ пугливыхъ!"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Интересно наблюдать за тобой,"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "Какъ ты проходишь"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "​Эти​ мѣста..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Бѣги-бѣги, малышъ!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "Догнать тебя еще успѣю!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Пытайся-пытайся!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Это весело!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Я вижу, ты идешь къ фуникулеру."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "Это самый длинный путь"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "Между версіями."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Интересно, какъ ты справишься"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "Съ ​теми​, кто тамъ живутъ,"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "Въ этомъ туманѣ."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Ты чего?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "А ну..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Не смотри,"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Дуракъ!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Дуракъ..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": "// Mita if player out"}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "А, ладно..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": "// Goodbye"}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Удачи тебѣ!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": "// Mitaghost"}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Кто здѣсь?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Я чувствую тебя..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Послушай,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "Ты игрокъ,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "Вѣрно?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Помоги мнѣ найти..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "Найти..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "Вспомнить..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "Я не увѣрена..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Да что тутъ происходитъ? // Player"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1 - Mitaghost"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Когда-то я хотѣла всё забыть..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Разбила ​всѣ​ зеркала,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "Испортила картины..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "А теперь..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "Я испытываю вину"}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "И это такъ глупо..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "​Всѣ​ совершаютъ ошибки,"}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Но какъ поступить,"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "Когда послѣдствія ​катастрофическія​?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Вотъ бы всё вернуть назадъ..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Говорятъ, время лѣчитъ..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Но что такое время?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Я уже ни во что не вѣрю..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "И если время способно излѣчить"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "Или хотя бы забрать меня"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "Изъ этого ​міра​,"}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "То прошу тебя,"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "Поторопи время,"}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "Чтобы оно убило меня"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "Въ послѣдній разъ."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Она любитъ..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Я тоже могла любить."}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Но не такъ, какъ она."}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "​Ея​ любовь очень активная,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "Докучливая,"}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "Горячая,"}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "Размашистая,"}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "Завистливая,"}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "Злобная,"}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "Безумная..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Кажется, меня звали эмоціональной..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "«Ты слишкомъ много волнуешься, Мита»..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "«Ты справишься, Мита»..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "«Ты не одинока»..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Но что же тамъ было въ итогѣ?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Печаль,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "Отчаяніе..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "И ужасъ."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Безполезно..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Никакъ не могу вспомнить..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "Руки опускаются..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Еще это безконечное эхо..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Не могу справиться съ мыслью,"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "Что я заперта здѣсь..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Я всегда была тутъ."}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "Почему?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Не помню…"}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Это закончится?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Не знаю…"}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mitaghost get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Это..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "Рисунокъ..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Я вспоминаю!"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "Спасибо тебѣ..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Но мое лицо..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "У меня нѣтъ лица."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "Это всё ОНА!"}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Оторвала кусокъ отъ меня!"}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "И выбросила въ пустоту..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Она сильна..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "И умна."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Я не имѣю никакого права задерживать тебя, игрокъ."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Загляни въ шкафъ."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": "// Chibi Mita - [not]"}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Эй!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Ты мнѣ дорогу преграждаешь!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Такъ и будешь стоять? "}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Можетъ, отойдешь?"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Дай пройти!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Если ты большой, это не значитъ, что ты всемогущій!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Почему ты меня преслѣдуешь?!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Отстань!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Погодите-ка, игрокъ?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "А чего ты тутъ забылъ?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Кто тутъ?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": "// Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Опять игрокъ, значитъ."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Я Мита-фонъ."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Сижу и удаленно управляю фуникулерами."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Ты понимаешь,"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "Что ты сейчасъ направляешься къ обломку?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Нѣтъ."}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "Но у меня нѣтъ другой дороги."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": "// Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Ясно."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Нажимай кнопку и садись за пушку."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "Пушка?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": "// Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Ага."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Думалъ, просто проѣдешь?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Ты проѣзжаешь черезъ мини-игру «Монстру-шлепсъ»,"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "Такъ что готовься стрѣлять)"}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Итакъ, мы отправляемся въ путь."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Отлично!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Ты справился!"}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Давай, выходи отсюда."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Живенько и быстренько!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 1 - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Ты чего стоишь?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Я сказала тебѣ выйти отсюда."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 2 - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Я не понимаю."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "Ты реально просто стоишь?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Какая приставка?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Че-ѣлъ..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Пока. "}
