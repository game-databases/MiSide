{"category": "LocationDialogue Location6", "line_index": 0, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "Mito?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "Kde ses tady vzal?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Ty jsi Mita, že?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Ale jsi nějaká jiná..."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "To máš pravdu..."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "Ale teď dobře poslouchej."}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "Nejsem ta Mita, kterou jsi potkal předtím."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Dávej si na ni pozor..."}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "Něco si na tebe chystá."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "Co si na mě chystá?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "Kruci!"}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "Jestli to vyjde, tak ti všechno řeknu."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Najdi klíč vedle gauče."}
{"category": "LocationDialogue Location6", "line_index": 19, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Ale..."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "Otázky si nech na později!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Dej mi ten klíč."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Tady máš prsten"}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "K čemu?"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Chceš se odsud dostat, že jo?"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "Jo..."}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Tak si ho nasaď."}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "Je to užitečná pomůcka,"}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "Pravděpodobně ho brzy využiješ."}
{"category": "LocationDialogue Location6", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Dobře..."}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "Mimochodem, já jsem"}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Mmm,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "Já jsem... Mita."}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// MitaKind quest 1"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "Vidíš tu konzoli?"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "Vezmi si ji."}
{"category": "LocationDialogue Location6", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "To je záznam?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "Kdo je to s ní?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "Tohle se děje právě teď."}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "Je to další hráč."}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Využívá ho."}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Dávej si na ni pozor,"}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "Může z tebe udělat kazetu."}
{"category": "LocationDialogue Location6", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "Musím odsud ihned vypadnout."}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "A ty taky."}
{"category": "LocationDialogue Location6", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "Ano, to musíme."}
{"category": "LocationDialogue Location6", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "Takže říkáš."}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "Že ho využívá."}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "Co se stane, když vytáhnu tu kazetu?"}
{"category": "LocationDialogue Location6", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "To by mohlo způsobit"}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "Nenávratné poškození kazety."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "Což znamená, že..."}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "Hráč zemře."}
{"category": "LocationDialogue Location6", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "..."}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "Co když tu konzoli prostě vypnu?"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "To by mohlo fungovat..."}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Za pokus to stojí. Na konzoli je červené tlačítko!"}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Vidíš ho?"}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "Našel jsem ho."}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "Stiskni ho."}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// MitaKind quest 2"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Musím tu zůstat."}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "Chci se jí zeptat na pár otázek,"}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "Abych se o ní něco dozvěděla."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "Ale nemyslím si, že bude mít chuť na řeč..."}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// MitaKind quest 3"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "Řeknu ti pravdu, tohle je moje verze."}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "Byla jsem tady s jedním hráčem,"}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "A najednou se něco stalo."}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "Objevila se ona..."}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "A proměnila hráče v kazetu"}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "A zavřela mě tady."}
{"category": "LocationDialogue Location6", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Počkat, ona z něj udělala kazetu?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "Může to vůbec udělat?"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "Ale proč?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "K čemu potřebuje hráče?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "Očividně je šílená..."}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Je to pro ní jen hra a vyžívá se v tom, potvora!"}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "Předělává hráče na kazety..."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Někteří ani netuší, že je promění..."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "A ti co ví, se ani nebrání..."}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "Vůbec se mi to nelíbí."}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "Musíš nám pomoct!"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "Já? Ale jak?"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "Potřebuju tě!"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "Když nám pomůžeš, pomůžu i já tobě!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Tohle je možná naše jediná šance."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "Prsten tě dovede ke správné verzi."}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "Setkáme se tam."}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// MitaKind quest 4"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "Stále nerozumím tomu"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "Co jsem tam nahoře viděl..."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Ta Mita..."}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "Chtěla mě zabít?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "Zabít?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Má pro tebe připravené horší věci..."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "Musíš si pospíšit."}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Hide!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "Kruci! Schovej se!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Počkat, co...?"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Rychle, už jde!"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "Následuj prsten. Dovede tě do bezpečí!"}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "No tak, řekneš mi kde je?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "Proč bych to dělala?"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "Nezabiješ ho, že ne?"}
{"category": "LocationDialogue Location6", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Aha, takže mi to odmítáš říct."}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Nevadí, mám ráda hru na schovávanou."}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "Vím, že je někde tady."}
{"category": "LocationDialogue Location6", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "Proč jsi na nás tak zlá?"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "Ani mi neřekneš, co se děje!"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "A vůbec..."}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "K čemu potřebuješ hráče?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "Nejsou to žádné hračky!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "Co to do tebe vjelo?!"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "Sklapni, panenko!"}
