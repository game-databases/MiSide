{"category": "LocationDialogue Location1", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 1, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 9, "text": "Ahoj, já jsem Mita!"}
{"category": "LocationDialogue Location1", "line_index": 10, "text": "Jak se jmenuješ?"}
{"category": "LocationDialogue Location1", "line_index": 11, "text": "Ráda tě poznávám, [player]!"}
{"category": "LocationDialogue Location1", "line_index": 12, "text": "Um... [player],"}
{"category": "LocationDialogue Location1", "line_index": 13, "text": "Předtím jsem trochu pospíchala a nechala tu nepořádek..."}
{"category": "LocationDialogue Location1", "line_index": 14, "text": "Pomohl bys mi uklidit?"}
{"category": "LocationDialogue Location1", "line_index": 15, "text": "Tyjo..."}
{"category": "LocationDialogue Location1", "line_index": 16, "text": "Mockrát děkuji!"}
{"category": "LocationDialogue Location1", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 18, "text": "[Player], kručí mi v bříšku..."}
{"category": "LocationDialogue Location1", "line_index": 19, "text": "Mám velký hlad..."}
{"category": "LocationDialogue Location1", "line_index": 20, "text": "Myslíš, že bys mi mohl pomoct sehnat ingredience na kuřecí vývar?"}
{"category": "LocationDialogue Location1", "line_index": 21, "text": "Jupí! Máme všechno!"}
{"category": "LocationDialogue Location1", "line_index": 22, "text": "Co takhle ho uvařit společně?"}
{"category": "LocationDialogue Location1", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 25, "text": "Ahoj, [player]! Přemýšlela jsem, že bych si koupila přenosnou televizku."}
{"category": "LocationDialogue Location1", "line_index": 26, "text": "Nějakou malou s anténkou. Ideální na procházky, nemyslíš?"}
{"category": "LocationDialogue Location1", "line_index": 27, "text": "Mimochodem, můžeš hrát hry abys vydělal peníze."}
{"category": "LocationDialogue Location1", "line_index": 28, "text": "Věděl jsi, že můžeš hrát hry a dostat za to peníze?"}
{"category": "LocationDialogue Location1", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 30, "text": "Hurá! Dokázal jsi to! Máš dost na to, abys mi koupil tu přenosnou televizku!"}
{"category": "LocationDialogue Location1", "line_index": 31, "text": "To je ona! Malá, přenosná a levná - přesně jak jsem chtěla."}
{"category": "LocationDialogue Location1", "line_index": 32, "text": "Děkuji!"}
{"category": "LocationDialogue Location1", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 34, "text": "Ahoj, [player]! Jsem moc ráda za tvou pomoc."}
{"category": "LocationDialogue Location1", "line_index": 35, "text": "Ale... ta televizka? Byla super, ale už se rozbila."}
{"category": "LocationDialogue Location1", "line_index": 36, "text": "Každopádně, mohl bys mi pomoct přestěhovat tuhle skříň?"}
{"category": "LocationDialogue Location1", "line_index": 37, "text": "Je strašně těžká... >.<"}
{"category": "LocationDialogue Location1", "line_index": 38, "text": "Moc ti děkuju, zlatíčko! <3"}
{"category": "LocationDialogue Location1", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 40, "text": "Ah, [player]! Byl to jen jeden den, ale už se mi tak hrozně stýskalo!"}
{"category": "LocationDialogue Location1", "line_index": 41, "text": "Kéž bys mě mohl navštěvovat častěji."}
{"category": "LocationDialogue Location1", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 43, "text": "To je pro mě?"}
{"category": "LocationDialogue Location1", "line_index": 44, "text": "Mockrát děkuji, opravdu!"}
{"category": "LocationDialogue Location1", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 46, "text": "Ahoj, [player]! Tak jsem přemýšlela..."}
{"category": "LocationDialogue Location1", "line_index": 47, "text": "Kéž bychom se mohli setkat osobně."}
{"category": "LocationDialogue Location1", "line_index": 48, "text": "Je škoda, že to nejde."}
{"category": "LocationDialogue Location1", "line_index": 49, "text": "Pořád mi pomáháš, každý den jsi ke mně tak laskavý..."}
{"category": "LocationDialogue Location1", "line_index": 50, "text": "Kéž bych pro tebe taky mohla něco takového udělat."}
{"category": "LocationDialogue Location1", "line_index": 51, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 52, "text": "Mám nápad!"}
{"category": "LocationDialogue Location1", "line_index": 53, "text": "Teď jsme spolu. // Záměrně krkolomnější dialog"}
{"category": "LocationDialogue Location1", "line_index": 54, "text": "Polož ten telefon."}
{"category": "LocationDialogue Location1", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 57, "text": "// T-shirt on the bed - Player"}
{"category": "LocationDialogue Location1", "line_index": 58, "text": "Co děláš tady na posteli?"}
{"category": "LocationDialogue Location1", "line_index": 59, "text": "// Rubik's Cube - Player"}
{"category": "LocationDialogue Location1", "line_index": 60, "text": "No, nemůžu říct, že by mi k něčemu byla..."}
{"category": "LocationDialogue Location1", "line_index": 61, "text": "Jednou jsem ji složil a pak už jsem se jí nikdy nedotkl."}
{"category": "LocationDialogue Location1", "line_index": 62, "text": "Beztak bych to podruhé nezvládl."}
{"category": "LocationDialogue Location1", "line_index": 63, "text": "// Computer"}
{"category": "LocationDialogue Location1", "line_index": 64, "text": "Tak co tu máme..."}
{"category": "LocationDialogue Location1", "line_index": 65, "text": "Sepsat seznam úkolů..."}
{"category": "LocationDialogue Location1", "line_index": 66, "text": "Naskriptovat reakce postav,"}
{"category": "LocationDialogue Location1", "line_index": 67, "text": "A možná se tam vejde i nějaké programování."}
{"category": "LocationDialogue Location1", "line_index": 68, "text": "// The airplane"}
{"category": "LocationDialogue Location1", "line_index": 69, "text": "Pro let jako dělané!"}
{"category": "LocationDialogue Location1", "line_index": 70, "text": "// Trash in the corner"}
{"category": "LocationDialogue Location1", "line_index": 71, "text": "Fuj, vždycky zapomenu vynést odpadky..."}
{"category": "LocationDialogue Location1", "line_index": 72, "text": "Ale tentokrát na to určitě nezapomenu!"}
{"category": "LocationDialogue Location1", "line_index": 73, "text": "...Počkat, kdy že jsem si měl uklidit?"}
{"category": "LocationDialogue Location1", "line_index": 74, "text": "// Photo of a cat on a watermelon"}
{"category": "LocationDialogue Location1", "line_index": 75, "text": "Tak se mi líbila..."}
{"category": "LocationDialogue Location1", "line_index": 76, "text": "Kočka na melounu."}
{"category": "LocationDialogue Location1", "line_index": 77, "text": "// Photo with a girl - Player"}
{"category": "LocationDialogue Location1", "line_index": 78, "text": "Vůbec si nejsme podobní,"}
{"category": "LocationDialogue Location1", "line_index": 79, "text": "Já a moje sestra."}
{"category": "LocationDialogue Location1", "line_index": 80, "text": "Ona je pořád někde venku,"}
{"category": "LocationDialogue Location1", "line_index": 81, "text": "A já trčím doma."}
{"category": "LocationDialogue Location1", "line_index": 82, "text": "// Photo with people"}
{"category": "LocationDialogue Location1", "line_index": 83, "text": "Hmm..."}
{"category": "LocationDialogue Location1", "line_index": 84, "text": "Být kancelářskou krysou nám opravdu navrtalo"}
{"category": "LocationDialogue Location1", "line_index": 85, "text": "Korporátní etiketu do hlavy, co?"}
{"category": "LocationDialogue Location1", "line_index": 86, "text": "Pořád mi trochu chybí"}
{"category": "LocationDialogue Location1", "line_index": 87, "text": "Ale"}
{"category": "LocationDialogue Location1", "line_index": 88, "text": "Ani vlastně nevím"}
{"category": "LocationDialogue Location1", "line_index": 89, "text": "Jestli je ještě někdy uvidím."}
{"category": "LocationDialogue Location1", "line_index": 90, "text": "...Počkat, proč tady tu fotku vůbec mám?"}
{"category": "LocationDialogue Location1", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 93, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 99, "text": "// Nope name - Mita"}
{"category": "LocationDialogue Location1", "line_index": 100, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 101, "text": "Ale ne."}
{"category": "LocationDialogue Location1", "line_index": 102, "text": "To nepůjde."}
{"category": "LocationDialogue Location1", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 104, "text": "// Name - Developer"}
{"category": "LocationDialogue Location1", "line_index": 105, "text": "Opravdu chceš použít jméno vývojáře?"}
{"category": "LocationDialogue Location1", "line_index": 106, "text": "Jsem ráda, že je znáš, ale..."}
{"category": "LocationDialogue Location1", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 108, "text": "// Bad name"}
{"category": "LocationDialogue Location1", "line_index": 109, "text": "Byla bych radši, kdyby ses tak nejmenoval."}
{"category": "LocationDialogue Location1", "line_index": 110, "text": "Vůbec se mi to nelíbí."}
{"category": "LocationDialogue Location1", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 112, "text": "// Go restart"}
{"category": "LocationDialogue Location1", "line_index": 113, "text": "Ne, takhle to určitě nepůjde. Začneme znovu."}
{"category": "LocationDialogue Location1", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 115, "text": "// Name with numbers"}
{"category": "LocationDialogue Location1", "line_index": 116, "text": "Ty máš v jméně čísla? To už bylo tvoje jméno zabrané?"}
{"category": "LocationDialogue Location1", "line_index": 117, "text": "Jak chceš, je to tvoje volba!"}
{"category": "LocationDialogue Location1", "line_index": 118, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 119, "text": "// Name Mita"}
{"category": "LocationDialogue Location1", "line_index": 120, "text": "Mita?"}
{"category": "LocationDialogue Location1", "line_index": 121, "text": "Opravdu se chceš jmenovat stejně jako já?"}
{"category": "LocationDialogue Location1", "line_index": 122, "text": "Nebo... se tak jmenuješ taky?"}
{"category": "LocationDialogue Location1", "line_index": 123, "text": "Bez urážky, ale myslím si, že bych tu měla být jediná Mita. ♪"}
{"category": "LocationDialogue Location1", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 125, "text": "// Day 10"}
{"category": "LocationDialogue Location1", "line_index": 126, "text": "Jsi zpátky!"}
{"category": "LocationDialogue Location1", "line_index": 127, "text": "Hej, nemůžu najít svůj hřeben..."}
{"category": "LocationDialogue Location1", "line_index": 128, "text": "Pomůžeš mi ho najít?"}
{"category": "LocationDialogue Location1", "line_index": 129, "text": "Zkus se podívat do nočního stolku - myslím, že jsem ho nechala tam."}
{"category": "LocationDialogue Location1", "line_index": 130, "text": "// Looked in the bedside table"}
{"category": "LocationDialogue Location1", "line_index": 131, "text": "Hmm, tam není..."}
{"category": "LocationDialogue Location1", "line_index": 132, "text": "Co takhle někde jinde?"}
{"category": "LocationDialogue Location1", "line_index": 133, "text": "Jen se nedívej do trouby, dobře?"}
{"category": "LocationDialogue Location1", "line_index": 134, "text": "Tam už jsem se dívala."}
{"category": "LocationDialogue Location1", "line_index": 135, "text": "// Looked into the stove"}
{"category": "LocationDialogue Location1", "line_index": 136, "text": "Hej! Říkala jsem ti, ať se tam nedíváš!"}
{"category": "LocationDialogue Location1", "line_index": 137, "text": "Otoč se, já to uklidím!"}
{"category": "LocationDialogue Location1", "line_index": 138, "text": "...Hotovo. Pokračujme v hledání."}
{"category": "LocationDialogue Location1", "line_index": 139, "text": "A dělej, že jsi nic neviděl, ano? <3"}
{"category": "LocationDialogue Location1", "line_index": 140, "text": "// Found a hairbrush"}
{"category": "LocationDialogue Location1", "line_index": 141, "text": "Našel jsi ho! Mockrát děkuji!"}
{"category": "LocationDialogue Location1", "line_index": 142, "text": "Co budeme dělat dál?"}
