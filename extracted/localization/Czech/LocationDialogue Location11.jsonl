{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Ahoj!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Jejda!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Promiň,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "Málem jsem tě zabila."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Teda..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "Ta lednička, teda... ta lednička tě málem zabila."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Já s tím nemám nic společného,"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "Přísahám!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Opravdu!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Jasně, věřím ti!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Ale vážně,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "Tohle místo je nebezpečné..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "Obzvlášť pro tebe."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "Ty se teda moc nebojíš!"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Baví mě tě pozorovat,"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "Jak procházíš"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "Těmito místy..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Jen utíkej, miláčku!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "Já tě doženu!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Jen se snaž!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Je to zábava!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Vidím, že míříš k lanovce."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "Je to ta nejdelší cesta"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "Mezi verzemi..."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Zajímá mě, jak se vypořádáš"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "S těmi, kteří tam žijí"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "Zahalení v mlze."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Co si myslíš, že děláš?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Prosím..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Nedívej se!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Hlupáku!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Ty hlupáku..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Uhm, dobře..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Zlom vaz!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Kdo je tam?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Vím, že tu jsi..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Poslouchej mě,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "Jsi hráč,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "Že ano?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Pomoz mi najít..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "Najít..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "Nech mě přemýšlet..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "Mám v hlavě prázdno..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Co se to tu proboha děje?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Chtěla jsem na všechno zapomenout..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Rozbila jsem všechna zrcadla,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "Zničila fotky..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "Ale teď..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "Cítím se provinile,"}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "Jak jsem byla hloupá..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Každý dělá chyby..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Ale co mám dělat,"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "Když jsou následky katastrofické?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Kéž bych mohla všechno vrátit zpátky..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Říká se, že čas zhojí všechny rány..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Ale co je to čas?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Já už nevěřím ničemu..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Ale jestli čas může léčit,"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "Nebo mě alespoň odnést pryč,"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "Pryč z tohoto světa..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "Pak tě prosím na kolenou,"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "Urychli čas."}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "Aby mě mohl zabít"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "Jednou provždy."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Ona miluje..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Milovala jsem taky někdy?"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Ale moje láska je jiná"}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "Její láska je živá,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "Dotěrná..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "Žhavá..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "Velkolepá..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "Závistivá..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "Zuřivá..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "Šílená..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Říkali mi, že jsem náladová..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "Děláš si příliš velké starosti, Mito..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "Dostaneš se z toho, Mito..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "Nejsi v tom sama, Mito..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Říkali. Ale co mi zbylo?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Smutek,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "Zoufalství..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "A strach."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Je to k ničemu..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Nemůžu si vzpomenout..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "Na nic..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Jen nekonečné ozvěny..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Nemůžu se smířit s tím"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "Že jsem tu uvězněná..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Vždycky jsem tu byla,"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "Ale proč?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Nevzpomínám si..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Skončí to někdy?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Nevím..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "To je..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "Obrázek..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Už si vzpomínám!"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "Děkuji ti..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Ale můj obličej..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "Já nemám obličej..."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "Za to může ONA!"}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Vzala si kus mě..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "A zahodila ho pryč..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Je silná..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "A chytrá."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Nemůžu tě zdržovat, hráči."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Podívej se do skříně..."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": "// Chibi Mita - [not]"}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Hej!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Stojíš mi v cestě!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Budeš tam jen tak stát?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Uhni mi z cesty!"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Nech mě projít!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "To, že jsi velký, neznamená, že jsi všemocný!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Proč mě pronásleduješ!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Jdi do prčic!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - radio voice"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Počkat... Hráč?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "Co tady děláš?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Kdo je tam?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Další hráč."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Jsem Mitafon."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Sedím tady a řídím lanovky."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Uvědomuješ si,"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "Že právě teď míříš do své zkázy?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Možná,"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "Ale je to jediná cesta, kterou mám."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Máš pravdu."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Stiskni tlačítko a sedni za dělo."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "Za dělo?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Jo."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Myslel sis, že pojedeš zadarmo?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Projíždíš přes minihru \"Vpal monstrům!\""}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "Takže se připrav na palbu."}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Dobře, začínáme!"}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Super!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Dokázal jsi to."}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Hej, vypadni odsud."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Pěkně rychle!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Co tu ještě děláš?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Řekla jsem ti, abys odsud vypadl."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Nerozumím tomu..."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "Proč tam jen tak stojíš?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Cože? Konzole?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Kámo..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Měj se."}
