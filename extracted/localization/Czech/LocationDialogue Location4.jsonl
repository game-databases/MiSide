{"category": "LocationDialogue Location4", "line_index": 0, "text": "Mito? // Player"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "Už jsi vzhůru? // Mita"}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "Jak ses sem dostala? // Player"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": "Před chvílí jsi byla hned vedle mě. // Player"}
{"category": "LocationDialogue Location4", "line_index": 4, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 5, "text": "Ne, nebyla."}
{"category": "LocationDialogue Location4", "line_index": 6, "text": "Ztuhl jsi před zrcadlem."}
{"category": "LocationDialogue Location4", "line_index": 7, "text": "Tak jsem odešla."}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "Proč jsou pokoje jinak? // Player"}
{"category": "LocationDialogue Location4", "line_index": 9, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "Přestavěla jsem to tady,"}
{"category": "LocationDialogue Location4", "line_index": 11, "text": "Abys ses tu cítil jako doma."}
{"category": "LocationDialogue Location4", "line_index": 12, "text": "Tady"}
{"category": "LocationDialogue Location4", "line_index": 13, "text": "Můžeme měnit pokoje"}
{"category": "LocationDialogue Location4", "line_index": 14, "text": "Jak jen budeme chtít."}
{"category": "LocationDialogue Location4", "line_index": 15, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 16, "text": "Nemusela jsi."}
{"category": "LocationDialogue Location4", "line_index": 17, "text": "Zvykal jsem si na to, jak byly."}
{"category": "LocationDialogue Location4", "line_index": 18, "text": "Myslím si, že se s tímto rozložením budeme cítit lépe. // Mita"}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Mita card game"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "Takže,"}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "Můžeme hrát?"}
{"category": "LocationDialogue Location4", "line_index": 22, "text": "Hra funguje takhle:"}
{"category": "LocationDialogue Location4", "line_index": 23, "text": "Tento žeton označuje typ,"}
{"category": "LocationDialogue Location4", "line_index": 24, "text": "Jako třeba zdraví."}
{"category": "LocationDialogue Location4", "line_index": 25, "text": "Každý z nás hraje jednu kartu,"}
{"category": "LocationDialogue Location4", "line_index": 26, "text": "A pokud bude tvoje karta mít vyšší"}
{"category": "LocationDialogue Location4", "line_index": 27, "text": "Číslo zdraví"}
{"category": "LocationDialogue Location4", "line_index": 28, "text": "Než moje,"}
{"category": "LocationDialogue Location4", "line_index": 29, "text": "Vyhráváš."}
{"category": "LocationDialogue Location4", "line_index": 30, "text": "Vem si karty."}
{"category": "LocationDialogue Location4", "line_index": 31, "text": "Teď jsem na řadě já."}
{"category": "LocationDialogue Location4", "line_index": 32, "text": "Super!"}
{"category": "LocationDialogue Location4", "line_index": 33, "text": "Dostala jsem pořádný karty!"}
{"category": "LocationDialogue Location4", "line_index": 34, "text": "Jdu první!"}
{"category": "LocationDialogue Location4", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 44, "text": "OK!"}
{"category": "LocationDialogue Location4", "line_index": 45, "text": "Jsi na řadě!"}
{"category": "LocationDialogue Location4", "line_index": 46, "text": "Uh-huh."}
{"category": "LocationDialogue Location4", "line_index": 47, "text": "Jsi na řadě!"}
{"category": "LocationDialogue Location4", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 49, "text": "Největší číslo zdraví vyhrává!"}
{"category": "LocationDialogue Location4", "line_index": 50, "text": "Všechno je o útoku!"}
{"category": "LocationDialogue Location4", "line_index": 51, "text": "Soustřeď se na obranu!"}
{"category": "LocationDialogue Location4", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 54, "text": "Vyhrál jsi!"}
{"category": "LocationDialogue Location4", "line_index": 55, "text": "Vyhráváš!"}
{"category": "LocationDialogue Location4", "line_index": 56, "text": "Dostal jsi mě."}
{"category": "LocationDialogue Location4", "line_index": 57, "text": "Ty..."}
{"category": "LocationDialogue Location4", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 59, "text": "Vyhrála jsem!"}
{"category": "LocationDialogue Location4", "line_index": 60, "text": "Jsem vítěz!"}
{"category": "LocationDialogue Location4", "line_index": 61, "text": "Vyhrála jsem!"}
{"category": "LocationDialogue Location4", "line_index": 62, "text": "Hah, mám tě!"}
{"category": "LocationDialogue Location4", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 64, "text": "Je to remíza."}
{"category": "LocationDialogue Location4", "line_index": 65, "text": "Obě stejně!"}
{"category": "LocationDialogue Location4", "line_index": 66, "text": "To je remíza!"}
{"category": "LocationDialogue Location4", "line_index": 67, "text": "Stejná čísla..."}
{"category": "LocationDialogue Location4", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 79, "text": "// The card game is interrupted"}
{"category": "LocationDialogue Location4", "line_index": 80, "text": "Co je to za zvuk?"}
{"category": "LocationDialogue Location4", "line_index": 81, "text": "Je to slyšet ze skříně."}
{"category": "LocationDialogue Location4", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 83, "text": "Zvuk?"}
{"category": "LocationDialogue Location4", "line_index": 84, "text": "Jaký zvuk?"}
{"category": "LocationDialogue Location4", "line_index": 85, "text": "Nic jsem neslyšela."}
{"category": "LocationDialogue Location4", "line_index": 86, "text": "Co sis myslel, že jsi slyšel?"}
{"category": "LocationDialogue Location4", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 88, "text": "Klepání, jako by tam někdo byl."}
{"category": "LocationDialogue Location4", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 90, "text": "Ale..."}
{"category": "LocationDialogue Location4", "line_index": 91, "text": "Nikdo tam není..."}
{"category": "LocationDialogue Location4", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 93, "text": "Rád bych se šel podívat."}
{"category": "LocationDialogue Location4", "line_index": 94, "text": "Trochu mě to děsí."}
{"category": "LocationDialogue Location4", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 96, "text": "Ale proč...?"}
{"category": "LocationDialogue Location4", "line_index": 97, "text": "Už zase..."}
{"category": "LocationDialogue Location4", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 105, "text": "Co je to s tebou!?"}
{"category": "LocationDialogue Location4", "line_index": 106, "text": "Je to skříň..."}
{"category": "LocationDialogue Location4", "line_index": 107, "text": "Mám tam spodní prádlo...!"}
{"category": "LocationDialogue Location4", "line_index": 108, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 109, "text": "Skrýváš přede mnou něco?"}
{"category": "LocationDialogue Location4", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 111, "text": "Proč mi nevěříš?"}
{"category": "LocationDialogue Location4", "line_index": 112, "text": "Co dělám špatně?"}
{"category": "LocationDialogue Location4", "line_index": 113, "text": "Jenom chci..."}
{"category": "LocationDialogue Location4", "line_index": 114, "text": "Chci jenom, abys byl se mnou."}
{"category": "LocationDialogue Location4", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 116, "text": "To by se mi líbilo, ale i tak...?"}
{"category": "LocationDialogue Location4", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 118, "text": "Proč seš tak upřený na tu skříň?!"}
{"category": "LocationDialogue Location4", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 120, "text": "Chci vědět, co to bylo za klepání!"}
{"category": "LocationDialogue Location4", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 122, "text": "Je to proto, že"}
{"category": "LocationDialogue Location4", "line_index": 123, "text": "Tento svět"}
{"category": "LocationDialogue Location4", "line_index": 124, "text": "Má jen tyto čtyři místnosti?"}
{"category": "LocationDialogue Location4", "line_index": 125, "text": "Nestačí ti to?"}
{"category": "LocationDialogue Location4", "line_index": 126, "text": "Proč nemůžeš být jen se mnou?"}
{"category": "LocationDialogue Location4", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 129, "text": "// Don't stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 130, "text": "Chápu to."}
{"category": "LocationDialogue Location4", "line_index": 131, "text": "Zase tohle..."}
{"category": "LocationDialogue Location4", "line_index": 132, "text": "Pokud se chceš podívat do skříně,"}
{"category": "LocationDialogue Location4", "line_index": 133, "text": "Tak to udělej,"}
{"category": "LocationDialogue Location4", "line_index": 134, "text": "A zjisti, co tam je!"}
{"category": "LocationDialogue Location4", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 139, "text": "Co se děje?"}
{"category": "LocationDialogue Location4", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 141, "text": "To se někdy stává."}
{"category": "LocationDialogue Location4", "line_index": 142, "text": "Místnost se zasekla při načítání."}
{"category": "LocationDialogue Location4", "line_index": 143, "text": "Chvilku počkej."}
{"category": "LocationDialogue Location4", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 145, "text": "To je tak zvláštní."}
{"category": "LocationDialogue Location4", "line_index": 146, "text": "Jsme snad v něčím telefonu?"}
{"category": "LocationDialogue Location4", "line_index": 147, "text": "V nějakém pomalém, kde se všechno načítá dlouho?"}
{"category": "LocationDialogue Location4", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 149, "text": "Vůbec ne."}
{"category": "LocationDialogue Location4", "line_index": 150, "text": "Ale ne všechno je dokonalé"}
{"category": "LocationDialogue Location4", "line_index": 151, "text": "V tomto světě..."}
{"category": "LocationDialogue Location4", "line_index": 152, "text": "Načítá nás"}
{"category": "LocationDialogue Location4", "line_index": 153, "text": "Jádro tohoto světa."}
{"category": "LocationDialogue Location4", "line_index": 154, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 155, "text": "Jádro světa?"}
{"category": "LocationDialogue Location4", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 157, "text": "Normálně, ne?"}
{"category": "LocationDialogue Location4", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 159, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 161, "text": "Každopádně, můžeme si"}
{"category": "LocationDialogue Location4", "line_index": 162, "text": "Zahrát hru na konzoli"}
{"category": "LocationDialogue Location4", "line_index": 163, "text": "Nebo jen karty."}
{"category": "LocationDialogue Location4", "line_index": 164, "text": "Vyber si."}
{"category": "LocationDialogue Location4", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 167, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 168, "text": "// Mita play fight"}
{"category": "LocationDialogue Location4", "line_index": 169, "text": "Chceš se prát?"}
{"category": "LocationDialogue Location4", "line_index": 170, "text": "Musíš vyhrát"}
{"category": "LocationDialogue Location4", "line_index": 171, "text": "Čtyřikrát."}
{"category": "LocationDialogue Location4", "line_index": 172, "text": "Tak do toho."}
{"category": "LocationDialogue Location4", "line_index": 173, "text": "Nejdřív ti asi"}
{"category": "LocationDialogue Location4", "line_index": 174, "text": "Budu trochu nahrávat."}
{"category": "LocationDialogue Location4", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 176, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 177, "text": "Šikulka!"}
{"category": "LocationDialogue Location4", "line_index": 178, "text": "Tak teď si drž kalhoty!"}
{"category": "LocationDialogue Location4", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 180, "text": "No teda!"}
{"category": "LocationDialogue Location4", "line_index": 181, "text": "Dobře, dobře."}
{"category": "LocationDialogue Location4", "line_index": 182, "text": "Teďka vážně."}
{"category": "LocationDialogue Location4", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 184, "text": "Podívej se na sebe!"}
{"category": "LocationDialogue Location4", "line_index": 185, "text": "Tak uvidíme,"}
{"category": "LocationDialogue Location4", "line_index": 186, "text": "Jestli mě porazíš i teď!"}
{"category": "LocationDialogue Location4", "line_index": 187, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 188, "text": "Jsi"}
{"category": "LocationDialogue Location4", "line_index": 189, "text": "Prostě"}
{"category": "LocationDialogue Location4", "line_index": 190, "text": "Neuvěřitelný! Šlo ti to skvěle!"}
{"category": "LocationDialogue Location4", "line_index": 191, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 193, "text": "No tak, co to bylo? :("}
{"category": "LocationDialogue Location4", "line_index": 194, "text": "Tohle mě nebaví."}
{"category": "LocationDialogue Location4", "line_index": 195, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 196, "text": "Dobře,"}
{"category": "LocationDialogue Location4", "line_index": 197, "text": "A máš to! Dostala jsem tě."}
{"category": "LocationDialogue Location4", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 199, "text": "No tak,"}
{"category": "LocationDialogue Location4", "line_index": 200, "text": "Dej se dohromady, jinak budeš navždycky smolař!"}
{"category": "LocationDialogue Location4", "line_index": 201, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 202, "text": "Co je to s tebou dneska?"}
{"category": "LocationDialogue Location4", "line_index": 203, "text": "Vytřela jsem s tebou podlahu."}
{"category": "LocationDialogue Location4", "line_index": 204, "text": "Nedal jsi do toho všechno..."}
{"category": "LocationDialogue Location4", "line_index": 205, "text": "Proto jsem vyhrála!"}
{"category": "LocationDialogue Location4", "line_index": 206, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 208, "text": "Tak dobře."}
{"category": "LocationDialogue Location4", "line_index": 209, "text": "Co kdybychom si zahráli karty?"}
{"category": "LocationDialogue Location4", "line_index": 210, "text": "Jsou v ložnici."}
{"category": "LocationDialogue Location4", "line_index": 211, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 214, "text": "// Door > [ERROR]"}
{"category": "LocationDialogue Location4", "line_index": 215, "text": "Co se děje?"}
{"category": "LocationDialogue Location4", "line_index": 216, "text": "Kde je..."}
{"category": "LocationDialogue Location4", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 218, "text": "Jejda."}
{"category": "LocationDialogue Location4", "line_index": 219, "text": "Omlouvám se..."}
{"category": "LocationDialogue Location4", "line_index": 220, "text": "Něco jsem si stáhla"}
{"category": "LocationDialogue Location4", "line_index": 221, "text": "Z netu."}
{"category": "LocationDialogue Location4", "line_index": 222, "text": "Chtěla jsem to venku"}
{"category": "LocationDialogue Location4", "line_index": 223, "text": "Jenom trochu zkrášlit."}
{"category": "LocationDialogue Location4", "line_index": 224, "text": "Ale vypadá to,"}
{"category": "LocationDialogue Location4", "line_index": 225, "text": "Že v souboru bylo něco špatně."}
{"category": "LocationDialogue Location4", "line_index": 226, "text": "Opravím to později."}
{"category": "LocationDialogue Location4", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 228, "text": "Proto nemůžeme opustit dům?"}
{"category": "LocationDialogue Location4", "line_index": 229, "text": "Ano, proto."}
{"category": "LocationDialogue Location4", "line_index": 230, "text": "// Mita shy"}
{"category": "LocationDialogue Location4", "line_index": 231, "text": "Hej..."}
{"category": "LocationDialogue Location4", "line_index": 232, "text": "Co je to s tebou?"}
{"category": "LocationDialogue Location4", "line_index": 233, "text": "Chceš něco?"}
{"category": "LocationDialogue Location4", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 236, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 237, "text": "// Wall Clock"}
{"category": "LocationDialogue Location4", "line_index": 238, "text": "Ty hodiny,"}
{"category": "LocationDialogue Location4", "line_index": 239, "text": "Kolik ukazují hodin?"}
{"category": "LocationDialogue Location4", "line_index": 240, "text": "Aktuální čas ve hře?"}
{"category": "LocationDialogue Location4", "line_index": 241, "text": "Nebo je to čas z mého telefonu?"}
{"category": "LocationDialogue Location4", "line_index": 242, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 243, "text": "No, ehm..."}
{"category": "LocationDialogue Location4", "line_index": 244, "text": "Já upřímně nevím."}
{"category": "LocationDialogue Location4", "line_index": 245, "text": "Ale na čase tady nezáleží..."}
{"category": "LocationDialogue Location4", "line_index": 246, "text": "Ať už pozdě nebo brzy,"}
{"category": "LocationDialogue Location4", "line_index": 247, "text": "Silná dívka jako já"}
{"category": "LocationDialogue Location4", "line_index": 248, "text": "Je vždycky plná energie."}
{"category": "LocationDialogue Location4", "line_index": 249, "text": "Nikdy se neunavím!"}
{"category": "LocationDialogue Location4", "line_index": 250, "text": "Můžeme mít věčné jaro,"}
{"category": "LocationDialogue Location4", "line_index": 251, "text": "Nebo nekončící odpoledne!"}
{"category": "LocationDialogue Location4", "line_index": 252, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 253, "text": "To je zajímavé..."}
{"category": "LocationDialogue Location4", "line_index": 254, "text": "Ale trochu děsivé."}
{"category": "LocationDialogue Location4", "line_index": 255, "text": "Uvíznutí ve stejném okamžiku, navždy..."}
{"category": "LocationDialogue Location4", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 258, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 259, "text": "// Photos of Mita"}
{"category": "LocationDialogue Location4", "line_index": 260, "text": "Hezké fotky."}
{"category": "LocationDialogue Location4", "line_index": 261, "text": "Hádám, že jsi na nich ty?"}
{"category": "LocationDialogue Location4", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 263, "text": "Ano."}
{"category": "LocationDialogue Location4", "line_index": 264, "text": "Taky se mi líbí."}
{"category": "LocationDialogue Location4", "line_index": 265, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 266, "text": "Kdo je fotil?"}
{"category": "LocationDialogue Location4", "line_index": 267, "text": "Jsou v tomto světě i jiní?"}
{"category": "LocationDialogue Location4", "line_index": 268, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 269, "text": "Dalo by se to tak říct."}
{"category": "LocationDialogue Location4", "line_index": 270, "text": "Pak tě představím."}
{"category": "LocationDialogue Location4", "line_index": 271, "text": "Ale ne teď."}
{"category": "LocationDialogue Location4", "line_index": 272, "text": "Zatím chci být jen s tebou, o samotě."}
{"category": "LocationDialogue Location4", "line_index": 273, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 275, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 276, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 277, "text": "// Portal"}
{"category": "LocationDialogue Location4", "line_index": 278, "text": "Kam se poděl ten portál?"}
{"category": "LocationDialogue Location4", "line_index": 279, "text": "Nebo jak jsi to nazvala?"}
{"category": "LocationDialogue Location4", "line_index": 280, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 281, "text": "Použila jsem"}
{"category": "LocationDialogue Location4", "line_index": 282, "text": "Trochu magie"}
{"category": "LocationDialogue Location4", "line_index": 283, "text": "A přesunula ho"}
{"category": "LocationDialogue Location4", "line_index": 284, "text": "Někam jinam."}
{"category": "LocationDialogue Location4", "line_index": 285, "text": "Už ho nepotřebujeme."}
{"category": "LocationDialogue Location4", "line_index": 286, "text": "Jen by tady překážel."}
{"category": "LocationDialogue Location4", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 288, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 289, "text": "// Mirror in the bedroom"}
{"category": "LocationDialogue Location4", "line_index": 290, "text": "Je zvláštní dívat se do zrcadla"}
{"category": "LocationDialogue Location4", "line_index": 291, "text": "A nevidět svůj odraz."}
{"category": "LocationDialogue Location4", "line_index": 292, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 293, "text": "Můžeme zapnout odrazy"}
{"category": "LocationDialogue Location4", "line_index": 294, "text": "Pokud je chceš mít."}
{"category": "LocationDialogue Location4", "line_index": 295, "text": "Ale opravdu je potřebujeme?"}
{"category": "LocationDialogue Location4", "line_index": 296, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 297, "text": "Samozřejmě, že ano."}
{"category": "LocationDialogue Location4", "line_index": 298, "text": "Nebo... to bude mít nějaké následky?"}
{"category": "LocationDialogue Location4", "line_index": 299, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 300, "text": "Ano."}
{"category": "LocationDialogue Location4", "line_index": 301, "text": "Budeme se hýbat pomalu a zadrhávat se."}
{"category": "LocationDialogue Location4", "line_index": 302, "text": "Viděl jsi někdy animák s trhavými animacemi?"}
{"category": "LocationDialogue Location4", "line_index": 303, "text": "Tak to u nás bude pořád."}
{"category": "LocationDialogue Location4", "line_index": 304, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 305, "text": "Chápu."}
{"category": "LocationDialogue Location4", "line_index": 306, "text": "Tak to bychom možná měli nechat odrazy vypnuté..."}
{"category": "LocationDialogue Location4", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 308, "text": "Hej, [player], jak se tak koukám,"}
{"category": "LocationDialogue Location4", "line_index": 309, "text": "Rád se díváš do zrcadla, co?"}
{"category": "LocationDialogue Location4", "line_index": 310, "text": "Bojíš se, že na své tváři uvidíš úsměv?"}
{"category": "LocationDialogue Location4", "line_index": 311, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 312, "text": "Cože? Ani ne..."}
{"category": "LocationDialogue Location4", "line_index": 313, "text": "Jsem jen unavený."}
{"category": "LocationDialogue Location4", "line_index": 314, "text": "Po vší té práci."}
{"category": "LocationDialogue Location4", "line_index": 315, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 316, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 317, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 318, "text": "// Blue sneakers"}
{"category": "LocationDialogue Location4", "line_index": 319, "text": "Ty jsou tvoje?"}
{"category": "LocationDialogue Location4", "line_index": 320, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 321, "text": "Nene, jsou tvoje."}
{"category": "LocationDialogue Location4", "line_index": 322, "text": "Copak si to nepamatuješ?"}
{"category": "LocationDialogue Location4", "line_index": 323, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 324, "text": "Nevzpomínám si, že bych měl takové tenisky."}
{"category": "LocationDialogue Location4", "line_index": 325, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 326, "text": "Teď už ano."}
{"category": "LocationDialogue Location4", "line_index": 327, "text": "Můžeš si je vzít"}
{"category": "LocationDialogue Location4", "line_index": 328, "text": "Až půjdeme ven."}
{"category": "LocationDialogue Location4", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 330, "text": "A co oblečení?"}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "Nemám v tomto světě"}
{"category": "LocationDialogue Location4", "line_index": 332, "text": "Jiné oblečení, než to, které mám na sobě."}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "Můžu si nějak pořídit nové?"}
{"category": "LocationDialogue Location4", "line_index": 334, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 335, "text": "Samozřejmě že ano."}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "Ale viděla jsem, co nosíš..."}
{"category": "LocationDialogue Location4", "line_index": 337, "text": "A upřímně, tvůj vkus není nic moc."}
{"category": "LocationDialogue Location4", "line_index": 338, "text": "Každopádně ti pomůžu nějaké sehnat."}
{"category": "LocationDialogue Location4", "line_index": 339, "text": "Jenom ne teď."}
{"category": "LocationDialogue Location4", "line_index": 340, "text": "Slibuji."}
{"category": "LocationDialogue Location4", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 342, "text": "Dobře."}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Games on TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "Co si chceš zahrát?"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Game milk"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "Tohle je bojová hra!"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "Uvidíme, kdo zkysne první!"}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "Jdeme na to!"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": "Mléka už bylo dost, pojďme zkusit něco jiného."}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Game penguins"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "V této hře jsi tučňák."}
{"category": "LocationDialogue Location4", "line_index": 354, "text": "A kloužeš na ledě."}
{"category": "LocationDialogue Location4", "line_index": 355, "text": "Tuhle hru jsme už hráli."}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "Cože?"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "To myslíš vážně? Já myslela, že..."}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "Mám takovou radost!"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "Ale jsem trochu zmatená..."}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "Tak..."}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "Prosím, zůstaň se mnou..."}
{"category": "LocationDialogue Location4", "line_index": 364, "text": "Navždy a napořád."}
{"category": "LocationDialogue Location4", "line_index": 365, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 367, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 368, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 369, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 370, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 372, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 373, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 374, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 375, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 376, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 377, "text": "// A game about penguins"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "Je to úplně jednoduché:"}
{"category": "LocationDialogue Location4", "line_index": 379, "text": "Sbírej sněhové koule."}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "Ten, kdo jich sesbírá víc, vyhravá!"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "Hrajeme na dvě kola, jo?"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// The first map"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "Jak si jich dokázal sebrat tolik?"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "Ha! Mám jich víc než ty!"}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "Začni se snažit! <3"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "Ha, 1:1!"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// The second map"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "Ty jsi snad tučňák od přírody!"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "Měli bychom někdy jít bruslit!"}
{"category": "LocationDialogue Location4", "line_index": 390, "text": "Pfft, ty jsi teda pomalý."}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "Pořád přemyšlíš nad posledním kolem?"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "Remíza! To je teda vzácné!"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// The game is over"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "Tak co, zkusíme jinou hru?"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "Nebo stačilo?"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "Na co to potřebuješ?"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "Máš až takovou závislost?"}
