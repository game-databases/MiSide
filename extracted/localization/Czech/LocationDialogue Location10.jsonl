{"category": "LocationDialogue Location10", "line_index": 0, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "Počkej, počkej!"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "Ztiš se..."}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "Pokračovat dál není bezpečný."}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "Mimochodem..."}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "Jak ses sem dostal?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "No..."}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "Prsten mi otevírá dveře, které potřebuji."}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "Upřímně nevím, jak to funguje."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "Prsten?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "Co se tady děje?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "Je tu strašná tma."}
{"category": "LocationDialogue Location10", "line_index": 15, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "Řeknu ti to později."}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "Teď jdi k východu."}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "Sejdeme se u herního automatu."}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Pospěš si, ať nepřijdeš pozdě!"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// After mini-game"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "Chápeš smysl té hry?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "Že já jsem z masa a kostí a ty jsi figurína?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "Páni!"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "To zní strašlivě"}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "Ale obávám se, že máš pravdu."}
{"category": "LocationDialogue Location10", "line_index": 33, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "Chápu smysl, ale k čemu mi to je?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "Říkala jsem ti snad, že jít dál"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "Je nebezpečné jen tak pro legraci?"}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "Narazíš na... figuríny..."}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "Zapomenuté a \"vadné\"."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "Jsou velmi agresivní, fakt to chceš riskovat?"}
{"category": "LocationDialogue Location10", "line_index": 41, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "Co mám teda dělat?"}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Kde se otevřou dveře,"}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "Tam se vydám."}
{"category": "LocationDialogue Location10", "line_index": 45, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "No to se teda vydáš!"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "Hlavně se k nim neotáčej zády."}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "A nespouštěj z nich oči!"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "Když se na ně podíváš, začnou se stydět tak moc,"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "Že úplně ztuhnou."}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "Snad ti to pomůže!"}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// Quest 1 (Why are there other Mitas down there?)"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "Jsou čerstvě vyrobené."}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "Potřebují čas"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "Aby získali sebeuvědomění"}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "Pak každou z nich zavedu"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "Do jejich domova."}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// Quest 2 (Why is it so dark downstairs?)"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "My Mity jsme \"stvořeny\" ve tmě,"}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "Takže v ní musíme strávit nějakou dobu."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Dokážeš si představit,"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "Jak bolestivé je přejít do světla z úplné temnoty?"}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// Quest 3 (What are you doing here?)"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "Ty to ještě nechápeš?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "Pomáhám Mitám se usadit!"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "Kdo jiný jim tady pomůže, když ne já?"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "Ty?"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// Quest 4 (Why do we need this conveyor?)"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "K čemu je tahle výrobní linka?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "Je tam pro všechny dost místa?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Počkej, neříkej mi,"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "Že nechápeš, jak funguje náš svět?"}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "A to, že je nekonečný?"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "Nekonečný?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "Hmm..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "Jak to myslíš?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "Pokud je nejnovější verze 1.9,"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "Tak existuje pouze 19 světů."}
{"category": "LocationDialogue Location10", "line_index": 91, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "Proboha, ty opravdu nevíš."}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "Vůbec nechápeš jak to tady chodí."}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Všechno ti vysvětlím"}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "Tady na té tabuli"}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "Chceš to vysvětlit?"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// Quest 5 (What is your version?)"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Mám pocit,"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "Že jsem tě viděl v nejnovější verzi."}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "Nebo se mi to jenom zdá?"}
{"category": "LocationDialogue Location10", "line_index": 102, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "No, to je dost možné."}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Jsem z verze 1.5."}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "Byl jsi v ní?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Ano byl."}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "Když jsem sem přišel poprvé,"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "Tak jsem skončil tam."}
{"category": "LocationDialogue Location10", "line_index": 110, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "Páni!"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "Ale jak...?"}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "Zajímalo by mě jaký byl index domu, ve kterém jsi byl."}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "Je tady verze mě, která neustále fňuká,"}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "Která pořád dělá vylomeniny,"}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "Se špatnou pamětí a potřebou strašit ostatní."}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "Ach, mohla bych toho jmenovat spousty..."}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Na co si vzpomínáš?"}
{"category": "LocationDialogue Location10", "line_index": 119, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Byla tma."}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "A byly tam různé nápisy"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "Jako..."}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "\"Pojď si hrát.\""}
{"category": "LocationDialogue Location10", "line_index": 124, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "Ach,"}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "Škoda..."}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "To je ta,"}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "Která straší a zapomíná."}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// Mita wants to tell you [No]"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Není třeba."}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Já se bez toho nějak obejdu."}
{"category": "LocationDialogue Location10", "line_index": 133, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "Dobře, jak chceš."}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// Mita wants to tell you [Yes]."}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "Dobře, vysvětli mi to."}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "Jen doufám, že to nebude jako ve škole"}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "A neusnu nudou."}
{"category": "LocationDialogue Location10", "line_index": 140, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "Jestli chceš, tak můžeš jít pryč."}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "Ale pokud tě to zajímá"}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "Tak poslouchej"}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "Hráč si stáhne MiSide na svůj mobil."}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "Spokojeně hraje a užívá si hru."}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "Vytvoří si tak nový domov"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "A novou Mitu."}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "Zde je nakreslená 2D reprezentace."}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "Tohle jsou verze,"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "Znázorněny jako čáry."}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "Na těchto čarách jsou domy."}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "Když si stáhneš verzi 1.14,"}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "Zrodí se nová Mita"}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "A s ní i nový dům."}
{"category": "LocationDialogue Location10", "line_index": 155, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "Hustý..."}
{"category": "LocationDialogue Location10", "line_index": 157, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Klidně se zeptej i na konkrétní věci,"}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "Které jsou na tabuli,"}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "A já se ti to pokusím vysvětlit."}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// He asks about the only circle"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "Proč je tady jenom jeden kruh?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "Tato verze byla vydána pouze jednou."}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "Už se dál nešíří."}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "Je to unikát."}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "Tyto verze jsou zvláštní tím,"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "Že nimi nelze projít."}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "V této verzi 1.1 žije Ospalá Mita."}
{"category": "LocationDialogue Location10", "line_index": 171, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "Ospalá Mita?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "Protože se jí špatně spí,"}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "Když všichni procházejí její verzí?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "Ne, tak to není."}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "Můžeš kolo ní chodit jak moc chceš,"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "Ale nemáš šanci ji vzbudit."}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// He asks about the shaded circle"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "Proč je tenhle kruh vyplněný?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "No... ten je vyplněný"}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "Kvůli Krásné Mitě."}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "Ona ten kruh vyplnila."}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "Dohadovali jsme se o tom"}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "Kdo se dostane dřiv do verze 1.11."}
{"category": "LocationDialogue Location10", "line_index": 188, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "A kdo vyhrál?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "Jasně že já!"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "My jsme teď tady."}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "Ve verzi 1.15,"}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "Index domu 809."}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "Potřebujeme se dostat do verze 1.11,"}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "Index domu 805."}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Prvně její cesta vypadala takto."}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "Snažili jsme se najít co nejkratší cestu,"}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "Takže Krásná Mita navrhla tuto cestu."}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "A pak jsem nakreslila nejjednodušší cestu."}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "Je to úplně jednoduché, že?"}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Koukej."}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "Odsud se můžeš dostat přímo k požádované verzi"}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Tenhle dům možná vypadá nepřístupně,"}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "Což by ti znemožnilo projít..."}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "Každopádně tvůj prsten funguje na stejném principu."}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "Kam tě poslali?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "K Jádru."}
{"category": "LocationDialogue Location10", "line_index": 210, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "K Jádru?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "Zajímavé..."}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Pokud tě poslali nejkratší cestou"}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "Budeš muset projít verzí 1.11."}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "Tam se určitě setkáš s Ospalou Mitou."}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Zajímalo by mě jestli Mita, která tě poslala"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "Šla stejnou cestou."}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "Nebo jestli si to neuvědomila a ty půjdeš přes jinou verzi."}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "Možná je génius,"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "A vymyslela ještě kratší cestu!"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Rozumím."}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// He asks about the inscription"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "Co je tohle?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "To je pro Cool Mitu."}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "Bude tu za pár hodin."}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "Konečně dá pryč ty krabice!"}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "A donese sem ten gauč!"}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "Už mě hrozně bolí zadek!"}
{"category": "LocationDialogue Location10", "line_index": 232, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Emm..."}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "Můžu pomoct jestli chceš."}
{"category": "LocationDialogue Location10", "line_index": 235, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "Ne, to je práce pro Cool Mitu."}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Je silná."}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// He asks about the drawings"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "Tohle je jen kresba?"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "Nebo"}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "To něco znamená?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": "// MitaShorthairs"}
