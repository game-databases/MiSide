{"category": "LocationDialogue Location15", "line_index": 0, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Tady jsi!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Proč jsi odešel z Jádra?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Řekla jsem ti, ať na mě počkáš!"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Říkal jsem si, že ti to trvá nějak dlouho..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "No, dobře..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Myslím, že jsem něco našla."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Asi je to ten index."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Uvidíme, jestli bude fungovat!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Pojďme odsud pryč."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "Šílená Mita..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Myslím, že je zaneprázdněná s jiným hráčem."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Takže doufám, že na nás nebude mít čas..."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Mito?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Počkej na mě."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": "// Mita killler"}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Upadlo ti něco?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Seznam se s ní znovu!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Mito..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Chytej!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Jak to, že..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Kdo jsi?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Ty... žiješ!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Ty si mě nepamatuješ?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Znám tě?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Ale jak to..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Co mám teď dělat?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Jak se odsud mám dostat..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "Jak to myslíš, dostat se odsud?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Počkej..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "To je ten prsten..."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "A tohle?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Netuším, co to je. :)"}
{"category": "LocationDialogue Location15", "line_index": 48, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "To je index!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Našla jsi ho!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Nevím, co na to říct."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Musíme se vrátit k Jádru."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "A ty..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Možná bys měla jít se mnou."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Cože?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Dobře..."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Počkej tady."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Mm-hmm."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Budu sedět tady."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Do prdele..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "To bylo o fous."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "Takže... zvládli jsme to?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Výborně."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Jsem ve správné verzi."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Ahoj!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Ty jsi hráč, že?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Jak se jmenuješ?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Chci odsud odejít..."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Ty už chceš odejít?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "Jak ses sem vůbec dostal?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "No nic..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Dobře, můžeš odejít..."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Jenom vyjdi dveřmi."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Hodně štěstí!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Zeď?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Hmm, něco je špatně."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Možná..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "Je ve sklepě něco, co ti pomůže."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Nedávno jsem objevila"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "Dveře v mé skříni..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Ukázalo se, že vedou do sklepa."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Ale je plný harampádí,"}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "A taky je tam nějaký zvláštní přístroj."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Chce to zadat nějaký kód nebo co..."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Moc tomu nerozumím"}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "A ani asi nechci rozumět."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "A ještě k tomu je tam tak neútulno."}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Podíváš se tam?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Uhm, dobře."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Vypadá to..."}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "Že si nic nepamatuje..."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Zvládli jsme to?"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "Restartovali jsme ji?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Pak mi zbývá jen"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "Vypadnout z téhle zatracené hry..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Ne tak rychle."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Ráda bych tě objala."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Cože?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Mita - hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Ráda jsem tě viděla."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Ach..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "Je to opravdu škoda"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "Že jsme my dva"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "Spolu strávili tak málo času."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Err..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "O čem to mluvíš?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Chci říct,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "Mohl jsi zůstat se mnou..."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "Je to všechno moje vina..."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Ta skříň a ty... zvuky."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Měla jsem ji ZABÍT dřív!"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Počkej, ale,"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "Přece jsem tě...?"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Jak to, že si to pamatuješ?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "HA!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Opravdu sis myslel, že to bude tak jednoduché?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Ty jsi trdlo..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Stejně jako všichni ostatní hráči..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Čas nám vyšel akorát, podívej!"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "Víš,"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "\"živý\""}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "Už nejsi potřeba."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Promiň, hihi."}
{"category": "LocationDialogue Location15", "line_index": 148, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Nemůžu tomu uvěřit..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Co jsme udělali špatně...?"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Ne... restartoval jsem tě, jsem si tím jistý..."}
{"category": "LocationDialogue Location15", "line_index": 152, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Pořád to nechápeš..."}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Ha-ha-ha!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Jsem tak úžasná herečka!"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Měl jsi vidět svůj obličej, zlato!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "To je taková legrace!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Proč jsi taková?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Co je to s tebou?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Jo..."}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Co je to se mnou?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "To mi hlava nebere..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Proč mi neřekneš, proč jsem taková?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Proč ze mě nikdy nebude pravá Mita?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Moje verze, ta vůbec"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "Nikdy neexistovala!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Jen stahuju z kůže tyhle naivní hlupáky,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "Schovávám se pod jejich kůží..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Není žádný způsob,"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "Jak mě restartovat!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Nevěřím tomu..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Ty..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "Oni nejsou ten problém!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "To ty bys neměla existovat!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "Už i ty..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Bolí mě, když to říkáš."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "A přece!"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Je čas, abys odešel!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Brzy se zase uvidíme!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Všichni jsou připraveni!"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "Je čas"}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "Dostat tě z konzole!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "Uvidíme se později!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Budeš moje oblíbená kazeta..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Hráč se zajímavým jménem."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "To není ono."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "To taky není ono."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Ne, špatně."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Tohle to není."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Musím najít možnost resetování postavy."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "To je špatná verze."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Ups, moje chyba."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "To není ono."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Budeme potřebovat jinou."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Něco je špatně"}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "S indexem."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Musím ten index přepsat,"}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "Není to ten správný."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Máš hlad?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Umím dobře krájet mrkev :)"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Aha, asi jsi sem"}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "Chtěl jít sám?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Proč se točíme v kruhu?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Proč se sem vracet?"}
