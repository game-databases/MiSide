{"category": "LocationDialogue Location9", "line_index": 0, "text": "// Mita Chibi"}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Hej, ty!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Čau!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Chceš vypadnout?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Tak mi pomoz najít klíč!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Kurňa! Tady klíč není!"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Samá voda..."}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "Nula, nic, prdlajz!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Mám ho!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// The usual conversation"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Myslela jsem, že budeš nižší!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "Seš celkem vysokej..."}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "Jak moje ségra!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "Tvoje sestra?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Jo, moje ségra."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Neříkej, že jsi ji ještě neviděl!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Uh... Myslím, že jsem se s ní potkal?"}
{"category": "LocationDialogue Location9", "line_index": 22, "text": "// MitaChibi"}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Tak seš blbej?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "Ehmm..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": "// MitaChibi"}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "Vypadá to, že jsi..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "To je fuk, pomoz mi už najít ten klíč!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// Next work"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Pojď sem."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Hoď to železo do pece!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Díkec!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "A teď mi podej to dřevo!"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Supr!"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Dej tomu páru!"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Hotovo! Tak..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "Tyjo, to je nádhera."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Zmáčkni ten knoflík!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Ještě chviličku..."}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "Tak a vem si ho!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "Klíč je tvůj!"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// Quest 1 (Are you Mita?)"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Jsem ChibiMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Mám tunu řádků,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "Nejjednodušší model,"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "Ale supr vlasy!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// Quest 2 (Have we seen each other yet?)"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Jsi mi to ale hlupáček!"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "Jsi docela roztomilý,"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "Hlavně když se takhle blbě ptáš."}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Zrovna když..."}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "Se teď vidíme poprvé!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Ale poslouchej..."}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Pokud si na mě někdo hraje,"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "Tak toho bude sakra litovat!"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// Quest 3 (Why are you here?)"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Copak to nechápeš?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "Tohle je kontrolní bod."}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "Zkouška tvého důvtipu!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "No tak!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Jsem tu, abych vedla beznadějné a ztracené duše jako jsi ty!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// Quest 4 (Why are you helping me?)"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "A proč ne?"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "Čím seš tak speciální, abych ti nepomohla?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "Co?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": "// MitaChibi"}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Ty hlupáčku..."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Z ničeho nic ses tu objevil!"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Nemáš tu co dělat,"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "Tak ti pomáhám!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Sbohem, hlupáčku!"}
