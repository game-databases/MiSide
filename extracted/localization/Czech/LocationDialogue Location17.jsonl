{"category": "LocationDialogue Location17", "line_index": 0, "text": "// Player thinks + Make coffee"}
{"category": "LocationDialogue Location17", "line_index": 1, "text": "Budu potřebovat něčí pomoc."}
{"category": "LocationDialogue Location17", "line_index": 2, "text": "Doufám, že zdejší Mita nekouše..."}
{"category": "LocationDialogue Location17", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 4, "text": "Proč tu ztrácím čas..."}
{"category": "LocationDialogue Location17", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 9, "text": "// Player tries to wake up MitaDreamer"}
{"category": "LocationDialogue Location17", "line_index": 10, "text": "Mito?"}
{"category": "LocationDialogue Location17", "line_index": 11, "text": "Mito, vstávej!"}
{"category": "LocationDialogue Location17", "line_index": 12, "text": "Mito!"}
{"category": "LocationDialogue Location17", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 14, "text": "Mito, budíček!"}
{"category": "LocationDialogue Location17", "line_index": 15, "text": "Potřebuji tvou pomoc."}
{"category": "LocationDialogue Location17", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 17, "text": "Kdo jsiiiii?"}
{"category": "LocationDialogue Location17", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 19, "text": "Pomoz mi s páčkami."}
{"category": "LocationDialogue Location17", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 21, "text": "Jaké páčky?"}
{"category": "LocationDialogue Location17", "line_index": 22, "text": "Nech mě spát..."}
{"category": "LocationDialogue Location17", "line_index": 23, "text": "Nebo mi přines kávu."}
{"category": "LocationDialogue Location17", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 25, "text": "Kávovar je támhle."}
{"category": "LocationDialogue Location17", "line_index": 26, "text": "Mito?"}
{"category": "LocationDialogue Location17", "line_index": 27, "text": "Mi-ito!"}
{"category": "LocationDialogue Location17", "line_index": 28, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 31, "text": "// Player gives away the coffee"}
{"category": "LocationDialogue Location17", "line_index": 32, "text": "Mito,"}
{"category": "LocationDialogue Location17", "line_index": 33, "text": "Tady máš kávu."}
{"category": "LocationDialogue Location17", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 37, "text": "// MitaDreamer exercise"}
{"category": "LocationDialogue Location17", "line_index": 38, "text": "Páčky,"}
{"category": "LocationDialogue Location17", "line_index": 39, "text": "Říkáš?"}
{"category": "LocationDialogue Location17", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 41, "text": "Ano."}
{"category": "LocationDialogue Location17", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 43, "text": "Jak víš, o nich?"}
{"category": "LocationDialogue Location17", "line_index": 44, "text": "Ale, proč se vůbec ptám..."}
{"category": "LocationDialogue Location17", "line_index": 45, "text": "Když už jsi tady,"}
{"category": "LocationDialogue Location17", "line_index": 46, "text": "Už bys toho měl vědět dost..."}
{"category": "LocationDialogue Location17", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 48, "text": "Počkej chvilku,"}
{"category": "LocationDialogue Location17", "line_index": 49, "text": "Musím si sednout."}
{"category": "LocationDialogue Location17", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 51, "text": "A?"}
{"category": "LocationDialogue Location17", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 53, "text": "Nevím, co na to říct..."}
{"category": "LocationDialogue Location17", "line_index": 54, "text": "Ale musím jít dál,"}
{"category": "LocationDialogue Location17", "line_index": 55, "text": "Následovat prsten."}
{"category": "LocationDialogue Location17", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 57, "text": "Ty máš její prsten?"}
{"category": "LocationDialogue Location17", "line_index": 58, "text": "Není divu."}
{"category": "LocationDialogue Location17", "line_index": 59, "text": "Že ses sem dostal."}
{"category": "LocationDialogue Location17", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 61, "text": "Přesně tak."}
{"category": "LocationDialogue Location17", "line_index": 62, "text": "Tak pomužeš mi?"}
{"category": "LocationDialogue Location17", "line_index": 63, "text": "S těmi páčkami?"}
{"category": "LocationDialogue Location17", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 65, "text": "Dobře."}
{"category": "LocationDialogue Location17", "line_index": 66, "text": "Pomůžu ti."}
{"category": "LocationDialogue Location17", "line_index": 67, "text": "S páčkami..."}
{"category": "LocationDialogue Location17", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 70, "text": "Mito, no tak..."}
{"category": "LocationDialogue Location17", "line_index": 71, "text": "Pojďme už."}
{"category": "LocationDialogue Location17", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 73, "text": "Uh?"}
{"category": "LocationDialogue Location17", "line_index": 74, "text": "Dobře."}
{"category": "LocationDialogue Location17", "line_index": 75, "text": "Jdeme na to."}
{"category": "LocationDialogue Location17", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 78, "text": "// MitaDreamer fall"}
{"category": "LocationDialogue Location17", "line_index": 79, "text": "Vstaň prosím."}
{"category": "LocationDialogue Location17", "line_index": 80, "text": "Jsi tak ospalá?"}
{"category": "LocationDialogue Location17", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 82, "text": "// MitaDreamer again sleep"}
{"category": "LocationDialogue Location17", "line_index": 83, "text": "Probuď se."}
{"category": "LocationDialogue Location17", "line_index": 84, "text": "Jsme tady."}
{"category": "LocationDialogue Location17", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 87, "text": "// Switches"}
{"category": "LocationDialogue Location17", "line_index": 88, "text": "Dobře,"}
{"category": "LocationDialogue Location17", "line_index": 89, "text": "Můžeme na to."}
{"category": "LocationDialogue Location17", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 91, "text": "Pojďme na to."}
{"category": "LocationDialogue Location17", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 93, "text": "Dobře."}
{"category": "LocationDialogue Location17", "line_index": 94, "text": "Začnu"}
{"category": "LocationDialogue Location17", "line_index": 95, "text": "Počítat."}
{"category": "LocationDialogue Location17", "line_index": 96, "text": "A zatáhneme je spolu."}
{"category": "LocationDialogue Location17", "line_index": 97, "text": "Dobře?"}
{"category": "LocationDialogue Location17", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 99, "text": "Hlavně zůstaň vzhůru, jo?"}
{"category": "LocationDialogue Location17", "line_index": 100, "text": "Můžeš."}
{"category": "LocationDialogue Location17", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 103, "text": "3"}
{"category": "LocationDialogue Location17", "line_index": 104, "text": "2"}
{"category": "LocationDialogue Location17", "line_index": 105, "text": "1"}
{"category": "LocationDialogue Location17", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 107, "text": "// Player lose 1"}
{"category": "LocationDialogue Location17", "line_index": 108, "text": "Nad čím přemýšlíš?"}
{"category": "LocationDialogue Location17", "line_index": 109, "text": "No tak,"}
{"category": "LocationDialogue Location17", "line_index": 110, "text": "Ještě jednou..."}
{"category": "LocationDialogue Location17", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 112, "text": "// Player lose 2"}
{"category": "LocationDialogue Location17", "line_index": 113, "text": "Ještě jeden pokus?"}
{"category": "LocationDialogue Location17", "line_index": 114, "text": "No tak,"}
{"category": "LocationDialogue Location17", "line_index": 115, "text": "Já..."}
{"category": "LocationDialogue Location17", "line_index": 116, "text": "Tady usínám..."}
{"category": "LocationDialogue Location17", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 118, "text": "// Player lose 3"}
{"category": "LocationDialogue Location17", "line_index": 119, "text": "Už skoro spím..."}
{"category": "LocationDialogue Location17", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 122, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 123, "text": "Nádhera,"}
{"category": "LocationDialogue Location17", "line_index": 124, "text": "Děkuji, Mito."}
{"category": "LocationDialogue Location17", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 126, "text": "Mm-hmm."}
{"category": "LocationDialogue Location17", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 129, "text": "Dveře..."}
{"category": "LocationDialogue Location17", "line_index": 130, "text": "Jak..."}
{"category": "LocationDialogue Location17", "line_index": 131, "text": "Pomalé..."}
{"category": "LocationDialogue Location17", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 134, "text": "Jdu spát..."}
{"category": "LocationDialogue Location17", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 136, "text": "// Why kitchen?"}
{"category": "LocationDialogue Location17", "line_index": 137, "text": "Proč jsme v kuchyni?"}
{"category": "LocationDialogue Location17", "line_index": 138, "text": "Jestli usnu na studené podlaze,"}
{"category": "LocationDialogue Location17", "line_index": 139, "text": "Můžeš za to ty."}
{"category": "LocationDialogue Location17", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 141, "text": "// Why bathroom?"}
{"category": "LocationDialogue Location17", "line_index": 142, "text": "Nechápu to..."}
{"category": "LocationDialogue Location17", "line_index": 143, "text": "S jakými páčkami jsi potřeboval pomoc?"}
{"category": "LocationDialogue Location17", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 145, "text": "// Put button"}
{"category": "LocationDialogue Location17", "line_index": 146, "text": "Nic se nestalo?"}
{"category": "LocationDialogue Location17", "line_index": 147, "text": "Tak k čemu je to tlačítko?"}
{"category": "LocationDialogue Location17", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 149, "text": "// Cofee"}
{"category": "LocationDialogue Location17", "line_index": 150, "text": "Ještě trochu kávy?"}
{"category": "LocationDialogue Location17", "line_index": 151, "text": "Nebo zase usneš."}
{"category": "LocationDialogue Location17", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 153, "text": "Cože?"}
{"category": "LocationDialogue Location17", "line_index": 154, "text": "Neee..."}
{"category": "LocationDialogue Location17", "line_index": 155, "text": "Ta káva chutná hrozně..."}
{"category": "LocationDialogue Location17", "line_index": 156, "text": "Jsem úplně v pohodě..."}
{"category": "LocationDialogue Location17", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 158, "text": "// Button"}
{"category": "LocationDialogue Location17", "line_index": 159, "text": "Mito? To tlačítko nefunguje... Slyšíš mě?"}
{"category": "LocationDialogue Location17", "line_index": 160, "text": "Haló?"}
