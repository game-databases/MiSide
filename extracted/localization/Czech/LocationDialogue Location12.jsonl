{"category": "LocationDialogue Location12", "line_index": 0, "text": "// Mita"}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Zůstaň tady."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Asi mi něco upadlo. Hned jsem zpátky."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "Pak půjdeme do jiného zbrusu nového světa."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": "// MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Dobře."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": "// MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Pojďme si hrát!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Chci svého medvídka!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "Ztratila jsem ho..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "Najdi ho!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": "// MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Ahoj..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "Na co se tak díváš?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Quest 1 (Who are you?)"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Jsem Mita."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "Nejlepší Mita."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "První Mita."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "Říkala to Mita, moje Mita."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Quest 2 (Why do you look like that?)"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "Jak vypadám?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "Jak vypadám?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "Jak vypadám?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "Moje Mita říká, že jsem krásná a originální."}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "Tak vypadám."}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Quest 3 (What was Mita doing here?)"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Odvede mě pryč."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Budeme žít v novém světě."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "Moje Mita mě pozvala."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Vezme mě s sebou. Budeme si hrát."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Quest 4 (Why do you need a teddy bear?)"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "Ty jsi medvídek,"}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "Jsi ztracený,"}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "Jako můj medvídek."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Quest 5 (Why is Mita angry?)"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "Moje..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "Mita."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Chce si hrát."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Chce vzít"}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "Jenom mě."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Jsme originální,"}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "Jsme jediní."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Mita a moje Mita,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0,8A a 8Ě54*."}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Quest 6 (Do you believe Mita?)"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "Moje Mita..."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "Moje nejlepší kamarádka..."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "Moje Mita."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "Můj jediný přítel."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "Jsi to ty!"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Dívej."}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Pojďme si hrát!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Ukážu ti, jak na to."}
