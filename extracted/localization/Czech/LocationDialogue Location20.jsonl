{"category": "LocationDialogue Location20", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Milo! Ne! Ty jsi šílená!"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Ha ha! CO TO VIDÍM?"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "Máš na tváři nový výraz?"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "No tak, ukaž mi další!"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "Dívat se na ten samý obličej je nuda!"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\""}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "Jak to jde, můj neposedný poutníčku?"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "Pořád ještě běháš? Ještě nemáš dost?"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Co jsi Mile udělala?"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": "// Mita"}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "Aha, takže ještě nejsi unavený!"}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Výborně! Zahrajeme si další hru!"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "Ty..."}
{"category": "LocationDialogue Location20", "line_index": 18, "text": "// Mita"}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "Začneme malou zkouškou!"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "Vyzkoušíme tvojí koordinaci!"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "Otestujeme tvé chovaní!"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "Co když s tebou něco není v pořádku?"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "Co když si ani nezasloužíš tu KŮŽI"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "Kterou tak hrdě nosíš!?"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "Podívej se..."}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "Který ti padnul do oka?"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "Ten pravý?"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "Nebo"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "Levý?"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "Vážně?"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "Záleží na tom vůbec?"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "Jen si z tebe utahuju!"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "Pobodání nejsou žádná novinka."}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "Ale nevadí."}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "Mám mnohem zajímavější nápady,"}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "Jako třeba..."}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "Podívej, com mám!"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Potřebujeme nějakou muziku!"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "Jak se ti líbí tahle melodie?"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "Rozproudila mi krev v žilách!"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "Začnu"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "S pravidly!"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rules"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "Když melodie hraje,"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "Můžeš se hýbat."}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "Když melodie přestane,"}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "NEHÝBEJ SE!"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "Jinak zemřeš, chápeš?"}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "Je to jednoduché: dostaň se až na konec"}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "Než píseň skončí."}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "Jdme na to!"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "Na co čekáš?"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Utíkej, zlato, utíkej!"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder - Mita"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "Aha!"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Podívej se na sebe! Tak poslušný!"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Úžasný exemplář."}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Chci tě mít pro sebe!"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "To bylo moc jednoduché, že jo?"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "Nech mě jít!"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": "// Mita"}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "Nezvykej si tu!"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "Máme před sebou ještě spoustu her!"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "Tady je další:"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Zavřu oči..."}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "A až je otevřu,"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "Ať už jsi pryč!"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "Rozumíš?"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "Jestli tě uvidím, potrestám tě!"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Dobře! Začneme!"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "Tohle je zbytečné..."}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide - Mita"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "Dokázal jsi to!"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Vedeš si skvěle! Začíná to být vzrušující!"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "Teď to ale bude těžší."}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "Mhonem, mnohem těžší."}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Schovej se, utíkej, otáčej se..."}
{"category": "LocationDialogue Location20", "line_index": 87, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "Jdi k čertu!"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Player falls - Player"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "Myslím, že je po všem..."}
