{"category": "LocationDialogue Location8", "line_index": 0, "text": "// The first meeting"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "Kdo jsi?"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "Co se děje?"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "Ty nemůžeš mluvit?"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "Počkej..."}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "Ty chceš odejít, že ano?"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "Ano..."}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "Musím se vrátit"}
{"category": "LocationDialogue Location8", "line_index": 11, "text": "Do předchozí verze."}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "Předchozí verze?"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "Proč odcházíš a jdeš"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "Někam jinam?"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "Proč nezůstaneš tady"}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "A nebudeš můj"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "Druhý kamarád?"}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Skipping all dialogs"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "Dobře..."}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Standing by the window (Random)"}
{"category": "LocationDialogue Location8", "line_index": 24, "text": "Dveřmi cestu ven nenajdeš."}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "Vypadá to, že spěcháš..."}
{"category": "LocationDialogue Location8", "line_index": 26, "text": "Běhání v kruhu tě nezachrání."}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "Tak moc toužíš utéct?"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "Podívej se z oken..."}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Aren't you Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "Hráč... ty jsi hráč, že?"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": "Můžeme si hrát spolu."}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "Pokud na to budu mít sílu,"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": "Stačí, když si budeme hrát."}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (What happened to you?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "Nejsem si jistá a vlastně ani nevím..."}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "Nemyslím si, že se stalo něco špatného..."}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "Ale všechno dobré jako by se vytrácelo..."}
{"category": "LocationDialogue Location8", "line_index": 41, "text": "Ale hlavně, že mám kamaráda."}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "Proč mě opustili?"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "Copak jsem jim nestačila?"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "Mám strach..."}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Quest 3 (Become a second friend?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "Kamarádi..."}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "Už mi jich zbylo tak málo."}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "Zůstal jen jeden..."}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "Jsem smutná, hráči."}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "Budeš můj kamarád?"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "Rád bych,"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "Ale musím jít dál..."}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "Bolí mě srdce..."}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Is this your house?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "Domov?"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "Hráči... změnil ses..."}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "Máš kratší ruce a nevypadáš tak naštvaně..."}
{"category": "LocationDialogue Location8", "line_index": 62, "text": "Hráči, změknul jsi, jsi laskavější."}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "Nejsem si jistý..."}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "Co to znamená."}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "To nic..."}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "Teď už mě to nebude bolet, že ne?"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (How do I leave this place?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "Opravdu mě opouštíš?"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "Je to snad můj..."}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "Osud?"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "Já..."}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": "Dveře ti nepomůžou."}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Hold player (Random)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "Proč odcházíš?"}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "Zůstaň tady..."}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "Hraj si se mnou..."}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "Hráči..."}
