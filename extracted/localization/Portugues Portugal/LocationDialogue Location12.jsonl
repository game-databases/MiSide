{"category": "LocationDialogue Location12", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Fica aqui."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Acho que deixei cair alguma coisa. Eu já volto."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "Depois vamos para outro mundo..."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Okay."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Vamos jogar!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Eu quero o meu ursinho!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "Perdi-o..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "ENCONTRA-O!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Ei..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "Estás a olhar para o quê?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Missão 1 (Quem és tu?)"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Sou a Mita."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "A melhor Mita."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "A primeira Mita."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "Foi o que a Mita disse, a minha Mita."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Missão 2 (Porque é que pareces assim?)"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "Pareço-me como?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "Pareço-me como?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "Pareço-me como?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "A minha Mita diz que sou linda e original."}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "Sou eu!"}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Missão 3 (O que é que a Mita estava a fazer aqui?)"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Ela vai levar-me."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Vamos viver num mundo novo."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "A minha Mita convidou-me."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Ela vai levar-me. E vamos brincar."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Missão 4 (Porque é que precisas de um ursinho de peluche?)"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "És um ursinho fofinho,"}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "e estás perdido,"}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "tal como o meu ursinho de peluche."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Missão 5 (Porque é que a Mita está zangada?)"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "A minha..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "Mita."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Ela quer brincar."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Ela só me quer a"}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "mim."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Somos únicas,"}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "as únicas."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "A Mita e a minha Mita,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0.8A e 8Ì54*."}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Missão 6 (Acreditas na Mita?)"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "A minha Mita."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "A minha melhor amiga."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "A minha Mita."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "A minha única amiga."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "És tu!"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Ei."}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Vamos jogar!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Vou mostrar-te como."}
