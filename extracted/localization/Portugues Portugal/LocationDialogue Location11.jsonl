{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Olá!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Ops!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Desculpa,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "quase te matei."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Hum..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "O frigorífico, quero dizer...  o frigorífico quase te matou."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Eu não tive nada a ver com isso,"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "juro!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Juro mesmo!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Claro, acredito em ti!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Mas a sério,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "este lugar é perigoso..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "principalmente para ti."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// Após algum tempo 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "És tudo menos covarde, não é!"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Ver-te"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "a passar por"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "estes lugares é divertido..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Corre, cavalinho, corre!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "Vou apanhar-te!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Isso mesmo!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Uau, isto é divertido!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// Após algum tempo 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Vi-te a ir em direção ao elétrico."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "Esse é o caminho mais longo"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "entre as versões..."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Pergunto-me como vais lidar"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "com os que vivem lá"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "naquela névoa."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Roupa interior"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "O que pensas que estás a fazer?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Por favor..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Não olhes!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Tolo!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Cabeça de vento..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Hum, está bem..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Parte uma perna!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Quem está aí?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Eu consigo sentir-te..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Ouve,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "és um jogador,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "não és?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Ajuda-me a encontrar..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "encontrar um..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "Deixa-me pensar..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "a minha mente está em branco..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "O que está a acontecer aqui?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Chorar 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Eu queria esquecer tudo de uma vez..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Parti todos os espelhos,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "estraguei as fotos..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "mas agora..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "tudo o que sinto é arrependimento."}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "Que estúpida fui..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Toda a gente comete erros, claro..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Mas o que fazes"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "quando as consequências são catastróficas?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Queria poder voltar atrás no tempo..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Chorar 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Dizem que o tempo cura todas as feridas..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Mas o que é o tempo?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Já não acredito em nada..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Mas se o tempo pode curar,"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "ou ao menos levar-me,"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "levar-me para longe deste mundo..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "Então, peço-te, por favor,"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "acelera o tempo."}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "Para que o tempo me mate"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "de uma vez por todas."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Chorar 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Ela é amada..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Eu também amei, uma vez?"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Mas o meu amor é diferente;"}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "o amor dela é vibrante,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "desprezível..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "ardente..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "implacável..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "invejoso..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "furioso..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "louco..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Chorar 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Chamavam-me sensível..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "Preocupas-te demasiado, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "Vais ultrapassar isto, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "Não estás sozinha, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Diziam eles. Mas o que resta?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Tristeza,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "desespero..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "e medo."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Chorar 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Inútil..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Não me lembro..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "De nada..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Só os ecos infinitos..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Não consigo lidar com o facto"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "de estar presa aqui..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Sempre estive aqui,"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "mas porquê?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Não me lembro..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Algum dia vai acabar?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Não sei..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita encontra a imagem"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Isto é..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "um desenho..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Agora lembro-me,"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "obrigada..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Mas o meu rosto..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "Eu não tenho rosto..."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "Tudo é ELA."}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Ela tirou um pedaço de mim..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "atirou-o fora..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Ela é forte..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "e inteligente."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Não tenho direito de te parar, jogador."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Vê o guarda-roupa..."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Ei!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Estás no meu caminho!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Vais ficar aí parado?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Sai da frente!"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Deixa-me passar!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Só porque és grande, não quer dizer que és todo-poderoso!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// EI! PÁRA!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Porque é que me estás a seguir!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Baza daqui!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - voz do rádio"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Espera aí... Jogador?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "O que estás a fazer aqui?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Quem está aí?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Outro jogador."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Sou a Mitafone."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Estou aqui a controlar o elétrico."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Percebes que"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "estás a caminho do teu fim, não é?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Talvez,"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "mas é o único caminho que tenho."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Sim, tens razão."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Pressiona o botão e fica atrás do canhão."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "O canhão?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Uh-huh."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Pensaste que ias passar assim, sem mais nem menos?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Tens que passar neste mini-jogo de Monster-slap,"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "então prepara-te para disparar."}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular vai"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Certo, hora de partir."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular vence"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Incrível!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Conseguiste."}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular pára"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Ei, tens que sair daqui."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Rápido!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular espera 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "O que é que ainda estás a fazer aqui?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Disse-te para saíres daqui."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular espera 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Não entendo..."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "Porque é que estás aí parado?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular Tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "O quê? Uma consola?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Mano..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular adeus"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Adeus."}
