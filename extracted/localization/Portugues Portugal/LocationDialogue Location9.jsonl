{"category": "LocationDialogue Location9", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Ei, tu!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Olá!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Queres sair?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Então ajuda-me a encontrar a chave!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Procura pela chave"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Merda! A chave desapareceu!"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Nada aqui—"}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "zero, bolinha, nada!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Encontrei-a!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// A conversa habitual"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Huh, pensei que fosses mais baixo!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "És alto—"}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "tal como a minha irmã!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "A tua irmã? Que é feito dela?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Sim, a minha irmã."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Não me digas que nunca a conheceste!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Uh... Eu conheci-a... acho?"}
{"category": "LocationDialogue Location9", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "És tolinho?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "Erm..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "Parece que és..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "Vamos lá, ajuda-me a encontrar a chave!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// Próximo trabalho"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Vem."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Põe o ferro dentro do tubo!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Obrigada!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "Agora traz-me aquela madeira!"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Obrigada!"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Uma mãozinha, por favor!"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Tudo em  ordem! Agora..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "uau, isto está lindo."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Carrega, anda!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Prepara-te..."}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "aí está, toma!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "A chave é tua!"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// Missão 1 (És Mita?)"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Sou a ChibiMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Milhares de linhas,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "modelos mais simples e—"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "o melhor de tudo—cabelos lindos!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// Missão 2 (Já nos vimos?)"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Tontinho!"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "Até és fofo, sabes,"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "a perguntar coisas tontinhas como essa."}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Embora,"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "esta seja a minha primeira vez a conhecer-te!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Mas olha..."}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Se roubas o meu visual maravilhoso,"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "vais-te arrepender!"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// Missão 3 (Porque estás aqui?)"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Não percebes?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "Isto é um ponto de controlo—"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "um teste à tua inteligência!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "Agora anda!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Estou aqui para guiar os irremediavelmente perdidos!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// Missão 4 (Porque me estás a ajudar?)"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "O que te torna tão especial?"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "Porque não ajudar-te de qualquer forma?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "O quê?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Tão tolo..."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Apareceste do nada!"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Não devias estar aqui,"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "por isso, estou a ajudar-te!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Adeusinho, tontinho!"}
