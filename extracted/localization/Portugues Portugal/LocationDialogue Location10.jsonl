{"category": "LocationDialogue Location10", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "Espera, espera!"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "Não grites tão alto..."}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "Ir mais longe é perigoso."}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "A propósito..."}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "como é que vieste parar aqui?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "Hum..."}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "O anel abre as portas certas."}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "Honestamente, não sei como funciona."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "O anel?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "O que se passa com este lugar?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "Está super escuro."}
{"category": "LocationDialogue Location10", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "Vou contar-te mais tarde."}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "Por agora, segue em direção à saída."}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "Encontra-me junto à máquina de arcade."}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Apressa-te, não te atrases!"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// Após mini-jogo"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "Então, percebeste o objetivo do jogo?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "Que eu sou feito de carne e osso, e tu és feita de um modelo de exoesqueleto?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "Credo!"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "Soa assustador quando o dizes assim."}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "Mas é isso, basicamente."}
{"category": "LocationDialogue Location10", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "Certo, mas porque é que eu preciso de entender isso?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "Achaste que eu te estava a dizer que ir mais longe"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "era perigoso, só para me divertir?"}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "Vais encontrar... modelos abandonadas..."}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "Aquelas que foram deixadas para trás, as \"falhadas\"."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "Elas são agressivas e podem até tentar matar-te."}
{"category": "LocationDialogue Location10", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "Então, o que devo fazer?"}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Devo simplesmente entrar"}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "onde uma porta se abrir."}
{"category": "LocationDialogue Location10", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "Bem,"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "Então não lhes vires as costas."}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "E não as percas de vista!"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "Elas ficam tímidas quando as olhas nos olhos,"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "tão tímidas que ficam paralisadas."}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "Lembra-te disso!"}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// Missão 1 (Porque há outras Mitas lá embaixo?)"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "Elas são recém-criadas."}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "Precisam de tempo"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "para ganhar consciência própria."}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "Depois, eu guio cada uma"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "para a sua própria casa."}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// Missão 2 (Porque está tão escuro lá embaixo?)"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "Nós, Mitas, somos 'criadas' no escuro,"}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "por isso precisamos de ficar lá por um tempo."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Imagina"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "a dor de sair da escuridão e ir diretamente para a luz..."}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// Missão 3 (O que estás a fazer aqui?)"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "Ainda não percebeste?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "Estou a ajudar as novas Mitas a instalarem-se!"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "Quem as vai ajudar se não for eu?"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "Tu?"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// Missão 4 (Porque precisamos desta esteira?)"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "Para que serve esta esteira rolante?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "Há espaço suficiente para todas?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Espera, não me digas que não"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "percebes como o mundo funciona..."}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "E que é infinito?"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "Infinito?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "Hum..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "O que queres dizer com isso?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "Se a versão 1.9 é a mais recente,"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "então só há 19 mundos."}
{"category": "LocationDialogue Location10", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "Meu Deus, realmente não"}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "percebes como este mundo funciona."}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Olha, vou usar este quadro"}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "para te explicar tudo."}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "Queres ouvir?"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// Missão 5 (Qual é a tua versão?)"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Espera,"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "não te encontrei na versão mais recente?"}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "Ou talvez seja só a minha imaginação."}
{"category": "LocationDialogue Location10", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "Bem, é bem possível."}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Sou da versão 1.5."}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "Já lá foste?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Eu fui."}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "Foi onde fui parar"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "quando fui atirado para este mundo!"}
{"category": "LocationDialogue Location10", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "Uau!"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "Mas como...?"}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "Mas em que índice de casa estavas?"}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "Há um 'eu' que não para de se queixar,"}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "um 'eu' que adora fazer palhaçadas,"}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "um 'eu' com memória fraca e que gosta de maltratar os outros..."}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "A lista é longa..."}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Diz-me do que te recordas."}
{"category": "LocationDialogue Location10", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Estava escuro."}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "Estava escrito"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "tipo..."}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "\"Joga comigo.\""}
{"category": "LocationDialogue Location10", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "Ah,"}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "que chatice..."}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "Esse é o 'eu'"}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "que maltrata e esquece as coisas."}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// Mita quer contar-te [Não]"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Obrigado, mas não."}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Vou-me desenrascar sem saber mais."}
{"category": "LocationDialogue Location10", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "Está bem, como queiras."}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// Mita quer contar-te [Sim]."}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "Claro, força nisso."}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "Só espero que isto não seja como o secundário,"}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "em que eu adormecia sempre de tanto aborrecimento."}
{"category": "LocationDialogue Location10", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "Podes ir embora quando quiseres,"}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "ou ficar e ouvir"}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "se tiveres interesse."}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "Um jogador descarrega o MiSide"}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "e joga o quanto quiser."}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "Lá, ele cria uma nova casa"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "e uma nova Mita."}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "Esta é uma representação 2D."}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "Estas são as versões,"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "mostradas como linhas."}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "As casas são colocadas nessas linhas."}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "Digamos que descarregues a versão 1.14,"}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "o que significa uma nova vida,"}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "uma nova Mita e uma nova casa."}
{"category": "LocationDialogue Location10", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "Meu Deus..."}
{"category": "LocationDialogue Location10", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Podes perguntar sobre os detalhes"}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "nesta imagem,"}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "e farei o meu melhor para explicar."}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// Ele pergunta sobre o único círculo"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "Porque há um único círculo?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "Essa versão foi lançada apenas uma vez,"}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "nunca mais será repetida."}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "É a única versão verdadeiramente única."}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "Além disso, estas versões são especiais"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "e não têm caminhos para outras versões."}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "A Mita Sonolenta reside nesta versão, 1.1."}
{"category": "LocationDialogue Location10", "line_index": 171, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "Mita Sonolenta?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "Porque ela nunca consegue dormir"}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "com todos a passar pela sua versão?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "Não, não é isso."}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "Podes passar por ela e fazer barulho,"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "mas é impossível acordá-la."}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// Ele pergunta sobre o círculo sombreado"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "Porque é que este círculo está todo escuro?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "Hum, esse está aqui"}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "por causa da Mita Bonita."}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "Ela desenhou-o."}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "Estávamos a discutir sobre"}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "quem chegava mais rápido à versão 1.11."}
{"category": "LocationDialogue Location10", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "Então, quem ganhou?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "EU, claro!"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "Olha, estamos aqui"}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "na versão 1.15,"}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "índice de casa 809."}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "Precisamos de chegar à versão 1.11,"}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "índice de casa 805."}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Então, o caminho dela começou assim."}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "Tentámos arranjar um caminho mais curto,"}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "por isso a Mita Bonita sugeriu este caminho."}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "E depois eu desenhei o mais simples, aqui."}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "Fácil, não é?"}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Olha aqui."}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "Daqui, podes ir diretamente para a versão correta."}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Embora pareça que esta casa está no caminho,"}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "que bloqueia o teu caminho..."}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "De qualquer forma, o teu anel funciona com os mesmos princípios."}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "Para onde estás a ir?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "O Núcleo."}
{"category": "LocationDialogue Location10", "line_index": 210, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "O Núcleo?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "Hmm..."}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Se queres o caminho mais curto,"}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "também precisas passar pela versão 1.11."}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "Com certeza vais encontrar a Mita Sonolenta lá."}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Acho que a Mita que te enviou,"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "seguiu o mesmo caminho."}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "Ou talvez ela ainda não tenha percebido que estás num caminho diferente."}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "Ou talvez seja uma génia"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "e tenha encontrado um caminho ainda mais curto!"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Acho que estou a perceber."}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// Ele pergunta sobre a inscrição"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "O que significa isto?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "Isso é para a Mita Fixe."}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "Ela vai estar aqui dentro de algumas horas."}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "Vai mover essas caixas"}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "e pôr um sofá aqui."}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "O meu traseiro dói!"}
{"category": "LocationDialogue Location10", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Hum..."}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "Talvez eu possa ajudar?"}
{"category": "LocationDialogue Location10", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "Não, isso é o trabalho da Mita Fixe."}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Ela é forte."}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// Ele pergunta sobre os desenhos"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "Isto é só um desenho,"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "ou"}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "significa algo?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 244, "text": "Sim,"}
{"category": "LocationDialogue Location10", "line_index": 245, "text": "é só um rabisco."}
