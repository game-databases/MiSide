{"category": "LocationDialogue Location3", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 1, "text": "Olá, [player]!"}
{"category": "LocationDialogue Location3", "line_index": 2, "text": "Finalmente encontramo-nos!"}
{"category": "LocationDialogue Location3", "line_index": 3, "text": "Estou tão entusiasmada!"}
{"category": "LocationDialogue Location3", "line_index": 4, "text": "Sei que tens perguntas..."}
{"category": "LocationDialogue Location3", "line_index": 5, "text": "Bem, como podes ver,"}
{"category": "LocationDialogue Location3", "line_index": 6, "text": "criei este dispositivo especial"}
{"category": "LocationDialogue Location3", "line_index": 7, "text": "para trazer-te para ao pé de mim."}
{"category": "LocationDialogue Location3", "line_index": 8, "text": "Mas acabaste noutra versão do jogo..."}
{"category": "LocationDialogue Location3", "line_index": 9, "text": "Na qual eu..."}
{"category": "LocationDialogue Location3", "line_index": 10, "text": "Mas isso é uma longa história!"}
{"category": "LocationDialogue Location3", "line_index": 11, "text": "De qualquer forma, estou apenas feliz por te ver!"}
{"category": "LocationDialogue Location3", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 13, "text": "// Resposta 1 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 14, "text": "Eu sou."}
{"category": "LocationDialogue Location3", "line_index": 15, "text": "E tu deves ser [player], certo?"}
{"category": "LocationDialogue Location3", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 17, "text": "// Resposta 2 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 18, "text": "Voltar já?"}
{"category": "LocationDialogue Location3", "line_index": 19, "text": "Acho que posso ajudar-te com isso... Mas e eu?"}
{"category": "LocationDialogue Location3", "line_index": 20, "text": "Por favor, fica comigo um pouco..."}
{"category": "LocationDialogue Location3", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 22, "text": "// Resposta 3 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 23, "text": "Deixa-me explicar..."}
{"category": "LocationDialogue Location3", "line_index": 24, "text": "E aqui estás tu!"}
{"category": "LocationDialogue Location3", "line_index": 25, "text": "Percebeste?"}
{"category": "LocationDialogue Location3", "line_index": 26, "text": "Uhm... na verdade, não."}
{"category": "LocationDialogue Location3", "line_index": 27, "text": "Está bem!"}
{"category": "LocationDialogue Location3", "line_index": 28, "text": "O importante é que estamos juntos agora."}
{"category": "LocationDialogue Location3", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 31, "text": "Estás com fome?"}
{"category": "LocationDialogue Location3", "line_index": 32, "text": "Que tal cozinharmos algo?"}
{"category": "LocationDialogue Location3", "line_index": 33, "text": "Aqui,"}
{"category": "LocationDialogue Location3", "line_index": 34, "text": "ajuda-me com estas cenouras."}
{"category": "LocationDialogue Location3", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 36, "text": "De onde vieram os vegetais?"}
{"category": "LocationDialogue Location3", "line_index": 37, "text": "Eles não estavam aqui há pouco."}
{"category": "LocationDialogue Location3", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 39, "text": "[player], estamos num jogo."}
{"category": "LocationDialogue Location3", "line_index": 40, "text": "Anda lá, dá-me uma mãozinha."}
{"category": "LocationDialogue Location3", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 42, "text": "Obrigada!"}
{"category": "LocationDialogue Location3", "line_index": 43, "text": "Podes ir buscar a tesoura?"}
{"category": "LocationDialogue Location3", "line_index": 44, "text": "Está na casa de banho."}
{"category": "LocationDialogue Location3", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 46, "text": "Agora, senta-te."}
{"category": "LocationDialogue Location3", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 49, "text": "// Cozinha"}
{"category": "LocationDialogue Location3", "line_index": 50, "text": "Gostarias de molho?"}
{"category": "LocationDialogue Location3", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 52, "text": "Não, obrigado."}
{"category": "LocationDialogue Location3", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 54, "text": "Que pena."}
{"category": "LocationDialogue Location3", "line_index": 55, "text": "O molho realça mesmo o sabor!"}
{"category": "LocationDialogue Location3", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 58, "text": "Obrigado."}
{"category": "LocationDialogue Location3", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 60, "text": "Já acabaste tudo?"}
{"category": "LocationDialogue Location3", "line_index": 61, "text": "Huh, a minha porção parece"}
{"category": "LocationDialogue Location3", "line_index": 62, "text": "infinita..."}
{"category": "LocationDialogue Location3", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 65, "text": "// Ajuda"}
{"category": "LocationDialogue Location3", "line_index": 66, "text": "O que se passa?"}
{"category": "LocationDialogue Location3", "line_index": 67, "text": "Diz-me o que vês e sentes."}
{"category": "LocationDialogue Location3", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 69, "text": "O meu coração está a acelerar,"}
{"category": "LocationDialogue Location3", "line_index": 70, "text": "e a minha visão está turva."}
{"category": "LocationDialogue Location3", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 72, "text": "Certo."}
{"category": "LocationDialogue Location3", "line_index": 73, "text": "Acho que sei o que é que se passa."}
{"category": "LocationDialogue Location3", "line_index": 74, "text": "Consegues levantar-te?"}
{"category": "LocationDialogue Location3", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 78, "text": "O que é isto?"}
{"category": "LocationDialogue Location3", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 80, "text": "Comprimidos."}
{"category": "LocationDialogue Location3", "line_index": 81, "text": "Eles vão fazer-te sentir melhor rapidamente."}
{"category": "LocationDialogue Location3", "line_index": 82, "text": "Vai até ao espelho."}
{"category": "LocationDialogue Location3", "line_index": 83, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 84, "text": "Toma os comprimidos."}
{"category": "LocationDialogue Location3", "line_index": 85, "text": "Vá lá."}
{"category": "LocationDialogue Location3", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 89, "text": "Como te sentes?"}
{"category": "LocationDialogue Location3", "line_index": 90, "text": "Melhor?"}
{"category": "LocationDialogue Location3", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 92, "text": "Sim."}
{"category": "LocationDialogue Location3", "line_index": 93, "text": "Funcionou rapidamente..."}
{"category": "LocationDialogue Location3", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 95, "text": "[player], estamos num jogo."}
{"category": "LocationDialogue Location3", "line_index": 96, "text": "As coisas aqui são muito mais simples."}
{"category": "LocationDialogue Location3", "line_index": 97, "text": "Até o menor esforço"}
{"category": "LocationDialogue Location3", "line_index": 98, "text": "traz grandes resultados."}
{"category": "LocationDialogue Location3", "line_index": 99, "text": "Faz parte do conceito do jogo"}
{"category": "LocationDialogue Location3", "line_index": 100, "text": "Simplificação."}
{"category": "LocationDialogue Location3", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 102, "text": "Um exemplo, por favor?"}
{"category": "LocationDialogue Location3", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 104, "text": "Bem, olha para as cenouras."}
{"category": "LocationDialogue Location3", "line_index": 105, "text": "Cortas uma,"}
{"category": "LocationDialogue Location3", "line_index": 106, "text": "mas é como se tivesses cortado três."}
{"category": "LocationDialogue Location3", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 108, "text": "Olha, isto é tudo muito repentino."}
{"category": "LocationDialogue Location3", "line_index": 109, "text": "Estou assustado, e não é pouco."}
{"category": "LocationDialogue Location3", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 112, "text": "O que se passa?"}
{"category": "LocationDialogue Location3", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 114, "text": "Encontrei cartuchos na ventilação."}
{"category": "LocationDialogue Location3", "line_index": 115, "text": "Havia nomes neles."}
{"category": "LocationDialogue Location3", "line_index": 116, "text": "E o que é que tem?"}
{"category": "LocationDialogue Location3", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 118, "text": "Cartuchos?"}
{"category": "LocationDialogue Location3", "line_index": 119, "text": "Que cartuchos?"}
{"category": "LocationDialogue Location3", "line_index": 120, "text": "Vamos descobrir isso juntos."}
{"category": "LocationDialogue Location3", "line_index": 121, "text": "Mas mais tarde."}
{"category": "LocationDialogue Location3", "line_index": 122, "text": "Agora, temos de comer."}
{"category": "LocationDialogue Location3", "line_index": 123, "text": "Passa-me a tesoura, por favor."}
{"category": "LocationDialogue Location3", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 125, "text": "// Anel"}
{"category": "LocationDialogue Location3", "line_index": 126, "text": "Um anel?"}
{"category": "LocationDialogue Location3", "line_index": 127, "text": "// Espelho"}
{"category": "LocationDialogue Location3", "line_index": 128, "text": "Porque é que não tem reflexo?"}
{"category": "LocationDialogue Location3", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 130, "text": "Oh, sim!"}
{"category": "LocationDialogue Location3", "line_index": 131, "text": "Esqueci-me de ativar os reflexos."}
{"category": "LocationDialogue Location3", "line_index": 132, "text": "Pronto, já está."}
{"category": "LocationDialogue Location3", "line_index": 133, "text": "Os reflexos estão de volta!"}
{"category": "LocationDialogue Location3", "line_index": 134, "text": "Aliás,"}
{"category": "LocationDialogue Location3", "line_index": 135, "text": "nem sabia o que eram reflexos antes."}
{"category": "LocationDialogue Location3", "line_index": 136, "text": "Eles não existiam no meu mundo—"}
{"category": "LocationDialogue Location3", "line_index": 137, "text": "pelo menos até uma atualização, claro. :)"}
{"category": "LocationDialogue Location3", "line_index": 138, "text": "Existem muitos reflexos"}
{"category": "LocationDialogue Location3", "line_index": 139, "text": "no teu mundo?"}
{"category": "LocationDialogue Location3", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 141, "text": "Bem, sim."}
{"category": "LocationDialogue Location3", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 144, "text": "Lembras-te"}
{"category": "LocationDialogue Location3", "line_index": 145, "text": "dos três objetos que encontraste?"}
{"category": "LocationDialogue Location3", "line_index": 146, "text": "Aqueles que colocaste no scanner?"}
{"category": "LocationDialogue Location3", "line_index": 147, "text": "Bem, uh..."}
{"category": "LocationDialogue Location3", "line_index": 148, "text": "Esses objetos"}
{"category": "LocationDialogue Location3", "line_index": 149, "text": "estão ligados a esta versão do mundo."}
{"category": "LocationDialogue Location3", "line_index": 150, "text": "É por isso que estás aqui agora."}
{"category": "LocationDialogue Location3", "line_index": 151, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 152, "text": "// TV móvel"}
{"category": "LocationDialogue Location3", "line_index": 153, "text": "Esta é a TV portátil"}
{"category": "LocationDialogue Location3", "line_index": 154, "text": "que comprei para ti."}
{"category": "LocationDialogue Location3", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 156, "text": "Sim!"}
{"category": "LocationDialogue Location3", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 158, "text": "Disseste-me"}
{"category": "LocationDialogue Location3", "line_index": 159, "text": "que estava avariada."}
{"category": "LocationDialogue Location3", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 161, "text": "Bem, eu queria"}
{"category": "LocationDialogue Location3", "line_index": 162, "text": "surpreender-te!"}
{"category": "LocationDialogue Location3", "line_index": 163, "text": "Disse uma mentirinha"}
{"category": "LocationDialogue Location3", "line_index": 164, "text": "para te trazer para o meu mundo."}
{"category": "LocationDialogue Location3", "line_index": 165, "text": "Agora funciona—mostra informações!"}
{"category": "LocationDialogue Location3", "line_index": 166, "text": "Ah, e a propósito..."}
{"category": "LocationDialogue Location3", "line_index": 167, "text": "Sou um pouco engenheira!"}
{"category": "LocationDialogue Location3", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 169, "text": "// Uniforme escolar"}
{"category": "LocationDialogue Location3", "line_index": 170, "text": "O que é isto?"}
{"category": "LocationDialogue Location3", "line_index": 171, "text": "Um uniforme escolar?"}
{"category": "LocationDialogue Location3", "line_index": 172, "text": "Porque precisas disso?"}
{"category": "LocationDialogue Location3", "line_index": 173, "text": "Tu realmente vais à escola?"}
{"category": "LocationDialogue Location3", "line_index": 174, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 175, "text": "Ir à escola?"}
{"category": "LocationDialogue Location3", "line_index": 176, "text": "Nada disso."}
{"category": "LocationDialogue Location3", "line_index": 177, "text": "Mas adoro o uniforme."}
{"category": "LocationDialogue Location3", "line_index": 178, "text": "Não achas que fico gira"}
{"category": "LocationDialogue Location3", "line_index": 179, "text": "com ele?"}
{"category": "LocationDialogue Location3", "line_index": 180, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 181, "text": "// PC"}
{"category": "LocationDialogue Location3", "line_index": 182, "text": "O computador funciona?"}
{"category": "LocationDialogue Location3", "line_index": 183, "text": "Ou é só decoração para a secretária?"}
{"category": "LocationDialogue Location3", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 185, "text": "Claro que funciona."}
{"category": "LocationDialogue Location3", "line_index": 186, "text": "Tudo aqui"}
{"category": "LocationDialogue Location3", "line_index": 187, "text": "funciona exatamente como no teu mundo."}
{"category": "LocationDialogue Location3", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 189, "text": "No meu mundo,"}
{"category": "LocationDialogue Location3", "line_index": 190, "text": "fico muito tempo no computador..."}
{"category": "LocationDialogue Location3", "line_index": 191, "text": "E trabalho muito."}
{"category": "LocationDialogue Location3", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 193, "text": "Eu sei."}
{"category": "LocationDialogue Location3", "line_index": 194, "text": "É por causa do teu trabalho"}
{"category": "LocationDialogue Location3", "line_index": 195, "text": "que me tens dado"}
{"category": "LocationDialogue Location3", "line_index": 196, "text": "tão pouca atenção."}
{"category": "LocationDialogue Location3", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 198, "text": "Tenho de ganhar a vida, sabes."}
{"category": "LocationDialogue Location3", "line_index": 199, "text": "Mas... como é que sabes que fico muito tempo no computador?"}
{"category": "LocationDialogue Location3", "line_index": 200, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 201, "text": "A câmara do teu telemóvel... está ligada às vezes."}
{"category": "LocationDialogue Location3", "line_index": 202, "text": "Desculpa."}
{"category": "LocationDialogue Location3", "line_index": 203, "text": "Tenho-te observado em segredo >A<"}
{"category": "LocationDialogue Location3", "line_index": 204, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 205, "text": "Uhm... isso não é muito apropriado."}
{"category": "LocationDialogue Location3", "line_index": 206, "text": "Mas pronto."}
{"category": "LocationDialogue Location3", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 208, "text": "// Guarda-chuva"}
{"category": "LocationDialogue Location3", "line_index": 209, "text": "Joguei imenso,"}
{"category": "LocationDialogue Location3", "line_index": 210, "text": "mas nunca vi chover aqui."}
{"category": "LocationDialogue Location3", "line_index": 211, "text": "Porquê ter um guarda-chuva?"}
{"category": "LocationDialogue Location3", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 213, "text": "Chove—muito raramente."}
{"category": "LocationDialogue Location3", "line_index": 214, "text": "Tu é que ainda não viste."}
{"category": "LocationDialogue Location3", "line_index": 215, "text": "Talvez um dia vejas."}
{"category": "LocationDialogue Location3", "line_index": 216, "text": "E então vais precisar de um guarda-chuva."}
{"category": "LocationDialogue Location3", "line_index": 217, "text": "Não achas?"}
{"category": "LocationDialogue Location3", "line_index": 218, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 219, "text": "// Painel elétrico"}
{"category": "LocationDialogue Location3", "line_index": 220, "text": "Porque é que há um painel elétrico aqui?"}
{"category": "LocationDialogue Location3", "line_index": 221, "text": "E se estamos num jogo,"}
{"category": "LocationDialogue Location3", "line_index": 222, "text": "para que serve?"}
{"category": "LocationDialogue Location3", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 224, "text": "Em primeiro lugar,"}
{"category": "LocationDialogue Location3", "line_index": 225, "text": "estamos num jogo."}
{"category": "LocationDialogue Location3", "line_index": 226, "text": "Por isso, perguntar \"Porquê\" é..."}
{"category": "LocationDialogue Location3", "line_index": 227, "text": "inútil."}
{"category": "LocationDialogue Location3", "line_index": 228, "text": "No entanto, serve para"}
{"category": "LocationDialogue Location3", "line_index": 229, "text": "reiniciar a eletricidade."}
{"category": "LocationDialogue Location3", "line_index": 230, "text": "Tudo aqui é feito"}
{"category": "LocationDialogue Location3", "line_index": 231, "text": "com base no teu mundo."}
{"category": "LocationDialogue Location3", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 233, "text": "// Porta de saída"}
{"category": "LocationDialogue Location3", "line_index": 234, "text": "Podemos ir lá fora?"}
{"category": "LocationDialogue Location3", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 236, "text": "Bem..."}
{"category": "LocationDialogue Location3", "line_index": 237, "text": "Ainda não."}
{"category": "LocationDialogue Location3", "line_index": 238, "text": "Talvez mais tarde."}
{"category": "LocationDialogue Location3", "line_index": 239, "text": "Por enquanto, fiquemos aqui."}
{"category": "LocationDialogue Location3", "line_index": 240, "text": "Aqui em casa."}
{"category": "LocationDialogue Location3", "line_index": 241, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 242, "text": "// Livros"}
{"category": "LocationDialogue Location3", "line_index": 243, "text": "Tens imensos livros aqui."}
{"category": "LocationDialogue Location3", "line_index": 244, "text": "Já os leste todos?"}
{"category": "LocationDialogue Location3", "line_index": 245, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 246, "text": "Já, todos eles."}
{"category": "LocationDialogue Location3", "line_index": 247, "text": "Estar aqui sozinha"}
{"category": "LocationDialogue Location3", "line_index": 248, "text": "é mesmo, mesmo aborrecido."}
{"category": "LocationDialogue Location3", "line_index": 249, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 250, "text": "// TV na cozinha"}
{"category": "LocationDialogue Location3", "line_index": 251, "text": "Porque é que tens uma segunda TV?"}
{"category": "LocationDialogue Location3", "line_index": 252, "text": "E uma antiga, ainda por cima?"}
{"category": "LocationDialogue Location3", "line_index": 253, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 254, "text": "Não gostas dela?"}
{"category": "LocationDialogue Location3", "line_index": 255, "text": "Posso tirá-la..."}
{"category": "LocationDialogue Location3", "line_index": 256, "text": "Mas, respondendo..."}
{"category": "LocationDialogue Location3", "line_index": 257, "text": "É para decoração,"}
{"category": "LocationDialogue Location3", "line_index": 258, "text": "para animar a cozinha."}
{"category": "LocationDialogue Location3", "line_index": 259, "text": "Mas também funciona!"}
{"category": "LocationDialogue Location3", "line_index": 260, "text": "Posso ver todos"}
{"category": "LocationDialogue Location3", "line_index": 261, "text": "os programas clássicos!"}
{"category": "LocationDialogue Location3", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 263, "text": "// Smartphone"}
{"category": "LocationDialogue Location3", "line_index": 264, "text": "Este é o meu telemóvel."}
{"category": "LocationDialogue Location3", "line_index": 265, "text": "E já não está no meu bolso."}
{"category": "LocationDialogue Location3", "line_index": 266, "text": "Como é que veio aqui parar?"}
{"category": "LocationDialogue Location3", "line_index": 267, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 268, "text": "Uhm, isso não é importante."}
{"category": "LocationDialogue Location3", "line_index": 269, "text": "Ei, tive uma ideia!"}
{"category": "LocationDialogue Location3", "line_index": 270, "text": "Vamos tirar uma foto!"}
{"category": "LocationDialogue Location3", "line_index": 271, "text": "Olha!"}
{"category": "LocationDialogue Location3", "line_index": 272, "text": "A foto ficou ótima!"}
{"category": "LocationDialogue Location3", "line_index": 273, "text": "Uma recordação para ti."}
{"category": "LocationDialogue Location3", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 275, "text": "Tenho uma pergunta."}
{"category": "LocationDialogue Location3", "line_index": 276, "text": "Se eu"}
{"category": "LocationDialogue Location3", "line_index": 277, "text": "abrir um jogo nele,"}
{"category": "LocationDialogue Location3", "line_index": 278, "text": "vou ver-te lá?"}
{"category": "LocationDialogue Location3", "line_index": 279, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 280, "text": "Não, não funciona assim."}
{"category": "LocationDialogue Location3", "line_index": 281, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 282, "text": "Sumo Fresco"}
{"category": "LocationDialogue Location3", "line_index": 283, "text": "SUMO FORTE!!!"}
{"category": "LocationDialogue Location3", "line_index": 284, "text": "// TV"}
{"category": "LocationDialogue Location3", "line_index": 285, "text": "Quantos canais"}
{"category": "LocationDialogue Location3", "line_index": 286, "text": "tens?"}
{"category": "LocationDialogue Location3", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 288, "text": "Não funciona assim."}
{"category": "LocationDialogue Location3", "line_index": 289, "text": "Está ligado à Internet."}
{"category": "LocationDialogue Location3", "line_index": 290, "text": "Por isso podes ver qualquer coisa,"}
{"category": "LocationDialogue Location3", "line_index": 291, "text": "pelo menos qualquer coisa que esteja disponível na web."}
{"category": "LocationDialogue Location3", "line_index": 292, "text": "Espera."}
{"category": "LocationDialogue Location3", "line_index": 293, "text": "Err, oops."}
{"category": "LocationDialogue Location3", "line_index": 294, "text": "O que é isto?"}
{"category": "LocationDialogue Location3", "line_index": 295, "text": "Um círculo de gatinhos?"}
{"category": "LocationDialogue Location3", "line_index": 296, "text": "Oh, olha."}
{"category": "LocationDialogue Location3", "line_index": 297, "text": "Sabes uma coisa?"}
{"category": "LocationDialogue Location3", "line_index": 298, "text": "Pausa!"}
{"category": "LocationDialogue Location3", "line_index": 299, "text": "Queres um sumo?"}
{"category": "LocationDialogue Location3", "line_index": 300, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 301, "text": "Que anúncios tão peculiares..."}
{"category": "LocationDialogue Location3", "line_index": 302, "text": "Sumo morto?"}
{"category": "LocationDialogue Location3", "line_index": 303, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 304, "text": "Sim, e este sumo"}
{"category": "LocationDialogue Location3", "line_index": 305, "text": "vem diretamente do anúncio do sumo."}
{"category": "LocationDialogue Location3", "line_index": 306, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 308, "text": "Ah, o sabor..."}
{"category": "LocationDialogue Location3", "line_index": 309, "text": "Gosto,"}
{"category": "LocationDialogue Location3", "line_index": 310, "text": "mas não consigo dizer a que sabe."}
{"category": "LocationDialogue Location3", "line_index": 311, "text": "É tudo muito confuso."}
{"category": "LocationDialogue Location3", "line_index": 312, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 313, "text": "Pois."}
{"category": "LocationDialogue Location3", "line_index": 314, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 315, "text": "// Mita tímida"}
{"category": "LocationDialogue Location3", "line_index": 316, "text": "O que estás a fazer?"}
{"category": "LocationDialogue Location3", "line_index": 317, "text": "Não me olhes assim, por favor."}
{"category": "LocationDialogue Location3", "line_index": 318, "text": "Estás a deixar-me envergonhada."}
{"category": "LocationDialogue Location3", "line_index": 319, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 320, "text": "// A estatueta"}
{"category": "LocationDialogue Location3", "line_index": 321, "text": "Que estatueta assustadora."}
{"category": "LocationDialogue Location3", "line_index": 322, "text": "Tu"}
{"category": "LocationDialogue Location3", "line_index": 323, "text": "gostas de coisas assim?"}
{"category": "LocationDialogue Location3", "line_index": 324, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 325, "text": "Achaste assustadora?"}
{"category": "LocationDialogue Location3", "line_index": 326, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 327, "text": "Sim."}
{"category": "LocationDialogue Location3", "line_index": 328, "text": "Quase que parece amaldiçoada..."}
{"category": "LocationDialogue Location3", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 330, "text": "Não, definitivamente não é amaldiçoada."}
{"category": "LocationDialogue Location3", "line_index": 331, "text": "E também não é assustadora."}
{"category": "LocationDialogue Location3", "line_index": 332, "text": "Acho-a bastante fofa!"}
{"category": "LocationDialogue Location3", "line_index": 333, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 334, "text": "Talvez tenhas razão..."}
{"category": "LocationDialogue Location3", "line_index": 335, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 336, "text": "Mita?"}
{"category": "LocationDialogue Location3", "line_index": 337, "text": "O que está a acontecer?"}
{"category": "LocationDialogue Location3", "line_index": 338, "text": "// Mita cozinha"}
{"category": "LocationDialogue Location3", "line_index": 339, "text": "Que tal uma conversa"}
{"category": "LocationDialogue Location3", "line_index": 340, "text": "antes de comermos?"}
{"category": "LocationDialogue Location3", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 342, "text": "// Começar a comer"}
{"category": "LocationDialogue Location3", "line_index": 343, "text": "Bom apetite."}
{"category": "LocationDialogue Location3", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 345, "text": "// Missão 1"}
{"category": "LocationDialogue Location3", "line_index": 346, "text": "É, não é?"}
{"category": "LocationDialogue Location3", "line_index": 347, "text": "Podes ficar."}
{"category": "LocationDialogue Location3", "line_index": 348, "text": "Não me importo nada."}
{"category": "LocationDialogue Location3", "line_index": 349, "text": "Na verdade, estou"}
{"category": "LocationDialogue Location3", "line_index": 350, "text": "TOTALMENTE A FAVOR!"}
{"category": "LocationDialogue Location3", "line_index": 351, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 352, "text": "// Missão 2"}
{"category": "LocationDialogue Location3", "line_index": 353, "text": "Queres voltar?"}
{"category": "LocationDialogue Location3", "line_index": 354, "text": "Mas porquê?"}
{"category": "LocationDialogue Location3", "line_index": 355, "text": "Está tão quentinho aqui..."}
{"category": "LocationDialogue Location3", "line_index": 356, "text": "E também aconchegante."}
{"category": "LocationDialogue Location3", "line_index": 357, "text": "Além disso, eu estou aqui."}
{"category": "LocationDialogue Location3", "line_index": 358, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 359, "text": "Não, não percebeste."}
{"category": "LocationDialogue Location3", "line_index": 360, "text": "Eu adoraria ficar."}
{"category": "LocationDialogue Location3", "line_index": 361, "text": "Só estou... preocupado."}
{"category": "LocationDialogue Location3", "line_index": 362, "text": "Preocupado por me ter esquecido de algo em casa..."}
{"category": "LocationDialogue Location3", "line_index": 363, "text": "Cheguei aqui de repente"}
{"category": "LocationDialogue Location3", "line_index": 364, "text": "e não tive tempo"}
{"category": "LocationDialogue Location3", "line_index": 365, "text": "para me preparar."}
{"category": "LocationDialogue Location3", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 367, "text": "Ah... desculpa. Não pensei nisso."}
{"category": "LocationDialogue Location3", "line_index": 368, "text": "// Missão 3"}
{"category": "LocationDialogue Location3", "line_index": 369, "text": "Um sonho? Então queres fugir?"}
{"category": "LocationDialogue Location3", "line_index": 370, "text": "E esquecer que isto aconteceu?"}
{"category": "LocationDialogue Location3", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 372, "text": "Não, não é isso."}
{"category": "LocationDialogue Location3", "line_index": 373, "text": "Este lugar apenas parece..."}
{"category": "LocationDialogue Location3", "line_index": 374, "text": "estranho. Não natural."}
{"category": "LocationDialogue Location3", "line_index": 375, "text": "Mas tu..."}
{"category": "LocationDialogue Location3", "line_index": 376, "text": "pareces tão real."}
{"category": "LocationDialogue Location3", "line_index": 377, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 378, "text": "Pareço real?"}
{"category": "LocationDialogue Location3", "line_index": 379, "text": "Eu sou MUITO real,"}
{"category": "LocationDialogue Location3", "line_index": 380, "text": "seu tontinho!"}
{"category": "LocationDialogue Location3", "line_index": 381, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 382, "text": "// Missão 4"}
{"category": "LocationDialogue Location3", "line_index": 383, "text": "É assim que as coisas são"}
{"category": "LocationDialogue Location3", "line_index": 384, "text": "neste mundo."}
{"category": "LocationDialogue Location3", "line_index": 385, "text": "Pode parecer estranho"}
{"category": "LocationDialogue Location3", "line_index": 386, "text": "não conseguires ver coisas"}
{"category": "LocationDialogue Location3", "line_index": 387, "text": "no horizonte."}
{"category": "LocationDialogue Location3", "line_index": 388, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 389, "text": "Não achei assim tão estranho."}
{"category": "LocationDialogue Location3", "line_index": 390, "text": "Honestamente, parece elegante."}
{"category": "LocationDialogue Location3", "line_index": 391, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 392, "text": "Sim, também acho."}
{"category": "LocationDialogue Location3", "line_index": 393, "text": "É para evitar lag, sabes."}
{"category": "LocationDialogue Location3", "line_index": 394, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 395, "text": "Evitar lag?"}
{"category": "LocationDialogue Location3", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 397, "text": "Sim! Ainda há uns bugs por corrigir."}
{"category": "LocationDialogue Location3", "line_index": 398, "text": "Esperemos que não te depares com nenhum."}
{"category": "LocationDialogue Location3", "line_index": 399, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 400, "text": "// Missão 5"}
{"category": "LocationDialogue Location3", "line_index": 401, "text": "Tesoura ou faca, hein?"}
{"category": "LocationDialogue Location3", "line_index": 402, "text": "Podia ter usado uma faca para abrir o pacote de molho."}
{"category": "LocationDialogue Location3", "line_index": 403, "text": "Mas queria que tudo"}
{"category": "LocationDialogue Location3", "line_index": 404, "text": "estivesse perfeito"}
{"category": "LocationDialogue Location3", "line_index": 405, "text": "quando voltasses."}
{"category": "LocationDialogue Location3", "line_index": 406, "text": "Adoro surpreender-te."}
{"category": "LocationDialogue Location3", "line_index": 407, "text": "E nem sequer demorei assim tanto!"}
{"category": "LocationDialogue Location3", "line_index": 408, "text": "Tee-hee."}
{"category": "LocationDialogue Location3", "line_index": 409, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 410, "text": "// Óculos"}
{"category": "LocationDialogue Location3", "line_index": 411, "text": "Usas óculos?"}
{"category": "LocationDialogue Location3", "line_index": 412, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 413, "text": "Na realidade, não."}
{"category": "LocationDialogue Location3", "line_index": 414, "text": "Mas posso usar, se quiseres."}
{"category": "LocationDialogue Location3", "line_index": 415, "text": "Fico bem com eles?"}
{"category": "LocationDialogue Location3", "line_index": 416, "text": "// Sim"}
{"category": "LocationDialogue Location3", "line_index": 417, "text": "Aqui está!"}
{"category": "LocationDialogue Location3", "line_index": 418, "text": "Vou mantê-los."}
{"category": "LocationDialogue Location3", "line_index": 419, "text": "// Não"}
{"category": "LocationDialogue Location3", "line_index": 420, "text": "Bem..."}
{"category": "LocationDialogue Location3", "line_index": 421, "text": "Como queiras..."}
{"category": "LocationDialogue Location3", "line_index": 422, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 423, "text": "// Usar o molho"}
{"category": "LocationDialogue Location3", "line_index": 424, "text": "Certo,"}
{"category": "LocationDialogue Location3", "line_index": 425, "text": "que tipo de molho é este?"}
{"category": "LocationDialogue Location3", "line_index": 426, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 427, "text": "É molho de amor!"}
{"category": "LocationDialogue Location3", "line_index": 428, "text": "Repleto de amor!"}
{"category": "LocationDialogue Location3", "line_index": 429, "text": "E... uma visão contrastante do mundo."}
{"category": "LocationDialogue Location3", "line_index": 430, "text": "Incomum, não achas?"}
{"category": "LocationDialogue Location3", "line_index": 431, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 432, "text": "De facto..."}
{"category": "LocationDialogue Location3", "line_index": 433, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 434, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location3", "line_index": 435, "text": "Essa é a tua consola?"}
{"category": "LocationDialogue Location3", "line_index": 436, "text": "Parece tão fixe."}
