{"category": "LocationDialogue Location6", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "Mita?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "Como raios é que vieste parar aqui?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "És a Mita, não és?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Mas há algo de diferente em ti..."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "Observador, estou a ver."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "E tens razão."}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "Não sou a Mita que conheceste antes."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Cuidado, ela está a aprontar algo"}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "sinistro."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "Huh, algo sinistro?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "Não há tempo para explicar"}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "se isto correr bem, conto-te tudo."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Pega na chave. Está ao lado do sofá."}
{"category": "LocationDialogue Location6", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Mas..."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "Guarda as tuas perguntas para depois!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Dá-me a chave."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Toma este anel."}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "Huh?"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Queres sair daqui, não queres?"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "Uhm, ya..."}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Então usa-o."}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "É um artefacto útil,"}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "provavelmente vais precisar dele em breve."}
{"category": "LocationDialogue Location6", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Okay..."}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "A propósito, sou"}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Mmm,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "Eu sou... a Mita."}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// Missão MitaKind 1"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "Vês aquela"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "consola? Pega nela."}
{"category": "LocationDialogue Location6", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "Estamos a ver uma gravação?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "Quem é que está com ela?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "Isto está a acontecer neste preciso momento."}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "É outro jogador."}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Ela está a usá-lo."}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Ela pode tentar"}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "transformar-te também num cartucho."}
{"category": "LocationDialogue Location6", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "Eu preciso de sair daqui o mais rápido possível."}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "E tu também."}
{"category": "LocationDialogue Location6", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "Sim, precisamos."}
{"category": "LocationDialogue Location6", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "Então, estás a dizer"}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "que ela está a usá-lo."}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "E se eu tirar o cartucho, o que acontece?"}
{"category": "LocationDialogue Location6", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "Isso pode muito bem"}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "danificar irreversivelmente o cartucho."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "O que significa que..."}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "o jogador morreria."}
{"category": "LocationDialogue Location6", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "..."}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "E se eu simplesmente desligar?"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "Isso pode funcionar..."}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Vale a pena tentar. Há um botão vermelho de energia!"}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Vês?"}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "Encontrei-o."}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "Pressiona-o."}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// Missão MitaKind 2"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Eu preciso de ficar."}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "Há perguntas que preciso de fazer-lhe"}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "para saber mais sobre ela."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "Embora seja improvável que ela coopere..."}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// Missão MitaKind 3"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "Para dizer-te a verdade, esta é a minha versão."}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "Eu estava a fazer companhia a um jogador,"}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "quando algo mudou de repente."}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "Então ela apareceu..."}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "e transformou o jogador num cartucho"}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "e trancou-me aqui."}
{"category": "LocationDialogue Location6", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Espera, ela transformou-o num cartucho?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "Ela consegue fazer isso?"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "Mas porquê?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "Para quê que ela precisa dos jogadores?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "Ela é obviamente maluca..."}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Ela está apenas a brincar connosco, e a usar-nos para as suas próprias invenções!"}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "Transformar jogadores em cartuchos..."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Alguns nem sequer percebem o que lhes está a acontecer..."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "E alguns que percebem, nem sequer lutam... Gah!"}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "Ora isso é uma reviravolta sombria..."}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "Tens de nos ajudar!"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "Eu? Mas como?"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "Eu preciso de ti!"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "Se me ajudares, eu ajudo-te!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Esta pode ser a nossa única oportunidade."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "O anel vai levar-te à versão correta."}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "Eu encontar-te-ei lá."}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// Missão MitaKind 4"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "Ainda não percebo muito bem"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "o que vi lá em cima..."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Aquela Mita..."}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "Ela estava a tentar matar-me?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "Matar?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Ela tem um destino pior do que isso em mente para ti..."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "Precisas de te apressar."}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Esconde-te!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "Oh, merda! Esconde-te!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Espera, o quê...?"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Rápido, ela está a chegar!"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "Segue o anel—ele vai deixar-te em segurança!"}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "Bem, bem, vais contar-me onde é que ele está?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "Porque é que contaria?"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "Não vais matá-lo, ou vais?"}
{"category": "LocationDialogue Location6", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Ah, então recusas-te a contar-me."}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Hah, gosto de um desafio."}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "Sei que ele está por aqui algures."}
{"category": "LocationDialogue Location6", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "Porque é que és tão má connosco?"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "Nem sequer me dizes o que se passa!"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "Para além disso..."}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "para que é que precisas dos jogadores?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "Eles não são brinquedos!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "O que se passou contigo?!"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "Basta! Calada, bonequinha!"}
