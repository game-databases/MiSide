{"category": "LocationDialogue Location8", "line_index": 0, "text": "// O primeiro encontro"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "Quem és tu?"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "Qual é o problema?"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "Não consegues falar?"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "Espera..."}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "Queres ir embora, não é?"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "Sim..."}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "Preciso voltar"}
{"category": "LocationDialogue Location8", "line_index": 11, "text": "à versão anterior."}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "A versão anterior?"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "Porquê ires te embora"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "para outro sítio?"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "Porque não ficares aqui"}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "e ser o meu"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "segundo amigo?"}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Ignorar todos os diálogos"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "Okay..."}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// De pé à janela (Aleatório)"}
{"category": "LocationDialogue Location8", "line_index": 24, "text": "Não vais encontrar a tua saída pelas portas."}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "Parece que estás com pressa..."}
{"category": "LocationDialogue Location8", "line_index": 26, "text": "Correr em círculos não te vai salvar."}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "Tão ansioso para escapar?"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "Olha pela janela..."}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Missão 1 (Não és a Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "Jogador... és um jogador, não és?"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": "Podemos brincar juntos."}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "Se eu conseguir encontrar a força,"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": "tudo o que precisamos fazer é brincar."}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Missão 2 (O que te aconteceu?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "Estou incerta, e na verdade não sei..."}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "Não acho que tenha acontecido algo de mal..."}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "Mas tudo o que é bom parece estar a escapar-se..."}
{"category": "LocationDialogue Location8", "line_index": 41, "text": "Embora, pelo menos, eu tenha um amigo."}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "Porque me deixaram?"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "Eu não era suficiente?"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "Estou com medo..."}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Missão 3 (Tornar-me o segundo amigo?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "Amigos..."}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "Agora tenho tão poucos."}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "Só me resta um..."}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "Estou triste, jogador."}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "Queres ser meu amigo?"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "Adoraria,"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "mas tenho que seguir em frente..."}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "O meu coração dói..."}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Missão 4 (Esta é a tua casa?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "Casa?"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "Jogador... mudaste..."}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "Os teus braços estão mais curtos, e já não pareces tão zangado..."}
{"category": "LocationDialogue Location8", "line_index": 62, "text": "Jogador, tornaste-te mais amável, mais gentil."}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "Não tenho a certeza..."}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "do que isso significa."}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "Está tudo bem..."}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "porque eu não vou magoar mais ninguém, não é?"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Missão 5 (Como saio daqui?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "Estás mesmo a deixar-me?"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "Será isto talvez apenas o meu..."}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "destino?"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "Eu..."}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": "As portas não te vão ajudar."}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Segurar jogador (Aleatório)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "Porquê sair?"}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "Fica aqui..."}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "Joga comigo..."}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "Jogador..."}
