{"category": "LocationDialogue Location4", "line_index": 0, "text": "Mita?"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "Ah, já acordado?"}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "Como é que vieste aqui parar?"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": "Estavas mesmo agora ao meu lado."}
{"category": "LocationDialogue Location4", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 5, "text": "Não, não estava."}
{"category": "LocationDialogue Location4", "line_index": 6, "text": "Ficaste congelado em frente ao espelho."}
{"category": "LocationDialogue Location4", "line_index": 7, "text": "Por isso saí."}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "Porque é que os quartos mudaram?"}
{"category": "LocationDialogue Location4", "line_index": 9, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "Reorganizei o espaço"}
{"category": "LocationDialogue Location4", "line_index": 11, "text": "para te fazer sentir mais em casa."}
{"category": "LocationDialogue Location4", "line_index": 12, "text": "Aqui,"}
{"category": "LocationDialogue Location4", "line_index": 13, "text": "podemos mudar os quartos"}
{"category": "LocationDialogue Location4", "line_index": 14, "text": "como nos apetecer."}
{"category": "LocationDialogue Location4", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 16, "text": "Não precisavas."}
{"category": "LocationDialogue Location4", "line_index": 17, "text": "Já me estava a habituar à disposição."}
{"category": "LocationDialogue Location4", "line_index": 18, "text": "De qualquer forma, acho que vais sentir-te mais à vontade com esta organização."}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Jogo de cartas com a Mita"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "Certo,"}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "jogamos?"}
{"category": "LocationDialogue Location4", "line_index": 22, "text": "O jogo funciona assim"}
{"category": "LocationDialogue Location4", "line_index": 23, "text": "Esta ficha indica um tipo,"}
{"category": "LocationDialogue Location4", "line_index": 24, "text": "como Vida"}
{"category": "LocationDialogue Location4", "line_index": 25, "text": "Cada um de nós joga uma carta,"}
{"category": "LocationDialogue Location4", "line_index": 26, "text": "e se a tua carta tiver"}
{"category": "LocationDialogue Location4", "line_index": 27, "text": "um valor de Vida"}
{"category": "LocationDialogue Location4", "line_index": 28, "text": "superior ao meu,"}
{"category": "LocationDialogue Location4", "line_index": 29, "text": "ganhas."}
{"category": "LocationDialogue Location4", "line_index": 30, "text": "Pega nas tuas cartas."}
{"category": "LocationDialogue Location4", "line_index": 31, "text": "É a minha vez."}
{"category": "LocationDialogue Location4", "line_index": 32, "text": "Uau!"}
{"category": "LocationDialogue Location4", "line_index": 33, "text": "Tenho uma mão incrível!"}
{"category": "LocationDialogue Location4", "line_index": 34, "text": "Vou primeiro!"}
{"category": "LocationDialogue Location4", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 44, "text": "OK!"}
{"category": "LocationDialogue Location4", "line_index": 45, "text": "É a tua vez!"}
{"category": "LocationDialogue Location4", "line_index": 46, "text": "Uh-huh."}
{"category": "LocationDialogue Location4", "line_index": 47, "text": "É a tua vez!"}
{"category": "LocationDialogue Location4", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 49, "text": "O maior valor de Vida ganha!"}
{"category": "LocationDialogue Location4", "line_index": 50, "text": "Está tudo no Ataque!"}
{"category": "LocationDialogue Location4", "line_index": 51, "text": "Foca-te na Defesa!"}
{"category": "LocationDialogue Location4", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 54, "text": "Ganhaste!"}
{"category": "LocationDialogue Location4", "line_index": 55, "text": "Ganhaste!"}
{"category": "LocationDialogue Location4", "line_index": 56, "text": "Apanhaste-me."}
{"category": "LocationDialogue Location4", "line_index": 57, "text": "Oh, tu..."}
{"category": "LocationDialogue Location4", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 59, "text": "Eu ganhei!"}
{"category": "LocationDialogue Location4", "line_index": 60, "text": "Sou a vencedora!"}
{"category": "LocationDialogue Location4", "line_index": 61, "text": "Eu ganhei!"}
{"category": "LocationDialogue Location4", "line_index": 62, "text": "Hah, apanhei-te!"}
{"category": "LocationDialogue Location4", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 64, "text": "É um empate."}
{"category": "LocationDialogue Location4", "line_index": 65, "text": "Estamos quites!"}
{"category": "LocationDialogue Location4", "line_index": 66, "text": "Bem, isto é um empate!"}
{"category": "LocationDialogue Location4", "line_index": 67, "text": "O mesmo valor..."}
{"category": "LocationDialogue Location4", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 79, "text": "// O jogo de cartas é interrompido"}
{"category": "LocationDialogue Location4", "line_index": 80, "text": "Que som é este?"}
{"category": "LocationDialogue Location4", "line_index": 81, "text": "Vem do roupeiro."}
{"category": "LocationDialogue Location4", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 83, "text": "Som?"}
{"category": "LocationDialogue Location4", "line_index": 84, "text": "Que som?"}
{"category": "LocationDialogue Location4", "line_index": 85, "text": "Não ouvi nada."}
{"category": "LocationDialogue Location4", "line_index": 86, "text": "O que achas que ouviste?"}
{"category": "LocationDialogue Location4", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 88, "text": "Batidas, como se alguém estivesse lá dentro."}
{"category": "LocationDialogue Location4", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 90, "text": "Mas..."}
{"category": "LocationDialogue Location4", "line_index": 91, "text": "Não há ninguém lá dentro..."}
{"category": "LocationDialogue Location4", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 93, "text": "Quero abrir e verificar."}
{"category": "LocationDialogue Location4", "line_index": 94, "text": "Estou um pouco assustado."}
{"category": "LocationDialogue Location4", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 96, "text": "Mas porquê...?"}
{"category": "LocationDialogue Location4", "line_index": 97, "text": "Isto outra vez..."}
{"category": "LocationDialogue Location4", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 105, "text": "O que é que se passa contigo!?"}
{"category": "LocationDialogue Location4", "line_index": 106, "text": "É só um roupeiro..."}
{"category": "LocationDialogue Location4", "line_index": 107, "text": "Tenho a minha roupa interior, aí...!"}
{"category": "LocationDialogue Location4", "line_index": 108, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 109, "text": "Estás a esconder-me algo?"}
{"category": "LocationDialogue Location4", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 111, "text": "Porque não acreditas em mim?"}
{"category": "LocationDialogue Location4", "line_index": 112, "text": "O que é que estou a fazer de mal?"}
{"category": "LocationDialogue Location4", "line_index": 113, "text": "O que eu quero..."}
{"category": "LocationDialogue Location4", "line_index": 114, "text": "tudo o que eu quero é que estejas comigo."}
{"category": "LocationDialogue Location4", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 116, "text": "Eu também gostava disso, mas ainda assim...?"}
{"category": "LocationDialogue Location4", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 118, "text": "Porque estás tão fixado nesse roupeiro?!"}
{"category": "LocationDialogue Location4", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 120, "text": "Quero saber o que raios eram aquelas batidas!"}
{"category": "LocationDialogue Location4", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 122, "text": "Será que é porque"}
{"category": "LocationDialogue Location4", "line_index": 123, "text": "este mundo"}
{"category": "LocationDialogue Location4", "line_index": 124, "text": "só tem estes quatro quartos?"}
{"category": "LocationDialogue Location4", "line_index": 125, "text": "Isso não é suficiente para ti?"}
{"category": "LocationDialogue Location4", "line_index": 126, "text": "Porque é que não podes simplesmente ficar comigo?"}
{"category": "LocationDialogue Location4", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 129, "text": "//Não fiques com a Mita"}
{"category": "LocationDialogue Location4", "line_index": 130, "text": "Eu entendo."}
{"category": "LocationDialogue Location4", "line_index": 131, "text": "Isto outra vez..."}
{"category": "LocationDialogue Location4", "line_index": 132, "text": "Se queres verificar o roupeiro,"}
{"category": "LocationDialogue Location4", "line_index": 133, "text": "então fá-lo,"}
{"category": "LocationDialogue Location4", "line_index": 134, "text": "e descobre o que está lá dentro!"}
{"category": "LocationDialogue Location4", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 139, "text": "Mas o que..."}
{"category": "LocationDialogue Location4", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 141, "text": "Isso acontece às vezes."}
{"category": "LocationDialogue Location4", "line_index": 142, "text": "O quarto ficou preso no carregamento."}
{"category": "LocationDialogue Location4", "line_index": 143, "text": "Espera só um momento."}
{"category": "LocationDialogue Location4", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 145, "text": "Isto é tão estranho."}
{"category": "LocationDialogue Location4", "line_index": 146, "text": "Estamos dentro do telemóvel de alguém?"}
{"category": "LocationDialogue Location4", "line_index": 147, "text": "Talvez um modelo lento com tempos de carregamento longos?"}
{"category": "LocationDialogue Location4", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 149, "text": "De todo."}
{"category": "LocationDialogue Location4", "line_index": 150, "text": "Mas nem tudo é perfeito"}
{"category": "LocationDialogue Location4", "line_index": 151, "text": "neste mundo..."}
{"category": "LocationDialogue Location4", "line_index": 152, "text": "Estamos a ser carregados"}
{"category": "LocationDialogue Location4", "line_index": 153, "text": "juntamente com o núcleo do mundo."}
{"category": "LocationDialogue Location4", "line_index": 154, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 155, "text": "O núcleo do mundo?"}
{"category": "LocationDialogue Location4", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 157, "text": "Típico, não achas?"}
{"category": "LocationDialogue Location4", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 159, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 161, "text": "De qualquer forma, podemos"}
{"category": "LocationDialogue Location4", "line_index": 162, "text": "jogar na consola"}
{"category": "LocationDialogue Location4", "line_index": 163, "text": "ou às cartas."}
{"category": "LocationDialogue Location4", "line_index": 164, "text": "Tu escolhes."}
{"category": "LocationDialogue Location4", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 167, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 168, "text": "// Brincadeira com a Mita"}
{"category": "LocationDialogue Location4", "line_index": 169, "text": "Queres lutar?"}
{"category": "LocationDialogue Location4", "line_index": 170, "text": "Tens de ganhar"}
{"category": "LocationDialogue Location4", "line_index": 171, "text": "quatro vezes."}
{"category": "LocationDialogue Location4", "line_index": 172, "text": "Manda vir."}
{"category": "LocationDialogue Location4", "line_index": 173, "text": "Não te preocupes, vou"}
{"category": "LocationDialogue Location4", "line_index": 174, "text": "ter calma contigo ao início."}
{"category": "LocationDialogue Location4", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 176, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 177, "text": "Isso mesmo."}
{"category": "LocationDialogue Location4", "line_index": 178, "text": "É melhor prestares atenção!"}
{"category": "LocationDialogue Location4", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 180, "text": "Uau!"}
{"category": "LocationDialogue Location4", "line_index": 181, "text": "Ya, okay."}
{"category": "LocationDialogue Location4", "line_index": 182, "text": "Agora é que vão ser elas."}
{"category": "LocationDialogue Location4", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 184, "text": "Uau!"}
{"category": "LocationDialogue Location4", "line_index": 185, "text": "Vamos ver se consegues"}
{"category": "LocationDialogue Location4", "line_index": 186, "text": "derrotar-me agora!"}
{"category": "LocationDialogue Location4", "line_index": 187, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 188, "text": "Tu és"}
{"category": "LocationDialogue Location4", "line_index": 189, "text": "simplesmente"}
{"category": "LocationDialogue Location4", "line_index": 190, "text": "incrível! Tu tens mesmo jeito!"}
{"category": "LocationDialogue Location4", "line_index": 191, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 193, "text": "O que se passa?"}
{"category": "LocationDialogue Location4", "line_index": 194, "text": "Huh, isto é aborrecido."}
{"category": "LocationDialogue Location4", "line_index": 195, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 196, "text": "Bem,"}
{"category": "LocationDialogue Location4", "line_index": 197, "text": "é isso. Acreditas no destino?"}
{"category": "LocationDialogue Location4", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 199, "text": "Então,"}
{"category": "LocationDialogue Location4", "line_index": 200, "text": "age em conformidade ou vais ser um perdedor para sempre!"}
{"category": "LocationDialogue Location4", "line_index": 201, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 202, "text": "O que se passa contigo hoje?"}
{"category": "LocationDialogue Location4", "line_index": 203, "text": "Dei-te uma tareia."}
{"category": "LocationDialogue Location4", "line_index": 204, "text": "Não deste o teu melhor—"}
{"category": "LocationDialogue Location4", "line_index": 205, "text": "é por isso que perdeste!"}
{"category": "LocationDialogue Location4", "line_index": 206, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 208, "text": "Está bem, então."}
{"category": "LocationDialogue Location4", "line_index": 209, "text": "Que tal jogarmos às cartas?"}
{"category": "LocationDialogue Location4", "line_index": 210, "text": "Estão no quarto."}
{"category": "LocationDialogue Location4", "line_index": 211, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 214, "text": "// Porta > [ERRO]"}
{"category": "LocationDialogue Location4", "line_index": 215, "text": "Huh, o que está a acontecer?"}
{"category": "LocationDialogue Location4", "line_index": 216, "text": "Onde está..."}
{"category": "LocationDialogue Location4", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 218, "text": "Uh-oh."}
{"category": "LocationDialogue Location4", "line_index": 219, "text": "Desculpa..."}
{"category": "LocationDialogue Location4", "line_index": 220, "text": "Eu baixei algo"}
{"category": "LocationDialogue Location4", "line_index": 221, "text": "da net."}
{"category": "LocationDialogue Location4", "line_index": 222, "text": "Eu queria enfeitar"}
{"category": "LocationDialogue Location4", "line_index": 223, "text": "um pouco o exterior."}
{"category": "LocationDialogue Location4", "line_index": 224, "text": "Mas o que acontece é que"}
{"category": "LocationDialogue Location4", "line_index": 225, "text": "havia algo de errado com o arquivo."}
{"category": "LocationDialogue Location4", "line_index": 226, "text": "Eu vou corrigi-lo depois."}
{"category": "LocationDialogue Location4", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 228, "text": "É por isso que não podemos sair de casa?"}
{"category": "LocationDialogue Location4", "line_index": 229, "text": "Sim, é por isso."}
{"category": "LocationDialogue Location4", "line_index": 230, "text": "// Mita tímida"}
{"category": "LocationDialogue Location4", "line_index": 231, "text": "Ei..."}
{"category": "LocationDialogue Location4", "line_index": 232, "text": "O que se passa contigo?"}
{"category": "LocationDialogue Location4", "line_index": 233, "text": "Queres alguma coisa?"}
{"category": "LocationDialogue Location4", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 236, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 237, "text": "// Relógio de parede"}
{"category": "LocationDialogue Location4", "line_index": 238, "text": "Este relógio,"}
{"category": "LocationDialogue Location4", "line_index": 239, "text": "que horas mostra?"}
{"category": "LocationDialogue Location4", "line_index": 240, "text": "A hora atual do jogo?"}
{"category": "LocationDialogue Location4", "line_index": 241, "text": "Ou está sincronizado com o meu telemóvel?"}
{"category": "LocationDialogue Location4", "line_index": 242, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 243, "text": "Bem, uhm..."}
{"category": "LocationDialogue Location4", "line_index": 244, "text": "Honestamente, não sei."}
{"category": "LocationDialogue Location4", "line_index": 245, "text": "Mas o tempo não importa aqui..."}
{"category": "LocationDialogue Location4", "line_index": 246, "text": "Seja tarde ou cedo,"}
{"category": "LocationDialogue Location4", "line_index": 247, "text": "uma rapariga forte como eu"}
{"category": "LocationDialogue Location4", "line_index": 248, "text": "está sempre cheia de energia—"}
{"category": "LocationDialogue Location4", "line_index": 249, "text": "nunca me canso!"}
{"category": "LocationDialogue Location4", "line_index": 250, "text": "Podemos ter uma primavera eterna,"}
{"category": "LocationDialogue Location4", "line_index": 251, "text": "ou uma tarde sem fim!"}
{"category": "LocationDialogue Location4", "line_index": 252, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 253, "text": "Isso é interessante..."}
{"category": "LocationDialogue Location4", "line_index": 254, "text": "mas também um pouco assustador."}
{"category": "LocationDialogue Location4", "line_index": 255, "text": "Presos no mesmo momento, para sempre..."}
{"category": "LocationDialogue Location4", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 258, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 259, "text": "// Fotos da Mita"}
{"category": "LocationDialogue Location4", "line_index": 260, "text": "Fotos boas."}
{"category": "LocationDialogue Location4", "line_index": 261, "text": "Aposto que são tuas, não?"}
{"category": "LocationDialogue Location4", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 263, "text": "Sim."}
{"category": "LocationDialogue Location4", "line_index": 264, "text": "Eu também gosto delas."}
{"category": "LocationDialogue Location4", "line_index": 265, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 266, "text": "Quem as tirou?"}
{"category": "LocationDialogue Location4", "line_index": 267, "text": "Há mais alguém neste mundo?"}
{"category": "LocationDialogue Location4", "line_index": 268, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 269, "text": "Pode-se dizer que sim."}
{"category": "LocationDialogue Location4", "line_index": 270, "text": "Vou apresentar-te eventualmente."}
{"category": "LocationDialogue Location4", "line_index": 271, "text": "Só que não agora."}
{"category": "LocationDialogue Location4", "line_index": 272, "text": "Por enquanto, quero estar só contigo."}
{"category": "LocationDialogue Location4", "line_index": 273, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 275, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 276, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 277, "text": "// Portal"}
{"category": "LocationDialogue Location4", "line_index": 278, "text": "Para onde foi o portal?"}
{"category": "LocationDialogue Location4", "line_index": 279, "text": "Ou lá como lhe chamavas?"}
{"category": "LocationDialogue Location4", "line_index": 280, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 281, "text": "Usei um"}
{"category": "LocationDialogue Location4", "line_index": 282, "text": "pouco de magia"}
{"category": "LocationDialogue Location4", "line_index": 283, "text": "e movi-o"}
{"category": "LocationDialogue Location4", "line_index": 284, "text": "para outro lugar."}
{"category": "LocationDialogue Location4", "line_index": 285, "text": "Já não precisamos dele."}
{"category": "LocationDialogue Location4", "line_index": 286, "text": "Só ia atrapalhar."}
{"category": "LocationDialogue Location4", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 288, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 289, "text": "// Espelho no quarto"}
{"category": "LocationDialogue Location4", "line_index": 290, "text": "Olhar para um espelho sem"}
{"category": "LocationDialogue Location4", "line_index": 291, "text": "ver um reflexo—é assustador."}
{"category": "LocationDialogue Location4", "line_index": 292, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 293, "text": "Podemos ativar os reflexos"}
{"category": "LocationDialogue Location4", "line_index": 294, "text": "se realmente quiseres."}
{"category": "LocationDialogue Location4", "line_index": 295, "text": "Mas, será que precisamos mesmo deles?"}
{"category": "LocationDialogue Location4", "line_index": 296, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 297, "text": "Claro que precisamos."}
{"category": "LocationDialogue Location4", "line_index": 298, "text": "Ou... ativar os reflexos vai ter consequências?"}
{"category": "LocationDialogue Location4", "line_index": 299, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 300, "text": "Sim."}
{"category": "LocationDialogue Location4", "line_index": 301, "text": "Vamos ter falhas e mexer-nos mais devagar."}
{"category": "LocationDialogue Location4", "line_index": 302, "text": "Já viste desenhos animados com poucos frames por segundo?"}
{"category": "LocationDialogue Location4", "line_index": 303, "text": "Vai ser assim para nós, o tempo inteiro."}
{"category": "LocationDialogue Location4", "line_index": 304, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 305, "text": "Entendido."}
{"category": "LocationDialogue Location4", "line_index": 306, "text": "Então talvez seja melhor manter os reflexos desligados..."}
{"category": "LocationDialogue Location4", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 308, "text": "Ei, [player],"}
{"category": "LocationDialogue Location4", "line_index": 309, "text": "gostas mesmo de espelhos, não é?"}
{"category": "LocationDialogue Location4", "line_index": 310, "text": "Tens medo de ver um sorriso nessa tua cara?"}
{"category": "LocationDialogue Location4", "line_index": 311, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 312, "text": "Huh? Não propriamente..."}
{"category": "LocationDialogue Location4", "line_index": 313, "text": "Só estou cansado"}
{"category": "LocationDialogue Location4", "line_index": 314, "text": "depois de tanto trabalho."}
{"category": "LocationDialogue Location4", "line_index": 315, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 316, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 317, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 318, "text": "// Ténis azuis"}
{"category": "LocationDialogue Location4", "line_index": 319, "text": "São teus?"}
{"category": "LocationDialogue Location4", "line_index": 320, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 321, "text": "Não, são teus."}
{"category": "LocationDialogue Location4", "line_index": 322, "text": "Não te lembras?"}
{"category": "LocationDialogue Location4", "line_index": 323, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 324, "text": "Não me recordo de ter ténis assim."}
{"category": "LocationDialogue Location4", "line_index": 325, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 326, "text": "Agora já tens."}
{"category": "LocationDialogue Location4", "line_index": 327, "text": "Podes usá-los"}
{"category": "LocationDialogue Location4", "line_index": 328, "text": "quando formos lá para fora."}
{"category": "LocationDialogue Location4", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 330, "text": "E as roupas?"}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "Só tenho a roupa que estou a usar neste mundo."}
{"category": "LocationDialogue Location4", "line_index": 332, "text": "são as roupas que estou a vestir."}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "Há alguma forma de arranjar umas novas?"}
{"category": "LocationDialogue Location4", "line_index": 334, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 335, "text": "Claro que sim."}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "Embora, já vi como te vestes—"}
{"category": "LocationDialogue Location4", "line_index": 337, "text": "e honestamente, o teu gosto não é grande coisa."}
{"category": "LocationDialogue Location4", "line_index": 338, "text": "De qualquer forma, vou ajudar-te a arranjar umas."}
{"category": "LocationDialogue Location4", "line_index": 339, "text": "Só não agora."}
{"category": "LocationDialogue Location4", "line_index": 340, "text": "Mas é uma promessa."}
{"category": "LocationDialogue Location4", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 342, "text": "Okay."}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Jogos na TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "O que queres jogar?"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Jogo leite"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "Este é um jogo de luta!"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "Vamos ver quem azeda primeiro!"}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "Que jogo!"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": "Já chega de leite por agora, vamos fazer outra coisa."}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Jogo pinguins"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "Neste jogo, és um pinguim"}
{"category": "LocationDialogue Location4", "line_index": 354, "text": "a deslizar por aí."}
{"category": "LocationDialogue Location4", "line_index": 355, "text": "Pronto, é isso o jogo."}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Fica com a Mita"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "Huh, o quê?"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "A sério? Pensei que estavas..."}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "Estou muito feliz!"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "E um pouco confusa..."}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "Mas..."}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "Por favor, fica comigo—"}
{"category": "LocationDialogue Location4", "line_index": 364, "text": "para sempre e sempre."}
{"category": "LocationDialogue Location4", "line_index": 365, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 367, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 368, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 369, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 370, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 372, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 373, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 374, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 375, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 376, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 377, "text": "// Um jogo de pinguins"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "É super simples"}
{"category": "LocationDialogue Location4", "line_index": 379, "text": "só tens de apanhar bolas de neve."}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "Quem apanhar mais, ganha!"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "Vamos jogar duas rondas, okay?!"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// O primeiro mapa"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "Uau, como é que conseguiste tantas?"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "Tee-hee! Eu tenho mais bolas de neve!"}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "É melhor apanhares o jeito!"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "Ha, 1:1!"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// O segundo mapa"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "És um verdadeiro pinguim!"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "Devias ir para o gelo verdadeiro!"}
{"category": "LocationDialogue Location4", "line_index": 390, "text": "Pfft, és tão lento."}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "Ainda a pensar na última ronda?"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "Uau, empate! Isso é raro!"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// O jogo terminou"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "Certo, queres jogar outra coisa?"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "Ou já chega?"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "Para que é que precisas disso?"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "És assim tão gamer?"}
