{"category": "LocationDialogue Location15", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Aí estás tu!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Porque é que saíste do Núcleo?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Disse-te para esperares por mim!"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Pensava que ias demorar mais..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Bem, tudo bem..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Acho que encontrei algo..."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Acho que é um índice..."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Vamos ver se funciona!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Vamos sair daqui."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "A Mita louca..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Acho que ela está ocupada com um novo jogador."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Então, espero que esteja demasiado ocupada para nos incomodar..."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Mita?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Espera por mim."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Deixaste cair alguma coisa?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Encontra-a outra vez!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Mita..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Apanha!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Como é que..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Quem és tu?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Tu... tu estás viva!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Não te lembras de mim?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Eu conheço-te?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "O que está a acontecer..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "O que é que eu devo fazer agora?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Não consigo sair..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "O que queres dizer com \"sair\"?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Espera..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "Esse é o anel..."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "E aquilo?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Não faço ideia do que seja."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "É um índice!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Encontraste-o!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Não sei o que dizer."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Temos de voltar ao Núcleo."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "E tu..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Talvez devesses vir comigo..."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Hã, o quê?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Claro..."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Espera aqui."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Mm-hmm."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Vou ficar sentada aqui."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Merda..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "Foi por pouco."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "Então... conseguimos?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Bom."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Estou na versão correta."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Alô!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "És um jogador, não és?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Qual é o teu nome?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Quero sair deste lugar..."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Queres sair assim tão depressa?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "Como é que vieste parar aqui sequer?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Ah bem..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Está bem, podes sair..."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Tenta a porta."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Boa sorte com isso!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Uma parede?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Hmm, isto não está certo."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Talvez..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "haja algo na cave que te ajude."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Descobri recentemente"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "uma porta no meu guarda-roupa..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Acontece que leva a uma cave."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Mas está cheia de lixo,"}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "lixo e uma tonelada de equipamentos chiques."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Tens de introduzir algum tipo de código ou algo do tipo."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Não entendo muito bem."}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "E não me importo."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "Também é um pouco desconfortável, quero dizer, muito desconfortável."}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Vais dar uma vista de olhos?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Uhm, okay."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Pensamento do jogador"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Não acho"}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "que ela se lembre de alguma coisa..."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Resultou?"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "Reiniciámo-la?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Então tudo o que tenho de fazer é"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "sair deste maldito jogo..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Não tão rápido."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Gostava de te abraçar."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Hã?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Abraços"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Foi bom ver-te."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Ahh..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "É uma pena"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "que tu e eu"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "tenhamos passado tão pouco tempo juntos."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Err..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "Do que é que estás a falar?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Quero dizer,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "podias ter ficado comigo..."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "Tudo é culpa minha..."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Aquele roupeiro e os... os sons."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Eu devia de tê-la MATADO mais cedo!"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Espera aí,"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "Tu não...?"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Como é que te lembras disso tudo?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "HA!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Pensaste mesmo que ia ser assim tão fácil?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "És só um tolo..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Tal como todos os outros jogadores..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Fizemos tudo bem, olha!"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "O VERDADEIRO"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "tu não és"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "mais necessário."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Desculpa, tee-hee."}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Não posso crer..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Falhamos...?"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Não... Reiniciei-te, tenho a certeza..."}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Ainda não percebes..."}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Ha-ha-ha!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Sou uma atriz tão boa!"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Devias ter visto a tua cara, docinho!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "Isto é tão divertido!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Porque é que és assim?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "O que  é que se passa contigo?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Ya..."}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "O que é que se passa comigo?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Não faço ideia..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Porque não me dizes tu porque é que sou assim?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Porque é que nunca serei uma Mita real?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "A minha versão, nunca"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "existiu sequer para começar!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Estou só a despir estas tolas ingénuas,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "e a esconder-me sob as suas peles..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Não há maneira de me"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "reiniciares!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Inacreditável..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Tu..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "Elas não são o problema!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "És tu que não devias existir!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "Tu também..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Dói ouvir-te dizer isso."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "E ainda assim!"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Está na hora de ires!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Vejo-te em breve!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Todos estão prontos!"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "Está"}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "na hora de tirar-te da consola!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "Até já!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Serás o meu cartucho favorito..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Um jogador com um nome interessante."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// consola do núcleo - nope programa"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Provavelmente não é isto."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Também não está certo."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Não, está errado."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Isto não é."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Preciso encontrar a opção de reiniciar personagem."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// consola do núcleo - nope versão"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "Esta é a versão errada."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Ups, enganei-me."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Não é isto."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Vou precisar de outra."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// consola do núcleo - nope índice"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Algo não está certo"}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "com o índice."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Preciso trocar o índice,"}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "este não serve."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Porquê cozinha"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Tens fome?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Sou ótima a cortar cenouras. :)"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Porquê casa de banho"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Ah, acho"}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "que querias ir sozinho?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Porquê quarto de volta"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Porque é que estamos a dar voltas?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Porquê voltar aqui?"}
