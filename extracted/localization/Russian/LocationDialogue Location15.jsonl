{"category": "LocationDialogue Location15", "line_index": 0, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Вот ты где!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Почему ты ушёл от ядра?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Я же велела ждать меня, так?"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Я просто подумал, что тебя долго нет и..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Ну ладненько..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Кажется, я нашла кое-что."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Вроде бы это индекс."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Нужно поскорее узнать, сработает ли!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Давай-ка уходить отсюда."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "Безумная Мита..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Думаю, она сейчас занята новыми игроками."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Так что ей не до нас, полагаю..."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Мита? "}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Подожди меня."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": "// Mita killler"}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Что-то потерял!?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Познакомься с ней ещё разочек!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Мита..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Лови!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Как же так..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Кто ты?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Ты... жива!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Ты ничего не помнишь?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Я тебя знаю?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Но как же..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Что же мне теперь делать?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Я не смогу выбраться..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "Что значит «выбраться»?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": "// Player "}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Подожди..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "Это же кольцо."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "А это?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Я не знаю, что это)"}
{"category": "LocationDialogue Location15", "line_index": 48, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "Это индекс!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Ты всё-таки нашла его!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Я не знаю, что сказать."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Нужно вернуться к ядру."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "И ты..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Наверное, тебе лучше пойти со мной."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Что?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Ну, хорошо."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Подожди здесь."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Ага."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Я тут присяду."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Чёрт..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "Чуть не помер..."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "И... что, у нас получилось?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Так..."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Я на этой самой версии."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Привет!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Ты ведь игрок?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Как тебя зовут?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Я хочу покинуть это место."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Уже хочешь уйти?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "А как ты здесь оказался, вообще?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Хм-м..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Ну-у-у, уйти можно."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Попробуй просто выйти из дома)"}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Удачи тебе!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Стена?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Ой, так не должно быть."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Может..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "Тебе поможет то, что находится в подвале."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Недавно я совершенно случайно"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "Обнаружила у себя в шкафу дверь..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Оказалось, это подвал."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Он явно нужен для всякого барахла."}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "А ещё там причудливая техника хранится."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Нужно вводить какие-то коды, что ли..."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Я не совсем понимаю"}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "И понимать не хочу)"}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "А ещё там неуютненько. Ну вот вообще!"}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Взглянешь?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Эм... Хорошо."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Кажется..."}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "Она ничего не помнит."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Значит, у нас получилось"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "Перезагрузить?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Осталось только выйти"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "Из этой проклятой игры..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Постой."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Я бы хотела тебя обнять."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Что?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Mita - hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Рада была видеть тебя!"}
{"category": "LocationDialogue Location15", "line_index": 120, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Э-эх..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "Жаль,"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "Что мы с тобой"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "Провели так мало времени..."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Не понял..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "Ты о чём?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Я о том,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "Что ты мог бы остаться со мной."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "Это я виновата."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Этот шкаф. И... звуки."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Нужно было раньше УБИТЬ её."}
{"category": "LocationDialogue Location15", "line_index": 134, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Погоди."}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "Ты что, не..."}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Откуда ты помнишь это?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "ХА!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Неужели ты думал, что всё будет так просто?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Ну ты дурачок..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Впрочем, как и все..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "А уложились-то в самый раз, гляди! // Показывает часы"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "Больше ты,"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "«Живой»,"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "Не нужен..."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Прости)"}
{"category": "LocationDialogue Location15", "line_index": 148, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Неужели..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Не получилось? // Мита убирает часы"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Нет, я точно смог перезагрузить тебя!"}
{"category": "LocationDialogue Location15", "line_index": 152, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Ты так ничего и не понял... // Мита опускает руки"}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Ха-ха-ха-ха!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Какая же я хорошая актриса! // Хватает за голову"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Видел бы ты своё лицо, дорогуша!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "Как же это весело!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Почему ты такая?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Что с тобой не так?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Да и вправду... // Мита показывает настоящий облик"}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Что же со мной не так?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Даже не знаю..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Может, сам мне скажешь, почему я такая?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Почему никогда не стану Митой?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Ведь моей версии никогда"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "И не существовало!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Я просто срываю кожу с этих наивных дур,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "Прячусь за их шкурками..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Меня просто невозможно"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "Перезагрузить!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Не могу поверить..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Ты..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "Не в них проблема!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "Это тебя не должно было существовать!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "И ты туда же..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Больно слышать такое от тебя("}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "И тем не менее! // Отходит назад"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Тебе пора!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Скоро снова увидимся!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Уже готово,"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "Думаю."}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "Время извлечь тебя из консоли!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "До встречи!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Ты будешь моим любимым картриджем..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Игрок с интересным именем."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm - Player"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Наверное, это не то. // 1"}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Тоже не подходит. // 2"}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Неа. // 3"}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Это не то, что мне нужно // 4"}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Мне надо найти перезагрузку персонажа. // 5"}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "Это не та версия. // 1"}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Ой, ошибся. // 2"}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Не она. // 3"}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Нужно подправить. // 4"}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Что-то не так. // 1"}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "Индекс неправильный. // 2"}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Нужно повторить индекс. // 3"}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "Не подходит. // 4"}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen - MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Ты хочешь кушать?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Я отлично умею нарезать морковку)"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom - MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Ой, наверное..."}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "Ты хотел сюда зайти один?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back - MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Ты решил ходить по кругу?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Зачем вернулись?"}
