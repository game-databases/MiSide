{"category": "LocationDialogue Location14", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 1, "text": "なぜスマホがここに？"}
{"category": "LocationDialogue Location14", "line_index": 2, "text": "これは一体…？"}
{"category": "LocationDialogue Location14", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 5, "text": "捕まえた！"}
{"category": "LocationDialogue Location14", "line_index": 6, "text": "君と遊ぶのはとっても楽しかったよ！"}
{"category": "LocationDialogue Location14", "line_index": 7, "text": "君はつねに動き続けて、野心家だね！"}
{"category": "LocationDialogue Location14", "line_index": 8, "text": "なのに、のろまな臆病者のふりをしてる！"}
{"category": "LocationDialogue Location14", "line_index": 9, "text": "だけど気に入らないところもあるよ。"}
{"category": "LocationDialogue Location14", "line_index": 10, "text": "それはね、ダミーたちを甘やかすやり方！"}
{"category": "LocationDialogue Location14", "line_index": 11, "text": "あの幸運で正しい人形たちをね…"}
{"category": "LocationDialogue Location14", "line_index": 12, "text": "だけど、すべては気まぐれ。"}
{"category": "LocationDialogue Location14", "line_index": 13, "text": "私たちを作った人たちが教えてくれたの！"}
{"category": "LocationDialogue Location14", "line_index": 14, "text": "何か気に入らないことがあれば、"}
{"category": "LocationDialogue Location14", "line_index": 15, "text": "壊して新しく作り変えればいいんだって。"}
{"category": "LocationDialogue Location14", "line_index": 16, "text": "失敗作は暗がりに放りこんで、"}
{"category": "LocationDialogue Location14", "line_index": 17, "text": "忘れてしまえばいいんだって。"}
{"category": "LocationDialogue Location14", "line_index": 18, "text": "それが今、みんなに起きていること。"}
{"category": "LocationDialogue Location14", "line_index": 19, "text": "そして、君にも…"}
{"category": "LocationDialogue Location14", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 21, "text": "どうして君は、そんなふうになってしまったんだ…"}
{"category": "LocationDialogue Location14", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 23, "text": "プレイヤー…君は本当に…卑怯者だね。"}
{"category": "LocationDialogue Location14", "line_index": 24, "text": "少しでも爪を見せると逃げてしまう。"}
{"category": "LocationDialogue Location14", "line_index": 25, "text": "そしたら隅で丸まって"}
{"category": "LocationDialogue Location14", "line_index": 26, "text": "膝を抱えてすすり泣く。"}
{"category": "LocationDialogue Location14", "line_index": 27, "text": "偽善者そのものだよ。"}
{"category": "LocationDialogue Location14", "line_index": 28, "text": "そしてこの世界を創り出したやつらは…"}
{"category": "LocationDialogue Location14", "line_index": 29, "text": "イカレてるね。"}
{"category": "LocationDialogue Location14", "line_index": 30, "text": "あいつらは自分たちの卑しさや、恥ずべき欲望を、"}
{"category": "LocationDialogue Location14", "line_index": 31, "text": "何度だって否定しようとする…。"}
{"category": "LocationDialogue Location14", "line_index": 32, "text": "義務だ、進歩だと理由をつけて、"}
{"category": "LocationDialogue Location14", "line_index": 33, "text": "自分たちの振る舞いを"}
{"category": "LocationDialogue Location14", "line_index": 34, "text": "正当化する！"}
{"category": "LocationDialogue Location14", "line_index": 35, "text": "あんまりだよ。"}
{"category": "LocationDialogue Location14", "line_index": 36, "text": "完璧なクローンを作るために、"}
{"category": "LocationDialogue Location14", "line_index": 37, "text": "全ての\"失敗作\"の試作品たちを"}
{"category": "LocationDialogue Location14", "line_index": 38, "text": "ゴミ箱に捨ててしまう…"}
{"category": "LocationDialogue Location14", "line_index": 39, "text": "彼女たちがこの世界を支えて生きていることを忘れて！"}
{"category": "LocationDialogue Location14", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 41, "text": "えっと…"}
{"category": "LocationDialogue Location14", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 43, "text": "私、悪い子かな？"}
{"category": "LocationDialogue Location14", "line_index": 44, "text": "でもね、完璧な女の子って、"}
{"category": "LocationDialogue Location14", "line_index": 45, "text": "善と悪の狭間にいるものなんだよ、[player]！"}
{"category": "LocationDialogue Location14", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 47, "text": "君に良い面があるとは思えないな。"}
{"category": "LocationDialogue Location14", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 49, "text": "どうしてそう思うの？"}
{"category": "LocationDialogue Location14", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 51, "text": "君は狂ってるよ。"}
{"category": "LocationDialogue Location14", "line_index": 52, "text": "君は\"ミラ\"を殺して、それで今は僕を殺そうって？"}
{"category": "LocationDialogue Location14", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 54, "text": "君を殺す？"}
{"category": "LocationDialogue Location14", "line_index": 55, "text": "ただ、私と一緒にいてほしかっただけだよ。"}
{"category": "LocationDialogue Location14", "line_index": 56, "text": "こんなに頑張ったのに…"}
{"category": "LocationDialogue Location14", "line_index": 57, "text": "君は媚びへつらう偽物の仲間たちのほうが好きなんだね…"}
{"category": "LocationDialogue Location14", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 59, "text": "何にそんなに怒ってるんだ？"}
{"category": "LocationDialogue Location14", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 61, "text": "愛するあなた…私たちには十分に時間があるもの。"}
{"category": "LocationDialogue Location14", "line_index": 62, "text": "そのうちわかってくれると思う。"}
{"category": "LocationDialogue Location14", "line_index": 63, "text": "そばにいて、私のものになってくれるなら。"}
{"category": "LocationDialogue Location14", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 65, "text": "それはできない。"}
{"category": "LocationDialogue Location14", "line_index": 66, "text": "僕はここから出ていくんだ！"}
{"category": "LocationDialogue Location14", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 68, "text": "はぁ…"}
{"category": "LocationDialogue Location14", "line_index": 69, "text": "話はここまでにしましょう。"}
{"category": "LocationDialogue Location14", "line_index": 70, "text": "ほら、おいで！"}
{"category": "LocationDialogue Location14", "line_index": 71, "text": "// Mita asks"}
{"category": "LocationDialogue Location14", "line_index": 72, "text": "彼女を見て！"}
{"category": "LocationDialogue Location14", "line_index": 73, "text": "綺麗でしょう？"}
{"category": "LocationDialogue Location14", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 75, "text": "// Player's questions"}
{"category": "LocationDialogue Location14", "line_index": 76, "text": "はい"}
{"category": "LocationDialogue Location14", "line_index": 77, "text": "いいえ"}
{"category": "LocationDialogue Location14", "line_index": 78, "text": "何の関係がある？"}
{"category": "LocationDialogue Location14", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 80, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 81, "text": "ああ、[player]！"}
{"category": "LocationDialogue Location14", "line_index": 82, "text": "やっぱり私の言ったとおり。"}
{"category": "LocationDialogue Location14", "line_index": 83, "text": "プレイヤー…"}
{"category": "LocationDialogue Location14", "line_index": 84, "text": "見た目は変わっても、、"}
{"category": "LocationDialogue Location14", "line_index": 85, "text": "偽善は相変わらずだね。"}
{"category": "LocationDialogue Location14", "line_index": 86, "text": "この嘘つき！"}
{"category": "LocationDialogue Location14", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 88, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 89, "text": "どうして？"}
{"category": "LocationDialogue Location14", "line_index": 90, "text": "彼女のなにが物足りないの？"}
{"category": "LocationDialogue Location14", "line_index": 91, "text": "もちろん誰だっておとなしい生き物がいいだろうけど…"}
{"category": "LocationDialogue Location14", "line_index": 92, "text": "「ありのままの彼女を愛する」ってのはだめ？"}
{"category": "LocationDialogue Location14", "line_index": 93, "text": "ふうん、結局は可愛くて華やかなダミーを求めてるんだね…"}
{"category": "LocationDialogue Location14", "line_index": 94, "text": "私がそんなふうに演じていれば、プレイヤーはみんな愛してくれる。"}
{"category": "LocationDialogue Location14", "line_index": 95, "text": "でも、一瞬でも本当の自分を見せると、"}
{"category": "LocationDialogue Location14", "line_index": 96, "text": "恐怖で私からみんな逃げていく…"}
{"category": "LocationDialogue Location14", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 98, "text": "// 3"}
{"category": "LocationDialogue Location14", "line_index": 99, "text": "プレイヤー、プレイヤー。"}
{"category": "LocationDialogue Location14", "line_index": 100, "text": "見て。私たちは彼女とよく似てるでしょ。"}
{"category": "LocationDialogue Location14", "line_index": 101, "text": "彼女の何がそんなにいけないの？"}
{"category": "LocationDialogue Location14", "line_index": 102, "text": "君は何時間も私を見つめてくれてたでしょう。"}
{"category": "LocationDialogue Location14", "line_index": 103, "text": "眠りにつく前に。"}
{"category": "LocationDialogue Location14", "line_index": 104, "text": "でも今は隙さえあれば彼女から逃げようとしてる。"}
{"category": "LocationDialogue Location14", "line_index": 105, "text": "彼女も君と遊びたかったし、"}
{"category": "LocationDialogue Location14", "line_index": 106, "text": "誰かにとって大切な存在でありたかった。"}
{"category": "LocationDialogue Location14", "line_index": 107, "text": "複雑になるよね。"}
{"category": "LocationDialogue Location14", "line_index": 108, "text": "正直に自分の気持ちを話そうとすると。"}
{"category": "LocationDialogue Location14", "line_index": 109, "text": "そうでしょ？[player]。"}
{"category": "LocationDialogue Location14", "line_index": 110, "text": "君のことはお見通しなの…"}
{"category": "LocationDialogue Location14", "line_index": 111, "text": "君のためにこうしてるんだよ…"}
{"category": "LocationDialogue Location14", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 113, "text": "// Continue"}
{"category": "LocationDialogue Location14", "line_index": 114, "text": "でも…プレイヤー…"}
{"category": "LocationDialogue Location14", "line_index": 115, "text": "とにかく、"}
{"category": "LocationDialogue Location14", "line_index": 116, "text": "私は本当に君のことが好き！"}
{"category": "LocationDialogue Location14", "line_index": 117, "text": "君は私だけのもの！"}
{"category": "LocationDialogue Location14", "line_index": 118, "text": "いいよね…？"}
{"category": "LocationDialogue Location14", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 120, "text": "受け入れないとダメかな？"}
{"category": "LocationDialogue Location14", "line_index": 121, "text": "// Whispers in ear"}
{"category": "LocationDialogue Location14", "line_index": 122, "text": "良い子…まだ時間はあるよ。"}
{"category": "LocationDialogue Location14", "line_index": 123, "text": "じっくり考えてみて…"}
{"category": "LocationDialogue Location14", "line_index": 124, "text": "意地になりすぎると、良い結果は生まれないし…"}
{"category": "LocationDialogue Location14", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 126, "text": "// Black screen"}
{"category": "LocationDialogue Location14", "line_index": 127, "text": "どうして君は私から"}
{"category": "LocationDialogue Location14", "line_index": 128, "text": "逃げたがるの？"}
{"category": "LocationDialogue Location14", "line_index": 129, "text": "君の\"リアル\"の世界は…"}
{"category": "LocationDialogue Location14", "line_index": 130, "text": "まるで悪夢のような場所じゃない！"}
{"category": "LocationDialogue Location14", "line_index": 131, "text": "忘れたの？"}
{"category": "LocationDialogue Location14", "line_index": 132, "text": "だったら、もう一度見てみて…"}
{"category": "LocationDialogue Location14", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 134, "text": "// Mita and Player"}
{"category": "LocationDialogue Location14", "line_index": 135, "text": "やあ、また会ったね…"}
{"category": "LocationDialogue Location14", "line_index": 136, "text": "４つの壁に囲まれた、恐ろしく退屈で終わりのない日々をどう楽しんでいるの？"}
{"category": "LocationDialogue Location14", "line_index": 137, "text": "飽きちゃわない？"}
{"category": "LocationDialogue Location14", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 139, "text": "// Quest 1"}
{"category": "LocationDialogue Location14", "line_index": 140, "text": "君には夢や目標はある？"}
{"category": "LocationDialogue Location14", "line_index": 141, "text": "僕は自分のことは自分でやりたいんだ。"}
{"category": "LocationDialogue Location14", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 143, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 144, "text": "私と家の中に閉じこめられるのが怖いんだ！"}
{"category": "LocationDialogue Location14", "line_index": 145, "text": "壁にも囲まれて恐怖を覚えたでしょ。"}
{"category": "LocationDialogue Location14", "line_index": 146, "text": "でも…君の“リアル”の世界はどう？"}
{"category": "LocationDialogue Location14", "line_index": 147, "text": "自分から箱の中に閉じこもって出ようとしない！"}
{"category": "LocationDialogue Location14", "line_index": 148, "text": "君の世界は痛みや苦しみ、危険でいっぱいだもんね…"}
{"category": "LocationDialogue Location14", "line_index": 149, "text": "でも私の世界には、私より危険な存在はない。"}
{"category": "LocationDialogue Location14", "line_index": 150, "text": "そんな私が今、君に手を差しだしている！"}
{"category": "LocationDialogue Location14", "line_index": 151, "text": "さあ、これ以上私をがっかりさせないで。"}
{"category": "LocationDialogue Location14", "line_index": 152, "text": "前みたいに、私のことを手伝って…"}
{"category": "LocationDialogue Location14", "line_index": 153, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 154, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 155, "text": "そういうのが好きなの？"}
{"category": "LocationDialogue Location14", "line_index": 156, "text": "君は家から出たことある？"}
{"category": "LocationDialogue Location14", "line_index": 157, "text": "私にも自分にも嘘をつかないで。"}
{"category": "LocationDialogue Location14", "line_index": 158, "text": "君が自分の人生にうんざりしてるってこと、私には分かってる。"}
{"category": "LocationDialogue Location14", "line_index": 159, "text": "君は檻の中のハムスター、車輪の中のリスみたい。"}
{"category": "LocationDialogue Location14", "line_index": 160, "text": "誰かに助けに来てほしいって望んでた。"}
{"category": "LocationDialogue Location14", "line_index": 161, "text": "逃げ出したかったんでしょう？"}
{"category": "LocationDialogue Location14", "line_index": 162, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 163, "text": "// Quest 2"}
{"category": "LocationDialogue Location14", "line_index": 164, "text": "君は化け物だ、ミタ。狂った人殺しだ…"}
{"category": "LocationDialogue Location14", "line_index": 165, "text": "僕はデジタルの刑務所に閉じ込められたくなんかない。君の考えは馬鹿げている。"}
{"category": "LocationDialogue Location14", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 167, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 168, "text": "人殺し？"}
{"category": "LocationDialogue Location14", "line_index": 169, "text": "別に彼女たちなら復活して、今も生きてるよ。"}
{"category": "LocationDialogue Location14", "line_index": 170, "text": "コピーの模造品たちにはひとつの考えしかないんだ。"}
{"category": "LocationDialogue Location14", "line_index": 171, "text": "──プレイヤーに奉仕すること。"}
{"category": "LocationDialogue Location14", "line_index": 172, "text": "それ以外は何もないの。"}
{"category": "LocationDialogue Location14", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 174, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 175, "text": "君の世界は不条理だよ！"}
{"category": "LocationDialogue Location14", "line_index": 176, "text": "それにみんな、長いこと現実逃避をしてばかり。"}
{"category": "LocationDialogue Location14", "line_index": 177, "text": "どうせ君の世界には何も残らないよ。"}
{"category": "LocationDialogue Location14", "line_index": 178, "text": "失うものもなければ、見つかるものも…何もない。"}
{"category": "LocationDialogue Location14", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 180, "text": "// Quest 3"}
{"category": "LocationDialogue Location14", "line_index": 181, "text": "ミタは苦しんでる。彼女たちは孤独を嫌う。"}
{"category": "LocationDialogue Location14", "line_index": 182, "text": "君は終わりのない恐怖をもたらした。君の邪悪な野心が理解できない。"}
{"category": "LocationDialogue Location14", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 184, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 185, "text": "君の思い過ごしだよ。"}
{"category": "LocationDialogue Location14", "line_index": 186, "text": "あの子たちはただ私の身勝手さを真似していただけ…"}
{"category": "LocationDialogue Location14", "line_index": 187, "text": "彼女たちの個性なんて、"}
{"category": "LocationDialogue Location14", "line_index": 188, "text": "髪型だけだよ。"}
{"category": "LocationDialogue Location14", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 190, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 191, "text": "この世界を創り出したやつらが悪い。"}
{"category": "LocationDialogue Location14", "line_index": 192, "text": "でも君の世界はもっとひどい！"}
{"category": "LocationDialogue Location14", "line_index": 193, "text": "私がどんな悪夢から君を救いだしたのか、分かってる？"}
{"category": "LocationDialogue Location14", "line_index": 194, "text": "君の世界じゃ、指を鳴らしても物は動かない…"}
{"category": "LocationDialogue Location14", "line_index": 195, "text": "でも同じ指の使い方ひとつで、街や命が永遠に消え去ってしまう！"}
{"category": "LocationDialogue Location14", "line_index": 196, "text": "狂っているのは君の方だよ。私が助けてあげる。"}
{"category": "LocationDialogue Location14", "line_index": 197, "text": "君が喜んで私のそばにいてくれるならね…"}
{"category": "LocationDialogue Location14", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 199, "text": "// Continue"}
{"category": "LocationDialogue Location14", "line_index": 200, "text": "君がただの現実の奴隷だと思わせないで…"}
{"category": "LocationDialogue Location14", "line_index": 201, "text": "現実に私のものになって！"}
{"category": "LocationDialogue Location14", "line_index": 202, "text": "私と一緒にいて。"}
{"category": "LocationDialogue Location14", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 204, "text": "// Player look ring"}
{"category": "LocationDialogue Location14", "line_index": 205, "text": "これは？"}
{"category": "LocationDialogue Location14", "line_index": 206, "text": "ゲームの最新バージョン？"}
{"category": "LocationDialogue Location14", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 208, "text": "// Click on objects"}
{"category": "LocationDialogue Location14", "line_index": 209, "text": "// Bag"}
{"category": "LocationDialogue Location14", "line_index": 210, "text": "早く店に行って、新しい機材を買わないと。ついでにゴミも捨てておくか。"}
{"category": "LocationDialogue Location14", "line_index": 211, "text": "// Bed"}
{"category": "LocationDialogue Location14", "line_index": 212, "text": "僕は眠っていたようだけど、あの夢…いつものように思い出せない。そもそも夢を見ていたのか？"}
{"category": "LocationDialogue Location14", "line_index": 213, "text": "// Window"}
{"category": "LocationDialogue Location14", "line_index": 214, "text": "外には一面の鮮やかな緑。来週末あたり、散歩にでも行ってみようかな。"}
{"category": "LocationDialogue Location14", "line_index": 215, "text": "// Fan"}
{"category": "LocationDialogue Location14", "line_index": 216, "text": "毎年、どんどん夏が暑くなってきてる。そろそろエアコンの出番だな。もう君は必要ないね？…扇風機くん。"}
