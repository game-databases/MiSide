{"category": "LocationDialogue Location9", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "ねえ、きみ！"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "やっほー！"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "ここから出たい？"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "だったらカギ探しを手伝って！"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "サイアク！カギなんてないじゃん！"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "空っぽ！"}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "なーんにもない！"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "見つけた！"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// The usual conversation"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "きみってもっと小さいのかと思ってた！"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "でも結構大きいんだね！"}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "お姉ちゃんみたい！"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "え…お姉ちゃん？"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "そうだよ、お姉ちゃん！"}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "会ったことないなんて言わせないよ！"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "君は会ったことあるの？控えめに言って。"}
{"category": "LocationDialogue Location9", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "…きみってばかなの？"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "ええっと…"}
{"category": "LocationDialogue Location9", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "やっぱりばかだ…"}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "まあいいや、カギがありそうな場所を教えて！"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// Next work"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "ここでいっか。"}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "ダクトの中に鉄を入れて！"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "ありがとー！"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "次はそこの薪を降ろして！"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "さんきゅー！"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "手を貸して！"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "おっけー！次は…"}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "きれいだから見てて。"}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "押して！ほら！"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "やった！"}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "あげる！手に取って！"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "このカギはきみのだよ！"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// Quest 1 (Are you Mita?)"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "私は\"ちびミタ.fbx\"だよ！"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "たくさんのセリフに、"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "最高にシンプルな衣裳。"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "それに究極の美髪！"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// Quest 2 (Have we seen each other yet?)"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "ああ！本当に愛おしくて"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "おばかな先生…"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "なんてくだらない質問なの…"}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "ま、"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "きみとは初めて会うんだけどね！"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "でも…"}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "もし誰かが、私の最高の\"イメージ\"を勝手に使おうものなら、"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "良心の呵責に苛まれるさ！"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// Quest 3 (Why are you here?)"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "まだわからない？"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "ここはチェックポイント！"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "きみの頭脳を見たかったんだ！"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "ともかく！"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "私が迷える子羊を導いてあげてるの！"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// Quest 4 (Why are you helping me?)"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "きみ…何様のつもり？"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "協力しちゃダメなの？"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "え？"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "とぼけてる…"}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "いきなり現れたくせに！"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "ここはきみの居場所じゃないよ。"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "だから協力してあげてるの！"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "ばいばい！冴えないおにいちゃん！"}
