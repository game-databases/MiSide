{"category": "LocationDialogue Location3", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 1, "text": "あっ、[player]！"}
{"category": "LocationDialogue Location3", "line_index": 2, "text": "やっと会えたね…"}
{"category": "LocationDialogue Location3", "line_index": 3, "text": "すっごくうれしいよ！"}
{"category": "LocationDialogue Location3", "line_index": 4, "text": "聞きたいことはたくさんあると思うけど…"}
{"category": "LocationDialogue Location3", "line_index": 5, "text": "ほら、見ての通りだよ。"}
{"category": "LocationDialogue Location3", "line_index": 6, "text": "私がこの特別な装置を作ったの。"}
{"category": "LocationDialogue Location3", "line_index": 7, "text": "一秒でも早く私のところに来てほしくて。"}
{"category": "LocationDialogue Location3", "line_index": 8, "text": "でもどういうわけか、君はゲームの別のバージョンの中に入り込んじゃったみたい。"}
{"category": "LocationDialogue Location3", "line_index": 9, "text": "その中で私は…"}
{"category": "LocationDialogue Location3", "line_index": 10, "text": "あ、話せば長くなるの！"}
{"category": "LocationDialogue Location3", "line_index": 11, "text": "とにかく、君に会えてよかった！"}
{"category": "LocationDialogue Location3", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 13, "text": "// Answer 1 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 14, "text": "私がミタだよ。"}
{"category": "LocationDialogue Location3", "line_index": 15, "text": "君はどう？ [player]さん。"}
{"category": "LocationDialogue Location3", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 17, "text": "// Answer 2 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 18, "text": "もう戻りたいの？"}
{"category": "LocationDialogue Location3", "line_index": 19, "text": "う―ん、手配はできると思うけど、私のことはどうするの？"}
{"category": "LocationDialogue Location3", "line_index": 20, "text": "一緒にいようよ…"}
{"category": "LocationDialogue Location3", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 22, "text": "// Answer 3 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 23, "text": "今から説明するね…"}
{"category": "LocationDialogue Location3", "line_index": 24, "text": "それで君はここにいるの！"}
{"category": "LocationDialogue Location3", "line_index": 25, "text": "理解できた？"}
{"category": "LocationDialogue Location3", "line_index": 26, "text": "まったく。"}
{"category": "LocationDialogue Location3", "line_index": 27, "text": "まあ、大したことじゃないよ。"}
{"category": "LocationDialogue Location3", "line_index": 28, "text": "重要なのは、今私たちが一緒にいることだよ。"}
{"category": "LocationDialogue Location3", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 31, "text": "お腹すいてる？"}
{"category": "LocationDialogue Location3", "line_index": 32, "text": "一緒に料理しない？"}
{"category": "LocationDialogue Location3", "line_index": 33, "text": "こっち"}
{"category": "LocationDialogue Location3", "line_index": 34, "text": "ニンジンをお願い。"}
{"category": "LocationDialogue Location3", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 36, "text": "この野菜はどこから来たんだ？"}
{"category": "LocationDialogue Location3", "line_index": 37, "text": "さっきまで何もなかったのに。"}
{"category": "LocationDialogue Location3", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 39, "text": "[player]、私たちは今ゲームの中だよ。"}
{"category": "LocationDialogue Location3", "line_index": 40, "text": "ほら、手伝って。"}
{"category": "LocationDialogue Location3", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 42, "text": "ありがとう。"}
{"category": "LocationDialogue Location3", "line_index": 43, "text": "ハサミをもらえる？"}
{"category": "LocationDialogue Location3", "line_index": 44, "text": "バスルームにあるよ。"}
{"category": "LocationDialogue Location3", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 46, "text": "まずは座って。"}
{"category": "LocationDialogue Location3", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 49, "text": "// Kitchen"}
{"category": "LocationDialogue Location3", "line_index": 50, "text": "ソースはどう？"}
{"category": "LocationDialogue Location3", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 52, "text": "要らない。"}
{"category": "LocationDialogue Location3", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 54, "text": "残念…"}
{"category": "LocationDialogue Location3", "line_index": 55, "text": "もっと風味豊かになるのに。"}
{"category": "LocationDialogue Location3", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 58, "text": "ありがとう"}
{"category": "LocationDialogue Location3", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 60, "text": "もう全部食べたの？"}
{"category": "LocationDialogue Location3", "line_index": 61, "text": "私の分は全然"}
{"category": "LocationDialogue Location3", "line_index": 62, "text": "減らないよ。"}
{"category": "LocationDialogue Location3", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 65, "text": "// Help"}
{"category": "LocationDialogue Location3", "line_index": 66, "text": "大丈夫？"}
{"category": "LocationDialogue Location3", "line_index": 67, "text": "どんな感覚か教えて？"}
{"category": "LocationDialogue Location3", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 69, "text": "心臓がバクバクして、"}
{"category": "LocationDialogue Location3", "line_index": 70, "text": "目もチカチカする。"}
{"category": "LocationDialogue Location3", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 72, "text": "そっか、わかった。"}
{"category": "LocationDialogue Location3", "line_index": 73, "text": "あれかもしれない。"}
{"category": "LocationDialogue Location3", "line_index": 74, "text": "起きあがれる？"}
{"category": "LocationDialogue Location3", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 78, "text": "これは何？"}
{"category": "LocationDialogue Location3", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 80, "text": "薬だよ。"}
{"category": "LocationDialogue Location3", "line_index": 81, "text": "すぐに気分が良くなるから。"}
{"category": "LocationDialogue Location3", "line_index": 82, "text": "鏡の前に立ってみて。"}
{"category": "LocationDialogue Location3", "line_index": 83, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 84, "text": "ほら、飲んで。"}
{"category": "LocationDialogue Location3", "line_index": 85, "text": "待ってるから。"}
{"category": "LocationDialogue Location3", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 89, "text": "気分はどう？"}
{"category": "LocationDialogue Location3", "line_index": 90, "text": "良くなった？"}
{"category": "LocationDialogue Location3", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 92, "text": "うん"}
{"category": "LocationDialogue Location3", "line_index": 93, "text": "効くの早くない？"}
{"category": "LocationDialogue Location3", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 95, "text": "[player]、私たちはゲームの中にいるんだよ。"}
{"category": "LocationDialogue Location3", "line_index": 96, "text": "ここでは何もかもがずっとシンプルなの。"}
{"category": "LocationDialogue Location3", "line_index": 97, "text": "ちょっと頑張っただけで、"}
{"category": "LocationDialogue Location3", "line_index": 98, "text": "とっても大きな成果が得られるんだ。"}
{"category": "LocationDialogue Location3", "line_index": 99, "text": "それはゲームの条件なの。"}
{"category": "LocationDialogue Location3", "line_index": 100, "text": "\"単純化\""}
{"category": "LocationDialogue Location3", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 102, "text": "例えば？"}
{"category": "LocationDialogue Location3", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 104, "text": "ニンジン…"}
{"category": "LocationDialogue Location3", "line_index": 105, "text": "１本を切っただけで"}
{"category": "LocationDialogue Location3", "line_index": 106, "text": "３本分がすぐにできあがる。"}
{"category": "LocationDialogue Location3", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 108, "text": "ねえ、すべてが唐突すぎて、"}
{"category": "LocationDialogue Location3", "line_index": 109, "text": "この状況が本当に怖いんだ…"}
{"category": "LocationDialogue Location3", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 112, "text": "何かおかしいの？"}
{"category": "LocationDialogue Location3", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 114, "text": "通気口にカートリッジを見つけた。"}
{"category": "LocationDialogue Location3", "line_index": 115, "text": "名前のラベルが付いてるやつ。"}
{"category": "LocationDialogue Location3", "line_index": 116, "text": "あれは一体？"}
{"category": "LocationDialogue Location3", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 118, "text": "カートリッジ？"}
{"category": "LocationDialogue Location3", "line_index": 119, "text": "どんなの？"}
{"category": "LocationDialogue Location3", "line_index": 120, "text": "一緒に調べようよ。"}
{"category": "LocationDialogue Location3", "line_index": 121, "text": "でもその前に、"}
{"category": "LocationDialogue Location3", "line_index": 122, "text": "まずはご飯を食べよう。"}
{"category": "LocationDialogue Location3", "line_index": 123, "text": "ハサミを頂戴。"}
{"category": "LocationDialogue Location3", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 125, "text": "// Ring"}
{"category": "LocationDialogue Location3", "line_index": 126, "text": "指輪？"}
{"category": "LocationDialogue Location3", "line_index": 127, "text": "// Mirror"}
{"category": "LocationDialogue Location3", "line_index": 128, "text": "なぜ反射しない鏡があるんだ？"}
{"category": "LocationDialogue Location3", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 130, "text": "あ、そうだった。"}
{"category": "LocationDialogue Location3", "line_index": 131, "text": "反射をつけるのを忘れてた…"}
{"category": "LocationDialogue Location3", "line_index": 132, "text": "ほら！"}
{"category": "LocationDialogue Location3", "line_index": 133, "text": "これで反射するよ。"}
{"category": "LocationDialogue Location3", "line_index": 134, "text": "あ、そういえば。"}
{"category": "LocationDialogue Location3", "line_index": 135, "text": "前は反射が何なのかさえ知らなかったの。"}
{"category": "LocationDialogue Location3", "line_index": 136, "text": "この世界には存在しなかったんだ。"}
{"category": "LocationDialogue Location3", "line_index": 137, "text": "アップデートがあるまではね。"}
{"category": "LocationDialogue Location3", "line_index": 138, "text": "君の世界にはたくさんの"}
{"category": "LocationDialogue Location3", "line_index": 139, "text": "反射があるの？"}
{"category": "LocationDialogue Location3", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 141, "text": "まあ、そうだね。"}
{"category": "LocationDialogue Location3", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 144, "text": "覚えてる？"}
{"category": "LocationDialogue Location3", "line_index": 145, "text": "君は３つのものをもってきて、"}
{"category": "LocationDialogue Location3", "line_index": 146, "text": "このスキャナーに置いたよね。"}
{"category": "LocationDialogue Location3", "line_index": 147, "text": "そう、だから…"}
{"category": "LocationDialogue Location3", "line_index": 148, "text": "これらのものは、"}
{"category": "LocationDialogue Location3", "line_index": 149, "text": "このバージョンの世界と接続されたの。"}
{"category": "LocationDialogue Location3", "line_index": 150, "text": "それで今、君はここにいる。"}
{"category": "LocationDialogue Location3", "line_index": 151, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 152, "text": "// Movbile TV"}
{"category": "LocationDialogue Location3", "line_index": 153, "text": "あのテレビは"}
{"category": "LocationDialogue Location3", "line_index": 154, "text": "僕が買ったんだ。"}
{"category": "LocationDialogue Location3", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 156, "text": "そうだよ。"}
{"category": "LocationDialogue Location3", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 158, "text": "でもこの前"}
{"category": "LocationDialogue Location3", "line_index": 159, "text": "壊れたって。"}
{"category": "LocationDialogue Location3", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 161, "text": "えっとね、私は君に"}
{"category": "LocationDialogue Location3", "line_index": 162, "text": "サプライズをしたかったの！"}
{"category": "LocationDialogue Location3", "line_index": 163, "text": "ここに連れてくるためにね。"}
{"category": "LocationDialogue Location3", "line_index": 164, "text": "だからちょっとだけ嘘をついたんだ。"}
{"category": "LocationDialogue Location3", "line_index": 165, "text": "これで画面に情報が表示されるよ。"}
{"category": "LocationDialogue Location3", "line_index": 166, "text": "あのね、そういえば…"}
{"category": "LocationDialogue Location3", "line_index": 167, "text": "私ってちょっとしたエンジニアなの！"}
{"category": "LocationDialogue Location3", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 169, "text": "// School cloth"}
{"category": "LocationDialogue Location3", "line_index": 170, "text": "これは何？"}
{"category": "LocationDialogue Location3", "line_index": 171, "text": "学校の制服？"}
{"category": "LocationDialogue Location3", "line_index": 172, "text": "なんで必要なの？"}
{"category": "LocationDialogue Location3", "line_index": 173, "text": "学校にでも行くの？"}
{"category": "LocationDialogue Location3", "line_index": 174, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 175, "text": "学校？"}
{"category": "LocationDialogue Location3", "line_index": 176, "text": "ううん。要らないよ。"}
{"category": "LocationDialogue Location3", "line_index": 177, "text": "でも制服はかわいいの。"}
{"category": "LocationDialogue Location3", "line_index": 178, "text": "それに着てると"}
{"category": "LocationDialogue Location3", "line_index": 179, "text": "自分もかわいく見せられる。"}
{"category": "LocationDialogue Location3", "line_index": 180, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 181, "text": "// PC"}
{"category": "LocationDialogue Location3", "line_index": 182, "text": "このパソコンは動くの？"}
{"category": "LocationDialogue Location3", "line_index": 183, "text": "それともただの飾り？"}
{"category": "LocationDialogue Location3", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 185, "text": "もちろん動くよ。"}
{"category": "LocationDialogue Location3", "line_index": 186, "text": "ここにあるものは全部"}
{"category": "LocationDialogue Location3", "line_index": 187, "text": "君の世界と同じように機能するよ。"}
{"category": "LocationDialogue Location3", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 189, "text": "僕の世界だと。"}
{"category": "LocationDialogue Location3", "line_index": 190, "text": "僕はよく自分のパソコンの前に座って…"}
{"category": "LocationDialogue Location3", "line_index": 191, "text": "仕事をしてるよ。"}
{"category": "LocationDialogue Location3", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 193, "text": "知ってるよ。"}
{"category": "LocationDialogue Location3", "line_index": 194, "text": "そのお仕事のせいで"}
{"category": "LocationDialogue Location3", "line_index": 195, "text": "君はあんまり"}
{"category": "LocationDialogue Location3", "line_index": 196, "text": "私にかまってくれないんだもん…"}
{"category": "LocationDialogue Location3", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 198, "text": "生活のためには仕方ないんだ。"}
{"category": "LocationDialogue Location3", "line_index": 199, "text": "でも、どうして知ってたの？"}
{"category": "LocationDialogue Location3", "line_index": 200, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 201, "text": "スマホのカメラが時々オンになってたでしょ？"}
{"category": "LocationDialogue Location3", "line_index": 202, "text": "ごめんね。"}
{"category": "LocationDialogue Location3", "line_index": 203, "text": "その時に覗いてたの。"}
{"category": "LocationDialogue Location3", "line_index": 204, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 205, "text": "分かるだろ、それはあまりよくないことだ。"}
{"category": "LocationDialogue Location3", "line_index": 206, "text": "まあ、いいや。"}
{"category": "LocationDialogue Location3", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 208, "text": "// Umbrella"}
{"category": "LocationDialogue Location3", "line_index": 209, "text": "何回プレイしても、"}
{"category": "LocationDialogue Location3", "line_index": 210, "text": "雨は降ったことがなかった。"}
{"category": "LocationDialogue Location3", "line_index": 211, "text": "その傘は何に使うんだ？"}
{"category": "LocationDialogue Location3", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 213, "text": "雨はとっても珍しいの。"}
{"category": "LocationDialogue Location3", "line_index": 214, "text": "君はまだ見たことがないんだね。"}
{"category": "LocationDialogue Location3", "line_index": 215, "text": "いつか出会う日が来るかも。"}
{"category": "LocationDialogue Location3", "line_index": 216, "text": "それで傘が必要になるんだ。"}
{"category": "LocationDialogue Location3", "line_index": 217, "text": "後になればわかるよ。"}
{"category": "LocationDialogue Location3", "line_index": 218, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 219, "text": "// Electrical panel"}
{"category": "LocationDialogue Location3", "line_index": 220, "text": "なんでここに分電盤が？"}
{"category": "LocationDialogue Location3", "line_index": 221, "text": "僕たちがゲームの中にいるとしたら、"}
{"category": "LocationDialogue Location3", "line_index": 222, "text": "一体何のためのものなんだ？"}
{"category": "LocationDialogue Location3", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 224, "text": "まず第一に"}
{"category": "LocationDialogue Location3", "line_index": 225, "text": "私たちはゲームの中にいるよ。"}
{"category": "LocationDialogue Location3", "line_index": 226, "text": "だから「どうして」って聞くのは"}
{"category": "LocationDialogue Location3", "line_index": 227, "text": "意味のないことなの。"}
{"category": "LocationDialogue Location3", "line_index": 228, "text": "でもね、ブレーカーは実際に"}
{"category": "LocationDialogue Location3", "line_index": 229, "text": "電源を再起動できるよ。"}
{"category": "LocationDialogue Location3", "line_index": 230, "text": "君の世界に基づいて"}
{"category": "LocationDialogue Location3", "line_index": 231, "text": "作られてるんだから。"}
{"category": "LocationDialogue Location3", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 233, "text": "// Exit door"}
{"category": "LocationDialogue Location3", "line_index": 234, "text": "外に行けたりする？"}
{"category": "LocationDialogue Location3", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 236, "text": "あっ…"}
{"category": "LocationDialogue Location3", "line_index": 237, "text": "まだダメ。"}
{"category": "LocationDialogue Location3", "line_index": 238, "text": "後にしよう？"}
{"category": "LocationDialogue Location3", "line_index": 239, "text": "しばらくはこのまま"}
{"category": "LocationDialogue Location3", "line_index": 240, "text": "家にいようよ。"}
{"category": "LocationDialogue Location3", "line_index": 241, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 242, "text": "// Books"}
{"category": "LocationDialogue Location3", "line_index": 243, "text": "本がたくさんあるんだね。"}
{"category": "LocationDialogue Location3", "line_index": 244, "text": "読んだりしてるの？"}
{"category": "LocationDialogue Location3", "line_index": 245, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 246, "text": "もう全部読んだよ。"}
{"category": "LocationDialogue Location3", "line_index": 247, "text": "ひとりでここにいると、"}
{"category": "LocationDialogue Location3", "line_index": 248, "text": "とっても、とーっても…退屈なの。"}
{"category": "LocationDialogue Location3", "line_index": 249, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 250, "text": "// TV in room kitchen"}
{"category": "LocationDialogue Location3", "line_index": 251, "text": "なんでテレビが２台も要るんだ？"}
{"category": "LocationDialogue Location3", "line_index": 252, "text": "しかもこんな古い機種。"}
{"category": "LocationDialogue Location3", "line_index": 253, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 254, "text": "気に入らない？"}
{"category": "LocationDialogue Location3", "line_index": 255, "text": "削除することもできるよ。"}
{"category": "LocationDialogue Location3", "line_index": 256, "text": "とはいえ…"}
{"category": "LocationDialogue Location3", "line_index": 257, "text": "ただの飾りなの。"}
{"category": "LocationDialogue Location3", "line_index": 258, "text": "キッチンの装飾のひとつ。"}
{"category": "LocationDialogue Location3", "line_index": 259, "text": "まだ現役で動くんだよ！"}
{"category": "LocationDialogue Location3", "line_index": 260, "text": "昔のアニメだって"}
{"category": "LocationDialogue Location3", "line_index": 261, "text": "見られるの！"}
{"category": "LocationDialogue Location3", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 263, "text": "// Smartphone"}
{"category": "LocationDialogue Location3", "line_index": 264, "text": "僕のスマホ。"}
{"category": "LocationDialogue Location3", "line_index": 265, "text": "ポケットからなくなってたんだ。"}
{"category": "LocationDialogue Location3", "line_index": 266, "text": "どうしてここに？"}
{"category": "LocationDialogue Location3", "line_index": 267, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 268, "text": "うーん…それは気にしないで。"}
{"category": "LocationDialogue Location3", "line_index": 269, "text": "あ、提案なんだけど、"}
{"category": "LocationDialogue Location3", "line_index": 270, "text": "ふたりで写真を撮らない？"}
{"category": "LocationDialogue Location3", "line_index": 271, "text": "見て。"}
{"category": "LocationDialogue Location3", "line_index": 272, "text": "素敵な写真！"}
{"category": "LocationDialogue Location3", "line_index": 273, "text": "記念になるね。"}
{"category": "LocationDialogue Location3", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 275, "text": "ひとつ聞いてもいい？"}
{"category": "LocationDialogue Location3", "line_index": 276, "text": "もしも今、"}
{"category": "LocationDialogue Location3", "line_index": 277, "text": "そのスマホでゲームを立ち上げたら、"}
{"category": "LocationDialogue Location3", "line_index": 278, "text": "君がゲームに出てくるかな？"}
{"category": "LocationDialogue Location3", "line_index": 279, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 280, "text": "そこには誰もいないよ。"}
{"category": "LocationDialogue Location3", "line_index": 281, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 282, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 283, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 284, "text": "// TV"}
{"category": "LocationDialogue Location3", "line_index": 285, "text": "チャンネル何個あるの？"}
{"category": "LocationDialogue Location3", "line_index": 286, "text": "そのテレビには。"}
{"category": "LocationDialogue Location3", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 288, "text": "うーん…有線じゃないからね。"}
{"category": "LocationDialogue Location3", "line_index": 289, "text": "インターネットだから、"}
{"category": "LocationDialogue Location3", "line_index": 290, "text": "なんでも見れるよ。"}
{"category": "LocationDialogue Location3", "line_index": 291, "text": "インターネットにあるものなら…"}
{"category": "LocationDialogue Location3", "line_index": 292, "text": "待って。"}
{"category": "LocationDialogue Location3", "line_index": 293, "text": "わっ…"}
{"category": "LocationDialogue Location3", "line_index": 294, "text": "何これ？"}
{"category": "LocationDialogue Location3", "line_index": 295, "text": "子猫？"}
{"category": "LocationDialogue Location3", "line_index": 296, "text": "わあ、見て。"}
{"category": "LocationDialogue Location3", "line_index": 297, "text": "ねえねえ…"}
{"category": "LocationDialogue Location3", "line_index": 298, "text": "今だ！"}
{"category": "LocationDialogue Location3", "line_index": 299, "text": "ジュース飲む？"}
{"category": "LocationDialogue Location3", "line_index": 300, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 301, "text": "奇妙な広告だった…"}
{"category": "LocationDialogue Location3", "line_index": 302, "text": "ジュースは死んだの？"}
{"category": "LocationDialogue Location3", "line_index": 303, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 304, "text": "うん。それでジュースが"}
{"category": "LocationDialogue Location3", "line_index": 305, "text": "ジュースになったの。"}
{"category": "LocationDialogue Location3", "line_index": 306, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 308, "text": "この味…"}
{"category": "LocationDialogue Location3", "line_index": 309, "text": "好きかも。"}
{"category": "LocationDialogue Location3", "line_index": 310, "text": "でも味をうまく言い表せない。"}
{"category": "LocationDialogue Location3", "line_index": 311, "text": "混乱してきた。"}
{"category": "LocationDialogue Location3", "line_index": 312, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 313, "text": "わかった。"}
{"category": "LocationDialogue Location3", "line_index": 314, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 315, "text": "// Mita shy"}
{"category": "LocationDialogue Location3", "line_index": 316, "text": "何してるの？"}
{"category": "LocationDialogue Location3", "line_index": 317, "text": "やめてよ。"}
{"category": "LocationDialogue Location3", "line_index": 318, "text": "恥ずかしいから。"}
{"category": "LocationDialogue Location3", "line_index": 319, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 320, "text": "// The statuette"}
{"category": "LocationDialogue Location3", "line_index": 321, "text": "不気味なフィギュアだ。"}
{"category": "LocationDialogue Location3", "line_index": 322, "text": "こういうのが"}
{"category": "LocationDialogue Location3", "line_index": 323, "text": "好きなの？"}
{"category": "LocationDialogue Location3", "line_index": 324, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 325, "text": "不気味？"}
{"category": "LocationDialogue Location3", "line_index": 326, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 327, "text": "うん。"}
{"category": "LocationDialogue Location3", "line_index": 328, "text": "呪われてそう…"}
{"category": "LocationDialogue Location3", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 330, "text": "呪われていないし、"}
{"category": "LocationDialogue Location3", "line_index": 331, "text": "不気味でもないよ。"}
{"category": "LocationDialogue Location3", "line_index": 332, "text": "なんならかわいい方だよ。"}
{"category": "LocationDialogue Location3", "line_index": 333, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 334, "text": "まあ、そう言われたら…"}
{"category": "LocationDialogue Location3", "line_index": 335, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 336, "text": "ミタ？"}
{"category": "LocationDialogue Location3", "line_index": 337, "text": "どうしたの？"}
{"category": "LocationDialogue Location3", "line_index": 338, "text": "// Mita kitchen"}
{"category": "LocationDialogue Location3", "line_index": 339, "text": "おしゃべりしない？"}
{"category": "LocationDialogue Location3", "line_index": 340, "text": "食事の前に。"}
{"category": "LocationDialogue Location3", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 342, "text": "// Start Eat"}
{"category": "LocationDialogue Location3", "line_index": 343, "text": "ボナペティ！"}
{"category": "LocationDialogue Location3", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 345, "text": "// Quest 1"}
{"category": "LocationDialogue Location3", "line_index": 346, "text": "そうでしょ？"}
{"category": "LocationDialogue Location3", "line_index": 347, "text": "ずっとここにいていいよ。"}
{"category": "LocationDialogue Location3", "line_index": 348, "text": "私は気にしないし、"}
{"category": "LocationDialogue Location3", "line_index": 349, "text": "むしろ"}
{"category": "LocationDialogue Location3", "line_index": 350, "text": "大歓迎！"}
{"category": "LocationDialogue Location3", "line_index": 351, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 352, "text": "// Quest 2"}
{"category": "LocationDialogue Location3", "line_index": 353, "text": "戻りたいの？"}
{"category": "LocationDialogue Location3", "line_index": 354, "text": "でもどうして？"}
{"category": "LocationDialogue Location3", "line_index": 355, "text": "ここはとっても暖かいし…"}
{"category": "LocationDialogue Location3", "line_index": 356, "text": "暖かいのって素敵でしょ？"}
{"category": "LocationDialogue Location3", "line_index": 357, "text": "それに私もいるんだよ。"}
{"category": "LocationDialogue Location3", "line_index": 358, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 359, "text": "いや、そうじゃなくて、"}
{"category": "LocationDialogue Location3", "line_index": 360, "text": "ここに残るのは大丈夫だけど、"}
{"category": "LocationDialogue Location3", "line_index": 361, "text": "気がかりがあるんだ。"}
{"category": "LocationDialogue Location3", "line_index": 362, "text": "家に忘れ物をしたかもしれなくて…"}
{"category": "LocationDialogue Location3", "line_index": 363, "text": "ほら、突然ここに来たから、"}
{"category": "LocationDialogue Location3", "line_index": 364, "text": "なにも準備を"}
{"category": "LocationDialogue Location3", "line_index": 365, "text": "してこなかったんだ。"}
{"category": "LocationDialogue Location3", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 367, "text": "ごめんなさい。そこまで気にしてあげられなかった。"}
{"category": "LocationDialogue Location3", "line_index": 368, "text": "// Quest 3"}
{"category": "LocationDialogue Location3", "line_index": 369, "text": "ここから逃げるつもり？"}
{"category": "LocationDialogue Location3", "line_index": 370, "text": "何もかも忘れて？"}
{"category": "LocationDialogue Location3", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 372, "text": "いや。"}
{"category": "LocationDialogue Location3", "line_index": 373, "text": "ふと思ったんだ。"}
{"category": "LocationDialogue Location3", "line_index": 374, "text": "ここはとても豊かだけど…不自然すぎる。"}
{"category": "LocationDialogue Location3", "line_index": 375, "text": "とはいえ、"}
{"category": "LocationDialogue Location3", "line_index": 376, "text": "君はかなり本物に見えるけど。"}
{"category": "LocationDialogue Location3", "line_index": 377, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 378, "text": "見える？"}
{"category": "LocationDialogue Location3", "line_index": 379, "text": "私は本物だよ！"}
{"category": "LocationDialogue Location3", "line_index": 380, "text": "ばかっ"}
{"category": "LocationDialogue Location3", "line_index": 381, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 382, "text": "// Quest 4"}
{"category": "LocationDialogue Location3", "line_index": 383, "text": "それはこの世界の"}
{"category": "LocationDialogue Location3", "line_index": 384, "text": "特性なの。"}
{"category": "LocationDialogue Location3", "line_index": 385, "text": "君には奇妙に感じるかもしれないけど"}
{"category": "LocationDialogue Location3", "line_index": 386, "text": "遠くにある物は"}
{"category": "LocationDialogue Location3", "line_index": 387, "text": "見ることがてきないんだ。"}
{"category": "LocationDialogue Location3", "line_index": 388, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 389, "text": "そこまで気にならないね。"}
{"category": "LocationDialogue Location3", "line_index": 390, "text": "上品にすら見える。"}
{"category": "LocationDialogue Location3", "line_index": 391, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 392, "text": "よかった。"}
{"category": "LocationDialogue Location3", "line_index": 393, "text": "遅延を回避するためなの。"}
{"category": "LocationDialogue Location3", "line_index": 394, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 395, "text": "遅延を回避？"}
{"category": "LocationDialogue Location3", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 397, "text": "うん。まだバグが残ってるんだ。"}
{"category": "LocationDialogue Location3", "line_index": 398, "text": "君が遭遇しないよう祈ってるね。"}
{"category": "LocationDialogue Location3", "line_index": 399, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 400, "text": "// Quest 5"}
{"category": "LocationDialogue Location3", "line_index": 401, "text": "ハサミとナイフ？"}
{"category": "LocationDialogue Location3", "line_index": 402, "text": "確かにナイフでソースの袋を開けることもできたけど、"}
{"category": "LocationDialogue Location3", "line_index": 403, "text": "君が戻ってくるまでの間に"}
{"category": "LocationDialogue Location3", "line_index": 404, "text": "食卓の準備を"}
{"category": "LocationDialogue Location3", "line_index": 405, "text": "終えておきたかったの。"}
{"category": "LocationDialogue Location3", "line_index": 406, "text": "私、サプライズが大好きなんだ！"}
{"category": "LocationDialogue Location3", "line_index": 407, "text": "準備もすぐに終わったよ。"}
{"category": "LocationDialogue Location3", "line_index": 408, "text": "えへへ。"}
{"category": "LocationDialogue Location3", "line_index": 409, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 410, "text": "// Glasses"}
{"category": "LocationDialogue Location3", "line_index": 411, "text": "いつも眼鏡をかけてるの？"}
{"category": "LocationDialogue Location3", "line_index": 412, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 413, "text": "ううん。"}
{"category": "LocationDialogue Location3", "line_index": 414, "text": "でもかけることはできるよ。"}
{"category": "LocationDialogue Location3", "line_index": 415, "text": "私に似合うかな？"}
{"category": "LocationDialogue Location3", "line_index": 416, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 417, "text": "さ、行こう。"}
{"category": "LocationDialogue Location3", "line_index": 418, "text": "これからはかけたままにするね。"}
{"category": "LocationDialogue Location3", "line_index": 419, "text": "// No"}
{"category": "LocationDialogue Location3", "line_index": 420, "text": "ふうん、"}
{"category": "LocationDialogue Location3", "line_index": 421, "text": "まあいいや…"}
{"category": "LocationDialogue Location3", "line_index": 422, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 423, "text": "// Use the sauce"}
{"category": "LocationDialogue Location3", "line_index": 424, "text": "いいね。"}
{"category": "LocationDialogue Location3", "line_index": 425, "text": "これはなんのソース？"}
{"category": "LocationDialogue Location3", "line_index": 426, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 427, "text": "愛のソースだよ！"}
{"category": "LocationDialogue Location3", "line_index": 428, "text": "愛のフレーバーが入ってるの。"}
{"category": "LocationDialogue Location3", "line_index": 429, "text": "それに世界観のコントラスト…"}
{"category": "LocationDialogue Location3", "line_index": 430, "text": "変わってるって思うよね？"}
{"category": "LocationDialogue Location3", "line_index": 431, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 432, "text": "うん…"}
{"category": "LocationDialogue Location3", "line_index": 433, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 434, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location3", "line_index": 435, "text": "君のゲーム機？"}
{"category": "LocationDialogue Location3", "line_index": 436, "text": "カッコイイね。"}
