{"category": "LocationDialogue Location20", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "ミラ！？くそっ…！お前は病気だ！"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "あはは！見ーつけた！"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "良い表情してるじゃない。"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "さあ！もっと遊びましょう！"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "見てるだけじゃ飽きてきちゃった！"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\""}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "やあ、調子はどう？"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "走り回るのにも飽きてきたでしょ？"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "おい！ミラに何をした！？"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "まだそんな力が残ってるんだ。"}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "いいよ、また一緒に遊んであげる！"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "お前ってやつは…"}
{"category": "LocationDialogue Location20", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "ちょっとしたテストをしましょう！"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "協調性を試すの！"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "あとは君の行動パターンも！"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "君に問題があったらどうする！？"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "その誇らしげに身に着けてる\"皮\"には、"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "ふさわしくない存在かも…"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "さあ、見て。"}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "君はどっちを選ぶ？"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "右？"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "それとも"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "左？"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "君、本気で言ってるの？"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "何か違うように見えた？"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "ただの冗談だよ！"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "気にしないで。ナイフで戦うなんて時代遅れ…"}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "まあいいや。"}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "私、もっと面白いアイデアがあるの。"}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "まずは…"}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "これを見て！"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "音楽が欲しかったの！"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "この曲なんてどう？"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "最高にアガっちゃうよね！"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "よし、"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "まずはルール説明！"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rule"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "音楽が流れている間は"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "動いてもいいよ。"}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "でも音楽が止まったら、"}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "その場で動かないで！"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "じゃないと死ぬよ。"}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "ほら、ゴール目指して頑張って。"}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "君ならできるよ。"}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "ゲームを始めましょう！"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "なに立ち止まってるの？"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "走って！ほら、早く！"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "わあ！"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "君ってとっても従順！"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "みんなのお手本になるべきだよ。"}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "標本にして飾っておきたいくらい！"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "でも、君にはちょっと簡単すぎたかな？"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "もうやめてくれ！"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "気を抜いちゃダメ！"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "まだまだ色んなゲームがあるんだから。"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "それじゃあいくよ！"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "今から目を閉じるね…"}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "次に目を開けたときには、"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "君はしっかり隠れること！"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "分かった？"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "見つけたらお仕置きだから！"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "じゃあ、始めるよ！"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "こんなことは無意味だ…"}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "ゲームクリア！"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "よくできました！すごいすごい！"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "次はもっと難しくなるよ！"}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "何倍も何十倍も…"}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "逃げて！隠れて！走り回って！"}
{"category": "LocationDialogue Location20", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "くそっ！"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Player fall"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "どうやら、逃げられたみたいだ…"}
