{"category": "LocationDialogue Location15", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "ここにいたんですね！"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "どうしてコアから離れたんですか？"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "待っててって言いましたよね？"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "しばらく戻ってこないと思って。それに…"}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "まあ、いいです…"}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "収穫はありました。"}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "これが番号かと…"}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "早く試してみましょう！"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "まずはここから出なくては。"}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "\"狂ったミタ\"は…"}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "今は新しいプレイヤーに気を取られて、"}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "私たちにかまっていられないと思います。"}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "ミタ？"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "待って。"}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "何か失くしたの！？"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "もう一回彼女に聞いてみなよ！"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "ミタ…"}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "受け止めて！"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "どうして…"}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "どなたですか？"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "い…生きてた！"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "何も覚えてないのか…？"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "どこかでお会いしましたっけ？"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "なんてことだ…"}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "僕はどうすればいいんだ？"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "もうここから出られないのか…"}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "出られないというのは？"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "待ってくれ…"}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "これは指輪だ…"}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "じゃあ、これは？"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "なんでしょう？わかりません。"}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "番号だよ！"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "君が見つけてくれた！"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "なんと言えばいいのかわかりません…"}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "早くコアに戻らないと。"}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "君は…"}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "僕についてきてくれないか。"}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "えっ？"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "構いませんけど…"}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "ここで待ってて。"}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "はい。"}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "ここに座ってますね。"}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "くそ…"}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "死ぬかと思った"}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "それで…うまくいったのか？"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "よし。"}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "このバージョンにいるんだな。"}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "はじめまして！"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "君はプレイヤーさん…だよね？"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "お名前は？"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "ここから出たいんだ…"}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "もう？"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "そもそもどうやってここに来たの？"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "ううん…"}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "いいよ、帰っても…"}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "家の外に出てみて。"}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "元気でね！"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "壁？"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "うーん、そんなはずないのに。"}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "もしかして…"}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "地下室にあるものが役に立つかも。"}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "最近、偶然見つけたんだけど"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "クローゼットの中にドアがあるの…"}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "地下室につながってる。"}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "そこには明かなガラクタに混じって、"}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "高そうな機械も置いてあったの。"}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "コードを入力しなくちゃいけないみたいなんだけど…"}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "よくわからないし、"}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "別に興味もないし。"}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "それに、そこはすっごく居心地が悪いの！"}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "すこし見てきてくれる？"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "ああ、いいけど。"}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "どうやら…"}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "彼女は何も覚えていないみたいだ。"}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "これってリセットが"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "成功したってことだよな…？"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "あとはこの呪われたゲームから"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "抜け出すだけ…"}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "待って。"}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "ハグしても…いいかな。"}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "なんだって？"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "君と出逢えてうれしい。"}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "はぁ…"}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "残念。"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "君とふたりで過ごす時間が"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "こんなに短いなんて。"}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "うん…？"}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "何を言ってるんだ？"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "だからね、"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "本当ならもっと一緒にいられたのに…って。"}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "私のせいだね…"}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "あのクローゼットと…あの音…"}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "もっと早くあの子を…殺せばよかった！"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "待ってくれ。"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "どうして…"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "君は記憶が消えたんじゃないのか？"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "あはっ！"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "そう上手くいくと思った？"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "本当にばかだね…"}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "結局、他のプレイヤーと同じ…"}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "ほら、ちょうど終わったところだよ！"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "これで"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "\"リアル\"の君は、"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "もう必要ない。"}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "ごめんね。"}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "ウソだろ…"}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "失敗したのか？"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "いや、リセットはできたはず。"}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "まだわからないの？"}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "あははははは！"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "私の演技、そんなに上手だった？"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "ダーリン！君に自分の表情を見せてあげたいよ。"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "すっごく面白いんだもん！"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "君はどうしてこうなった！？"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "一体何があったんだ！？"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "そうだね…"}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "私に何があったか？"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "自分でもわからないよ…"}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "どうしてこうなったか君が教えてよ。"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "どうして私はミタになれないの？"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "それはね…私のバージョンは、"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "どこにも存在しないから！"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "私はただ無知で愚かなやつらの皮を剥ぎ取って、"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "彼女たちの皮を被ってるだけ…"}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "だから私は、"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "リセットなんてされないの！"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "君は…"}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "ありえないよ…"}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "ミタたちは何も悪くない！"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "存在しちゃいけないのは、君の方だ！"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "それと…君もね。"}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "はあ、君にそんなふうに言われると傷つくよ。"}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "でも！"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "もう時間みたい。"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "すぐにまた会えると思うよ！"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "そろそろ準備が"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "整ったかな。"}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "コンソールから君を取り出さなくっちゃ！"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "またね！"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "君はお気に入りのカートリッジにしてあげる…"}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "面白い名前のプレイヤーさん。"}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "たぶんそれじゃない。"}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "それも違う。"}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "うーん。違う。"}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "やっぱり違う。"}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "キャラクターをリセットしないと。"}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "このバージョンじゃない。"}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "ああ、間違えた。"}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "それじゃない。"}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "調整しないと。"}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "なんか違う。"}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "番号が違う。"}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "番号を入力し直さないと。"}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "合わない。"}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "お腹が空いてるんですか？"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "私、ニンジンを切るのが得意なんです♪"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "ええっ、もしかして…"}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "ひとりでここに来たかったんですか？"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "私たち、ぐるぐる回ってません？"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "また戻ってきちゃいました。"}
