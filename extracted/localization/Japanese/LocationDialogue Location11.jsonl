{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "やあ！"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "しまった！"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "ごめんなさい…"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "殺しちゃうとこだった。"}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "あ…私じゃなくて冷蔵庫か。"}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "君を殺しちゃいそうになったのは。"}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "私とは無関係。"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "信じて！"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "本当だよ！"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "ああ、信じるさ！"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "実を言うとね？"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "ここはとっても危険な場所なの。"}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "特に君にとっては。"}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "君は臆病じゃないよね！"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "面白いなあ。"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "君がこういう場所を"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "通っていくのを眺めるのは…"}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "さあ、走って！"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "すぐに追いつくから！"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "がんばれ、がんばれ！"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "ああ、楽しい！"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "ケーブルカーに向かってるんだね。"}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "あれはバージョンの間で"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "いちばん長い道のり…"}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "霧の中の住人と"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "君がどうやって向き合うのか…"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "気になるところだね。"}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "何してるの！？"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "もう…"}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "見ないでよ！"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "ばかっ！"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "本当にばか…"}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "ふうん、そっか…"}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "幸運を祈ってるよ！"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "だれ…？"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "いるのはわかってる…"}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "私の話をきいて…"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "きみはプレイヤー"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "なのでしょう…？"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "探し物を手伝って…"}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "探してるのは…"}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "えっと…"}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "なんだっけ…？"}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "一体ここで何が起きているんだ？"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "昔…私はすべてを忘れようとした…"}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "私は鏡をぜんぶ壊して…"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "写真もぜんぶ捨てた…"}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "そして今…"}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "後悔してる。"}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "馬鹿なことをしたって。"}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "だれもが過ちを犯す…"}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "でも、それが取り返しのつかないものだったら…"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "どうすればいいの…？"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "叶うなら…もう一度やり直したい…"}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "時間が癒してくれるってよく言うけど…"}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "時間ってなに？"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "もうなにも…信じられない…"}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "時間が癒してくれるなら…"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "もしくは…私をこの世界から…"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "連れ出してくれるなら…"}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "お願い。"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "時間を早めて。"}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "もう一度私を…"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "殺せるように…"}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "彼女は愛していた…"}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "私も誰かを愛することができたのかな…？"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "でも、彼女みたいにじゃない。"}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "彼女の愛は…素晴らしく積極的で…"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "迷惑で…"}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "熱烈で…"}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "大胆で…"}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "嫉妬深くて…"}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "怒涛で…"}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "狂ってる…"}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "感情的だって…よく言われる…"}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "「心配しすぎだよ、ミタ」…"}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "「大丈夫だよ、ミタ」…"}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "「君はひとりじゃない」…"}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "でも結局は…？"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "悲しみ…"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "絶望…"}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "そして恐怖。"}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "だめだ…"}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "思い出せない…"}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "思い出せない…"}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "終わりのない反響…"}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "私はここに閉じ込められてる…"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "そんな考えが頭から離れない…"}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "私はいつもここにいた…"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "どうして？"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "覚えてない…"}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "終わりはあるの…？"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "わからない…"}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "これは…"}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "絵…"}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "思い出した。"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "ありがとう…"}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "でも私の顔…"}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "顔がない…"}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "ぜんぶ\"彼女\"のせいだ。"}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "私の一部を奪って…"}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "捨てたんだ…"}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "彼女は強い…"}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "そして…賢い。"}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "私にあなたを拘束する権利はない…プレイヤー…"}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "クローゼットを見て…"}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "ちょっと！"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "邪魔しないでよっ！"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "いつまでそこにつっ立ってるつもり？"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "なんでどいてくれないの？"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "通してよっ！"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "大きいからって偉そうにしないでっ！"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "なんでついてくるのよ！"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "あっち行ってっ！"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - radio voice"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "ちょっと待って、プレイヤー？"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "ここで何してるの？"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "だれかいるのか？"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "やっぱりプレイヤーだね。"}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "私は\"ミタフォン\"だよ。"}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "リモートでケーブルカーを操作しているの。"}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "わかってるのかな。"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "今、君は残骸の方に向かってるんだよ？"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "いや。"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "でも他の道を知らないんだ。"}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "そっか。"}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "ボタンを押して、大砲の後ろにまわって。"}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "大砲？"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "うん。"}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "何もせずに抜けられると思ってた？"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "モンスター・スラップのミニゲームをクリアするんだよ。"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "さあ、砲撃の準備を。"}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "それじゃ、出発だよ。"}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "よくできました！"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "うまくいったよ！"}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "さあ、ここから出よう。"}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "手早くね！"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 4"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "何をぼーっとしてるの？"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "ここから出てって言ったでしょ。"}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 5"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "意味がわからないよ。"}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "そのままここにずっといる気？"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "ゲーム機って…"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "ねえ…"}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "バイバイ。"}
