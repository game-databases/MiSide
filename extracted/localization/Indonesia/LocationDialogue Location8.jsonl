{"category": "LocationDialogue Location8", "line_index": 0, "text": "// The first meeting"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "Kamu siapa?"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "Ada apa?"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "Kamu tidak bisa bicara?"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "Tunggu.."}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "Kamu ingin pergi?"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "Iya..."}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "Aku harus kembali"}
{"category": "LocationDialogue Location8", "line_index": 11, "text": "ke versi sebelumnya."}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "Versi sebelumnya?"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "Kenapa harus pergi"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "ke tempat lain?"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "Kenapa enggak tinggal di sini saja"}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "dan jadi"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "teman keduaku?"}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Skipping all dialogs"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "Baiklah..."}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Standing by the window (Random)"}
{"category": "LocationDialogue Location8", "line_index": 24, "text": "Kamu enggak akan bisa pergi lewat pintu."}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "Kelihatannya kamu lagi buru-buru..."}
{"category": "LocationDialogue Location8", "line_index": 26, "text": "Mondar-mandir begitu enggak akan membantumu."}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "Masih bertekad ingin pergi?"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "Lihatlah ke luar jendela..."}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Aren't you Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "Pemain... kamu seorang pemain, kan?"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": "Kita bisa bermain bersama."}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "Andai aku punya tenaga,"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": "kita bisa bermain."}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (What happened to you?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "Entahlah... aku juga enggak tahu..."}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "Aku rasa enggak ada hal buruk yang terjadi..."}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "Tapi enggak ada hal baik juga yang terjadi akhir-akhir ini..."}
{"category": "LocationDialogue Location8", "line_index": 41, "text": "Setidaknya aku masih punya seorang teman."}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "Tapi kenapa pemain lain pergi meninggalkanku?"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "Apa aku tidak cukup baik?"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "Aku takut..."}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Quest 3 (Become a second friend?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "Teman..."}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "Sekarang temanku tinggal sedikit sekali."}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "Cuma satu yang tersisa..."}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "Aku sedih, wahai pemain."}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "Maukah kamu menjadi temanku?"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "Aku sebenarnya mau,"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "tapi aku harus pergi..."}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "Hatiku sakit..."}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Is this your house?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "Rumah?"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "Pemain... Kamu terlihat berbeda..."}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "Lenganmu lebih pendek, dan kamu enggak kelihatan galak lagi..."}
{"category": "LocationDialogue Location8", "line_index": 62, "text": "Pemain, kamu tumbuh menjadi lebih lembut dan baik."}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "Aku enggak terlalu paham..."}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "apa maksudnya."}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "Enggak masalah..."}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "toh enggak ada yang akan menyakitiku lagi, ya kan?"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (How do I leave this place?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "Kamu beneran mau pergi ninggalin aku?"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "Apa memang begini..."}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "takdirku?"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "Aku..."}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": "Pintu-pintu itu enggak akan membantumu."}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Hold player (Random)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "Kenapa pergi?"}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "Tetaplah di sini..."}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "Main sama aku..."}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "Wahai pemain..."}
