{"category": "LocationDialogue Location17", "line_index": 0, "text": "// Player thinks + Make coffee"}
{"category": "LocationDialogue Location17", "line_index": 1, "text": "Aku butuh bantuan seseorang di sini."}
{"category": "LocationDialogue Location17", "line_index": 2, "text": "Semoga saja Mita di sini tidak menggigit..."}
{"category": "LocationDialogue Location17", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 4, "text": "Ngapain aku buang-buang waktu begini..."}
{"category": "LocationDialogue Location17", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 9, "text": "// Player tries to wake up MitaDreamer"}
{"category": "LocationDialogue Location17", "line_index": 10, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 11, "text": "Mita, bangun!"}
{"category": "LocationDialogue Location17", "line_index": 12, "text": "Mita!"}
{"category": "LocationDialogue Location17", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 14, "text": "Mita, wakey-wakey!"}
{"category": "LocationDialogue Location17", "line_index": 15, "text": "Aku butuh bantuanmu."}
{"category": "LocationDialogue Location17", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 17, "text": "Kamu siapaaaaaa?"}
{"category": "LocationDialogue Location17", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 19, "text": "Tolong bantu aku tarik tuasnya."}
{"category": "LocationDialogue Location17", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 21, "text": "Tuas apa?"}
{"category": "LocationDialogue Location17", "line_index": 22, "text": "Biarkan aku tidur, dong..."}
{"category": "LocationDialogue Location17", "line_index": 23, "text": "Atau buatkan aku kopi."}
{"category": "LocationDialogue Location17", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 25, "text": "Mesin kopinya kan di sebelah sana."}
{"category": "LocationDialogue Location17", "line_index": 26, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 27, "text": "Mi-ita!"}
{"category": "LocationDialogue Location17", "line_index": 28, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 31, "text": "// Player gives away the coffee"}
{"category": "LocationDialogue Location17", "line_index": 32, "text": "Mita,"}
{"category": "LocationDialogue Location17", "line_index": 33, "text": "ini kopimu."}
{"category": "LocationDialogue Location17", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 37, "text": "// MitaDreamer exercise"}
{"category": "LocationDialogue Location17", "line_index": 38, "text": "Tuas ya,"}
{"category": "LocationDialogue Location17", "line_index": 39, "text": "tadi kamu bilang?"}
{"category": "LocationDialogue Location17", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 41, "text": "Iya."}
{"category": "LocationDialogue Location17", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 43, "text": "Kok kamu tahu soal itu?"}
{"category": "LocationDialogue Location17", "line_index": 44, "text": "Tapi, buat apa aku tanyakan..."}
{"category": "LocationDialogue Location17", "line_index": 45, "text": "Mengingat kamu ada di sini,"}
{"category": "LocationDialogue Location17", "line_index": 46, "text": "berarti kamu sudah tahu banyak hal, kan..."}
{"category": "LocationDialogue Location17", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 48, "text": "Sebentar,"}
{"category": "LocationDialogue Location17", "line_index": 49, "text": "aku mau duduk dulu."}
{"category": "LocationDialogue Location17", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 51, "text": "Lalu?"}
{"category": "LocationDialogue Location17", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 53, "text": "Aku enggak tahu harus bilang gimana..."}
{"category": "LocationDialogue Location17", "line_index": 54, "text": "Tapi intinya aku harus lanjut terus,"}
{"category": "LocationDialogue Location17", "line_index": 55, "text": "lanjut ikuti arahan cincinnya."}
{"category": "LocationDialogue Location17", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 57, "text": "Kamu punya cincin dia?"}
{"category": "LocationDialogue Location17", "line_index": 58, "text": "Pantas saja"}
{"category": "LocationDialogue Location17", "line_index": 59, "text": "kamu menemukan tempat ini."}
{"category": "LocationDialogue Location17", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 61, "text": "Benar."}
{"category": "LocationDialogue Location17", "line_index": 62, "text": "Maka dari itu, apa kamu bisa bantu aku?"}
{"category": "LocationDialogue Location17", "line_index": 63, "text": "Tarik tuasnya?"}
{"category": "LocationDialogue Location17", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 65, "text": "Tentu."}
{"category": "LocationDialogue Location17", "line_index": 66, "text": "Akan kubantu."}
{"category": "LocationDialogue Location17", "line_index": 67, "text": "Tarik tuasnya..."}
{"category": "LocationDialogue Location17", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 70, "text": "Mita, ayolah..."}
{"category": "LocationDialogue Location17", "line_index": 71, "text": "Ayo jalan."}
{"category": "LocationDialogue Location17", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 73, "text": "Uh?"}
{"category": "LocationDialogue Location17", "line_index": 74, "text": "Baiklah."}
{"category": "LocationDialogue Location17", "line_index": 75, "text": "Ayok."}
{"category": "LocationDialogue Location17", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 78, "text": "// MitaDreamer fall"}
{"category": "LocationDialogue Location17", "line_index": 79, "text": "Bangun."}
{"category": "LocationDialogue Location17", "line_index": 80, "text": "Kamu sengantuk itukah?"}
{"category": "LocationDialogue Location17", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 82, "text": "// MitaDreamer again sleep"}
{"category": "LocationDialogue Location17", "line_index": 83, "text": "Bangun."}
{"category": "LocationDialogue Location17", "line_index": 84, "text": "Kita sudah tiba."}
{"category": "LocationDialogue Location17", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 87, "text": "// Switches"}
{"category": "LocationDialogue Location17", "line_index": 88, "text": "Oke,"}
{"category": "LocationDialogue Location17", "line_index": 89, "text": "aku siap."}
{"category": "LocationDialogue Location17", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 91, "text": "Aku juga siap."}
{"category": "LocationDialogue Location17", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 93, "text": "Baiklah."}
{"category": "LocationDialogue Location17", "line_index": 94, "text": "Aku akan mulai"}
{"category": "LocationDialogue Location17", "line_index": 95, "text": "hitung mundur."}
{"category": "LocationDialogue Location17", "line_index": 96, "text": "Lalu kita akan tarik tuasnya bersama."}
{"category": "LocationDialogue Location17", "line_index": 97, "text": "Mengerti?"}
{"category": "LocationDialogue Location17", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 99, "text": "Yang penting tetap siaga, ya!"}
{"category": "LocationDialogue Location17", "line_index": 100, "text": "Ayo."}
{"category": "LocationDialogue Location17", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 103, "text": "3"}
{"category": "LocationDialogue Location17", "line_index": 104, "text": "2"}
{"category": "LocationDialogue Location17", "line_index": 105, "text": "1"}
{"category": "LocationDialogue Location17", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 107, "text": "// Player lose 1"}
{"category": "LocationDialogue Location17", "line_index": 108, "text": "Kamu ngelamun?"}
{"category": "LocationDialogue Location17", "line_index": 109, "text": "Ayo,"}
{"category": "LocationDialogue Location17", "line_index": 110, "text": "coba lagi..."}
{"category": "LocationDialogue Location17", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 112, "text": "// Player lose 2"}
{"category": "LocationDialogue Location17", "line_index": 113, "text": "Sekali lagi?"}
{"category": "LocationDialogue Location17", "line_index": 114, "text": "Aduh,"}
{"category": "LocationDialogue Location17", "line_index": 115, "text": "Aku..."}
{"category": "LocationDialogue Location17", "line_index": 116, "text": "Aku mau merem, nih..."}
{"category": "LocationDialogue Location17", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 118, "text": "// Player lose 3"}
{"category": "LocationDialogue Location17", "line_index": 119, "text": "Aku hampir banget tertidur..."}
{"category": "LocationDialogue Location17", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 122, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 123, "text": "Bagus,"}
{"category": "LocationDialogue Location17", "line_index": 124, "text": "makasih, Mita."}
{"category": "LocationDialogue Location17", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 126, "text": "Mm-hmm."}
{"category": "LocationDialogue Location17", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 129, "text": "Pintunya..."}
{"category": "LocationDialogue Location17", "line_index": 130, "text": "lambat..."}
{"category": "LocationDialogue Location17", "line_index": 131, "text": "banget..."}
{"category": "LocationDialogue Location17", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 134, "text": "Aku pergi tidur, ya..."}
{"category": "LocationDialogue Location17", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 136, "text": "// Why kitchen?"}
{"category": "LocationDialogue Location17", "line_index": 137, "text": "Kenapa malah ke dapur?"}
{"category": "LocationDialogue Location17", "line_index": 138, "text": "Kalau aku tertidur di lantai yang dingin ini,"}
{"category": "LocationDialogue Location17", "line_index": 139, "text": "itu salahmu, ya."}
{"category": "LocationDialogue Location17", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 141, "text": "// Why bathroom?"}
{"category": "LocationDialogue Location17", "line_index": 142, "text": "Aku tidak mengerti..."}
{"category": "LocationDialogue Location17", "line_index": 143, "text": "tuas mana yang perlu dibantuin di sini?"}
{"category": "LocationDialogue Location17", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 145, "text": "// Put button"}
{"category": "LocationDialogue Location17", "line_index": 146, "text": "Tidak ada yang terjadi?"}
{"category": "LocationDialogue Location17", "line_index": 147, "text": "Lantas buat apa ada tombol di sini?"}
{"category": "LocationDialogue Location17", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 149, "text": "// Cofee"}
{"category": "LocationDialogue Location17", "line_index": 150, "text": "Mau kopi lagi?"}
{"category": "LocationDialogue Location17", "line_index": 151, "text": "Kalau enggak nanti kamu tertidur lagi."}
{"category": "LocationDialogue Location17", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 153, "text": "Apa?"}
{"category": "LocationDialogue Location17", "line_index": 154, "text": "Tidak mau..."}
{"category": "LocationDialogue Location17", "line_index": 155, "text": "Kopi ini rasanya enggak enak..."}
{"category": "LocationDialogue Location17", "line_index": 156, "text": "Aku aman saja, kok..."}
{"category": "LocationDialogue Location17", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 158, "text": "// Button"}
{"category": "LocationDialogue Location17", "line_index": 159, "text": "Mita? Tombolnya enggak berfungsi... Kamu dengar tidak?"}
{"category": "LocationDialogue Location17", "line_index": 160, "text": "Halo?"}
