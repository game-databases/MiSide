{"category": "LocationDialogue Location1", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 1, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 9, "text": "Hai, aku Mita!"}
{"category": "LocationDialogue Location1", "line_index": 10, "text": "Siapa namamu?"}
{"category": "LocationDialogue Location1", "line_index": 11, "text": "Senang bertemu denganmu, [player]!"}
{"category": "LocationDialogue Location1", "line_index": 12, "text": "Um... [player],"}
{"category": "LocationDialogue Location1", "line_index": 13, "text": "aku tadi agak terburu-buru, jadi sekarang kamarnya berantakan, nih..."}
{"category": "LocationDialogue Location1", "line_index": 14, "text": "Bisa tolong bantu aku bereskan sedikit?"}
{"category": "LocationDialogue Location1", "line_index": 15, "text": "Wahhh.."}
{"category": "LocationDialogue Location1", "line_index": 16, "text": "Makasih banyak!"}
{"category": "LocationDialogue Location1", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 18, "text": "[player], aku lapar nih..."}
{"category": "LocationDialogue Location1", "line_index": 19, "text": "Aku ingin makan..."}
{"category": "LocationDialogue Location1", "line_index": 20, "text": "Bisa tolong belikan aku bahan-bahan untuk sup ayam?"}
{"category": "LocationDialogue Location1", "line_index": 21, "text": "Yay! Kamu sudah dapat semuanya!"}
{"category": "LocationDialogue Location1", "line_index": 22, "text": "Sekarang, kita masak sama-sama, yuk?"}
{"category": "LocationDialogue Location1", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 25, "text": "Aku mau beli TV murah hari ini—"}
{"category": "LocationDialogue Location1", "line_index": 26, "text": "Tv-nya mudah dibawa dan ada antenanya, aku ingin membawanya saat berpergian."}
{"category": "LocationDialogue Location1", "line_index": 27, "text": "Ngomong-ngomong, kamu bisa main game untuk mendapatkan uang."}
{"category": "LocationDialogue Location1", "line_index": 28, "text": "Kamu mau enggak main, menghasilkan uang, lalu belikan aku TV kecil?"}
{"category": "LocationDialogue Location1", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 30, "text": "Yay! Kamu berhasil! Kamu punya cukup uang untuk beliin aku TV portabel itu!"}
{"category": "LocationDialogue Location1", "line_index": 31, "text": "Ini dia! Kecil, portabel, dan murah seperti yang aku mau."}
{"category": "LocationDialogue Location1", "line_index": 32, "text": "Terima kasih!"}
{"category": "LocationDialogue Location1", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 34, "text": "Hai, [player]! Kamu benar-benar sangat membantu, jujur aja."}
{"category": "LocationDialogue Location1", "line_index": 35, "text": "Tapi, uh... TV itu? Memang keren, tapi sudah rusak."}
{"category": "LocationDialogue Location1", "line_index": 36, "text": "Ngomong-ngomong, bisakah kamu membantuku memindahkan lemari ini?"}
{"category": "LocationDialogue Location1", "line_index": 37, "text": "Lemari ini berat banget... >.<"}
{"category": "LocationDialogue Location1", "line_index": 38, "text": "Terima kasih banyak, sayang! <3"}
{"category": "LocationDialogue Location1", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 40, "text": "Oh, [player]! Baru sehari, tapi aku sudah kangen banget!"}
{"category": "LocationDialogue Location1", "line_index": 41, "text": "Aku harap kamu bisa lebih sering ngunjungin aku."}
{"category": "LocationDialogue Location1", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 43, "text": "Apakah ini buatku?"}
{"category": "LocationDialogue Location1", "line_index": 44, "text": "Makasih, makasih, makasih!"}
{"category": "LocationDialogue Location1", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 46, "text": "Hai, [player]! Aku tadi berpikir..."}
{"category": "LocationDialogue Location1", "line_index": 47, "text": "Aku berharap kita bisa ketemu langsung."}
{"category": "LocationDialogue Location1", "line_index": 48, "text": "Menyebalkan banget karena aku enggak bisa."}
{"category": "LocationDialogue Location1", "line_index": 49, "text": "Kamu selalu membantuku, begitu baik setiap hari..."}
{"category": "LocationDialogue Location1", "line_index": 50, "text": "Aku berharap bisa melakukan sesuatu untukmu juga."}
{"category": "LocationDialogue Location1", "line_index": 51, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 52, "text": "Oh, aku punya ide!"}
{"category": "LocationDialogue Location1", "line_index": 53, "text": "Sekarang kita bersama."}
{"category": "LocationDialogue Location1", "line_index": 54, "text": "Coba letakkan dulu ponselmu."}
{"category": "LocationDialogue Location1", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 57, "text": "// T-shirt on the bed"}
{"category": "LocationDialogue Location1", "line_index": 58, "text": "Kenapa nih kaos ada di kasur?"}
{"category": "LocationDialogue Location1", "line_index": 59, "text": "// Rubik's Cube"}
{"category": "LocationDialogue Location1", "line_index": 60, "text": "Aku jarang banget main ini, sih..."}
{"category": "LocationDialogue Location1", "line_index": 61, "text": "Pernah kuselesaikan sekali, tapi habis itu nggak pernah kumainkan lagi."}
{"category": "LocationDialogue Location1", "line_index": 62, "text": "Kayaknya karena aku nggak yakin bisa melakukannya lagi, sih."}
{"category": "LocationDialogue Location1", "line_index": 63, "text": "// Computer"}
{"category": "LocationDialogue Location1", "line_index": 64, "text": "Oke, cek dulu..."}
{"category": "LocationDialogue Location1", "line_index": 65, "text": "Buat daftar tugas..."}
{"category": "LocationDialogue Location1", "line_index": 66, "text": "Tulis skrip reaksi karakter,"}
{"category": "LocationDialogue Location1", "line_index": 67, "text": "Dan mungkin selipkan beberapa coding."}
{"category": "LocationDialogue Location1", "line_index": 68, "text": "// The airplane"}
{"category": "LocationDialogue Location1", "line_index": 69, "text": "Terbang menuju tak terbatas dan melampauinya!"}
{"category": "LocationDialogue Location1", "line_index": 70, "text": "// Trash in the corner"}
{"category": "LocationDialogue Location1", "line_index": 71, "text": "Duh, sibuk banget sampai lupa buang sampah lagi..."}
{"category": "LocationDialogue Location1", "line_index": 72, "text": "Kali ini bakal aku buang kok, beneran!"}
{"category": "LocationDialogue Location1", "line_index": 73, "text": "...Tapi, jadwal bersih-bersihnya kapan, ya?"}
{"category": "LocationDialogue Location1", "line_index": 74, "text": "// Photo of a cat on a watermelon"}
{"category": "LocationDialogue Location1", "line_index": 75, "text": "Dia yang terbaik..."}
{"category": "LocationDialogue Location1", "line_index": 76, "text": "Seekor kucing, santai di atas semangka."}
{"category": "LocationDialogue Location1", "line_index": 77, "text": "// Photo with a girl"}
{"category": "LocationDialogue Location1", "line_index": 78, "text": "Aku dengan saudariku,"}
{"category": "LocationDialogue Location1", "line_index": 79, "text": "sama sekali tidak mirip."}
{"category": "LocationDialogue Location1", "line_index": 80, "text": "Dia selalu keluar dan jalan-jalan,"}
{"category": "LocationDialogue Location1", "line_index": 81, "text": "sedangkan aku diam di rumah saja."}
{"category": "LocationDialogue Location1", "line_index": 82, "text": "// Photo with people"}
{"category": "LocationDialogue Location1", "line_index": 83, "text": "Hmm..."}
{"category": "LocationDialogue Location1", "line_index": 84, "text": "Kehidupan kantor benar-benar menanamkan"}
{"category": "LocationDialogue Location1", "line_index": 85, "text": "ajaran etika kepada kita, bukan begitu?"}
{"category": "LocationDialogue Location1", "line_index": 86, "text": "Anehnya aku masih merasa terikat"}
{"category": "LocationDialogue Location1", "line_index": 87, "text": "dengan rekan-rekan kerjaku..."}
{"category": "LocationDialogue Location1", "line_index": 88, "text": "Tapi apakah aku bakal"}
{"category": "LocationDialogue Location1", "line_index": 89, "text": "bertemu mereka lagi?"}
{"category": "LocationDialogue Location1", "line_index": 90, "text": "...Tunggu, buat apa aku memajang foto ini?"}
{"category": "LocationDialogue Location1", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 93, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 99, "text": "// Nope name"}
{"category": "LocationDialogue Location1", "line_index": 100, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 101, "text": "Oh, tidak."}
{"category": "LocationDialogue Location1", "line_index": 102, "text": "Jangan pakai nama itu, enggak akan berhasil."}
{"category": "LocationDialogue Location1", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 104, "text": "// Name Developer"}
{"category": "LocationDialogue Location1", "line_index": 105, "text": "Kamu yakin mau pakai nama developer?"}
{"category": "LocationDialogue Location1", "line_index": 106, "text": "Aku senang sih, tapi..."}
{"category": "LocationDialogue Location1", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 108, "text": "// Bad name"}
{"category": "LocationDialogue Location1", "line_index": 109, "text": "Aku lebih suka kamu enggak nyebut dirimu kayak gitu."}
{"category": "LocationDialogue Location1", "line_index": 110, "text": "Nama itu enggak keren sama sekali."}
{"category": "LocationDialogue Location1", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 112, "text": "// Go restart"}
{"category": "LocationDialogue Location1", "line_index": 113, "text": "Enggak, bukan seperti itu caranya. Ayo mulai lagi."}
{"category": "LocationDialogue Location1", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 115, "text": "// Name with numbers"}
{"category": "LocationDialogue Location1", "line_index": 116, "text": "Oh, jadi kamu pakai angka? Tapi apa kreatifnya itu?"}
{"category": "LocationDialogue Location1", "line_index": 117, "text": "Ya sudah, toh itu pilihanmu!"}
{"category": "LocationDialogue Location1", "line_index": 118, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 119, "text": "// Name Mita"}
{"category": "LocationDialogue Location1", "line_index": 120, "text": "Mita?"}
{"category": "LocationDialogue Location1", "line_index": 121, "text": "Kamu beneran kasih nama dirimu sepertiku?"}
{"category": "LocationDialogue Location1", "line_index": 122, "text": "Atau... apakah itu juga namamu?"}
{"category": "LocationDialogue Location1", "line_index": 123, "text": "Jangan tersinggung ya, tapi kurasa aku harus jadi satu-satunya Mita di sini, hehe ♪"}
{"category": "LocationDialogue Location1", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 125, "text": "// Day 10"}
{"category": "LocationDialogue Location1", "line_index": 126, "text": "Oh, kamu sudah kembali!"}
{"category": "LocationDialogue Location1", "line_index": 127, "text": "Aduh, aku kehilangan sisir rambutku, nih..."}
{"category": "LocationDialogue Location1", "line_index": 128, "text": "Bisakah kamu membantuku menemukannya?"}
{"category": "LocationDialogue Location1", "line_index": 129, "text": "Coba periksa meja di samping kasur dulu—kayaknya aku pernah taruh di situ."}
{"category": "LocationDialogue Location1", "line_index": 130, "text": "// Looked in the bedside table"}
{"category": "LocationDialogue Location1", "line_index": 131, "text": "Hmm, enggak ada sisir di sana..."}
{"category": "LocationDialogue Location1", "line_index": 132, "text": "Gimana kalau di tempat lain?"}
{"category": "LocationDialogue Location1", "line_index": 133, "text": "Tapi jangan cari di dalam oven, oke?"}
{"category": "LocationDialogue Location1", "line_index": 134, "text": "Soalnya sudah aku cek."}
{"category": "LocationDialogue Location1", "line_index": 135, "text": "// Looked into the stove"}
{"category": "LocationDialogue Location1", "line_index": 136, "text": "Hei! Sudah kubilang jangan cari ke dalam sana!"}
{"category": "LocationDialogue Location1", "line_index": 137, "text": "Balik badan—aku bakal beresin ini!"}
{"category": "LocationDialogue Location1", "line_index": 138, "text": "...Sudah selesai. Ayo cari di tempat lain."}
{"category": "LocationDialogue Location1", "line_index": 139, "text": "Oh, dan um, lupakan yang kamu lihat tadi, oke?"}
{"category": "LocationDialogue Location1", "line_index": 140, "text": "// Found a hairbrush"}
{"category": "LocationDialogue Location1", "line_index": 141, "text": "Kamu menemukannya! Kerja bagus!"}
{"category": "LocationDialogue Location1", "line_index": 142, "text": "Selanjutnya mau ngapain nih?"}
