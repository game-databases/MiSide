{"category": "LocationDialogue Location13", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 1, "text": "Cincinnya."}
{"category": "LocationDialogue Location13", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 3, "text": "// Answer 1 (Where have you been all this time?)"}
{"category": "LocationDialogue Location13", "line_index": 4, "text": "Aku sedang mencari cara untuk membawamu ke Core."}
{"category": "LocationDialogue Location13", "line_index": 5, "text": "Dengan metode yang lebih aman."}
{"category": "LocationDialogue Location13", "line_index": 6, "text": "Bukankah begitu rencananya?"}
{"category": "LocationDialogue Location13", "line_index": 7, "text": "Makanya aku harus menghindari"}
{"category": "LocationDialogue Location13", "line_index": 8, "text": "Mita Cegil, kan?"}
{"category": "LocationDialogue Location13", "line_index": 9, "text": "Aku juga harus mencari informasi sebisaku"}
{"category": "LocationDialogue Location13", "line_index": 10, "text": "mengenai ujung alam semesta ini, bukan begitu?"}
{"category": "LocationDialogue Location13", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 12, "text": "Um... Kayaknya begitu...?"}
{"category": "LocationDialogue Location13", "line_index": 13, "text": "Tapi gimana kamu menentukan rute cincin ini, sih?"}
{"category": "LocationDialogue Location13", "line_index": 14, "text": "Kenapa aku malah berakhir di versi ngebug"}
{"category": "LocationDialogue Location13", "line_index": 15, "text": "penuh dengan bahaya?"}
{"category": "LocationDialogue Location13", "line_index": 16, "text": "Aku bisa kabur berkat"}
{"category": "LocationDialogue Location13", "line_index": 17, "text": "lompat ke dalam kegelapan tak berdasar."}
{"category": "LocationDialogue Location13", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 19, "text": "Maaf, aku lupa memberitahu secara detail"}
{"category": "LocationDialogue Location13", "line_index": 20, "text": "apa yang harus kamu lakukan..."}
{"category": "LocationDialogue Location13", "line_index": 21, "text": "Tapi ya, sejak awal rencananya memang begitu"}
{"category": "LocationDialogue Location13", "line_index": 22, "text": "agar kamu berani ambil risiko..."}
{"category": "LocationDialogue Location13", "line_index": 23, "text": "Dan kamu berhasil melakukannya!"}
{"category": "LocationDialogue Location13", "line_index": 24, "text": "Kerja bagus!"}
{"category": "LocationDialogue Location13", "line_index": 25, "text": "Oke, ayo lanjutkan rencananya."}
{"category": "LocationDialogue Location13", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 27, "text": "// Answer 2 (How did you get here?)"}
{"category": "LocationDialogue Location13", "line_index": 28, "text": "Kamu pasti habis mengalami banyak hal ya,"}
{"category": "LocationDialogue Location13", "line_index": 29, "text": "makanya sampai lupa pembicaraan kita sebelumnya."}
{"category": "LocationDialogue Location13", "line_index": 30, "text": "Aku kan Mita, aku bisa pindah antar versi "}
{"category": "LocationDialogue Location13", "line_index": 31, "text": "sesuka hati, ingat?"}
{"category": "LocationDialogue Location13", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 33, "text": "Tidak semua Mita bisa lakuin itu,"}
{"category": "LocationDialogue Location13", "line_index": 34, "text": "aku sudah lihat ada yang tidak bisa."}
{"category": "LocationDialogue Location13", "line_index": 35, "text": "Dan mereka jelas menderita."}
{"category": "LocationDialogue Location13", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 37, "text": "Iya, versi mereka itu rusak,"}
{"category": "LocationDialogue Location13", "line_index": 38, "text": "dunia mereka hancur. Aku sudah bilang, kan."}
{"category": "LocationDialogue Location13", "line_index": 39, "text": "Haduh..."}
{"category": "LocationDialogue Location13", "line_index": 40, "text": "Kamu tahu siapa pelakunya, kan?"}
{"category": "LocationDialogue Location13", "line_index": 41, "text": "Si Mita Cegil."}
{"category": "LocationDialogue Location13", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 43, "text": "Iya, sudah pasti itu dia..."}
{"category": "LocationDialogue Location13", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 45, "text": "// Answer 3 (Who was this Mita just now?)"}
{"category": "LocationDialogue Location13", "line_index": 46, "text": "Dia itu Mita Jelek."}
{"category": "LocationDialogue Location13", "line_index": 47, "text": "Agresif dan bodoh."}
{"category": "LocationDialogue Location13", "line_index": 48, "text": "Kamu enggak akan bisa ngobrol secara jelas sama dia,"}
{"category": "LocationDialogue Location13", "line_index": 49, "text": "karena dunia dia cuma berputar di sekitar Mita Cegil."}
{"category": "LocationDialogue Location13", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 51, "text": "Iya, aku tahu kok."}
{"category": "LocationDialogue Location13", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 53, "text": "Ayo, kita harus segera pergi ke Core-nya."}
{"category": "LocationDialogue Location13", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 55, "text": "// Answer 4 (How does the ring work?)"}
{"category": "LocationDialogue Location13", "line_index": 56, "text": "Dan cincin ini,"}
{"category": "LocationDialogue Location13", "line_index": 57, "text": "apa ini satu-satunya cara untuk pergi ke Core?"}
{"category": "LocationDialogue Location13", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 59, "text": "Benar."}
{"category": "LocationDialogue Location13", "line_index": 60, "text": "Tentunya, bila kita punya portal"}
{"category": "LocationDialogue Location13", "line_index": 61, "text": "kita bisa langsung memindahkan"}
{"category": "LocationDialogue Location13", "line_index": 62, "text": "dirimu ke sini."}
{"category": "LocationDialogue Location13", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 64, "text": "Apa ada keuntungan dari cincin ini?"}
{"category": "LocationDialogue Location13", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 66, "text": "Tentu saja!"}
{"category": "LocationDialogue Location13", "line_index": 67, "text": "Ini mudah dipakai,"}
{"category": "LocationDialogue Location13", "line_index": 68, "text": "dan bisa mengingat versi "}
{"category": "LocationDialogue Location13", "line_index": 69, "text": "yang sudah kamu kunjungi sebelumnya,"}
{"category": "LocationDialogue Location13", "line_index": 70, "text": "jadi kamu bisa balik ke sana dengan mudah."}
{"category": "LocationDialogue Location13", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 72, "text": "// Answer 5 (Why does Mad Mita need me?)"}
{"category": "LocationDialogue Location13", "line_index": 73, "text": "Kenapa Mita Cegil tidak mau membiarkanku pergi?"}
{"category": "LocationDialogue Location13", "line_index": 74, "text": "Dia menarikku ke dalam game-nya yang berbahaya,"}
{"category": "LocationDialogue Location13", "line_index": 75, "text": "tapi aku masih hidup sih...."}
{"category": "LocationDialogue Location13", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 77, "text": "Tebakanku"}
{"category": "LocationDialogue Location13", "line_index": 78, "text": "dia sedang mencari pemain yang cocok..."}
{"category": "LocationDialogue Location13", "line_index": 79, "text": "Yang bisa menerima dia apa adanya."}
{"category": "LocationDialogue Location13", "line_index": 80, "text": "Lagipula, Mita adalah Mita!"}
{"category": "LocationDialogue Location13", "line_index": 81, "text": "Tapi karena itu jelas mustahil,"}
{"category": "LocationDialogue Location13", "line_index": 82, "text": "dia mengubah pemain menjadi cartridge,"}
{"category": "LocationDialogue Location13", "line_index": 83, "text": "supaya tidak ada yang bisa kabur..."}
{"category": "LocationDialogue Location13", "line_index": 84, "text": "Kira-kira begitulah tebakanku."}
{"category": "LocationDialogue Location13", "line_index": 85, "text": "Sudahlah, ayo fokus ke hal yang lebih penting."}
{"category": "LocationDialogue Location13", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 87, "text": "// Answer 6 (Is this the core?)"}
{"category": "LocationDialogue Location13", "line_index": 88, "text": "Inikah?"}
{"category": "LocationDialogue Location13", "line_index": 89, "text": "Core-nya?"}
{"category": "LocationDialogue Location13", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 91, "text": "Betul. Ini Core-nya."}
{"category": "LocationDialogue Location13", "line_index": 92, "text": "Dulu aku sudah coba jelaskan,"}
{"category": "LocationDialogue Location13", "line_index": 93, "text": "kalian para pemain bukanlah bagian dari dunia ini..."}
{"category": "LocationDialogue Location13", "line_index": 94, "text": "Artinya, kamu tidak butuh izin khusus untuk masuk."}
{"category": "LocationDialogue Location13", "line_index": 95, "text": "Yah, setidaknya itu yang aku percayai, sih."}
{"category": "LocationDialogue Location13", "line_index": 96, "text": "Pokoknya, aku sangat yakin"}
{"category": "LocationDialogue Location13", "line_index": 97, "text": "kalau solusi atas semua permasalahan kita"}
{"category": "LocationDialogue Location13", "line_index": 98, "text": "bisa ditemukan di dalam sana!"}
{"category": "LocationDialogue Location13", "line_index": 99, "text": "[player], masuklah."}
{"category": "LocationDialogue Location13", "line_index": 100, "text": "Kamu benar-benar berhasil..."}
{"category": "LocationDialogue Location13", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 102, "text": "// Look on CoreMita"}
{"category": "LocationDialogue Location13", "line_index": 103, "text": "Hati-hati, [player]."}
{"category": "LocationDialogue Location13", "line_index": 104, "text": "Dia mengawasimu."}
{"category": "LocationDialogue Location13", "line_index": 105, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 106, "text": "Dia siapa?"}
{"category": "LocationDialogue Location13", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 108, "text": "Aku juga enggak tahu..."}
{"category": "LocationDialogue Location13", "line_index": 109, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 110, "text": "Baiklah..."}
{"category": "LocationDialogue Location13", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 113, "text": "Apa itu?"}
{"category": "LocationDialogue Location13", "line_index": 114, "text": "Hei!"}
{"category": "LocationDialogue Location13", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 116, "text": "Kayaknya aku menemukannya!"}
{"category": "LocationDialogue Location13", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 118, "text": "Luar biasa! Kerja bagus!"}
{"category": "LocationDialogue Location13", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 120, "text": "Tapi aku perlu menentukan versinya."}
{"category": "LocationDialogue Location13", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 122, "text": "Oh iya, versi dia itu..."}
{"category": "LocationDialogue Location13", "line_index": 123, "text": "00.98"}
{"category": "LocationDialogue Location13", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 125, "text": "Bingo!"}
{"category": "LocationDialogue Location13", "line_index": 126, "text": "Oke, dan apa indeksnya?"}
{"category": "LocationDialogue Location13", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 128, "text": "Uhm, indeks?"}
{"category": "LocationDialogue Location13", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 130, "text": "Aku butuh indeksnya."}
{"category": "LocationDialogue Location13", "line_index": 131, "text": "Tunggu, jangan bilang kamu tidak tahu...?"}
{"category": "LocationDialogue Location13", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 134, "text": "Hmm, tapi masuk akal, sih..."}
{"category": "LocationDialogue Location13", "line_index": 135, "text": "Setiap Mita memiliki indeks,"}
{"category": "LocationDialogue Location13", "line_index": 136, "text": "jadi tidak bisa kalau langsung restart seluruh versi..."}
{"category": "LocationDialogue Location13", "line_index": 137, "text": "Kalau itu terjadi akan menimbulkan kekacauan besar!"}
{"category": "LocationDialogue Location13", "line_index": 138, "text": "Aduh, aku enggak berpikir sampai ke situ..."}
{"category": "LocationDialogue Location13", "line_index": 139, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 144, "text": "// Answer 1 (What's wrong with you?)"}
{"category": "LocationDialogue Location13", "line_index": 145, "text": "Selain masalah yang pelik,"}
{"category": "LocationDialogue Location13", "line_index": 146, "text": "aku baik-baik saja kok."}
{"category": "LocationDialogue Location13", "line_index": 147, "text": "Semuanya baik-baik saja, tapi banyak yang berubah..."}
{"category": "LocationDialogue Location13", "line_index": 148, "text": "Aku perlu berpikir."}
{"category": "LocationDialogue Location13", "line_index": 149, "text": "Itu saja."}
{"category": "LocationDialogue Location13", "line_index": 150, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 151, "text": "// Answer 2 (Maybe there's a way to get to know him?)"}
{"category": "LocationDialogue Location13", "line_index": 152, "text": "Aku..."}
{"category": "LocationDialogue Location13", "line_index": 153, "text": "Aku rasa... Duh, itu gila!"}
{"category": "LocationDialogue Location13", "line_index": 154, "text": "Gila banget!"}
{"category": "LocationDialogue Location13", "line_index": 155, "text": "Seperti mencari jarum di..."}
{"category": "LocationDialogue Location13", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 157, "text": "Kamu kenapa?"}
{"category": "LocationDialogue Location13", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 159, "text": "Beberapa bug menghilang bersama dengan informasi,"}
{"category": "LocationDialogue Location13", "line_index": 160, "text": "seperti dunia yang isi perutnya terkoyak gitu!"}
{"category": "LocationDialogue Location13", "line_index": 161, "text": "Log, log, log, data?"}
{"category": "LocationDialogue Location13", "line_index": 162, "text": "Apa jangan-jangan itu, ya?"}
{"category": "LocationDialogue Location13", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 164, "text": "Huh? Ada apa?"}
{"category": "LocationDialogue Location13", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 166, "text": "Aku tahu sebuah tempat!"}
{"category": "LocationDialogue Location13", "line_index": 167, "text": "Tunggu di sini."}
{"category": "LocationDialogue Location13", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 169, "text": "Kamu mau kemana?"}
{"category": "LocationDialogue Location13", "line_index": 170, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 171, "text": "// Answer 3 (What if we attack Mad Mita?)"}
{"category": "LocationDialogue Location13", "line_index": 172, "text": "Kamu pernah bilang kalau Mita apapun"}
{"category": "LocationDialogue Location13", "line_index": 173, "text": "akan kembali ke setelan pabrik saat mati..."}
{"category": "LocationDialogue Location13", "line_index": 174, "text": "Gimana kalau kita..."}
{"category": "LocationDialogue Location13", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 176, "text": "bunuh saja si Mita Cegil?"}
{"category": "LocationDialogue Location13", "line_index": 177, "text": "Kamu gila, ya?"}
{"category": "LocationDialogue Location13", "line_index": 178, "text": "Gimana caranya kita kalahkan cewek gila yang bawa-bawa gergaji begitu?"}
{"category": "LocationDialogue Location13", "line_index": 179, "text": "Dia potong wortel saja bukan pakai pisau!"}
{"category": "LocationDialogue Location13", "line_index": 180, "text": "Dan entah kenapa, dia itu kuat banget!"}
{"category": "LocationDialogue Location13", "line_index": 181, "text": "Masih untung kita hidup..."}
{"category": "LocationDialogue Location13", "line_index": 182, "text": "Sudahlah, kita urus Core-nya dulu."}
{"category": "LocationDialogue Location13", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 185, "text": "// core console entry"}
{"category": "LocationDialogue Location13", "line_index": 186, "text": "Kita perlu masukin kode..."}
{"category": "LocationDialogue Location13", "line_index": 187, "text": "Tapi bagaimana cara mengetahuinya?"}
{"category": "LocationDialogue Location13", "line_index": 188, "text": "Mita, apa kamu tahu?"}
{"category": "LocationDialogue Location13", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 190, "text": "Mungkin tertulis di suatu tempat?"}
{"category": "LocationDialogue Location13", "line_index": 191, "text": "Coba kamu cari."}
{"category": "LocationDialogue Location13", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 193, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location13", "line_index": 194, "text": "Kayaknya bukan ini."}
{"category": "LocationDialogue Location13", "line_index": 195, "text": "Ini juga bukan."}
{"category": "LocationDialogue Location13", "line_index": 196, "text": "Bukan, ini salah."}
{"category": "LocationDialogue Location13", "line_index": 197, "text": "Bukan yang itu."}
{"category": "LocationDialogue Location13", "line_index": 198, "text": "Aku harus temukan opsi reset karakter."}
{"category": "LocationDialogue Location13", "line_index": 199, "text": "// core console - nope version"}
{"category": "LocationDialogue Location13", "line_index": 200, "text": "Versinya salah tuh."}
{"category": "LocationDialogue Location13", "line_index": 201, "text": "Ups, maaf."}
{"category": "LocationDialogue Location13", "line_index": 202, "text": "Bukan itu."}
{"category": "LocationDialogue Location13", "line_index": 203, "text": "Cari yang lain."}
{"category": "LocationDialogue Location13", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location13", "line_index": 205, "text": "Ada yang salah"}
{"category": "LocationDialogue Location13", "line_index": 206, "text": "dengan indeksnya."}
{"category": "LocationDialogue Location13", "line_index": 207, "text": "Aku perlu ganti indeksnya,"}
{"category": "LocationDialogue Location13", "line_index": 208, "text": "itu tidak cocok."}
{"category": "LocationDialogue Location13", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 210, "text": "// Answer 4 (Little people - Chibi)"}
{"category": "LocationDialogue Location13", "line_index": 211, "text": "Tahu enggak, di perjalanan aku sempat bertemu "}
{"category": "LocationDialogue Location13", "line_index": 212, "text": "dengan orang-orang kerdil..."}
{"category": "LocationDialogue Location13", "line_index": 213, "text": "Mereka itu apa?"}
{"category": "LocationDialogue Location13", "line_index": 214, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 215, "text": "Yang Chibi itu?"}
{"category": "LocationDialogue Location13", "line_index": 216, "text": "Um, gimana ya jelasinnya...?"}
{"category": "LocationDialogue Location13", "line_index": 217, "text": "Itu adalah fenomena di sini..."}
{"category": "LocationDialogue Location13", "line_index": 218, "text": "Setiap Mita punya proyeksi Chibi,"}
{"category": "LocationDialogue Location13", "line_index": 219, "text": "dan pemain juga bisa punya..."}
{"category": "LocationDialogue Location13", "line_index": 220, "text": "Apa kamu tahu kalau kami para Mita bisa memanggil mereka?"}
{"category": "LocationDialogue Location13", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 222, "text": "Hah? Caranya?"}
{"category": "LocationDialogue Location13", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 224, "text": "Lihat, nih!"}
{"category": "LocationDialogue Location13", "line_index": 225, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 226, "text": "Seperti sihir, ya..."}
{"category": "LocationDialogue Location13", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 228, "text": "Tapi ada yang salah dengan Chibi punyaku,"}
{"category": "LocationDialogue Location13", "line_index": 229, "text": "kebanyakan mati usai terlahir."}
{"category": "LocationDialogue Location13", "line_index": 230, "text": "Hanya satu ini yang tersisa..."}
{"category": "LocationDialogue Location13", "line_index": 231, "text": "Tapi yah,"}
{"category": "LocationDialogue Location13", "line_index": 232, "text": "dia cuma berputar-putar saja."}
