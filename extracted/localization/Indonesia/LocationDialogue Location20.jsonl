{"category": "LocationDialogue Location20", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Mila! Tidak! Kamu gila, ya!"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Kya-ha-ha! WAH, APAAN NIH?"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "Ini kali pertama kamu membuat ekspresi itu, ya kan?"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "Teruslah begitu! Aku mau lihat lagi!"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "Aku sudah bosan dengan ekspresimu yang itu-itu melulu!"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\""}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "Hai, apa kabarmu?"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "Kamu masih lari-lari? Belum cukup juga?"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Apa yang kamu lakukan pada Mila?!"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "Oh, jadi kamu masih belum capek, ya!"}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Bagus! Ayo kita bermain game lain!"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "Kamu...!"}
{"category": "LocationDialogue Location20", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "Ayo lakukan tes kecil!"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "Kita akan menguji koordinasi dirimu!"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "Lalu tunjukkan kemampuanmu dalam bertindak!"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "Soalnya bagaimana jika ada sesuatu yang salah denganmu!?"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "Bagaimana jika kamu bahkan tidak berhak menggunakan"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "\"SKIN\" yang sangat kamu banggakan itu!?"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "Lihatlah ini..."}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "Manakah yang menarik perhatianmu?"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "Yang kanan?"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "Atau"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "yang kiri?"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "Eh, kamu serius?"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "Memangnya itu penting?"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "Aku cuma bercanda, kok!"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "Lagipula, penikaman itu udah enggak zaman."}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "Sudahlah!"}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "Aku punya permainan yang jauh lebih baik,"}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "seperti..."}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "Lihat ini!"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Kita butuh sedikit musik!"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "Bagaimana dengan lagu ini?"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "Darahku jadi terpompa saking semangatnya!"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "Aku akan mulai"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "dengan menjelaskan peraturannya!"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rules"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "Saat lagu diputar,"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "kamu boleh bergerak."}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "Tapi saat lagu berhenti,"}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "JANGAN BERGERAK!"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "Atau kamu mati. Paham?"}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "Golnya simpel saja: pergilah hingga ke ujung"}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "sebelum lagunya habis."}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "Mari kita mulai!"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "Masih terdiam, ya?"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Lari dong, ayang, ayo lari!"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "Wow!"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Lihatlah dirimu! Sangat patuh sekali!"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Bisa jadi contoh yang sempurna untuk orang lain."}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Aku jadi semakin menginginkanmu untuk diriku sendiri!"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "Tapi, tadi itu terlalu gampang, iya kan?"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "Biarkan aku pergi!"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "Jangan lengah!"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "Masih ada banyak permainan yang harus dimainkan!"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "Selanjutnya adalah ini:"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Aku akan menutup mata..."}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "Dan saat aku membukanya,"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "pastikan kamu sudah sembunyi!"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "Mengerti?"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "Kalau aku melihatmu, aku akan menghukummu!"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Kalau begitu, mari kita mulai!"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "Melakukan ini enggak ada gunanya..."}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "Kamu berhasil!"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Hebat banget! Dan ini semakin seru!"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "Tapi selanjutnya akan jadi lebih sulit."}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "JAUH lebih sulit."}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Sembunyi! Lari! Berputar!"}
{"category": "LocationDialogue Location20", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "Gah, sialan kamu!"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Player falls"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "Sepertinya aku sudah lolos..."}
