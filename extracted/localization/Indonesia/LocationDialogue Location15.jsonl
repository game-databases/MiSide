{"category": "LocationDialogue Location15", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Ternyata kamu di situ!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Kenapa kamu meninggalkan Ruang Core?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Aku kan sudah bilang tunggu aku!"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Kukira kamu bakal memakan waktu lama..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Aduh, ya sudahlah..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Sepertinya aku menemukan sesuatu..."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Menurutku ini suatu indeks..."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Kita harus coba ini berhasil atau tidak!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Ayo keluar dari sini."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "Si Mita Cegil..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Kayaknya dia lagi sibuk dengan pemain baru."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Semoga saja dia sibuk banget biar enggak sempat menganggu kita..."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Mita?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Tunggu aku."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Apa kamu kehilangan seseorang?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Nih, temui dia lagi!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Mita..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Tangkap!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Bagaimana mungkin..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Siapa kamu?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Kamu... kamu masih hidup!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Tidakkah kamu ingat?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Apa aku kenal kamu?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Apa yang terjadi ini..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Aku harus bagaimana sekarang?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Aku saja nggak bisa keluar..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "Maksud kamu \"keluar\" apa?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Tunggu..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "Itu cincinnya..."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "Lalu itu?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Entah itu apaan."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "Ini indeksnya!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Kamu menemukannya!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Aku enggak tahu harus komentar apa."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Kita harus kembali ke Core-nya."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "Dan kamu..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Mungkin sebaiknya kamu ikut denganku..."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Eh, apa?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Baiklah..."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Tunggu di sini."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Mm-hmm."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Aku akan duduk di sini."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Gawat..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "Hampir saja."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "Jadi... apa kita berhasil?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Bagus."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Aku ada di versi yang benar."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Halo!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Kamu seorang pemain, kan?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Siapa namamu?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Maaf, aku mau tinggalkan tempat ini..."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Pergi secepat itu?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "Tapi bagaimana caranya kamu tiba di sini?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Ah, masa bodoh..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Oke deh, kamu boleh pergi..."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Cobain saja pintunya."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Semoga berhasil, ya!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Dinding?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Hmm, harusnya enggak begini."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Ah, mungkin saja..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "ada sesuatu di basemen yang dapat membantumu."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Baru-baru ini aku menemukan"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "sebuah pintu di dalam lemari..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Rupanya pintu itu mengarah ke basemen."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Tapi ruangannya penuh dengan sampah,"}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "dan berbagai peralatan mewah."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Kamu harus memasukkan semacam kode atau apalah."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Aku enggak terlalu paham."}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "Dan aku enggak peduli."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "Juga rasanya kurang nyaman, maksudku, benar-benar enggak nyaman."}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Mau coba lihat?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Uhm, oke."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Sepertinya"}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "dia tidak ingat apa-apa..."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Apa kami berhasil?"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "Kami sudah menyalakan ulang dia?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Kalau begitu sisanya aku tinggal"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "keluar saja dari game terkutuk ini..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Tunggu sebentar."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Aku ingin memelukmu."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Huh?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Senang bertemu denganmu."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Ahh..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "tapi sayang sekali,"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "kamu dan aku"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "hanya menghabiskan waktu sebentar saja."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Err..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "Kamu ngomong apa, sih?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Yang aku maksud,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "kamu kan bisa saja tinggal bersamaku..."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "Ini semua salahku..."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Lemari dan... suara itu."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Harusnya aku BUNUH saja dia lebih cepat!"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Tunggu sebentar,"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "Bukannya kamu sudah...?"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Kenapa kamu bisa ingat semua itu?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "HA!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Kamu kira bakal semudah itu?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Tolol banget..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Pada akhirnya, kamu sama saja seperti pemain lainnya..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Kebetulan nih mereka baru saja selesai. Lihat!"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "Kamu"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "yang ASLI"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "tidak diperlukan lagi."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Hehe, maaf ya."}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Yang benar saja..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Jadi kami gagal...?"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Tidak... aku sudah me-reboot dirimu kok, aku yakin itu..."}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Rupanya kamu masih belum paham juga..."}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Ha-ha-ha!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Kalau begitu aku pandai banget aktingnya!"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Duh, ayang, harusnya kamu lihat mukamu sendiri tuh!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "Lucu banget!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Kenapa kamu begini?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Apa masalahmu?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Iya, ya..."}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Apa masalahku, ya?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Aku enggak tahu, tuh..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Makanya coba kamu kasih tahu kenapa aku begini?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Kenapa aku enggak akan pernah bisa menjadi Mita yang asli?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Versi diriku, sejak awal"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "itu enggak pernah ada!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Aku cuma menguliti orang-orang idiot itu,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "dan menyamar jadi mereka..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Jadi, tidak mungkin kamu bisa "}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "me-reboot diriku!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Yang benar saja..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Kamu..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "Yang salah itu bukan mereka!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "Harusnya kamu yang enggak ada di dunia ini!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "Kamu pun begitu, ya..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Sakit tahu, dikatain begitu."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "Akan tetapi!"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Sudah saatnya kamu pergi!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Kita akan segera berjumpa lagi!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Sepertinya semua sudah siap!"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "Kini"}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "saatnya mengeluarkanmu dari konsol!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "Sampai jumpa!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Kamu akan jadi cartridge favoritku..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Wahai pemain dengan nama unik."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Kayaknya bukan ini."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Ini juga bukan."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Bukan, ini salah."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Bukan yang itu."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Aku harus temukan opsi reset karakter."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "Versinya salah tuh."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Ups, maaf."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Bukan itu."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Cari yang lain."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Ada yang salah"}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "dengan indeksnya."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Aku perlu mengubah indeksnya,"}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "itu tidak cocok."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Kamu lapar?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Aku jago potong wortel, lho. :)"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Ah, sepertinya"}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "kamu ingin masuk sendiri, ya?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Kenapa kita cuma bolak-balik?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Kenapa kembali ke sini?"}
