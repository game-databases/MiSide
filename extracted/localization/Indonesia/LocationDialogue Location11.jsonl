{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Hiya!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Ups!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Maaf,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "hampir saja membunuhmu."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Uhm..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "Kulkasnya, maksudku... kulkasnya hampir saja membunuhmu."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Aku tidak ada hubungannya,"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "sumpah lho!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Beneran!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Mana mungkin aku percaya itu!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Tapi serius deh,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "tempat ini berbahaya..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "terutama buat kamu."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "Kamu ini pengecut banget, ya!"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Melihat dirimu"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "melewati tempat-tempat ini"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "menyenangkan juga..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Lari, bang, lari!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "Aku susul nanti!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Anak pintar!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Wah, seru banget!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Aku lihat kamu pergi ke arah kereta gantung."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "Itu merupakan jalur terpanjang"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "antar versi..."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Aku jadi penasaran gimana kamu akan"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "menangani mereka yang hidup di sana"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "di kabut itu."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Kamu ngapain, sih?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Tolong, ya..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Jangan dilihat!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Dasar mesum!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Cabul..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Uhm, oke..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Semoga berhasil!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Siapa di sana?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Aku bisa merasakan kehadiranmu..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Tolong dengarkan aku,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "kamu seorang pemain,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "bukan?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Tolong bantu aku temukan..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "temukan..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "Sebentar..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "pikiranku kosong..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Ada apa dengan tempat ini?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Dulu aku ingin melupakan semuanya..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Aku menghancurkan semua cermin,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "menyobek lembaran foto-foto..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "tapi kini..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "yang aku rasakan hanya rasa sesal."}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "Bodohnya aku yang dulu..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Iya, semua orang pasti pernah membuat kesalahan..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Tapi kita harus bagaimana"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "jika akibatnya sangatlah buruk?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Andai aku bisa memutar waktu kembali..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Orang bilang waktu menyembuhkan segala luka..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Tapi apa itu waktu?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Aku sudah tidak percaya pada apapun lagi..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Tapi misal waktu dapat menyembuhkan,"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "atau setidaknya membawaku pergi,"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "jauh dari dunia ini..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "Lantas aku mohon padamu, tolong"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "percepat waktunya."}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "Supaya aku bisa mati"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "dengan cepat."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Dia dicintai..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Dulu aku juga bisa mencintai."}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Tapi rasa cintaku berbeda;"}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "rasa cintanya berwarna,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "keji..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "membara..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "tanpa belas kasih..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "iri..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "ganas..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "gila..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Mereka bilang aku emosional..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "'Kamu jangan khawatiran gitu, Mita'..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "'Kamu pasti bisa, Mita'..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "'Kamu tidak sendirian, Mita'..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Begitu katanya. Tapi apa yang tersisa?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Hanya rasa sedih,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "putus asa..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "dan juga rasa takut."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Percuma saja..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Aku tidak bisa mengingat..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "Sama sekali tidak bisa..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Hanya ada gema tiada akhir..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Aku tidak bisa menerima kenyataan"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "bahwa aku terjebak di sini..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Dari dulu aku selalu ada di sini,"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "tapi kenapa?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Aku tidak bisa ingat..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Akankah ini ada akhirnya?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Entahlah..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Ini..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "sebuah gambar..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Kini aku ingat,"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "terima kasih..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Tapi wajahku..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "Aku tak punya wajah..."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "Ini semua karena DIA."}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Dia ambil sebagian diriku..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "lalu membuangnya..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Dia itu kuat..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "dan cerdas."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Aku enggak punya hak untuk menghentikanmu, pemain."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Lihatlah ke dalam lemari..."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Hei!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Kamu menghalangi jalan!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Jangan diam saja di situ!"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Menyingkir dong!"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Biarkan aku lewat!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Hanya karena badanmu lebih besar bukan berarti kamu berkuasa!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Kenapa kamu mengikutiku!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Pergi sana!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - radio voice"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Sebentar... Pemain?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "Kamu ngapain di sini?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Siapa itu?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Pemain lain, ya."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Aku Mitaphone."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Aku berada di sini untuk mengontrol kereta gantung."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Apa kamu sadar"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "saat ini kamu sedang menuju maut?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Mungkin,"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "tapi ini satu-satunya jalur yang aku punya."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Baiklah."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Tekan tombol itu dan berdiri di belakang meriam."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "Meriam?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Iya."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Kamu kira kamu bakal langsung masuk begitu saja?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Kamu harus selesaikan mini game Monster-slap dulu,"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "jadi bersiaplah untuk menembak."}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Baik, saatnya berangkat."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Luar biasa!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Kamu berhasil."}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Hei, keluar dari sini."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Cepat-cepat!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Kenapa masih di sini?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Kan sudah kubilang keluar."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Aku tidak mengerti..."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "kenapa kamu cuma diam doang?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Apa? Sebuah konsol?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Duh..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Dadah."}
