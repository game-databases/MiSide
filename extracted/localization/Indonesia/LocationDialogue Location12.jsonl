{"category": "LocationDialogue Location12", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Tetaplah di sini."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Kayaknya aku menjatuhkan sesuatu. Aku akan segera kembali."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "Habis itu kita akan pergi ke dunia lain..."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Oke."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Ayo bermain!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Aku mau boneka beruangku!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "Aku kehilangan dia..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "Temukan DIA!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Hei..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "lihat apa kamu?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Quest 1 (Who are you?)"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Aku Mita."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "Mita yang terbaik."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "Mita yang pertama."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "Itu yang dikatakan oleh Mita, Mita-ku."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Quest 2 (Why do you look like that?)"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "Bagaimana penampilanku?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "Bagaimana penampilanku?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "Bagaimana penampilanku?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "Mita-ku bilang aku cantik dan orisinal."}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "Itulah aku!"}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Quest 3 (What was Mita doing here?)"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Dia akan bawa aku pergi."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Kami akan tinggal di dunia baru."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "Mita-ku mengundang aku."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Dia akan bawa aku pergi. Dan kami akan bermain."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Quest 4 (Why do you need a teddy bear?)"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "Kamu boneka beruang yang empuk,"}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "dan kamu tersesat,"}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "sama seperti boneka beruangku."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Quest 5 (Why is Mita angry?)"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "Mita..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "ku."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Dia ingin bermain."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Dia cuma ingin"}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "aku."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Kami unik,"}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "satu-satunya."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Mita dan Mita-ku,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0.8A dan 8�54*."}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Quest 6 (Do you believe Mita?)"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "Mita-ku."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "Teman terbaik."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "Mita-ku."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "Satu-satunya teman."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "Ternyata kamu!"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Hei."}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Ayo bermain!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Akan kutunjukkan caranya."}
