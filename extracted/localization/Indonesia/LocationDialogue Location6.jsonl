{"category": "LocationDialogue Location6", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "Mita?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "Kenapa kamu bisa ada di sini?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Kamu Mita, kan?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Tapi rasanya ada yang beda darimu..."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "Matamu cukup jeli, ya."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "Dan kamu benar."}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "Aku bukan Mita yang kamu temui sebelumnya."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Berhati-hatilah, dia sedang merencakan sesuatu"}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "yang jahat."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "Hah? Sesuatu yang jahat?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "Waktunya enggak cukup untuk menjelaskan:"}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "kalau ini berhasil, aku akan memberitahumu semuanya."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Ambil kunci itu. Letaknya ada di sebelah sofa."}
{"category": "LocationDialogue Location6", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Tapi..."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "Pertanyaannya nanti saja!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Berikan aku kuncinya."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Lalu, ambil cincin ini."}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "Hah?"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Kamu ingin keluar dari tempat ini, kan?"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "Uhm, iya sih..."}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Kalau begitu, pakai cincin itu."}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "Ini artefak yang berguna, "}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "kemungkinan besar kamu akan segera membutuhkannya."}
{"category": "LocationDialogue Location6", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Oke..."}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "Ngomong-ngomong, aku"}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Mmm,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "Aku... Mita."}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// MitaKind quest 1"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "Lihat konsol itu?"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "Ambillah."}
{"category": "LocationDialogue Location6", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "Apa ini sebuah rekaman?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "Siapa yang sedang bersamanya itu?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "Itu siaran langsung."}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "Dan dia itu pemain lain."}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Mita mau memanfaatkan pemain itu."}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Mita juga sepertinya "}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "mau mengubahmu menjadi cartridge."}
{"category": "LocationDialogue Location6", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "Aku harus pergi dari sini secepatnya."}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "Dan kamu juga."}
{"category": "LocationDialogue Location6", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "Benar, kita harus pergi."}
{"category": "LocationDialogue Location6", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "Eh, tadi kamu bilang"}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "dia mau memanfaatkan pemain itu."}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "Kalau aku cabut cartridge-nya, apa yang terjadi?"}
{"category": "LocationDialogue Location6", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "Hal itu mungkin"}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "akan merusak cartridge-nya secara permanen."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "Yang mana berarti..."}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "pemain tersebut akan mati."}
{"category": "LocationDialogue Location6", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "..."}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "Kalau cuma aku matikan saja?"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "Mungkin bisa berhasil..."}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Patut dicoba. Ada tombol power warna merah di situ!"}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Kamu lihat enggak?"}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "Ketemu nih."}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "Tekan itu."}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// MitaKind quest 2"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Aku harus tetap di sini."}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "Ada banyak pertanyaan yang perlu aku tanyakan ke dia"}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "supaya aku bisa mencari tahu tentangnya lebih jauh."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "Walaupun kecil kemungkinan dia mau bekerja sama..."}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// MitaKind quest 3"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "Sejujurnya, ini tuh versiku."}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "Aku sedang menemani seorang pemain,"}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "saat tiba-tiba terjadi perubahan."}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "Lalu dia muncul..."}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "dan mengubah pemain menjadi cartridge,"}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "kemudian mengurungku."}
{"category": "LocationDialogue Location6", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Bentar, Mita mengubah pemain jadi cartridge?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "Memang itu bisa dilakukan olehnya?"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "Tapi kenapa?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "Untuk apa dia memerlukan para pemain?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "Dia itu cegil banget..."}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Dia cuma mempermainkan kita, dan memanfaatkan kita untuk rencananya sendiri!"}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "Mengubah pemain menjadi cartridge..."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Beberapa bahkan ada yang enggak sadar mereka habis diapain..."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "Dan yang sadar, malah tidak mau melawan balik... Duh!"}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "Plotnya kenapa jadi gelap begini..."}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "Kamu harus membantu kami!"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "Aku? Tapi bagaimana?"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "Aku butuh kamu!"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "Kalau kamu bantu kami, aku akan bantu kamu juga!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Ini mungkin satu-satunya kesempatan kita."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "Cincin itu akan membimbingmu ke versi yang benar."}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "Kita akan bertemu lagi di sana."}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// MitaKind quest 4"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "Aku masih enggak begitu paham"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "dengan apa yang aku lihat tadi..."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Mita yang itu..."}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "Apa dia ingin membunuhku?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "Bunuh?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Yang dia pikirkan itu lebih dari sekedar membunuh..."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "Kamu harus bergegas."}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Hide!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "Aduh, sial! Ayo sembunyi!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Eh, apa...?"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Buruan, dia mau datang!"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "Ikuti cincinnya—itu akan membawamu ke tempat yang aman!"}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "Hmm, kasih tahu dong ada di mana dia?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "Buat apa?"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "Kamu nggak bakal bunuh dia, kan?"}
{"category": "LocationDialogue Location6", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Aduh, jadi kamu menolak nih buat kasih tahu aku."}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Yah, aku suka tantangan sih."}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "Aku yakin dia ada di sekitar sini."}
{"category": "LocationDialogue Location6", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "Kenapa kamu begitu jahat sama kami?"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "Kamu bahkan enggak ngasih tahu apa yang sebenarnya terjadi!"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "Selain itu..."}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "mau kamu apakan para pemain itu?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "Mereka itu bukan mainan!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "Kamu ini kerasukan apa sih?!"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "Cukup! Tutup mulutmu, dasar boneka!"}
