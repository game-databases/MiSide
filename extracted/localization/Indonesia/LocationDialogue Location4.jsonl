{"category": "LocationDialogue Location4", "line_index": 0, "text": "Mita?"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "Ah, sudah bangun?"}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "Bagaimana kamu bisa di sini?"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": "Tadi kan kamu di sebelahku."}
{"category": "LocationDialogue Location4", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 5, "text": "Tidak."}
{"category": "LocationDialogue Location4", "line_index": 6, "text": "Kamu tadi freeze di depan cermin."}
{"category": "LocationDialogue Location4", "line_index": 7, "text": "Jadi aku pergi."}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "Kenapa ruangannya berubah?"}
{"category": "LocationDialogue Location4", "line_index": 9, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "Aku atur ulang tempatnya"}
{"category": "LocationDialogue Location4", "line_index": 11, "text": "biar kamu merasa lebih nyaman."}
{"category": "LocationDialogue Location4", "line_index": 12, "text": "Di sini,"}
{"category": "LocationDialogue Location4", "line_index": 13, "text": "kita bisa merubah ruangan"}
{"category": "LocationDialogue Location4", "line_index": 14, "text": "sesuai keinginan kita."}
{"category": "LocationDialogue Location4", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 16, "text": "Harusnya enggak usah."}
{"category": "LocationDialogue Location4", "line_index": 17, "text": "Lagipula aku sudah mulai terbiasa dengan tata letaknya."}
{"category": "LocationDialogue Location4", "line_index": 18, "text": "Tapi menurutku, dengan tata letak ini, kamu akan lebih merasa nyaman."}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Mita card game"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "Kalau begitu,"}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "mari kita mulai?"}
{"category": "LocationDialogue Location4", "line_index": 22, "text": "Peraturannya seperti ini:"}
{"category": "LocationDialogue Location4", "line_index": 23, "text": "Chip ini menunjukkan suatu tipe,"}
{"category": "LocationDialogue Location4", "line_index": 24, "text": "contohnya hati, serangan, atau pertahanan."}
{"category": "LocationDialogue Location4", "line_index": 25, "text": "Letakkan kartu di meja."}
{"category": "LocationDialogue Location4", "line_index": 26, "text": "Kalau kamu punya lebih banyak hati"}
{"category": "LocationDialogue Location4", "line_index": 27, "text": "pada kartumu"}
{"category": "LocationDialogue Location4", "line_index": 28, "text": "daripada punyaku,"}
{"category": "LocationDialogue Location4", "line_index": 29, "text": "kamu menang."}
{"category": "LocationDialogue Location4", "line_index": 30, "text": "Ambil kartumu."}
{"category": "LocationDialogue Location4", "line_index": 31, "text": "Sekarang giliranku."}
{"category": "LocationDialogue Location4", "line_index": 32, "text": "Wow!"}
{"category": "LocationDialogue Location4", "line_index": 33, "text": "Aku dapat kartu bagus!"}
{"category": "LocationDialogue Location4", "line_index": 34, "text": "Aku mulai duluan, ya!"}
{"category": "LocationDialogue Location4", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 44, "text": "Oke!"}
{"category": "LocationDialogue Location4", "line_index": 45, "text": "Giliranmu!"}
{"category": "LocationDialogue Location4", "line_index": 46, "text": "Uh-huh."}
{"category": "LocationDialogue Location4", "line_index": 47, "text": "Giliranmu!"}
{"category": "LocationDialogue Location4", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 49, "text": "Status hati tertinggi adalah pemenangnya!"}
{"category": "LocationDialogue Location4", "line_index": 50, "text": "Ini tuh aksi serang-menyerang!"}
{"category": "LocationDialogue Location4", "line_index": 51, "text": "Sekarang, fokus saja ke pertahanan!"}
{"category": "LocationDialogue Location4", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 54, "text": "Kamu menang!"}
{"category": "LocationDialogue Location4", "line_index": 55, "text": "Kamu menang!"}
{"category": "LocationDialogue Location4", "line_index": 56, "text": "Oke, kamu menang."}
{"category": "LocationDialogue Location4", "line_index": 57, "text": "Duh, kamu ini ya..."}
{"category": "LocationDialogue Location4", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 59, "text": "Aku menang!"}
{"category": "LocationDialogue Location4", "line_index": 60, "text": "Aku pemenangnya!"}
{"category": "LocationDialogue Location4", "line_index": 61, "text": "Aku menang!"}
{"category": "LocationDialogue Location4", "line_index": 62, "text": "Hah, kena!"}
{"category": "LocationDialogue Location4", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 64, "text": "Seri."}
{"category": "LocationDialogue Location4", "line_index": 65, "text": "Tidak ada yang menang!"}
{"category": "LocationDialogue Location4", "line_index": 66, "text": "Sekarang seri!"}
{"category": "LocationDialogue Location4", "line_index": 67, "text": "Duh, kita setara..."}
{"category": "LocationDialogue Location4", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 79, "text": "// The card game is interrupted"}
{"category": "LocationDialogue Location4", "line_index": 80, "text": "Suara apa itu?"}
{"category": "LocationDialogue Location4", "line_index": 81, "text": "Asalnya dari lemari."}
{"category": "LocationDialogue Location4", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 83, "text": "Suara?"}
{"category": "LocationDialogue Location4", "line_index": 84, "text": "Suara apa?"}
{"category": "LocationDialogue Location4", "line_index": 85, "text": "Aku enggak dengar apa-apa."}
{"category": "LocationDialogue Location4", "line_index": 86, "text": "Apa yang kamu dengar?"}
{"category": "LocationDialogue Location4", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 88, "text": "Ketukan, kayak ada orang di sana."}
{"category": "LocationDialogue Location4", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 90, "text": "Tapi..."}
{"category": "LocationDialogue Location4", "line_index": 91, "text": "Enggak ada siapa-siapa di sana..."}
{"category": "LocationDialogue Location4", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 93, "text": "Aku ingin buka dan memeriksanya."}
{"category": "LocationDialogue Location4", "line_index": 94, "text": "Soalnya aneh sekali."}
{"category": "LocationDialogue Location4", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 96, "text": "Tapi kenapa?"}
{"category": "LocationDialogue Location4", "line_index": 97, "text": "Lagi-lagi..."}
{"category": "LocationDialogue Location4", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 105, "text": "Kamu mau ngapain!?"}
{"category": "LocationDialogue Location4", "line_index": 106, "text": "Di sana..."}
{"category": "LocationDialogue Location4", "line_index": 107, "text": "ada pakaian dalamku...!"}
{"category": "LocationDialogue Location4", "line_index": 108, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 109, "text": "Kamu menyembunyikan sesuatu, ya?"}
{"category": "LocationDialogue Location4", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 111, "text": "Kamu enggak percaya sama aku?"}
{"category": "LocationDialogue Location4", "line_index": 112, "text": "Apa perbuatanku ini salah?"}
{"category": "LocationDialogue Location4", "line_index": 113, "text": "Aku cuma..."}
{"category": "LocationDialogue Location4", "line_index": 114, "text": "ingin kamu bersama denganku."}
{"category": "LocationDialogue Location4", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 116, "text": "Aku juga ingin bersamamu, tapi..."}
{"category": "LocationDialogue Location4", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 118, "text": "Kenapa kamu tertarik banget sama lemari ini?!"}
{"category": "LocationDialogue Location4", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 120, "text": "Aku cuma ingin tahu tadi itu suara apa!"}
{"category": "LocationDialogue Location4", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 122, "text": "Apa karena"}
{"category": "LocationDialogue Location4", "line_index": 123, "text": "dunia ini"}
{"category": "LocationDialogue Location4", "line_index": 124, "text": "hanya punya empat ruangan saja?"}
{"category": "LocationDialogue Location4", "line_index": 125, "text": "Jadi itu enggak cukup buat kamu?"}
{"category": "LocationDialogue Location4", "line_index": 126, "text": "Kenapa enggak coba tinggal sama aku aja?"}
{"category": "LocationDialogue Location4", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 129, "text": "// Don't stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 130, "text": "Aku mengerti."}
{"category": "LocationDialogue Location4", "line_index": 131, "text": "Lagi-lagi begini..."}
{"category": "LocationDialogue Location4", "line_index": 132, "text": "Kalau kamu mau tahu apa isi di dalamnya,"}
{"category": "LocationDialogue Location4", "line_index": 133, "text": "maka kamu akan mengetahuinya,"}
{"category": "LocationDialogue Location4", "line_index": 134, "text": "saat ini juga!"}
{"category": "LocationDialogue Location4", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 139, "text": "Apa-apaan ini..."}
{"category": "LocationDialogue Location4", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 141, "text": "Begitulah kadang-kadang."}
{"category": "LocationDialogue Location4", "line_index": 142, "text": "Kamarnya stuck saat loading."}
{"category": "LocationDialogue Location4", "line_index": 143, "text": "Tunggu saja sebentar."}
{"category": "LocationDialogue Location4", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 145, "text": "Aneh banget."}
{"category": "LocationDialogue Location4", "line_index": 146, "text": "Apa kita sedang di dalam ponsel seseorang?"}
{"category": "LocationDialogue Location4", "line_index": 147, "text": "Mungkin ponsel yang lemot dengan waktu loading yang lama?"}
{"category": "LocationDialogue Location4", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 149, "text": "Tidak seperti itu, kok."}
{"category": "LocationDialogue Location4", "line_index": 150, "text": "Hanya saja tidak semua hal"}
{"category": "LocationDialogue Location4", "line_index": 151, "text": "dibuat sempurna di dunia ini..."}
{"category": "LocationDialogue Location4", "line_index": 152, "text": "Kita lagi diload"}
{"category": "LocationDialogue Location4", "line_index": 153, "text": "bersama core dunia ini."}
{"category": "LocationDialogue Location4", "line_index": 154, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 155, "text": "Core?"}
{"category": "LocationDialogue Location4", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 157, "text": "Tipikal banget, iya kan?"}
{"category": "LocationDialogue Location4", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 159, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 161, "text": "Ngomong-ngomong, kita bisa"}
{"category": "LocationDialogue Location4", "line_index": 162, "text": "main game konsol"}
{"category": "LocationDialogue Location4", "line_index": 163, "text": "atau kartu."}
{"category": "LocationDialogue Location4", "line_index": 164, "text": "Pilih saja sesukamu."}
{"category": "LocationDialogue Location4", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 167, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 168, "text": "// Mita play fight"}
{"category": "LocationDialogue Location4", "line_index": 169, "text": "Mau tanding, nih?"}
{"category": "LocationDialogue Location4", "line_index": 170, "text": "Kamu harus menang"}
{"category": "LocationDialogue Location4", "line_index": 171, "text": "empat kali."}
{"category": "LocationDialogue Location4", "line_index": 172, "text": "Ayo!"}
{"category": "LocationDialogue Location4", "line_index": 173, "text": "Tenang, aku"}
{"category": "LocationDialogue Location4", "line_index": 174, "text": "enggak akan main kasar di awal."}
{"category": "LocationDialogue Location4", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 176, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 177, "text": "Bagus."}
{"category": "LocationDialogue Location4", "line_index": 178, "text": "Fokus, ya!"}
{"category": "LocationDialogue Location4", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 180, "text": "Wah!"}
{"category": "LocationDialogue Location4", "line_index": 181, "text": "Oke,"}
{"category": "LocationDialogue Location4", "line_index": 182, "text": "aku serius sekarang."}
{"category": "LocationDialogue Location4", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 184, "text": "Wow!"}
{"category": "LocationDialogue Location4", "line_index": 185, "text": "Apa kamu bisa mengalahkanku"}
{"category": "LocationDialogue Location4", "line_index": 186, "text": "sekarang, nih?"}
{"category": "LocationDialogue Location4", "line_index": 187, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 188, "text": "Kamu"}
{"category": "LocationDialogue Location4", "line_index": 189, "text": "bener-bener"}
{"category": "LocationDialogue Location4", "line_index": 190, "text": "hebat! Pro sekali!"}
{"category": "LocationDialogue Location4", "line_index": 191, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 193, "text": "Ada apa?"}
{"category": "LocationDialogue Location4", "line_index": 194, "text": "Hah, tadi itu membosankan."}
{"category": "LocationDialogue Location4", "line_index": 195, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 196, "text": "Yah,"}
{"category": "LocationDialogue Location4", "line_index": 197, "text": "gitu aja. Kamu percaya takdir?"}
{"category": "LocationDialogue Location4", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 199, "text": "Kalau gitu,"}
{"category": "LocationDialogue Location4", "line_index": 200, "text": "buruan deh, atau kamu bakal jadi pecundang selamanya!"}
{"category": "LocationDialogue Location4", "line_index": 201, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 202, "text": "Oh, serius nih?"}
{"category": "LocationDialogue Location4", "line_index": 203, "text": "Kamu kalah telak."}
{"category": "LocationDialogue Location4", "line_index": 204, "text": "Kamu enggak ngasih usaha penuh—"}
{"category": "LocationDialogue Location4", "line_index": 205, "text": "makanya aku menang!"}
{"category": "LocationDialogue Location4", "line_index": 206, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 208, "text": "Oke deh."}
{"category": "LocationDialogue Location4", "line_index": 209, "text": "Gimana kalau kita main kartu aja?"}
{"category": "LocationDialogue Location4", "line_index": 210, "text": "Kartunya ada di kamarku."}
{"category": "LocationDialogue Location4", "line_index": 211, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 214, "text": "// Door > [ERROR]"}
{"category": "LocationDialogue Location4", "line_index": 215, "text": "Hah, ada apa ini?"}
{"category": "LocationDialogue Location4", "line_index": 216, "text": "Di mana..."}
{"category": "LocationDialogue Location4", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 218, "text": "Aduh."}
{"category": "LocationDialogue Location4", "line_index": 219, "text": "Maaf..."}
{"category": "LocationDialogue Location4", "line_index": 220, "text": "Aku download sesuatu"}
{"category": "LocationDialogue Location4", "line_index": 221, "text": "dari internet."}
{"category": "LocationDialogue Location4", "line_index": 222, "text": "Mau mempercantik"}
{"category": "LocationDialogue Location4", "line_index": 223, "text": "bagian luar."}
{"category": "LocationDialogue Location4", "line_index": 224, "text": "Tapi ternyata"}
{"category": "LocationDialogue Location4", "line_index": 225, "text": "ada yang salah sama file-nya."}
{"category": "LocationDialogue Location4", "line_index": 226, "text": "Nanti aku perbaiki."}
{"category": "LocationDialogue Location4", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 228, "text": "Apa itu sebabnya kita tidak bisa pergi dari rumah?"}
{"category": "LocationDialogue Location4", "line_index": 229, "text": "Iya, karena itu."}
{"category": "LocationDialogue Location4", "line_index": 230, "text": "// Mita shy"}
{"category": "LocationDialogue Location4", "line_index": 231, "text": "Hei..."}
{"category": "LocationDialogue Location4", "line_index": 232, "text": "Ada apa dengan kamu?"}
{"category": "LocationDialogue Location4", "line_index": 233, "text": "Kamu mau sesuatu?"}
{"category": "LocationDialogue Location4", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 236, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 237, "text": "// Wall Clock"}
{"category": "LocationDialogue Location4", "line_index": 238, "text": "Jam ini,"}
{"category": "LocationDialogue Location4", "line_index": 239, "text": "menunjukkan waktu apa?"}
{"category": "LocationDialogue Location4", "line_index": 240, "text": "Waktu di dalam game?"}
{"category": "LocationDialogue Location4", "line_index": 241, "text": "Atau selaras dengan waktu di ponselku?"}
{"category": "LocationDialogue Location4", "line_index": 242, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 243, "text": "Soal itu, uhm..."}
{"category": "LocationDialogue Location4", "line_index": 244, "text": "Sebenarnya aku enggak tahu juga, sih."}
{"category": "LocationDialogue Location4", "line_index": 245, "text": "Tapi waktu enggak penting di sini..."}
{"category": "LocationDialogue Location4", "line_index": 246, "text": "Mau malam atau pagi,"}
{"category": "LocationDialogue Location4", "line_index": 247, "text": "cewek sekuat aku"}
{"category": "LocationDialogue Location4", "line_index": 248, "text": "selalu penuh energi—"}
{"category": "LocationDialogue Location4", "line_index": 249, "text": "enggak pernah capek!"}
{"category": "LocationDialogue Location4", "line_index": 250, "text": "Tempat ini bisa selamanya musim semi,"}
{"category": "LocationDialogue Location4", "line_index": 251, "text": "ataupun selamanya siang hari!"}
{"category": "LocationDialogue Location4", "line_index": 252, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 253, "text": "Itu menarik..."}
{"category": "LocationDialogue Location4", "line_index": 254, "text": "tapi juga agak menyeramkan."}
{"category": "LocationDialogue Location4", "line_index": 255, "text": "Terjebak di satu waktu selamanya..."}
{"category": "LocationDialogue Location4", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 258, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 259, "text": "// Photos of Mita"}
{"category": "LocationDialogue Location4", "line_index": 260, "text": "Foto yang bagus."}
{"category": "LocationDialogue Location4", "line_index": 261, "text": "Kayaknya ini foto kamu?"}
{"category": "LocationDialogue Location4", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 263, "text": "Iya."}
{"category": "LocationDialogue Location4", "line_index": 264, "text": "Aku juga suka fotonya."}
{"category": "LocationDialogue Location4", "line_index": 265, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 266, "text": "Siapa yang ambil foto ini?"}
{"category": "LocationDialogue Location4", "line_index": 267, "text": "Ada orang lain di dunia ini juga?"}
{"category": "LocationDialogue Location4", "line_index": 268, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 269, "text": "Bisa dibilang begitu."}
{"category": "LocationDialogue Location4", "line_index": 270, "text": "Aku bakal kenalin kamu nanti."}
{"category": "LocationDialogue Location4", "line_index": 271, "text": "Tapi nanti."}
{"category": "LocationDialogue Location4", "line_index": 272, "text": "Untuk sekarang, aku cuma mau bersama kamu."}
{"category": "LocationDialogue Location4", "line_index": 273, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 275, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 276, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 277, "text": "// Portal"}
{"category": "LocationDialogue Location4", "line_index": 278, "text": "Ke mana portal itu pergi?"}
{"category": "LocationDialogue Location4", "line_index": 279, "text": "Atau apapun yang kamu sebut itu?"}
{"category": "LocationDialogue Location4", "line_index": 280, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 281, "text": "Aku pakai"}
{"category": "LocationDialogue Location4", "line_index": 282, "text": "sedikit sihir"}
{"category": "LocationDialogue Location4", "line_index": 283, "text": "dan memindahnya"}
{"category": "LocationDialogue Location4", "line_index": 284, "text": "ke tempat lain."}
{"category": "LocationDialogue Location4", "line_index": 285, "text": "Kita enggak butuh portal itu lagi."}
{"category": "LocationDialogue Location4", "line_index": 286, "text": "Nanti bisa menganggu kita."}
{"category": "LocationDialogue Location4", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 288, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 289, "text": "// Cermin di kamar tidur"}
{"category": "LocationDialogue Location4", "line_index": 290, "text": "Rasanya ngeri, melihat cermin"}
{"category": "LocationDialogue Location4", "line_index": 291, "text": "yang tidak ada pantulannya."}
{"category": "LocationDialogue Location4", "line_index": 292, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 293, "text": "Pantulannya bisa dinyalakan"}
{"category": "LocationDialogue Location4", "line_index": 294, "text": "kalau kamu mau."}
{"category": "LocationDialogue Location4", "line_index": 295, "text": "Tapi memangnya perlu?"}
{"category": "LocationDialogue Location4", "line_index": 296, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 297, "text": "Tentu saja."}
{"category": "LocationDialogue Location4", "line_index": 298, "text": "Atau... apa nyalain itu bakal ada konsekuensinya?"}
{"category": "LocationDialogue Location4", "line_index": 299, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 300, "text": "Iya."}
{"category": "LocationDialogue Location4", "line_index": 301, "text": "Kita akan bergerak jadi lebih lambat."}
{"category": "LocationDialogue Location4", "line_index": 302, "text": "Pernah lihat kartun dengan frame rate yang rendah?"}
{"category": "LocationDialogue Location4", "line_index": 303, "text": "Nantinya kita bakal seperti itu terus."}
{"category": "LocationDialogue Location4", "line_index": 304, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 305, "text": "Begitu, toh."}
{"category": "LocationDialogue Location4", "line_index": 306, "text": "Mungkin lebih baik kita matikan saja pantulannya..."}
{"category": "LocationDialogue Location4", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 308, "text": "Hei, [player],"}
{"category": "LocationDialogue Location4", "line_index": 309, "text": "kamu suka banget sama cermin, ya?"}
{"category": "LocationDialogue Location4", "line_index": 310, "text": "Takut lihat senyum di wajahmu?"}
{"category": "LocationDialogue Location4", "line_index": 311, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 312, "text": "Hah? Enggak, kok..."}
{"category": "LocationDialogue Location4", "line_index": 313, "text": "Aku cuma capek"}
{"category": "LocationDialogue Location4", "line_index": 314, "text": "setelah bekerja."}
{"category": "LocationDialogue Location4", "line_index": 315, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 316, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 317, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 318, "text": "// Blue sneakers"}
{"category": "LocationDialogue Location4", "line_index": 319, "text": "Ini punyamu?"}
{"category": "LocationDialogue Location4", "line_index": 320, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 321, "text": "Bukan kok, itu punyamu."}
{"category": "LocationDialogue Location4", "line_index": 322, "text": "Kamu enggak ingat?"}
{"category": "LocationDialogue Location4", "line_index": 323, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 324, "text": "Aku enggak ingat punya sepatu seperti itu."}
{"category": "LocationDialogue Location4", "line_index": 325, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 326, "text": "Sekarang kamu punya."}
{"category": "LocationDialogue Location4", "line_index": 327, "text": "Kamu bisa pakai itu"}
{"category": "LocationDialogue Location4", "line_index": 328, "text": "saat kita pergi keluar nanti."}
{"category": "LocationDialogue Location4", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 330, "text": "Gimana dengan baju?"}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "Yang aku punya di dunia ini"}
{"category": "LocationDialogue Location4", "line_index": 332, "text": "cuma baju yang aku pakai."}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "Ada cara enggak buat dapetin baju baru?"}
{"category": "LocationDialogue Location4", "line_index": 334, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 335, "text": "Tentu aja ada."}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "Tapi, aku sudah lihat yang kamu pakai—"}
{"category": "LocationDialogue Location4", "line_index": 337, "text": "dan jujur aja, selera kamu enggak bagus."}
{"category": "LocationDialogue Location4", "line_index": 338, "text": "Tapi enggak masalah, aku bantu kamu dapetin baju lain."}
{"category": "LocationDialogue Location4", "line_index": 339, "text": "Cuma bukan sekarang."}
{"category": "LocationDialogue Location4", "line_index": 340, "text": "Aku janji."}
{"category": "LocationDialogue Location4", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 342, "text": "Oke."}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Games on TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "Mau main apa nih?"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Game milk"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "Ini game pertarungan!"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "Kita lihat siapa yang kalah duluan!"}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "Seru sekali!"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": "Kita sudah puas bermain ini, ayo mainkan yang lain."}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Game penguins"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "Di game ini, kamu jadi penguin"}
{"category": "LocationDialogue Location4", "line_index": 354, "text": "yang meluncur kesana kemari."}
{"category": "LocationDialogue Location4", "line_index": 355, "text": "Iya, seperti itu gamenya."}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "Hah, apa?"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "Kamu serius? Aku kira kamu..."}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "Aku senang banget!"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "Dan sedikit kebingungan..."}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "Tapi..."}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "Tolong, tetaplah bersamaku—"}
{"category": "LocationDialogue Location4", "line_index": 364, "text": "selamanya."}
{"category": "LocationDialogue Location4", "line_index": 365, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 367, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 368, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 369, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 370, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 372, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 373, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 374, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 375, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 376, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 377, "text": "// A game about penguins"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "Ini gampang banget:"}
{"category": "LocationDialogue Location4", "line_index": 379, "text": "kumpulkan saja bola-bola saljunya."}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "Yang kumpulin paling banyak, pemenangnya!"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "Ayo main dua ronde, oke?!"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// The first map"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "Wah, gimana bisa kamu dapat sebanyak itu?"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "Tee-hee! Aku yang paling banyak dapat bola saljunya!"}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "Harus disusul nih!"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "Ha, 1:1!"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// The second map"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "Kamu penguin yang jagom ya!"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "Harusnya kamu main di es juga!"}
{"category": "LocationDialogue Location4", "line_index": 390, "text": "Pfft, kamu lambat banget."}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "Masih mikirin ronde yang sebelumnya?"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "Woah, kita seri! Jarang-jarang nih!"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// The game is over"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "Oke, mau main yang lain?"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "Atau udah selesai?"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "Apa kamu perlu itu?"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "Niat banget mainnya."}
