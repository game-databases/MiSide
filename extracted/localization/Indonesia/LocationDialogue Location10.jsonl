{"category": "LocationDialogue Location10", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "Tunggu, berhenti dulu!"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "Jangan keras-keras..."}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "Melangkah lebih jauh itu berbahaya."}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "Tapi omong-omong..."}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "gimana caranya kamu bisa kemari?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "Um..."}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "Cincin ini membuka pintu yang tepat."}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "Sejujurnya aku enggak tahu cara kerjanya gimana, sih."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "Cincin?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "Ada apa dengan tempat ini?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "Gelap banget."}
{"category": "LocationDialogue Location10", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "Nanti aku ceritakan."}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "Untuk saat ini, pergilah ke pintu keluar."}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "Temui aku di mesin arcade."}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Cepat, jangan lamban!"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// After mini-game"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "Jadi, sudah paham inti dari permainannya?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "Bahwa aku terbuat dari daging dan tulang, sedangkan kamu terbuat dari model kerangka?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "Waduh!"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "Kedengaran serem saat kamu bilang begitu."}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "Tapi yah, begitulah intinya."}
{"category": "LocationDialogue Location10", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "Baiklah, tapi kenapa aku harus memahami itu?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "Sebelumnya aku sudah bilang kan,"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "kalau pergi lebih jauh itu berbahaya?"}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "Kamu nanti bakal ketemu... banyak model buangan..."}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "Model yang \"cacat\"."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "Mereka agresif! Kamu beneran mau melangkah lebih jauh?"}
{"category": "LocationDialogue Location10", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "Jadi, aku harus bagaimana?"}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Aku kan harus pergi"}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "kemanapun pintu terbuka."}
{"category": "LocationDialogue Location10", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "Wow!"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "Kalau begitu jangan membelakangi mereka."}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "Dan jangan biarkan mereka lepas dari pandanganmu!"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "Mereka bakal malu kalau kamu tatap mereka,"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "jadi tidak akan bergerak."}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "Ingat itu, ya!"}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// Quest 1 (Why are there other Mitas down there?)"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "Mereka itu baru saja dibuat."}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "Mereka butuh waktu"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "untuk mendapatkan kesadaran diri."}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "Lalu aku memandu mereka"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "ke rumahnya masing-masing."}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// Quest 2 (Why is it so dark downstairs?)"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "Kami para Mita 'diciptakan' di kegelapan,"}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "jadi kami harus tetap di sana untuk sementara waktu."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Bayangkan"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "akan sesakit apa kalau dari kegelapan langsung terkena cahaya..."}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// Quest 3 (What are you doing here?)"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "Duh, masih belum paham?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "Aku membantu Mita baru menyesuaikan diri!"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "Memang siapa lagi yang mau membantu mereka kalau bukan aku?"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "Kamu, hah?"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// Quest 4 (Why do we need this conveyor?)"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "Conveyor belt ini untuk apa?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "Apa ada cukup ruang untuk semua orang?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Sebentar, jangan bilang kalau kamu"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "belum paham cara kerja dunia ini..."}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "Dan bahwa dunia ini tak terbatas?"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "Tak terbatas?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "Uhm..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "Apa maksudmu?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "Jika 1.9 adalah versi terbaru,"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "berarti cuma ada 19 dunia, kan."}
{"category": "LocationDialogue Location10", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "Ya ampun, kamu benar-benar sama sekali"}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "enggak paham gimana cara kerja dunia ini."}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Sini deh, aku akan gunakan papan tulis ini"}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "untuk menjelaskan semuanya."}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "Mau dengar tidak?"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// Quest 5 (What is your version?)"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Sebentar,"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "bukannya aku pernah ketemu kamu di versi terbaru?"}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "Atau mungkin itu cuma imajinasiku saja."}
{"category": "LocationDialogue Location10", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "Bisa saja, sih."}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Aku dari versi 1.5."}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "Kamu pernah ke sana?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Pernah."}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "Itu versi yang aku datangi"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "saat masuk ke dunia ini!"}
{"category": "LocationDialogue Location10", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "Wah!"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "Kok bisa...?"}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "Tapi indeks rumah apa yang kamu masuki?"}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "Ada 'aku' yang tidak bisa berhenti mengeluh,"}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "'aku' yang suka bercanda,"}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "'aku' yang pelupa dan suka mengganggu orang lain..."}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "Aduh, daftarnya panjang banget..."}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Ceritakan apa yang kamu ingat."}
{"category": "LocationDialogue Location10", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Tempatnya gelap."}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "Lalu ada tulisan"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "semacam..."}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "\"Ayo bermain denganku.\""}
{"category": "LocationDialogue Location10", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "Ah,"}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "berabe banget..."}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "Dia adalah 'aku'"}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "yang suka megganggu dan pelupa."}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// Mita wants to tell you [No]"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Makasih, tapi enggak deh."}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Enggak tahu apa-apa juga enggak masalah bagiku."}
{"category": "LocationDialogue Location10", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "Baiklah, sesukamu saja."}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// Mita wants to tell you [Yes]."}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "Oke, bolehlah."}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "Semoga saja penjelasannya enggak seperti waktu di SMA dulu "}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "yang membosankan sampai bikin aku ngantuk."}
{"category": "LocationDialogue Location10", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "Kamu boleh pergi kapanpun kok,"}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "atau tetap mendengarkan juga boleh"}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "kalau kamu tertarik."}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "Seorang pemain mengunduh MiSide"}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "dan bermain selama yang dia inginkan."}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "Di sana, dia menciptakan rumah baru"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "dan Mita baru."}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "Ini adalah representasi 2D-nya."}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "Ini adalah versi-versinya,"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "yang ditampilkan sebagai garis."}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "Rumah-rumahnya terletak pada garis ini."}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "Anggaplah kamu mengunduh versi 1.14,"}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "yang berarti hidup baru,"}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "Mita baru, dan rumah baru."}
{"category": "LocationDialogue Location10", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "Wow..."}
{"category": "LocationDialogue Location10", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Kamu bisa menanyakan detail"}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "pada gambar ini,"}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "dan aku akan jelaskan sebaik mungkin."}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// He asks about the only circle"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "Mengapa hanya ada satu lingkaran saja?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "Versi itu hanya dirilis sekali,"}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "dan tidak pernah diulang lagi."}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "Ini satu-satunya versi yang benar-benar unik."}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "Ditambah, versi ini istimewa"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "dan tidak memiliki jalur ke versi lain."}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "Mita Turu berada di versi ini, 1.1."}
{"category": "LocationDialogue Location10", "line_index": 171, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "Mita Turu?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "Apa dia jarang tidur karena "}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "orang-orang melewati versi dia?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "Tidak, bukan begitu."}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "Mau kamu buat suara sekeras apapun di hadapannya,"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "dia itu tidak akan bisa dibangunkan."}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// He asks about the shaded circle"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "Mengapa lingkarin ini bergaris?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "Uhm, kalau yang itu"}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "penyebabnya karena Mita Cecan."}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "Dia yang menggambarnya."}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "Kami berdua adu mulut "}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "siapa yang paling cepat dalam mencapai versi 1.11."}
{"category": "LocationDialogue Location10", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "Lalu siapa yang menang?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "AKU, tentu saja!"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "Lihat, kami ini kan dari "}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "versi 1.15,"}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "indeks rumah 809."}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "Terus kami harus mencapai versi 1.11, "}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "indeks rumah 805."}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Jadi, jalurnya dia itu dimulai seperti ini."}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "Kami mencoba mencari rute yang lebih pendek,"}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "makanya Mita Cecan menyarankan jalur ini."}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "Kemudian aku gambarkan yang paling sederhana di sini."}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "Mudah, kan?"}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Lihat, nih."}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "Dari sini, kamu bisa langsung tiba ke versi yang dibutuhkan."}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Meski tampaknya rumah ini menghalangi jalan,"}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "tapi sebenarnya bisa dilewatin..."}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "Omong-omong, cincinmu juga bekerja dengan prinsip yang sama."}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "Kemana tujuanmu pergi?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "Core."}
{"category": "LocationDialogue Location10", "line_index": 210, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "Core?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "Hmm..."}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Kalau kamu menginginkan rute terpendek,"}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "kamu juga harus melewati versi 1.11."}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "Kamu pasti bakal ketemu Mita Turu di sana."}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Sepertinya Mita yang mengirimkan dirimu,"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "mengambil jalur yang sama."}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "Atau mungkin dia enggak sadar kamu ada di jalur yang berbeda."}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "Atau mungkin saja dia seorang jenius"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "dan berhasil mendapatkan rute yang lebih pendek lagi!"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Kayaknya aku mulai paham."}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// He asks about the inscription"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "Apa maksudnya ini?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "Oh, itu buat si Mita Perkasa."}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "Beberapa jam lagi dia akan datang kemari."}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "Dia akan memindahkan kotak-kotak itu"}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "dan meletakkan sofa di sini."}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "Karena pantatku sakit!"}
{"category": "LocationDialogue Location10", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Emm..."}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "Mungkin aku bisa bantu?"}
{"category": "LocationDialogue Location10", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "Enggak perlu, itu tugasnya Mita Perkasa."}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Dia itu kuat."}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// He asks about the drawings"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "Itu cuma coretan,"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "atau"}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "ada artinya?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 244, "text": "Iya,"}
{"category": "LocationDialogue Location10", "line_index": 245, "text": "itu cuma coretan."}
