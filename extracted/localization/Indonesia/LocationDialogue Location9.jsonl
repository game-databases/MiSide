{"category": "LocationDialogue Location9", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Hei, kamu!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Halo!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Kamu mau keluar?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Kalau begitu, bantu aku cari kuncinya!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Sial! Enggak ada kunci di sini!"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Di sini juga enggak ada—"}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "Enggak ada sama sekali!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Ketemu!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// The usual conversation"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Oh, aku kira kamu bakal lebih pendek!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "Ternyata kamu tinggi—"}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "seperti saudariku!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "Saudarimu?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Iya, saudariku."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Jangan bilang kamu belum pernah ketemu dia!?"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Uh... Pernah... Kayaknya?"}
{"category": "LocationDialogue Location9", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Kamu ini bodoh, ya?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "Erm..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "Hadeh, memang bodoh ternyata..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "Sudahlah, buruan bantu aku cari kuncinya!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// Next work"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Sini."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Masukkan besinya ke pipa!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Terima kasih!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "Sekarang ambilkan aku kayu itu!"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Terima kasih!"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Tolong bantu lagi, ya!"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Sudah selesai! Sekarang..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "wow, indahnya."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Ayo, tekan itu!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Siap-siap, ya..."}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "nih, ambil!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "Kuncinya buat kamu!"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// Quest 1 (Are you Mita?)"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Aku ChibiMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Punya banyak dialog,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "berbentuk paling simpel, dan—"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "yang terbaik—punya rambut indah!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// Quest 2 (Have we seen each other yet?)"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Dasar bodoh!"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "Yah, kamu lumayan lucu sih,"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "karena menanyakan pertanyaan konyol kayak gitu."}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Sayangnya,"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "ini pertama kalinya kita bertemu!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Tapi..."}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Kalau kamu mencuri penampilanku yang luar biasa ini, "}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "aku bakal bikin kamu menyesal!"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// Quest 3 (Why are you here?)"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Kamu masih belum paham?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "Ini tuh checkpoint—"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "untuk menguji kegigihanmu!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "Nah, ayo bergegas!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Aku di sini untuk membimbing jiwa yang tersesat!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// Quest 4 (Why are you helping me?)"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "Maksud kamu?"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "Kamu enggak berhak dibantu, begitu?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "Apa?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Betul-betul, ya..."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Kamu kan tiba-tiba muncul entah darimana!"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Kamu tuh harusnya enggak boleh ada di sini,"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "makanya aku bantu kamu!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Dadah, bodoh!"}
