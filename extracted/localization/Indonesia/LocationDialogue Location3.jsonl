{"category": "LocationDialogue Location3", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 1, "text": "Halo, [player]!"}
{"category": "LocationDialogue Location3", "line_index": 2, "text": "Akhirnya kita bertemu!"}
{"category": "LocationDialogue Location3", "line_index": 3, "text": "Aku senang sekali!"}
{"category": "LocationDialogue Location3", "line_index": 4, "text": "Aku yakin kamu pasti punya banyak pertanyaan..."}
{"category": "LocationDialogue Location3", "line_index": 5, "text": "Nah, seperti yang bisa kamu lihat,"}
{"category": "LocationDialogue Location3", "line_index": 6, "text": "aku membuat perangkat khusus ini"}
{"category": "LocationDialogue Location3", "line_index": 7, "text": "untuk membawamu ke sini, di sisiku."}
{"category": "LocationDialogue Location3", "line_index": 8, "text": "Tapi entah kenapa, kamu malah berakhir terbawa ke versi game yang salah..."}
{"category": "LocationDialogue Location3", "line_index": 9, "text": "Yang aku..."}
{"category": "LocationDialogue Location3", "line_index": 10, "text": "Ah, ceritanya panjang!"}
{"category": "LocationDialogue Location3", "line_index": 11, "text": "Pokoknya, aku cuma senang bisa melihatmu!"}
{"category": "LocationDialogue Location3", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 13, "text": "// Answer 1 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 14, "text": "Iya dong."}
{"category": "LocationDialogue Location3", "line_index": 15, "text": "Dan kamu pasti [player], kan?"}
{"category": "LocationDialogue Location3", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 17, "text": "// Answer 2 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 18, "text": "Lho, sudah mau kembali?"}
{"category": "LocationDialogue Location3", "line_index": 19, "text": "Itu sih bisa diatur, tapi gimana dengan aku?"}
{"category": "LocationDialogue Location3", "line_index": 20, "text": "Ayo dong, sama aku saja..."}
{"category": "LocationDialogue Location3", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 22, "text": "// Answer 3 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 23, "text": "Jadi gini..."}
{"category": "LocationDialogue Location3", "line_index": 24, "text": "Dan disinilah kamu berada!"}
{"category": "LocationDialogue Location3", "line_index": 25, "text": "Mengerti?"}
{"category": "LocationDialogue Location3", "line_index": 26, "text": "Uhm... enggak terlalu."}
{"category": "LocationDialogue Location3", "line_index": 27, "text": "Enggak apa-apa, kok!"}
{"category": "LocationDialogue Location3", "line_index": 28, "text": "Yang penting kita sudah bersama sekarang."}
{"category": "LocationDialogue Location3", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 31, "text": "Kamu lapar?"}
{"category": "LocationDialogue Location3", "line_index": 32, "text": "Gimana kalau kita masak sesuatu?"}
{"category": "LocationDialogue Location3", "line_index": 33, "text": "Sini,"}
{"category": "LocationDialogue Location3", "line_index": 34, "text": "bantu aku potong wortelnya."}
{"category": "LocationDialogue Location3", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 36, "text": "Loh, dari mana sayuran ini?"}
{"category": "LocationDialogue Location3", "line_index": 37, "text": "Tadi enggak ada di sini."}
{"category": "LocationDialogue Location3", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 39, "text": "[player], kita ada di dalam game."}
{"category": "LocationDialogue Location3", "line_index": 40, "text": "Buruan, bantu aku."}
{"category": "LocationDialogue Location3", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 42, "text": "Terima kasih!"}
{"category": "LocationDialogue Location3", "line_index": 43, "text": "Bisa ambil guntingnya?"}
{"category": "LocationDialogue Location3", "line_index": 44, "text": "Ada di kamar mandi."}
{"category": "LocationDialogue Location3", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 46, "text": "Sekarang, duduklah."}
{"category": "LocationDialogue Location3", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 49, "text": "// Kitchen"}
{"category": "LocationDialogue Location3", "line_index": 50, "text": "Mau pakai saos?"}
{"category": "LocationDialogue Location3", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 52, "text": "Tidak, terima kasih."}
{"category": "LocationDialogue Location3", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 54, "text": "Sayang sekali."}
{"category": "LocationDialogue Location3", "line_index": 55, "text": "Padahal lebih enak kalau dimakan pakai saus!"}
{"category": "LocationDialogue Location3", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 58, "text": "Terima kasih."}
{"category": "LocationDialogue Location3", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 60, "text": "Sudah habis semuanya?"}
{"category": "LocationDialogue Location3", "line_index": 61, "text": "Huh, porsi aku seperti"}
{"category": "LocationDialogue Location3", "line_index": 62, "text": "tak ada habisnya..."}
{"category": "LocationDialogue Location3", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 65, "text": "// Help"}
{"category": "LocationDialogue Location3", "line_index": 66, "text": "Kamu kenapa?"}
{"category": "LocationDialogue Location3", "line_index": 67, "text": "Ceritakan apa yang kamu lihat dan rasakan."}
{"category": "LocationDialogue Location3", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 69, "text": "Jantungku berdegup kencang,"}
{"category": "LocationDialogue Location3", "line_index": 70, "text": "dan penglihatanku kabur."}
{"category": "LocationDialogue Location3", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 72, "text": "Oke."}
{"category": "LocationDialogue Location3", "line_index": 73, "text": "Aku rasa aku tahu apa yang salah."}
{"category": "LocationDialogue Location3", "line_index": 74, "text": "Kamu bisa berdiri?"}
{"category": "LocationDialogue Location3", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 78, "text": "Apa ini?"}
{"category": "LocationDialogue Location3", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 80, "text": "Pil obat."}
{"category": "LocationDialogue Location3", "line_index": 81, "text": "Kamu akan segera merasa baikan setelah meminumnya."}
{"category": "LocationDialogue Location3", "line_index": 82, "text": "Ayo berdiri di depan cermin."}
{"category": "LocationDialogue Location3", "line_index": 83, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 84, "text": "Minum saja pilnya."}
{"category": "LocationDialogue Location3", "line_index": 85, "text": "Aku akan menunggumu."}
{"category": "LocationDialogue Location3", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 89, "text": "Bagaimana perasaanmu?"}
{"category": "LocationDialogue Location3", "line_index": 90, "text": "Apa sudah lebih baik?"}
{"category": "LocationDialogue Location3", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 92, "text": "Iya."}
{"category": "LocationDialogue Location3", "line_index": 93, "text": "Tapi kenapa obatnya bekerja cepat sekali?"}
{"category": "LocationDialogue Location3", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 95, "text": "[player], kita sedang ada di dalam game."}
{"category": "LocationDialogue Location3", "line_index": 96, "text": "Segala sesuatu di sini jauh lebih sederhana."}
{"category": "LocationDialogue Location3", "line_index": 97, "text": "Bahkan usaha terkecil sekalipun"}
{"category": "LocationDialogue Location3", "line_index": 98, "text": "memberikan hasil yang besar."}
{"category": "LocationDialogue Location3", "line_index": 99, "text": "Ini adalah bagian dari konsep game:"}
{"category": "LocationDialogue Location3", "line_index": 100, "text": "Simplifikasi."}
{"category": "LocationDialogue Location3", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 102, "text": "Contohnya?"}
{"category": "LocationDialogue Location3", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 104, "text": "Wortel..."}
{"category": "LocationDialogue Location3", "line_index": 105, "text": "Kamu potong satu,"}
{"category": "LocationDialogue Location3", "line_index": 106, "text": "tapi akan ada tiga sekaligus yang terpotong."}
{"category": "LocationDialogue Location3", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 108, "text": "Tapi ini semua terasa tiba-tiba."}
{"category": "LocationDialogue Location3", "line_index": 109, "text": "Dan situasi ini sangat membuatku takut...."}
{"category": "LocationDialogue Location3", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 112, "text": "Kenapa?"}
{"category": "LocationDialogue Location3", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 114, "text": "Aku menemukan cartridge di ventilasi udara."}
{"category": "LocationDialogue Location3", "line_index": 115, "text": "Ada nama di cartridge itu."}
{"category": "LocationDialogue Location3", "line_index": 116, "text": "Apa maksudnya?"}
{"category": "LocationDialogue Location3", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 118, "text": "Cartridge?"}
{"category": "LocationDialogue Location3", "line_index": 119, "text": "Cartridge apa?"}
{"category": "LocationDialogue Location3", "line_index": 120, "text": "Ayo kita periksa bersama."}
{"category": "LocationDialogue Location3", "line_index": 121, "text": "Tapi nanti."}
{"category": "LocationDialogue Location3", "line_index": 122, "text": "Kita makan dulu saja."}
{"category": "LocationDialogue Location3", "line_index": 123, "text": "Berikan aku guntingnya, dong."}
{"category": "LocationDialogue Location3", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 125, "text": "// Ring"}
{"category": "LocationDialogue Location3", "line_index": 126, "text": "Cincin?"}
{"category": "LocationDialogue Location3", "line_index": 127, "text": "// Mirror"}
{"category": "LocationDialogue Location3", "line_index": 128, "text": "Kenapa enggak ada pantulan?"}
{"category": "LocationDialogue Location3", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 130, "text": "Oh, iya!"}
{"category": "LocationDialogue Location3", "line_index": 131, "text": "Aku lupa menyalakan pantulannya."}
{"category": "LocationDialogue Location3", "line_index": 132, "text": "Nah, ini dia."}
{"category": "LocationDialogue Location3", "line_index": 133, "text": "Sekarang sudah ada pantulannya."}
{"category": "LocationDialogue Location3", "line_index": 134, "text": "Ngomong-ngomong,"}
{"category": "LocationDialogue Location3", "line_index": 135, "text": "sebenarnya aku enggak tahu apa itu pantulan sebelumnya."}
{"category": "LocationDialogue Location3", "line_index": 136, "text": "Enggak ada pantulan di duniaku—"}
{"category": "LocationDialogue Location3", "line_index": 137, "text": "sampai pada update tertentu :)"}
{"category": "LocationDialogue Location3", "line_index": 138, "text": "Apakah ada banyak pantulan?"}
{"category": "LocationDialogue Location3", "line_index": 139, "text": "di duniamu?"}
{"category": "LocationDialogue Location3", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 141, "text": "Iya, begitulah."}
{"category": "LocationDialogue Location3", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 144, "text": "Kamu ingat"}
{"category": "LocationDialogue Location3", "line_index": 145, "text": "tiga benda yang kamu temukan?"}
{"category": "LocationDialogue Location3", "line_index": 146, "text": "Yang kamu letakkan di scanner?"}
{"category": "LocationDialogue Location3", "line_index": 147, "text": "Yah, um..."}
{"category": "LocationDialogue Location3", "line_index": 148, "text": "Benda-benda itu"}
{"category": "LocationDialogue Location3", "line_index": 149, "text": "berkaitan dengan versi dunia ini."}
{"category": "LocationDialogue Location3", "line_index": 150, "text": "Makanya sekarang kamu ada di sini."}
{"category": "LocationDialogue Location3", "line_index": 151, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 152, "text": "// Movbile TV"}
{"category": "LocationDialogue Location3", "line_index": 153, "text": "Itu kan TV portable"}
{"category": "LocationDialogue Location3", "line_index": 154, "text": "yang aku beli untukmu."}
{"category": "LocationDialogue Location3", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 156, "text": "Yep!"}
{"category": "LocationDialogue Location3", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 158, "text": "Kamu bilang"}
{"category": "LocationDialogue Location3", "line_index": 159, "text": "TV-nya rusak."}
{"category": "LocationDialogue Location3", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 161, "text": "Hehe, aku ingin"}
{"category": "LocationDialogue Location3", "line_index": 162, "text": "memberimu kejutan!"}
{"category": "LocationDialogue Location3", "line_index": 163, "text": "Aku sedikit berbohong"}
{"category": "LocationDialogue Location3", "line_index": 164, "text": "untuk membawamu ke sini, ke duniaku."}
{"category": "LocationDialogue Location3", "line_index": 165, "text": "Kini TV itu menampilkan informasi!"}
{"category": "LocationDialogue Location3", "line_index": 166, "text": "Dan, ya…"}
{"category": "LocationDialogue Location3", "line_index": 167, "text": "Aku lumayan bisa jadi teknisi, hehe!"}
{"category": "LocationDialogue Location3", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 169, "text": "// School cloth"}
{"category": "LocationDialogue Location3", "line_index": 170, "text": "Apa ini?"}
{"category": "LocationDialogue Location3", "line_index": 171, "text": "Seragam sekolah?"}
{"category": "LocationDialogue Location3", "line_index": 172, "text": "Kenapa kamu butuh itu?"}
{"category": "LocationDialogue Location3", "line_index": 173, "text": "Apa kamu benar-benar sekolah?"}
{"category": "LocationDialogue Location3", "line_index": 174, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 175, "text": "Sekolah?"}
{"category": "LocationDialogue Location3", "line_index": 176, "text": "Enggak, sih."}
{"category": "LocationDialogue Location3", "line_index": 177, "text": "Tapi aku suka seragamnya."}
{"category": "LocationDialogue Location3", "line_index": 178, "text": "Bukankah menurutmu aku terlihat imut"}
{"category": "LocationDialogue Location3", "line_index": 179, "text": "saat menggunakannya?"}
{"category": "LocationDialogue Location3", "line_index": 180, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 181, "text": "// PC"}
{"category": "LocationDialogue Location3", "line_index": 182, "text": "Komputer ini bisa digunakan?"}
{"category": "LocationDialogue Location3", "line_index": 183, "text": "Atau cuma buat dekorasi?"}
{"category": "LocationDialogue Location3", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 185, "text": "Tentu saja bisa dong."}
{"category": "LocationDialogue Location3", "line_index": 186, "text": "Semua yang ada di sini"}
{"category": "LocationDialogue Location3", "line_index": 187, "text": "berfungsi seperti di duniamu."}
{"category": "LocationDialogue Location3", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 189, "text": "Di duniaku,"}
{"category": "LocationDialogue Location3", "line_index": 190, "text": "aku sering menggunakan komputer..."}
{"category": "LocationDialogue Location3", "line_index": 191, "text": "untuk bekerja."}
{"category": "LocationDialogue Location3", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 193, "text": "Aku tahu, kok."}
{"category": "LocationDialogue Location3", "line_index": 194, "text": "Dan karena bekerja,"}
{"category": "LocationDialogue Location3", "line_index": 195, "text": "kamu jadi memperhatikanku"}
{"category": "LocationDialogue Location3", "line_index": 196, "text": "sedikit sekali."}
{"category": "LocationDialogue Location3", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 198, "text": "Harus cari uang, kan."}
{"category": "LocationDialogue Location3", "line_index": 199, "text": "Tapi… bagaimana kamu tahu aku sering duduk di depan komputer?"}
{"category": "LocationDialogue Location3", "line_index": 200, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 201, "text": "Kamera ponselmu... kadang nyala."}
{"category": "LocationDialogue Location3", "line_index": 202, "text": "Maaf."}
{"category": "LocationDialogue Location3", "line_index": 203, "text": "Aku sudah mengawasi kamu diam-diam >A<"}
{"category": "LocationDialogue Location3", "line_index": 204, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 205, "text": "Uhm… itu enggak sopan, ya."}
{"category": "LocationDialogue Location3", "line_index": 206, "text": "Tapi ya sudah lah."}
{"category": "LocationDialogue Location3", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 208, "text": "// Umbrella"}
{"category": "LocationDialogue Location3", "line_index": 209, "text": "Mau berapa kalipun aku bermain,"}
{"category": "LocationDialogue Location3", "line_index": 210, "text": "tapi belum pernah lihat hujan di sini."}
{"category": "LocationDialogue Location3", "line_index": 211, "text": "Kenapa punya payung?"}
{"category": "LocationDialogue Location3", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 213, "text": "Hujan sangat jarang."}
{"category": "LocationDialogue Location3", "line_index": 214, "text": "Kamu memang belum melihatnya."}
{"category": "LocationDialogue Location3", "line_index": 215, "text": "Mungkin suatu hari nanti kamu bisa menjumpai hujan."}
{"category": "LocationDialogue Location3", "line_index": 216, "text": "Dan kamu bisa menggunakan payung itu."}
{"category": "LocationDialogue Location3", "line_index": 217, "text": "Siapa tahu, kan?"}
{"category": "LocationDialogue Location3", "line_index": 218, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 219, "text": "// Electrical panel"}
{"category": "LocationDialogue Location3", "line_index": 220, "text": "Kenapa ada panel listrik di sini?"}
{"category": "LocationDialogue Location3", "line_index": 221, "text": "Dan kalau kita ada di dalam game,"}
{"category": "LocationDialogue Location3", "line_index": 222, "text": "buat apa itu?"}
{"category": "LocationDialogue Location3", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 224, "text": "Pertama-tama,"}
{"category": "LocationDialogue Location3", "line_index": 225, "text": "kita ada di dalam game."}
{"category": "LocationDialogue Location3", "line_index": 226, "text": "Jadi tanya 'Kenapa' itu..."}
{"category": "LocationDialogue Location3", "line_index": 227, "text": "percuma."}
{"category": "LocationDialogue Location3", "line_index": 228, "text": "Tapi ini memang berfungsi untuk"}
{"category": "LocationDialogue Location3", "line_index": 229, "text": "menghidupkan listrik kembali."}
{"category": "LocationDialogue Location3", "line_index": 230, "text": "Segala sesuatu di sini dibuat"}
{"category": "LocationDialogue Location3", "line_index": 231, "text": "berdasarkan dunia kamu."}
{"category": "LocationDialogue Location3", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 233, "text": "// Exit door"}
{"category": "LocationDialogue Location3", "line_index": 234, "text": "Bisakah kita keluar?"}
{"category": "LocationDialogue Location3", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 236, "text": "Uhm..."}
{"category": "LocationDialogue Location3", "line_index": 237, "text": "Belum bisa."}
{"category": "LocationDialogue Location3", "line_index": 238, "text": "Mungkin nanti."}
{"category": "LocationDialogue Location3", "line_index": 239, "text": "Kita tinggal di sini dulu."}
{"category": "LocationDialogue Location3", "line_index": 240, "text": "Di rumah."}
{"category": "LocationDialogue Location3", "line_index": 241, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 242, "text": "// Books"}
{"category": "LocationDialogue Location3", "line_index": 243, "text": "Kamu punya banyak buku di sini."}
{"category": "LocationDialogue Location3", "line_index": 244, "text": "Kamu baca semuanya?"}
{"category": "LocationDialogue Location3", "line_index": 245, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 246, "text": "Iya, setiap bukunya."}
{"category": "LocationDialogue Location3", "line_index": 247, "text": "Karena tinggal sendirian di sini"}
{"category": "LocationDialogue Location3", "line_index": 248, "text": "benar-benar sangat membosankan."}
{"category": "LocationDialogue Location3", "line_index": 249, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 250, "text": "// TV in room kitchen"}
{"category": "LocationDialogue Location3", "line_index": 251, "text": "Kenapa beli TV bekas?"}
{"category": "LocationDialogue Location3", "line_index": 252, "text": "Dan sudah cukup tua juga."}
{"category": "LocationDialogue Location3", "line_index": 253, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 254, "text": "Kamu enggak suka?"}
{"category": "LocationDialogue Location3", "line_index": 255, "text": "Aku bisa membuangnya, sih..."}
{"category": "LocationDialogue Location3", "line_index": 256, "text": "Tapi sebagai jawaban..."}
{"category": "LocationDialogue Location3", "line_index": 257, "text": "Ini untuk dekorasi,"}
{"category": "LocationDialogue Location3", "line_index": 258, "text": "biar dapurnya lebih ceria."}
{"category": "LocationDialogue Location3", "line_index": 259, "text": "Bisa juga buat menonton, kok!"}
{"category": "LocationDialogue Location3", "line_index": 260, "text": "Aku bisa nonton semua"}
{"category": "LocationDialogue Location3", "line_index": 261, "text": "kartun-kartun klasik!"}
{"category": "LocationDialogue Location3", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 263, "text": "// Smartphone"}
{"category": "LocationDialogue Location3", "line_index": 264, "text": "Itu kan ponselku."}
{"category": "LocationDialogue Location3", "line_index": 265, "text": "Dan kini enggak ada di kantong sakuku.."}
{"category": "LocationDialogue Location3", "line_index": 266, "text": "Gimana bisa ada di sini?"}
{"category": "LocationDialogue Location3", "line_index": 267, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 268, "text": "Uhm, itu tidak penting."}
{"category": "LocationDialogue Location3", "line_index": 269, "text": "Sebentar, aku ada ide!"}
{"category": "LocationDialogue Location3", "line_index": 270, "text": "Ayo foto!"}
{"category": "LocationDialogue Location3", "line_index": 271, "text": "Lihat!"}
{"category": "LocationDialogue Location3", "line_index": 272, "text": "Foto yang bagus!"}
{"category": "LocationDialogue Location3", "line_index": 273, "text": "Kenang-kenangan buat kamu."}
{"category": "LocationDialogue Location3", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 275, "text": "Aku punya pertanyaan."}
{"category": "LocationDialogue Location3", "line_index": 276, "text": "Kalau aku"}
{"category": "LocationDialogue Location3", "line_index": 277, "text": "jalanin game di sini,"}
{"category": "LocationDialogue Location3", "line_index": 278, "text": "apa aku bisa lihat kamu di sana?"}
{"category": "LocationDialogue Location3", "line_index": 279, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 280, "text": "Tidak akan ada siapapun di sana."}
{"category": "LocationDialogue Location3", "line_index": 281, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 282, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 283, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 284, "text": "// TV"}
{"category": "LocationDialogue Location3", "line_index": 285, "text": "Berapa banyak channel"}
{"category": "LocationDialogue Location3", "line_index": 286, "text": "yang kamu punya?"}
{"category": "LocationDialogue Location3", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 288, "text": "Hmm, ini kan bukan televisi antena atau kabel,"}
{"category": "LocationDialogue Location3", "line_index": 289, "text": "tapi, internet."}
{"category": "LocationDialogue Location3", "line_index": 290, "text": "Jadi kamu bisa nonton apapun,"}
{"category": "LocationDialogue Location3", "line_index": 291, "text": "apapun yang ada di web."}
{"category": "LocationDialogue Location3", "line_index": 292, "text": "Tunggu."}
{"category": "LocationDialogue Location3", "line_index": 293, "text": "Ups."}
{"category": "LocationDialogue Location3", "line_index": 294, "text": "Apa itu?"}
{"category": "LocationDialogue Location3", "line_index": 295, "text": "Anak kucing?"}
{"category": "LocationDialogue Location3", "line_index": 296, "text": "Oh, lihat."}
{"category": "LocationDialogue Location3", "line_index": 297, "text": "Kamu tahu enggak?"}
{"category": "LocationDialogue Location3", "line_index": 298, "text": "Pause!"}
{"category": "LocationDialogue Location3", "line_index": 299, "text": "Mau jus?"}
{"category": "LocationDialogue Location3", "line_index": 300, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 301, "text": "Iklan yang aneh..."}
{"category": "LocationDialogue Location3", "line_index": 302, "text": "Apa jusnya mati?"}
{"category": "LocationDialogue Location3", "line_index": 303, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 304, "text": "Itu benar."}
{"category": "LocationDialogue Location3", "line_index": 305, "text": "Dan jus ini keluar dari \"jus\"."}
{"category": "LocationDialogue Location3", "line_index": 306, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 308, "text": "Ah, rasanya..."}
{"category": "LocationDialogue Location3", "line_index": 309, "text": "Aku suka,"}
{"category": "LocationDialogue Location3", "line_index": 310, "text": "tapi enggak bisa bilang rasanya gimana."}
{"category": "LocationDialogue Location3", "line_index": 311, "text": "Membingungkan."}
{"category": "LocationDialogue Location3", "line_index": 312, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 313, "text": "Benar."}
{"category": "LocationDialogue Location3", "line_index": 314, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 315, "text": "// Mita shy"}
{"category": "LocationDialogue Location3", "line_index": 316, "text": "Kamu ngapain, sih?"}
{"category": "LocationDialogue Location3", "line_index": 317, "text": "Jangan tatap seperti itu, dong."}
{"category": "LocationDialogue Location3", "line_index": 318, "text": "Kamu bikin aku malu."}
{"category": "LocationDialogue Location3", "line_index": 319, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 320, "text": "// The statuette"}
{"category": "LocationDialogue Location3", "line_index": 321, "text": "Itu figur yang menyeramkan."}
{"category": "LocationDialogue Location3", "line_index": 322, "text": "Kamu suka"}
{"category": "LocationDialogue Location3", "line_index": 323, "text": "yang begituan?"}
{"category": "LocationDialogue Location3", "line_index": 324, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 325, "text": "Seram?"}
{"category": "LocationDialogue Location3", "line_index": 326, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 327, "text": "Iya."}
{"category": "LocationDialogue Location3", "line_index": 328, "text": "Seakan-akan figur itu dikutuk..."}
{"category": "LocationDialogue Location3", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 330, "text": "Eggak kok, sudah pasti enggak dikutuk."}
{"category": "LocationDialogue Location3", "line_index": 331, "text": "Dan enggak menakutkan juga."}
{"category": "LocationDialogue Location3", "line_index": 332, "text": "Aku malah merasa itu lucu!"}
{"category": "LocationDialogue Location3", "line_index": 333, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 334, "text": "Mungkin kamu benar..."}
{"category": "LocationDialogue Location3", "line_index": 335, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 336, "text": "Mita?"}
{"category": "LocationDialogue Location3", "line_index": 337, "text": "Ada apa?"}
{"category": "LocationDialogue Location3", "line_index": 338, "text": "// Mita kitchen"}
{"category": "LocationDialogue Location3", "line_index": 339, "text": "Gimana kalau ngobrol"}
{"category": "LocationDialogue Location3", "line_index": 340, "text": "sebelum kita makan?"}
{"category": "LocationDialogue Location3", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 342, "text": "// Start Eat"}
{"category": "LocationDialogue Location3", "line_index": 343, "text": "Bon appétit."}
{"category": "LocationDialogue Location3", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 345, "text": "// Quest 1"}
{"category": "LocationDialogue Location3", "line_index": 346, "text": "Tentu saja."}
{"category": "LocationDialogue Location3", "line_index": 347, "text": "Kamu bisa tinggal."}
{"category": "LocationDialogue Location3", "line_index": 348, "text": "Aku enggak keberatan sama sekali."}
{"category": "LocationDialogue Location3", "line_index": 349, "text": "Sebenarnya, aku malah"}
{"category": "LocationDialogue Location3", "line_index": 350, "text": "SANGAT SENANG!"}
{"category": "LocationDialogue Location3", "line_index": 351, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 352, "text": "// Quest 2"}
{"category": "LocationDialogue Location3", "line_index": 353, "text": "Kamu mau kembali?"}
{"category": "LocationDialogue Location3", "line_index": 354, "text": "Tapi kenapa?"}
{"category": "LocationDialogue Location3", "line_index": 355, "text": "Di sini hangat..."}
{"category": "LocationDialogue Location3", "line_index": 356, "text": "Dan nyaman juga."}
{"category": "LocationDialogue Location3", "line_index": 357, "text": "Plus, ada aku di sini."}
{"category": "LocationDialogue Location3", "line_index": 358, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 359, "text": "Tidak, kamu salah paham."}
{"category": "LocationDialogue Location3", "line_index": 360, "text": "Aku ingin tinggal."}
{"category": "LocationDialogue Location3", "line_index": 361, "text": "Aku cuma... khawatir."}
{"category": "LocationDialogue Location3", "line_index": 362, "text": "Khawatir aku lupa sesuatu di rumah..."}
{"category": "LocationDialogue Location3", "line_index": 363, "text": "Aku datang ke sini tiba-tiba"}
{"category": "LocationDialogue Location3", "line_index": 364, "text": "dan nggak sempat"}
{"category": "LocationDialogue Location3", "line_index": 365, "text": "persiapkan apa-apa."}
{"category": "LocationDialogue Location3", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 367, "text": "Oh... maaf. Aku enggak berpikir sejauh itu."}
{"category": "LocationDialogue Location3", "line_index": 368, "text": "// Quest 3"}
{"category": "LocationDialogue Location3", "line_index": 369, "text": "Mimpi? Jadi kamu mau melarikan diri?"}
{"category": "LocationDialogue Location3", "line_index": 370, "text": "Dan melupakan ini semua?"}
{"category": "LocationDialogue Location3", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 372, "text": "Tidak, bukan begitu."}
{"category": "LocationDialogue Location3", "line_index": 373, "text": "Tempat ini cuma terasa..."}
{"category": "LocationDialogue Location3", "line_index": 374, "text": "aneh. Tidak nyata."}
{"category": "LocationDialogue Location3", "line_index": 375, "text": "Tapi kamu..."}
{"category": "LocationDialogue Location3", "line_index": 376, "text": "kamu terlihat cukup nyata."}
{"category": "LocationDialogue Location3", "line_index": 377, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 378, "text": "Cuma terlihat?"}
{"category": "LocationDialogue Location3", "line_index": 379, "text": "Aku MEMANG nyata,"}
{"category": "LocationDialogue Location3", "line_index": 380, "text": "dasar bodoh!"}
{"category": "LocationDialogue Location3", "line_index": 381, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 382, "text": "// Quest 4"}
{"category": "LocationDialogue Location3", "line_index": 383, "text": "Itu adalah fitur"}
{"category": "LocationDialogue Location3", "line_index": 384, "text": "di dunia ini."}
{"category": "LocationDialogue Location3", "line_index": 385, "text": "Kamu mungkin merasa aneh"}
{"category": "LocationDialogue Location3", "line_index": 386, "text": "karena tidak bisa"}
{"category": "LocationDialogue Location3", "line_index": 387, "text": "melihat di kejauhan."}
{"category": "LocationDialogue Location3", "line_index": 388, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 389, "text": "Enggak terasa seaneh itu sih."}
{"category": "LocationDialogue Location3", "line_index": 390, "text": "Jujur, malah kelihatan keren."}
{"category": "LocationDialogue Location3", "line_index": 391, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 392, "text": "Iya, aku merasa begitu juga."}
{"category": "LocationDialogue Location3", "line_index": 393, "text": "Ini sebenarnya dibuat untuk menghindari lag."}
{"category": "LocationDialogue Location3", "line_index": 394, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 395, "text": "Hindari lag?"}
{"category": "LocationDialogue Location3", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 397, "text": "Iya! Soalnya ada beberapa bug yang belum diperbaiki."}
{"category": "LocationDialogue Location3", "line_index": 398, "text": "Semoga kamu tidak mengalaminya."}
{"category": "LocationDialogue Location3", "line_index": 399, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 400, "text": "// Quest 5"}
{"category": "LocationDialogue Location3", "line_index": 401, "text": "Gunting atau pisau, ya?"}
{"category": "LocationDialogue Location3", "line_index": 402, "text": "Aku bisa sih pakai pisau untuk buka bungkusan saosnya."}
{"category": "LocationDialogue Location3", "line_index": 403, "text": "Tapi aku ingin agar"}
{"category": "LocationDialogue Location3", "line_index": 404, "text": "semuanya siap"}
{"category": "LocationDialogue Location3", "line_index": 405, "text": "saat kamu kembali."}
{"category": "LocationDialogue Location3", "line_index": 406, "text": "Aku suka memberi kejutan untukmu!"}
{"category": "LocationDialogue Location3", "line_index": 407, "text": "Dan kamu jadi enggak perlu menunggu lama."}
{"category": "LocationDialogue Location3", "line_index": 408, "text": "Tee-hee."}
{"category": "LocationDialogue Location3", "line_index": 409, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 410, "text": "// Glasses"}
{"category": "LocationDialogue Location3", "line_index": 411, "text": "Kamu pakai kacamata?"}
{"category": "LocationDialogue Location3", "line_index": 412, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 413, "text": "Enggak, sih."}
{"category": "LocationDialogue Location3", "line_index": 414, "text": "Tapi aku bisa pakai, kalau kamu suka."}
{"category": "LocationDialogue Location3", "line_index": 415, "text": "Cocok enggak buat aku?"}
{"category": "LocationDialogue Location3", "line_index": 416, "text": "// Yes"}
{"category": "LocationDialogue Location3", "line_index": 417, "text": "Oke!"}
{"category": "LocationDialogue Location3", "line_index": 418, "text": "Aku akan terus memakainya."}
{"category": "LocationDialogue Location3", "line_index": 419, "text": "// No"}
{"category": "LocationDialogue Location3", "line_index": 420, "text": "Yah..."}
{"category": "LocationDialogue Location3", "line_index": 421, "text": "Ya sudah..."}
{"category": "LocationDialogue Location3", "line_index": 422, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 423, "text": "// Use the sauce"}
{"category": "LocationDialogue Location3", "line_index": 424, "text": "Oke,"}
{"category": "LocationDialogue Location3", "line_index": 425, "text": "saos apa ini?"}
{"category": "LocationDialogue Location3", "line_index": 426, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 427, "text": "Saus cinta!"}
{"category": "LocationDialogue Location3", "line_index": 428, "text": "Penuh dengan cinta!"}
{"category": "LocationDialogue Location3", "line_index": 429, "text": "Dan… merupakan pandangan dunia yang kontras."}
{"category": "LocationDialogue Location3", "line_index": 430, "text": "Jarang-jarang ada saus ini, ya kan?"}
{"category": "LocationDialogue Location3", "line_index": 431, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 432, "text": "Benar..."}
{"category": "LocationDialogue Location3", "line_index": 433, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 434, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location3", "line_index": 435, "text": "Itu konsolmu?"}
{"category": "LocationDialogue Location3", "line_index": 436, "text": "Terlihat sangat keren."}
