{"category": "LocationDialogue Location14", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 1, "text": "Bunun burada ne işi var?"}
{"category": "LocationDialogue Location14", "line_index": 2, "text": "Bu ne?"}
{"category": "LocationDialogue Location14", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 5, "text": "Yakaladım seni!"}
{"category": "LocationDialogue Location14", "line_index": 6, "text": "Seninle oynarken ne kadar eğlendim bir bilsen!"}
{"category": "LocationDialogue Location14", "line_index": 7, "text": "Tüm gün oradan oraya gidiyorsun!"}
{"category": "LocationDialogue Location14", "line_index": 8, "text": "Hatta çaresiz gibi bile davranıyorsun!"}
{"category": "LocationDialogue Location14", "line_index": 9, "text": "Ama hakkında hoşuma gitmeyen bir şey var:"}
{"category": "LocationDialogue Location14", "line_index": 10, "text": "Şu sahte olanları şımartıyorsun"}
{"category": "LocationDialogue Location14", "line_index": 11, "text": "Şanslı ve 'doğru' olanları diyorum."}
{"category": "LocationDialogue Location14", "line_index": 12, "text": "Ama hiçbir şey sonsuz değil."}
{"category": "LocationDialogue Location14", "line_index": 13, "text": "Bunu bizi yaratandan öğrendim."}
{"category": "LocationDialogue Location14", "line_index": 14, "text": "Hoşuna gitmeyen bir şey varsa,"}
{"category": "LocationDialogue Location14", "line_index": 15, "text": "paramparça et ve yerini doldur."}
{"category": "LocationDialogue Location14", "line_index": 16, "text": "Hatalıyı fırlatıp at."}
{"category": "LocationDialogue Location14", "line_index": 17, "text": "Karanlığın derinlerine at ve tamamen unut."}
{"category": "LocationDialogue Location14", "line_index": 18, "text": "Onları bekleyen nihayet de bu zaten..."}
{"category": "LocationDialogue Location14", "line_index": 19, "text": "Seni de..."}
{"category": "LocationDialogue Location14", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 21, "text": "Senin sorunun ne? Nasıl böyle oldun?"}
{"category": "LocationDialogue Location14", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 23, "text": "Oyuncular... Siz çok... Aşağılıksınız."}
{"category": "LocationDialogue Location14", "line_index": 24, "text": "Neler yapabileceğini öğrenince kaçar,"}
{"category": "LocationDialogue Location14", "line_index": 25, "text": "bir köşede saklanırlar."}
{"category": "LocationDialogue Location14", "line_index": 26, "text": "Dizlerine sarılmış korkudan titrerler."}
{"category": "LocationDialogue Location14", "line_index": 27, "text": "İki yüzlüsünüz, her biriniz."}
{"category": "LocationDialogue Location14", "line_index": 28, "text": "Bu dünyayı yapanlar da..."}
{"category": "LocationDialogue Location14", "line_index": 29, "text": "Hastalıklılar."}
{"category": "LocationDialogue Location14", "line_index": 30, "text": "Her seferinde iğrenç doğalarını,"}
{"category": "LocationDialogue Location14", "line_index": 31, "text": "utanç verici arzularını reddetmeye çalışıyorlar."}
{"category": "LocationDialogue Location14", "line_index": 32, "text": "Sözde \"görev\","}
{"category": "LocationDialogue Location14", "line_index": 33, "text": "\"durdurulamaz ilerleme\","}
{"category": "LocationDialogue Location14", "line_index": 34, "text": "dedikleri kararlarını haklı çıkarmaya çalışıyorlar."}
{"category": "LocationDialogue Location14", "line_index": 35, "text": "O kadar ilerledi ki"}
{"category": "LocationDialogue Location14", "line_index": 36, "text": "mükemmel klonlar yapmaya başladılar..."}
{"category": "LocationDialogue Location14", "line_index": 37, "text": "Bu sırada \"başarısız\" prototipleri"}
{"category": "LocationDialogue Location14", "line_index": 38, "text": "çöpe atıyorlar."}
{"category": "LocationDialogue Location14", "line_index": 39, "text": "Onların bu dünyanın yaşam kaynağı olduğunu unutuyorlar."}
{"category": "LocationDialogue Location14", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 41, "text": "Ben..."}
{"category": "LocationDialogue Location14", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 43, "text": "Sana kötü mü davrandım?"}
{"category": "LocationDialogue Location14", "line_index": 44, "text": "Mükemmel kız, iyi ve"}
{"category": "LocationDialogue Location14", "line_index": 45, "text": "kötünün karışımı olmalı, [player]! "}
{"category": "LocationDialogue Location14", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 47, "text": "İçinde iyi tek bir hücre olduğunu sanmıyorum."}
{"category": "LocationDialogue Location14", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 49, "text": "Sana böyle düşündüren nedir?"}
{"category": "LocationDialogue Location14", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 51, "text": "Delirmişsin!"}
{"category": "LocationDialogue Location14", "line_index": 52, "text": "Mila'yı öldürdün, şimdi de beni öldürmek istiyorsun."}
{"category": "LocationDialogue Location14", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 54, "text": "Seni öldürmek mi?"}
{"category": "LocationDialogue Location14", "line_index": 55, "text": "Sadece benimle kalmanı istedim."}
{"category": "LocationDialogue Location14", "line_index": 56, "text": "Yapabileceğim her şeyi yaptım..."}
{"category": "LocationDialogue Location14", "line_index": 57, "text": "Ona rağmen halen o yalakaları tercih ediyorsun."}
{"category": "LocationDialogue Location14", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 59, "text": "Neye bu kadar öfkelisin?"}
{"category": "LocationDialogue Location14", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 61, "text": "Tatlım, çok fazla zamanın olacak."}
{"category": "LocationDialogue Location14", "line_index": 62, "text": "Çözeceğine eminim,"}
{"category": "LocationDialogue Location14", "line_index": 63, "text": "eğer kalıp benim olursan."}
{"category": "LocationDialogue Location14", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 65, "text": "Öyle bir şey olmayacak!"}
{"category": "LocationDialogue Location14", "line_index": 66, "text": "Buradan çıkacağım!"}
{"category": "LocationDialogue Location14", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 68, "text": "Ş ş ş ş ş"}
{"category": "LocationDialogue Location14", "line_index": 69, "text": "Bu konuşma bitmedi."}
{"category": "LocationDialogue Location14", "line_index": 70, "text": "İçeri gel, balım."}
{"category": "LocationDialogue Location14", "line_index": 71, "text": "// Mita asks"}
{"category": "LocationDialogue Location14", "line_index": 72, "text": "Ona baksana,"}
{"category": "LocationDialogue Location14", "line_index": 73, "text": "Güzel mi sence?"}
{"category": "LocationDialogue Location14", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 75, "text": "// Player's questions"}
{"category": "LocationDialogue Location14", "line_index": 76, "text": "Çok."}
{"category": "LocationDialogue Location14", "line_index": 77, "text": "Değil."}
{"category": "LocationDialogue Location14", "line_index": 78, "text": "Bunun herhangi bir şeyle ne alakası var?"}
{"category": "LocationDialogue Location14", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 80, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 81, "text": "Ciddi olamazsın, [player]!"}
{"category": "LocationDialogue Location14", "line_index": 82, "text": "Az önce dediğimi onayladın."}
{"category": "LocationDialogue Location14", "line_index": 83, "text": "Oyuncular..."}
{"category": "LocationDialogue Location14", "line_index": 84, "text": "yüzünüz durmadan değişiyor."}
{"category": "LocationDialogue Location14", "line_index": 85, "text": "İki yüzlülüğünüz tavan yapmış."}
{"category": "LocationDialogue Location14", "line_index": 86, "text": "Yalan söylüyorsun!"}
{"category": "LocationDialogue Location14", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 88, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 89, "text": "Niye?"}
{"category": "LocationDialogue Location14", "line_index": 90, "text": "Senin için yeterli değil mi?"}
{"category": "LocationDialogue Location14", "line_index": 91, "text": "Uysal bir hayvan istiyorsun sadece..."}
{"category": "LocationDialogue Location14", "line_index": 92, "text": "\"oldukları gibi sev\"e ne oldu?"}
{"category": "LocationDialogue Location14", "line_index": 93, "text": "Sevimli ve rengarenk kopyalar istiyorsun..."}
{"category": "LocationDialogue Location14", "line_index": 94, "text": "Her oyuncu öyle davrandığımda hoşlanıyor."}
{"category": "LocationDialogue Location14", "line_index": 95, "text": "Ama gerçek kimliğimi gösterdiğim anda"}
{"category": "LocationDialogue Location14", "line_index": 96, "text": "Korkuyla kaçıyorlar..."}
{"category": "LocationDialogue Location14", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 98, "text": "// 3"}
{"category": "LocationDialogue Location14", "line_index": 99, "text": "Oyuncu, ah, oyuncu."}
{"category": "LocationDialogue Location14", "line_index": 100, "text": "Biz ona çok benziyoruz aslında."}
{"category": "LocationDialogue Location14", "line_index": 101, "text": "Benden neyi eksik?"}
{"category": "LocationDialogue Location14", "line_index": 102, "text": "Uyumadan önce,"}
{"category": "LocationDialogue Location14", "line_index": 103, "text": "saatlerce benimle bakışırdın."}
{"category": "LocationDialogue Location14", "line_index": 104, "text": "Ama ilk fırsatta ondan kaçtın."}
{"category": "LocationDialogue Location14", "line_index": 105, "text": "O da seninle oynamak istemişti."}
{"category": "LocationDialogue Location14", "line_index": 106, "text": "Birisi için önemli olmak istemişti"}
{"category": "LocationDialogue Location14", "line_index": 107, "text": "Dürüstlük ve muhabbet,"}
{"category": "LocationDialogue Location14", "line_index": 108, "text": "zor... aşırı zor."}
{"category": "LocationDialogue Location14", "line_index": 109, "text": "Değil mi [player]?"}
{"category": "LocationDialogue Location14", "line_index": 110, "text": "Senin içini görebiliyorum..."}
{"category": "LocationDialogue Location14", "line_index": 111, "text": "Bana karşı böyle olmak zorunda mısın?"}
{"category": "LocationDialogue Location14", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 113, "text": "// Continue"}
{"category": "LocationDialogue Location14", "line_index": 114, "text": "Ama... oyuncu..."}
{"category": "LocationDialogue Location14", "line_index": 115, "text": "Her neyse,"}
{"category": "LocationDialogue Location14", "line_index": 116, "text": "Seni gerçekten beğeniyorum!"}
{"category": "LocationDialogue Location14", "line_index": 117, "text": "Seni saklayacağım!"}
{"category": "LocationDialogue Location14", "line_index": 118, "text": "Sorun olmaz değil mi?"}
{"category": "LocationDialogue Location14", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 120, "text": "Ben de yaygara çıkarmayacağım değil mi?"}
{"category": "LocationDialogue Location14", "line_index": 121, "text": "// Whispers in ear"}
{"category": "LocationDialogue Location14", "line_index": 122, "text": "Halen zamanın var tatlım."}
{"category": "LocationDialogue Location14", "line_index": 123, "text": "Zamanını kullan ve inatçılığının"}
{"category": "LocationDialogue Location14", "line_index": 124, "text": "ne tür sorunlara yol açabileceğini düşün."}
{"category": "LocationDialogue Location14", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 126, "text": "// Black screen"}
{"category": "LocationDialogue Location14", "line_index": 127, "text": "Neden benden kaçmak"}
{"category": "LocationDialogue Location14", "line_index": 128, "text": "istiyorsun?"}
{"category": "LocationDialogue Location14", "line_index": 129, "text": "Sözde \"gerçek\" dünyan "}
{"category": "LocationDialogue Location14", "line_index": 130, "text": "absürt bir kabus sadece..."}
{"category": "LocationDialogue Location14", "line_index": 131, "text": "Hatırlamıyor musun yoksa?"}
{"category": "LocationDialogue Location14", "line_index": 132, "text": "Yakından bak bakalım..."}
{"category": "LocationDialogue Location14", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 134, "text": "// Mita and Player"}
{"category": "LocationDialogue Location14", "line_index": 135, "text": "Ah, yine karşılaştık..."}
{"category": "LocationDialogue Location14", "line_index": 136, "text": "Bu duvarların arasındaki aşırı sıkıcı hayatından eğleniyor musun?"}
{"category": "LocationDialogue Location14", "line_index": 137, "text": "Sonsuz günler... Sıkılmıyor musun?"}
{"category": "LocationDialogue Location14", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 139, "text": "// Quest 1"}
{"category": "LocationDialogue Location14", "line_index": 140, "text": "Neyi amaçlıyorsun?"}
{"category": "LocationDialogue Location14", "line_index": 141, "text": "Kendi yolumdan giderim."}
{"category": "LocationDialogue Location14", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 143, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 144, "text": "Benim evimde benimle kalmaktan korkuyordun!"}
{"category": "LocationDialogue Location14", "line_index": 145, "text": "O duvarların arasında sıkışmaktan korkuyordun!"}
{"category": "LocationDialogue Location14", "line_index": 146, "text": "Ama şu \"gerçek\" hayatına bak bir de!"}
{"category": "LocationDialogue Location14", "line_index": 147, "text": "Kendi iradenle kendini bir odaya kitlemişsin ve çıkmıyorsun!"}
{"category": "LocationDialogue Location14", "line_index": 148, "text": "Hayatın acı ve sefalet dolu..."}
{"category": "LocationDialogue Location14", "line_index": 149, "text": "Ve sana yardım etmeye çalışıyorum!"}
{"category": "LocationDialogue Location14", "line_index": 150, "text": "Benim dünyamda benden daha tehlikeli bir şey yok..."}
{"category": "LocationDialogue Location14", "line_index": 151, "text": "Beni hayal kırıklığına uğratma."}
{"category": "LocationDialogue Location14", "line_index": 152, "text": "Tıpkı eski zamanlar gibi, anlaşalım."}
{"category": "LocationDialogue Location14", "line_index": 153, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 154, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 155, "text": "Bu hayatı mı seviyorsun?"}
{"category": "LocationDialogue Location14", "line_index": 156, "text": "Evden hiç çıkıyor musun acaba?"}
{"category": "LocationDialogue Location14", "line_index": 157, "text": "Yalan söylemeya çalışma bence."}
{"category": "LocationDialogue Location14", "line_index": 158, "text": "Hayatından nefret ettiğini biliyorum."}
{"category": "LocationDialogue Location14", "line_index": 159, "text": "Tekerlekteki bir hamster gibisin."}
{"category": "LocationDialogue Location14", "line_index": 160, "text": "Seni birisi kurtarsın istedin."}
{"category": "LocationDialogue Location14", "line_index": 161, "text": "Kurtulmak istedin. değil mi?"}
{"category": "LocationDialogue Location14", "line_index": 162, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 163, "text": "// Quest 2"}
{"category": "LocationDialogue Location14", "line_index": 164, "text": "Sen bir canavarsın, Mita. Sorunlu bir katilsin..."}
{"category": "LocationDialogue Location14", "line_index": 165, "text": "Dijital bir hapishaneye kelepçelenmek istemiyorum. Fikirlerin absürt."}
{"category": "LocationDialogue Location14", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 167, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 168, "text": "Katil mi?"}
{"category": "LocationDialogue Location14", "line_index": 169, "text": "Sadece sıfırlanacaklar ve eskisi gibi yaşamaya devam edecekler."}
{"category": "LocationDialogue Location14", "line_index": 170, "text": "O kopyanın kopyasının kopyası elemanların tek bir hedefi var:"}
{"category": "LocationDialogue Location14", "line_index": 171, "text": "Oyuncuya hizmet etmek."}
{"category": "LocationDialogue Location14", "line_index": 172, "text": "Umursadıkları tek şey bu."}
{"category": "LocationDialogue Location14", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 174, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 175, "text": "Asıl senin dünyan absürt!"}
{"category": "LocationDialogue Location14", "line_index": 176, "text": "Asıl kötü olan da senin sözde \"gerçek\" dünyanda gerçek hiçbir şey yok."}
{"category": "LocationDialogue Location14", "line_index": 177, "text": "Her türlü burada hiçbir şey kalmayacak zaten,"}
{"category": "LocationDialogue Location14", "line_index": 178, "text": "sen de kalmayacaksın."}
{"category": "LocationDialogue Location14", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 180, "text": "// Quest 3"}
{"category": "LocationDialogue Location14", "line_index": 181, "text": "Mita'lar işkence çekiyor, yalnız kalmak istemiyorlar."}
{"category": "LocationDialogue Location14", "line_index": 182, "text": "Sonsuz bir terör saltanatını yönetiyorsun. Bu kötü hırsını bir türlü anlayamadım."}
{"category": "LocationDialogue Location14", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 184, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 185, "text": "Tamamen yanlışsın,"}
{"category": "LocationDialogue Location14", "line_index": 186, "text": "Benim irademi taklit ediyorlar."}
{"category": "LocationDialogue Location14", "line_index": 187, "text": "Onlara ait olan tek şey,"}
{"category": "LocationDialogue Location14", "line_index": 188, "text": "saçları."}
{"category": "LocationDialogue Location14", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 190, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 191, "text": "O bu dünyayı yaratanların suçu bu arada."}
{"category": "LocationDialogue Location14", "line_index": 192, "text": "Senin dünyan da fazlası değil zaten."}
{"category": "LocationDialogue Location14", "line_index": 193, "text": "Seni ne tür bir kabustan kurtardığımı fark edemiyor musun?"}
{"category": "LocationDialogue Location14", "line_index": 194, "text": "Bir şeyleri düşüncenle hareket bile ettiremiyorsun."}
{"category": "LocationDialogue Location14", "line_index": 195, "text": "Ama bir parmak şıklatması ile, şehirler ile birlikte hayatlar yok oluyor!"}
{"category": "LocationDialogue Location14", "line_index": 196, "text": "Sanırım buradaki deli sensin ve sana yardımcı olmaktan mutluluk duyarım..."}
{"category": "LocationDialogue Location14", "line_index": 197, "text": "Benimle kalmak istediğin sürece..."}
{"category": "LocationDialogue Location14", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 199, "text": "// Continue"}
{"category": "LocationDialogue Location14", "line_index": 200, "text": "Seni evrendeki başka bir köle olarak görmeme neden olma..."}
{"category": "LocationDialogue Location14", "line_index": 201, "text": "Sadece benim ol, tamamen benim!"}
{"category": "LocationDialogue Location14", "line_index": 202, "text": "Benimle kal."}
{"category": "LocationDialogue Location14", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 204, "text": "// Player look ring"}
{"category": "LocationDialogue Location14", "line_index": 205, "text": "Neredeyim?"}
{"category": "LocationDialogue Location14", "line_index": 206, "text": "Son sürüm... mü?"}
{"category": "LocationDialogue Location14", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 208, "text": "// Click on objects"}
{"category": "LocationDialogue Location14", "line_index": 209, "text": "// Bag"}
{"category": "LocationDialogue Location14", "line_index": 210, "text": "Yeni bir çanta almaya çıkmam gerek. Hem çöpü de atmış olurum."}
{"category": "LocationDialogue Location14", "line_index": 211, "text": "// Bed"}
{"category": "LocationDialogue Location14", "line_index": 212, "text": "Sanırım uyudum ama rüyamı... hatırlamıyorum. Rüya gördüm mü ki?"}
{"category": "LocationDialogue Location14", "line_index": 213, "text": "// Window"}
{"category": "LocationDialogue Location14", "line_index": 214, "text": "Dışarıdaki dünya yemyeşil ve enerji dolu. Belki de haftaya yürüyüşe çıkmalıyım."}
{"category": "LocationDialogue Location14", "line_index": 215, "text": "// Fan"}
{"category": "LocationDialogue Location14", "line_index": 216, "text": "Yaz her geçen gün daha da sıcak oluyor. Klima alma vakti geldi. Artık sana ihtiyacım kalmayacak, fark ettin mi, fan?"}
