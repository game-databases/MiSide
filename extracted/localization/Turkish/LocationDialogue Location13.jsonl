{"category": "LocationDialogue Location13", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 1, "text": "Yüzük."}
{"category": "LocationDialogue Location13", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 3, "text": "// Answer 1 (Where have you been all this time?)"}
{"category": "LocationDialogue Location13", "line_index": 4, "text": "Seni çekirdeğe götürmek için yol arıyordum."}
{"category": "LocationDialogue Location13", "line_index": 5, "text": "Tamamen bir arada,"}
{"category": "LocationDialogue Location13", "line_index": 6, "text": "plan başından beri buydu değil mi?"}
{"category": "LocationDialogue Location13", "line_index": 7, "text": "Bu yüzden Deli Mita'dan"}
{"category": "LocationDialogue Location13", "line_index": 8, "text": "kaçmam gerekti değil mi?"}
{"category": "LocationDialogue Location13", "line_index": 9, "text": "Lanet evrenin arka kapısı hakkında"}
{"category": "LocationDialogue Location13", "line_index": 10, "text": "bulabildiğim her şeyi araştırmam gerekti, değil mi?"}
{"category": "LocationDialogue Location13", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 12, "text": "Nereden bileyim? Öyledir."}
{"category": "LocationDialogue Location13", "line_index": 13, "text": "Yüzüğün yolunu nasıl ayarlardın sen."}
{"category": "LocationDialogue Location13", "line_index": 14, "text": "Neden sorunlu bir sürüme gittim."}
{"category": "LocationDialogue Location13", "line_index": 15, "text": "Tamamıyla tehlike dolu."}
{"category": "LocationDialogue Location13", "line_index": 16, "text": "Kurtulmak için,"}
{"category": "LocationDialogue Location13", "line_index": 17, "text": "sonsuz bir boşluğa atlamam gerekti."}
{"category": "LocationDialogue Location13", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 19, "text": "Yapman gerekenleri aşırı detaylı bir şekilde"}
{"category": "LocationDialogue Location13", "line_index": 20, "text": "anlatmadığım için özür dilerim."}
{"category": "LocationDialogue Location13", "line_index": 21, "text": "Ama evet,"}
{"category": "LocationDialogue Location13", "line_index": 22, "text": "oradan atlaman lazımdı zaten."}
{"category": "LocationDialogue Location13", "line_index": 23, "text": "Ve sen de, başardın!"}
{"category": "LocationDialogue Location13", "line_index": 24, "text": "Aferin!"}
{"category": "LocationDialogue Location13", "line_index": 25, "text": "Haydi plana devam edelim."}
{"category": "LocationDialogue Location13", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 27, "text": "// Answer 2 (How did you get here?)"}
{"category": "LocationDialogue Location13", "line_index": 28, "text": "Çok fazla şey yaşamış olmalısın"}
{"category": "LocationDialogue Location13", "line_index": 29, "text": "Konuştuklarımızı da unuttun galiba."}
{"category": "LocationDialogue Location13", "line_index": 30, "text": "Ben Mita, sürümler arasında yolculuk yapabiliyorum."}
{"category": "LocationDialogue Location13", "line_index": 31, "text": "Hatırladın mı?"}
{"category": "LocationDialogue Location13", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 33, "text": "Bütün Mita'lar bunu yapamıyor,"}
{"category": "LocationDialogue Location13", "line_index": 34, "text": "Yapamayanları gördüm en azından."}
{"category": "LocationDialogue Location13", "line_index": 35, "text": "Acı çektikleri çok açık."}
{"category": "LocationDialogue Location13", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 37, "text": "Evet, onların sürümü bozuk,"}
{"category": "LocationDialogue Location13", "line_index": 38, "text": "dünyaları hatalı. Sana söylemiştim."}
{"category": "LocationDialogue Location13", "line_index": 39, "text": "Lanet olsun..."}
{"category": "LocationDialogue Location13", "line_index": 40, "text": "Bunların arkasındaki kim biliyorsun değil mi?"}
{"category": "LocationDialogue Location13", "line_index": 41, "text": "Deli Mita."}
{"category": "LocationDialogue Location13", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 43, "text": "Sen demesen ben derdim."}
{"category": "LocationDialogue Location13", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 45, "text": "// Answer 3 (Who was this Mita just now?)"}
{"category": "LocationDialogue Location13", "line_index": 46, "text": "O Çirkin Mita."}
{"category": "LocationDialogue Location13", "line_index": 47, "text": "Agresif ve aptal."}
{"category": "LocationDialogue Location13", "line_index": 48, "text": "Mantıklı bir şey konuşamazsın onunla."}
{"category": "LocationDialogue Location13", "line_index": 49, "text": "Hayatı Deli Mita'sı üzerine kurulu."}
{"category": "LocationDialogue Location13", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 51, "text": "Fark ettim, evet."}
{"category": "LocationDialogue Location13", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 53, "text": "Hadi, çekirdeğe girmeliyiz."}
{"category": "LocationDialogue Location13", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 55, "text": "// Answer 4 (How does the ring work?)"}
{"category": "LocationDialogue Location13", "line_index": 56, "text": "Yüzük peki, "}
{"category": "LocationDialogue Location13", "line_index": 57, "text": "Çekirdeğe gelen tek yol mu?"}
{"category": "LocationDialogue Location13", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 59, "text": "Evet."}
{"category": "LocationDialogue Location13", "line_index": 60, "text": "Aslında portalımız olsaydı"}
{"category": "LocationDialogue Location13", "line_index": 61, "text": "buraya direkt olarak"}
{"category": "LocationDialogue Location13", "line_index": 62, "text": "ışınlanabilirdik."}
{"category": "LocationDialogue Location13", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 64, "text": "Yüzüğün herhangi bir avantajı yok mu?"}
{"category": "LocationDialogue Location13", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 66, "text": "Var tabii!"}
{"category": "LocationDialogue Location13", "line_index": 67, "text": "Taşıması basit,"}
{"category": "LocationDialogue Location13", "line_index": 68, "text": "ve daha önce geçtiğin"}
{"category": "LocationDialogue Location13", "line_index": 69, "text": "sürümleri hatırlar."}
{"category": "LocationDialogue Location13", "line_index": 70, "text": "Böylece geri giderken zorlanmazsın."}
{"category": "LocationDialogue Location13", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 72, "text": "// Answer 5 (Why does Mad Mita need me?)"}
{"category": "LocationDialogue Location13", "line_index": 73, "text": "Deli Mita neden beni rahat bırakmıyor?"}
{"category": "LocationDialogue Location13", "line_index": 74, "text": "Bana o tehlikeli oyununu oynattı"}
{"category": "LocationDialogue Location13", "line_index": 75, "text": "ama halen yaşıyorum..."}
{"category": "LocationDialogue Location13", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 77, "text": "Sanırsam"}
{"category": "LocationDialogue Location13", "line_index": 78, "text": "uygun bir oyuncu arıyor..."}
{"category": "LocationDialogue Location13", "line_index": 79, "text": "Onu olduğu gibi kabul edecek birisini."}
{"category": "LocationDialogue Location13", "line_index": 80, "text": "Ne de olsa, Mita Mita'dır!"}
{"category": "LocationDialogue Location13", "line_index": 81, "text": "Tabii ki böyle bir şey asla olmayacak."}
{"category": "LocationDialogue Location13", "line_index": 82, "text": "Oyuncuları kartuşa çeviriyor ki,"}
{"category": "LocationDialogue Location13", "line_index": 83, "text": "kaçamasınlar..."}
{"category": "LocationDialogue Location13", "line_index": 84, "text": "En azından benim tahminim bu yönde."}
{"category": "LocationDialogue Location13", "line_index": 85, "text": "Neyse, önemli olana odaklanalım."}
{"category": "LocationDialogue Location13", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 87, "text": "// Answer 6 (Is this the core?)"}
{"category": "LocationDialogue Location13", "line_index": 88, "text": "Burası mı?"}
{"category": "LocationDialogue Location13", "line_index": 89, "text": "Çekirdek mi?"}
{"category": "LocationDialogue Location13", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 91, "text": "Evet. Çekirdek."}
{"category": "LocationDialogue Location13", "line_index": 92, "text": "Açıklamaya çalıştım,"}
{"category": "LocationDialogue Location13", "line_index": 93, "text": "siz oyuncular bu dünyanın bir parçası değilsiniz..."}
{"category": "LocationDialogue Location13", "line_index": 94, "text": "O yüzden giriş için özel bir izine ihtiyacınız yok."}
{"category": "LocationDialogue Location13", "line_index": 95, "text": "Yani en azından ben buna inanıyorum."}
{"category": "LocationDialogue Location13", "line_index": 96, "text": "Neyse, bütün problemlerimizin"}
{"category": "LocationDialogue Location13", "line_index": 97, "text": "çözümünün içeride olduğuna"}
{"category": "LocationDialogue Location13", "line_index": 98, "text": "adımın Mita olduğundan daha eminim."}
{"category": "LocationDialogue Location13", "line_index": 99, "text": "[player], içeri gir."}
{"category": "LocationDialogue Location13", "line_index": 100, "text": "Gerçekten de girdin."}
{"category": "LocationDialogue Location13", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 102, "text": "// Look on CoreMita"}
{"category": "LocationDialogue Location13", "line_index": 103, "text": "Dikkatli ol, [player]."}
{"category": "LocationDialogue Location13", "line_index": 104, "text": "O seni izliyor."}
{"category": "LocationDialogue Location13", "line_index": 105, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 106, "text": "O kim?"}
{"category": "LocationDialogue Location13", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 108, "text": "Ben de bilmiyorum..."}
{"category": "LocationDialogue Location13", "line_index": 109, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 110, "text": "İyiymiş..."}
{"category": "LocationDialogue Location13", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 113, "text": "O ne?"}
{"category": "LocationDialogue Location13", "line_index": 114, "text": "Hey!"}
{"category": "LocationDialogue Location13", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 116, "text": "Sanırım buldum!"}
{"category": "LocationDialogue Location13", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 118, "text": "Şahane! Bu iyi haber!"}
{"category": "LocationDialogue Location13", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 120, "text": "Bir sürüm söylemeliymişim."}
{"category": "LocationDialogue Location13", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 122, "text": "Doğru. Onun sürümü..."}
{"category": "LocationDialogue Location13", "line_index": 123, "text": "00.98."}
{"category": "LocationDialogue Location13", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 125, "text": "Tamamdır."}
{"category": "LocationDialogue Location13", "line_index": 126, "text": "Sıra numarası nedir?"}
{"category": "LocationDialogue Location13", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 128, "text": "Uhm, Sıra numarası mı?"}
{"category": "LocationDialogue Location13", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 130, "text": "Sıra numarası gerek."}
{"category": "LocationDialogue Location13", "line_index": 131, "text": "Bilmediğini söyleme lütfen!"}
{"category": "LocationDialogue Location13", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 134, "text": "Hmm, mantıklı aslında..."}
{"category": "LocationDialogue Location13", "line_index": 135, "text": "Her Mita'nın bir sıra numarası olmalı ki"}
{"category": "LocationDialogue Location13", "line_index": 136, "text": "yanlışlıkla tüm sürümü sıfırlamayalım..."}
{"category": "LocationDialogue Location13", "line_index": 137, "text": "Büyük bir kargaşaya neden olurdu!"}
{"category": "LocationDialogue Location13", "line_index": 138, "text": "Düşünemediğime inanamıyorum..."}
{"category": "LocationDialogue Location13", "line_index": 139, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 144, "text": "// Answer 1 (What's wrong with you?)"}
{"category": "LocationDialogue Location13", "line_index": 145, "text": "Tüm olanlar bi yana,"}
{"category": "LocationDialogue Location13", "line_index": 146, "text": "ben tamamen iyiyim."}
{"category": "LocationDialogue Location13", "line_index": 147, "text": "Her şey güzel ancak çok şey değişti..."}
{"category": "LocationDialogue Location13", "line_index": 148, "text": "Düşünmem gerekli."}
{"category": "LocationDialogue Location13", "line_index": 149, "text": "Bu kadar"}
{"category": "LocationDialogue Location13", "line_index": 150, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 151, "text": "// Answer 2 (Maybe there's a way to get to know him?)"}
{"category": "LocationDialogue Location13", "line_index": 152, "text": "Ben..."}
{"category": "LocationDialogue Location13", "line_index": 153, "text": "Bence... Bu delilik!"}
{"category": "LocationDialogue Location13", "line_index": 154, "text": "Çılgınca, heh!"}
{"category": "LocationDialogue Location13", "line_index": 155, "text": "Tıpkı samanlıkta iğne..."}
{"category": "LocationDialogue Location13", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 157, "text": "Ne oldu?"}
{"category": "LocationDialogue Location13", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 159, "text": "bazı engeller bilgi ile aşılır,"}
{"category": "LocationDialogue Location13", "line_index": 160, "text": "Tıpkı dünyanın içini çıkarmak gibi!"}
{"category": "LocationDialogue Location13", "line_index": 161, "text": "Kayıtlar, kayıtlar, kayıtlar, veri?"}
{"category": "LocationDialogue Location13", "line_index": 162, "text": "Ya tüm mesele buysa?"}
{"category": "LocationDialogue Location13", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 164, "text": "He? Noldu?"}
{"category": "LocationDialogue Location13", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 166, "text": "Bir yer biliyorum!"}
{"category": "LocationDialogue Location13", "line_index": 167, "text": "Burada bekle."}
{"category": "LocationDialogue Location13", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 169, "text": "Nereye gidiyorsun?"}
{"category": "LocationDialogue Location13", "line_index": 170, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 171, "text": "// Answer 3 (What if we attack Mad Mita?)"}
{"category": "LocationDialogue Location13", "line_index": 172, "text": "Her Mita için"}
{"category": "LocationDialogue Location13", "line_index": 173, "text": "öldüğünde sıfırlandığını söylemiştin..."}
{"category": "LocationDialogue Location13", "line_index": 174, "text": "Ya onu..."}
{"category": "LocationDialogue Location13", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 176, "text": "Öldürsek mi?"}
{"category": "LocationDialogue Location13", "line_index": 177, "text": "Ciddi misin?"}
{"category": "LocationDialogue Location13", "line_index": 178, "text": "Testereli deli bir kadınla nasıl baş edeceksin?"}
{"category": "LocationDialogue Location13", "line_index": 179, "text": "Doğradığı tek şey sebze değil!"}
{"category": "LocationDialogue Location13", "line_index": 180, "text": "Ve bir nedenden ötürü aşırı güçlü!"}
{"category": "LocationDialogue Location13", "line_index": 181, "text": "Nasıl halen hayattayız acaba..."}
{"category": "LocationDialogue Location13", "line_index": 182, "text": "Hadi, çekirdeğe girmeliyiz."}
{"category": "LocationDialogue Location13", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 185, "text": "// core console entry"}
{"category": "LocationDialogue Location13", "line_index": 186, "text": "Bir komut girmemiz lazım..."}
{"category": "LocationDialogue Location13", "line_index": 187, "text": "Ama ne komudu?"}
{"category": "LocationDialogue Location13", "line_index": 188, "text": "Mita, sen biliyor musun?"}
{"category": "LocationDialogue Location13", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 190, "text": "Belki bir yerde yazıyordur?"}
{"category": "LocationDialogue Location13", "line_index": 191, "text": "Bakamaz mısın?"}
{"category": "LocationDialogue Location13", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 193, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location13", "line_index": 194, "text": "Muhtemelen bu değil."}
{"category": "LocationDialogue Location13", "line_index": 195, "text": "Bu da değildir."}
{"category": "LocationDialogue Location13", "line_index": 196, "text": "Yok, değil."}
{"category": "LocationDialogue Location13", "line_index": 197, "text": "Bu değil."}
{"category": "LocationDialogue Location13", "line_index": 198, "text": "Karakter sıfırlama seçeneğini bulmam gerekli."}
{"category": "LocationDialogue Location13", "line_index": 199, "text": "// core console - nope version"}
{"category": "LocationDialogue Location13", "line_index": 200, "text": "Yanlış sürüm."}
{"category": "LocationDialogue Location13", "line_index": 201, "text": "Paardon, benim hatam."}
{"category": "LocationDialogue Location13", "line_index": 202, "text": "Bu değil."}
{"category": "LocationDialogue Location13", "line_index": 203, "text": "Bir kere daha deneyelim."}
{"category": "LocationDialogue Location13", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location13", "line_index": 205, "text": "Sıra kodu ile ilgili"}
{"category": "LocationDialogue Location13", "line_index": 206, "text": "bir şeyler yanlış."}
{"category": "LocationDialogue Location13", "line_index": 207, "text": "Sıra kodunu değiştirmem gerek,"}
{"category": "LocationDialogue Location13", "line_index": 208, "text": "uymuyor."}
{"category": "LocationDialogue Location13", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 210, "text": "// Answer 4 (Little people - Chibi)"}
{"category": "LocationDialogue Location13", "line_index": 211, "text": "Aslında, gelirken bir sürü"}
{"category": "LocationDialogue Location13", "line_index": 212, "text": "küçük insana rastladım..."}
{"category": "LocationDialogue Location13", "line_index": 213, "text": "Onlar nedir?"}
{"category": "LocationDialogue Location13", "line_index": 214, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 215, "text": "Minikler mi?"}
{"category": "LocationDialogue Location13", "line_index": 216, "text": "Ehm, nasıl açıklasam?"}
{"category": "LocationDialogue Location13", "line_index": 217, "text": "Buradaki bir doğa olayı denebilir..."}
{"category": "LocationDialogue Location13", "line_index": 218, "text": "Her Mita'nın bir mini versiyonu olur."}
{"category": "LocationDialogue Location13", "line_index": 219, "text": "Oyuncular da onlara sahip olabilir..."}
{"category": "LocationDialogue Location13", "line_index": 220, "text": "Mita'ların onları yaratabildiğini biliyor muydun?"}
{"category": "LocationDialogue Location13", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 222, "text": "Nasıl?"}
{"category": "LocationDialogue Location13", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 224, "text": "Seyret!"}
{"category": "LocationDialogue Location13", "line_index": 225, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 226, "text": "Büyü gibi..."}
{"category": "LocationDialogue Location13", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 228, "text": "Benim miniklerimle ilgili bir sorun var ama"}
{"category": "LocationDialogue Location13", "line_index": 229, "text": "çoğu ölü doğuyor."}
{"category": "LocationDialogue Location13", "line_index": 230, "text": "Ama bir tanesi var..."}
{"category": "LocationDialogue Location13", "line_index": 231, "text": "Şey,"}
{"category": "LocationDialogue Location13", "line_index": 232, "text": "Sadece çember çizerek koşuyor."}
