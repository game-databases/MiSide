{"category": "LocationDialogue Location20", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Mila! Hayır! Sen kafayı sıyırmışsın!"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Ha ha! NE OLDU?"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "Yeni bir ifade mi görüyorum?"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "Durma, biraz daha göreyim!"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "Aynı surata bakmaktan sıkıldım!"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\""}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "N'aber, yorulmak bilmeyen avarem benim?"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "Halen koşturup duruyor musun? Yetmedi mi?"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Mila'ya ne yaptın?"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "A, yorulmadın demek!"}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Bir oyun daha oynayalım o halde!"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "Sen..."}
{"category": "LocationDialogue Location20", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "Önce küçük bir testle başlayalım!"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "Koordinasyonunu test edelim!"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "Nasıl tepki verdiğini görelim!"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "Ya bir problemin varsa!?"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "Ya o üstüne tutmayı çok sevdiğin"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "DERİYİ bile hak etmiyorsan!?"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "Bak bakalım..."}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "Hangisi hoşuna gidiyor?"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "Sağdaki mi?"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "Yoksa"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "soldaki mi?"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "Cidden mi?"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "Fark eder mi?"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "Sadece seninle uğraşıyordum!"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "Bıçaklama eskimedi mi?"}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "Her neyse!"}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "Daha iyi oyunlar planlıyorum!"}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "mesela..."}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "Bak!"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Müzik açalım!"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "Bu nasıl, güzel mi?"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "Kanımı hızlanıdırıyor!"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "Kuralları anlatarak"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "başlayalım!"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rules"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "Müzik çalarken,"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "hareket edebilirsin."}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "Ama müzik durunca,"}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "KILINI KIPIRDATMA!"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "Ya da ölürsün, sen bilirsin."}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "Gayet basit: Müzik bitmeden"}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "Sona ulaşıyorsun."}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "Haydi başlayalım!"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "Halen yerinde duruyorsun bakıyorum."}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Koş, sevgilim, koş."}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "Bitti mi!"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Şuna bak! Ne kadar itaatkar!"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Mükemmel bir örnek."}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Seni kendime istiyorum."}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "Bu çok kolaydı değil mi?"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "Bırak gideyim!"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "Hemen havalara girme."}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "Daha oynayacak oyunlarımız var!"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "Sıradaki:"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Gözlerimi kapatıyorum..."}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "Ve açtığımda "}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "gitmiş olsan iyi olur!"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "Anladın mı?"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "Seni görürsem, sonu iyi bitmez!"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Tamamdır! Başlayalım."}
{"category": "LocationDialogue Location20", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "Çok saçma..."}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "Başarmışsın!"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Çok güzel ilerliyorsun, heyecanlanmaya başlıyorum."}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "Ama işler zorlaşacak."}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "BAYA zorlaşacak."}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Saklan, kaç, dön..."}
{"category": "LocationDialogue Location20", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "Ah, cehenneme git!"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Player falls"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "Kurtuldum herhalde."}
