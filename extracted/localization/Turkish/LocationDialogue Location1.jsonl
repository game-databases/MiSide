{"category": "LocationDialogue Location1", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 1, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 9, "text": "Selam, ben Mita!"}
{"category": "LocationDialogue Location1", "line_index": 10, "text": "Senin adın nedir?"}
{"category": "LocationDialogue Location1", "line_index": 11, "text": "Tanıştığıma memnun oldum, [player]!"}
{"category": "LocationDialogue Location1", "line_index": 12, "text": "Um... [player],"}
{"category": "LocationDialogue Location1", "line_index": 13, "text": "Acele ile çıktığım için etrafı biraz dağıtmışım da..."}
{"category": "LocationDialogue Location1", "line_index": 14, "text": "Acaba temizlememde yardımcı olabilir misin?"}
{"category": "LocationDialogue Location1", "line_index": 15, "text": "Huff.."}
{"category": "LocationDialogue Location1", "line_index": 16, "text": "Çok teşekkürler!"}
{"category": "LocationDialogue Location1", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 18, "text": "[player], Karnım gurulduyor..."}
{"category": "LocationDialogue Location1", "line_index": 19, "text": "Çok açım..."}
{"category": "LocationDialogue Location1", "line_index": 20, "text": "Tavuk çorbası için malzeme alır mısın?"}
{"category": "LocationDialogue Location1", "line_index": 21, "text": "Her şeyi almışsın!"}
{"category": "LocationDialogue Location1", "line_index": 22, "text": "Hadi birlikte pişirelim!"}
{"category": "LocationDialogue Location1", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 25, "text": "[player], Bugün taşınılabilir bir televizyon almayı planlıyordum."}
{"category": "LocationDialogue Location1", "line_index": 26, "text": "Küçük, antenli bir tane. Yürüyüşler için birebir, sence de öyle değil mi?"}
{"category": "LocationDialogue Location1", "line_index": 27, "text": "Bu arada, mini-oyun oynayarak para kazanabileceğini biliyor muydun?"}
{"category": "LocationDialogue Location1", "line_index": 28, "text": "Yeterince para kazanıp, bana o televizyonu alabilir misin, [player]?"}
{"category": "LocationDialogue Location1", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 30, "text": "Yaşasın! Artık o televizyonu alacak kadar paran var!"}
{"category": "LocationDialogue Location1", "line_index": 31, "text": "Bu işte! Küçük, taşınabilir ve ucuz; Tam da istediğim gibi."}
{"category": "LocationDialogue Location1", "line_index": 32, "text": "Teşekkürler!"}
{"category": "LocationDialogue Location1", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 34, "text": "Selam, [player]! Bana gerçekten çok yardımcı oluyorsun."}
{"category": "LocationDialogue Location1", "line_index": 35, "text": "Ama, şey... O televizyonu hatırlıyor musun? Güzeldi ama şimdiden bozuldu."}
{"category": "LocationDialogue Location1", "line_index": 36, "text": "Her neyse, şu dolabı hareket ettirmemde yardımcı olabilir misin?"}
{"category": "LocationDialogue Location1", "line_index": 37, "text": "Çok ağır da... >.<"}
{"category": "LocationDialogue Location1", "line_index": 38, "text": "Teşekkürler, tatlım! ♥"}
{"category": "LocationDialogue Location1", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 40, "text": "Of [player], sadece bir gün oldu ama seni çok özledim."}
{"category": "LocationDialogue Location1", "line_index": 41, "text": "Keşke beni daha sık ziyaret edebilsen."}
{"category": "LocationDialogue Location1", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 43, "text": "Bu bana mı?"}
{"category": "LocationDialogue Location1", "line_index": 44, "text": "Çok teşekkürler, gerçekten!"}
{"category": "LocationDialogue Location1", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 46, "text": "Selam, [player]! Düşünüyordum da..."}
{"category": "LocationDialogue Location1", "line_index": 47, "text": "Keşke yüz yüze tanışabilsek."}
{"category": "LocationDialogue Location1", "line_index": 48, "text": "Tanışamıyor olmamız sinirlerimi bozuyor."}
{"category": "LocationDialogue Location1", "line_index": 49, "text": "Her gün bana çok yardımcı oluyor, kibar davranıyorsun..."}
{"category": "LocationDialogue Location1", "line_index": 50, "text": "Ben de senin için bir şey yapabilmek isterdim."}
{"category": "LocationDialogue Location1", "line_index": 51, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 52, "text": "A, bir fikrim var!"}
{"category": "LocationDialogue Location1", "line_index": 53, "text": "Artık birlikteyiz."}
{"category": "LocationDialogue Location1", "line_index": 54, "text": "Telefonu bırak."}
{"category": "LocationDialogue Location1", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 57, "text": "// T-shirt on the bed"}
{"category": "LocationDialogue Location1", "line_index": 58, "text": "Senin yatakta ne işin var?"}
{"category": "LocationDialogue Location1", "line_index": 59, "text": "// Rubik's Cube"}
{"category": "LocationDialogue Location1", "line_index": 60, "text": "Çok kullandığım söylenemez..."}
{"category": "LocationDialogue Location1", "line_index": 61, "text": "Bir kere çözüp bir daha da dokunmadım."}
{"category": "LocationDialogue Location1", "line_index": 62, "text": "Sanırsam bir daha çözemeyeceğimi anladığım için."}
{"category": "LocationDialogue Location1", "line_index": 63, "text": "// Computer"}
{"category": "LocationDialogue Location1", "line_index": 64, "text": "Bir bakalım..."}
{"category": "LocationDialogue Location1", "line_index": 65, "text": "Bir yapılacaklar listesi oluştur..."}
{"category": "LocationDialogue Location1", "line_index": 66, "text": "Karakter tepkilerini yaz,"}
{"category": "LocationDialogue Location1", "line_index": 67, "text": "belki de araya biraz kod sıkıştır."}
{"category": "LocationDialogue Location1", "line_index": 68, "text": "// The airplane"}
{"category": "LocationDialogue Location1", "line_index": 69, "text": "Gökleri del bakalım!"}
{"category": "LocationDialogue Location1", "line_index": 70, "text": "// Trash in the corner"}
{"category": "LocationDialogue Location1", "line_index": 71, "text": "Ugh, Çöpleri dışarı çıkartmaya hiç vaktim olmuyor..."}
{"category": "LocationDialogue Location1", "line_index": 72, "text": "Ama kesin bu sefer ilgileneceğim..."}
{"category": "LocationDialogue Location1", "line_index": 73, "text": "...Şimdi, çöp günü ne zamandı ki?"}
{"category": "LocationDialogue Location1", "line_index": 74, "text": "// Photo of a cat on a watermelon"}
{"category": "LocationDialogue Location1", "line_index": 75, "text": "O, en iyi hayvandı..."}
{"category": "LocationDialogue Location1", "line_index": 76, "text": "Karpuzun üstündeki kedi."}
{"category": "LocationDialogue Location1", "line_index": 77, "text": "// Photo with a girl"}
{"category": "LocationDialogue Location1", "line_index": 78, "text": "Kardeşim ile ben,"}
{"category": "LocationDialogue Location1", "line_index": 79, "text": "birbirimize hiç benzemiyoruz."}
{"category": "LocationDialogue Location1", "line_index": 80, "text": "O hep dışarıda,"}
{"category": "LocationDialogue Location1", "line_index": 81, "text": "ben de evde hapsolmuşum."}
{"category": "LocationDialogue Location1", "line_index": 82, "text": "// Photo with people"}
{"category": "LocationDialogue Location1", "line_index": 83, "text": "Hmm..."}
{"category": "LocationDialogue Location1", "line_index": 84, "text": "Ofis hayatı"}
{"category": "LocationDialogue Location1", "line_index": 85, "text": "bize görgü kurallarını beynimize işletti, değil mi?"}
{"category": "LocationDialogue Location1", "line_index": 86, "text": "Hala garip bir şekilde bağlı hissediyorum"}
{"category": "LocationDialogue Location1", "line_index": 87, "text": "Ama..."}
{"category": "LocationDialogue Location1", "line_index": 88, "text": "Acaba onları"}
{"category": "LocationDialogue Location1", "line_index": 89, "text": "tekrar görecek miyim?"}
{"category": "LocationDialogue Location1", "line_index": 90, "text": "Bir saniye, ben bu fotoğrafı neden astım ki?"}
{"category": "LocationDialogue Location1", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 93, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 99, "text": "// Nope name"}
{"category": "LocationDialogue Location1", "line_index": 100, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 101, "text": "O, hayır."}
{"category": "LocationDialogue Location1", "line_index": 102, "text": "Maalesef, bu olmaz."}
{"category": "LocationDialogue Location1", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 104, "text": "// Name Developer"}
{"category": "LocationDialogue Location1", "line_index": 105, "text": "Yapımcının adını koymak istediğine emin misin?"}
{"category": "LocationDialogue Location1", "line_index": 106, "text": "Gururlandım, ama..."}
{"category": "LocationDialogue Location1", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 108, "text": "// Bad name"}
{"category": "LocationDialogue Location1", "line_index": 109, "text": "Kendine öyle dememeni tercih ederim."}
{"category": "LocationDialogue Location1", "line_index": 110, "text": "Hiç hoş değil."}
{"category": "LocationDialogue Location1", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 112, "text": "// Go restart"}
{"category": "LocationDialogue Location1", "line_index": 113, "text": "Hayır, bu böyle olmaz. Baştan başlayalım."}
{"category": "LocationDialogue Location1", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 115, "text": "// Name with numbers"}
{"category": "LocationDialogue Location1", "line_index": 116, "text": "Sayı mı kullanacaksın? Yaratıcılık bunun neresinde?"}
{"category": "LocationDialogue Location1", "line_index": 117, "text": "Neyse, senin tercihin!"}
{"category": "LocationDialogue Location1", "line_index": 118, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 119, "text": "// Name Mita"}
{"category": "LocationDialogue Location1", "line_index": 120, "text": "Mita mı?"}
{"category": "LocationDialogue Location1", "line_index": 121, "text": "Adını gerçekten benden mi aldın?"}
{"category": "LocationDialogue Location1", "line_index": 122, "text": "Ya da senin adın da Mita?"}
{"category": "LocationDialogue Location1", "line_index": 123, "text": "Alınma ama buradaki tek Mita ben olmalıyım."}
{"category": "LocationDialogue Location1", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 125, "text": "// Day 10"}
{"category": "LocationDialogue Location1", "line_index": 126, "text": "Ah, gelmişsin!"}
{"category": "LocationDialogue Location1", "line_index": 127, "text": "Hey, tarağımı kaybettim de."}
{"category": "LocationDialogue Location1", "line_index": 128, "text": "Bulmamda yardımcı olur musun?"}
{"category": "LocationDialogue Location1", "line_index": 129, "text": "Önce komodini kontrol et, sanırsam orada bıraktım."}
{"category": "LocationDialogue Location1", "line_index": 130, "text": "// Looked in the bedside table"}
{"category": "LocationDialogue Location1", "line_index": 131, "text": "Hmm, Burada tarak yok..."}
{"category": "LocationDialogue Location1", "line_index": 132, "text": "Belki de farklı bir yerdedir?"}
{"category": "LocationDialogue Location1", "line_index": 133, "text": "Sadece ocağa bakma. Tamam mı?"}
{"category": "LocationDialogue Location1", "line_index": 134, "text": "Orayı zaten kontrol ettim."}
{"category": "LocationDialogue Location1", "line_index": 135, "text": "// Looked into the stove"}
{"category": "LocationDialogue Location1", "line_index": 136, "text": "Hey! Oraya bakma demiştim!"}
{"category": "LocationDialogue Location1", "line_index": 137, "text": "Arkanı dön-- ben burayı temizleyeceğim!"}
{"category": "LocationDialogue Location1", "line_index": 138, "text": "...İşte, tamamdır. Diğer yerlere bakmaya devam edelim."}
{"category": "LocationDialogue Location1", "line_index": 139, "text": "Ve, ehm, şey, az önce gördüğünü unut. Tamam mı?"}
{"category": "LocationDialogue Location1", "line_index": 140, "text": "// Found a hairbrush"}
{"category": "LocationDialogue Location1", "line_index": 141, "text": "Tarağımı buldun! iyi işti!"}
{"category": "LocationDialogue Location1", "line_index": 142, "text": "Öyleyse, şimdi ne yapsak?"}
