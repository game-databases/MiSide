{"category": "LocationDialogue Location4", "line_index": 0, "text": "Mita?"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "Ah, uyandın mı?"}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "Buraya nasıl geldin?"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": "Yanımda duruyordun."}
{"category": "LocationDialogue Location4", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 5, "text": "Durmuyordum."}
{"category": "LocationDialogue Location4", "line_index": 6, "text": "Aynanın önünde dondun."}
{"category": "LocationDialogue Location4", "line_index": 7, "text": "Ben de gittim."}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "Odalar neden değişti?"}
{"category": "LocationDialogue Location4", "line_index": 9, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "Evin gibi hissetmen için"}
{"category": "LocationDialogue Location4", "line_index": 11, "text": "etrafı yeniden düzenledim."}
{"category": "LocationDialogue Location4", "line_index": 12, "text": "Burada,"}
{"category": "LocationDialogue Location4", "line_index": 13, "text": "odaları dilediğimiz gibi"}
{"category": "LocationDialogue Location4", "line_index": 14, "text": "değiştirebiliriz."}
{"category": "LocationDialogue Location4", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 16, "text": "Yapmana gerek yoktu."}
{"category": "LocationDialogue Location4", "line_index": 17, "text": "Etrafa alışmaya başlamıştım."}
{"category": "LocationDialogue Location4", "line_index": 18, "text": "Her türlü, böyle daha rahat edeceğini düşünüyorum."}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Mita card game"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "Tamam,"}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "oynayalım mı?"}
{"category": "LocationDialogue Location4", "line_index": 22, "text": "Oyun şöyle oynanıyor:"}
{"category": "LocationDialogue Location4", "line_index": 23, "text": "Çipteki sembol, oyun tipini gösterir,"}
{"category": "LocationDialogue Location4", "line_index": 24, "text": "Örnek olarak Kalp:"}
{"category": "LocationDialogue Location4", "line_index": 25, "text": "İkimiz de bir kart oynarız,"}
{"category": "LocationDialogue Location4", "line_index": 26, "text": "senin kartının değeri"}
{"category": "LocationDialogue Location4", "line_index": 27, "text": "benim kartımdan"}
{"category": "LocationDialogue Location4", "line_index": 28, "text": "daha yüksek ise"}
{"category": "LocationDialogue Location4", "line_index": 29, "text": "sen kazanırsın."}
{"category": "LocationDialogue Location4", "line_index": 30, "text": "Kartlarını al."}
{"category": "LocationDialogue Location4", "line_index": 31, "text": "Benim sıram."}
{"category": "LocationDialogue Location4", "line_index": 32, "text": "Vaay!"}
{"category": "LocationDialogue Location4", "line_index": 33, "text": "Şu kartlara bir bak!"}
{"category": "LocationDialogue Location4", "line_index": 34, "text": "İlk ben başlıyorum!"}
{"category": "LocationDialogue Location4", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 44, "text": "İyi!"}
{"category": "LocationDialogue Location4", "line_index": 45, "text": "Senin sıran!"}
{"category": "LocationDialogue Location4", "line_index": 46, "text": "Hı hm."}
{"category": "LocationDialogue Location4", "line_index": 47, "text": "Sende!"}
{"category": "LocationDialogue Location4", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 49, "text": "Gönlü bol olan kazanır!"}
{"category": "LocationDialogue Location4", "line_index": 50, "text": "Saldırı odaklı oyna!"}
{"category": "LocationDialogue Location4", "line_index": 51, "text": "Savunmaya aban!"}
{"category": "LocationDialogue Location4", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 54, "text": "Sen aldın."}
{"category": "LocationDialogue Location4", "line_index": 55, "text": "Sen kazandın!"}
{"category": "LocationDialogue Location4", "line_index": 56, "text": "Güzel hamle"}
{"category": "LocationDialogue Location4", "line_index": 57, "text": "A sen var ya..."}
{"category": "LocationDialogue Location4", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 59, "text": "Aldım."}
{"category": "LocationDialogue Location4", "line_index": 60, "text": "Bu elin galibi benim!"}
{"category": "LocationDialogue Location4", "line_index": 61, "text": "Kazanmışım!"}
{"category": "LocationDialogue Location4", "line_index": 62, "text": "Haha, bende!"}
{"category": "LocationDialogue Location4", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 64, "text": "Berabere."}
{"category": "LocationDialogue Location4", "line_index": 65, "text": "Aynı kart!"}
{"category": "LocationDialogue Location4", "line_index": 66, "text": "İşte şimdi berabere!"}
{"category": "LocationDialogue Location4", "line_index": 67, "text": "Birebir aynısı."}
{"category": "LocationDialogue Location4", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 79, "text": "// The card game is interrupted"}
{"category": "LocationDialogue Location4", "line_index": 80, "text": "O ses ne?"}
{"category": "LocationDialogue Location4", "line_index": 81, "text": "Dolaptan geliyor."}
{"category": "LocationDialogue Location4", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 83, "text": "Ses mi?"}
{"category": "LocationDialogue Location4", "line_index": 84, "text": "Ne sesi?"}
{"category": "LocationDialogue Location4", "line_index": 85, "text": "Ben hiçbir şey duymadım."}
{"category": "LocationDialogue Location4", "line_index": 86, "text": "Ne duyduğunu düşünüyorsun?"}
{"category": "LocationDialogue Location4", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 88, "text": "Tıklatma. Sanki birisi varmış gibi."}
{"category": "LocationDialogue Location4", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 90, "text": "Ama..."}
{"category": "LocationDialogue Location4", "line_index": 91, "text": "Orada kimse yok...."}
{"category": "LocationDialogue Location4", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 93, "text": "Açıp kontrol etmek istiyorum."}
{"category": "LocationDialogue Location4", "line_index": 94, "text": "Biraz ürperdim."}
{"category": "LocationDialogue Location4", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 96, "text": "Ama neden?"}
{"category": "LocationDialogue Location4", "line_index": 97, "text": "Yine bu..."}
{"category": "LocationDialogue Location4", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 105, "text": "Sana ne oldu ya?"}
{"category": "LocationDialogue Location4", "line_index": 106, "text": "Bu bir dolap..."}
{"category": "LocationDialogue Location4", "line_index": 107, "text": "İçinde iç çamaşırlarım var...!"}
{"category": "LocationDialogue Location4", "line_index": 108, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 109, "text": "Benden bir şey mi saklıyorsun?"}
{"category": "LocationDialogue Location4", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 111, "text": "Neden sadece bana güvenmiyorsun?"}
{"category": "LocationDialogue Location4", "line_index": 112, "text": "Neyi yanlış yapıyorum?"}
{"category": "LocationDialogue Location4", "line_index": 113, "text": "İstediğim şey sadece..."}
{"category": "LocationDialogue Location4", "line_index": 114, "text": "Tek istediğim şey senin benimle olman."}
{"category": "LocationDialogue Location4", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 116, "text": "Ben de öyle isterim, ama yine de..."}
{"category": "LocationDialogue Location4", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 118, "text": "Dolaba niye bu kadar taktın ki?!"}
{"category": "LocationDialogue Location4", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 120, "text": "Sadece tıklatmanın sebebini merak ediyorum!"}
{"category": "LocationDialogue Location4", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 122, "text": "Sadece..."}
{"category": "LocationDialogue Location4", "line_index": 123, "text": "Bu dünyada"}
{"category": "LocationDialogue Location4", "line_index": 124, "text": "dört oda olduğu için mi?"}
{"category": "LocationDialogue Location4", "line_index": 125, "text": "Burası sana yetmiyor mu?"}
{"category": "LocationDialogue Location4", "line_index": 126, "text": "Neden benimle kalamıyorsun ki?"}
{"category": "LocationDialogue Location4", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 129, "text": "// Don't stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 130, "text": "Anlıyorum."}
{"category": "LocationDialogue Location4", "line_index": 131, "text": "Yine bu."}
{"category": "LocationDialogue Location4", "line_index": 132, "text": "Dolabı kontrol mu etmek istiyorsun?"}
{"category": "LocationDialogue Location4", "line_index": 133, "text": "O zaman et,"}
{"category": "LocationDialogue Location4", "line_index": 134, "text": "bak bakalım ne varmış!"}
{"category": "LocationDialogue Location4", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 139, "text": "Bu ne lan..."}
{"category": "LocationDialogue Location4", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 141, "text": "Bazen öyle oluyor."}
{"category": "LocationDialogue Location4", "line_index": 142, "text": "Oda yüklemede kalmış."}
{"category": "LocationDialogue Location4", "line_index": 143, "text": "Sadece birkaç saniye bekle."}
{"category": "LocationDialogue Location4", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 145, "text": "Bu çok garip."}
{"category": "LocationDialogue Location4", "line_index": 146, "text": "Birinin telefonunda mıyız?"}
{"category": "LocationDialogue Location4", "line_index": 147, "text": "Belki de yavaş, uzun yükleme süresi olan bir tane?"}
{"category": "LocationDialogue Location4", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 149, "text": "Kesinlikle hayır."}
{"category": "LocationDialogue Location4", "line_index": 150, "text": "Bu dünyada hiçbir şey"}
{"category": "LocationDialogue Location4", "line_index": 151, "text": "mükemmel değildir..."}
{"category": "LocationDialogue Location4", "line_index": 152, "text": "Dünyanın çekirdeği ile"}
{"category": "LocationDialogue Location4", "line_index": 153, "text": "birlikte yükleniyoruz."}
{"category": "LocationDialogue Location4", "line_index": 154, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 155, "text": "Dünyanın çekirdeği?"}
{"category": "LocationDialogue Location4", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 157, "text": "Tipik, sence de öyle değil mi?"}
{"category": "LocationDialogue Location4", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 159, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 161, "text": "Neyse, oynayabileceklerimiz:"}
{"category": "LocationDialogue Location4", "line_index": 162, "text": "konsol oyunu"}
{"category": "LocationDialogue Location4", "line_index": 163, "text": "ya da kart oyunu."}
{"category": "LocationDialogue Location4", "line_index": 164, "text": "Sen seç."}
{"category": "LocationDialogue Location4", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 167, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 168, "text": "// Mita play fight"}
{"category": "LocationDialogue Location4", "line_index": 169, "text": "Dövüşmek ister misin?"}
{"category": "LocationDialogue Location4", "line_index": 170, "text": "Dört kere"}
{"category": "LocationDialogue Location4", "line_index": 171, "text": "kazanman gerek."}
{"category": "LocationDialogue Location4", "line_index": 172, "text": "Başlayalım."}
{"category": "LocationDialogue Location4", "line_index": 173, "text": "Korkma,"}
{"category": "LocationDialogue Location4", "line_index": 174, "text": "başlarda seni çok ezmeyeceğim."}
{"category": "LocationDialogue Location4", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 176, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 177, "text": "İyi gidiyorsun..."}
{"category": "LocationDialogue Location4", "line_index": 178, "text": "Sonrakine odaklansan iyi olur!"}
{"category": "LocationDialogue Location4", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 180, "text": "Vay!"}
{"category": "LocationDialogue Location4", "line_index": 181, "text": "Peki, tamam."}
{"category": "LocationDialogue Location4", "line_index": 182, "text": "Şimdi ciddileşiyorum."}
{"category": "LocationDialogue Location4", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 184, "text": "Peki!"}
{"category": "LocationDialogue Location4", "line_index": 185, "text": "Bakalım şimdi"}
{"category": "LocationDialogue Location4", "line_index": 186, "text": "beni yenebiliyor musun!"}
{"category": "LocationDialogue Location4", "line_index": 187, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 188, "text": "Sen,"}
{"category": "LocationDialogue Location4", "line_index": 189, "text": "tek kelimeyle,"}
{"category": "LocationDialogue Location4", "line_index": 190, "text": "inanılmazsın! şu yeteneklere bak!"}
{"category": "LocationDialogue Location4", "line_index": 191, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 193, "text": "N'oldu?"}
{"category": "LocationDialogue Location4", "line_index": 194, "text": "Huh, işte şimdi sıkıcı olmaya başladı."}
{"category": "LocationDialogue Location4", "line_index": 195, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 196, "text": "Pekala,"}
{"category": "LocationDialogue Location4", "line_index": 197, "text": "bu kadar. kadere inanır mıydın?"}
{"category": "LocationDialogue Location4", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 199, "text": "O zaman,"}
{"category": "LocationDialogue Location4", "line_index": 200, "text": " aklını başına topla yoksa sonsuza kadar ezik kalacaksın!"}
{"category": "LocationDialogue Location4", "line_index": 201, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 202, "text": "Sana ne oldu ya?"}
{"category": "LocationDialogue Location4", "line_index": 203, "text": "Resmen zemini süpürdün."}
{"category": "LocationDialogue Location4", "line_index": 204, "text": "Çok da odaklanmadın gibi-"}
{"category": "LocationDialogue Location4", "line_index": 205, "text": "Bu yüzden kazandım!"}
{"category": "LocationDialogue Location4", "line_index": 206, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 208, "text": "Tamamdır o zaman."}
{"category": "LocationDialogue Location4", "line_index": 209, "text": "Kart oynayalım mı?"}
{"category": "LocationDialogue Location4", "line_index": 210, "text": "Kartlar odamda."}
{"category": "LocationDialogue Location4", "line_index": 211, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 214, "text": "// Door > [ERROR]"}
{"category": "LocationDialogue Location4", "line_index": 215, "text": "Ha, ne oluyor?"}
{"category": "LocationDialogue Location4", "line_index": 216, "text": "Dışarıya ne..."}
{"category": "LocationDialogue Location4", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 218, "text": "O..."}
{"category": "LocationDialogue Location4", "line_index": 219, "text": "Pardon..."}
{"category": "LocationDialogue Location4", "line_index": 220, "text": "İnternetten bir şey"}
{"category": "LocationDialogue Location4", "line_index": 221, "text": "indirdim de."}
{"category": "LocationDialogue Location4", "line_index": 222, "text": "Dışarıyı biraz"}
{"category": "LocationDialogue Location4", "line_index": 223, "text": "süslemek istemiştim."}
{"category": "LocationDialogue Location4", "line_index": 224, "text": "Ama anlaşılan"}
{"category": "LocationDialogue Location4", "line_index": 225, "text": "dosyada bir şeyler sıkıntılı."}
{"category": "LocationDialogue Location4", "line_index": 226, "text": "Sonra düzeltirim."}
{"category": "LocationDialogue Location4", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 228, "text": "Bu yüzden mi evden çıkamıyoruz?"}
{"category": "LocationDialogue Location4", "line_index": 229, "text": "Evet bu yüzden."}
{"category": "LocationDialogue Location4", "line_index": 230, "text": "// Mita shy"}
{"category": "LocationDialogue Location4", "line_index": 231, "text": "Hey..."}
{"category": "LocationDialogue Location4", "line_index": 232, "text": "Ne oldu?"}
{"category": "LocationDialogue Location4", "line_index": 233, "text": "Bir şey mi istiyorsun?"}
{"category": "LocationDialogue Location4", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 236, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 237, "text": "// Wall Clock"}
{"category": "LocationDialogue Location4", "line_index": 238, "text": "Bu saat,"}
{"category": "LocationDialogue Location4", "line_index": 239, "text": "hangi zamanı gösteriyor?"}
{"category": "LocationDialogue Location4", "line_index": 240, "text": "Oyunun içindeki zamanı mı?"}
{"category": "LocationDialogue Location4", "line_index": 241, "text": "yoksa zaman telefonum ile senkronize mi?"}
{"category": "LocationDialogue Location4", "line_index": 242, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 243, "text": "Şey, hm..."}
{"category": "LocationDialogue Location4", "line_index": 244, "text": "Bilmiyorum aslında."}
{"category": "LocationDialogue Location4", "line_index": 245, "text": "Ama burada zaman pek önemli değil..."}
{"category": "LocationDialogue Location4", "line_index": 246, "text": "Geç de olsa erken de olsa,"}
{"category": "LocationDialogue Location4", "line_index": 247, "text": "benim gibi güçlü kızlar"}
{"category": "LocationDialogue Location4", "line_index": 248, "text": "her zaman enerji doludur!"}
{"category": "LocationDialogue Location4", "line_index": 249, "text": "Ben asla yorulmam!"}
{"category": "LocationDialogue Location4", "line_index": 250, "text": "Sonsuz baharımız,"}
{"category": "LocationDialogue Location4", "line_index": 251, "text": "ya da bitmeyen bir akşamımız olabilir!"}
{"category": "LocationDialogue Location4", "line_index": 252, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 253, "text": "İlginçmiş."}
{"category": "LocationDialogue Location4", "line_index": 254, "text": "aynı zamanda da biraz ürpertici."}
{"category": "LocationDialogue Location4", "line_index": 255, "text": "Sonsuza kadar aynı anda tıkılıp kalmak..."}
{"category": "LocationDialogue Location4", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 258, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 259, "text": "// Photos of Mita"}
{"category": "LocationDialogue Location4", "line_index": 260, "text": "Güzel fotoğraflar."}
{"category": "LocationDialogue Location4", "line_index": 261, "text": "Bunlar senin fotoğrafların sanıyorum?"}
{"category": "LocationDialogue Location4", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 263, "text": "Evet."}
{"category": "LocationDialogue Location4", "line_index": 264, "text": "Onları ben de seviyorum."}
{"category": "LocationDialogue Location4", "line_index": 265, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 266, "text": "Bu fotoğrafları kim çekti?"}
{"category": "LocationDialogue Location4", "line_index": 267, "text": "Bu dünyada başkaları da mı var?"}
{"category": "LocationDialogue Location4", "line_index": 268, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 269, "text": "Öyle diyebilirsin."}
{"category": "LocationDialogue Location4", "line_index": 270, "text": "Sizi zaten tanıştıracağım."}
{"category": "LocationDialogue Location4", "line_index": 271, "text": "Ama henüz değil."}
{"category": "LocationDialogue Location4", "line_index": 272, "text": "Şimdilik sadece senle baş başa olmak istiyorum."}
{"category": "LocationDialogue Location4", "line_index": 273, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 275, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 276, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 277, "text": "// Portal"}
{"category": "LocationDialogue Location4", "line_index": 278, "text": "Portal nereye gitti?"}
{"category": "LocationDialogue Location4", "line_index": 279, "text": "Ya da ona artık ne diyorsan?"}
{"category": "LocationDialogue Location4", "line_index": 280, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 281, "text": "Biraz"}
{"category": "LocationDialogue Location4", "line_index": 282, "text": "büyü kullandım"}
{"category": "LocationDialogue Location4", "line_index": 283, "text": "ve başka bir yere"}
{"category": "LocationDialogue Location4", "line_index": 284, "text": "taşıdım."}
{"category": "LocationDialogue Location4", "line_index": 285, "text": "Artık ihtiyacımız yok."}
{"category": "LocationDialogue Location4", "line_index": 286, "text": "Sadece yolumuza çıkardı, o kadar."}
{"category": "LocationDialogue Location4", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 288, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 289, "text": "// Mirror in the bedroom"}
{"category": "LocationDialogue Location4", "line_index": 290, "text": "Yansıma görmeden bir aynaya bakmak"}
{"category": "LocationDialogue Location4", "line_index": 291, "text": "ne yalan söyleyeyim biraz gerici."}
{"category": "LocationDialogue Location4", "line_index": 292, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 293, "text": "Çok istiyorsan"}
{"category": "LocationDialogue Location4", "line_index": 294, "text": "yansımaları açabiliriz."}
{"category": "LocationDialogue Location4", "line_index": 295, "text": "Ama gerçekten gerekli mi?"}
{"category": "LocationDialogue Location4", "line_index": 296, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 297, "text": "Gerekli tabii."}
{"category": "LocationDialogue Location4", "line_index": 298, "text": "Yoksa... açınca bir şey mi oluyor?"}
{"category": "LocationDialogue Location4", "line_index": 299, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 300, "text": "Evet."}
{"category": "LocationDialogue Location4", "line_index": 301, "text": "Takılır, daha yavaş hareket ederiz."}
{"category": "LocationDialogue Location4", "line_index": 302, "text": "Hiç eski tip çizgi film gördün mü?"}
{"category": "LocationDialogue Location4", "line_index": 303, "text": "Bizim için de öyle olur, her zaman."}
{"category": "LocationDialogue Location4", "line_index": 304, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 305, "text": "Anladım."}
{"category": "LocationDialogue Location4", "line_index": 306, "text": "Belki de yansımaları kapalı tutsak iyi olur..."}
{"category": "LocationDialogue Location4", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 308, "text": "Hey, [player]."}
{"category": "LocationDialogue Location4", "line_index": 309, "text": "Aynaları seviyorsun değil mi?"}
{"category": "LocationDialogue Location4", "line_index": 310, "text": "Yüzünde neşeye dair bir şey gözükür diye mi korkuyorsun?"}
{"category": "LocationDialogue Location4", "line_index": 311, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 312, "text": "Ha? Hayır..."}
{"category": "LocationDialogue Location4", "line_index": 313, "text": "Sadece iş yüzünden"}
{"category": "LocationDialogue Location4", "line_index": 314, "text": "biraz yorgunum."}
{"category": "LocationDialogue Location4", "line_index": 315, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 316, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 317, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 318, "text": "// Blue sneakers"}
{"category": "LocationDialogue Location4", "line_index": 319, "text": "Bunlar senin mi?"}
{"category": "LocationDialogue Location4", "line_index": 320, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 321, "text": "Hayır, onlar senin."}
{"category": "LocationDialogue Location4", "line_index": 322, "text": "Hatırlamıyor musun?"}
{"category": "LocationDialogue Location4", "line_index": 323, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 324, "text": "hayır, Böyle bir ayakkabımın var olduğunu hatırlamıyorum."}
{"category": "LocationDialogue Location4", "line_index": 325, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 326, "text": "Artık var işte."}
{"category": "LocationDialogue Location4", "line_index": 327, "text": "Dışarı çıktığımızda "}
{"category": "LocationDialogue Location4", "line_index": 328, "text": "bunları giyebilirsin."}
{"category": "LocationDialogue Location4", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 330, "text": "Peki ya kıyafetlerim?"}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "Üstüme giydiklerim"}
{"category": "LocationDialogue Location4", "line_index": 332, "text": "dışında hiçbir şeyim yok."}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "Bana başka kıyafet alma ihtimalimiz var mı?"}
{"category": "LocationDialogue Location4", "line_index": 334, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 335, "text": "Tabii ki de var."}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "Ki, ne giydiğini gördüm-"}
{"category": "LocationDialogue Location4", "line_index": 337, "text": "ve dürüst olayım, tarzın çok da iyi değil."}
{"category": "LocationDialogue Location4", "line_index": 338, "text": "Yine de, sana kıyafet bulmakta yardımcı olurum."}
{"category": "LocationDialogue Location4", "line_index": 339, "text": "Şimdi değil,"}
{"category": "LocationDialogue Location4", "line_index": 340, "text": "Ama söz."}
{"category": "LocationDialogue Location4", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 342, "text": "Tamam."}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Games on TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "Ne oynamak istiyorsun?"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Game milk"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "Bu bir savaş oyunu!"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "İlk kimin ekşidiğini göreceğiz!"}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "Güzel oyun!"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": "Bu kadar süt şimdilik yeterli, şimdi başka bir şey yapalım."}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Game penguins"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "Bu oyunda etrafta kayan"}
{"category": "LocationDialogue Location4", "line_index": 354, "text": "bir penguensin."}
{"category": "LocationDialogue Location4", "line_index": 355, "text": "Evet, oyun bu kadar."}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "Ha, ne?"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "Ciddi misin? Ben sandım ki..."}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "Çok mutlu oldum!"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "Biraz da kafam karıştı..."}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "Ama..."}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "Lütfen benimle kal."}
{"category": "LocationDialogue Location4", "line_index": 364, "text": "Her zaman ve sonsuza kadar."}
{"category": "LocationDialogue Location4", "line_index": 365, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 367, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 368, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 369, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 370, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 372, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 373, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 374, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 375, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 376, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 377, "text": "// A game about penguins"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "Oyun aşırı basit:"}
{"category": "LocationDialogue Location4", "line_index": 379, "text": "Sadece kar topu topla."}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "En çok toplayan kazanır!"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "İki tur oynayalım, olur mu?"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// The first map"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "Vay, o kadarı nereye sığdırdın?"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "Tee-hee! En çok ben toplamışım!"}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "Yetişsen iyi olur!"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "Ha, 1-1!"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// The second map"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "Sen mükemmel bir penguensin!"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "Seni gerçek buza çıkartmamız lazım!"}
{"category": "LocationDialogue Location4", "line_index": 390, "text": "Pfft, çok yavaşsın."}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "Halen geçen turu mu düşünüyorsun?"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "Berabere! İşte şimdi oyun ilginçleşti!"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// The game is over"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "Başka bir şey oynamak ister misin?"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "Yoksa sana yeter mi?"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "Onu ne yapıyorsun?"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "O kadar mı bağımlısın?"}
