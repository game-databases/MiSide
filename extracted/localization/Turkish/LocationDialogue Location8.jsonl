{"category": "LocationDialogue Location8", "line_index": 0, "text": "// The first meeting"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "Sen kimsin?"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "Sorun ne?"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "Konuşamıyor musun?"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "Bekle..."}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "Çıkmak istiyorsun değil mi?"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "Evet.."}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "Önceki sürüme,"}
{"category": "LocationDialogue Location8", "line_index": 11, "text": "geri dönmem gerek."}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "Önceki sürüm mü?"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "Neden başka bir yere"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "gidesin ki?"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "Burada kalıp"}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "benim ikinci"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "arkadaşım olsan ya?"}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Skipping all dialogs"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "Peki..."}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Standing by the window (Random)"}
{"category": "LocationDialogue Location8", "line_index": 24, "text": "Kapılar seni kurtarmayacak..."}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "Acelen var gibi..."}
{"category": "LocationDialogue Location8", "line_index": 26, "text": "Yuvarlak çizmenin bir faydası yok."}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "Çıkışı bu kadar mı istiyorsun?"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "Pencereden dışarıya bak..."}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Aren't you Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "Oyuncu... Sen bir oyuncusun, değil mi?"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": "Birlikte oyun oynayabiliriz."}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "Eğer gücümü toparlayabilirsem,"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": "Sadece oyun oynasak yeterli olur."}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (What happened to you?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "Emin değilim ve aslında bilmiyorum..."}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "Kötü bir şey olmamıştır bence..."}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "Ama iyi olan her şey yok olup gidiyor gibi..."}
{"category": "LocationDialogue Location8", "line_index": 41, "text": "En azından bir arkadaşım var."}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "Niye beni terk ettiler ki?"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "Yeterli değil miydim?"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "Korkuyorum..."}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Quest 3 (Become a second friend?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "Arkadaşlar..."}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "Çok az arkadaşım kaldı."}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "Sadece bir tane var..."}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "Canım çok yanıyor, oyuncu."}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "Arkadaşım olur musun?"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "İsterdim,"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "ama devam etmek zorundayım..."}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "Kalbim ağrıyor."}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Is this your house?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "Ev mi?"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "Oyuncu... Değişmişsin..."}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "Kolların daha kısa ve artık kızgın durmuyorsun..."}
{"category": "LocationDialogue Location8", "line_index": 62, "text": "Oyuncu, Daha yumuşak, daha nazik olmuşsu."}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "Ne anlamam geldiğinden"}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "emin değilim..."}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "Sorun değil..."}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "Çünkü artık kimse beni incitmeyecek, değil mi?"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (How do I leave this place?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "Beni gerçekten terk mi ediyorsun?"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "Acaba bu benim"}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "kaderim olabilir mi?"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "Ben..."}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": "Kapılar sana yardımcı olmayacak."}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Hold player (Random)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "Gitmesene."}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "Burada kal..."}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "Benimle oyna..."}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "Oyuncu..."}
