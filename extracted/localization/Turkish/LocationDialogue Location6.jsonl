{"category": "LocationDialogue Location6", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "Mita?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "Sen buraya nasıl geldin?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Sen Mita'sın değil mi?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Ama sende bir değişiklik var."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "Görüyorum ki dikkatlisin."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "Ve haklısın."}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "Daha önce tanıştığın Mita ben değilim."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Dikkat et,"}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "onun sinsi bir planı var."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "He, sinsice bir şey mi?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "Açıklamak için zaman yok."}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "Bu işe yarar ise sana her şeyi anlatacağım."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Koltuğun önündeki anahtarı getir."}
{"category": "LocationDialogue Location6", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Ama..."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "Sorularını sonraya sakla!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Anahtarı ver."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Bu yüzüğü al."}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "Hm?"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Burada çıkmak istiyorsun, değil mi?"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "Eh, evet..."}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "O zaman yüzüğü tak."}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "İşe yarar bi alet."}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "İleride muhtemelen ihtiyacın olacak."}
{"category": "LocationDialogue Location6", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Peki..."}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "Bu arada ben,"}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Hmm,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "Ben... Mita."}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": "// MitaKind quest 1"}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "Şu konsolu gördün mü?"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "Al onu."}
{"category": "LocationDialogue Location6", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 50, "text": "Bu bir video mu?"}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "O yanındaki kim?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 53, "text": "İzlediğin şey şu anda gerçekleşiyor."}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "O başka bir oyuncu."}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "Mita onu kullanıyor."}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Seni de "}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "bir kartuşa dönüştürmeyi deneyebilir."}
{"category": "LocationDialogue Location6", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 59, "text": "Buradan ACİLEN çıkmam gerek."}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "Senin de öyle."}
{"category": "LocationDialogue Location6", "line_index": 61, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 62, "text": "Evet, çıkmalıyız."}
{"category": "LocationDialogue Location6", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 64, "text": "Yani diyorsun ki"}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "adamı kullanıyor."}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "Kartuşu çekersem ne olur peki?"}
{"category": "LocationDialogue Location6", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 68, "text": "Bu büyük ihtimal"}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "kartuşa geri alınamaz bir hasar verir."}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "Bu da oyuncunun..."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "öleceği anlamına geliyor tabii."}
{"category": "LocationDialogue Location6", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 73, "text": "..."}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "Kapatırsam ne olur ki?"}
{"category": "LocationDialogue Location6", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 76, "text": "İşe yarayabilir..."}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "Denemeye değer. Kırmızı bir tuş var!"}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Gördün mü?"}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Buldum."}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "Bas ona."}
{"category": "LocationDialogue Location6", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 82, "text": "// MitaKind quest 2"}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "Benim burada kalmam lazım."}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Oa sormam gereken sorularım var."}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "Onun hakkında öğrenmem gereken şeyler var."}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "Pek konuşmaya hevesli değil ama..."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 88, "text": "// MitaKind quest 3"}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "Sana karşı dürüst olayım, burası benim sürümüm."}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "Bir oyuncuyu ağırlıyordum."}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "taa ki her şey birden değişene kadar."}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "Sonra o çıkageldi..."}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "Ve oyuncuyu kartuşa çevirip"}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "beni de kilitledi."}
{"category": "LocationDialogue Location6", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 96, "text": "Bekle, oyuncuyu kartuşa çevirdi mi dedin?"}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Öyle bir şey mi yapabiliyor?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "Neden ama?"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "Oyuncuları ne yapıyor ki?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 101, "text": "Bariz bir şekilde delirmiş..."}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "Sadece bizimle eğleniyor ve bizi entrikalarına alet ediyor!"}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Oyuncuları kartuşa çeviriyor..."}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "Bazıları ne olduğunu bile anlayamadı..."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Bazıları karşılık bile vermedi..."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "Bu beklenmedik oldu..."}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "Bize yardım etmelisin!"}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "Ben mi? Nasıl?"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "Sana ihtiyacım var!"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "Bize yardım et, ben de sana yardım edeyim!"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "Bu tek şansımız olabilir!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Yüzük seni doğru sürüme götürecek."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "Seninle orada buluşurum."}
{"category": "LocationDialogue Location6", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 115, "text": "// MitaKind quest 4"}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "Halen tam olarak"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "yukarıda ne gördüğümü anlamadım..."}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "O Mita..."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Beni öldürmeye mi çalışıyordu?"}
{"category": "LocationDialogue Location6", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 121, "text": "Öldürmek mi?"}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "Aklında sandığından daha kötü bir son hazırlamış senin için..."}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Acele etmen gerek."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 125, "text": "// Hide!"}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "Ah, siktir! Saklan!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "Ne?"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Çabuk, geliyor!"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Yüzüğü takip et, o seni güvenli bir yere götürecektir!"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": "Bakalım, bakalım, onun nerede olduğunu söyleyecek misin?"}
{"category": "LocationDialogue Location6", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 134, "text": "Neden söyleyeyim?"}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "Onu öldürmeyeceksin değil mi?"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 137, "text": "Yani söylemeyi reddediyorsun."}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Heh, meydan okumaları severim."}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Burada bir yerde olduğunu biliyorum."}
{"category": "LocationDialogue Location6", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 141, "text": "Bize karşı niye böylesin?"}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "Neler olduğunu bile söylemiyorsun!"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "Ayrıca..."}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "Oyuncuları ne yapacaksın ki?"}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "Oyuncak değiller!"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "Sana ne oldu böyle?!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 148, "text": "Yeter! Kes sesini, kukla!"}
