{"category": "LocationDialogue Location9", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Hey, sen!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Selam!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Çıkmak mı istiyorsun?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Anahtarı bulmamda yardımcı ol o zaman!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Boş!"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Burada bir şey yok—"}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "Yok, burada değil."}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Buldum!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// The usual conversation"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Kısa olursun sanmıştım!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "Uzunsun—"}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "Ablam gibi!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "Ablan mı? Nasıl yani?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "He, ablam!"}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Tanışmadım deme bana!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Uhh... Tanıştım... Galiba..."}
{"category": "LocationDialogue Location9", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Aptal mısın?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "Emm..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "Sanırsam öylesin..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "Hadi anahtarı bulmamda yardımcı ol!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// Next work"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Gel."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Demirleri boruya koy!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Teşekkürler!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "Şimdi odunu ver bana!"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Sağ olasın!"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Biraz daha yardım, lütfen!"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Oldu!"}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "Vay, çok güzel."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Bas, hadi!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Hazır."}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "İşte, Al!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "Anahtar senindir!"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// Quest 1 (Are you Mita?)"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Ben ChibiMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Tonla satır,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "en basit modelleme"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "ve en iyisinden şahane saç!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// Quest 2 (Have we seen each other yet?)"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Şapşal çocuk!"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "Şirinsin aslında biliyor musun?"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "Böyle şapşal sorular soruyorsun."}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Ancak"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "Bu seninle ilk karşılaşışım!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Ama..."}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Biri bana benzemeye çalıştıysa,"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "pişman ederim!"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// Quest 3 (Why are you here?)"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Anlamıyor musun?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "Burası bir kontrol noktası."}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "Zekanı ölçeceğin bir yer!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "Şimdi haydi!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Burada kaybolmuşlara yardım ediyorum!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// Quest 4 (Why are you helping me?)"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "Seni özel yapan nedir?"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "Niye yardım etmeyeyim?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "Anlamadım?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Çok aptalca..."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Bi anda odada var oldun!"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Burada olmaman gerektiği bariz."}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "Bu yüzden yardımcı oluyorum!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Görüşürüz, şapşal!"}
