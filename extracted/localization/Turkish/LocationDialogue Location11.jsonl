{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Hoppala!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Hayda!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Pardoon,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "Az kalsın seni öldürüyordum."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Yani..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "Buz dolabı, Buz dolabı seni öldürüyordu."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Onunla hiçbir alakam yok."}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "Yemin ederim!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Gerçekten!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Buna inanacağımı mı sandın? Hadi be oradan!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Cidden ama,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "Burası tehlikeli..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "özellikle de senin için."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "Cesurum diyorsun!"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Oralardan geçerken"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "seni seyretmek"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "eğlenceli..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Koş, balkabağım, koş!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "Seni yakalayacağım!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Hadi oğluşum!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Vay, bu eğlenceli!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Seni trene giderken gördüm."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "Orası sürümler arası "}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "en uzun yol..."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "O siste yaşayanlarla"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "nasıl ilgileneceğini "}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "merak ediyorum."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Ne yaptığını zannediyorsun!?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Git."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Bakmasana!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Gerizekalı!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Aptal..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Uhm, peki..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Bol şans!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Kim var orada?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Seni hissedebiliyorum..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Beni dinle,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "Sen oyuncusun,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "değil mi?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Bana yardım et..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "Şeyi bulmamda..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "Düşüneyim..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "Zihnim boş..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Burada ne oluyor?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Her şeyi unutmak istedim bir keresinde..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Her aynayı kırdım,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "her fotoğrafı parçaladım..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "ama şimdi..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "tek hissettiğim pişmanlık."}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "Ne kadar aptalmışım..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Herkes hata yapar, tabii ki..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Bedeli ağır gelince"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "sen ne yaparsın..."}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Keşke zamanı geri alabilsem..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Zaman her yarayı "}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "iyileştirir derler..."}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "peki ya bu sefer?"}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Artık inancım kalmadı..."}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "ama eğer zaman iyileştiriyorsa"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "ya da en azından beni bu dünyadan silebilirse..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "O zaman sana yalvarıyorum, lütfen"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "Zamanı hızlandır,"}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "ki beni öldürsün."}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "Tek ve ebediyen."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Sevilmişti..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Ben de sevilmiş miydim?"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Ama benim sevgim farklı;"}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "Onun sevgisi canlı,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "iğrenç..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "yanıcı..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "amansız..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "kıskanç..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "öfkeli..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "çılgın..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Bana duygusal dediler..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "\"Çok takıyorsun, Mita\"..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "\"Atlatacaksın, Mita\"..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "\"Yalnız değilsin, Mita\"..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Dediler ama geriye ne kaldı?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Hüzün,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "çaresizlik"}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "ve korku..."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "İşe yaramaz...."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Hatırlayamıyorum..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "Hiçbir şey..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Sonsuz yankılar..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Burada sıkıştığım,"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "gerçeği ile baş edemiyorum..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Her zaman buradaydım..."}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "ama neden?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Hatırlayamıyorum..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Son bulacak mı?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Bilmiyorum..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Bu..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "çizim..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Şimdi hatırladım,"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "Teşekkürler..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Ama benim suratım..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "Suratım yok..."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "Hepsi ONUN...."}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Benden bir parçamı aldı..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "Fırlatıp attı..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Güçlü..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "Zeki..."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Seni durdurmaya hakkım yok, oyuncu."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Dolaba bak..."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Hey!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Yolumdasın!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Orada öylece duracak mısın?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Önümden çıkar mısın?"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Bırak geçeyim!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Büyüksün diye güçlü olduğun anlamına gelmiyor!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Beni takip mi ediyorsun!?"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Geri bas!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - radio voice"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Dur orada... Oyuncu?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "Burada ne yapıyorsun?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Kimsin sen?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Başka bir oyuncu..."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Ben Mitaphone."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Burada oturuyor, trenleri kontrol ediyorum."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Cehennemine doğru gittiğinin"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "farkındasın değil mi?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Belki de,"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "ama tek yol bu."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Haklısın."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Tuşa bas ve topun başına geç."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "Top mu?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Hı Hı."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Kolayca geçeceğini sanmadın herhalde?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Canavar vurma oyununu bitirmen lazım,"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "O yüzden patlatmaya hazır ol."}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Yola koyulma vakti."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Şahane!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Başardın!"}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Git buradan."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Hızlı ve dikkatli!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Niye halen buradasın?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Git dedim!"}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Anlamıyorum..."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "Neden öylece dikiliyorsun?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Tetris mi cidden?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Kanka ya..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Görüşürüz."}
