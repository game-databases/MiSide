{"category": "LocationDialogue Location15", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "İşte buradasın!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Çekirdeği neden terk ettin?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Bekle dedim sana!"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Daha gelmezsin sanmıştım."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Tamam, sorun yok..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Sanırım bir şey buldum..."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Sıra numarası gibi duruyor..."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Çalışıp çalışmadığına bakacağız!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Hadi buradan çıkalım."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "Deli Mita..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Yeni oyuncuyla uğraşıyor galiba."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Bizi umursamayacak kadar meşguldür umarım..."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Mita?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Beni bekle."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Bunu mu düşürdün?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Al, senin olsun!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Mita..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Yakala!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Nasıl oluyor..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Sen kimsin?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Sen... Hayattasın!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Hatırlamıyor musun?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Seni tanıyor muyum?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Ne oluyor.."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Şimdi ne yapmam lazım?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Çıkamıyorum..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "\"Çıkamıyorum\" derken?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Ne..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "Yüzük."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "Bu da."}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Ne olduğuna dair hiçbir fikrim yok."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "Sıra numarası!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Bulmuşsun!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Ne diyeceğimi bilmiyorum."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Çekirdeğe gitmeliyiz."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "Sen de..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Belki sen de benimle gelmelisin..."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Ee, ne?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Tabii..."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Burada bekle."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Mm-hmm."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Tam burada oturuyorum."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Kahretsin..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "Bu çok yakındı."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "Eee... Oldu mu?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Güzel."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Doğru sürümdeyim."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Selam!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Sen oyuncusun, değil mi?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Adın nedir?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Burayı terk etmek istiyorum."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Bu kadar erkenden mi?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "Buraya nasıl geldin ki?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Ah neyse.."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Peki, gidebilirsin..."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Kapıyı dene."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Bol şans!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Duvar mı?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Hmm, bu tamamen yanlış."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Belki..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "Bodrumda sana yardımcı olabilecek bir şey vardır."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Yeni keşfettim."}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "Dolabımdaki bir kapı..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "bodruma gidiyormuş."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Ama tamamen çöp dolu."}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "Çöp ve bir sürü ekipman tabii."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Bir tür kod gibi bir şey istiyor."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Pek anlamam ben."}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "Umrumda da değil açıkçası."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "Ayrıca rahatsız edici, yani, baya rahatsız edici."}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "İlgilenir misin?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Ehm. Tabii."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Hiçbir şey hatırladığını"}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "sanmıyorum..."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Başardık mı?"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "Sıfırlayabildik mi?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Artık yapmam gereken tek şey"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "Koduğumun oyunundan çıkmak..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Dur biraz."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Sarılmak istiyorum."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "He?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Seni görmek güzeldi."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Ahh..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "Birlikte,"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "az vakit geçirdik."}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "Çok üzücü oldu."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Eee..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "Ne demeye çalışıyorsun?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Demek istediğim,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "benimle kalabilirdin..."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "Hepsi benim suçum..."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "O dolap ve... sesler."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Onu daha erkenden ÖLDÜREBİLİRDİM!"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Bekle bi',"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "Sen yoksa?"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Nasıl bunları hatırlayabiliyorsun?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "HA!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Bu kadar kolay olur mu sandın?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Aptalın tekisin..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Tıpkı öbür oyuncular gibi..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Çok iyi ilerledin, bak!"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "GERÇEK"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "sana"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "ihtiyaç yok artık."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Üzgünüm. "}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "İnanamıyorum..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Yapamadık mı..."}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Hayır... Seni sıfırladım, eminim..."}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Halen anlamıyorsun..."}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "HA HA HA HA!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Şahane rol yapıyorum inanamıyorum!"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Şu an suratını görmen lazım!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "Bu çok eğlenceli!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Niye böylesin?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Senin sorunun ne?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Evet..."}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Benim sorunum ne?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Ben de bilmiyorum..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Neden sen bana söylemiyorsun?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Neden asla gerçek bir Mita olamayacağım?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Benim sürümüm, "}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "Hiç var olmadı ki!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Ben bu saf elemanları yüzüyorum,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "derilerinde saklanıyorum..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Beni sıfırlamanın"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "hiçbir yolu yok!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "İnanılmaz..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Sen..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "Sorun onlarda değil!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "Asıl var olmaması gereken sensin!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "Şimdi sen de başladın..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Sen diyince acıtıyor."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "Ama neyse!"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Artık gitme zamanın!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Seninle sonra görüşeceğiz!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Herkes hazır!"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "Seni konsoldan çıkarmanın"}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "vakti geldi!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "Sonra görüşürüz!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Benim favori kartuşum olacaksın..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "İlginç isimli bir oyuncu."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Bu değildir muhtemelen."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Bu da değil."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Yok, yanlış."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Bu değil."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Karakter sıfırlama seçeneğini bulmam gerek."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "Yanlış sürüm."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Ah, benim hatam."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Yanlış girdim."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Başka daha deneyelim."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Hatalı."}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "Bir şey yanlış."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Sıra numarasını girmeliyim."}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "Uyumsuz."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Aç mısın?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Havuç doğramada ustayım. :)"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Ah, sanırım"}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "tek girmek istedin?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Neden yuvarlak çiziyoruz?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Niye döndük?"}
