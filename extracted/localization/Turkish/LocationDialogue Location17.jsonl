{"category": "LocationDialogue Location17", "line_index": 0, "text": "// Player thinks + Make coffee"}
{"category": "LocationDialogue Location17", "line_index": 1, "text": "Birinin yardımı gerekecek burada"}
{"category": "LocationDialogue Location17", "line_index": 2, "text": "Umarım buranın Mita'sı ısırmıyordur."}
{"category": "LocationDialogue Location17", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 4, "text": "Zamanımı neyle harcıyorum..."}
{"category": "LocationDialogue Location17", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 9, "text": "// Player tries to wake up MitaDreamer"}
{"category": "LocationDialogue Location17", "line_index": 10, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 11, "text": "Mita, Uyansana!"}
{"category": "LocationDialogue Location17", "line_index": 12, "text": "Mita!"}
{"category": "LocationDialogue Location17", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 14, "text": "Mita, Uyan!"}
{"category": "LocationDialogue Location17", "line_index": 15, "text": "Yardımın gerek."}
{"category": "LocationDialogue Location17", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 17, "text": "Sen kimsiinnnn?"}
{"category": "LocationDialogue Location17", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 19, "text": "Kapıyı açmamda yardım et."}
{"category": "LocationDialogue Location17", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 21, "text": "Ne kapısı?"}
{"category": "LocationDialogue Location17", "line_index": 22, "text": "Bırak da uyuyayım..."}
{"category": "LocationDialogue Location17", "line_index": 23, "text": "Ya da bana kahve getir..."}
{"category": "LocationDialogue Location17", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 25, "text": "Kettle hemen orada."}
{"category": "LocationDialogue Location17", "line_index": 26, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 27, "text": "Mi-ita!"}
{"category": "LocationDialogue Location17", "line_index": 28, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 31, "text": "// Player gives away the coffee"}
{"category": "LocationDialogue Location17", "line_index": 32, "text": "Mita,"}
{"category": "LocationDialogue Location17", "line_index": 33, "text": "Kahveni getirdim."}
{"category": "LocationDialogue Location17", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 37, "text": "// MitaDreamer exercise"}
{"category": "LocationDialogue Location17", "line_index": 38, "text": "Kapı diyorsun,"}
{"category": "LocationDialogue Location17", "line_index": 39, "text": "Öyle mi?"}
{"category": "LocationDialogue Location17", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 41, "text": "Evet."}
{"category": "LocationDialogue Location17", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 43, "text": "Nasıl oluyor da kapıdan haberin oluyor?"}
{"category": "LocationDialogue Location17", "line_index": 44, "text": "Gerçi, neden soruyorum ki..."}
{"category": "LocationDialogue Location17", "line_index": 45, "text": "Burada olduğuna göre"}
{"category": "LocationDialogue Location17", "line_index": 46, "text": "fazlasıyla biliyorsun demektir..."}
{"category": "LocationDialogue Location17", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 48, "text": "Bekle bi'."}
{"category": "LocationDialogue Location17", "line_index": 49, "text": "Oturmam lazım."}
{"category": "LocationDialogue Location17", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 51, "text": "Sonra?"}
{"category": "LocationDialogue Location17", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 53, "text": "Ne diyeceğimi bilmiyorum..."}
{"category": "LocationDialogue Location17", "line_index": 54, "text": "Ama devam etmem lazım,"}
{"category": "LocationDialogue Location17", "line_index": 55, "text": "Yüzüğün yolunu takip etmeliyim."}
{"category": "LocationDialogue Location17", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 57, "text": "Yüzüğünü mü aldın?"}
{"category": "LocationDialogue Location17", "line_index": 58, "text": "Burayı bulmana"}
{"category": "LocationDialogue Location17", "line_index": 59, "text": "şaşmamalı."}
{"category": "LocationDialogue Location17", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 61, "text": "Doğru."}
{"category": "LocationDialogue Location17", "line_index": 62, "text": "Ee, yardımcı olabilir misin?"}
{"category": "LocationDialogue Location17", "line_index": 63, "text": "Kapı hakkında?"}
{"category": "LocationDialogue Location17", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 65, "text": "Tabii."}
{"category": "LocationDialogue Location17", "line_index": 66, "text": "Ederim."}
{"category": "LocationDialogue Location17", "line_index": 67, "text": "Kapı hakkında."}
{"category": "LocationDialogue Location17", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 70, "text": "Mita, Hadi."}
{"category": "LocationDialogue Location17", "line_index": 71, "text": "Gidelim artık."}
{"category": "LocationDialogue Location17", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 73, "text": "He?"}
{"category": "LocationDialogue Location17", "line_index": 74, "text": "Tamam."}
{"category": "LocationDialogue Location17", "line_index": 75, "text": "Hadi."}
{"category": "LocationDialogue Location17", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 78, "text": "// MitaDreamer fall"}
{"category": "LocationDialogue Location17", "line_index": 79, "text": "Kalksana."}
{"category": "LocationDialogue Location17", "line_index": 80, "text": "Bu kadar uykun olamaz."}
{"category": "LocationDialogue Location17", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 82, "text": "// MitaDreamer again sleep"}
{"category": "LocationDialogue Location17", "line_index": 83, "text": "Uyan."}
{"category": "LocationDialogue Location17", "line_index": 84, "text": "Geldik sayılır."}
{"category": "LocationDialogue Location17", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 86, "text": "// Switches"}
{"category": "LocationDialogue Location17", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 88, "text": "Tamam,"}
{"category": "LocationDialogue Location17", "line_index": 89, "text": "hazırım."}
{"category": "LocationDialogue Location17", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 91, "text": "Ben de hazırım."}
{"category": "LocationDialogue Location17", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 93, "text": "Pekii."}
{"category": "LocationDialogue Location17", "line_index": 94, "text": "Üçe kadar"}
{"category": "LocationDialogue Location17", "line_index": 95, "text": "saymaya başlıyorum."}
{"category": "LocationDialogue Location17", "line_index": 96, "text": "Ve kolu aynı anda çekiyoruz."}
{"category": "LocationDialogue Location17", "line_index": 97, "text": "Tamam mı?"}
{"category": "LocationDialogue Location17", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 99, "text": "Sadece uyanık kal. Tamam!"}
{"category": "LocationDialogue Location17", "line_index": 100, "text": "Hadi."}
{"category": "LocationDialogue Location17", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 103, "text": "3"}
{"category": "LocationDialogue Location17", "line_index": 104, "text": "2"}
{"category": "LocationDialogue Location17", "line_index": 105, "text": "1"}
{"category": "LocationDialogue Location17", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 107, "text": "// Player lose 1"}
{"category": "LocationDialogue Location17", "line_index": 108, "text": "Daldın mı?"}
{"category": "LocationDialogue Location17", "line_index": 109, "text": "Hadi,"}
{"category": "LocationDialogue Location17", "line_index": 110, "text": "bir daha deneyelim..."}
{"category": "LocationDialogue Location17", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 112, "text": "// Player lose 2"}
{"category": "LocationDialogue Location17", "line_index": 113, "text": "Bir daha deneyelim mi?"}
{"category": "LocationDialogue Location17", "line_index": 114, "text": "Hadi,"}
{"category": "LocationDialogue Location17", "line_index": 115, "text": "ben..."}
{"category": "LocationDialogue Location17", "line_index": 116, "text": "ben uyuyakalmak üzereyim..."}
{"category": "LocationDialogue Location17", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 118, "text": "// Player lose 3"}
{"category": "LocationDialogue Location17", "line_index": 119, "text": "Uyumak üzereyim..."}
{"category": "LocationDialogue Location17", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 122, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 123, "text": "Şahane."}
{"category": "LocationDialogue Location17", "line_index": 124, "text": "Teşekkürler, Mita."}
{"category": "LocationDialogue Location17", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 126, "text": "Mm-hmm."}
{"category": "LocationDialogue Location17", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 129, "text": "Kapı..."}
{"category": "LocationDialogue Location17", "line_index": 130, "text": "Çok..."}
{"category": "LocationDialogue Location17", "line_index": 131, "text": "Yavaş..."}
{"category": "LocationDialogue Location17", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 134, "text": "Ben uyuyorum."}
{"category": "LocationDialogue Location17", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 136, "text": "// Why kitchen?"}
{"category": "LocationDialogue Location17", "line_index": 137, "text": "Mutfakta n'apıyoruz?"}
{"category": "LocationDialogue Location17", "line_index": 138, "text": "Soğukta uyuyakalırsam,"}
{"category": "LocationDialogue Location17", "line_index": 139, "text": "senin suçun."}
{"category": "LocationDialogue Location17", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 141, "text": "// Why bathroom?"}
{"category": "LocationDialogue Location17", "line_index": 142, "text": "Tam olarak anlayamadım."}
{"category": "LocationDialogue Location17", "line_index": 143, "text": "Hangi kapı hakkında yardım istedin?"}
{"category": "LocationDialogue Location17", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 145, "text": "// Put button"}
{"category": "LocationDialogue Location17", "line_index": 146, "text": "Hiçbir şey olmadı?"}
{"category": "LocationDialogue Location17", "line_index": 147, "text": "Bu ne iş yapıyor o zaman?"}
{"category": "LocationDialogue Location17", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 149, "text": "// Cofee"}
{"category": "LocationDialogue Location17", "line_index": 150, "text": "Biraz daha kahve ister misin?"}
{"category": "LocationDialogue Location17", "line_index": 151, "text": "Yoksa uyuya kalacaksın."}
{"category": "LocationDialogue Location17", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 153, "text": "Nee?"}
{"category": "LocationDialogue Location17", "line_index": 154, "text": "Hayıırr..."}
{"category": "LocationDialogue Location17", "line_index": 155, "text": "Bu kahvenin tadı berbat..."}
{"category": "LocationDialogue Location17", "line_index": 156, "text": "Tamamen iyiyim..."}
{"category": "LocationDialogue Location17", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 158, "text": "// Button"}
{"category": "LocationDialogue Location17", "line_index": 159, "text": "Mita? Tuş çalışmıyor... Duyuyor musun?"}
{"category": "LocationDialogue Location17", "line_index": 160, "text": "Merhaba?"}
