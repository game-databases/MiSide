{"category": "LocationDialogue Location12", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Otur."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Bir şey düşürdüm sanırım. Hemen gelirim."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "Sonra da başka bi dünyaya gideriz..."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Tamam."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Hadi oynayalım!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Ayıcığımı istiyorum!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "Kaybettim..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "Bul ONU!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Hey..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "Neye bakıyorsun?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Quest 1 (Who are you?)"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Ben Mita."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "En en iyi Mita."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "İlk Mita."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "Mita öyle dedi yani, Benim Mita'm."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Quest 2 (Why do you look like that?)"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "Nasılmışım?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "Nasılmışım?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "Nasılmışım?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "Mita'm güzel ve orjinal olduğumu söylüyor."}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "İşte ben!"}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Quest 3 (What was Mita doing here?)"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Beni götürecek."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Yeni bir dünyada yaşayacağız."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "Mita'm beni davet etti."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Beni götürecek ve oyun oynayacağız."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Quest 4 (Why do you need a teddy bear?)"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "Sen bir ayıcıksın,"}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "ve kaybolmuşsun,"}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "tıpkı benim ayım gibi."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Quest 5 (Why is Mita angry?)"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "benim..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "Mita'm."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Oynamak istiyor."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Sadece."}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "Beni istiyor."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Biz eşsiziz."}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "Tekiz."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Mita ve benim Mita'm,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0.8A ve 8Ì54*."}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Quest 6 (Do you believe Mita?)"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "Benim Mita'm."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "En yakın arkadaşım."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "Benim Mita'm."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "Tek arkadaşım."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "Sensin!"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Hey."}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Hadi oynayalım!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Sana göstereceğim."}
