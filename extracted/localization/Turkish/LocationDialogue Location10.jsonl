{"category": "LocationDialogue Location10", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "Bekle, dur burada!,"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "Sessiz ol..."}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "İlerisi tehlikeli."}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "Bu arada..."}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "Nasıl geldin sen buraya?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "Um..."}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "Yüzük doğru kapıları açıyor"}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "cart curt çok bilmiyorum."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "Yüzük mü?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "Buranın olayı ne?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "Niye bu kadar karanlık?"}
{"category": "LocationDialogue Location10", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "Daha sonra anlatırım."}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "Şimdilik çıkışa git."}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "Oyun makinesinde buluşuruz."}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Acele et, geç kalma!"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// After mini-game"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "Eee, mesajı anladın mı?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "Benim et ve kemikten yapıldığım, senin de iskelet modelinden yapıldığın mı?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "Vay!"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "Öyle diyince korkutucu geldi."}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "Ama genel olarak öyle."}
{"category": "LocationDialogue Location10", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "Güzel, niye anlamam gerekti peki bunu?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "İlerlemenin tehlikeli olduğunu söylerken"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "şaka yapıyorum mu sandın?"}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "Terk edilmiş modellerle karşılaşıcaksın..."}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "\"hatalı\" olarak işaretlenmiş olanlarla."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "Agresifler ve seni öldürmek isteyecekler."}
{"category": "LocationDialogue Location10", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "Yani, ne yapmalıyım?"}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Kapı nereye açılırsa "}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "oraya giderim."}
{"category": "LocationDialogue Location10", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "Peki!"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "O zaman onlara arkanı dönme."}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "Gözünün önünde bulunsunlar!"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "Onlara baktığında utanırlar,"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "o kadar utanırlar ki donakalırlar."}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "Aklında bulunsun."}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// Quest 1 (Why are there other Mitas down there?)"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "Onlar yeni yapılmış."}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "Benliklerini kazanmaları için"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "zamana ihtiyaçları var."}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "Sonra tek tek evlerine,"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "götürüyorum."}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// Quest 2 (Why is it so dark downstairs?)"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "Biz Mita'lar karanlıkta yaratılırız"}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "O yüzden biraz karanlıkta kalmamız gerekir."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Karanlıktan ışığa yürümenin"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "acısını hayal etsene..."}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// Quest 3 (What are you doing here?)"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "Anlamadın mı halen?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "Yeni Mita'ların yerleşmesinde yardımcı oluyorum!"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "Ben olmasam kim yardımcı olacak?"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "Sen mi?"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// Quest 4 (Why do we need this conveyor?)"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "Bu bant ne için?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "Herkes için yer var mı?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Buranın olayını anlamadığını"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "söyleme bana lütfen..."}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "Burası sonsuz."}
{"category": "LocationDialogue Location10", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "Sonsuz mu?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "Ehm..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "Ne demek istiyorsun?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "1.9 son sürümse eğer"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "19 dünya vardır."}
{"category": "LocationDialogue Location10", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "Tanrım,"}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "gerçekten hiçbir şey anlamamışsın."}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Sana şu tahtada"}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "her şeyi anlatabilirim."}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "Duymak ister misin?"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// Quest 5 (What is your version?)"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Bekle,"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "Ben seninle ileri sürümlerde karşılaşmamış mıyıdım?"}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "Ya da hayal mi etmiştim?"}
{"category": "LocationDialogue Location10", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "Aslında mümkünatı var."}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Ben 1.5 sürümündenim."}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "Orada mıydın?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Evet."}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "Bu saçmalığa itildiğimde"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "ilk başladığım yer orasıydı!"}
{"category": "LocationDialogue Location10", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "Vay!"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "Ama nasıl?"}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "Evinin sıra numarası neydi ki?"}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "Mızmızlanan bir 'ben' var orada,"}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "takılmayı seven bir 'ben',"}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "başkalarını zorbalamayı seven ve her şeyi unutan bir 'ben'..."}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "Uzun bir liste..."}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Ne hatırladığını söyle."}
{"category": "LocationDialogue Location10", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Karanlıktı."}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "Duvarda bir yazı yazıyordu"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "Şey gibi..."}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "\"Benimle oyna.\""}
{"category": "LocationDialogue Location10", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "Ah,"}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "Ne yazık ki..."}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "O unutkan ve zorbalığı seven"}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "'ben' oluyorum."}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// Mita wants to tell you [No]"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Teşekkürler ama hayır."}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Bilmesem de olur."}
{"category": "LocationDialogue Location10", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "Peki, rahatına bak."}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// Mita wants to tell you [Yes]."}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "Olur, anlat."}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "Umarım lise gibi olmaz."}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "Sürekli sıkıntıdan uyuyaklıyordum da."}
{"category": "LocationDialogue Location10", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "İstediğin zaman gidebilirsin,"}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "ya da kalıp dinlersin."}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "Sana kalmış."}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "Bir oyuncu MiSide'ı indirir"}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "ve istediği kadar oynar."}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "İşte o zaman,"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "yeni bir ev ve Mita yaratmış olur."}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "Bu 2 boyutlu temsili."}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "Bunlar sürümler,"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "çizgiler olarak gösterilmiş."}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "Evler bu çizgilerde konuşlanır."}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "Diyelim ki 1.14 sürümünü indirdin,"}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "bu yeni bir hayat demek oluyor."}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "Yeni bir Mita yeni bir ev."}
{"category": "LocationDialogue Location10", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "İlginç..."}
{"category": "LocationDialogue Location10", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Çizim üzerinden"}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "sorun varsa alabilirim."}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "Anlatmak için elimden geleni yaparım."}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// He asks about the only circle"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "Şurada neden tek bi çember var?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "O sürüm bir daha çıkmamak üzere,"}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "bir kere çıktı."}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "Bu yüzden özel bir sürüm."}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "Ayrıca bu sürümlerin özelliği,"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "Kaçınılmaz olmaları."}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "1.1 sürümünde Uykucu Mita kalıyor."}
{"category": "LocationDialogue Location10", "line_index": 171, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "Uykucu Mita mı?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "Onun sürümünden geçen insanlar yüzünden,"}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "uyuyamıyor diye mi?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "Hayır öyle değil."}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "Yanından geçerken ses yapsan da,"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "uyanması imkansız."}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// He asks about the shaded circle"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "Bu çember niye tamamen boyanmış?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "Ehm, o"}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "Güzel Mita yüzünden."}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "O çizdi."}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "Kim ilk 1.11 sürümüne gider diye,"}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "tartışıyorduk da."}
{"category": "LocationDialogue Location10", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "Ee, kim kazandı?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "BEN tabii ki!"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "Bak, biz burada,"}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "1.15 sürümündeyiz."}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "Ev sıra kodu 809."}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "1.11 sürümü 805 sırasına, "}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "gitmeliyiz."}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Onun yolu burdan başladı."}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "Daha kısa bir yol bulmaya çalıştık."}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "Güzel Mita da bu yolu önerdi."}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "Sonra ben daha basit bir tane çizdim."}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "Basit, değil mi?"}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Bak bi."}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "Şuradan direkt doğru sürüme gidebiliyorsun."}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Bu ev yolda gibi "}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "ama sorun çıkarmıyor."}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "Neyse, senin yüzüğün de aynı şekilde çalışıyor."}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "Nereye gidiyorsun?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "Çekirdeğe"}
{"category": "LocationDialogue Location10", "line_index": 210, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "Çekirdeğe mi?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "Hmm..."}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Eğer en kısa yoldan gidiyorsan."}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "Senin de 1.1 sürümünden geçmen gerek."}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "Orada kesinlikle Uykucu Mita ile karşılaşırsın."}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Seni yollayan Mita da"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "aynı yolu çizdi sanırım."}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "Ya da fark edemedi ve başka yerleri de gezersin."}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "Ya da belki çok zekidir"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "ve daha da kısa bir yol bulmuştur!"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Sanırım anlıyorum."}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// He asks about the inscription"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "Bu ne için?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "O Havalı Mita için."}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "Birkaç saate burada olur."}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "Kutuları kaldıracak"}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "ve oraya koltuk koyacak."}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "Kıçım acıyor."}
{"category": "LocationDialogue Location10", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Emm..."}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "Yardımcı olabilirim belki."}
{"category": "LocationDialogue Location10", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "Hayır, o Havalı Mita'nın işi."}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Serttir."}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// He asks about the drawings"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "Şunun bir anlamı var mı"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "yoksa "}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "sadece bir çizim mi?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 244, "text": "Evet"}
{"category": "LocationDialogue Location10", "line_index": 245, "text": "sadece bir karalama."}
