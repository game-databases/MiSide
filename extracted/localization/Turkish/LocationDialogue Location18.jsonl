{"category": "LocationDialogue Location18", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 1, "text": "Parlak ışık gözüme vuruyordu."}
{"category": "LocationDialogue Location18", "line_index": 2, "text": "Gözüm açılana kadar hareket etmeden bekledim."}
{"category": "LocationDialogue Location18", "line_index": 3, "text": "Parlak yaz ışığı tanıdık salonun içini dolduruyordu."}
{"category": "LocationDialogue Location18", "line_index": 4, "text": "Biraz sonra, aklım yerine geldi ve etrafıma baktım."}
{"category": "LocationDialogue Location18", "line_index": 5, "text": "Koltuktan kalkmaya çalıştığım anda keskin bir sızı kalbimi hızlandırdı, kalbim resmen gömleğime çarpıyordu."}
{"category": "LocationDialogue Location18", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 8, "text": "Bir şeyler kesinlikle yanlıştı... Ben 2B mi olmuştum? 2B bir sürümde miydim?!"}
{"category": "LocationDialogue Location18", "line_index": 9, "text": "..."}
{"category": "LocationDialogue Location18", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 12, "text": "Aklım bulanmış, boğucu karanlık aklıma sızmış neredeyse ve içgüdüsel olarak ellerimi kucağıma koydum,"}
{"category": "LocationDialogue Location18", "line_index": 13, "text": "nefesimi dinginleştirmeye çalıştım. Göğüsüm sıkılaşıyordu, içeri doğru sıkılıyomuş gibi."}
{"category": "LocationDialogue Location18", "line_index": 14, "text": "Dakikalar sonra, nefesim düzeldi ve sonraki hamlemi düşünmeye cesaret edebildim."}
{"category": "LocationDialogue Location18", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 17, "text": "Siktir, şimdi ne olacak?"}
{"category": "LocationDialogue Location18", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 20, "text": "Çaresizce aklımı toparlamaya çalıştım, beynimi zorladım, aklıma bir tane gelene kadar fikir aradım."}
{"category": "LocationDialogue Location18", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 23, "text": "Doğru, 3B ye dönmeliyim!"}
{"category": "LocationDialogue Location18", "line_index": 24, "text": "Sınırların dışına çık, tıpkı diğer herkesin oyunu hataya sürüklemesi gibi!"}
{"category": "LocationDialogue Location18", "line_index": 25, "text": "Ben de yapabilirim!"}
{"category": "LocationDialogue Location18", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 28, "text": "2B nin ötesine, 3B ye gidebileceğime karar verdim."}
{"category": "LocationDialogue Location18", "line_index": 29, "text": "Uzandım, elimi 3B dünyaya sokmaya çalıştım."}
{"category": "LocationDialogue Location18", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 32, "text": "Ama... olmadı. Lanet! Niye işe yaramıyor?!"}
{"category": "LocationDialogue Location18", "line_index": 33, "text": "Ve, ne? Yüzük nerede? Hay."}
{"category": "LocationDialogue Location18", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 36, "text": "Durdum, bunun anlamsız olduğunu fark ettim."}
{"category": "LocationDialogue Location18", "line_index": 37, "text": "Arayüz sanki gerçek değilmiş gibi, orada değildi."}
{"category": "LocationDialogue Location18", "line_index": 38, "text": "Tek seçeneğim salona dönmekti."}
{"category": "LocationDialogue Location18", "line_index": 39, "text": "Yüzüğü ne olursa olsun bulmalıydım."}
{"category": "LocationDialogue Location18", "line_index": 40, "text": "Bir yerlerde kaybetmişim, ya da bu düz evrende bir yerlerde saklıdır."}
{"category": "LocationDialogue Location18", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 42, "text": "Ve ilk adımı atar atmaz, sevimli bir kız karşıma çıkıverdi."}
{"category": "LocationDialogue Location18", "line_index": 43, "text": "At kuyruğu saçlarını salladı, gözlerinde hain bir parlama,"}
{"category": "LocationDialogue Location18", "line_index": 44, "text": "birkaç adım geriden beni izliyordu. Ondaki heyecanı hissedebiliyordum"}
{"category": "LocationDialogue Location18", "line_index": 45, "text": "ve bu beni geriyordu."}
{"category": "LocationDialogue Location18", "line_index": 46, "text": "> Açıkça, gizlenmiş bir şeytan. <"}
{"category": "LocationDialogue Location18", "line_index": 47, "text": "Diye düşündüm."}
{"category": "LocationDialogue Location18", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 49, "text": "Donakaldım,"}
{"category": "LocationDialogue Location18", "line_index": 50, "text": "Halen bu ışınlanma, anomali işlerine alışamadım."}
{"category": "LocationDialogue Location18", "line_index": 51, "text": "Sesli bir şekilde iç çekti ve gözlerini devirdi."}
{"category": "LocationDialogue Location18", "line_index": 52, "text": "Beni şaşırttı ve sonunda konuşmayı başlatan kişi olmaya karar verdim."}
{"category": "LocationDialogue Location18", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 55, "text": "M-Mita?"}
{"category": "LocationDialogue Location18", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 58, "text": "Gözlerini hırsla kıstı ve sesi her yönden yankılandı."}
{"category": "LocationDialogue Location18", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 61, "text": "Ya kim olacaktı?"}
{"category": "LocationDialogue Location18", "line_index": 62, "text": "Bana benzeyen BAŞKA KIZ mı gördün?"}
{"category": "LocationDialogue Location18", "line_index": 63, "text": "Ve benim adımda?"}
{"category": "LocationDialogue Location18", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 66, "text": "Benimle oynuyordu, ona bir şey yapmışım ya da bir borcum varmışcasına."}
{"category": "LocationDialogue Location18", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 69, "text": "Söylesem inanmazsın..."}
{"category": "LocationDialogue Location18", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 72, "text": "Açıkcası, kimle ne yapıyorsun bilmek istemiyorum!"}
{"category": "LocationDialogue Location18", "line_index": 73, "text": "Burada n'apıyorsun ki?"}
{"category": "LocationDialogue Location18", "line_index": 74, "text": "Buraya öylece giremezsin!"}
{"category": "LocationDialogue Location18", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 77, "text": "Sesi yükseliyordu,"}
{"category": "LocationDialogue Location18", "line_index": 78, "text": "ve cümlesini parmağını bana göstererek bitirdi."}
{"category": "LocationDialogue Location18", "line_index": 79, "text": "O uzun parmaklarının arasındaki... Yüzüktü. Benim elimden kaybolan."}
{"category": "LocationDialogue Location18", "line_index": 80, "text": "Çenem düştü."}
{"category": "LocationDialogue Location18", "line_index": 81, "text": "Gözleri parladı, kara kirpikleri arasından zafer gözüküyordu."}
{"category": "LocationDialogue Location18", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 83, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 84, "text": "Burada kaybettiğin şey bu değil mi?"}
{"category": "LocationDialogue Location18", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 87, "text": "Yutkundum ve yakamı düzelttim, boğazımda bir düğüm hissettim."}
{"category": "LocationDialogue Location18", "line_index": 88, "text": "Sert sesi, vahşi doğası ile birleşince içim ürperdi."}
{"category": "LocationDialogue Location18", "line_index": 89, "text": "Artık emindim, bu rastgele bir kız değil. O doğanın bir ürünüydü."}
{"category": "LocationDialogue Location18", "line_index": 90, "text": "Derin bir nefes aldım ve dedim ki"}
{"category": "LocationDialogue Location18", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 93, "text": "Bana yüzüğü verip, çıkışı gösterirsen çok memnun olurum."}
{"category": "LocationDialogue Location18", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 96, "text": "Demek bu senindi."}
{"category": "LocationDialogue Location18", "line_index": 97, "text": "Ne olduğunu merak ediyordum!"}
{"category": "LocationDialogue Location18", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 100, "text": "Sesi bir anda yumuşadı,"}
{"category": "LocationDialogue Location18", "line_index": 101, "text": "meraklı ve şakacı bir hal aldı."}
{"category": "LocationDialogue Location18", "line_index": 102, "text": "Omuzlarımdan bir yük kalkmış gibi hissettim."}
{"category": "LocationDialogue Location18", "line_index": 103, "text": "Fırtına geçti ve o neredeyse... flörtöz görünüyordu."}
{"category": "LocationDialogue Location18", "line_index": 104, "text": "Hareketleri sinirli bir panterden meraklı bir kediye döndü."}
{"category": "LocationDialogue Location18", "line_index": 105, "text": "Göz kırptım ama bi anda, iki boyutlu Mita kayboldu, yerine sadece boşluk kaldı."}
{"category": "LocationDialogue Location18", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 108, "text": "Hey!"}
{"category": "LocationDialogue Location18", "line_index": 109, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 110, "text": "Diye bağırdım sinirli bir şekilde."}
{"category": "LocationDialogue Location18", "line_index": 111, "text": "Mutfak"}
{"category": "LocationDialogue Location18", "line_index": 112, "text": "Yatak odası"}
{"category": "LocationDialogue Location18", "line_index": 113, "text": "// Description kitchen:"}
{"category": "LocationDialogue Location18", "line_index": 114, "text": "Mita'yı takip etmektan başka seçeneğim yoktu."}
{"category": "LocationDialogue Location18", "line_index": 115, "text": "Yüzük ondaydı ve o olmadan hiçbir şey yapamazdım."}
{"category": "LocationDialogue Location18", "line_index": 116, "text": "İlk mutfağa gittim,"}
{"category": "LocationDialogue Location18", "line_index": 117, "text": "kapıyı hızlıca iterek girdim,"}
{"category": "LocationDialogue Location18", "line_index": 118, "text": "Havuçların tanıdık kokusunu aldım."}
{"category": "LocationDialogue Location18", "line_index": 119, "text": "Ama 2B Mita'dan iz yoktu."}
{"category": "LocationDialogue Location18", "line_index": 120, "text": "Dışarı fırladım, salona koştum, "}
{"category": "LocationDialogue Location18", "line_index": 121, "text": "yetenekli bir şekilde koltuktan—biraz engel oldu—geçip yatak odası kapısının önünde durdum."}
{"category": "LocationDialogue Location18", "line_index": 122, "text": "Açılması için itince sesli bir şekilde gıcırdadı."}
{"category": "LocationDialogue Location18", "line_index": 123, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 124, "text": "// Description bedroom:"}
{"category": "LocationDialogue Location18", "line_index": 125, "text": "İşte burada, bağdaş kurmuş yatakta oturuyor, onu bulmamı beklermişcesine."}
{"category": "LocationDialogue Location18", "line_index": 126, "text": "Gözlerini açtı, bi anlığına sakince duvara baktı."}
{"category": "LocationDialogue Location18", "line_index": 127, "text": "Sonra, adeta bir sirk akrobatının hızıyla bana doğru sıçardı."}
{"category": "LocationDialogue Location18", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 130, "text": "Anladım!"}
{"category": "LocationDialogue Location18", "line_index": 131, "text": "Yüzüğü istiyorusun, ucube."}
{"category": "LocationDialogue Location18", "line_index": 132, "text": "Beni tic-tac-toe da yen!"}
{"category": "LocationDialogue Location18", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 135, "text": "Sırıttı, nefes nefeseydi, dilini bir köpek gibi çıkardı."}
{"category": "LocationDialogue Location18", "line_index": 136, "text": "Aşağılayıcı ses tonu ve küçümseyici gülüşü etkisini gösteriyordu."}
{"category": "LocationDialogue Location18", "line_index": 137, "text": "Aramıza biraz mesafe koymak için omzunu ittim."}
{"category": "LocationDialogue Location18", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 139, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 140, "text": "Bak, bu önemli bir konu."}
{"category": "LocationDialogue Location18", "line_index": 141, "text": "Ver şunu bana, çok fazla şey ona bağlı."}
{"category": "LocationDialogue Location18", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 144, "text": "Sesimi sakin ve düz bir şekilde tuttum,"}
{"category": "LocationDialogue Location18", "line_index": 145, "text": "ama onunla böyle dengeli bir şekilde konuşmak saçma hissettirdi."}
{"category": "LocationDialogue Location18", "line_index": 146, "text": "Umursamaz görünüyordu, delilik noktasında,"}
{"category": "LocationDialogue Location18", "line_index": 147, "text": "ve aramızda garip bir mizah hissediyordum."}
{"category": "LocationDialogue Location18", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 150, "text": "Bana dokunma!"}
{"category": "LocationDialogue Location18", "line_index": 151, "text": "Bu yüzüğün nesi bu kadar önemli ki?"}
{"category": "LocationDialogue Location18", "line_index": 152, "text": "Yüzük takıntılısı ucube falan mısın?"}
{"category": "LocationDialogue Location18", "line_index": 153, "text": "Parmağına yüzük takmaktan mı hoşlanıyorsun?"}
{"category": "LocationDialogue Location18", "line_index": 154, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 156, "text": "Hızla cevap verdi, daha sesli ve daha sert."}
{"category": "LocationDialogue Location18", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 159, "text": "Büyülü bir yüzük o! Daha ne anlatmalıyım? Sadece ver şunu!"}
{"category": "LocationDialogue Location18", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 162, "text": "Gerçekten komiksin!"}
{"category": "LocationDialogue Location18", "line_index": 163, "text": "Büyülü bir yüzük mü?"}
{"category": "LocationDialogue Location18", "line_index": 164, "text": "HAHAHAHA!"}
{"category": "LocationDialogue Location18", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 167, "text": "Gülmeye başladı. Sesi etrafımızda yankılandı."}
{"category": "LocationDialogue Location18", "line_index": 168, "text": "Gözümü çevirdim,"}
{"category": "LocationDialogue Location18", "line_index": 169, "text": "kahkahasının daha da... arkadaş canlısı olması garip hissettirdi."}
{"category": "LocationDialogue Location18", "line_index": 170, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 171, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 172, "text": "Hadisene, ucube!"}
{"category": "LocationDialogue Location18", "line_index": 173, "text": "Hadi tic-tac-toe oynayalım!"}
{"category": "LocationDialogue Location18", "line_index": 174, "text": "Zamanını bahanelere harcama!"}
{"category": "LocationDialogue Location18", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 176, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 177, "text": "> Oyunları baya seviyorlar! <"}
{"category": "LocationDialogue Location18", "line_index": 178, "text": "Diye düşündüm."}
{"category": "LocationDialogue Location18", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 180, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 181, "text": "Tamam peki, oynayalım."}
{"category": "LocationDialogue Location18", "line_index": 182, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 184, "text": "Sen başla, bugün cömert hissediyorum."}
{"category": "LocationDialogue Location18", "line_index": 185, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 186, "text": "// The game of tic-tac-toe"}
{"category": "LocationDialogue Location18", "line_index": 187, "text": "İlk hamleyi yaptım."}
{"category": "LocationDialogue Location18", "line_index": 188, "text": "A, kendini eleverdin! Neden X'i seçtiğini ve beni O ile bıraktığını biliyorum, psikoloji! X'ler kapanmayla ilgilidir, bişeyleri saklamakla, sır tutmakla. Sen gerginsin!"}
{"category": "LocationDialogue Location18", "line_index": 189, "text": "Ve anladım; benim gibi aşırı güzel birinin yanında, ölüp giderdin! Ya da O'lar benim için daha mı iyiydi? Psikoloji bana hakaret etmeye çalıştığını söylüyor. Üzücü, dostum. Çok üzücü! Ha ha ha ha!"}
{"category": "LocationDialogue Location18", "line_index": 190, "text": "Akıllıca bir hamle yaparım sandım,"}
{"category": "LocationDialogue Location18", "line_index": 191, "text": "Bu oyunu seviyorum. Şu küçük çarpılar, her şeyi ele geçirebileceklerini sanıyorlar! Ama işte, Onları yok ettim,"}
{"category": "LocationDialogue Location18", "line_index": 192, "text": "ve kahraman gibi bir şeyim şu anda! N'oldu? Garip bir şey mi söylüyorum? Öyle bakıyorsun... Ha ha ha!"}
{"category": "LocationDialogue Location18", "line_index": 193, "text": "O hareketlerini açıklarken ben sessizce oyunumu oynadım."}
{"category": "LocationDialogue Location18", "line_index": 194, "text": "Sembolik! Yüzüğü yok saymaya çalışıyorsun ancak işe yaramıyor. Zekisin, değil mi?"}
{"category": "LocationDialogue Location18", "line_index": 195, "text": "Yüzüğü istiyorsun değil mi? Oyunu kazan o zaman!"}
{"category": "LocationDialogue Location18", "line_index": 196, "text": "Oyunu oynamaya devam ettik ve her hamleden sonra gülmeye ve konuşmaya devam etti. Kulaklarım yaptığı boşa alışmaya başlamıştı."}
{"category": "LocationDialogue Location18", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 198, "text": "Oyunun sonuna yaklaştıkça kimin kazacağı netleşmeye başladı."}
{"category": "LocationDialogue Location18", "line_index": 199, "text": "Ama oyun anlık bir kapı gümbürtüsüyle bölündü."}
{"category": "LocationDialogue Location18", "line_index": 200, "text": "Gümleme daha da gürültülü bir hal aldı,"}
{"category": "LocationDialogue Location18", "line_index": 201, "text": "Her vuruş altımızdaki zemini titretiyordu,"}
{"category": "LocationDialogue Location18", "line_index": 202, "text": "Sonunda kapı, fırlayarak açıldı."}
{"category": "LocationDialogue Location18", "line_index": 203, "text": "Ve her zamanki gibi içeri Deli Mita girdi."}
{"category": "LocationDialogue Location18", "line_index": 204, "text": "Hayatın kendisinden daha büyük bir şekilde, odanın ortasında durdu."}
{"category": "LocationDialogue Location18", "line_index": 205, "text": "Dondum, korkudan rengimin solduğunu hissettim."}
{"category": "LocationDialogue Location18", "line_index": 206, "text": "2B Mita korkmuş gibi bakıyordu."}
{"category": "LocationDialogue Location18", "line_index": 207, "text": "Deli Mita ikimize de sert bir bakış attı ve azarlayan ses tonuyla konuşmaya başladı:"}
{"category": "LocationDialogue Location18", "line_index": 208, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 209, "text": "[player], burada ne yapıyorsun?"}
{"category": "LocationDialogue Location18", "line_index": 210, "text": "Dinmeden önce daha kaç tane Mita bulman gerek?"}
{"category": "LocationDialogue Location18", "line_index": 211, "text": "Bunun olayı nedir?"}
{"category": "LocationDialogue Location18", "line_index": 212, "text": "Şu düz dünyadan nefret ediyorum."}
{"category": "LocationDialogue Location18", "line_index": 213, "text": "Sıkıcı..."}
{"category": "LocationDialogue Location18", "line_index": 214, "text": "Saçma..."}
{"category": "LocationDialogue Location18", "line_index": 215, "text": "Nereye gidiyorsun? Dur!"}
{"category": "LocationDialogue Location18", "line_index": 216, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 217, "text": "2B arkadaşımın elini tuttum ve çıkışa doğru fırladım."}
{"category": "LocationDialogue Location18", "line_index": 218, "text": "Biz koştukça koridor garip bir şekilde bükülmeye başladı, arkamızdan gelen adım sesleri bizi ileri gitmeye zorluyordu."}
{"category": "LocationDialogue Location18", "line_index": 219, "text": "Ne kadar koştuk bilmiyorum,"}
{"category": "LocationDialogue Location18", "line_index": 220, "text": "Kulaklarımdaki paniğin gümbürtüsü her sesi duymamı engelliyordu."}
{"category": "LocationDialogue Location18", "line_index": 221, "text": "2B Mita'nın benimle konuşmaya çalıştığını zor anladım, bi anda elimi bıraktı."}
{"category": "LocationDialogue Location18", "line_index": 222, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 223, "text": "Hey! Sakinleş bi. Kimse bizi kovalamıyor artık."}
{"category": "LocationDialogue Location18", "line_index": 224, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 225, "text": "He? Peki..."}
{"category": "LocationDialogue Location18", "line_index": 226, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 228, "text": "Yüzündeki sertlik gitti de yerine üzgün bir surat geldi."}
{"category": "LocationDialogue Location18", "line_index": 229, "text": "Zemine baktı, ayağıyla çemberler çizdi."}
{"category": "LocationDialogue Location18", "line_index": 230, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 231, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 232, "text": "[player], yüzüğü istiyordun değil mi?"}
{"category": "LocationDialogue Location18", "line_index": 233, "text": "Beni adil bir şekilde yendin, o yüzden al."}
{"category": "LocationDialogue Location18", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 236, "text": "Yüzüğü elime verdi."}
{"category": "LocationDialogue Location18", "line_index": 237, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 239, "text": "Şey, teşekkürler. Devam edelim mi?"}
{"category": "LocationDialogue Location18", "line_index": 240, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 241, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 242, "text": "Kafasını kaldırıp gülümsedi,"}
{"category": "LocationDialogue Location18", "line_index": 243, "text": "parmaklarıyla biraz oynadı ve emin olmayan ses tonuyla şunu dedi:"}
{"category": "LocationDialogue Location18", "line_index": 244, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 245, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 246, "text": "Nereye?"}
{"category": "LocationDialogue Location18", "line_index": 247, "text": "Gidecek bir yerim yok..."}
{"category": "LocationDialogue Location18", "line_index": 248, "text": "Oyun için teşekkürler ucube!"}
{"category": "LocationDialogue Location18", "line_index": 249, "text": "Sonra bir daha gel."}
{"category": "LocationDialogue Location18", "line_index": 250, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 251, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 252, "text": "Konuşurken garip bir şey oldu."}
{"category": "LocationDialogue Location18", "line_index": 253, "text": "Etrafımızdaki dünya değişti, ev şekline geldi."}
{"category": "LocationDialogue Location18", "line_index": 254, "text": "2B Mita'nın konuşma kutusu değişti ve yerine tanıyamadığım bir satır geldi."}
{"category": "LocationDialogue Location18", "line_index": 255, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location18", "line_index": 258, "text": "Pasta mı? Hiç sevmem! Havuç rendeleyelim, olur mu?"}
