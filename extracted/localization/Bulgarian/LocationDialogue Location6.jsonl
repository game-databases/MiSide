{"category": "LocationDialogue Location6", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "Мита?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "Как изобщо дойде тук?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Ти си Мита, нали?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Но не си точно същата..."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "Ясно."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "Прав си, действително"}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "не съм същата Мита, която познаваш."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Внимавай, тя крои много"}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "лоши неща за теб."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "Какви неща?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "Нямам време да ти обясня."}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "Ако това сработи, ще ти обясня всичко."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Вземи ключа. Намира се до дивана."}
{"category": "LocationDialogue Location6", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Но..."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "Запази си въпросите за по-късно!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Дай ми ключа."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Вземи този пръстен."}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "Защо?"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Искаш да се измъкнеш оттук, нали?"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "Ами, да..."}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Тогава си го сложи."}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "Полезен инструмент е,"}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "най-вероятно ще ти трябва скоро."}
{"category": "LocationDialogue Location6", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Добре..."}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "Иначе аз се казвам"}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Прекрасно име имаш,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "Аз се казвам... Мита."}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// MitaKind quest 1"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "Виждаш ли онази"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "конзола? Вземи я."}
{"category": "LocationDialogue Location6", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "Да не гледаме запис?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "Кой е този с нея?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "Това се случва в реално време."}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "С друг играч е."}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Използва го."}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Може би ще се опита"}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "да превърне и теб в дискета."}
{"category": "LocationDialogue Location6", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "Трябва да изляза оттук възможно най-скоро."}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "И ти също."}
{"category": "LocationDialogue Location6", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "Да, така е."}
{"category": "LocationDialogue Location6", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "Значи казваш,"}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "че тя го използва?"}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "Какво ще стане, ако извадя дискетата?"}
{"category": "LocationDialogue Location6", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "Това би могло"}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "необратимо да повреди дискетата."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "Тоест..."}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "...играчът ще умре."}
{"category": "LocationDialogue Location6", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "..."}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "Ами ако просто я изключа?"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "Това би могло да проработи..."}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Заслужава си да пробваш. Има червен бутон за изключване!"}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Видя ли го?"}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "Открих го."}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "Натисни го."}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// MitaKind quest 2"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Аз трябва да остана."}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "Трябва да я питам разни неща,"}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "за да разбера повече за нея."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "Макар че едва ли ще е в състояние да общуваме адекватно..."}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// MitaKind quest 3"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "Всъщност това е моята версия."}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "Бях с един играч,"}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "но изведнъж нещо се промени."}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "И после тя се появи..."}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "Превърна играча в дискета"}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "и ме заключи тук."}
{"category": "LocationDialogue Location6", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Чакай, превърнала е играча в дискета?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "Тя може да направи такова нещо?"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "Но защо?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "За какво ѝ трябват играчите?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "Очевидно е обезумяла..."}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Просто си играе с нас, защото така ѝ е забавно на нея. "}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "Превръща играчите в дискети..."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Някои дори не осъзнават какво им се случва."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "Други пък осъзнават, но не се съпротивляват..."}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "Това изобщо не ми допада..."}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "Трябва да ни помогнеш!"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "Аз ли? Но как?"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "Нуждаем се от теб!"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "Ако ни помогнеш, и аз ще ти помогна!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Това може да е единственият ни шанс."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "Пръстенът ще те отведе до правилната версия."}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "Ще се срещнем там."}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// MitaKind quest 4"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "Все още не мога да обработя"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "какво видях на горния етаж..."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Онази Мита..."}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "Опитваше ли се да ме убие?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "Да те убие?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Възнамерява много по-лоши неща да ти прави..."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "Трябва да побързаш."}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Hide!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "По дяволите! Скрий се!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Какво?"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Бързо, тя идва!"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "Довери се на пръстена - той ще те спаси!"}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "Сега ще ми кажеш ли къде е той?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "Защо бих?"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "Не смяташ да го убиваш, нали?"}
{"category": "LocationDialogue Location6", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Значи няма да ми кажеш..."}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Няма страшно, харесва ми, че се крие."}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "Знам, че е тук някъде."}
{"category": "LocationDialogue Location6", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "Защо си толкова агресивна?"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "Даже не искаш да ми кажеш какво се случва!"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "Въобще..."}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "за какво са ти играчите?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "Те не са играчки!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "Какво те е обзело?!"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "Достатъчно! Мълчи, кукла проклета!"}
