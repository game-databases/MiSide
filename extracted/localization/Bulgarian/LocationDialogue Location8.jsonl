{"category": "LocationDialogue Location8", "line_index": 0, "text": "// The first meeting"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "Коя си ти?"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "Какво има?"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "Не можеш ли да говориш?"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "Чакай..."}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "Искаш да си тръгнеш, нали?"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "Да..."}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "Трябва да се върна"}
{"category": "LocationDialogue Location8", "line_index": 11, "text": "към по-стара версия."}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "По-стара версия?"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "Защо ще тръгваш и ще ходиш"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "някъде другаде?"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "Защо не останеш тук"}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "и не станеш"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "моят втори приятел?"}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Skipping all dialogs"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "Ясно..."}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Standing by the window (Random)"}
{"category": "LocationDialogue Location8", "line_index": 24, "text": "Няма да си намериш пътя през вратите."}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "Изглежда сякаш бързаш..."}
{"category": "LocationDialogue Location8", "line_index": 26, "text": "Бягането няма да те спаси."}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "Толкова ли искаш да избягаш?"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "Погледни през прозореца..."}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Aren't you Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "Играч... ти си играч, нали?"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": "Може да играем."}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "Ако имам сили,"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": "можем просто да играем."}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (What happened to you?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "Не съм сигурна, всъщност не знам..."}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "Не знам за нещо лошо да ми се е случвало..."}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "Но всичко хубаво сякаш ми се изплъзва..."}
{"category": "LocationDialogue Location8", "line_index": 41, "text": "Обаче поне си имам приятел."}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "Защо ме остави?"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "Не съм ли достатъчна?"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "Страх ме е..."}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Quest 3 (Become a second friend?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "Приятели..."}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "Имам толкова малко вече."}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "Само един остана..."}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "Тъжна съм, играч."}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "Ще ми станеш ли приятел?"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "С удоволствие,"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "обаче трябва да вървя..."}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "Сърцето ме боли..."}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Is this your house?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "Дом?"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "Играч... променил си се..."}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "Ръцете ти са по-къси и не изглеждаш ядосан..."}
{"category": "LocationDialogue Location8", "line_index": 62, "text": "Играч, станал си по-нежен и по-мил."}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "Не съм сигурен..."}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "какво значи това."}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "Няма нищо..."}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "защото няма да ме боли повече, нали?"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (How do I leave this place?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "Наистина ли ще ме оставиш?"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "Може би това ми е..."}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "съдбата?"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "Аз..."}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": "Вратите няма да ти помогнат."}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Hold player (Random)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "Защо си тръгваш?"}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "Стой тук..."}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "Играй си с мен..."}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "Играч..."}
