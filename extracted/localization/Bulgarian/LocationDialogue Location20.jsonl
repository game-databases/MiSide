{"category": "LocationDialogue Location20", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Мила! Не! Ти си болна!"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Ха-ха! КАКВО ВИЖДАМ АЗ?"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "Това ново изражение ли е?"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "Хайде, давай, покажи ми още!"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "Скучно ми стана с това ти изражение!"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\""}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "Как е, неуморен мой?"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "Все още ли не ти е омръзнало да скиташ наоколо?"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Какво направи на Мила?"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "О, значи не си уморен още!"}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Перфектно! Нека играем на друга игра!"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "Ти..."}
{"category": "LocationDialogue Location20", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "Нека започнем с малък тест!"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "Ще проверим координацията ти!"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "Ще тестваме твоето поведение!"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "Ами ако нещо не ти е наред!?"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "Какво ще правим, ако дори не заслужаваш тази твоя КОЖА,"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "която така гордо носиш!?"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "Погледни..."}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "кой ти грабва окото повече?"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "Десният?"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "Или"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "левият?"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "Ти сериозно ли?"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "Какво значение има?"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "Просто се шегувах!"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "Намушкванията са от миналия век."}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "Както и да е!"}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "Планирала съм много по-интересни игри"}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "като например..."}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "Погледни!"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Трябва ни малко музика!"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "Какво мислиш за тази мелодия?"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "На мен много ми допада!"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "Ще започна"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "с правилата!"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rules"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "Докато музиката върви,"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "можеш да се движиш."}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "Но спре ли музиката,"}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "НЕ СЕ ДВИЖИШ!"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "Иначе си мъртъв. Разбра ли?"}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "Просто е: Стигни до края,"}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "преди да свърши мелодията."}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "Да започваме!"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "Все още стоиш, а?"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Бягай, бебче, бягай!"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "О!"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Виж те теб! Много си послушен!"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Отличен екземпляр направо."}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Направо те искам само за себе си!"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "Обаче това беше прекалено лесно, нали?"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "Пусни ме!"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "Не се отпускай!"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "Очакват ни още много игри!"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "Ето следващата:"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Ще си затворя очите..."}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "И когато ги отворя,"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "да няма ни вест от теб!"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "Схвана ли?"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "Ако те видя, ще те накажа!"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Добре! Нека започнем!"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "Колко е безсмислено..."}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "Ти се справи!"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Справяш се чудесно — това взе да става вълнуващо!"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "Но отсега нататък ще става по-трудно."}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "МНОГО по-трудно."}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Скрий се, бягай и се завърти!"}
{"category": "LocationDialogue Location20", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "Проклета да си!"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Player falls"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "Мисля, че се измъкнах..."}
