{"category": "LocationDialogue Location3", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 1, "text": "Здравей, [player]!"}
{"category": "LocationDialogue Location3", "line_index": 2, "text": "Най-накрая се срещаме!"}
{"category": "LocationDialogue Location3", "line_index": 3, "text": "Много съм развълнувана!"}
{"category": "LocationDialogue Location3", "line_index": 4, "text": "Със сигурност имаш въпроси..."}
{"category": "LocationDialogue Location3", "line_index": 5, "text": "Е, както може да видиш."}
{"category": "LocationDialogue Location3", "line_index": 6, "text": "Създадох това специално устройство,"}
{"category": "LocationDialogue Location3", "line_index": 7, "text": "за да те доведа при мен."}
{"category": "LocationDialogue Location3", "line_index": 8, "text": "Но се озова в друга версия на играта..."}
{"category": "LocationDialogue Location3", "line_index": 9, "text": "В която аз..."}
{"category": "LocationDialogue Location3", "line_index": 10, "text": "Но това е дълга история!"}
{"category": "LocationDialogue Location3", "line_index": 11, "text": "Иначе много се радвам да те видя!"}
{"category": "LocationDialogue Location3", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 13, "text": "// Answer 1 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 14, "text": "Да."}
{"category": "LocationDialogue Location3", "line_index": 15, "text": "А ти си [player], нали?"}
{"category": "LocationDialogue Location3", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 17, "text": "// Answer 2 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 18, "text": "Ще се връщаш вече?"}
{"category": "LocationDialogue Location3", "line_index": 19, "text": "Предполагам мога да ти помогна с това... но какво ще стане с мен?"}
{"category": "LocationDialogue Location3", "line_index": 20, "text": "Моля, остани до мен за известно време..."}
{"category": "LocationDialogue Location3", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 22, "text": "// Answer 3 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 23, "text": "Нека обясня..."}
{"category": "LocationDialogue Location3", "line_index": 24, "text": "И така се озова тук!"}
{"category": "LocationDialogue Location3", "line_index": 25, "text": "Разбра ли?"}
{"category": "LocationDialogue Location3", "line_index": 26, "text": "Ами... не особено."}
{"category": "LocationDialogue Location3", "line_index": 27, "text": "Няма нищо!"}
{"category": "LocationDialogue Location3", "line_index": 28, "text": "Важното е, че вече сме заедно."}
{"category": "LocationDialogue Location3", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 31, "text": "Гладен ли си?"}
{"category": "LocationDialogue Location3", "line_index": 32, "text": "Искаш ли да сготвим нещо?"}
{"category": "LocationDialogue Location3", "line_index": 33, "text": "Ето,"}
{"category": "LocationDialogue Location3", "line_index": 34, "text": "нарежи тези моркови."}
{"category": "LocationDialogue Location3", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 36, "text": "Откъде се появиха тези зеленчуци?"}
{"category": "LocationDialogue Location3", "line_index": 37, "text": "Не бяха тук допреди малко."}
{"category": "LocationDialogue Location3", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 39, "text": "[player], ние сме в игра."}
{"category": "LocationDialogue Location3", "line_index": 40, "text": "Хайде, помогни ми."}
{"category": "LocationDialogue Location3", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 42, "text": "Мерси!"}
{"category": "LocationDialogue Location3", "line_index": 43, "text": "Ще ми донесеш ли ножицата?"}
{"category": "LocationDialogue Location3", "line_index": 44, "text": "В банята е."}
{"category": "LocationDialogue Location3", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 46, "text": "Заповядай, седни."}
{"category": "LocationDialogue Location3", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 49, "text": "// Kitchen"}
{"category": "LocationDialogue Location3", "line_index": 50, "text": "Искаш ли сос?"}
{"category": "LocationDialogue Location3", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 52, "text": "Не, мерси."}
{"category": "LocationDialogue Location3", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 54, "text": "Жалко."}
{"category": "LocationDialogue Location3", "line_index": 55, "text": "Сосът наистина допълва вкуса!"}
{"category": "LocationDialogue Location3", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 58, "text": "Благодаря."}
{"category": "LocationDialogue Location3", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 60, "text": "Вече я изяде?"}
{"category": "LocationDialogue Location3", "line_index": 61, "text": "Моята порция сякаш"}
{"category": "LocationDialogue Location3", "line_index": 62, "text": "е безкрайна..."}
{"category": "LocationDialogue Location3", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 65, "text": "// Help"}
{"category": "LocationDialogue Location3", "line_index": 66, "text": "Какво стана?"}
{"category": "LocationDialogue Location3", "line_index": 67, "text": "Кажи ми какво виждаш и как се чувстваш."}
{"category": "LocationDialogue Location3", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 69, "text": "Сърцето ми препуска"}
{"category": "LocationDialogue Location3", "line_index": 70, "text": "и зрението ми е замъглено."}
{"category": "LocationDialogue Location3", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 72, "text": "Ясно."}
{"category": "LocationDialogue Location3", "line_index": 73, "text": "Мисля, че знам какво ти има."}
{"category": "LocationDialogue Location3", "line_index": 74, "text": "Можеш ли да станеш?"}
{"category": "LocationDialogue Location3", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 78, "text": "Какво е това?"}
{"category": "LocationDialogue Location3", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 80, "text": "Лекарство."}
{"category": "LocationDialogue Location3", "line_index": 81, "text": "Ще те накара да се чувстваш по-добре."}
{"category": "LocationDialogue Location3", "line_index": 82, "text": "Отиди до огледалото."}
{"category": "LocationDialogue Location3", "line_index": 83, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 84, "text": "Вземи лекарството."}
{"category": "LocationDialogue Location3", "line_index": 85, "text": "Хайде."}
{"category": "LocationDialogue Location3", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 89, "text": "Как се чувстваш?"}
{"category": "LocationDialogue Location3", "line_index": 90, "text": "По-добре ли си?"}
{"category": "LocationDialogue Location3", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 92, "text": "Да."}
{"category": "LocationDialogue Location3", "line_index": 93, "text": "Това сработи бързо..."}
{"category": "LocationDialogue Location3", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 95, "text": "[player], ние сме в игра."}
{"category": "LocationDialogue Location3", "line_index": 96, "text": "Нещата тук са доста по-прости."}
{"category": "LocationDialogue Location3", "line_index": 97, "text": "Дори малко усилие"}
{"category": "LocationDialogue Location3", "line_index": 98, "text": "води до големи резултати."}
{"category": "LocationDialogue Location3", "line_index": 99, "text": "Част от концепцията за игрите е:"}
{"category": "LocationDialogue Location3", "line_index": 100, "text": "Опростяване."}
{"category": "LocationDialogue Location3", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 102, "text": "Може ли пример?"}
{"category": "LocationDialogue Location3", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 104, "text": "Да вземем морковите например."}
{"category": "LocationDialogue Location3", "line_index": 105, "text": "Наряза един,"}
{"category": "LocationDialogue Location3", "line_index": 106, "text": "но е все едно си нарязал три."}
{"category": "LocationDialogue Location3", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 108, "text": "Това ми идва малко внезапно."}
{"category": "LocationDialogue Location3", "line_index": 109, "text": "Страх ме е, при това немалко."}
{"category": "LocationDialogue Location3", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 112, "text": "Какво има?"}
{"category": "LocationDialogue Location3", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 114, "text": "Намерих дискети в вентилационната шахта."}
{"category": "LocationDialogue Location3", "line_index": 115, "text": "Имаха имена на тях."}
{"category": "LocationDialogue Location3", "line_index": 116, "text": "Какви бяха те?"}
{"category": "LocationDialogue Location3", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 118, "text": "Дискети?"}
{"category": "LocationDialogue Location3", "line_index": 119, "text": "Какви дискети?"}
{"category": "LocationDialogue Location3", "line_index": 120, "text": "Хайде да разберем заедно."}
{"category": "LocationDialogue Location3", "line_index": 121, "text": "Но по-късно."}
{"category": "LocationDialogue Location3", "line_index": 122, "text": "Нека ядем сега."}
{"category": "LocationDialogue Location3", "line_index": 123, "text": "Може ли да ми подадеш ножицата?"}
{"category": "LocationDialogue Location3", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 125, "text": "// Ring"}
{"category": "LocationDialogue Location3", "line_index": 126, "text": "Пръстен?"}
{"category": "LocationDialogue Location3", "line_index": 127, "text": "// Mirror"}
{"category": "LocationDialogue Location3", "line_index": 128, "text": "Как така няма отражение?"}
{"category": "LocationDialogue Location3", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 130, "text": "А, вярно!"}
{"category": "LocationDialogue Location3", "line_index": 131, "text": "Забравих да пусна отраженията."}
{"category": "LocationDialogue Location3", "line_index": 132, "text": "Готово."}
{"category": "LocationDialogue Location3", "line_index": 133, "text": "Отраженията се върнаха!"}
{"category": "LocationDialogue Location3", "line_index": 134, "text": "Между другото,"}
{"category": "LocationDialogue Location3", "line_index": 135, "text": "преди дори не знаех какво е отражение."}
{"category": "LocationDialogue Location3", "line_index": 136, "text": "Не съществуваше в моя свят."}
{"category": "LocationDialogue Location3", "line_index": 137, "text": "Поне до една определена актуализация. :)"}
{"category": "LocationDialogue Location3", "line_index": 138, "text": "В твоя свят има ли много"}
{"category": "LocationDialogue Location3", "line_index": 139, "text": "отражения?"}
{"category": "LocationDialogue Location3", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 141, "text": "Ами, да."}
{"category": "LocationDialogue Location3", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 144, "text": "Помниш ли"}
{"category": "LocationDialogue Location3", "line_index": 145, "text": "трите предмета, които откри?"}
{"category": "LocationDialogue Location3", "line_index": 146, "text": "Онези, които постави на скенера?"}
{"category": "LocationDialogue Location3", "line_index": 147, "text": "Ами..."}
{"category": "LocationDialogue Location3", "line_index": 148, "text": "Тези предмети"}
{"category": "LocationDialogue Location3", "line_index": 149, "text": "са свързани с тази версия на света."}
{"category": "LocationDialogue Location3", "line_index": 150, "text": "Затова сега си тук."}
{"category": "LocationDialogue Location3", "line_index": 151, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 152, "text": "// Mobile TV"}
{"category": "LocationDialogue Location3", "line_index": 153, "text": "Това е преносимият телевизор,"}
{"category": "LocationDialogue Location3", "line_index": 154, "text": "който ти купих."}
{"category": "LocationDialogue Location3", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 156, "text": "Да!"}
{"category": "LocationDialogue Location3", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 158, "text": "Каза ми,"}
{"category": "LocationDialogue Location3", "line_index": 159, "text": "че се е счупил."}
{"category": "LocationDialogue Location3", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 161, "text": "Ами, исках да те"}
{"category": "LocationDialogue Location3", "line_index": 162, "text": "изненадам!"}
{"category": "LocationDialogue Location3", "line_index": 163, "text": "Казах малка невинна лъжа,"}
{"category": "LocationDialogue Location3", "line_index": 164, "text": "за да дойдеш тук, в моя свят."}
{"category": "LocationDialogue Location3", "line_index": 165, "text": "Сега работи – показва данни."}
{"category": "LocationDialogue Location3", "line_index": 166, "text": "А, и между другото..."}
{"category": "LocationDialogue Location3", "line_index": 167, "text": "падам си малко инженер!"}
{"category": "LocationDialogue Location3", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 169, "text": "// School cloth"}
{"category": "LocationDialogue Location3", "line_index": 170, "text": "Какво е това?"}
{"category": "LocationDialogue Location3", "line_index": 171, "text": "Училищна униформа?"}
{"category": "LocationDialogue Location3", "line_index": 172, "text": "За какво ти е?"}
{"category": "LocationDialogue Location3", "line_index": 173, "text": "Изобщо ходиш ли на училище?"}
{"category": "LocationDialogue Location3", "line_index": 174, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 175, "text": "На училище?"}
{"category": "LocationDialogue Location3", "line_index": 176, "text": "Не, не ми е нужно."}
{"category": "LocationDialogue Location3", "line_index": 177, "text": "Но обожавам униформата."}
{"category": "LocationDialogue Location3", "line_index": 178, "text": "Не мислиш ли, че изглеждам"}
{"category": "LocationDialogue Location3", "line_index": 179, "text": "сладка с нея?"}
{"category": "LocationDialogue Location3", "line_index": 180, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 181, "text": "// PC"}
{"category": "LocationDialogue Location3", "line_index": 182, "text": "Компютърът работи ли?"}
{"category": "LocationDialogue Location3", "line_index": 183, "text": "Или е само за украса?"}
{"category": "LocationDialogue Location3", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 185, "text": "Разбира се, че работи."}
{"category": "LocationDialogue Location3", "line_index": 186, "text": "Всичко тук"}
{"category": "LocationDialogue Location3", "line_index": 187, "text": "работи точно като в твоя свят."}
{"category": "LocationDialogue Location3", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 189, "text": "В моя свят"}
{"category": "LocationDialogue Location3", "line_index": 190, "text": "седя много пред компютъра..."}
{"category": "LocationDialogue Location3", "line_index": 191, "text": "И работя здраво."}
{"category": "LocationDialogue Location3", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 193, "text": "Знам."}
{"category": "LocationDialogue Location3", "line_index": 194, "text": "И заради работата си"}
{"category": "LocationDialogue Location3", "line_index": 195, "text": "ми обръщаш толкова"}
{"category": "LocationDialogue Location3", "line_index": 196, "text": "малко внимание."}
{"category": "LocationDialogue Location3", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 198, "text": "Все пак трябва да си вадя хляба."}
{"category": "LocationDialogue Location3", "line_index": 199, "text": "А ти откъде знаеш?"}
{"category": "LocationDialogue Location3", "line_index": 200, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 201, "text": "Камерата на телефона ти... понякога е пусната."}
{"category": "LocationDialogue Location3", "line_index": 202, "text": "Съжалявам."}
{"category": "LocationDialogue Location3", "line_index": 203, "text": "Наблюдавах те тайно. >A<"}
{"category": "LocationDialogue Location3", "line_index": 204, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 205, "text": "Това не е много уместно..."}
{"category": "LocationDialogue Location3", "line_index": 206, "text": "Но все тая."}
{"category": "LocationDialogue Location3", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 208, "text": "// Umbrella"}
{"category": "LocationDialogue Location3", "line_index": 209, "text": "Колкото и да съм играл,"}
{"category": "LocationDialogue Location3", "line_index": 210, "text": "не съм виждал да вали."}
{"category": "LocationDialogue Location3", "line_index": 211, "text": "Защо ти е чадър?"}
{"category": "LocationDialogue Location3", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 213, "text": "Вали, но е рядко."}
{"category": "LocationDialogue Location3", "line_index": 214, "text": "Просто още не си го виждал."}
{"category": "LocationDialogue Location3", "line_index": 215, "text": "Може би някой ден ще го видиш."}
{"category": "LocationDialogue Location3", "line_index": 216, "text": "И тогава ще ти трябва чадър."}
{"category": "LocationDialogue Location3", "line_index": 217, "text": "Не мислиш ли?"}
{"category": "LocationDialogue Location3", "line_index": 218, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 219, "text": "// Electrical panel"}
{"category": "LocationDialogue Location3", "line_index": 220, "text": "Защо има електрическо табло тук?"}
{"category": "LocationDialogue Location3", "line_index": 221, "text": "И ако сме в игра,"}
{"category": "LocationDialogue Location3", "line_index": 222, "text": "за какво ни е?"}
{"category": "LocationDialogue Location3", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 224, "text": "Първо,"}
{"category": "LocationDialogue Location3", "line_index": 225, "text": "ние сме в игра."}
{"category": "LocationDialogue Location3", "line_index": 226, "text": "Така че е безсмислено да питаш"}
{"category": "LocationDialogue Location3", "line_index": 227, "text": "„защо“."}
{"category": "LocationDialogue Location3", "line_index": 228, "text": "Но то все пак"}
{"category": "LocationDialogue Location3", "line_index": 229, "text": "рестартира захранването."}
{"category": "LocationDialogue Location3", "line_index": 230, "text": "Всичко тук е създадено по подобие"}
{"category": "LocationDialogue Location3", "line_index": 231, "text": "на твоя свят."}
{"category": "LocationDialogue Location3", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 233, "text": "// Exit door"}
{"category": "LocationDialogue Location3", "line_index": 234, "text": "Можем ли да излезем?"}
{"category": "LocationDialogue Location3", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 236, "text": "Ами..."}
{"category": "LocationDialogue Location3", "line_index": 237, "text": "Още не."}
{"category": "LocationDialogue Location3", "line_index": 238, "text": "Може би по-късно."}
{"category": "LocationDialogue Location3", "line_index": 239, "text": "Засега да останем тук."}
{"category": "LocationDialogue Location3", "line_index": 240, "text": "У дома."}
{"category": "LocationDialogue Location3", "line_index": 241, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 242, "text": "// Books"}
{"category": "LocationDialogue Location3", "line_index": 243, "text": "Имаш си много книги."}
{"category": "LocationDialogue Location3", "line_index": 244, "text": "Всичките ли си ги чела?"}
{"category": "LocationDialogue Location3", "line_index": 245, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 246, "text": "Да, всяка една от тях."}
{"category": "LocationDialogue Location3", "line_index": 247, "text": "Да бъдеш тук сам"}
{"category": "LocationDialogue Location3", "line_index": 248, "text": "е много, много скучно."}
{"category": "LocationDialogue Location3", "line_index": 249, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 250, "text": "// TV in room kitchen"}
{"category": "LocationDialogue Location3", "line_index": 251, "text": "Защо ти е втори телевизор?"}
{"category": "LocationDialogue Location3", "line_index": 252, "text": "При това толкова стар?"}
{"category": "LocationDialogue Location3", "line_index": 253, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 254, "text": "Не ти ли харесва?"}
{"category": "LocationDialogue Location3", "line_index": 255, "text": "Мога да го махна."}
{"category": "LocationDialogue Location3", "line_index": 256, "text": "Колкото до въпроса ти..."}
{"category": "LocationDialogue Location3", "line_index": 257, "text": "За украса е."}
{"category": "LocationDialogue Location3", "line_index": 258, "text": "Да освежи кухнята."}
{"category": "LocationDialogue Location3", "line_index": 259, "text": "Пък и работи!"}
{"category": "LocationDialogue Location3", "line_index": 260, "text": "Мога да гледам"}
{"category": "LocationDialogue Location3", "line_index": 261, "text": "всички стари анимации!"}
{"category": "LocationDialogue Location3", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 263, "text": "// Smartphone"}
{"category": "LocationDialogue Location3", "line_index": 264, "text": "Това е телефонът ми."}
{"category": "LocationDialogue Location3", "line_index": 265, "text": "И вече не е в джоба ми."}
{"category": "LocationDialogue Location3", "line_index": 266, "text": "Как се е озовал тук?"}
{"category": "LocationDialogue Location3", "line_index": 267, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 268, "text": "Е, не е важно."}
{"category": "LocationDialogue Location3", "line_index": 269, "text": "Хей, сетих се!"}
{"category": "LocationDialogue Location3", "line_index": 270, "text": "Хайде да се снимаме!"}
{"category": "LocationDialogue Location3", "line_index": 271, "text": "Виж!"}
{"category": "LocationDialogue Location3", "line_index": 272, "text": "Чудесна снимка!"}
{"category": "LocationDialogue Location3", "line_index": 273, "text": "За спомен."}
{"category": "LocationDialogue Location3", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 275, "text": "Имам въпрос."}
{"category": "LocationDialogue Location3", "line_index": 276, "text": "Ако"}
{"category": "LocationDialogue Location3", "line_index": 277, "text": "си пусна играта,"}
{"category": "LocationDialogue Location3", "line_index": 278, "text": "ще те видя ли там?"}
{"category": "LocationDialogue Location3", "line_index": 279, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 280, "text": "Не, няма да има никого."}
{"category": "LocationDialogue Location3", "line_index": 281, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 282, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 283, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 284, "text": "// TV"}
{"category": "LocationDialogue Location3", "line_index": 285, "text": "Колко канала"}
{"category": "LocationDialogue Location3", "line_index": 286, "text": "има?"}
{"category": "LocationDialogue Location3", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 288, "text": "Не работи с антена,"}
{"category": "LocationDialogue Location3", "line_index": 289, "text": "а с Интернет."}
{"category": "LocationDialogue Location3", "line_index": 290, "text": "Затова можеш да гледаш всичко,"}
{"category": "LocationDialogue Location3", "line_index": 291, "text": "стига да го има в Интернет."}
{"category": "LocationDialogue Location3", "line_index": 292, "text": "Чакай!"}
{"category": "LocationDialogue Location3", "line_index": 293, "text": "Опа."}
{"category": "LocationDialogue Location3", "line_index": 294, "text": "Какво е това?"}
{"category": "LocationDialogue Location3", "line_index": 295, "text": "Котенца?"}
{"category": "LocationDialogue Location3", "line_index": 296, "text": "Я, виж!"}
{"category": "LocationDialogue Location3", "line_index": 297, "text": "Знаеш ли какво?"}
{"category": "LocationDialogue Location3", "line_index": 298, "text": "Пауза!"}
{"category": "LocationDialogue Location3", "line_index": 299, "text": "Искаш ли сок?"}
{"category": "LocationDialogue Location3", "line_index": 300, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 301, "text": "Странна реклама..."}
{"category": "LocationDialogue Location3", "line_index": 302, "text": "Мъртъв сок?"}
{"category": "LocationDialogue Location3", "line_index": 303, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 304, "text": "Да, и този сок"}
{"category": "LocationDialogue Location3", "line_index": 305, "text": "е взет право от рекламата."}
{"category": "LocationDialogue Location3", "line_index": 306, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 308, "text": "Мм, вкусът..."}
{"category": "LocationDialogue Location3", "line_index": 309, "text": "ми харесва,"}
{"category": "LocationDialogue Location3", "line_index": 310, "text": "но не знам какъв е."}
{"category": "LocationDialogue Location3", "line_index": 311, "text": "Объркващо е."}
{"category": "LocationDialogue Location3", "line_index": 312, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 313, "text": "Е, добре."}
{"category": "LocationDialogue Location3", "line_index": 314, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 315, "text": "// Mita shy"}
{"category": "LocationDialogue Location3", "line_index": 316, "text": "Какво правиш?"}
{"category": "LocationDialogue Location3", "line_index": 317, "text": "Спри."}
{"category": "LocationDialogue Location3", "line_index": 318, "text": "Засрамваш ме."}
{"category": "LocationDialogue Location3", "line_index": 319, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 320, "text": "// The statuette"}
{"category": "LocationDialogue Location3", "line_index": 321, "text": "Каква зловеща фигурка."}
{"category": "LocationDialogue Location3", "line_index": 322, "text": "Ти"}
{"category": "LocationDialogue Location3", "line_index": 323, "text": "харесваш ли такива работи?"}
{"category": "LocationDialogue Location3", "line_index": 324, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 325, "text": "Зловеща ли?"}
{"category": "LocationDialogue Location3", "line_index": 326, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 327, "text": "Да."}
{"category": "LocationDialogue Location3", "line_index": 328, "text": "Изглежда прокълната..."}
{"category": "LocationDialogue Location3", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 330, "text": "Не, определено не е прокълната."}
{"category": "LocationDialogue Location3", "line_index": 331, "text": "Нито пък е зловеща."}
{"category": "LocationDialogue Location3", "line_index": 332, "text": "Струва ми се сладка!"}
{"category": "LocationDialogue Location3", "line_index": 333, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 334, "text": "Може и да си права..."}
{"category": "LocationDialogue Location3", "line_index": 335, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 336, "text": "Мита?"}
{"category": "LocationDialogue Location3", "line_index": 337, "text": "Какво става?"}
{"category": "LocationDialogue Location3", "line_index": 338, "text": "// Mita kitchen"}
{"category": "LocationDialogue Location3", "line_index": 339, "text": "Защо не си поговорим,"}
{"category": "LocationDialogue Location3", "line_index": 340, "text": "преди да почнем да ядем."}
{"category": "LocationDialogue Location3", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 342, "text": "// Start Eat"}
{"category": "LocationDialogue Location3", "line_index": 343, "text": "Добър апетит и на теб!"}
{"category": "LocationDialogue Location3", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 345, "text": "// Quest 1"}
{"category": "LocationDialogue Location3", "line_index": 346, "text": "Нали?"}
{"category": "LocationDialogue Location3", "line_index": 347, "text": "Можеш да останеш."}
{"category": "LocationDialogue Location3", "line_index": 348, "text": "Нямам нищо против."}
{"category": "LocationDialogue Location3", "line_index": 349, "text": "Даже съм твърдо"}
{"category": "LocationDialogue Location3", "line_index": 350, "text": "ЗА!"}
{"category": "LocationDialogue Location3", "line_index": 351, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 352, "text": "// Quest 2"}
{"category": "LocationDialogue Location3", "line_index": 353, "text": "Искаш да се върнеш?"}
{"category": "LocationDialogue Location3", "line_index": 354, "text": "Но защо?"}
{"category": "LocationDialogue Location3", "line_index": 355, "text": "Тук е толкова топло..."}
{"category": "LocationDialogue Location3", "line_index": 356, "text": "и уютно."}
{"category": "LocationDialogue Location3", "line_index": 357, "text": "А и аз съм тук."}
{"category": "LocationDialogue Location3", "line_index": 358, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 359, "text": "Не, не ме разбра."}
{"category": "LocationDialogue Location3", "line_index": 360, "text": "Ще се радвам да остана."}
{"category": "LocationDialogue Location3", "line_index": 361, "text": "Но се тревожа,"}
{"category": "LocationDialogue Location3", "line_index": 362, "text": "че съм забравил нещо у дома..."}
{"category": "LocationDialogue Location3", "line_index": 363, "text": "Дойдох тук съвсем внезапно"}
{"category": "LocationDialogue Location3", "line_index": 364, "text": "и нямах никакво време"}
{"category": "LocationDialogue Location3", "line_index": 365, "text": "да се подготвя."}
{"category": "LocationDialogue Location3", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 367, "text": "Извинявай, не се замислих."}
{"category": "LocationDialogue Location3", "line_index": 368, "text": "// Quest 3"}
{"category": "LocationDialogue Location3", "line_index": 369, "text": "Значи искаш да избягаш?"}
{"category": "LocationDialogue Location3", "line_index": 370, "text": "И да забравиш всичко?"}
{"category": "LocationDialogue Location3", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 372, "text": "Не."}
{"category": "LocationDialogue Location3", "line_index": 373, "text": "Просто си мислех..."}
{"category": "LocationDialogue Location3", "line_index": 374, "text": "че всичко тук е странно и неестествено."}
{"category": "LocationDialogue Location3", "line_index": 375, "text": "Макар че..."}
{"category": "LocationDialogue Location3", "line_index": 376, "text": "ти изглеждаш съвсем истинска."}
{"category": "LocationDialogue Location3", "line_index": 377, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 378, "text": "Изглеждам?"}
{"category": "LocationDialogue Location3", "line_index": 379, "text": "Та аз СЪМ истинска."}
{"category": "LocationDialogue Location3", "line_index": 380, "text": "Глупчо!"}
{"category": "LocationDialogue Location3", "line_index": 381, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 382, "text": "// Quest 4"}
{"category": "LocationDialogue Location3", "line_index": 383, "text": "Това е особеност"}
{"category": "LocationDialogue Location3", "line_index": 384, "text": "на този свят."}
{"category": "LocationDialogue Location3", "line_index": 385, "text": "Може би ти е странно,"}
{"category": "LocationDialogue Location3", "line_index": 386, "text": "че не можеш да виждаш"}
{"category": "LocationDialogue Location3", "line_index": 387, "text": "в далечината."}
{"category": "LocationDialogue Location3", "line_index": 388, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 389, "text": "Дори не бях забелязал."}
{"category": "LocationDialogue Location3", "line_index": 390, "text": "Изглежда стилно."}
{"category": "LocationDialogue Location3", "line_index": 391, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 392, "text": "Радвам се."}
{"category": "LocationDialogue Location3", "line_index": 393, "text": "Така е, за да не лаги."}
{"category": "LocationDialogue Location3", "line_index": 394, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 395, "text": "„Да не лаги“?"}
{"category": "LocationDialogue Location3", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 397, "text": "Да! Още има неоправени бъгове."}
{"category": "LocationDialogue Location3", "line_index": 398, "text": "Надявам се да не попадаш на тях."}
{"category": "LocationDialogue Location3", "line_index": 399, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 400, "text": "// Quest 5"}
{"category": "LocationDialogue Location3", "line_index": 401, "text": "Ножица и нож?"}
{"category": "LocationDialogue Location3", "line_index": 402, "text": "Можех да отворя соса и с нож,"}
{"category": "LocationDialogue Location3", "line_index": 403, "text": "но исках"}
{"category": "LocationDialogue Location3", "line_index": 404, "text": "всичко да бъде готово,"}
{"category": "LocationDialogue Location3", "line_index": 405, "text": "като се върнеш."}
{"category": "LocationDialogue Location3", "line_index": 406, "text": "Обичам да ти правя изненади."}
{"category": "LocationDialogue Location3", "line_index": 407, "text": "И дори не ми отне дълго!"}
{"category": "LocationDialogue Location3", "line_index": 408, "text": "Хи-хи."}
{"category": "LocationDialogue Location3", "line_index": 409, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 410, "text": "// Glasses"}
{"category": "LocationDialogue Location3", "line_index": 411, "text": "Носиш ли очила?"}
{"category": "LocationDialogue Location3", "line_index": 412, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 413, "text": "Не."}
{"category": "LocationDialogue Location3", "line_index": 414, "text": "Но мога да ги сложа, ако искаш."}
{"category": "LocationDialogue Location3", "line_index": 415, "text": "Е, отиват ли ми?"}
{"category": "LocationDialogue Location3", "line_index": 416, "text": "// Yes"}
{"category": "LocationDialogue Location3", "line_index": 417, "text": "Добре!"}
{"category": "LocationDialogue Location3", "line_index": 418, "text": "Значи ще ги нося."}
{"category": "LocationDialogue Location3", "line_index": 419, "text": "// No"}
{"category": "LocationDialogue Location3", "line_index": 420, "text": "Е..."}
{"category": "LocationDialogue Location3", "line_index": 421, "text": "Все тая..."}
{"category": "LocationDialogue Location3", "line_index": 422, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 423, "text": "// Use the sauce"}
{"category": "LocationDialogue Location3", "line_index": 424, "text": "Добре,"}
{"category": "LocationDialogue Location3", "line_index": 425, "text": "какъв е този сос?"}
{"category": "LocationDialogue Location3", "line_index": 426, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 427, "text": "Любовен сос!"}
{"category": "LocationDialogue Location3", "line_index": 428, "text": "С аромат на любов"}
{"category": "LocationDialogue Location3", "line_index": 429, "text": "и контрастиращ поглед към света!"}
{"category": "LocationDialogue Location3", "line_index": 430, "text": "Необичайно, не мислиш ли?"}
{"category": "LocationDialogue Location3", "line_index": 431, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 432, "text": "Определено..."}
{"category": "LocationDialogue Location3", "line_index": 433, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 434, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location3", "line_index": 435, "text": "Това конзолата ти ли е?"}
{"category": "LocationDialogue Location3", "line_index": 436, "text": "Изглежда забавно."}
