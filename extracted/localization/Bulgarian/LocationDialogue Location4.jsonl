{"category": "LocationDialogue Location4", "line_index": 0, "text": "Мита?"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "О, вече си буден?"}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "Как се озова тук?"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": "Беше зад мен допреди малко."}
{"category": "LocationDialogue Location4", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 5, "text": "Не, не бях."}
{"category": "LocationDialogue Location4", "line_index": 6, "text": "Беше забил пред огледалото."}
{"category": "LocationDialogue Location4", "line_index": 7, "text": "Затова се махнах."}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "Защо стаите са се променили?"}
{"category": "LocationDialogue Location4", "line_index": 9, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "Пренаредих мястото,"}
{"category": "LocationDialogue Location4", "line_index": 11, "text": "за да се чувстваш като у дома."}
{"category": "LocationDialogue Location4", "line_index": 12, "text": "Тоест"}
{"category": "LocationDialogue Location4", "line_index": 13, "text": "можем да променяме стаите"}
{"category": "LocationDialogue Location4", "line_index": 14, "text": "както пожелаем."}
{"category": "LocationDialogue Location4", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 16, "text": "Нямаше нужда."}
{"category": "LocationDialogue Location4", "line_index": 17, "text": "Тъкмо почнах да свиквам."}
{"category": "LocationDialogue Location4", "line_index": 18, "text": "Но смятам, че така повече ще ти допадне. // "}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Mita card game"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "Добре,"}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "да поиграем?"}
{"category": "LocationDialogue Location4", "line_index": 22, "text": "Играта работи по следния начин."}
{"category": "LocationDialogue Location4", "line_index": 23, "text": "Чипът показва вида,"}
{"category": "LocationDialogue Location4", "line_index": 24, "text": "като живот:"}
{"category": "LocationDialogue Location4", "line_index": 25, "text": "Двамата играем карта"}
{"category": "LocationDialogue Location4", "line_index": 26, "text": "и ако твоята има по-високи"}
{"category": "LocationDialogue Location4", "line_index": 27, "text": "точки живот"}
{"category": "LocationDialogue Location4", "line_index": 28, "text": "от моята,"}
{"category": "LocationDialogue Location4", "line_index": 29, "text": "ти печелиш."}
{"category": "LocationDialogue Location4", "line_index": 30, "text": "Вземи си картите."}
{"category": "LocationDialogue Location4", "line_index": 31, "text": "Мой ред е."}
{"category": "LocationDialogue Location4", "line_index": 32, "text": "Еха!"}
{"category": "LocationDialogue Location4", "line_index": 33, "text": "Каква ръка ми се падна само!"}
{"category": "LocationDialogue Location4", "line_index": 34, "text": "Аз ще съм първа!"}
{"category": "LocationDialogue Location4", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 44, "text": "Добре!"}
{"category": "LocationDialogue Location4", "line_index": 45, "text": "Твой ход!"}
{"category": "LocationDialogue Location4", "line_index": 46, "text": "Мхм."}
{"category": "LocationDialogue Location4", "line_index": 47, "text": "Твой ред!"}
{"category": "LocationDialogue Location4", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 49, "text": "Най-високите точки живот печелят!"}
{"category": "LocationDialogue Location4", "line_index": 50, "text": "Този път основното е атака!"}
{"category": "LocationDialogue Location4", "line_index": 51, "text": "Сега гледаме защита!"}
{"category": "LocationDialogue Location4", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 54, "text": "Ти спечели!"}
{"category": "LocationDialogue Location4", "line_index": 55, "text": "Ти спечели!"}
{"category": "LocationDialogue Location4", "line_index": 56, "text": "Победи ме."}
{"category": "LocationDialogue Location4", "line_index": 57, "text": "Ах, ти..."}
{"category": "LocationDialogue Location4", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 59, "text": "Аз печеля!"}
{"category": "LocationDialogue Location4", "line_index": 60, "text": "Победата е моя!"}
{"category": "LocationDialogue Location4", "line_index": 61, "text": "Аз печеля!"}
{"category": "LocationDialogue Location4", "line_index": 62, "text": "Направо те схрусках!"}
{"category": "LocationDialogue Location4", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 64, "text": "Равенство."}
{"category": "LocationDialogue Location4", "line_index": 65, "text": "Равни са!"}
{"category": "LocationDialogue Location4", "line_index": 66, "text": "Това е равенство!"}
{"category": "LocationDialogue Location4", "line_index": 67, "text": "Еднаква стойност..."}
{"category": "LocationDialogue Location4", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 79, "text": "// The card game is interrupted"}
{"category": "LocationDialogue Location4", "line_index": 80, "text": "Какъв е онзи звук?"}
{"category": "LocationDialogue Location4", "line_index": 81, "text": "Идва от гардероба."}
{"category": "LocationDialogue Location4", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 83, "text": "Звук?"}
{"category": "LocationDialogue Location4", "line_index": 84, "text": "Какъв звук?"}
{"category": "LocationDialogue Location4", "line_index": 85, "text": "Аз нищо не чух."}
{"category": "LocationDialogue Location4", "line_index": 86, "text": "Какво смяташ, че се чу?"}
{"category": "LocationDialogue Location4", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 88, "text": "Чукане, сякаш има някой там."}
{"category": "LocationDialogue Location4", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 90, "text": "Но..."}
{"category": "LocationDialogue Location4", "line_index": 91, "text": "Няма никого там..."}
{"category": "LocationDialogue Location4", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 93, "text": "Искам да отворя и да проверя."}
{"category": "LocationDialogue Location4", "line_index": 94, "text": "Леко ме плаши."}
{"category": "LocationDialogue Location4", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 96, "text": "Но защо...?"}
{"category": "LocationDialogue Location4", "line_index": 97, "text": "Пак това..."}
{"category": "LocationDialogue Location4", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 105, "text": "Какво ти има!?"}
{"category": "LocationDialogue Location4", "line_index": 106, "text": "Просто гардероб е..."}
{"category": "LocationDialogue Location4", "line_index": 107, "text": "Там си държа бельото...!"}
{"category": "LocationDialogue Location4", "line_index": 108, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 109, "text": "Криеш ли нещо от мен?"}
{"category": "LocationDialogue Location4", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 111, "text": "Защо просто не ми повярваш?"}
{"category": "LocationDialogue Location4", "line_index": 112, "text": "Къде сгреших?"}
{"category": "LocationDialogue Location4", "line_index": 113, "text": "Просто искам..."}
{"category": "LocationDialogue Location4", "line_index": 114, "text": "Единствено искам да бъдеш с мен."}
{"category": "LocationDialogue Location4", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 116, "text": "И аз бих искал, но все пак...?"}
{"category": "LocationDialogue Location4", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 118, "text": "Защо толкова те влече гардероба?!"}
{"category": "LocationDialogue Location4", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 120, "text": "Просто искам да разбера какъв беше този звук!"}
{"category": "LocationDialogue Location4", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 122, "text": "Да не би да е защото"}
{"category": "LocationDialogue Location4", "line_index": 123, "text": "този свят"}
{"category": "LocationDialogue Location4", "line_index": 124, "text": "има само четири стаи?"}
{"category": "LocationDialogue Location4", "line_index": 125, "text": "Не ти ли стигат?"}
{"category": "LocationDialogue Location4", "line_index": 126, "text": "Защо просто не останеш с мен?"}
{"category": "LocationDialogue Location4", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 129, "text": "// Don't stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 130, "text": "Разбирам."}
{"category": "LocationDialogue Location4", "line_index": 131, "text": "Пак това..."}
{"category": "LocationDialogue Location4", "line_index": 132, "text": "Ако толкова искаш да провериш гардероба,"}
{"category": "LocationDialogue Location4", "line_index": 133, "text": "тогава давай,"}
{"category": "LocationDialogue Location4", "line_index": 134, "text": "разбери какво има вътре!"}
{"category": "LocationDialogue Location4", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 139, "text": "Какво по..."}
{"category": "LocationDialogue Location4", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 141, "text": "Това се случва понякога."}
{"category": "LocationDialogue Location4", "line_index": 142, "text": "Стаята е забила и още зарежда."}
{"category": "LocationDialogue Location4", "line_index": 143, "text": "Изчакай малко."}
{"category": "LocationDialogue Location4", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 145, "text": "Толкова е странно."}
{"category": "LocationDialogue Location4", "line_index": 146, "text": "Да не сме в нечий телефон?"}
{"category": "LocationDialogue Location4", "line_index": 147, "text": "Някакъв, който зарежда бавно?"}
{"category": "LocationDialogue Location4", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 149, "text": "Не, изобщо."}
{"category": "LocationDialogue Location4", "line_index": 150, "text": "Но не всичко е перфектно "}
{"category": "LocationDialogue Location4", "line_index": 151, "text": "в този свят..."}
{"category": "LocationDialogue Location4", "line_index": 152, "text": "Зареждат ни"}
{"category": "LocationDialogue Location4", "line_index": 153, "text": "зааедно с ядрото на света."}
{"category": "LocationDialogue Location4", "line_index": 154, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 155, "text": "Ядрото на света?"}
{"category": "LocationDialogue Location4", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 157, "text": "Типично, не мислиш ли?"}
{"category": "LocationDialogue Location4", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 159, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 161, "text": "Иначе можем"}
{"category": "LocationDialogue Location4", "line_index": 162, "text": "да играем на конзолни игри"}
{"category": "LocationDialogue Location4", "line_index": 163, "text": "или на карти."}
{"category": "LocationDialogue Location4", "line_index": 164, "text": "Избери."}
{"category": "LocationDialogue Location4", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 167, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 168, "text": "// Mita play fight"}
{"category": "LocationDialogue Location4", "line_index": 169, "text": "Да се бием?"}
{"category": "LocationDialogue Location4", "line_index": 170, "text": "Трябва да спечелиш"}
{"category": "LocationDialogue Location4", "line_index": 171, "text": "четири пъти."}
{"category": "LocationDialogue Location4", "line_index": 172, "text": "Ела ми."}
{"category": "LocationDialogue Location4", "line_index": 173, "text": "Не се тревожи,"}
{"category": "LocationDialogue Location4", "line_index": 174, "text": "първия път ще те щадя."}
{"category": "LocationDialogue Location4", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 176, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 177, "text": "Поздравления."}
{"category": "LocationDialogue Location4", "line_index": 178, "text": "Сега гледай да внимаваш!"}
{"category": "LocationDialogue Location4", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 180, "text": "Еха!"}
{"category": "LocationDialogue Location4", "line_index": 181, "text": "Добре, добре."}
{"category": "LocationDialogue Location4", "line_index": 182, "text": "Сега вече ще съм сериозна."}
{"category": "LocationDialogue Location4", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 184, "text": "Уау!"}
{"category": "LocationDialogue Location4", "line_index": 185, "text": "Да видим дали ще можеш"}
{"category": "LocationDialogue Location4", "line_index": 186, "text": "да ме биеш сега!"}
{"category": "LocationDialogue Location4", "line_index": 187, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 188, "text": "Ти си"}
{"category": "LocationDialogue Location4", "line_index": 189, "text": "направо"}
{"category": "LocationDialogue Location4", "line_index": 190, "text": "невероятен! Какви умения само!"}
{"category": "LocationDialogue Location4", "line_index": 191, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 193, "text": "Какво стана?"}
{"category": "LocationDialogue Location4", "line_index": 194, "text": "Това е скучно."}
{"category": "LocationDialogue Location4", "line_index": 195, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 196, "text": "Е,"}
{"category": "LocationDialogue Location4", "line_index": 197, "text": "това беше всичко. Вярваш ли в съдбата?"}
{"category": "LocationDialogue Location4", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 199, "text": "Тогава"}
{"category": "LocationDialogue Location4", "line_index": 200, "text": "се вземи в ръце, иначе винаги ще бъдеш загубеняк!"}
{"category": "LocationDialogue Location4", "line_index": 201, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 202, "text": "Какво ти има днес?"}
{"category": "LocationDialogue Location4", "line_index": 203, "text": "Направо те смазах!"}
{"category": "LocationDialogue Location4", "line_index": 204, "text": "Не даде всичко от себе си—"}
{"category": "LocationDialogue Location4", "line_index": 205, "text": "затова спечелих!"}
{"category": "LocationDialogue Location4", "line_index": 206, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 208, "text": "Добре."}
{"category": "LocationDialogue Location4", "line_index": 209, "text": "Защо не поиграем на карти?"}
{"category": "LocationDialogue Location4", "line_index": 210, "text": "В спалнята са."}
{"category": "LocationDialogue Location4", "line_index": 211, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 214, "text": "// Door > [ERROR]"}
{"category": "LocationDialogue Location4", "line_index": 215, "text": "А? Какво се случва?"}
{"category": "LocationDialogue Location4", "line_index": 216, "text": "Къде е..."}
{"category": "LocationDialogue Location4", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 218, "text": "Опа."}
{"category": "LocationDialogue Location4", "line_index": 219, "text": "Съжалявам..."}
{"category": "LocationDialogue Location4", "line_index": 220, "text": "Изтеглих нещо"}
{"category": "LocationDialogue Location4", "line_index": 221, "text": "от Интернет."}
{"category": "LocationDialogue Location4", "line_index": 222, "text": "Исках да разкрася"}
{"category": "LocationDialogue Location4", "line_index": 223, "text": "отвън малко."}
{"category": "LocationDialogue Location4", "line_index": 224, "text": "Но явно"}
{"category": "LocationDialogue Location4", "line_index": 225, "text": "му е имало нещо на файла."}
{"category": "LocationDialogue Location4", "line_index": 226, "text": "По-късно ще го оправя."}
{"category": "LocationDialogue Location4", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 228, "text": "Затова ли не можем да излезем от къщата?"}
{"category": "LocationDialogue Location4", "line_index": 229, "text": "Да, точно така."}
{"category": "LocationDialogue Location4", "line_index": 230, "text": "// Mita shy"}
{"category": "LocationDialogue Location4", "line_index": 231, "text": "Хей..."}
{"category": "LocationDialogue Location4", "line_index": 232, "text": "Какво ти има?"}
{"category": "LocationDialogue Location4", "line_index": 233, "text": "Искаш ли нещо?"}
{"category": "LocationDialogue Location4", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 236, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 237, "text": "// Wall Clock"}
{"category": "LocationDialogue Location4", "line_index": 238, "text": "Този часовник"}
{"category": "LocationDialogue Location4", "line_index": 239, "text": "кое време показва?"}
{"category": "LocationDialogue Location4", "line_index": 240, "text": "Текущото време в играта?"}
{"category": "LocationDialogue Location4", "line_index": 241, "text": "Или е синхронизиран с телефона ми?"}
{"category": "LocationDialogue Location4", "line_index": 242, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 243, "text": "А, ами..."}
{"category": "LocationDialogue Location4", "line_index": 244, "text": "Честно казано, не знам."}
{"category": "LocationDialogue Location4", "line_index": 245, "text": "Но времето тук няма значение..."}
{"category": "LocationDialogue Location4", "line_index": 246, "text": "Независимо дали е късно или рано,"}
{"category": "LocationDialogue Location4", "line_index": 247, "text": "едно силно момиче като мен"}
{"category": "LocationDialogue Location4", "line_index": 248, "text": "е винаги изпълнено с енергия—"}
{"category": "LocationDialogue Location4", "line_index": 249, "text": "Никога не се уморявам!"}
{"category": "LocationDialogue Location4", "line_index": 250, "text": "Можем да имаме вечна пролет"}
{"category": "LocationDialogue Location4", "line_index": 251, "text": "или пък безкраен следобед!"}
{"category": "LocationDialogue Location4", "line_index": 252, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 253, "text": "Tова е интересно..."}
{"category": "LocationDialogue Location4", "line_index": 254, "text": "но и донякъде зловещо."}
{"category": "LocationDialogue Location4", "line_index": 255, "text": "Да сме заседнали в същия миг завинаги..."}
{"category": "LocationDialogue Location4", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 258, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 259, "text": "// Photos of Mita"}
{"category": "LocationDialogue Location4", "line_index": 260, "text": "Хубави снимки."}
{"category": "LocationDialogue Location4", "line_index": 261, "text": "Предполагам са твои?"}
{"category": "LocationDialogue Location4", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 263, "text": "Да."}
{"category": "LocationDialogue Location4", "line_index": 264, "text": "И аз ги харесвам."}
{"category": "LocationDialogue Location4", "line_index": 265, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 266, "text": "Кой ги е заснел?"}
{"category": "LocationDialogue Location4", "line_index": 267, "text": "Има ли други в този свят?"}
{"category": "LocationDialogue Location4", "line_index": 268, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 269, "text": "Може да се каже."}
{"category": "LocationDialogue Location4", "line_index": 270, "text": "Евентуално ще те запозная."}
{"category": "LocationDialogue Location4", "line_index": 271, "text": "Но още не."}
{"category": "LocationDialogue Location4", "line_index": 272, "text": "Засега искам да съм сама с теб."}
{"category": "LocationDialogue Location4", "line_index": 273, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 275, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 276, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 277, "text": "// Portal"}
{"category": "LocationDialogue Location4", "line_index": 278, "text": "Къде отиде порталът?"}
{"category": "LocationDialogue Location4", "line_index": 279, "text": "Или както го наричаше там?"}
{"category": "LocationDialogue Location4", "line_index": 280, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 281, "text": "По мое желание"}
{"category": "LocationDialogue Location4", "line_index": 282, "text": "направих малка магия"}
{"category": "LocationDialogue Location4", "line_index": 283, "text": "и го преместих"}
{"category": "LocationDialogue Location4", "line_index": 284, "text": "някъде другаде."}
{"category": "LocationDialogue Location4", "line_index": 285, "text": "Нямаме нужда от него вече."}
{"category": "LocationDialogue Location4", "line_index": 286, "text": "Само би ни пречил."}
{"category": "LocationDialogue Location4", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 288, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 289, "text": "// Mirror in the bedroom"}
{"category": "LocationDialogue Location4", "line_index": 290, "text": "Да гледаш огледало,"}
{"category": "LocationDialogue Location4", "line_index": 291, "text": "без да виждаш отражение – зловещо е."}
{"category": "LocationDialogue Location4", "line_index": 292, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 293, "text": "Можем да пуснем отраженията,"}
{"category": "LocationDialogue Location4", "line_index": 294, "text": "ако толкова искаш."}
{"category": "LocationDialogue Location4", "line_index": 295, "text": "Но наистина ли ни трябват?"}
{"category": "LocationDialogue Location4", "line_index": 296, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 297, "text": "Разбира се, че трябват."}
{"category": "LocationDialogue Location4", "line_index": 298, "text": "Или пък... да не би включването да има последствия?"}
{"category": "LocationDialogue Location4", "line_index": 299, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 300, "text": "Да."}
{"category": "LocationDialogue Location4", "line_index": 301, "text": "Ще забиваме и ще се движим по-бавно."}
{"category": "LocationDialogue Location4", "line_index": 302, "text": "Виждал ли си анимация с ниска честота на кадрите?"}
{"category": "LocationDialogue Location4", "line_index": 303, "text": "Така ще бъдем и ние, но постоянно."}
{"category": "LocationDialogue Location4", "line_index": 304, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 305, "text": "Ясно."}
{"category": "LocationDialogue Location4", "line_index": 306, "text": "В такъв случай може да държим отраженията изключени..."}
{"category": "LocationDialogue Location4", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 308, "text": "Хей, [player],"}
{"category": "LocationDialogue Location4", "line_index": 309, "text": "нещо май много харесваш огледала."}
{"category": "LocationDialogue Location4", "line_index": 310, "text": "Да не се боиш, че ще се появи усмивка на лицето ти?"}
{"category": "LocationDialogue Location4", "line_index": 311, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 312, "text": "А? Не особено..."}
{"category": "LocationDialogue Location4", "line_index": 313, "text": "Просто съм изморен"}
{"category": "LocationDialogue Location4", "line_index": 314, "text": "след всичката работа."}
{"category": "LocationDialogue Location4", "line_index": 315, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 316, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 317, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 318, "text": "// Blue sneakers"}
{"category": "LocationDialogue Location4", "line_index": 319, "text": "Това твоите ли са?"}
{"category": "LocationDialogue Location4", "line_index": 320, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 321, "text": "Не, твои са."}
{"category": "LocationDialogue Location4", "line_index": 322, "text": "Не помниш ли?"}
{"category": "LocationDialogue Location4", "line_index": 323, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 324, "text": "Не помня да имам такива маратонки."}
{"category": "LocationDialogue Location4", "line_index": 325, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 326, "text": "Вече имаш."}
{"category": "LocationDialogue Location4", "line_index": 327, "text": "Можеш да ги носиш,"}
{"category": "LocationDialogue Location4", "line_index": 328, "text": "когато излезем навън."}
{"category": "LocationDialogue Location4", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 330, "text": "Ами дрехите?"}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "В този свят единствено имам"}
{"category": "LocationDialogue Location4", "line_index": 332, "text": "тези дрехи, които нося сега."}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "Има ли как да взема нови?"}
{"category": "LocationDialogue Location4", "line_index": 334, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 335, "text": "Разбира се, че има."}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "Обаче съм виждала какви ги носиш—"}
{"category": "LocationDialogue Location4", "line_index": 337, "text": "и честно казано, нямаш добър вкус."}
{"category": "LocationDialogue Location4", "line_index": 338, "text": "Но ще ти помогна да си вземеш."}
{"category": "LocationDialogue Location4", "line_index": 339, "text": "Просто не сега."}
{"category": "LocationDialogue Location4", "line_index": 340, "text": "Обещавам ти."}
{"category": "LocationDialogue Location4", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 342, "text": "Добре."}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Games on TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "Какво ти се играе?"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Game milk"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "В тази игра се бием!"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "Да видим кой ще се вкисне първи!"}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "Каква игра само!"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": "Стига толкова мляко засега, нека играем на нещо друго."}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Game penguins"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "В тази игра си пингвин"}
{"category": "LocationDialogue Location4", "line_index": 354, "text": "и се пързаляш."}
{"category": "LocationDialogue Location4", "line_index": 355, "text": "Вече сме играли тази игра."}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "Чакай, какво?"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "Сериозен ли си? Смятах, че..."}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "Много съм щастлива!"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "И леко объркана..."}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "Но..."}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "Моля, остани с мен—"}
{"category": "LocationDialogue Location4", "line_index": 364, "text": "завинаги."}
{"category": "LocationDialogue Location4", "line_index": 365, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 367, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 368, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 369, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 370, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 372, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 373, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 374, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 375, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 376, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 377, "text": "// A game about penguins"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "Супер проста е:"}
{"category": "LocationDialogue Location4", "line_index": 379, "text": "просто събираш снежни топки."}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "Който събере повече, печели!"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "Да изиграем два рунда?"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// The first map"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "Еха, как събра толкова много?"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "Опа! Май нещо събрах повече снежни топки!"}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "Трябва да ме настигнеш!"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "Ха, 1:1!"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// The second map"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "Направо си роден да бъдеш пингвин!"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "Трябва да те видим на истински лед!"}
{"category": "LocationDialogue Location4", "line_index": 390, "text": "Пф, много си бавен."}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "Да не си останал в предишния рунд?"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "Еха, равенство! Много рядко се случва!"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// The game is over"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "Добре, искаш ли да играем на нещо друго?"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "Или ти стига толкова?"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "За какво ти е тази конзола?"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "Толкова ли си пристрастен към игрите?"}
