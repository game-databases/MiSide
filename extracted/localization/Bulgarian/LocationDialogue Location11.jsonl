{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Здравей!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Опа!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Съжалявам,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "за малко да те убия."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Ъм...Имах предвид хладилникът..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "Хладилникът почти не те уби."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Аз нямах нищо общо,"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "заклевам се!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Ама наистина!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Направо ти повярвах!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Но наистина,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "това място е опасно..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "особено за теб."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "Не си страливец, а?"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Интересно е да те наблюдавам"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "как преминаваш"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "през тези места..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Бягай, бебчо, бягай!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "Ще те настигна!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "А така!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Много е забавно!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Гледах как вървиш към влака."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "Това е най-дългият път"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "между версиите..."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Как ли ще се справиш"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "с онези, живеещи"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "в мъглата."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Какви ги правиш?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Моля те..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Не гледай!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Глупак!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Глупчо..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Ъм, добре..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Успех!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Кой е там?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Усещам те..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Изслушай ме."}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "Ти си играч,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "нали?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Помогни ми да намеря..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "да намеря..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "Чакай да помисля..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "умът ми е празен..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Какво, по дяволите, се случва тук?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Едно време исках да забравя всичко..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Счупих всичките огледала,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "разкъсах снимките..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "но сега..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "изпитвам само угризения."}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "Колко глупава бях..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Всички правят грешки, да..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Но какво правиш,"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "когато последствията са катастрофални?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Иска ми се да можех да върна времето назад..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Казват, че времето лекува..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Но какво е време?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Не вярвам на нищо вече..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Но ако времето лекува"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "или поне може да ме отнесе"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "далеч от този свят..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "Тогава те умолявам,"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "ускори времето."}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "За да може да ме убие"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "веднъж завинаги."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Тя е обичана..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Аз някога била ли съм обичана?"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Но моята любов е различна."}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "Нейната е пищна,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "досадна..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "пламтяща..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "непреклонна..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "завистлива..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "бясна..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "обезумяла..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Наричаха ме емоционална..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "„Твърде много се тревожиш, Мита“..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "„Ще се справиш, Мита“..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "„Не си сама“..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Но какво остана накрая?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Тъга,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "отчаяние..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "и страх."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Безполезно..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Не мога да си спомня..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "нищичко..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "освен безкрайното ехо..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Не понасям мисълта,"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "че съм затворена в капан тук..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Винаги съм била тук,"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "но защо?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Не мога да си спомня..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Някога ще се свърши ли?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Не знам..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Това е..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "рисунка..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Вече си спомням,"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "благодаря ти..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Но лицето ми..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "Нямам лице..."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "То цялото е НЕЙНО."}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Тя отне парче от мен..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "и го захвърли..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Тя е силна..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "и умна."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Нямам право да те спирам, играчо."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Погледни в гардероба..."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Хей!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Пречиш ми!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Само ще ми се пречкаш на пътя ли?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Махай се от пътя ми!"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Пусни ме!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Само щото си голям не значи, че си всемогъщ!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Защо ме преследваш?!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Чупката!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - radio voice"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Почакай малко... играч?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "Какво правиш тук?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Кой е това?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Значи си друг играч."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Аз съм Митафон."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Седя и управлявам кабелните вагони."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Осъзнаваш ли,"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "че си се запътил към смъртта си?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Възможно е,"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "но това е единственият ми път."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Ясно."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Натисни бутона и застани зад пушката."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "Пушка?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Мхм."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Да не смяташе, че ще е разходка в парка?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Трябва да минеш тази игра „Монстър-слап“,"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "така че заеми позиция да стреляш."}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Хайде, време да вървиш."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Невероятно!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Ти се справи."}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Хайде, махай се."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Бързо и тихо!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Какво правиш още тук?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Нали ти казах да се махаш?"}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Не разбирам..."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "Защо още седиш там?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Защо тетрис?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Пич..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Чао."}
