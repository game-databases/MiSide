{"category": "LocationDialogue Location1", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 1, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 9, "text": "Здравей, аз съм Мита!"}
{"category": "LocationDialogue Location1", "line_index": 10, "text": "Как се казваш?"}
{"category": "LocationDialogue Location1", "line_index": 11, "text": "Приятно ми е да се запознаем, [player]!"}
{"category": "LocationDialogue Location1", "line_index": 12, "text": "Ъм... [player],"}
{"category": "LocationDialogue Location1", "line_index": 13, "text": "по-рано много бързах и сега стаята е голяма бъркотия..."}
{"category": "LocationDialogue Location1", "line_index": 14, "text": "Би ли ми помогнал да я разчистим?"}
{"category": "LocationDialogue Location1", "line_index": 15, "text": "Еха..."}
{"category": "LocationDialogue Location1", "line_index": 16, "text": "Много ти благодаря!"}
{"category": "LocationDialogue Location1", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 18, "text": "[Player], корема ми къркори..."}
{"category": "LocationDialogue Location1", "line_index": 19, "text": "Много съм гладна..."}
{"category": "LocationDialogue Location1", "line_index": 20, "text": "Би ли ми купил съставки за пилешка супа?"}
{"category": "LocationDialogue Location1", "line_index": 21, "text": "Ура! Взел си всичко нужно!"}
{"category": "LocationDialogue Location1", "line_index": 22, "text": "Искаш ли да я приготвим заедно?"}
{"category": "LocationDialogue Location1", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 25, "text": "Здравей, [player]! Днес мислех да си купя евтин телевизор."}
{"category": "LocationDialogue Location1", "line_index": 26, "text": "От онези малките с антена, за да мога да го взема със себе си, като излизам на разходка."}
{"category": "LocationDialogue Location1", "line_index": 27, "text": "Впрочем, можеш да изкарваш пари, като играеш игри."}
{"category": "LocationDialogue Location1", "line_index": 28, "text": "Би ли играл, за да изкараш пари и да ми купиш телевизор?"}
{"category": "LocationDialogue Location1", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 30, "text": "Ура! Вече имаш достатъчно да купиш телевизор!"}
{"category": "LocationDialogue Location1", "line_index": 31, "text": "Точно този! Малък, преносим и евтин! Точно такъв исках."}
{"category": "LocationDialogue Location1", "line_index": 32, "text": "Благодаря!"}
{"category": "LocationDialogue Location1", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 34, "text": "Здравей, [player]! Много съм ти благодарна, че ми помагаш."}
{"category": "LocationDialogue Location1", "line_index": 35, "text": "Обаче... онзи телевизор... Беше готин, но взе, че се счупи."}
{"category": "LocationDialogue Location1", "line_index": 36, "text": "Би ли ми помогнал да преместим гардероба?"}
{"category": "LocationDialogue Location1", "line_index": 37, "text": "Твърде тежък е... >.<"}
{"category": "LocationDialogue Location1", "line_index": 38, "text": "Много ти благодаря, любимец мой! <3"}
{"category": "LocationDialogue Location1", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 40, "text": "О, [player]! Минал е едва ден, а много ми липсваш!"}
{"category": "LocationDialogue Location1", "line_index": 41, "text": "Може ли да ме посещаваш по-често?"}
{"category": "LocationDialogue Location1", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 43, "text": "За мен?"}
{"category": "LocationDialogue Location1", "line_index": 44, "text": "Благодаря, благодаря, благодаря!"}
{"category": "LocationDialogue Location1", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 46, "text": "Привет, [player]! Мислех си..."}
{"category": "LocationDialogue Location1", "line_index": 47, "text": "Иска ми се да те видя на живо."}
{"category": "LocationDialogue Location1", "line_index": 48, "text": "Жал ми е, че не мога."}
{"category": "LocationDialogue Location1", "line_index": 49, "text": "Всеки ден си мил с мен и ми помагаш..."}
{"category": "LocationDialogue Location1", "line_index": 50, "text": "Де да можех да направя и аз нещо за теб."}
{"category": "LocationDialogue Location1", "line_index": 51, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 52, "text": "А, сетих се!"}
{"category": "LocationDialogue Location1", "line_index": 53, "text": "Вече сме заедно."}
{"category": "LocationDialogue Location1", "line_index": 54, "text": "Остави си телефона."}
{"category": "LocationDialogue Location1", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 57, "text": "// T-shirt on the bed"}
{"category": "LocationDialogue Location1", "line_index": 58, "text": "Какво правиш тук на леглото?"}
{"category": "LocationDialogue Location1", "line_index": 59, "text": "// Rubik's Cube"}
{"category": "LocationDialogue Location1", "line_index": 60, "text": "Май го купих напразно..."}
{"category": "LocationDialogue Location1", "line_index": 61, "text": "Наредих го веднъж и го оставих така."}
{"category": "LocationDialogue Location1", "line_index": 62, "text": "Може би се страхувам, че няма да мога да го наредя отново?"}
{"category": "LocationDialogue Location1", "line_index": 63, "text": "// Computer"}
{"category": "LocationDialogue Location1", "line_index": 64, "text": "Днес какво ще трябва да правя..."}
{"category": "LocationDialogue Location1", "line_index": 65, "text": "Да съставя списък със задачи,"}
{"category": "LocationDialogue Location1", "line_index": 66, "text": "да моделирам реакциите на моделите"}
{"category": "LocationDialogue Location1", "line_index": 67, "text": "и, ако успея, да вмъкна малко кодене."}
{"category": "LocationDialogue Location1", "line_index": 68, "text": "// The airplane"}
{"category": "LocationDialogue Location1", "line_index": 69, "text": "Отличен полет!"}
{"category": "LocationDialogue Location1", "line_index": 70, "text": "// Trash in the corner"}
{"category": "LocationDialogue Location1", "line_index": 71, "text": "Никога нямам време да извхърля боклука..."}
{"category": "LocationDialogue Location1", "line_index": 72, "text": "Следващия път определено ще го хвърля."}
{"category": "LocationDialogue Location1", "line_index": 73, "text": "…Всъщност кога по график трябва да го хвърля?"}
{"category": "LocationDialogue Location1", "line_index": 74, "text": "// Photo of a cat on a watermelon"}
{"category": "LocationDialogue Location1", "line_index": 75, "text": "Толкова е страхотна…"}
{"category": "LocationDialogue Location1", "line_index": 76, "text": "Котка, излегнала се на диня."}
{"category": "LocationDialogue Location1", "line_index": 77, "text": "// Photo with a girl"}
{"category": "LocationDialogue Location1", "line_index": 78, "text": "Много сме различни аз"}
{"category": "LocationDialogue Location1", "line_index": 79, "text": "и сестра ми."}
{"category": "LocationDialogue Location1", "line_index": 80, "text": "Тя никога не пропуска събитие,"}
{"category": "LocationDialogue Location1", "line_index": 81, "text": "а аз вечно стоя у дома."}
{"category": "LocationDialogue Location1", "line_index": 82, "text": "// Photo with people"}
{"category": "LocationDialogue Location1", "line_index": 83, "text": "Хмм..."}
{"category": "LocationDialogue Location1", "line_index": 84, "text": "Шефовете наистина са ни промили мозъка"}
{"category": "LocationDialogue Location1", "line_index": 85, "text": "с офис етикета, а?"}
{"category": "LocationDialogue Location1", "line_index": 86, "text": "Все още се чувствам обвързан"}
{"category": "LocationDialogue Location1", "line_index": 87, "text": "с колегите си..."}
{"category": "LocationDialogue Location1", "line_index": 88, "text": "Обаче дори не знам"}
{"category": "LocationDialogue Location1", "line_index": 89, "text": "дали ще ги видя отново."}
{"category": "LocationDialogue Location1", "line_index": 90, "text": "…Чакай малко, наистина ли съм окачил тази снимка?"}
{"category": "LocationDialogue Location1", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 93, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 99, "text": "// Nope name"}
{"category": "LocationDialogue Location1", "line_index": 100, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 101, "text": "О, не."}
{"category": "LocationDialogue Location1", "line_index": 102, "text": "О, не, не. Не бива така."}
{"category": "LocationDialogue Location1", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 104, "text": "// Name Developer"}
{"category": "LocationDialogue Location1", "line_index": 105, "text": "Сигурен ли си, че искаш да ползваш името на разработчика?"}
{"category": "LocationDialogue Location1", "line_index": 106, "text": "Поласкана съм, но…"}
{"category": "LocationDialogue Location1", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 108, "text": "// Bad name"}
{"category": "LocationDialogue Location1", "line_index": 109, "text": "Бих предпочела да не се наричаш така."}
{"category": "LocationDialogue Location1", "line_index": 110, "text": "Изобщо не е готино."}
{"category": "LocationDialogue Location1", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 112, "text": "// Go restart"}
{"category": "LocationDialogue Location1", "line_index": 113, "text": "Не се прави така. Нека започнем отначало."}
{"category": "LocationDialogue Location1", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 115, "text": "// Name with numbers"}
{"category": "LocationDialogue Location1", "line_index": 116, "text": "Охо? В името ти има числа? Какво му е креативното на това?"}
{"category": "LocationDialogue Location1", "line_index": 117, "text": "Е, какво пък, изборът си е твой!"}
{"category": "LocationDialogue Location1", "line_index": 118, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 119, "text": "// Name Mita"}
{"category": "LocationDialogue Location1", "line_index": 120, "text": "Мита?"}
{"category": "LocationDialogue Location1", "line_index": 121, "text": "Да не се кръсти като мен?"}
{"category": "LocationDialogue Location1", "line_index": 122, "text": "Или действително се казваш така?"}
{"category": "LocationDialogue Location1", "line_index": 123, "text": "Нищо лично, но смятам, че само аз трябва да се казвам Мита ♪"}
{"category": "LocationDialogue Location1", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 125, "text": "// Day 10"}
{"category": "LocationDialogue Location1", "line_index": 126, "text": "А, ти се върна!"}
{"category": "LocationDialogue Location1", "line_index": 127, "text": "Загубих си четката за коса…"}
{"category": "LocationDialogue Location1", "line_index": 128, "text": "Би ли ми помогнал да я намеря?"}
{"category": "LocationDialogue Location1", "line_index": 129, "text": "Първо пробвай в чекмеджето до леглото, мисля, че там я оставих."}
{"category": "LocationDialogue Location1", "line_index": 130, "text": "// Looked in the bedside table"}
{"category": "LocationDialogue Location1", "line_index": 131, "text": "Хмм, четката не е там..."}
{"category": "LocationDialogue Location1", "line_index": 132, "text": "Може би е някъде другаде?"}
{"category": "LocationDialogue Location1", "line_index": 133, "text": "Само не гледай във фурната!"}
{"category": "LocationDialogue Location1", "line_index": 134, "text": "По-рано търсих там."}
{"category": "LocationDialogue Location1", "line_index": 135, "text": "// Looked into the stove"}
{"category": "LocationDialogue Location1", "line_index": 136, "text": "Хей, казах ти да не търсиш там!"}
{"category": "LocationDialogue Location1", "line_index": 137, "text": "Обърни се, ще почистя!"}
{"category": "LocationDialogue Location1", "line_index": 138, "text": "...Готово. Да потърим някъде другаде."}
{"category": "LocationDialogue Location1", "line_index": 139, "text": "А, да, забрави какво видя там, става ли?"}
{"category": "LocationDialogue Location1", "line_index": 140, "text": "// Found a hairbrush"}
{"category": "LocationDialogue Location1", "line_index": 141, "text": "Откри я! Добра работа!"}
{"category": "LocationDialogue Location1", "line_index": 142, "text": "Страхотно! Сега какво ти се прави?"}
