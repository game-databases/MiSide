{"category": "LocationDialogue Location9", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Ей, ти!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Здрасти!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Искаш ли да излезеш?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Тогава ми помогни да открия ключа!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Лошо! Ключът го няма!"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Няма нищо тук!"}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "Нула, нищо, празно!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Открих го!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// The usual conversation"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Хмм, очаквах да си по-нисък!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "Висок си!"}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "Като сестра ми!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "Сестра ти? Какво за нея?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Да, сестра ми."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Не ми казвай, че не я познаваш!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Ъм... Срещал съм я... сигурно?"}
{"category": "LocationDialogue Location9", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Да не си глупак?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "Ъм..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "Явно си..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "Хайде, помогни ми да направя ключа де!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// Next work"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Ела."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Сложи желязото в тръбата!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Благодаря!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "Сега ми дай дървата!"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Благодаря ти!"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Още малко помощ, моля!"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Добре! Сега..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "Еха, красиво е."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Хайде, натисни го!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Подготви се..."}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "Ето, вземи го!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "Ключът е твой!"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// Quest 1 (Are you Mita?)"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Аз съм ChibiMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Много редове,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "прост модел"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "и с най-прекрасната коса!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// Quest 2 (Have we seen each other yet?)"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Господин Голям глупак,"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "много си сладък,"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "когато задаваш такива глупави въпроси."}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Въпреки това"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "за пръв път те виждам!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Но внимавай..."}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Ако ми откраднеш прекрасния образ,"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "много ще съжаляваш!"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// Quest 3 (Why are you here?)"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Не схващаш ли?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "Това е контролна точка—"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "тест на твоя интелект!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "Сега давай!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Тук съм да упътвам безумно загубените!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// Quest 4 (Why are you helping me?)"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "Че какъв си ти,"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "за да не ти помогна?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "Какво?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Толкова си глупав..."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Изпадна тук от нищото!"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Не бива да си тук,"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "затова ти помагам!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Чао-чао, глупчо!"}
