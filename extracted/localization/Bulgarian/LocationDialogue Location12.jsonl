{"category": "LocationDialogue Location12", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Стой тук."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Мисля, че изпуснах нещо. Сега се връщам."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "После ще идем в друг свят..."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Добре."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Да играем!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Искам си мечето!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "Загубих го..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "Намери ГО!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Хей..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "какво гледаш?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Quest 1 (Who are you?)"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Аз съм Мита."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "Най-добрата Мита."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "Най-първата Мита."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "Това ми каза Мита, моята Мита."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Quest 2 (Why do you look like that?)"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "Как изглеждам?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "Как изглеждам?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "Как изглеждам?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "Моята Мита казва, че съм красива и оригинална."}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "Това съм аз!"}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Quest 3 (What was Mita doing here?)"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Тя ще ме отведе."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Ние ще живеем в нов свят."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "Моята Мита ме покани."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Ще ме отведе. И ще играем."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Quest 4 (Why do you need a teddy bear?)"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "Ти си гушливо мече"}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "и си загубен."}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "Точно като моето гушливо мече."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Quest 5 (Why is Mita angry?)"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "Моята..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "Мита."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Тя иска да си играем."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Тя единствено иска"}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "мен."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Ние сме уникални,"}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "единствените."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Мита и моята Мита,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0.8A и 8�54*."}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Quest 6 (Do you believe Mita?)"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "Моята Мита."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "Най-добрата приятелка."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "Моята Мита."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "Единствената приятелка."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "Ти гониш!"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Хей."}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Да играем!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Ще ти покажа как."}
