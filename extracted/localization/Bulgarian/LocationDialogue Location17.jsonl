{"category": "LocationDialogue Location17", "line_index": 0, "text": "// Player thinks + Make coffee"}
{"category": "LocationDialogue Location17", "line_index": 1, "text": "Ще ми трябва помощ."}
{"category": "LocationDialogue Location17", "line_index": 2, "text": "Надявам се тази Мита да не хапе..."}
{"category": "LocationDialogue Location17", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 4, "text": "С какво си губя времето само..."}
{"category": "LocationDialogue Location17", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 9, "text": "// Player tries to wake up MitaDreamer"}
{"category": "LocationDialogue Location17", "line_index": 10, "text": "Мита?"}
{"category": "LocationDialogue Location17", "line_index": 11, "text": "Мита, събуждай се!"}
{"category": "LocationDialogue Location17", "line_index": 12, "text": "Мита!"}
{"category": "LocationDialogue Location17", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 14, "text": "Мита, ставай вече!"}
{"category": "LocationDialogue Location17", "line_index": 15, "text": "Трябваш ми."}
{"category": "LocationDialogue Location17", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 17, "text": "Кой си тииии?"}
{"category": "LocationDialogue Location17", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 19, "text": "Помогни ми с лостовете."}
{"category": "LocationDialogue Location17", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 21, "text": "Какви лостовете?"}
{"category": "LocationDialogue Location17", "line_index": 22, "text": "Остави ме да спя..."}
{"category": "LocationDialogue Location17", "line_index": 23, "text": "Или ми донеси кафе."}
{"category": "LocationDialogue Location17", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 25, "text": "Две прости стъпки са."}
{"category": "LocationDialogue Location17", "line_index": 26, "text": "Мита?"}
{"category": "LocationDialogue Location17", "line_index": 27, "text": "Миита!"}
{"category": "LocationDialogue Location17", "line_index": 28, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 31, "text": "// Player gives away the coffee"}
{"category": "LocationDialogue Location17", "line_index": 32, "text": "Мита,"}
{"category": "LocationDialogue Location17", "line_index": 33, "text": "ето ти кафето."}
{"category": "LocationDialogue Location17", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 37, "text": "// MitaDreamer exercise"}
{"category": "LocationDialogue Location17", "line_index": 38, "text": "Лостове"}
{"category": "LocationDialogue Location17", "line_index": 39, "text": "викаш?"}
{"category": "LocationDialogue Location17", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 41, "text": "Да."}
{"category": "LocationDialogue Location17", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 43, "text": "Как така знаеш за тях?"}
{"category": "LocationDialogue Location17", "line_index": 44, "text": "Защо ли питам..."}
{"category": "LocationDialogue Location17", "line_index": 45, "text": "Щом си тук,"}
{"category": "LocationDialogue Location17", "line_index": 46, "text": "значи знаеш достатъчно вече..."}
{"category": "LocationDialogue Location17", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 48, "text": "Чакай малко,"}
{"category": "LocationDialogue Location17", "line_index": 49, "text": "трябва да седна за малко."}
{"category": "LocationDialogue Location17", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 51, "text": "И?"}
{"category": "LocationDialogue Location17", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 53, "text": "Нямам думи..."}
{"category": "LocationDialogue Location17", "line_index": 54, "text": "Но трябва да продължа"}
{"category": "LocationDialogue Location17", "line_index": 55, "text": "и да следя насоките на пръстена."}
{"category": "LocationDialogue Location17", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 57, "text": "Имаш ѝ пръстена?"}
{"category": "LocationDialogue Location17", "line_index": 58, "text": "Нищо чудно,"}
{"category": "LocationDialogue Location17", "line_index": 59, "text": "че си открил това място."}
{"category": "LocationDialogue Location17", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 61, "text": "Да."}
{"category": "LocationDialogue Location17", "line_index": 62, "text": "Та би ли ми помогнала?"}
{"category": "LocationDialogue Location17", "line_index": 63, "text": "С лостовете?"}
{"category": "LocationDialogue Location17", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 65, "text": "Добре."}
{"category": "LocationDialogue Location17", "line_index": 66, "text": "Ще помогна."}
{"category": "LocationDialogue Location17", "line_index": 67, "text": "С лостовете..."}
{"category": "LocationDialogue Location17", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 70, "text": "Мита, хайде..."}
{"category": "LocationDialogue Location17", "line_index": 71, "text": "Да вървим..."}
{"category": "LocationDialogue Location17", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 73, "text": "А?"}
{"category": "LocationDialogue Location17", "line_index": 74, "text": "Добре."}
{"category": "LocationDialogue Location17", "line_index": 75, "text": "Да вървим."}
{"category": "LocationDialogue Location17", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 78, "text": "// MitaDreamer fall"}
{"category": "LocationDialogue Location17", "line_index": 79, "text": "Ставай."}
{"category": "LocationDialogue Location17", "line_index": 80, "text": "Толкова много ли ти се спи?"}
{"category": "LocationDialogue Location17", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 82, "text": "// MitaDreamer again sleep"}
{"category": "LocationDialogue Location17", "line_index": 83, "text": "Ставай."}
{"category": "LocationDialogue Location17", "line_index": 84, "text": "Стигнахме."}
{"category": "LocationDialogue Location17", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 87, "text": "// Switches"}
{"category": "LocationDialogue Location17", "line_index": 88, "text": "Добре."}
{"category": "LocationDialogue Location17", "line_index": 89, "text": "Готова съм."}
{"category": "LocationDialogue Location17", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 91, "text": "И аз съм готов."}
{"category": "LocationDialogue Location17", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 93, "text": "Добре."}
{"category": "LocationDialogue Location17", "line_index": 94, "text": "Аз ще почна"}
{"category": "LocationDialogue Location17", "line_index": 95, "text": "отброяването."}
{"category": "LocationDialogue Location17", "line_index": 96, "text": "И ще дръпнем лостовете заедно."}
{"category": "LocationDialogue Location17", "line_index": 97, "text": "Разбра ли?"}
{"category": "LocationDialogue Location17", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 99, "text": "Само гледай да не заспиш!"}
{"category": "LocationDialogue Location17", "line_index": 100, "text": "Почвай."}
{"category": "LocationDialogue Location17", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 103, "text": "3"}
{"category": "LocationDialogue Location17", "line_index": 104, "text": "2"}
{"category": "LocationDialogue Location17", "line_index": 105, "text": "1"}
{"category": "LocationDialogue Location17", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 107, "text": "// Player lose 1"}
{"category": "LocationDialogue Location17", "line_index": 108, "text": "Унесе ли се?"}
{"category": "LocationDialogue Location17", "line_index": 109, "text": "Хайде,"}
{"category": "LocationDialogue Location17", "line_index": 110, "text": "давай пак..."}
{"category": "LocationDialogue Location17", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 112, "text": "// Player lose 2"}
{"category": "LocationDialogue Location17", "line_index": 113, "text": "Да пробваме още веднъж?"}
{"category": "LocationDialogue Location17", "line_index": 114, "text": "Хайде де,"}
{"category": "LocationDialogue Location17", "line_index": 115, "text": "аз..."}
{"category": "LocationDialogue Location17", "line_index": 116, "text": "аз направо заспивам тук..."}
{"category": "LocationDialogue Location17", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 118, "text": "// Player lose 3"}
{"category": "LocationDialogue Location17", "line_index": 119, "text": "Май само аз не заспивам..."}
{"category": "LocationDialogue Location17", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 122, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 123, "text": "Прекрасно,"}
{"category": "LocationDialogue Location17", "line_index": 124, "text": "благодаря, Мита."}
{"category": "LocationDialogue Location17", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 126, "text": "Мхммм."}
{"category": "LocationDialogue Location17", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 129, "text": "Вратата..."}
{"category": "LocationDialogue Location17", "line_index": 130, "text": "е..."}
{"category": "LocationDialogue Location17", "line_index": 131, "text": "бавна..."}
{"category": "LocationDialogue Location17", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 134, "text": "Ще си лягам..."}
{"category": "LocationDialogue Location17", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 136, "text": "// Why kitchen?"}
{"category": "LocationDialogue Location17", "line_index": 137, "text": "Защо сме в кухнята?"}
{"category": "LocationDialogue Location17", "line_index": 138, "text": "Ако заспя на студения под,"}
{"category": "LocationDialogue Location17", "line_index": 139, "text": "ти си виновен."}
{"category": "LocationDialogue Location17", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 141, "text": "// Why bathroom?"}
{"category": "LocationDialogue Location17", "line_index": 142, "text": "Не разбирам..."}
{"category": "LocationDialogue Location17", "line_index": 143, "text": "с какви лостове имаше нужда от помощ?"}
{"category": "LocationDialogue Location17", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 145, "text": "// Put button"}
{"category": "LocationDialogue Location17", "line_index": 146, "text": "Нищо не стана?"}
{"category": "LocationDialogue Location17", "line_index": 147, "text": "Тогава за какво има бутон тук?"}
{"category": "LocationDialogue Location17", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 149, "text": "// Cofee"}
{"category": "LocationDialogue Location17", "line_index": 150, "text": "Искаш ли още кафе?"}
{"category": "LocationDialogue Location17", "line_index": 151, "text": "Иначе пак ще заспиш."}
{"category": "LocationDialogue Location17", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 153, "text": "Какво?"}
{"category": "LocationDialogue Location17", "line_index": 154, "text": "Неее..."}
{"category": "LocationDialogue Location17", "line_index": 155, "text": "Кафето има ужасен вкус..."}
{"category": "LocationDialogue Location17", "line_index": 156, "text": "Добре съм си..."}
{"category": "LocationDialogue Location17", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 158, "text": "// Button"}
{"category": "LocationDialogue Location17", "line_index": 159, "text": "Мита? Бутонът не работи... Чуваш ли ме?"}
{"category": "LocationDialogue Location17", "line_index": 160, "text": "Ехо?"}
