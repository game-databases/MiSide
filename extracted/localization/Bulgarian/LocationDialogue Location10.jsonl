{"category": "LocationDialogue Location10", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "Стой, чакай!"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "Не бъди така шумен..."}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "Напред е опасно."}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "Впрочем..."}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "как се озова тук?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "Ами..."}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "Пръстенът отваря правилните врати."}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "Честно казано, не знам как работи."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "Пръстенът?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "Какво му има на това място?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "Много е тъмно."}
{"category": "LocationDialogue Location10", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "После ще ти кажа."}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "Сега да вървим към изхода."}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "Ще се чакаме пред аркадната машина."}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Побързай, не губи време!"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// After mini-game"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "Та схвана ли идеята на играта?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "Под моята кожа има кости, а под твоята манекен?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "Уау!"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "Звучи зловещо, като го кажеш по този начин."}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "Но това е горе-долу идеята."}
{"category": "LocationDialogue Location10", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "Добре, но защо трябва да разбера това?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "Смяташ, че съм ти казала, че е опасно"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "да продължиш напред просто ей така?"}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "Ще се натъкнеш на... онези манекени..."}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "Онези, от които са се отказали - „дефектните“."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "Те са агресивни и дори може да се опитат да те убият."}
{"category": "LocationDialogue Location10", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "Какво друго мога да направя?"}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Просто ходя,"}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "където вратата ме отведе."}
{"category": "LocationDialogue Location10", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "Еха!"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "Тогава не им обръщай гръб."}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "И не ги губи от поглед!"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "Срам ги е, докато ги гледаш,"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "толкова ги е срам, че замръзват."}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "Имай го предвид!"}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// Quest 1 (Why are there other Mitas down there?)"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "Наскоро са получили кожата си."}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "Трябва им време"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "да получат самосъзнание."}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "После водя всяка"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "до нейния дом."}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// Quest 2 (Why is it so dark downstairs?)"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "Митите се създават в мрака,"}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "затова трябва да стоим там известно време."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Представи си"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "болката от това да минеш от мрак право в светлината..."}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// Quest 3 (What are you doing here?)"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "Все още ли не си разбрал?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "Помагам на новите Мити да се заселят!"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "Кой ще ги упъти, ако не съм аз тук?"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "Ти ли?"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// Quest 4 (Why do we need this conveyor?)"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "За какво е конвейера?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "Има ли достатъчно място за всички?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Чакай, не ми казвай,"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "че още не разбираш как работи светът..."}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "И че е безкраен?"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "Безкраен?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "Хмм..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "Ама как?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "Ако 1.9 е най-новата версия, "}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "то тогава има само 19 свята."}
{"category": "LocationDialogue Location10", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "О, боже! Ти изобщо не схващаш"}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "как работи светът."}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Виж, ще ти покажа на дъската"}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "как работи."}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "Става ли?"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// Quest 5 (What is your version?)"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Чакай,"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "не те ли видях в най-новата версия?"}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "Или просто си въобразявам?"}
{"category": "LocationDialogue Location10", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "Е, напълно възможно е."}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Аз съм от версия 1.5."}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "Бил ли си там?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Да."}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "Там се озовах,"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "когато за пръв път дойдох в света!"}
{"category": "LocationDialogue Location10", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "Еха!"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "Как така...?"}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "Но в къщата на кой индекс беше?"}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "Има моя версия, която не спира да мрънка,"}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "друга моя версия, която много обича да играе,"}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "друга моя версия, която обича да тормози хората и забравя..."}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "Много са да ги изброявам..."}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Кажи ми какво си спомняш."}
{"category": "LocationDialogue Location10", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Беше тъмно."}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "Имаше и надписи"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "от рода на:"}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "„Играй си с мен“."}
{"category": "LocationDialogue Location10", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "Ох,"}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "колко жалко..."}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "Това е онази аз,"}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "която обича да тормози и забравя."}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// Mita wants to tell you [No]"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Мерси, но няма нужда."}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Ще се справя и без да знам повече."}
{"category": "LocationDialogue Location10", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "Добре, както щеш."}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// Mita wants to tell you [Yes]."}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "Добре, давай."}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "Само се надявам да не е като в гимназията,"}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "където все заспивах от скука."}
{"category": "LocationDialogue Location10", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "Може да си тръгнеш по всяко време"}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "или да останеш и да слушаш,"}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "ако ти е интересно."}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "Играч тегли MiSide"}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "и играе колкото си иска."}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "Тогава създава нов дом,"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "както и нова Мита."}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "Това е двуизмерна визуализация."}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "Това са версиите,"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "изобразени като линии."}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "Къщите се намират на тези линии."}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "Да речем, че теглиш версия 1.14,"}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "което значи нов живот,"}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "нова Мита и нова къща."}
{"category": "LocationDialogue Location10", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "Божичко..."}
{"category": "LocationDialogue Location10", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Може да питаш по-конкретно"}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "за нещата по рисунката"}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "и ще се опитам да ти обясня."}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// He asks about the only circle"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "Защо тук има само едно кръгче?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "Тази версия беше пусната само веднъж"}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "и никога повече не се пусна."}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "Това е единствената наистина уникална версия."}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "Пък и тази версия е специална"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "и няма друг път до други версии."}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "Сънена Мита живее в тази версия - 1.1."}
{"category": "LocationDialogue Location10", "line_index": 171, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "Сънена Мита?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "Защото никога не може да се наспи,"}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "като всички минават през нейната версия?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "Не, не е това."}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "Можеш да минеш покрай нея и да вдигнеш шум,"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "но е невъзможно да я събудиш."}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// He asks about the shaded circle"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "Защо това кръгче е черно?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "Ами това тук е"}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "заради Хубавица Мита."}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "Тя го нарисува."}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "С нея спорихме"}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "коя може да стигне до версия 1.11 най-бързо."}
{"category": "LocationDialogue Location10", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "И коя спечели?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "АЗ, разбира се!"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "Виж, намираме се тук"}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "във версия 1.15,"}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "в къщата с индекс 809."}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "Трябва да стигнем до версия 1.11,"}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "в къщата с индекс 805."}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Нейният път почна така."}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "Опитахме се да измислим по-кратък път,"}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "затова Хубавица Мита измисли този път."}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "И аз после нарисувах най-късия път ето тук."}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "Просто, нали?"}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Погледни тук."}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "От тук можеш да стигнеш директно до правилната версия."}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Макар и да изглежда сякаш тази къща е по пътя,"}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "че ти пречи..."}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "Иначе твоят пръстен работи на същия принцип."}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "Накъде си се запътил?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "Към Ядрото."}
{"category": "LocationDialogue Location10", "line_index": 210, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "Ядрото?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "Хмм..."}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Ако търсиш най-късия път,"}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "тогава и ти ще трябва да минеш през 1.11."}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "Със сигурност ще срещнеш Сънена Мита там."}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Смятам, че онази Мита, която те е пратила,"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "също е поела по този път."}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "Или не е осъзнала, че вървиш по друг път."}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "Или пък е гений"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "и е открила още по-къс път!"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Мисля, че схващам."}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// He asks about the inscription"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "Какво е това?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "Това е за Готина Мита."}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "Тя ще дойде след няколко часа."}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "Ще измести тези кашони"}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "и ще сложи диван там."}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "Задникът ме боли!"}
{"category": "LocationDialogue Location10", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Ъм..."}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "Може да ти помогна?"}
{"category": "LocationDialogue Location10", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "Не, това е работа за Готина Мита."}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Тя е корава."}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// He asks about the drawings"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "Това рисунка ли е"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "или"}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "има някакъв смисъл?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 244, "text": "Не,"}
{"category": "LocationDialogue Location10", "line_index": 245, "text": "просто драскулка е."}
