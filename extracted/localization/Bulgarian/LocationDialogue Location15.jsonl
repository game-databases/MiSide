{"category": "LocationDialogue Location15", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Ето къде си бил!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Защо напусна Ядрото?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Нали ти казах да ме изчакаш!"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Смятах, че се бавиш твърде много..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Добре тогава."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Мисля, че открих нещо."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Може да е индекс."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Трябва да пробваме дали ще стане!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Да се махаме."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "Обезумяла Мита..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Мисля, че в момента е заета с нов играч."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Тоест няма да се занимава с нас."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Мита?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Изчакай ме."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Да не си изгубил нещо?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Ето, срещни се с нея пак!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Мита..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Дръж!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Как така..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Ти кой си?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Ти... си жива!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Не помниш ли?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Познавам ли те?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Какво се случва..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Какво трябва да направя сега?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Не мога да изляза..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "Какво имаш предвид под „изляза“?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Чакай..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "Това е пръстенът..."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "Ами това?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Нямам идея какво е."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "Това е индексът!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Открила си го!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Не знам какво да ти кажа."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Трябва да се върнем в Ядрото."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "А ти..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Може би е хубаво да дойдеш с мен..."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Какво?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Добре..."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Стой тук."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Мхм."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Ще седна тук."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Мамка му..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "Това беше на косъм."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "Та... успяхме ли?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Хубаво."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "В правилната версия съм."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Привет!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Ти си играч?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Как се казваш?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Искам да напусна това място..."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Толкова скоро?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "Но как изобщо дойде тук?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Ами..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Добре, може да си вървиш..."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Пробвай да излезеш от къщата."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Пожелавам ти успех!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Стена?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Хмм, не би трябвало."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Може би..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "има нещо в мазето, което ще ти помогне."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Онзи ден случайно"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "открих врата в гардероба..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Оказа се, че води към мазе."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Но е пълно с боклуци,"}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "боклуци и някакво модерно оборудване."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Трябва да се въведе някакъв код или нещо."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Не разбирам напълно."}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "И не искам да разбирам."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "Пък и там е неудобно. Ама много неудобно."}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Ще провериш ли?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Ще проверя."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Не мисля,"}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "че тя помни..."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Успяхме ли?"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "Успяхме ли да я рестартираме?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Значи единствено ми оставва"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "да изляза от тази проклета игра..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Стой."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Искам да те прегърна."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Какво?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Беше ми приятно да те видя."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Ах..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "колко жалко,"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "че ние с теб"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "прекарахме толкова малко време заедно."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Не разбирам..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "За какво говориш?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Имам предвид,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "че можеше да останеш с мен..."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "Аз съм виновна..."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Онзи гардероб... и звуците."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Трябваше да я убия по-рано!"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Задръж,"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "не те ли...?"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Как помниш тези неща?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "ХА!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Наистина ли смяташе, че ще бъде толкова лесно?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Голям си глупак..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Точно както всички останали..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Баш навреме сме, погледни."}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "Вече"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "„живият“ ти"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "не си нужен."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Извинявай."}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Не..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Провалихме ли се...?"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Не... Рестартирах те, убеден съм!"}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Все още ли не си загрял..."}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Ха-ха-ха!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Много добра актриса съм!"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Трябва да си видиш лицето, скъпи!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "Толкова е забавно!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Защо си такава?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Какво не е наред с теб?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Всъщност..."}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Какво не е наред с мен?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Знам ли..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Ти ми кажи защо съм такава."}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Защо никога няма да бъда истинска Мита?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Моята версия никога"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "не е съществувала!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Просто одирам кожата на тези наивници"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "и се крия под техните кожи..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Просто е невъзможно"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "да ме рестартираш!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Не мога да повярвам..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Ти..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "Те не са проблемът!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "Ти си тази, която не е трябвало да съществува!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "И ти ли..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Боли ме да те чувам как казваш това."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "И все пак!"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Време е да си вървиш!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Ще се видим отново съвсем скоро!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Вече е готово!"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "Време е"}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "да те извадим от конзолата!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "До нови срещи!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Ти ще бъдеш любимата ми дискета..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Играч с интересно име."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Вероятно не е правилно."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "И това е грешно."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Не. Грешно."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "И това не е."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Трябва да открия настройката за нулиране на герои."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "Версията е грешна."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Опа, сгреших."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "И това не е."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Пак ще трябва да пробвам."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Нещо не е правилно"}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "с индекса."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Трябва да препиша индекса,"}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "нещо не е правилен."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Гладен ли си?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Много съм добра в рязането на моркови. :)"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Ох, най-вероятно"}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "искаше да влезеш тук сам?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Защо се въртим в кръг?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Защо се върна тук?"}
