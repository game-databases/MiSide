{"category": "LocationDialogue Location8", "line_index": 0, "text": "// The first meeting"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "؟ﻦﻴﻣ ﻲﺘﻧﺇ !؟هﺩ ﻪﻳﺇ"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "؟ﺔﺟﺎﺣ ﻲﻓ"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "؟ﻲﻤﻠﻜﺘﺘﺑ ﺶﻣ ﻲﺘﻧﺇ"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "...ﻲﻨﺘﺳﺍ"}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "؟هﺪﻛ ﺶﻣ ﻲﺸﻤﺗ ﺰﻳﺎﻋ"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "...هﺍ"}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "ﻊﺟﺭﺃ ﺰﻳﺎﻋ ﺎﻧﺍ"}
{"category": "LocationDialogue Location8", "line_index": 11, "text": ".تﺎﻓ ﻲﻠﻟﺍ رﺍﺪﺻﻺﻟ"}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "؟تﺎﻓ ﻲﻠﻟﺇ رﺍﺪﺻﻹﺍ"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "ﻲﺸﻤﺗﻭ ﻲﻨﺒﺴﺗ ﻪﻴﻟ"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "؟ﻲﻧﺎﺗ نﺎﻜﻤﻟ"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "ﺎﻨﻫ ﺪﻌﻘﺗ ﺰﻳﺎﻋ ﺶﻣ ﻪﻴﻟ"}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "...ﻲﺒﻘﺗﻭ"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "؟ﻲﻧﺎﺜﻟﺍ..ﻲﺒﺤﺻ..."}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Skipping all dialogs"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "...مﺎﻤﺗ"}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Standing by the window (Random)"}
{"category": "LocationDialogue Location8", "line_index": 24, "text": ".نﺎﺒﻴﺒﻟﺍ ﻦﻣ جﺮﺨﺗ فﺮﻌﺘﻫ ﺶﻣ"}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "...ﻞﺠﻌﺘﺴﻣ ﻚﻠﻜﺷ"}
{"category": "LocationDialogue Location8", "line_index": 26, "text": ".نﺍﺭﻭﺪﻟﺍﻭ ﻒﻠﻟﺍ ﻚﻌﻔﻨﻴﻫ ﺶﻣ"}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "؟ﻲﻨﻣ بﺮﻬﺗ ﻚﻧﺍ ﻢﻤﺼﻣ ﺖﻧﺍ"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "...كﺎﺒﺸﻟﺍ ﺔﻴﺣﺎﻧ ﺺﺑ"}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Aren't you Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "؟هﺪﻛ ﺶﻣ ،ﺐﻋﻻ ﺖﻧﺃ ...ﺐﻋﻻ"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": ".ﺾﻌﺑ ﻊﻣ ﺐﻌﻠﻧ ﻦﻜﻤﻣ"}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "... ﺲﺑ ﻲﻠﻴﺣ ةﺩﺎﺷ ﺖﻨﻛ ﻮﻟ"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": ".ﺐﻌﻟﺃ ﻲﻧﺍ ﺎﻫﺰﻳﺎﻋ ﻲﻠﻟﺍ ﻞﻛ ﺎﻧﺍ"}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (What happened to you?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "...ﺔﺟﺎﺤﺑ ﺔﺳﺎﺣ ﻻﻭ ،ﺔﻓﺭﺎﻋ ﺶﻣ"}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "...ﺖﻠﺼﺣ ﺔﺸﺣﻭ ﺔﺟﺎﺣ ﻪﻴﻓ نﺍ شﺪﻘﺘﻌﻣ"}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "...حﻭﺮﺘﺑ ﺔﺟﺎﺣ ﻞﻛ نﺍ ﻦﻳﺎﺑ ﻦﻜﻟ"}
{"category": "LocationDialogue Location8", "line_index": 41, "text": ".ﻞﻗﻻﺍ ﻲﻠﻋ ﺐﺣﺎﺻ يﺪﻨﻋ ،هﺪﻛ ﻦﻣ ﻢﻏﺮﺑﻭ"}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "... ؟ﻲﻧﻮﺘﺒﺳ ﻪﻴﻟ"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "؟ﺔﺴﻳﻮﻛ ﺶﻣ ﺎﻧﺍ ﻮﻫ"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": ".ﺔﻔﻳﺎﺧ ﺎﻧﺃ ... ﺶﻴﻧﻮﺒﺴﺘﻣ"}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Quest 3 (Become a second friend?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "...؟بﺎﺤﺻﺃ"}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "...ﻲﻨﺑﺎﺳﻭ حﺍﺭ ﻪﻠﻛ"}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "...ﺲﺑ ﺪﺣﺍﻭ ﺮﻴﻏ شﺎﻘﺒﻣ"}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "...ﺐﻋﻻ ﺎﻳ ،ﺔﻧﻼﻋﺯ ﺎﻧﺃ"}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "؟ﻲﺒﺣﺎﺻ ﻲﻘﺒﺗ ﻦﻜﻤﻣ"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "...،هﺪﻛ ﻲﻓ ﻲﺴﻔﻧ نﺎﻛ"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": ".كﺮﺤﺗﺍ مﺯﻻ ﻦﻜﻟ"}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "...حﻭﺮﺠﻣ ﻲﺒﻠﻗ"}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Is this your house?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "...؟ﻲﺘﻴﺑ"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "...تﺮﻴﻐﺗ ﺖﻧﺍ ... ﺐﻋﻻ ﺎﻳ"}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "...نﺎﺒﻀﻏ ﻚﻧﺍ ﻚﻴﻠﻋ ﻦﻳﺎﺑ ﺶﻣﻭ ،ﺔﻔﻴﻔﺧ ﻲﺘﻗﻮﻟﺩ ﻚﻳﺪﻳﺍ"}
{"category": "LocationDialogue Location8", "line_index": 62, "text": ".ﻒﻴﻄﻟﻭ ﻦﻴﻨﺣ ﺖﻴﻘﺑ ﺖﻧﺍ ،ﺐﻋﻻ ﺎﻳ"}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "...ﻢﻫﺎﻓ ﺶﻣ"}
{"category": "LocationDialogue Location8", "line_index": 65, "text": ".؟ﻪﻳﺇ كﺪﺼﻗ"}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "...ﻢﻬﻣ ﺶﻣ"}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "؟هﺪﻛ ﺶﻣ ،ﻊﺟﻮﺑ ﺲﺤﻫ ﺶﻣ نﺎﺸﻠﻋ"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (How do I leave this place?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "... ؟ﻲﻨﺒﻴﺴﺘﻫ ﺖﻧﺍ ﻮﻫ"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": ".. ﺲﺑ هﺩ ﻮﻫ"}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "؟ﻲﺘﺒﻴﺧ..."}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "...ﺎﻧﺃ"}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": ".كﺪﻋﺎﺴﺘﻫ ﺶﻣ بﺍﻮﺑﻷﺍ"}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Hold player (Random)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "؟ﻲﺸﻤﺘﺑ ﻪﻴﻟ"}
{"category": "LocationDialogue Location8", "line_index": 81, "text": ".ﺎﻨﻫ ﻚﻴﻠﺧ ﻚﻴﻠﻋ ﻪﻠﻟﺎﺑ"}
{"category": "LocationDialogue Location8", "line_index": 82, "text": ".ﺎﻳﺎﻌﻣ ﺐﻌﻟﺇ ﻲﺒﻨﻟﺍﻭ"}
{"category": "LocationDialogue Location8", "line_index": 83, "text": ".ﻲﺒﻨﻟﺍﻭ ﺐﻋﻻ ﺎﻳ"}
