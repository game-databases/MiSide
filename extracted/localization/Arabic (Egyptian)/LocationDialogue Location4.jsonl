{"category": "LocationDialogue Location4", "line_index": 377, "text": "// A game about penguins"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "ﺔﻄﻴﺴﺑ ﺔﺒﻌﻠﻟﺍ ةﺮﻜﻓ"}
{"category": "LocationDialogue Location4", "line_index": 379, "text": ".ﺞﻠﺘﻟﺍ تﺍﺮﻛ ﻊﻤﺠﺗ ﻚﻴﻠﻋ ﻲﻠﻟﺍ ﻞﻛ"}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "!زﻮﻔﻴﻫ ،ﺮﺘﻛﺍ ﻊﻤﺠﻴﻫ ﻲﻠﻟﺍﻭ"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "!؟مﺎﻤﺗ ﻦﻴﺘﻟﻮﺟ ﺐﻌﻠﻨﻫ"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// The first map"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "يﻭﺍ ﺮﻴﺘﻛ ﺖﻌﻤﺟ ﺖﻧﺍ ـﺎﻘﺑ ةﻮﻳﺍ"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "!ﻚﻨﻣ ﺮﺘﻛﺍ ﺖﻌﻤﺟ ﺎﻧﺃ !ﻲﻬﻴﻬﻴﻬﻴﻫ"}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "!ﺎﻘﺑ ﻚﻟﺎﺑ ﻲﻠﺧ"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "!1:1 ،هﺍ"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// The second map"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "!يﻭﺃ ﻖﻳﺮﻄﺑ ﺖﻧﺃ"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "!ﻲﺑﻮﻨﺠﻟﺍ ﺐﻄﻘﻟﺍ ﻲﻓ ﺶﻴﻌﺗ ﻚﻴﻠﺨﻧ مﺯﻻ"}
{"category": "LocationDialogue Location4", "line_index": 390, "text": ".اﺪﺟ ءﻲﻄﺑ ﺖﻧﺃ ،ﻢﻋ ﺎﻳ ﻪﻳﺇ"}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "؟ﺔﻟﻮﺟ ﺮﺧﺍ ﻲﻓ ﻚﺑﺍﺭ ﻪﻳﺇ"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "!لﺩﺎﻌﺗ ﻞﺼﺤﻴﺑ ﻦﻴﻓﻭ ﻦﻴﻓ هﺩ !لﺩﺎﻌﺘﻟﺍ ،هﺎﻳ"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// The game is over"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "؟ﺔﻴﻧﺎﺗ ﺔﺒﻌﻟ ﺐﻌﻠﺗ ﺰﻳﺎﻋ ﺖﻧﺍ ،ﺐﻴﻃ"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "؟ﺔﻳﺎﻔﻛ صﻼﺧ ﻻﻭ"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "؟ﻪﻳﺇ ﺐﻌﻠﺘﺑ ﺖﻧﺍ ﻮﻫ"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "؟يﺩ يﺯ ﻲﻠﻟﺍ بﺎﻌﻟﻻﺍ ﺐﺤﺗ ﻚﻴﻠﺨﻴﺑ ﻲﻠﻟﺍ ﻪﺑﺍ"}
