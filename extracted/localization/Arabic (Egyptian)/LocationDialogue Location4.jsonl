{"category": "LocationDialogue Location4", "line_index": 330, "text": "؟ﺲﺑﻼﻤﻟﺍﻭ ﺐﻃ"}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "هﺩ ﺶﺒﻠﻟﺍ ﺮﻴﻏ ﺶﻳﺪﻨﻌﻣ ﺎﻧﺃ"}
{"category": "LocationDialogue Location4", "line_index": 332, "text": ".هﺩ ﻢﻟﺎﻌﻟﺍ ﻲﻓ"}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "؟ﺪﻳﺪﺟ ﺲﺒﻟ ﻲﻠﻋ ﻚﺑﺎﺴﺣ ﺔﻠﻣﺎﻋ ﻲﺘﻧﺇ ﺐﻃ"}
{"category": "LocationDialogue Location4", "line_index": 334, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 335, "text": ".ﻪﻴﻓ ﺪﻴﻛﺍ"}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "-ﻪﻳﺇ ﺲﺒﻠﺘﺑ ﺖﻧﺍ ﺖﻓﻮﺷ ﺎﻧﺍ"}
{"category": "LocationDialogue Location4", "line_index": 337, "text": ".ﻮﻠﺣ ﺶﻣ ﻚﻗﻭﺫ ،ﺔﺣﺍﺮﺼﺑﻭ"}
{"category": "LocationDialogue Location4", "line_index": 338, "text": ".ﺲﺑﻼﻤﻟﺍ رﺎﺨﺗ ﻚﻧﺍ ﻲﻓ كﺪﻋﺎﺳﺍ رﺪﻗﺍ ﺲﺑ"}
{"category": "LocationDialogue Location4", "line_index": 339, "text": ".ﻲﺘﻗﻮﻟﺩ ﺶﻣ ﺲﺑ"}
{"category": "LocationDialogue Location4", "line_index": 340, "text": ".ﺶﻘﻠﻘﺘﻣ"}
{"category": "LocationDialogue Location4", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 342, "text": ".ﻲﺷﺎﻣ"}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Games on TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "؟ﺔﺒﻌﻟ ﺐﻌﻠﺗ ﺰﻳﺎﻋ"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Game milk"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "!ﺔﻋﺭﺎﺼﻣ ﺔﺒﻌﻟ يﺩ"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "!لﻭﻷﺍ ﻖﻟﺪﻴﻫ ﻲﻠﻟﺍ ﻦﻴﻣ فﻮﺸﻨﻫ"}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "!؟يﺩ ﺔﺒﻌﻠﻟﺍ ﻪﻳﺇ"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": ".ﺔﻴﻧﺎﺗ ﺔﺟﺎﺣ فﻮﺸﻧ ﺎﻨﻴﻠﺧ ،صﻼﺧ ﻦﺒﻟ ﺔﻳﺎﻔﻛ"}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Game penguins"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "ﻖﻳﺮﻄﺑ ﺖﻧﺍ يﺩ ﺔﺒﻌﻠﻟﺍ ﻲﻓ"}
{"category": "LocationDialogue Location4", "line_index": 354, "text": ".ﻖﻠﺣﺰﺘﺘﺑ"}
{"category": "LocationDialogue Location4", "line_index": 355, "text": ".ﺔﺒﻌﻠﻟﺍ يﺩ ﻲﻫ ﺲﺑ"}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "؟ﺪﺠﺑ ؟هﺩ ﻪﻳﺍ"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "...ﺎﻨﻫ ﻚﺘﺒﺟ ﻲﻠﻟﺍ ﺎﻧﺍ ؟لﻮﻘﻌﻣ ﺶﻣ"}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "!طﺎﺴﺒﻣﻻﺍ ﻦﻣ ﻖﻄﻫ ﺎﻧﺍ"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "...ﻪﻳﺍ لﻮﻗﺍ ﺔﻓﺭﺎﻋ ﺶﻣ"}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "...ﺲﺑ"}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "...ﺎﻳﺎﻌﻣ ﺪﻌﻗﺍ ﻲﺒﻨﻟﺍﻭ"}
{"category": "LocationDialogue Location4", "line_index": 364, "text": ".ﺪــــــــﺑﻼﻟ"}
