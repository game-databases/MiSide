{"category": "LocationDialogue Location4", "line_index": 0, "text": "؟ﺎﺘﻴﻣ"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "؟ﺖﻴﺤﺻ ﺖﻧﺍ ؟هﺩ ﻪﻳﺇ"}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "؟يﺍﺯﺇ ﺎﻨﻫ ﻲﺘﻴﺟ"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": ".ﺔﻳﻮﺷ ﻦﻣ ﻲﺒﻧﺎﺟ ﻪﺴﻟ ﻲﺘﻨﻛ ﻲﺘﻧﺇ"}
{"category": "LocationDialogue Location4", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 5, "text": ".كﺎﻌﻣ ﺖﻨﻛ ﺎﻧﺃ ﻻ"}
{"category": "LocationDialogue Location4", "line_index": 6, "text": ".ﺮﻴﺘﻛ ﺎﻳﺍﺮﻤﻟﺍ ﻲﻓ ﺖﺤﻨﺗ ﺖﻧﺍ ﺲﺑ"}
{"category": "LocationDialogue Location4", "line_index": 7, "text": ".ﺖﻴﺸﻣﻭ ﻚﺘﺒﺴﻓ"}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "؟تﺮﻴﻐﺗﺍ ضﻭﻻﺍ ﻦﻛﺎﻣﺃ ﻪﻴﻟ"}
{"category": "LocationDialogue Location4", "line_index": 9, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "... ﻚﺘﻴﺑ ﻪﻧﺍ ﺲﺤﺗ نﺎﺸﻠﻋ"}
{"category": "LocationDialogue Location4", "line_index": 11, "text": ".ﺪﻳﺪﺟﻭ لﻭﺃ ﻦﻣ ضﻭﻻﺍ ﺐﻴﺗﺮﺗ تﺮﻴﻏ ﺖﻤﻘﻓ"}
{"category": "LocationDialogue Location4", "line_index": 12, "text": ".ﺢﺻﺍ ﻲﻨﻌﻤﺑ"}
{"category": "LocationDialogue Location4", "line_index": 13, "text": ".ضﻭﻻﺍ ﻦﻛﺎﻣﺍ ﺮﻴﻐﻧ رﺪﻘﻧ"}
{"category": "LocationDialogue Location4", "line_index": 14, "text": ".ﻦﻴﻴﺑﺎﺣ ﺎﻨﺣﺍ ﺎﻣ يﺯ"}
{"category": "LocationDialogue Location4", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 16, "text": ".ﺖﻴﺒﻟﺍ ﻲﻠﻋ تﺩﻮﻌﺗﺍ ﺎﻧﺍ ﺲﺑ"}
{"category": "LocationDialogue Location4", "line_index": 17, "text": ".ﻲﻧﺎﺗ ﻦﻣ ضﻭﻻﺍ ﺐﻴﺗﺮﺗ ﺮﻴﻐﻧ ﺎﻨﻧﺍ ﻲﻋﺍﺩ شﺎﻬﻠﻣ"}
{"category": "LocationDialogue Location4", "line_index": 18, "text": ".ﻚﺒﺠﻌﻳ ﺖﻴﺒﻟﺍ ﺐﻴﺗﺮﺗ نﺍ ﻲﻨﻤﺘﺑ ،ﺎﻣﻮﻤﻋ ﻮﻫ"}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Mita card game"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "ﻻﺎﻳ"}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "تﻭﺮﻜﻟﺍ ﺐﻌﻠﻧ ..."}
