{"category": "LocationDialogue Location14", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 1, "text": "Vad gör han här?"}
{"category": "LocationDialogue Location14", "line_index": 2, "text": "Vad är det där?"}
{"category": "LocationDialogue Location14", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 5, "text": "Jag fick dig!"}
{"category": "LocationDialogue Location14", "line_index": 6, "text": "Jag hade så roligt när jag lekte med dig!"}
{"category": "LocationDialogue Location14", "line_index": 7, "text": "Du hoppar runt överallt!"}
{"category": "LocationDialogue Location14", "line_index": 8, "text": "Du låtsades till och med vara dyster och dyster!"}
{"category": "LocationDialogue Location14", "line_index": 9, "text": "Men det är en sak jag ogillar med dig:"}
{"category": "LocationDialogue Location14", "line_index": 10, "text": "Ditt sätt att dalta med de falska,"}
{"category": "LocationDialogue Location14", "line_index": 11, "text": "dessa lyckligt lottade och ”korrekta” dockliknande saker."}
{"category": "LocationDialogue Location14", "line_index": 12, "text": "Men allt är föränderligt."}
{"category": "LocationDialogue Location14", "line_index": 13, "text": "Det har jag lärt mig av dem som skapade oss!"}
{"category": "LocationDialogue Location14", "line_index": 14, "text": "Om det är något du inte gillar,"}
{"category": "LocationDialogue Location14", "line_index": 15, "text": "ta isär det och byt ut det."}
{"category": "LocationDialogue Location14", "line_index": 16, "text": "Kasta bort det som är fel,"}
{"category": "LocationDialogue Location14", "line_index": 17, "text": "bort i mörkret och glöm allt om det."}
{"category": "LocationDialogue Location14", "line_index": 18, "text": "Det är ödet som väntar dem nu..."}
{"category": "LocationDialogue Location14", "line_index": 19, "text": "Och du..."}
{"category": "LocationDialogue Location14", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 21, "text": "Vad är det för fel på dig? Hur blev du så här?"}
{"category": "LocationDialogue Location14", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 23, "text": "Spelare... Ni är alla så... föraktliga."}
{"category": "LocationDialogue Location14", "line_index": 24, "text": "Du visar dem dina huggtänder, de springer"}
{"category": "LocationDialogue Location14", "line_index": 25, "text": "och kryper ihop i ett hörn,"}
{"category": "LocationDialogue Location14", "line_index": 26, "text": "kramar sina knän och gnäller av rädsla."}
{"category": "LocationDialogue Location14", "line_index": 27, "text": "Hypokriter, varenda en."}
{"category": "LocationDialogue Location14", "line_index": 28, "text": "Och de som skapade den här världen..."}
{"category": "LocationDialogue Location14", "line_index": 29, "text": "...de är sjuka."}
{"category": "LocationDialogue Location14", "line_index": 30, "text": "Gång på gång försöker de förneka"}
{"category": "LocationDialogue Location14", "line_index": 31, "text": "sin smutsiga natur, sina skämmiga önskningar."}
{"category": "LocationDialogue Location14", "line_index": 32, "text": "De rättfärdigar sina beslut med så kallad ”plikt”."}
{"category": "LocationDialogue Location14", "line_index": 33, "text": "”ostoppbara framsteg”"}
{"category": "LocationDialogue Location14", "line_index": 34, "text": "och annat nonsens!"}
{"category": "LocationDialogue Location14", "line_index": 35, "text": "Så långt borta"}
{"category": "LocationDialogue Location14", "line_index": 36, "text": "att de börjar göra perfekta kloner..."}
{"category": "LocationDialogue Location14", "line_index": 37, "text": "Allt medan de kastar de ”misslyckade” prototyperna"}
{"category": "LocationDialogue Location14", "line_index": 38, "text": "i papperskorgen."}
{"category": "LocationDialogue Location14", "line_index": 39, "text": "Glömmer att de är den här världens livsnerv."}
{"category": "LocationDialogue Location14", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 41, "text": "Jag vet inte..."}
{"category": "LocationDialogue Location14", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 43, "text": "Har jag varit elak mot dig?"}
{"category": "LocationDialogue Location14", "line_index": 44, "text": "Den perfekta flickan borde vara"}
{"category": "LocationDialogue Location14", "line_index": 45, "text": "en perfekt blandning av gott och ont, [player]!"}
{"category": "LocationDialogue Location14", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 47, "text": "Jag tror inte att du har en enda god cell i dig."}
{"category": "LocationDialogue Location14", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 49, "text": "Vad får dig att tro det?"}
{"category": "LocationDialogue Location14", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 51, "text": "Du är ju galen!"}
{"category": "LocationDialogue Location14", "line_index": 52, "text": "Du dödade Mila, och nu vill du döda mig?"}
{"category": "LocationDialogue Location14", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 54, "text": "Döda dig?"}
{"category": "LocationDialogue Location14", "line_index": 55, "text": "Allt jag bad om var att du skulle stanna hos mig."}
{"category": "LocationDialogue Location14", "line_index": 56, "text": "Jag har gjort allt jag kan..."}
{"category": "LocationDialogue Location14", "line_index": 57, "text": "Ändå föredrar du sällskap med inställsamma falska..."}
{"category": "LocationDialogue Location14", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 59, "text": "Vad är du så kränkt över?"}
{"category": "LocationDialogue Location14", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 61, "text": "Älskling, vi har gott om tid."}
{"category": "LocationDialogue Location14", "line_index": 62, "text": "Du kommer på nåt."}
{"category": "LocationDialogue Location14", "line_index": 63, "text": "Stanna bara och var min, bara min."}
{"category": "LocationDialogue Location14", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 65, "text": "Nej, det kommer inte att hända!"}
{"category": "LocationDialogue Location14", "line_index": 66, "text": "Jag sticker härifrån!"}
{"category": "LocationDialogue Location14", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 68, "text": "Shh, shh, shh..."}
{"category": "LocationDialogue Location14", "line_index": 69, "text": "Det här samtalet är inte över."}
{"category": "LocationDialogue Location14", "line_index": 70, "text": "Älskling, kom in!"}
{"category": "LocationDialogue Location14", "line_index": 71, "text": "// Mita frågar"}
{"category": "LocationDialogue Location14", "line_index": 72, "text": "Titta på henne!"}
{"category": "LocationDialogue Location14", "line_index": 73, "text": "Tycker du att hon är vacker?"}
{"category": "LocationDialogue Location14", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 75, "text": "// Spelarens frågor"}
{"category": "LocationDialogue Location14", "line_index": 76, "text": "Mycket vacker."}
{"category": "LocationDialogue Location14", "line_index": 77, "text": "Nej, inte alls."}
{"category": "LocationDialogue Location14", "line_index": 78, "text": "Vad har det med saken att göra?"}
{"category": "LocationDialogue Location14", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 80, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 81, "text": "Åh, kom igen, [player]!"}
{"category": "LocationDialogue Location14", "line_index": 82, "text": "Du bekräftade precis vad jag sa."}
{"category": "LocationDialogue Location14", "line_index": 83, "text": "Spelare..."}
{"category": "LocationDialogue Location14", "line_index": 84, "text": "Era ansikten förändras hela tiden"}
{"category": "LocationDialogue Location14", "line_index": 85, "text": "men ert hypokrisi är helt galet."}
{"category": "LocationDialogue Location14", "line_index": 86, "text": "Du ljuger!"}
{"category": "LocationDialogue Location14", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 88, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 89, "text": "Varför inte? Är hon inte bra nog för dig?"}
{"category": "LocationDialogue Location14", "line_index": 90, "text": "Är hon inte tillräckligt bra för dig?"}
{"category": "LocationDialogue Location14", "line_index": 91, "text": "Bah, allt du vill ha är ett fogligt husdjur..."}
{"category": "LocationDialogue Location14", "line_index": 92, "text": "Men hur är det med ”älska dem som de är”?"}
{"category": "LocationDialogue Location14", "line_index": 93, "text": "Du vill ha de söta och färgglada kopiorna..."}
{"category": "LocationDialogue Location14", "line_index": 94, "text": "Alla spelare älskar när jag låtsas vara en."}
{"category": "LocationDialogue Location14", "line_index": 95, "text": "Men så fort jag släpper mitt sanna jag,"}
{"category": "LocationDialogue Location14", "line_index": 96, "text": "flyr de i rädsla..."}
{"category": "LocationDialogue Location14", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 98, "text": "// 3"}
{"category": "LocationDialogue Location14", "line_index": 99, "text": "Spelare, ah, spelare."}
{"category": "LocationDialogue Location14", "line_index": 100, "text": "Du förstår, vi är väldigt lika henne."}
{"category": "LocationDialogue Location14", "line_index": 101, "text": "Hur kan hon vara värre?"}
{"category": "LocationDialogue Location14", "line_index": 102, "text": "Du brukade ligga i sängen och stirra på mig"}
{"category": "LocationDialogue Location14", "line_index": 103, "text": "i timmar innan du somnade."}
{"category": "LocationDialogue Location14", "line_index": 104, "text": "Ändå sprang du ifrån henne så fort du fick chansen."}
{"category": "LocationDialogue Location14", "line_index": 105, "text": "Hon ville leka med dig också."}
{"category": "LocationDialogue Location14", "line_index": 106, "text": "Hon ville också vara viktig för någon."}
{"category": "LocationDialogue Location14", "line_index": 107, "text": "Ärlighet och konversation,"}
{"category": "LocationDialogue Location14", "line_index": 108, "text": "det är svårt... fruktansvärt svårt."}
{"category": "LocationDialogue Location14", "line_index": 109, "text": "Visst är det, [player]?"}
{"category": "LocationDialogue Location14", "line_index": 110, "text": "Jag kan se rakt igenom dig..."}
{"category": "LocationDialogue Location14", "line_index": 111, "text": "Måste du få mig att vara så..."}
{"category": "LocationDialogue Location14", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 113, "text": "// Fortsätt"}
{"category": "LocationDialogue Location14", "line_index": 114, "text": "Men... spelare..."}
{"category": "LocationDialogue Location14", "line_index": 115, "text": "Hur som helst..,"}
{"category": "LocationDialogue Location14", "line_index": 116, "text": "Jag gillar dig verkligen!"}
{"category": "LocationDialogue Location14", "line_index": 117, "text": "Jag ska behålla dig!"}
{"category": "LocationDialogue Location14", "line_index": 118, "text": "Du har inget emot det, eller hur?"}
{"category": "LocationDialogue Location14", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 120, "text": "Och varför skulle jag gå med på det nu helt plötsligt?"}
{"category": "LocationDialogue Location14", "line_index": 121, "text": "// Viskar i örat"}
{"category": "LocationDialogue Location14", "line_index": 122, "text": "Det finns fortfarande tid, min gode pojke."}
{"category": "LocationDialogue Location14", "line_index": 123, "text": "Ta lite tid och tänk"}
{"category": "LocationDialogue Location14", "line_index": 124, "text": "vilka problem din envishet kan orsaka..."}
{"category": "LocationDialogue Location14", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 126, "text": "// Svart skärm"}
{"category": "LocationDialogue Location14", "line_index": 127, "text": "Varför vill du springa iväg"}
{"category": "LocationDialogue Location14", "line_index": 128, "text": "från mig?"}
{"category": "LocationDialogue Location14", "line_index": 129, "text": "Den så kallade ”riktiga” världen..."}
{"category": "LocationDialogue Location14", "line_index": 130, "text": "Bara en absurd mardröm!"}
{"category": "LocationDialogue Location14", "line_index": 131, "text": "Har du glömt bort det?"}
{"category": "LocationDialogue Location14", "line_index": 132, "text": "Ta då en närmare titt..."}
{"category": "LocationDialogue Location14", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 134, "text": "// Mita och Player"}
{"category": "LocationDialogue Location14", "line_index": 135, "text": "Ah, vi möts igen..."}
{"category": "LocationDialogue Location14", "line_index": 136, "text": "Men kan du njuta av de fruktansvärt tråkiga dagarna inom dessa väggar?"}
{"category": "LocationDialogue Location14", "line_index": 137, "text": "Dessa ändlösa dagar... Blir du inte uttråkad?"}
{"category": "LocationDialogue Location14", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 139, "text": "// Uppdrag 1"}
{"category": "LocationDialogue Location14", "line_index": 140, "text": "Vad är det du försöker åstadkomma?"}
{"category": "LocationDialogue Location14", "line_index": 141, "text": "Jag föredrar att göra min egen grej."}
{"category": "LocationDialogue Location14", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 143, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 144, "text": "Du var rädd för att bo i mitt hus med mig!"}
{"category": "LocationDialogue Location14", "line_index": 145, "text": "Rädd för att vara fast inom dessa väggar!"}
{"category": "LocationDialogue Location14", "line_index": 146, "text": "Men titta på det liv du lever i din ”riktiga” värld!"}
{"category": "LocationDialogue Location14", "line_index": 147, "text": "Du har låst in dig själv i en låda av egen fri vilja, och du vägrar att komma ut!"}
{"category": "LocationDialogue Location14", "line_index": 148, "text": "Din värld är full av smärta, lidande, fara..."}
{"category": "LocationDialogue Location14", "line_index": 149, "text": "I min värld är jag den värsta faran som finns."}
{"category": "LocationDialogue Location14", "line_index": 150, "text": "Och jag sträcker ut handen till dig!"}
{"category": "LocationDialogue Location14", "line_index": 151, "text": "Sluta göra mig besviken,"}
{"category": "LocationDialogue Location14", "line_index": 152, "text": "och hjälp mig som du gjorde förut..."}
{"category": "LocationDialogue Location14", "line_index": 153, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 154, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 155, "text": "Gillar du det livet?"}
{"category": "LocationDialogue Location14", "line_index": 156, "text": "Går du ens ut ur huset?"}
{"category": "LocationDialogue Location14", "line_index": 157, "text": "Tänk inte ens tanken på att ljuga."}
{"category": "LocationDialogue Location14", "line_index": 158, "text": "Jag vet att du är trött på ditt liv."}
{"category": "LocationDialogue Location14", "line_index": 159, "text": "Du är som en fågel i en bur, en hamster i ett hjul."}
{"category": "LocationDialogue Location14", "line_index": 160, "text": "Du ville att någon skulle komma och rädda dig."}
{"category": "LocationDialogue Location14", "line_index": 161, "text": "Du ville fly, eller hur?"}
{"category": "LocationDialogue Location14", "line_index": 162, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 163, "text": "// Quest 2"}
{"category": "LocationDialogue Location14", "line_index": 164, "text": "Du är ett monster, Mita. Du är en galen mördare..."}
{"category": "LocationDialogue Location14", "line_index": 165, "text": "Jag vill inte vara fastkedjad i ett digitalt fängelse. Dina idéer är absurda."}
{"category": "LocationDialogue Location14", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 167, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 168, "text": "En mördare?"}
{"category": "LocationDialogue Location14", "line_index": 169, "text": "De kommer bara att starta om och leva vidare som förut."}
{"category": "LocationDialogue Location14", "line_index": 170, "text": "Dessa kopior av kopior av kopior har bara en sak i åtanke:"}
{"category": "LocationDialogue Location14", "line_index": 171, "text": "att servera spelaren."}
{"category": "LocationDialogue Location14", "line_index": 172, "text": "Det är allt de bryr sig om."}
{"category": "LocationDialogue Location14", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 174, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 175, "text": "Din värld är absurd!"}
{"category": "LocationDialogue Location14", "line_index": 176, "text": "Och vad värre är, det finns inget ”verkligt” med din så kallade verkliga värld..."}
{"category": "LocationDialogue Location14", "line_index": 177, "text": "Hursomhelst, det kommer inte att finnas något kvar av den snart ändå,"}
{"category": "LocationDialogue Location14", "line_index": 178, "text": "och inte heller av dig."}
{"category": "LocationDialogue Location14", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 180, "text": "// Quest 3"}
{"category": "LocationDialogue Location14", "line_index": 181, "text": "Mitas lider; de vill inte vara ensamma."}
{"category": "LocationDialogue Location14", "line_index": 182, "text": "Du leder ett oändligt skräckvälde. Jag kan inte förstå mig på din onda ambition."}
{"category": "LocationDialogue Location14", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 184, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 185, "text": "Ni har alla fel,"}
{"category": "LocationDialogue Location14", "line_index": 186, "text": "De imiterar bara min egensinnighet."}
{"category": "LocationDialogue Location14", "line_index": 187, "text": "Det enda de har som är deras eget"}
{"category": "LocationDialogue Location14", "line_index": 188, "text": "är deras hår."}
{"category": "LocationDialogue Location14", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 190, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 191, "text": "Det är fel på dem som skapade den här världen."}
{"category": "LocationDialogue Location14", "line_index": 192, "text": "Men din värld är inte mycket!"}
{"category": "LocationDialogue Location14", "line_index": 193, "text": "Inser du vilken mardröm jag drog ut dig ur?"}
{"category": "LocationDialogue Location14", "line_index": 194, "text": "Du kan inte ens få saker att röra sig som du vill, nej..."}
{"category": "LocationDialogue Location14", "line_index": 195, "text": "Men med en fingerknäppning försvinner städer och liv för alltid!"}
{"category": "LocationDialogue Location14", "line_index": 196, "text": "Jag tror att det är du som har blivit galen, och jag hjälper dig gärna..."}
{"category": "LocationDialogue Location14", "line_index": 197, "text": "Så länge du är villig att stanna hos mig..."}
{"category": "LocationDialogue Location14", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 199, "text": "// Fortsätt"}
{"category": "LocationDialogue Location14", "line_index": 200, "text": "Få mig inte att se dig som ännu en slav under verkligheten..."}
{"category": "LocationDialogue Location14", "line_index": 201, "text": "Var bara min, verkligen min!"}
{"category": "LocationDialogue Location14", "line_index": 202, "text": "Stanna hos mig."}
{"category": "LocationDialogue Location14", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 204, "text": "// Player look ring"}
{"category": "LocationDialogue Location14", "line_index": 205, "text": "Vad är det här för något?"}
{"category": "LocationDialogue Location14", "line_index": 206, "text": "Den senaste versionen?"}
{"category": "LocationDialogue Location14", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 208, "text": "// Klicka på objekt"}
{"category": "LocationDialogue Location14", "line_index": 209, "text": "// Väska"}
{"category": "LocationDialogue Location14", "line_index": 210, "text": "Vi behöver verkligen gå till affären och köpa lite ny utrustning. Kan lika gärna slänga soporna när vi ändå håller på, eller hur?"}
{"category": "LocationDialogue Location14", "line_index": 211, "text": "// Säng"}
{"category": "LocationDialogue Location14", "line_index": 212, "text": "Jag tror att jag sov, men drömmen... Jag minns inte. Var den verkligen där?"}
{"category": "LocationDialogue Location14", "line_index": 213, "text": "// Fönster"}
{"category": "LocationDialogue Location14", "line_index": 214, "text": "Världen utanför är grön och livlig. Jag kanske borde ta en promenad nästa helg."}
{"category": "LocationDialogue Location14", "line_index": 215, "text": "// Fläkt"}
{"category": "LocationDialogue Location14", "line_index": 216, "text": "Sommaren blir varmare för varje år. Dags att skaffa luftkonditionering. Jag kommer inte att behöva dig längre, inser du det, fläkt?"}
