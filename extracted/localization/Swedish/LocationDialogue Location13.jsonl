{"category": "LocationDialogue Location13", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 1, "text": "Ringen."}
{"category": "LocationDialogue Location13", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 3, "text": "// Svar 1 (Var har du varit hela den här tiden?)"}
{"category": "LocationDialogue Location13", "line_index": 4, "text": "Jag har letat efter ett sätt att få dig till kärnan."}
{"category": "LocationDialogue Location13", "line_index": 5, "text": "Allt i ett helt stycke, så klart."}
{"category": "LocationDialogue Location13", "line_index": 6, "text": "Det var planen hela tiden, eller hur?"}
{"category": "LocationDialogue Location13", "line_index": 7, "text": "Det var därför jag var tvungen att undvika"}
{"category": "LocationDialogue Location13", "line_index": 8, "text": "Galna Mita, eller hur?"}
{"category": "LocationDialogue Location13", "line_index": 9, "text": "Jag var också tvungen att gräva upp all info jag kunde"}
{"category": "LocationDialogue Location13", "line_index": 10, "text": "om det jävla universums bakgrund, var det inte så?"}
{"category": "LocationDialogue Location13", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 12, "text": "Jag antar...?"}
{"category": "LocationDialogue Location13", "line_index": 13, "text": "Men hur ställde du in ringens rutt?"}
{"category": "LocationDialogue Location13", "line_index": 14, "text": "Varför hamnade jag i en buggig version"}
{"category": "LocationDialogue Location13", "line_index": 15, "text": "full av faror?"}
{"category": "LocationDialogue Location13", "line_index": 16, "text": "Jag flydde bara genom att"}
{"category": "LocationDialogue Location13", "line_index": 17, "text": "hoppa in i ett oändligt mörker."}
{"category": "LocationDialogue Location13", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 19, "text": "Förlåt, jag glömde att berätta i detalj"}
{"category": "LocationDialogue Location13", "line_index": 20, "text": "vad du behövde göra..."}
{"category": "LocationDialogue Location13", "line_index": 21, "text": "Men ja, det var planen för dig"}
{"category": "LocationDialogue Location13", "line_index": 22, "text": "att ta språnget hela tiden..."}
{"category": "LocationDialogue Location13", "line_index": 23, "text": "Och ja, du gjorde det!"}
{"category": "LocationDialogue Location13", "line_index": 24, "text": "Bra jobbat!"}
{"category": "LocationDialogue Location13", "line_index": 25, "text": "Okej, låt oss gå vidare med planen."}
{"category": "LocationDialogue Location13", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 27, "text": "// Svar 2 (Hur kom du hit?)"}
{"category": "LocationDialogue Location13", "line_index": 28, "text": "Du måste ha gått igenom en hel del,"}
{"category": "LocationDialogue Location13", "line_index": 29, "text": "med tanke på att du glömt vad vi pratade om."}
{"category": "LocationDialogue Location13", "line_index": 30, "text": "Jag är Mita, jag kan flytta mellan versioner"}
{"category": "LocationDialogue Location13", "line_index": 31, "text": "som det passar mig, minns du?"}
{"category": "LocationDialogue Location13", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 33, "text": "Inte alla Mita kan göra det,"}
{"category": "LocationDialogue Location13", "line_index": 34, "text": "Jag har sett några som inte kan det."}
{"category": "LocationDialogue Location13", "line_index": 35, "text": "Och de lider tydligen."}
{"category": "LocationDialogue Location13", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 37, "text": "Ja, deras versioner är trasiga,"}
{"category": "LocationDialogue Location13", "line_index": 38, "text": "deras världar är buggade. Jag sa ju det förut."}
{"category": "LocationDialogue Location13", "line_index": 39, "text": "Fan också..."}
{"category": "LocationDialogue Location13", "line_index": 40, "text": "Du vet vem som ligger bakom allt det här, eller hur?"}
{"category": "LocationDialogue Location13", "line_index": 41, "text": "Galna Mita."}
{"category": "LocationDialogue Location13", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 43, "text": "Ja, det är helt säkert hon..."}
{"category": "LocationDialogue Location13", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 45, "text": "// Svar 3 (Vem var den här Mita nyss?)"}
{"category": "LocationDialogue Location13", "line_index": 46, "text": "Det är Fula Mita."}
{"category": "LocationDialogue Location13", "line_index": 47, "text": "Aggressiv och dum."}
{"category": "LocationDialogue Location13", "line_index": 48, "text": "Man kan inte prata förstånd med henne,"}
{"category": "LocationDialogue Location13", "line_index": 49, "text": "hela hennes värld är centrerad kring Galna Mita."}
{"category": "LocationDialogue Location13", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 51, "text": "Ja, jag har märkt det."}
{"category": "LocationDialogue Location13", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 53, "text": "Kom igen, vi måste komma till kärnan."}
{"category": "LocationDialogue Location13", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 55, "text": "// Svar 4 (Hur fungerar ringen?)"}
{"category": "LocationDialogue Location13", "line_index": 56, "text": "Och ringen,"}
{"category": "LocationDialogue Location13", "line_index": 57, "text": "är det den enda vägen till kärnan?"}
{"category": "LocationDialogue Location13", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 59, "text": "Ja, det är den."}
{"category": "LocationDialogue Location13", "line_index": 60, "text": "Naturligtvis, om vi hade portalen"}
{"category": "LocationDialogue Location13", "line_index": 61, "text": "kunde vi bara teleportera"}
{"category": "LocationDialogue Location13", "line_index": 62, "text": "dig rätt dit."}
{"category": "LocationDialogue Location13", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 64, "text": "Finns det någon fördel med ringen?"}
{"category": "LocationDialogue Location13", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 66, "text": "Ja, självklart!"}
{"category": "LocationDialogue Location13", "line_index": 67, "text": "Den är lätt att bära,"}
{"category": "LocationDialogue Location13", "line_index": 68, "text": "och minns versionerna"}
{"category": "LocationDialogue Location13", "line_index": 69, "text": "du har besökt tidigare,"}
{"category": "LocationDialogue Location13", "line_index": 70, "text": "så att du lätt kan hitta tillbaka dit."}
{"category": "LocationDialogue Location13", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 72, "text": "// Svar 5 (Varför behöver Mad Mita mig?)"}
{"category": "LocationDialogue Location13", "line_index": 73, "text": "Varför låter inte Galna Mita mig vara?"}
{"category": "LocationDialogue Location13", "line_index": 74, "text": "Hon har dragit in mig i sitt livsfarliga spel,"}
{"category": "LocationDialogue Location13", "line_index": 75, "text": "men jag lever fortfarande..."}
{"category": "LocationDialogue Location13", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 77, "text": "Min gissning"}
{"category": "LocationDialogue Location13", "line_index": 78, "text": "är att hon letar efter en lämplig spelare..."}
{"category": "LocationDialogue Location13", "line_index": 79, "text": "En som accepterar henne för den hon är."}
{"category": "LocationDialogue Location13", "line_index": 80, "text": "Mita är ju trots allt Mita!"}
{"category": "LocationDialogue Location13", "line_index": 81, "text": "Men det kommer ju aldrig att hända,"}
{"category": "LocationDialogue Location13", "line_index": 82, "text": "förvandlar hon spelare till kassetter,"}
{"category": "LocationDialogue Location13", "line_index": 83, "text": "så att ingen nånsin kan rymma..."}
{"category": "LocationDialogue Location13", "line_index": 84, "text": "Det är i alla fall min gissning."}
{"category": "LocationDialogue Location13", "line_index": 85, "text": "Hur som helst, låt oss fokusera på det som är viktigt."}
{"category": "LocationDialogue Location13", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 87, "text": "// Svar 6 (Är detta kärnan?)"}
{"category": "LocationDialogue Location13", "line_index": 88, "text": "Är det här kärnan?"}
{"category": "LocationDialogue Location13", "line_index": 89, "text": "Kärnan?"}
{"category": "LocationDialogue Location13", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 91, "text": "Ja, det är det. Kärnan."}
{"category": "LocationDialogue Location13", "line_index": 92, "text": "Jag har försökt förklara,"}
{"category": "LocationDialogue Location13", "line_index": 93, "text": "ni spelare är inte riktigt en del av den här världen..."}
{"category": "LocationDialogue Location13", "line_index": 94, "text": "Det betyder att ni inte behöver särskilt tillstånd för att komma in."}
{"category": "LocationDialogue Location13", "line_index": 95, "text": "Eller, det är vad jag tror, i alla fall."}
{"category": "LocationDialogue Location13", "line_index": 96, "text": "Hursomhelst, jag är mer än säker på"}
{"category": "LocationDialogue Location13", "line_index": 97, "text": "att lösningen på alla våra problem"}
{"category": "LocationDialogue Location13", "line_index": 98, "text": "kan hittas där inne!"}
{"category": "LocationDialogue Location13", "line_index": 99, "text": "[player], gå in."}
{"category": "LocationDialogue Location13", "line_index": 100, "text": "Jag har faktiskt varit där en gång."}
{"category": "LocationDialogue Location13", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 102, "text": "// Titta på CoreMita"}
{"category": "LocationDialogue Location13", "line_index": 103, "text": "Försiktigt, [player]."}
{"category": "LocationDialogue Location13", "line_index": 104, "text": "Den tittar på dig."}
{"category": "LocationDialogue Location13", "line_index": 105, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 106, "text": "Vem då?"}
{"category": "LocationDialogue Location13", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 108, "text": "Jag vet inte heller..."}
{"category": "LocationDialogue Location13", "line_index": 109, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 110, "text": "Coolt..."}
{"category": "LocationDialogue Location13", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 113, "text": "Vad är det där?"}
{"category": "LocationDialogue Location13", "line_index": 114, "text": "Hallå där!"}
{"category": "LocationDialogue Location13", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 116, "text": "Jag tror jag har hittat det!"}
{"category": "LocationDialogue Location13", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 118, "text": "Fantastiskt! Det är ju toppen!"}
{"category": "LocationDialogue Location13", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 120, "text": "Men jag måste specificera en version."}
{"category": "LocationDialogue Location13", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 122, "text": "Okej, hennes version är..."}
{"category": "LocationDialogue Location13", "line_index": 123, "text": "0.98."}
{"category": "LocationDialogue Location13", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 125, "text": "Bingo!"}
{"category": "LocationDialogue Location13", "line_index": 126, "text": "Okej, och vilket index?"}
{"category": "LocationDialogue Location13", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 128, "text": "Eh, index?"}
{"category": "LocationDialogue Location13", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 130, "text": "Jag behöver indexet."}
{"category": "LocationDialogue Location13", "line_index": 131, "text": "Vänta, säg inte att du inte vet...?"}
{"category": "LocationDialogue Location13", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 134, "text": "Hmm, det låter logiskt, men..."}
{"category": "LocationDialogue Location13", "line_index": 135, "text": "Varje Mita har ett index,"}
{"category": "LocationDialogue Location13", "line_index": 136, "text": "så du kan inte bara starta om en hel version..."}
{"category": "LocationDialogue Location13", "line_index": 137, "text": "Det skulle orsaka total kaos!"}
{"category": "LocationDialogue Location13", "line_index": 138, "text": "Jag kan inte fatta att jag inte tänkte på det..."}
{"category": "LocationDialogue Location13", "line_index": 139, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 144, "text": "// Svar 1 (Vad är det för fel på dig?)"}
{"category": "LocationDialogue Location13", "line_index": 145, "text": "Spara för alla våra problem,"}
{"category": "LocationDialogue Location13", "line_index": 146, "text": "Jag är helt okej."}
{"category": "LocationDialogue Location13", "line_index": 147, "text": "Allt är bra, men mycket har förändrats..."}
{"category": "LocationDialogue Location13", "line_index": 148, "text": "Jag behöver tänka."}
{"category": "LocationDialogue Location13", "line_index": 149, "text": "Och så är det med det."}
{"category": "LocationDialogue Location13", "line_index": 150, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 151, "text": "// Svar 2 (Det kanske finns ett sätt att lära känna honom?)"}
{"category": "LocationDialogue Location13", "line_index": 152, "text": "Jag..."}
{"category": "LocationDialogue Location13", "line_index": 153, "text": "Jag tror att... Det är ju helt galet!"}
{"category": "LocationDialogue Location13", "line_index": 154, "text": "Det är galenskap, hah!"}
{"category": "LocationDialogue Location13", "line_index": 155, "text": "Det är som att leta efter en nål i en..."}
{"category": "LocationDialogue Location13", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 157, "text": "Vad gör du?"}
{"category": "LocationDialogue Location13", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 159, "text": "Vissa hinder eroderar med information,"}
{"category": "LocationDialogue Location13", "line_index": 160, "text": "Du vet, som världen som får sina inre delar utslitna!"}
{"category": "LocationDialogue Location13", "line_index": 161, "text": "Loggar, loggar, loggar, data?"}
{"category": "LocationDialogue Location13", "line_index": 162, "text": "Tänk om det är allt?"}
{"category": "LocationDialogue Location13", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 164, "text": "Vad är det? Vad är det för fel?"}
{"category": "LocationDialogue Location13", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 166, "text": "Jag vet ett ställe!"}
{"category": "LocationDialogue Location13", "line_index": 167, "text": "Vänta här."}
{"category": "LocationDialogue Location13", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 169, "text": "Vart ska du ta vägen?"}
{"category": "LocationDialogue Location13", "line_index": 170, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 171, "text": "// Svar 3 (Vad händer om vi attackerar Mad Mita?)"}
{"category": "LocationDialogue Location13", "line_index": 172, "text": "Du sa att alla Mita"}
{"category": "LocationDialogue Location13", "line_index": 173, "text": "återställs till fabriksinställningarna vid döden..."}
{"category": "LocationDialogue Location13", "line_index": 174, "text": "Tänk om vi..."}
{"category": "LocationDialogue Location13", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 176, "text": "...bara dödade Galna Mita?"}
{"category": "LocationDialogue Location13", "line_index": 177, "text": "Menar du allvar?"}
{"category": "LocationDialogue Location13", "line_index": 178, "text": "Och hur ska du hantera en motorsågssvingande galen kvinna?"}
{"category": "LocationDialogue Location13", "line_index": 179, "text": "Hon skivar morötter med mer än bara knivar!"}
{"category": "LocationDialogue Location13", "line_index": 180, "text": "Och av någon anledning är hon fruktansvärt stark!"}
{"category": "LocationDialogue Location13", "line_index": 181, "text": "Det är ett mirakel att vi fortfarande lever..."}
{"category": "LocationDialogue Location13", "line_index": 182, "text": "Kom igen, vi måste till kärnan."}
{"category": "LocationDialogue Location13", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 185, "text": "// kärnans konsol inmatning"}
{"category": "LocationDialogue Location13", "line_index": 186, "text": "Vi måste gå in i en kommandoprompt..."}
{"category": "LocationDialogue Location13", "line_index": 187, "text": "Men vilken kommandoprompt?"}
{"category": "LocationDialogue Location13", "line_index": 188, "text": "Mita, vet du?"}
{"category": "LocationDialogue Location13", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 190, "text": "Det kanske står någonstans?"}
{"category": "LocationDialogue Location13", "line_index": 191, "text": "Kan du försöka leta upp det?"}
{"category": "LocationDialogue Location13", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 193, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location13", "line_index": 194, "text": "Det är nog inte det."}
{"category": "LocationDialogue Location13", "line_index": 195, "text": "Det är inte rätt heller."}
{"category": "LocationDialogue Location13", "line_index": 196, "text": "Nix, fel."}
{"category": "LocationDialogue Location13", "line_index": 197, "text": "Det är inte det."}
{"category": "LocationDialogue Location13", "line_index": 198, "text": "Jag måste hitta alternativet för karaktärsåterställning."}
{"category": "LocationDialogue Location13", "line_index": 199, "text": "// core console - nope version"}
{"category": "LocationDialogue Location13", "line_index": 200, "text": "Det är fel version."}
{"category": "LocationDialogue Location13", "line_index": 201, "text": "Oops, mitt misstag."}
{"category": "LocationDialogue Location13", "line_index": 202, "text": "Det är inte den."}
{"category": "LocationDialogue Location13", "line_index": 203, "text": "Jag behöver en annan."}
{"category": "LocationDialogue Location13", "line_index": 204, "text": "// kärnkonsol - nope index"}
{"category": "LocationDialogue Location13", "line_index": 205, "text": "Något är fel"}
{"category": "LocationDialogue Location13", "line_index": 206, "text": "med indexet."}
{"category": "LocationDialogue Location13", "line_index": 207, "text": "Jag måste ändra indexet,"}
{"category": "LocationDialogue Location13", "line_index": 208, "text": "det passar inte."}
{"category": "LocationDialogue Location13", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 210, "text": "// Svar 4 (Små människor - Chibi)"}
{"category": "LocationDialogue Location13", "line_index": 211, "text": "Du vet, jag sprang på ett gäng"}
{"category": "LocationDialogue Location13", "line_index": 212, "text": "minimänniskor på vägen..."}
{"category": "LocationDialogue Location13", "line_index": 213, "text": "Vad är de för några?"}
{"category": "LocationDialogue Location13", "line_index": 214, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 215, "text": "Chibi-människorna?"}
{"category": "LocationDialogue Location13", "line_index": 216, "text": "Uhm, hur ska jag förklara...?"}
{"category": "LocationDialogue Location13", "line_index": 217, "text": "Det är ett fenomen här..."}
{"category": "LocationDialogue Location13", "line_index": 218, "text": "Varje Mita har en Chibi-projektion,"}
{"category": "LocationDialogue Location13", "line_index": 219, "text": "och spelare kan också ha dem..."}
{"category": "LocationDialogue Location13", "line_index": 220, "text": "Visste du att vi Mitas kan kalla på dem?"}
{"category": "LocationDialogue Location13", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 222, "text": "Huh, hur?"}
{"category": "LocationDialogue Location13", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 224, "text": "Kolla in det här!"}
{"category": "LocationDialogue Location13", "line_index": 225, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 226, "text": "Precis som magi..."}
{"category": "LocationDialogue Location13", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 228, "text": "Men det är något fel med mina Chibis,"}
{"category": "LocationDialogue Location13", "line_index": 229, "text": "De flesta är bara födda döda."}
{"category": "LocationDialogue Location13", "line_index": 230, "text": "Men det finns en här..."}
{"category": "LocationDialogue Location13", "line_index": 231, "text": "Eller ja,"}
{"category": "LocationDialogue Location13", "line_index": 232, "text": "hon springer bara i cirklar."}
