{"category": "LocationDialogue Location8", "line_index": 0, "text": "// Det första mötet"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "Vem är du,"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "Vad är det för fel på dig?"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "Kan du inte prata?"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "Vänta lite..."}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "Du vill gå, eller hur?"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "Ja..."}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "Jag behöver komma tillbaka"}
{"category": "LocationDialogue Location8", "line_index": 11, "text": "till den tidigare versionen."}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "Den tidigare versionen?"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "Varför lämna och gå"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "någon annanstans?"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "Varför inte stanna här"}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "och vara min"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "andra vän?"}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Hoppar över alla dialoger"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "Okej..."}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Står vid fönstret (slumpmässigt)"}
{"category": "LocationDialogue Location8", "line_index": 24, "text": "Du kommer inte kunna gå ut genom dörrar."}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "Du verkar ha bråttom..."}
{"category": "LocationDialogue Location8", "line_index": 26, "text": "Att springa i cirklar kommer inte att rädda dig."}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "Så ivrig att fly?"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "Titta ut genom fönstren..."}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Är inte du Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "Spelare... du är en spelare, eller hur?"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": "Vi kan spela tillsammans."}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "Om jag kan hitta styrkan,"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": "är allt vi behöver göra att spela."}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (Vad hände med dig?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "Jag är osäker, och jag vet faktiskt inte..."}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "Jag tror inte att något dåligt har hänt..."}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "Men allt som är bra verkar glida iväg..."}
{"category": "LocationDialogue Location8", "line_index": 41, "text": "Men jag har i alla fall en vän."}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "Varför lämnade de mig?"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "Var jag inte tillräcklig?"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "Jag är rädd..."}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Quest 3 (Bli en andra vän?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "Vänner..."}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "Jag har så lite kvar nu."}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "Bara en återstår..."}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "Jag är ledsen, spelare."}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "Vill du vara min vän?"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "Det skulle jag gärna vilja,"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "men jag måste gå vidare..."}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "Mitt hjärta smärtar..."}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Är det här ditt hus?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "Hem?"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "Spelare ... du har förändrats ..."}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "Dina armar är kortare, och du ser inte så arg ut..."}
{"category": "LocationDialogue Location8", "line_index": 62, "text": "Spelare, du har blivit mjukare, snällare."}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "Jag är inte säker på..."}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "...vad det betyder."}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "Det är okej..."}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "för jag kommer ha ont längre, eller hur?"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (Hur lämnar jag den här platsen?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "Lämnar du mig verkligen?"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "Är det här kanske bara mitt..."}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "...öde?"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "Jag..."}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": "Dörrarna kommer inte att hjälpa dig."}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Håll spelare (slumpmässigt)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "Varför går du?"}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "Stanna här..."}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "Spela med mig..."}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "Spelare..."}
