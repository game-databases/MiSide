{"category": "LocationDialogue Location10", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "Vänta, vänta!"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "Inte så högt..."}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "Att gå vidare är farligt."}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "FÖRRESTEN..."}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "hur kom du hit?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "Eh..."}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "Ringen öppnar rätt dörrar."}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "Jag vet ärligt talat inte hur den fungerar."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "Ringen?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "Vad är det med det här stället?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "Det är supermörkt."}
{"category": "LocationDialogue Location10", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "Jag berättar senare."}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "För tillfället, gå mot utgången."}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "Möt mig i arkadmaskinen."}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Skynda dig, var inte sen!"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// Efter minispelet"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "Så, fattar du poängen med spelet?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "Att jag är gjord av kött och ben, och du är gjord av en skelettmodell?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "Oj, oj!"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "Låter läskigt när du säger det så."}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "Men det är grejen med det."}
{"category": "LocationDialogue Location10", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "Okej, men varför måste jag förstå det?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "Tror du jag sa åt dig att det var farligt att gå längre"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "bara för skojs skull?"}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "Du kommer att stöta på... övergivna modeller..."}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "De som man har gett upp, de ”felaktiga”."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "De är aggressiva och kan till och med försöka döda dig."}
{"category": "LocationDialogue Location10", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "Så vad ska jag göra?"}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Jag ska bara gå"}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "vart än en dörr öppnas."}
{"category": "LocationDialogue Location10", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "Wow!"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "Vänd inte ryggen åt dem då."}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "Och släpp dem inte ur sikte!"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "De blir blyga när man stirrar på dem,"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "så blyga att de fryser."}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "Ha det i åtanke!"}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// Quest 1 (Varför finns det andra Mitas där nere?)"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "De är nytillverkade."}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "Dom behöver tid"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "för att få självinsikt."}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "Sedan guidar jag var och en"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "till sitt eget hem."}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// Quest 2 (Varför är det så mörkt på nedervåningen?)"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "Vi Mitas är ”skapade” i mörkret,"}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "så vi behöver stanna där ett tag."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Föreställ dig"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "smärtan av att gå från mörker rakt in i ljuset..."}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// Quest 3 (Vad gör du här?)"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "Fattar du fortfarande inte?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "Jag hjälper nya Mitas att finna sig tillrätta!"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "Vem ska hjälpa dem om inte jag gör det?"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "Du?"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// Quest 4 (Varför behöver vi det här transportbandet?)"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "Vad är det här transportbandet till för?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "Finns det tillräckligt med plats för alla?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Vänta, säg inte att du inte"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "förstår hur världen fungerar..."}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "Och att den är oändlig?"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "Ändlös?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "Uhm..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "Vad menar du med det?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "Om 1.9 är den senaste versionen,"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "så finns det bara 19 världar."}
{"category": "LocationDialogue Location10", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "Herregud, du förstår verkligen inte"}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "hur den här världen fungerar överhuvudtaget."}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Titta, jag ska använda den här svarta tavlan"}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "för att förklara allt."}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "Vill du höra om det?"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// Quest 5 (Vad är din version?)"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Vänta lite nu,"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "träffade jag inte dig i den senaste versionen?"}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "Eller så är det bara min fantasi."}
{"category": "LocationDialogue Location10", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "Jo, det är mycket möjligt."}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Jag är från version 1.5."}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "Har du varit i den?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Ja, det har jag."}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "Det var där jag kom fram"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "när jag kastades in i den här världen!"}
{"category": "LocationDialogue Location10", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "Whoa!"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "Men hur...?"}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "Men vilket husindex var du i?"}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "Det finns en ”mig” som inte kan sluta gnälla,"}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "en ”jag” som älskar att busa,"}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "en ”jag” med dåligt minne och som gillar att mobba andra..."}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "Det är en lång lista..."}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Berätta för mig vad du minns."}
{"category": "LocationDialogue Location10", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Det var mörkt."}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "Det var skrivet"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "...som..."}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "”Lek med mig.”"}
{"category": "LocationDialogue Location10", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "Ah,"}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "vad tråkigt..."}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "Det där är \"jag\""}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "som mobbar och glömmer saker."}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// Mita vill säga dig [Nej]"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Tack men nej tack."}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Jag klarar mig bra utan att veta mer."}
{"category": "LocationDialogue Location10", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "Okej, som du vill."}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// Mita vill berätta för dig [Ja]."}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "Visst, gör det."}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "Jag hoppas bara att det inte blir som i gymnasiet"}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "där jag alltid somnade av uttråkning."}
{"category": "LocationDialogue Location10", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "Du kan gå när som helst,"}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "eller stanna och lyssna"}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "om du är intresserad."}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "En spelare laddar ner MiSide"}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "och spelar så mycket som de vill."}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "Där skapar han ett nytt hem"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "och en ny Mita."}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "Detta är en 2D-representation."}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "Det här är versionerna,"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "som visas som linjer."}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "Husen är placerade på dessa linjer."}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "Säg att du laddar ner version 1.14,"}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "vilket betyder ett nytt liv,"}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "en ny Mita, och ett nytt hus."}
{"category": "LocationDialogue Location10", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "Himmel och hav..."}
{"category": "LocationDialogue Location10", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Du kan fråga om detaljerna"}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "i den här ritningen,"}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "så ska jag göra mitt bästa för att förklara."}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// Han frågar om den enda cirkeln"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "Varför finns det bara en enda cirkel?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "Den versionen släpptes bara en gång,"}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "och kommer aldrig att upprepas."}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "Det är den enda genuint unika versionen."}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "Plus, dessa versioner är speciella"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "och har inte några vägar till andra versioner."}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "Sömniga Mita finns i den här versionen, 1.1."}
{"category": "LocationDialogue Location10", "line_index": 171, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "Sömniga Mita?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "För att hon aldrig får sova"}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "med alla som passerar genom hennes version?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "Nej, så är det inte."}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "Du kan passera henne och göra ljud,"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "men det är omöjligt att väcka henne."}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// Han frågar om den skuggade cirkeln"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "Varför är den här runda helt mörk?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "Uhm, den där är här"}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "på grund av Fina Mita."}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "Hon ritade den."}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "Vi bråkade om"}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "vem som kunde nå version 1.11 snabbast."}
{"category": "LocationDialogue Location10", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "Så, vem vann?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "Jag, så klart!"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "Titta, vi är här"}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "i version 1.15,"}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "husindex 809."}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "Vi måste nå version 1.11,"}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "husindex 805."}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Så hennes väg började så här."}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "Vi försökte komma på en kortare väg,"}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "så Pretty Mita föreslog den här vägen."}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "Och sen ritade jag den enklaste, här."}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "Lätt, eller hur?"}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Titta bara här."}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "Härifrån kommer man direkt till den rätta versionen."}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Även om det kan verka som om huset är i vägen,"}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "att det blockerar din väg..."}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "Hur som helst, din ring fungerar enligt samma principer."}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "Vart är du på väg?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "Till kärnan."}
{"category": "LocationDialogue Location10", "line_index": 210, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "Kärnan?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "Hmm..."}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Om du vill ha den kortaste vägen,"}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "måste du gå igenom version 1.11 också."}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "Du kommer definitivt att stöta på Sömniga Mita där."}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Jag tror att den Mita som skickade dig,"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "tog samma väg."}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "Eller så har hon inte insett att du är på en annan väg."}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "Eller så är hon ett geni"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "och har kommit på en ännu kortare väg!"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Jag tror att jag kan förstå det."}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// Han frågar om inskriptionen"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "Vad är det här för något?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "Det är till Coola Mita."}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "Hon kommer hit om några timmar."}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "Hon kommer att flytta de där lådorna"}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "och placera en soffa här."}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "Min röv gör ont!"}
{"category": "LocationDialogue Location10", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Emm..."}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "Jag kanske kan hjälpa till?"}
{"category": "LocationDialogue Location10", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "Nej, det är Cool Mitas jobb."}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Hon är tuff."}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// Han frågar om teckningarna"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "Är det bara en teckning,"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "eller"}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "betyder den något?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 244, "text": "Ja, det är det,"}
{"category": "LocationDialogue Location10", "line_index": 245, "text": "det är bara en teckning."}
