{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Hej på dig!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Oops!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Förlåt, jag..,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "dödade dig nästan där."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Uhm..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "Kylskåpet, jag menar... kylskåpet dödade dig nästan."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Jag hade inget med det att göra,"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "Jag svär!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Verkligen!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Visst, jag tror dig!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Men allvarligt talat,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "det här stället är farligt..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "speciellt för dig."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// Efter en stund 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "Du är allt annat än en fegis, va!"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Tittar på dig"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "när du passerar genom"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "dessa platser är kul..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Spring, pumpan, spring!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "Jag kommer ikapp!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Duktig pojke!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Wow, det här är kul!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// Efter en stund 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Jag såg att du var på väg mot tåget."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "Det är den längsta vägen"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "mellan version..."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Jag undrar hur du kommer att hantera"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "med dem som bor där"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "i den där dimman."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Trosor"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Vad tror du att du håller på med?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Snälla..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Titta inte!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Idiot!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Din dumskalle..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Uhm, okej..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Bryt ett ben!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Vem där?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Jag kan känna dig..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Lyssna på mig nu,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "du är en spelare,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "är du inte?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Hjälp mig att hitta..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "...hitta en..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "Låt mig tänka..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "Mitt minne är tomt..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Vad i hela världen är det som händer här?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Jag ville glömma allt en gång..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Jag krossade alla speglar,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "förstörde fotona..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "...men nu..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "...känner jag bara ånger."}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "Hur dum jag var..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Alla gör misstag, visst..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Men vad gör man"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "när konsekvenserna är katastrofala?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Jag önskar att jag bara kunde vrida tillbaka tiden..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "De säger att tiden läker alla sår..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Men vad är tid?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Jag tror inte på någonting längre..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Men om tiden kan läka,"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "eller åtminstone ta mig bort,"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "bort från den här världen..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "Då ber jag dig, snälla"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "påskynda tiden."}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "Så att den kan döda mig"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "en gång för alla."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Hon har älskat..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Har jag också älskat, en gång?"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Men min kärlek är annorlunda;"}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "hennes kärlek är levande,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "föraktlig..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "brinnande..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "obarmhärtig..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "avundsjuk..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "rasande..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "galen..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "De kallade mig känslosam..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "Du oroar dig för mycket, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "Du kommer att ta dig igenom det här, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "Du är inte ensam, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Sa de. Men vad finns kvar?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Sorgsenhet,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "hopplöshet..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "och rädsla."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Värdelös..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Jag kan inte minnas..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "Ingenting alls..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Bara de ändlösa ekona..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Jag kan inte hantera det faktum"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "att jag är fångad här..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Jag har alltid varit här,"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "men varför?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Jag kan inte minnas..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Kommer det någonsin att ta slut?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Jag vet inte..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita får bild"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Det här är..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "...en teckning..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Jag minns den nu,"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "tack..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Men mitt ansikte..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "Jag har inget ansikte..."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "Allt är hennes."}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Hon tog en bit av mig..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "...kastade bort den..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Hon är stark..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "...och smart."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Jag har ingen rätt att stoppa dig, spelare."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Titta i garderoben..."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Hallå där!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Du är i vägen för mig!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Tänker du bara stå där?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Flytta på dig!"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Släpp fram mig!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Bara för att du är stor betyder det inte att du är allsmäktig!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOPP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Varför följer du efter mig!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Dra åt helvete!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - radioröst"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Vänta lite nu... Player?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "Vad gör du här?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Vem är det där?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "En annan spelare."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Jag är Mitaphone."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Jag sitter här och kontrollerar linbanorna."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Inser du"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "att du är på väg mot din dom just nu?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Kanske det,"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "men det är den enda vägen jag har."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Det har du rätt i."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Tryck på knappen och ställ dig bakom kanonen."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "Kanonen?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Uh-huh."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Trodde du att du bara skulle glida rakt igenom?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Du måste klara det här Monster-slap minispelet,"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "så gör dig redo att spränga."}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Tunnelbanan går"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Okej, dags att ge sig ut på vägarna."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Fantastiskt!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Du gjorde det."}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Hej, ut härifrån."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Snyggt och snabbt!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Varför är du kvar här?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Jag sa åt dig att sticka härifrån."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Jag förstår inte..."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "varför står du bara där?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Varför Tetris?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Grabben..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular adjö"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Hejdå."}
