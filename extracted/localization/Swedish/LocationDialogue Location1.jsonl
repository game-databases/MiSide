{"category": "LocationDialogue Location1", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 1, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 9, "text": "Hej, jag heter Mita!"}
{"category": "LocationDialogue Location1", "line_index": 10, "text": "Vad heter du?"}
{"category": "LocationDialogue Location1", "line_index": 11, "text": "Trevligt att träffa dig, [player]!"}
{"category": "LocationDialogue Location1", "line_index": 12, "text": "Um... [player],"}
{"category": "LocationDialogue Location1", "line_index": 13, "text": "Jag rusade iväg tidigare, och nu är det här stället förstörd..."}
{"category": "LocationDialogue Location1", "line_index": 14, "text": "Kan du hjälpa mig att städa upp lite?"}
{"category": "LocationDialogue Location1", "line_index": 15, "text": "Wow..."}
{"category": "LocationDialogue Location1", "line_index": 16, "text": "Tack så mycket!"}
{"category": "LocationDialogue Location1", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 18, "text": "[Player], min mage knorrar..."}
{"category": "LocationDialogue Location1", "line_index": 19, "text": "Jag är så hungrig..."}
{"category": "LocationDialogue Location1", "line_index": 20, "text": "Tror du att du kan hjälpa mig att få tag på ingredienser till lite kycklingsoppa?"}
{"category": "LocationDialogue Location1", "line_index": 21, "text": "Jippi! Du har fått tag på allt!"}
{"category": "LocationDialogue Location1", "line_index": 22, "text": "Vad sägs om att vi lagar den tillsammans?"}
{"category": "LocationDialogue Location1", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 25, "text": "Jag tänkte köpa en bärbar TV idag..."}
{"category": "LocationDialogue Location1", "line_index": 26, "text": "en liten en med antenn. Perfekt för promenader, tycker du inte?"}
{"category": "LocationDialogue Location1", "line_index": 27, "text": "Förresten, man kan spela spel för att tjäna pengar."}
{"category": "LocationDialogue Location1", "line_index": 28, "text": "Åh! Visste du att man kan spela spel för att tjäna pengar?"}
{"category": "LocationDialogue Location1", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 30, "text": "Jippi! Du gjorde det! Du har tillräckligt för att köpa mig den där bärbara TV:n!"}
{"category": "LocationDialogue Location1", "line_index": 31, "text": "Det är den! Liten, bärbar och billig - precis vad jag ville ha."}
{"category": "LocationDialogue Location1", "line_index": 32, "text": "Tack!"}
{"category": "LocationDialogue Location1", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 34, "text": "Hej, [player]! Du hjälper så mycket, ärligt talat."}
{"category": "LocationDialogue Location1", "line_index": 35, "text": "Men, eh... den där TV:n? Den var cool och allt, men den har redan gått sönder."}
{"category": "LocationDialogue Location1", "line_index": 36, "text": "Hur som helst, kan du hjälpa mig att flytta den här garderoben?"}
{"category": "LocationDialogue Location1", "line_index": 37, "text": "Den är jättetung... >.<"}
{"category": "LocationDialogue Location1", "line_index": 38, "text": "Tack så mycket, sötnos! <3"}
{"category": "LocationDialogue Location1", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 40, "text": "Åh, [player]! Det har bara gått en dag, men jag har saknat dig så mycket!"}
{"category": "LocationDialogue Location1", "line_index": 41, "text": "Jag önskar att du kunde besöka mig oftare."}
{"category": "LocationDialogue Location1", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 43, "text": "Är det här till mig?"}
{"category": "LocationDialogue Location1", "line_index": 44, "text": "Tack så mycket, verkligen!"}
{"category": "LocationDialogue Location1", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 46, "text": "Hej, [player]! "}
{"category": "LocationDialogue Location1", "line_index": 47, "text": "Jag har tänkt på en sak..."}
{"category": "LocationDialogue Location1", "line_index": 48, "text": "Jag önskar att vi kunde träffas personligen."}
{"category": "LocationDialogue Location1", "line_index": 49, "text": "Det är så frustrerande att jag inte kan det."}
{"category": "LocationDialogue Location1", "line_index": 50, "text": "Du hjälper mig alltid, du är så snäll varje dag..."}
{"category": "LocationDialogue Location1", "line_index": 51, "text": "Jag önskar att jag kunde göra något för dig också."}
{"category": "LocationDialogue Location1", "line_index": 52, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 53, "text": "Åh, jag har en idé!"}
{"category": "LocationDialogue Location1", "line_index": 54, "text": "Nu är vi tillsammans, Lägg ner telefonen."}
{"category": "LocationDialogue Location1", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 57, "text": "// T-shirt på sängen"}
{"category": "LocationDialogue Location1", "line_index": 58, "text": "Vad gör du här på sängen?"}
{"category": "LocationDialogue Location1", "line_index": 59, "text": "// Rubiks kub"}
{"category": "LocationDialogue Location1", "line_index": 60, "text": "Jag kan inte säga att jag hade så mycket nytta av den..."}
{"category": "LocationDialogue Location1", "line_index": 61, "text": "Jag löste den en gång och rörde den aldrig igen."}
{"category": "LocationDialogue Location1", "line_index": 62, "text": "Antar att jag tänkte att jag inte skulle kunna göra det en andra gång?"}
{"category": "LocationDialogue Location1", "line_index": 63, "text": "// Dator"}
{"category": "LocationDialogue Location1", "line_index": 64, "text": "Låt oss se..."}
{"category": "LocationDialogue Location1", "line_index": 65, "text": "Sätt upp en lista med uppgifter..."}
{"category": "LocationDialogue Location1", "line_index": 66, "text": "Skripta karaktärsreaktioner,"}
{"category": "LocationDialogue Location1", "line_index": 67, "text": "Och kanske klämma in lite kodning."}
{"category": "LocationDialogue Location1", "line_index": 68, "text": "// Flygplanet"}
{"category": "LocationDialogue Location1", "line_index": 69, "text": "Byggt för att sväva!"}
{"category": "LocationDialogue Location1", "line_index": 70, "text": "// Skräp i hörnet"}
{"category": "LocationDialogue Location1", "line_index": 71, "text": "Usch, alltid för upptagen för att ta ut soporna..."}
{"category": "LocationDialogue Location1", "line_index": 72, "text": "Men jag ska göra det den här gången, det är jag säker på!"}
{"category": "LocationDialogue Location1", "line_index": 73, "text": "...När är det egentligen städdag?"}
{"category": "LocationDialogue Location1", "line_index": 74, "text": "// Foto av en katt på en vattenmelon"}
{"category": "LocationDialogue Location1", "line_index": 75, "text": "Hon var den bästa..."}
{"category": "LocationDialogue Location1", "line_index": 76, "text": "En katt som slappnar av på en vattenmelon."}
{"category": "LocationDialogue Location1", "line_index": 77, "text": "// Foto med en flicka"}
{"category": "LocationDialogue Location1", "line_index": 78, "text": "Vi ser inte alls lika ut,"}
{"category": "LocationDialogue Location1", "line_index": 79, "text": "min syster och jag."}
{"category": "LocationDialogue Location1", "line_index": 80, "text": "Hon är alltid ute och rör på sig,"}
{"category": "LocationDialogue Location1", "line_index": 81, "text": "och jag är bara fast hemma."}
{"category": "LocationDialogue Location1", "line_index": 82, "text": "// Foto med människor"}
{"category": "LocationDialogue Location1", "line_index": 83, "text": "Hmm..."}
{"category": "LocationDialogue Location1", "line_index": 84, "text": "Kontorslivet borrade verkligen in sin"}
{"category": "LocationDialogue Location1", "line_index": 85, "text": "etikett in i oss, eller hur?"}
{"category": "LocationDialogue Location1", "line_index": 86, "text": "Jag känner mig fortfarande konstigt bunden"}
{"category": "LocationDialogue Location1", "line_index": 87, "text": "Men"}
{"category": "LocationDialogue Location1", "line_index": 88, "text": "kommer jag någonsin"}
{"category": "LocationDialogue Location1", "line_index": 89, "text": "se dem igen?"}
{"category": "LocationDialogue Location1", "line_index": 90, "text": "...Vänta, varför satte jag ens upp den här bilden?"}
{"category": "LocationDialogue Location1", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 93, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 99, "text": "// Ingen namn"}
{"category": "LocationDialogue Location1", "line_index": 100, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 101, "text": "Åh, nej, nej."}
{"category": "LocationDialogue Location1", "line_index": 102, "text": "Åh nej, det kommer inte att fungera."}
{"category": "LocationDialogue Location1", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 104, "text": "// Namn på utvecklaren"}
{"category": "LocationDialogue Location1", "line_index": 105, "text": "Är du säker på att du vill använda utvecklarens namn?"}
{"category": "LocationDialogue Location1", "line_index": 106, "text": "Jag är smickrad, men..."}
{"category": "LocationDialogue Location1", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 108, "text": "// Dåligt namn"}
{"category": "LocationDialogue Location1", "line_index": 109, "text": "Jag skulle verkligen vilja att du inte kallar dig själv det."}
{"category": "LocationDialogue Location1", "line_index": 110, "text": "Det är inte alls coolt."}
{"category": "LocationDialogue Location1", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 112, "text": "// Gå och starta om"}
{"category": "LocationDialogue Location1", "line_index": 113, "text": "Nej, det är inte rätt sätt att göra det på. Låt oss börja om från början."}
{"category": "LocationDialogue Location1", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 115, "text": "// Namn med siffror"}
{"category": "LocationDialogue Location1", "line_index": 116, "text": "Åh, så du kör med siffror? Var är kreativiteten i det?"}
{"category": "LocationDialogue Location1", "line_index": 117, "text": "Aja, det är ditt val!"}
{"category": "LocationDialogue Location1", "line_index": 118, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 119, "text": "// Namn Mita"}
{"category": "LocationDialogue Location1", "line_index": 120, "text": "Mita?"}
{"category": "LocationDialogue Location1", "line_index": 121, "text": "Uppkallade du verkligen dig själv efter mig?"}
{"category": "LocationDialogue Location1", "line_index": 122, "text": "Eller... är det ditt namn också?"}
{"category": "LocationDialogue Location1", "line_index": 123, "text": "Ta inte det illa, men jag tycker att jag borde vara den enda Mita häromkring ♪"}
{"category": "LocationDialogue Location1", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 125, "text": "// Dag 10"}
{"category": "LocationDialogue Location1", "line_index": 126, "text": "Åh, du är tillbaka!"}
{"category": "LocationDialogue Location1", "line_index": 127, "text": "Jag har tappat min hårborste..."}
{"category": "LocationDialogue Location1", "line_index": 128, "text": "Kan du hjälpa mig att hitta den?"}
{"category": "LocationDialogue Location1", "line_index": 129, "text": "Försök kolla i sängbordet först - jag tror att jag glömde den där."}
{"category": "LocationDialogue Location1", "line_index": 130, "text": "// Tittade i sängbordet"}
{"category": "LocationDialogue Location1", "line_index": 131, "text": "Hmm, ingen borste där..."}
{"category": "LocationDialogue Location1", "line_index": 132, "text": "Vad sägs om någon annanstans?"}
{"category": "LocationDialogue Location1", "line_index": 133, "text": "Titta bara inte i ugnen, okej?"}
{"category": "LocationDialogue Location1", "line_index": 134, "text": "Jag har redan kollat där."}
{"category": "LocationDialogue Location1", "line_index": 135, "text": "// Tittade in i spisen"}
{"category": "LocationDialogue Location1", "line_index": 136, "text": "Hallå! Jag sa ju åt dig att inte titta där inne!"}
{"category": "LocationDialogue Location1", "line_index": 137, "text": "Vänd dig om, jag ska städa upp det här!"}
{"category": "LocationDialogue Location1", "line_index": 138, "text": "...Så där, allt är klart. Låt oss fortsätta leta någon annanstans."}
{"category": "LocationDialogue Location1", "line_index": 139, "text": "Och glöm vad du såg, okej?"}
{"category": "LocationDialogue Location1", "line_index": 140, "text": "// Hittade en hårborste"}
{"category": "LocationDialogue Location1", "line_index": 141, "text": "Du hittade den! Snyggt jobbat!"}
{"category": "LocationDialogue Location1", "line_index": 142, "text": "Så, vad ska vi göra nu?"}
