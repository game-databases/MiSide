{"category": "LocationDialogue Location12", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Stanna här."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Jag tror att jag tappade något. Jag kommer strax tillbaka."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "Sen åker vi till en annan värld..."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Okej, då."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Nu ska vi leka!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Jag vill ha min teddy!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "Jag tappade bort honom..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "Hitta HONOM!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Hej..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "vad är det du tittar på"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": " Quest 1 (Vem är du)"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Jag är Mita."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "Den bästa Mita."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "Den första Mita."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "Det var vad Mita sa, min Mita."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": " Quest 2 (Varför ser du ut så där)"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "Hur ser jag ut"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "Hur ser jag ut"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "Hur ser jag ut"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "Min Mita säger att jag är vacker och originell."}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "Det är jag!"}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": " Quest 3 (Vad gjorde Mita här)"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Hon kommer att ta mig bort."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Vi ska leva i en ny värld."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "Min Mita bjöd in mig."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Hon kommer att ta mig bort. Och vi ska leka."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": " Quest 4 (Varför behöver du en teddybjörn)"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "Du är en gosig björn,"}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "och du är vilse,"}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "precis som min gosedjursbjörn."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": " Quest 5 (Varför är Mita arg)"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "Min..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "Mita."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Hon vill leka."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Hon vill bara ha"}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "mig."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Vi är unika,"}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "de enda."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Mita och min Mita,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0,8A och 8Ì54."}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": " Uppdrag 6 (Tror du på Mita)"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "Min Mita."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "Min bästa vän."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "Min Mita."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "Min enda vän."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "Det är du som är här!"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Hallå där!"}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Låt oss leka!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Jag ska visa dig hur man gör."}
