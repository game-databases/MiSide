{"category": "LocationDialogue Location2", "line_index": 0, "text": "// Spelarens start"}
{"category": "LocationDialogue Location2", "line_index": 1, "text": "Vart är jag nu?"}
{"category": "LocationDialogue Location2", "line_index": 2, "text": "Det här stället verkar bekant ut."}
{"category": "LocationDialogue Location2", "line_index": 3, "text": "Vänta lite... Är jag i spelet?"}
{"category": "LocationDialogue Location2", "line_index": 4, "text": "// Spelaren försöker öppna dörren"}
{"category": "LocationDialogue Location2", "line_index": 5, "text": "Låst?"}
{"category": "LocationDialogue Location2", "line_index": 6, "text": "// Spelaren i mörkret"}
{"category": "LocationDialogue Location2", "line_index": 7, "text": "Det är mörkt här inne."}
{"category": "LocationDialogue Location2", "line_index": 8, "text": "Jag kan inte se någonting."}
