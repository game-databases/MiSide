{"category": "LocationDialogue Location6", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "Mita?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "Hur i hela världen kom du hit?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Du är Mita, eller hur?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Men det är något annorlunda med dig..."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "Observant, ser jag."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "Och du har rätt."}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "Jag är inte den Mita du träffade förut."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Var försiktig, hon håller på med något"}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "skumt."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "Huh, något skumt?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "Det finns ingen tid att förklara:"}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "Om det här funkar, berättar jag allt för dig."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Hämta nyckeln. Den ligger bredvid soffan."}
{"category": "LocationDialogue Location6", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Men..."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "Spara dina frågor till senare!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Ge mig nyckeln."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Ta den här ringen."}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "Va?"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Du vill komma ut härifrån, eller hur?"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "Uhm, ja..."}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Sätt på dig den då."}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "Det är en praktisk artifakt,"}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "du kommer sannolikt att behöva det snart."}
{"category": "LocationDialogue Location6", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Okej..."}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "Förresten, jag är"}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Mmm,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "Jag är... Mita."}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// MitaKind quest 1"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "Ser du den där"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "konsolen? Plocka upp den."}
{"category": "LocationDialogue Location6", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "Tittar vi på en inspelning?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "Vem är det som är med henne?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "Det händer just nu."}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "Det är en annan spelare."}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Hon använder honom."}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Hon kanske försöker"}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "förvandla dig till en kassett också."}
{"category": "LocationDialogue Location6", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "Jag måste ut härifrån så fort som möjligt."}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "Och du också."}
{"category": "LocationDialogue Location6", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "Ja, det gör vi."}
{"category": "LocationDialogue Location6", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "Så, du säger"}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "att hon använder honom."}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "Om jag drar ut kassetten, vad händer då?"}
{"category": "LocationDialogue Location6", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "Det kan mycket väl"}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "oåterkalleligt skada kassetten."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "Vilket betyder att..."}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "spelaren skulle dö."}
{"category": "LocationDialogue Location6", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "..."}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "Tänk om jag bara stänger av den?"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "Det skulle kunna fungera..."}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Det är värt ett försök. Det finns en röd strömknapp!"}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Ser du den?"}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "Hittade den."}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "Tryck på den."}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// MitaKind quest 2"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Jag måste stanna."}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "Det finns frågor jag måste ställa till henne"}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "för att få reda på mer om henne."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "Men det är inte säkert att hon är med på spelet..."}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// MitaKind uppdrag 3"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "Sanningen att säga är det här min version."}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "Jag höll en spelare sällskap,"}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "när något plötsligt förändrades."}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "Sen dök hon upp..."}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "och förvandlade spelaren till en kassett"}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "och låste in mig."}
{"category": "LocationDialogue Location6", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Vänta, förvandlade hon honom till en kassett?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "Kan hon ens göra det?"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "Men varför?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "Vad behöver hon spelarna till?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "Hon är uppenbarligen galen..."}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Hon leker bara med oss, och använder oss för sina egna intriger!"}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "Förvandlar spelare till kassetter..."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Vissa insåg inte ens vad som hände med dem..."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "Och några som gjorde det, kämpade inte ens emot... Gah!"}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "Nu är det en mörk twist..."}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "Du måste hjälpa oss!"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "Mig? Men hur?"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "Jag behöver dig!"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "Om du hjälper oss, så hjälper jag dig!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Det här kan vara vår enda chans."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "Ringen kommer att leda dig till rätt version."}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "Jag möter dig där."}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// MitaKind uppdrag 4"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "Jag förstår fortfarande inte riktigt"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "vad jag såg där uppe..."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Den där Mita..."}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "Försökte hon döda mig?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "Döda?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Hon har ett värre öde än så i åtanke för dig..."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "Du måste skynda dig."}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Göm dig!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "Åh, jävlar! Göm dig!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Vänta, vad...?"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Skynda, hon kommer!"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "Följ ringen, den leder dig i säkerhet!"}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "Tänker du berätta var han är?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "Varför skulle jag göra det?"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "Du kommer inte att döda honom, eller hur?"}
{"category": "LocationDialogue Location6", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Ah, så du vägrar att berätta för mig."}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Hah, jag gillar en utmaning."}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "Jag vet att han är någonstans häromkring."}
{"category": "LocationDialogue Location6", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "Varför är du så elak mot oss?"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "Du vill inte ens berätta vad som händer!"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "Förresten..."}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "vad behöver du spelare till?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "De är inga leksaker!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "Vad har det hänt med dig?!"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "Nu räcker det! Håll käften, dockan!"}
