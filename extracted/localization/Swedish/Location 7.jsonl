{"category": "Location 7", "line_index": 0, "text": "// Namn på spår"}
{"category": "Location 7", "line_index": 1, "text": "Smällkaramell"}
{"category": "Location 7", "line_index": 2, "text": "Bubbel-dryck"}
{"category": "Location 7", "line_index": 3, "text": "Ballong"}
{"category": "Location 7", "line_index": 4, "text": "// Inga uppdrag"}
{"category": "Location 7", "line_index": 5, "text": "Det var inget."}
{"category": "Location 7", "line_index": 6, "text": "// Uppdrag ”Möte med snälla Mita”"}
{"category": "Location 7", "line_index": 7, "text": "Borde jag lita på dig?"}
{"category": "Location 7", "line_index": 8, "text": "Hur kom jag hit?"}
{"category": "Location 7", "line_index": 9, "text": "Vad är det här för ställe?"}
{"category": "Location 7", "line_index": 10, "text": "Hur kom du hit?"}
{"category": "Location 7", "line_index": 11, "text": "Vad gjorde du med ringen?"}
{"category": "Location 7", "line_index": 12, "text": "Är gångarna farliga?"}
{"category": "Location 7", "line_index": 13, "text": "Hjälper du mig att fly?"}
{"category": "Location 7", "line_index": 14, "text": "Du nämnde en plan."}
{"category": "Location 7", "line_index": 15, "text": "// Uppdrag MitaCap"}
{"category": "Location 7", "line_index": 16, "text": "Minns du någonting?"}
{"category": "Location 7", "line_index": 17, "text": "Vad tycker du om den ringbärande Mita?"}
{"category": "Location 7", "line_index": 18, "text": "Har du alltid den där kepsen på dig?"}
