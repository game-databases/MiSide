{"category": "LocationDialogue Location20", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Mila! Nej! Du är galen!"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Ha-ha! VAD ÄR DET HÄR?"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "Är det ett nytt ansiktsuttryck jag ser?"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "Fortsätt, låt mig se mer!"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "Att titta på samma gamla ansikte blir så tråkigt!"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena ”Hallå”"}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "Hur är läget, min rastlösa lilla vandrare?"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "Springer du fortfarande omkring? Har du inte fått nog än?"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Vad har du gjort med Mila?"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "Åh, så du är inte trött än!"}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Perfekt! Vi leker en annan lek!"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "Du..."}
{"category": "LocationDialogue Location20", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "Låt oss börja med ett litet test!"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "Låt oss testa din koordination!"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "Nu din förmåga att agera!"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "Tänk om det är något fel på dig!?"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "Tänk om du inte ens förtjänar det där HUDET"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "som du är så stolt över att bära!?"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Visa knivar"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "Ta en titt..."}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "Vilken fångar ditt öga?"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "Den högra?"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "Eller"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "den vänstra?"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Kasta knivar"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "Åh, allvarligt talat?"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "Spelar det ens någon roll?"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "Jag bara skämtade med dig!"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "Knivhugg är gamla nyheter ändå."}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "Strunt samma!"}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "Jag har mycket bättre lekar planerade,"}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "som..."}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Visa inspelare"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "Kolla in det här!"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Vi behöver lite musik!"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "Vad tycker du om den här melodin?"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "Den får mitt blod att pumpa!"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "Jag börjar"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "med reglerna!"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Regler för showen"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "Medan melodin spelas,"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "kan du röra dig."}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "Men när musiken stannar,"}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "RÖR DIG INTE!"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "Annars är du död. Fattar du?"}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "Det är enkelt: ta dig till slutet"}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "innan låten tar slut."}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "Nu börjar vi!"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "Står du fortfarande här?"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Spring, sötnos, spring!"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Redo inspelare"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "Oh!"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Titta på dig! Så lydig!"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Ett perfekt litet exempel."}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Jag vill ha dig för mig själv!"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "Det var alldeles för lätt, eller hur?"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "Släpp mig!"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "Bli inte för bekväm!"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "Vi har många fler lekar att leka!"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "Här är nästa:"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Jag ska blunda..."}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "Och när jag öppnar dem,"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "är det bäst att du är borta!"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "Fattar du?"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "Om jag ser dig, ska jag straffa dig!"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Bra! Låt oss börja!"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "Det här är meningslöst..."}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "Du klarade det!"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Du är jätteduktig - det här börjar bli spännande!"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "Men nu kommer det att bli svårare."}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "VÄLDIGT mycket svårare."}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Göm dig, spring, snurra..."}
{"category": "LocationDialogue Location20", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "Fan ta dig i helvetet!"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Spelaren faller"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "Jag tror att jag kom undan..."}
