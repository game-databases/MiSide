{"category": "LocationDialogue Location4", "line_index": 0, "text": "Mita?"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "Är du redan vaken?"}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "Hur kom du hit?"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": "Du var precis bredvid mig nyss."}
{"category": "LocationDialogue Location4", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 5, "text": "Nej, det var jag inte."}
{"category": "LocationDialogue Location4", "line_index": 6, "text": "Du frös framför spegeln."}
{"category": "LocationDialogue Location4", "line_index": 7, "text": "Så jag gick."}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "Varför har rummen ändrats?"}
{"category": "LocationDialogue Location4", "line_index": 9, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "Jag ordnade om stället"}
{"category": "LocationDialogue Location4", "line_index": 11, "text": "så att du skulle känna dig mer som hemma."}
{"category": "LocationDialogue Location4", "line_index": 12, "text": "Här inne,"}
{"category": "LocationDialogue Location4", "line_index": 13, "text": "kan vi ändra rummen"}
{"category": "LocationDialogue Location4", "line_index": 14, "text": "hur vi vill."}
{"category": "LocationDialogue Location4", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 16, "text": "Det behövde du inte."}
{"category": "LocationDialogue Location4", "line_index": 17, "text": "Jag höll på att vänja mig vid layouten."}
{"category": "LocationDialogue Location4", "line_index": 18, "text": "Hur som helst, jag tror att du kommer att känna dig mer bekväm med den här layouten."}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Mita kortspel"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "Just det,"}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "ska vi spela?"}
{"category": "LocationDialogue Location4", "line_index": 22, "text": "Spelet fungerar så här:"}
{"category": "LocationDialogue Location4", "line_index": 23, "text": "Denna bricka indikerar en typ,"}
{"category": "LocationDialogue Location4", "line_index": 24, "text": "till exempel hälsa:"}
{"category": "LocationDialogue Location4", "line_index": 25, "text": "Vi spelar ett kort var,"}
{"category": "LocationDialogue Location4", "line_index": 26, "text": "och om ditt kort har en högre"}
{"category": "LocationDialogue Location4", "line_index": 27, "text": "hälsostatus"}
{"category": "LocationDialogue Location4", "line_index": 28, "text": "än mitt,"}
{"category": "LocationDialogue Location4", "line_index": 29, "text": "vinner du."}
{"category": "LocationDialogue Location4", "line_index": 30, "text": "Plocka upp dina kort."}
{"category": "LocationDialogue Location4", "line_index": 31, "text": "Nu är det min tur."}
{"category": "LocationDialogue Location4", "line_index": 32, "text": "Whoa!"}
{"category": "LocationDialogue Location4", "line_index": 33, "text": "Jag har en riktigt bra hand!"}
{"category": "LocationDialogue Location4", "line_index": 34, "text": "Jag går först!"}
{"category": "LocationDialogue Location4", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 44, "text": "OKEJ!"}
{"category": "LocationDialogue Location4", "line_index": 45, "text": "Din tur!"}
{"category": "LocationDialogue Location4", "line_index": 46, "text": "Uh-huh."}
{"category": "LocationDialogue Location4", "line_index": 47, "text": "Din tur!"}
{"category": "LocationDialogue Location4", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 49, "text": "Högsta hälsostatus vinner!"}
{"category": "LocationDialogue Location4", "line_index": 50, "text": "Allt handlar om attack!"}
{"category": "LocationDialogue Location4", "line_index": 51, "text": "Fokusera bara på skydd!"}
{"category": "LocationDialogue Location4", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 54, "text": "Du vann!"}
{"category": "LocationDialogue Location4", "line_index": 55, "text": "Du vann!"}
{"category": "LocationDialogue Location4", "line_index": 56, "text": "Du fick mig."}
{"category": "LocationDialogue Location4", "line_index": 57, "text": "Åh, du..."}
{"category": "LocationDialogue Location4", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 59, "text": "Jag vann!"}
{"category": "LocationDialogue Location4", "line_index": 60, "text": "Jag är vinnaren!"}
{"category": "LocationDialogue Location4", "line_index": 61, "text": "Jag vann!"}
{"category": "LocationDialogue Location4", "line_index": 62, "text": "Hah, jag fick dig!"}
{"category": "LocationDialogue Location4", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 64, "text": "Det är oavgjort."}
{"category": "LocationDialogue Location4", "line_index": 65, "text": "Alla lika!"}
{"category": "LocationDialogue Location4", "line_index": 66, "text": "Nu är det oavgjort!"}
{"category": "LocationDialogue Location4", "line_index": 67, "text": "Samma värde..."}
{"category": "LocationDialogue Location4", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 79, "text": "// Kortspelet är avbrutet"}
{"category": "LocationDialogue Location4", "line_index": 80, "text": "Vad är det för ljud?"}
{"category": "LocationDialogue Location4", "line_index": 81, "text": "Det kommer från garderoben."}
{"category": "LocationDialogue Location4", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 83, "text": "Ljudet?"}
{"category": "LocationDialogue Location4", "line_index": 84, "text": "Vilket ljud?"}
{"category": "LocationDialogue Location4", "line_index": 85, "text": "Jag hörde ingenting."}
{"category": "LocationDialogue Location4", "line_index": 86, "text": "Vad tyckte du att du hörde?"}
{"category": "LocationDialogue Location4", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 88, "text": "Knackningar, som om någon är där inne."}
{"category": "LocationDialogue Location4", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 90, "text": "Men..."}
{"category": "LocationDialogue Location4", "line_index": 91, "text": "Det är ingen där..."}
{"category": "LocationDialogue Location4", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 93, "text": "Jag skulle vilja öppna och kolla."}
{"category": "LocationDialogue Location4", "line_index": 94, "text": "Jag är lite rädd."}
{"category": "LocationDialogue Location4", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 96, "text": "Men varför...?"}
{"category": "LocationDialogue Location4", "line_index": 97, "text": "Det här igen..."}
{"category": "LocationDialogue Location4", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 105, "text": "Vad är det med dig!?"}
{"category": "LocationDialogue Location4", "line_index": 106, "text": "Det är en garderob..."}
{"category": "LocationDialogue Location4", "line_index": 107, "text": "Jag har mina trosor där...!"}
{"category": "LocationDialogue Location4", "line_index": 108, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 109, "text": "Döljer du något från mig?"}
{"category": "LocationDialogue Location4", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 111, "text": "Varför tror du mig inte bara?"}
{"category": "LocationDialogue Location4", "line_index": 112, "text": "Vad är det jag gör fel?"}
{"category": "LocationDialogue Location4", "line_index": 113, "text": "Vad jag vill..."}
{"category": "LocationDialogue Location4", "line_index": 114, "text": "Allt jag vill är att du ska vara med mig."}
{"category": "LocationDialogue Location4", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 116, "text": "Jag skulle vilja det också, men ändå...?"}
{"category": "LocationDialogue Location4", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 118, "text": "Varför är du så fast i den där garderoben?!"}
{"category": "LocationDialogue Location4", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 120, "text": "Jag vill veta vad i hela friden det var som knackade!"}
{"category": "LocationDialogue Location4", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 122, "text": "Är det för att"}
{"category": "LocationDialogue Location4", "line_index": 123, "text": "den här världen"}
{"category": "LocationDialogue Location4", "line_index": 124, "text": "bara har de här fyra rummen?"}
{"category": "LocationDialogue Location4", "line_index": 125, "text": "Är inte det tillräckligt för dig?"}
{"category": "LocationDialogue Location4", "line_index": 126, "text": "Varför kan du inte bara vara med mig?"}
{"category": "LocationDialogue Location4", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 129, "text": "// Stanna inte hos Mita"}
{"category": "LocationDialogue Location4", "line_index": 130, "text": "Jag fattar det."}
{"category": "LocationDialogue Location4", "line_index": 131, "text": "Det här igen..."}
{"category": "LocationDialogue Location4", "line_index": 132, "text": "Om du vill kolla garderoben,"}
{"category": "LocationDialogue Location4", "line_index": 133, "text": "gör det då,"}
{"category": "LocationDialogue Location4", "line_index": 134, "text": "och ta reda på vad som finns där inne!"}
{"category": "LocationDialogue Location4", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 139, "text": "Vad i..."}
{"category": "LocationDialogue Location4", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 141, "text": "Sånt händer ibland."}
{"category": "LocationDialogue Location4", "line_index": 142, "text": "Rummet fastnade i laddningen."}
{"category": "LocationDialogue Location4", "line_index": 143, "text": "Vänta bara en sekund."}
{"category": "LocationDialogue Location4", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 145, "text": "Det här är så konstigt."}
{"category": "LocationDialogue Location4", "line_index": 146, "text": "Är vi inne i någons telefon?"}
{"category": "LocationDialogue Location4", "line_index": 147, "text": "Kanske en långsam med långa laddningstider?"}
{"category": "LocationDialogue Location4", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 149, "text": "Nej, inte alls."}
{"category": "LocationDialogue Location4", "line_index": 150, "text": "Men allt är inte perfekt"}
{"category": "LocationDialogue Location4", "line_index": 151, "text": "i den här världen..."}
{"category": "LocationDialogue Location4", "line_index": 152, "text": "Vi laddas"}
{"category": "LocationDialogue Location4", "line_index": 153, "text": "tillsammans med världens kärna."}
{"category": "LocationDialogue Location4", "line_index": 154, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 155, "text": "Världens kärna?"}
{"category": "LocationDialogue Location4", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 157, "text": "Typiskt, tycker du inte?"}
{"category": "LocationDialogue Location4", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 159, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 161, "text": "Hur som helst, vi kan"}
{"category": "LocationDialogue Location4", "line_index": 162, "text": "spela ett konsolspel"}
{"category": "LocationDialogue Location4", "line_index": 163, "text": "eller bara kort."}
{"category": "LocationDialogue Location4", "line_index": 164, "text": "Du väljer."}
{"category": "LocationDialogue Location4", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 167, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 168, "text": "// Mita spela slagsmål"}
{"category": "LocationDialogue Location4", "line_index": 169, "text": "Vill du slåss?"}
{"category": "LocationDialogue Location4", "line_index": 170, "text": "Du måste vinna"}
{"category": "LocationDialogue Location4", "line_index": 171, "text": "fyra gånger."}
{"category": "LocationDialogue Location4", "line_index": 172, "text": "Kom igen nu."}
{"category": "LocationDialogue Location4", "line_index": 173, "text": "Oroa dig inte, jag ska"}
{"category": "LocationDialogue Location4", "line_index": 174, "text": "vara snäll mot dig i början."}
{"category": "LocationDialogue Location4", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 176, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 177, "text": "Duktig pojke."}
{"category": "LocationDialogue Location4", "line_index": 178, "text": "Bäst att du fokuserar!"}
{"category": "LocationDialogue Location4", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 180, "text": "Whoa!"}
{"category": "LocationDialogue Location4", "line_index": 181, "text": "Just det, okej."}
{"category": "LocationDialogue Location4", "line_index": 182, "text": "Jag ska bli seriös."}
{"category": "LocationDialogue Location4", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 184, "text": "Wow!"}
{"category": "LocationDialogue Location4", "line_index": 185, "text": "Låt oss se om du kan"}
{"category": "LocationDialogue Location4", "line_index": 186, "text": "slå mig nu!"}
{"category": "LocationDialogue Location4", "line_index": 187, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 188, "text": "Du är"}
{"category": "LocationDialogue Location4", "line_index": 189, "text": "helt enkelt"}
{"category": "LocationDialogue Location4", "line_index": 190, "text": "otrolig! Vilken talang!"}
{"category": "LocationDialogue Location4", "line_index": 191, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 193, "text": "Vad är det för fel?"}
{"category": "LocationDialogue Location4", "line_index": 194, "text": "Huh, det är tråkigt."}
{"category": "LocationDialogue Location4", "line_index": 195, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 196, "text": "Aja,"}
{"category": "LocationDialogue Location4", "line_index": 197, "text": "det var det. Tror du på ödet?"}
{"category": "LocationDialogue Location4", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 199, "text": "Då så,"}
{"category": "LocationDialogue Location4", "line_index": 200, "text": "skärp dig, annars blir du en förlorare för alltid!"}
{"category": "LocationDialogue Location4", "line_index": 201, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 202, "text": "Vad är det för fel på dig idag?"}
{"category": "LocationDialogue Location4", "line_index": 203, "text": "Jag moppade golvet med dig."}
{"category": "LocationDialogue Location4", "line_index": 204, "text": "Du gav inte allt..."}
{"category": "LocationDialogue Location4", "line_index": 205, "text": "Det var därför jag vann!"}
{"category": "LocationDialogue Location4", "line_index": 206, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 208, "text": "Okej, då så."}
{"category": "LocationDialogue Location4", "line_index": 209, "text": "Vad sägs om att spela lite kort?"}
{"category": "LocationDialogue Location4", "line_index": 210, "text": "De är i sovrummet."}
{"category": "LocationDialogue Location4", "line_index": 211, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 214, "text": "// Dörr > [ERROR]"}
{"category": "LocationDialogue Location4", "line_index": 215, "text": "Vad är det som händer?"}
{"category": "LocationDialogue Location4", "line_index": 216, "text": "Var är..."}
{"category": "LocationDialogue Location4", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 218, "text": "Uh-oh."}
{"category": "LocationDialogue Location4", "line_index": 219, "text": "Förlåt..."}
{"category": "LocationDialogue Location4", "line_index": 220, "text": "Jag laddade ner något"}
{"category": "LocationDialogue Location4", "line_index": 221, "text": "från nätet."}
{"category": "LocationDialogue Location4", "line_index": 222, "text": "Jag ville piffa upp"}
{"category": "LocationDialogue Location4", "line_index": 223, "text": "utsidan lite."}
{"category": "LocationDialogue Location4", "line_index": 224, "text": "Men det visade sig"}
{"category": "LocationDialogue Location4", "line_index": 225, "text": "att det var något fel på filen."}
{"category": "LocationDialogue Location4", "line_index": 226, "text": "Jag fixar det senare."}
{"category": "LocationDialogue Location4", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 228, "text": "Är det därför vi inte kan lämna huset?"}
{"category": "LocationDialogue Location4", "line_index": 229, "text": "Ja, det är därför."}
{"category": "LocationDialogue Location4", "line_index": 230, "text": "// Mita shy"}
{"category": "LocationDialogue Location4", "line_index": 231, "text": "Hej..."}
{"category": "LocationDialogue Location4", "line_index": 232, "text": "Vad är det för fel på dig?"}
{"category": "LocationDialogue Location4", "line_index": 233, "text": "Vill du ha något?"}
{"category": "LocationDialogue Location4", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 236, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 237, "text": "// Väggklocka"}
{"category": "LocationDialogue Location4", "line_index": 238, "text": "Den här klockan..,"}
{"category": "LocationDialogue Location4", "line_index": 239, "text": "vad visar den för tid?"}
{"category": "LocationDialogue Location4", "line_index": 240, "text": "Den aktuella tiden i spelet?"}
{"category": "LocationDialogue Location4", "line_index": 241, "text": "Eller är den synkroniserad med min telefon?"}
{"category": "LocationDialogue Location4", "line_index": 242, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 243, "text": "Tja, uhm..."}
{"category": "LocationDialogue Location4", "line_index": 244, "text": "Jag vet ärligt talat inte."}
{"category": "LocationDialogue Location4", "line_index": 245, "text": "Men tiden spelar ingen roll här..."}
{"category": "LocationDialogue Location4", "line_index": 246, "text": "Oavsett om det är sent eller tidigt,"}
{"category": "LocationDialogue Location4", "line_index": 247, "text": "en stark tjej som jag"}
{"category": "LocationDialogue Location4", "line_index": 248, "text": "är alltid full av energi."}
{"category": "LocationDialogue Location4", "line_index": 249, "text": "Jag blir aldrig trött!"}
{"category": "LocationDialogue Location4", "line_index": 250, "text": "Vi kan ha en evig vår,"}
{"category": "LocationDialogue Location4", "line_index": 251, "text": "eller en oändlig eftermiddag!"}
{"category": "LocationDialogue Location4", "line_index": 252, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 253, "text": "Det är intressant..."}
{"category": "LocationDialogue Location4", "line_index": 254, "text": "men också lite läskigt."}
{"category": "LocationDialogue Location4", "line_index": 255, "text": "Fast i samma ögonblick, för evigt..."}
{"category": "LocationDialogue Location4", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 258, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 259, "text": "// Foton av Mita"}
{"category": "LocationDialogue Location4", "line_index": 260, "text": "Fina bilder."}
{"category": "LocationDialogue Location4", "line_index": 261, "text": "Jag gissar att de är på dig?"}
{"category": "LocationDialogue Location4", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 263, "text": "Japp."}
{"category": "LocationDialogue Location4", "line_index": 264, "text": "Jag gillar dem också."}
{"category": "LocationDialogue Location4", "line_index": 265, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 266, "text": "Vem tog dem?"}
{"category": "LocationDialogue Location4", "line_index": 267, "text": "Finns det andra i den här världen också?"}
{"category": "LocationDialogue Location4", "line_index": 268, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 269, "text": "Det kan man säga."}
{"category": "LocationDialogue Location4", "line_index": 270, "text": "Jag ska presentera dig så småningom."}
{"category": "LocationDialogue Location4", "line_index": 271, "text": "Men inte än."}
{"category": "LocationDialogue Location4", "line_index": 272, "text": "Just nu vill jag bara vara med dig ensam."}
{"category": "LocationDialogue Location4", "line_index": 273, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 275, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 276, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 277, "text": "// Portal"}
{"category": "LocationDialogue Location4", "line_index": 278, "text": "Vart tog portalen vägen?"}
{"category": "LocationDialogue Location4", "line_index": 279, "text": "Eller vad det nu var du kallade den?"}
{"category": "LocationDialogue Location4", "line_index": 280, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 281, "text": "Jag använde"}
{"category": "LocationDialogue Location4", "line_index": 282, "text": "lite magi"}
{"category": "LocationDialogue Location4", "line_index": 283, "text": "och flyttade den"}
{"category": "LocationDialogue Location4", "line_index": 284, "text": "någon annanstans."}
{"category": "LocationDialogue Location4", "line_index": 285, "text": "Vi behöver den inte längre."}
{"category": "LocationDialogue Location4", "line_index": 286, "text": "Den skulle bara vara i vägen."}
{"category": "LocationDialogue Location4", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 288, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 289, "text": "// Spegel i sovrummet"}
{"category": "LocationDialogue Location4", "line_index": 290, "text": "Att titta in i en spegel utan att"}
{"category": "LocationDialogue Location4", "line_index": 291, "text": "se en reflektion - det är läskigt."}
{"category": "LocationDialogue Location4", "line_index": 292, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 293, "text": "Vi kan slå på reflektioner"}
{"category": "LocationDialogue Location4", "line_index": 294, "text": "om man verkligen vill."}
{"category": "LocationDialogue Location4", "line_index": 295, "text": "Men behöver vi dem verkligen?"}
{"category": "LocationDialogue Location4", "line_index": 296, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 297, "text": "Självklart gör vi det."}
{"category": "LocationDialogue Location4", "line_index": 298, "text": "Eller... kommer det att få konsekvenser om vi slår på dem?"}
{"category": "LocationDialogue Location4", "line_index": 299, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 300, "text": "Ja, det får det."}
{"category": "LocationDialogue Location4", "line_index": 301, "text": "Vi kommer att stamma och röra oss långsammare."}
{"category": "LocationDialogue Location4", "line_index": 302, "text": "Har du någonsin sett en tecknad film med låga bildrutor per sekund?"}
{"category": "LocationDialogue Location4", "line_index": 303, "text": "Det kommer att vara så för oss, hela tiden."}
{"category": "LocationDialogue Location4", "line_index": 304, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 305, "text": "Jag fattar."}
{"category": "LocationDialogue Location4", "line_index": 306, "text": "Då kanske det är bäst att vi stänger av reflektionerna..."}
{"category": "LocationDialogue Location4", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 308, "text": "Hej, [player],"}
{"category": "LocationDialogue Location4", "line_index": 309, "text": "du gillar verkligen speglar, eller hur?"}
{"category": "LocationDialogue Location4", "line_index": 310, "text": "Rädd för att se ett leende på ditt ansikte?"}
{"category": "LocationDialogue Location4", "line_index": 311, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 312, "text": "Huh? Inte riktigt..."}
{"category": "LocationDialogue Location4", "line_index": 313, "text": "Jag är bara trött"}
{"category": "LocationDialogue Location4", "line_index": 314, "text": "efter allt arbete."}
{"category": "LocationDialogue Location4", "line_index": 315, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 316, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 317, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 318, "text": "// Blå sneakers"}
{"category": "LocationDialogue Location4", "line_index": 319, "text": "Är de här dina?"}
{"category": "LocationDialogue Location4", "line_index": 320, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 321, "text": "Nej, de är dina."}
{"category": "LocationDialogue Location4", "line_index": 322, "text": "Kommer du inte ihåg?"}
{"category": "LocationDialogue Location4", "line_index": 323, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 324, "text": "Jag minns inte att jag hade såna sneakers."}
{"category": "LocationDialogue Location4", "line_index": 325, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 326, "text": "Nu har du det."}
{"category": "LocationDialogue Location4", "line_index": 327, "text": "Du kan ha dem på dig"}
{"category": "LocationDialogue Location4", "line_index": 328, "text": "när vi går ut."}
{"category": "LocationDialogue Location4", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 330, "text": "Kläder, då?"}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "Allt jag har i den här världen"}
{"category": "LocationDialogue Location4", "line_index": 332, "text": "är kläderna jag har på mig."}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "Finns det något sätt för mig att skaffa nya?"}
{"category": "LocationDialogue Location4", "line_index": 334, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 335, "text": "Självklart finns det det."}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "Men jag har sett vad du har på dig..."}
{"category": "LocationDialogue Location4", "line_index": 337, "text": "och ärligt talat, din smak är inte så bra."}
{"category": "LocationDialogue Location4", "line_index": 338, "text": "Hur som helst, jag ska hjälpa dig att skaffa några."}
{"category": "LocationDialogue Location4", "line_index": 339, "text": "Men inte just nu."}
{"category": "LocationDialogue Location4", "line_index": 340, "text": "Jag lovar."}
{"category": "LocationDialogue Location4", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 342, "text": "Okej."}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Spel på TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "Vad vill du spela?"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Spelmjölk"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "Det här är ett fightingspel!"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "Låt oss se vem som surnar först!"}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "Vilket spel!"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": "Vi har fått tillräckligt med mjölk för nu, låt oss göra något annat."}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Spel pingviner"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "I det här spelet är du en pingvin"}
{"category": "LocationDialogue Location4", "line_index": 354, "text": "som glider runt."}
{"category": "LocationDialogue Location4", "line_index": 355, "text": "Just det, det var det spelet."}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Stanna med Mita"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "Huh, vad?"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "Menar du allvar? Jag trodde att du var..."}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "Jag är jätteglad!"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "Och lite förvirrad..."}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "Men..."}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "Snälla, stanna hos mig..."}
{"category": "LocationDialogue Location4", "line_index": 364, "text": "för alltid och för evigt."}
{"category": "LocationDialogue Location4", "line_index": 365, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 367, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 368, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 369, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 370, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 372, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 373, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 374, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 375, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 376, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 377, "text": "// Ett spel om pingviner"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "Det är superenkelt:"}
{"category": "LocationDialogue Location4", "line_index": 379, "text": "bara samla snöbollar."}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "Den som samlar flest vinner!"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "Låt oss spela två rundor, okej?!"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// Den första kartan"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "Wow, hur fick du ihop så många?"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "Tee-hee! Jag har flest snöbollar!"}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "Bäst att komma ikapp!"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "Ha, 1:1!"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// Den andra kartan"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "Du är en naturlig pingvin!"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "Vi borde få ut dig på riktig is!"}
{"category": "LocationDialogue Location4", "line_index": 390, "text": "Pfft, du är så långsam."}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "Tänker du fortfarande på förra omgången?"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "Oj, oavgjort! Det är sällsynt!"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// Spelet är över"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "Okej, vill du spela något annat?"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "Eller är du klar?"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "Vad ska du med den till?"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "Är du så mycket av en gamer?"}
