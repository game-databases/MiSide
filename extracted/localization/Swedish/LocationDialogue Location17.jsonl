{"category": "LocationDialogue Location17", "line_index": 0, "text": "// Spelaren tänker + Kokar kaffe"}
{"category": "LocationDialogue Location17", "line_index": 1, "text": "Jag behöver någons hjälp här."}
{"category": "LocationDialogue Location17", "line_index": 2, "text": "Jag hoppas att Mita här inte bits..."}
{"category": "LocationDialogue Location17", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 4, "text": "Vad slösar jag bort min tid på..."}
{"category": "LocationDialogue Location17", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 9, "text": "// Spelaren försöker väcka MitaDreamer"}
{"category": "LocationDialogue Location17", "line_index": 10, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 11, "text": "Mita, vakna!"}
{"category": "LocationDialogue Location17", "line_index": 12, "text": "Mita!"}
{"category": "LocationDialogue Location17", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 14, "text": "Mita, vakna nu!"}
{"category": "LocationDialogue Location17", "line_index": 15, "text": "Jag behöver din hjälp."}
{"category": "LocationDialogue Location17", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 17, "text": "Vem är du?"}
{"category": "LocationDialogue Location17", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 19, "text": "Hjälp mig med switchen."}
{"category": "LocationDialogue Location17", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 21, "text": "Vilka switchar?"}
{"category": "LocationDialogue Location17", "line_index": 22, "text": "Låt mig sova..."}
{"category": "LocationDialogue Location17", "line_index": 23, "text": "Eller ge mig en kopp kaffe."}
{"category": "LocationDialogue Location17", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 25, "text": "Kaffebryggaren är precis där borta."}
{"category": "LocationDialogue Location17", "line_index": 26, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 27, "text": "Mi-ita!"}
{"category": "LocationDialogue Location17", "line_index": 28, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 31, "text": "// Spelaren ger bort kaffet"}
{"category": "LocationDialogue Location17", "line_index": 32, "text": "Mita,"}
{"category": "LocationDialogue Location17", "line_index": 33, "text": "här är ditt kaffe."}
{"category": "LocationDialogue Location17", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 37, "text": "// MitaDreamer övar"}
{"category": "LocationDialogue Location17", "line_index": 38, "text": "Switchar,"}
{"category": "LocationDialogue Location17", "line_index": 39, "text": "säger du?"}
{"category": "LocationDialogue Location17", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 41, "text": "Ja, det gör jag."}
{"category": "LocationDialogue Location17", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 43, "text": "Hur kommer det sig att du känner till dem?"}
{"category": "LocationDialogue Location17", "line_index": 44, "text": "Men, varför frågar jag ens..."}
{"category": "LocationDialogue Location17", "line_index": 45, "text": "Med tanke på att du är här,"}
{"category": "LocationDialogue Location17", "line_index": 46, "text": "borde du veta mycket redan..."}
{"category": "LocationDialogue Location17", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 48, "text": "Ett ögonblick bara,"}
{"category": "LocationDialogue Location17", "line_index": 49, "text": "Jag behöver sitta ner."}
{"category": "LocationDialogue Location17", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 51, "text": "Och?"}
{"category": "LocationDialogue Location17", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 53, "text": "Jag vet inte vad jag ska säga..."}
{"category": "LocationDialogue Location17", "line_index": 54, "text": "Men jag måste fortsätta,"}
{"category": "LocationDialogue Location17", "line_index": 55, "text": "fortsätta följa ringens vägledning."}
{"category": "LocationDialogue Location17", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 57, "text": "Har du hennes ring?"}
{"category": "LocationDialogue Location17", "line_index": 58, "text": "Inte så konstigt"}
{"category": "LocationDialogue Location17", "line_index": 59, "text": "att du hittade den här platsen."}
{"category": "LocationDialogue Location17", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 61, "text": "Ja, just det."}
{"category": "LocationDialogue Location17", "line_index": 62, "text": "Så, kan du hjälpa mig?"}
{"category": "LocationDialogue Location17", "line_index": 63, "text": "Med strömbrytarna?"}
{"category": "LocationDialogue Location17", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 65, "text": "Javisst."}
{"category": "LocationDialogue Location17", "line_index": 66, "text": "Det ska jag göra."}
{"category": "LocationDialogue Location17", "line_index": 67, "text": "Med switcharna..."}
{"category": "LocationDialogue Location17", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 70, "text": "Mita, kom igen..."}
{"category": "LocationDialogue Location17", "line_index": 71, "text": "Låt oss gå redan."}
{"category": "LocationDialogue Location17", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 73, "text": "Uh?"}
{"category": "LocationDialogue Location17", "line_index": 74, "text": "Okej, okej."}
{"category": "LocationDialogue Location17", "line_index": 75, "text": "Då går vi."}
{"category": "LocationDialogue Location17", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 78, "text": "// MitaDreamer fall"}
{"category": "LocationDialogue Location17", "line_index": 79, "text": "Gå upp."}
{"category": "LocationDialogue Location17", "line_index": 80, "text": "Är du så sömnig?"}
{"category": "LocationDialogue Location17", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 82, "text": "// MitaDreamer igen sova"}
{"category": "LocationDialogue Location17", "line_index": 83, "text": "Vakna upp."}
{"category": "LocationDialogue Location17", "line_index": 84, "text": "Vi är framme."}
{"category": "LocationDialogue Location17", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 87, "text": "// Switches"}
{"category": "LocationDialogue Location17", "line_index": 88, "text": "Okej,"}
{"category": "LocationDialogue Location17", "line_index": 89, "text": "jag är redo."}
{"category": "LocationDialogue Location17", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 91, "text": "Jag är också redo."}
{"category": "LocationDialogue Location17", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 93, "text": "Nåväl..."}
{"category": "LocationDialogue Location17", "line_index": 94, "text": "Jag börjar"}
{"category": "LocationDialogue Location17", "line_index": 95, "text": "nedräkningen."}
{"category": "LocationDialogue Location17", "line_index": 96, "text": "Och vi drar ihop brytarna."}
{"category": "LocationDialogue Location17", "line_index": 97, "text": "Okej?"}
{"category": "LocationDialogue Location17", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 99, "text": "Håll dig bara vaken, okej!"}
{"category": "LocationDialogue Location17", "line_index": 100, "text": "Kör."}
{"category": "LocationDialogue Location17", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 103, "text": "3"}
{"category": "LocationDialogue Location17", "line_index": 104, "text": "2"}
{"category": "LocationDialogue Location17", "line_index": 105, "text": "1"}
{"category": "LocationDialogue Location17", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 107, "text": "// Spelare förlorar 1"}
{"category": "LocationDialogue Location17", "line_index": 108, "text": "Tappar du bort dig?"}
{"category": "LocationDialogue Location17", "line_index": 109, "text": "Kom igen nu..,"}
{"category": "LocationDialogue Location17", "line_index": 110, "text": "nu kör vi igen..."}
{"category": "LocationDialogue Location17", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 112, "text": "// Spelaren förlorar 2"}
{"category": "LocationDialogue Location17", "line_index": 113, "text": "Ett försök till?"}
{"category": "LocationDialogue Location17", "line_index": 114, "text": "Kom igen, jag..,"}
{"category": "LocationDialogue Location17", "line_index": 115, "text": "jag..."}
{"category": "LocationDialogue Location17", "line_index": 116, "text": "Jag håller på att somna här..."}
{"category": "LocationDialogue Location17", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 118, "text": "// Spelare förlorar 3"}
{"category": "LocationDialogue Location17", "line_index": 119, "text": "Jag håller på att somna..."}
{"category": "LocationDialogue Location17", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 122, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 123, "text": "Underbart,"}
{"category": "LocationDialogue Location17", "line_index": 124, "text": "tack så mycket, Mita."}
{"category": "LocationDialogue Location17", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 126, "text": "Mm-hmm."}
{"category": "LocationDialogue Location17", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 129, "text": "Dörrarna..."}
{"category": "LocationDialogue Location17", "line_index": 130, "text": "...så..."}
{"category": "LocationDialogue Location17", "line_index": 131, "text": "...långsamma..."}
{"category": "LocationDialogue Location17", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 134, "text": "Jag går och lägger mig..."}
{"category": "LocationDialogue Location17", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 136, "text": "// Varför köket?"}
{"category": "LocationDialogue Location17", "line_index": 137, "text": "Varför gå till köket?"}
{"category": "LocationDialogue Location17", "line_index": 138, "text": "Om jag somnar på det kalla golvet,"}
{"category": "LocationDialogue Location17", "line_index": 139, "text": "är det ditt fel."}
{"category": "LocationDialogue Location17", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 141, "text": "// Varför badrum?"}
{"category": "LocationDialogue Location17", "line_index": 142, "text": "Jag förstår inte..."}
{"category": "LocationDialogue Location17", "line_index": 143, "text": "vilka switchar behövde du hjälp med?"}
{"category": "LocationDialogue Location17", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 145, "text": "// Put button"}
{"category": "LocationDialogue Location17", "line_index": 146, "text": "Ingenting hände?"}
{"category": "LocationDialogue Location17", "line_index": 147, "text": "Vad gör då den här knappen här?"}
{"category": "LocationDialogue Location17", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 149, "text": "// Cofee"}
{"category": "LocationDialogue Location17", "line_index": 150, "text": "Lite mer kaffe?"}
{"category": "LocationDialogue Location17", "line_index": 151, "text": "Annars somnar du igen."}
{"category": "LocationDialogue Location17", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 153, "text": "Vad är det?"}
{"category": "LocationDialogue Location17", "line_index": 154, "text": "Nej, nej..."}
{"category": "LocationDialogue Location17", "line_index": 155, "text": "Det här kaffet smakar fruktansvärt..."}
{"category": "LocationDialogue Location17", "line_index": 156, "text": "Jag är helt okej..."}
{"category": "LocationDialogue Location17", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 158, "text": "// Knapp"}
{"category": "LocationDialogue Location17", "line_index": 159, "text": "Mita? Knappen fungerar inte... Kan du höra mig?"}
{"category": "LocationDialogue Location17", "line_index": 160, "text": "Hallå?"}
