{"category": "LocationDialogue Location3", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 1, "text": "Hej, [player]!"}
{"category": "LocationDialogue Location3", "line_index": 2, "text": "Äntligen möts vi!"}
{"category": "LocationDialogue Location3", "line_index": 3, "text": "Jag är så taggad!"}
{"category": "LocationDialogue Location3", "line_index": 4, "text": "Jag vet att du har frågor..."}
{"category": "LocationDialogue Location3", "line_index": 5, "text": "Som du kan se,"}
{"category": "LocationDialogue Location3", "line_index": 6, "text": "gjorde jag den här speciella enheten"}
{"category": "LocationDialogue Location3", "line_index": 7, "text": "för att föra dig hit till min sida."}
{"category": "LocationDialogue Location3", "line_index": 8, "text": "Men du hamnade i en annan version av spelet..."}
{"category": "LocationDialogue Location3", "line_index": 9, "text": "I vilken jag..."}
{"category": "LocationDialogue Location3", "line_index": 10, "text": "Men det är en lång historia!"}
{"category": "LocationDialogue Location3", "line_index": 11, "text": "Hur som helst, jag är bara glad att se dig!"}
{"category": "LocationDialogue Location3", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 13, "text": "// Svar 1 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 14, "text": "Ja, det är jag."}
{"category": "LocationDialogue Location3", "line_index": 15, "text": "Och du måste vara [player], eller hur?"}
{"category": "LocationDialogue Location3", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 17, "text": "// Svar 2 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 18, "text": "Ska du redan gå tillbaka?"}
{"category": "LocationDialogue Location3", "line_index": 19, "text": "Jag antar att jag kan hjälpa dig med det... Men hur blir det med mig då?"}
{"category": "LocationDialogue Location3", "line_index": 20, "text": "Snälla, stanna hos mig ett tag..."}
{"category": "LocationDialogue Location3", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 22, "text": "// Svar 3 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 23, "text": "Låt mig förklara..."}
{"category": "LocationDialogue Location3", "line_index": 24, "text": "Och här är du!"}
{"category": "LocationDialogue Location3", "line_index": 25, "text": "Fattar du?"}
{"category": "LocationDialogue Location3", "line_index": 26, "text": "Uhm... inte riktigt."}
{"category": "LocationDialogue Location3", "line_index": 27, "text": "Det gör inget!"}
{"category": "LocationDialogue Location3", "line_index": 28, "text": "Det viktiga är att vi är tillsammans nu."}
{"category": "LocationDialogue Location3", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 31, "text": "Är du hungrig?"}
{"category": "LocationDialogue Location3", "line_index": 32, "text": "Vad sägs om att vi lagar något?"}
{"category": "LocationDialogue Location3", "line_index": 33, "text": "Här,"}
{"category": "LocationDialogue Location3", "line_index": 34, "text": "hjälp mig med de här morötterna."}
{"category": "LocationDialogue Location3", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 36, "text": "Var kom grönsakerna ifrån?"}
{"category": "LocationDialogue Location3", "line_index": 37, "text": "De var inte här nyss."}
{"category": "LocationDialogue Location3", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 39, "text": "[player], vi är med i ett spel."}
{"category": "LocationDialogue Location3", "line_index": 40, "text": "Kom igen, ge mig en hand."}
{"category": "LocationDialogue Location3", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 42, "text": "Tack för hjälpen!"}
{"category": "LocationDialogue Location3", "line_index": 43, "text": "Kan du hämta saxen?"}
{"category": "LocationDialogue Location3", "line_index": 44, "text": "Den är i badrummet."}
{"category": "LocationDialogue Location3", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 46, "text": "Sätt dig nu."}
{"category": "LocationDialogue Location3", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 49, "text": "// Kök"}
{"category": "LocationDialogue Location3", "line_index": 50, "text": "Vill du ha lite sås?"}
{"category": "LocationDialogue Location3", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 52, "text": "Nej, tack."}
{"category": "LocationDialogue Location3", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 54, "text": "Det är synd."}
{"category": "LocationDialogue Location3", "line_index": 55, "text": "Sås förhöjer verkligen smaken!"}
{"category": "LocationDialogue Location3", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 58, "text": "Tack."}
{"category": "LocationDialogue Location3", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 60, "text": "Har du ätit upp allt redan?"}
{"category": "LocationDialogue Location3", "line_index": 61, "text": "Huh, min portion känns"}
{"category": "LocationDialogue Location3", "line_index": 62, "text": "oändlig..."}
{"category": "LocationDialogue Location3", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 65, "text": "// Hjälp"}
{"category": "LocationDialogue Location3", "line_index": 66, "text": "Vad är det för fel?"}
{"category": "LocationDialogue Location3", "line_index": 67, "text": "Berätta för mig vad du ser och känner."}
{"category": "LocationDialogue Location3", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 69, "text": "Mitt hjärta rusar,"}
{"category": "LocationDialogue Location3", "line_index": 70, "text": "och min syn är suddig."}
{"category": "LocationDialogue Location3", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 72, "text": "Okej."}
{"category": "LocationDialogue Location3", "line_index": 73, "text": "Jag tror jag vet vad som är fel."}
{"category": "LocationDialogue Location3", "line_index": 74, "text": "Kan du resa dig upp?"}
{"category": "LocationDialogue Location3", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 78, "text": "Vad är det här?"}
{"category": "LocationDialogue Location3", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 80, "text": "Tabletter."}
{"category": "LocationDialogue Location3", "line_index": 81, "text": "De får dig att må bättre snart."}
{"category": "LocationDialogue Location3", "line_index": 82, "text": "Gå till spegeln."}
{"category": "LocationDialogue Location3", "line_index": 83, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 84, "text": "Ta tabletterna."}
{"category": "LocationDialogue Location3", "line_index": 85, "text": "Kom igen nu."}
{"category": "LocationDialogue Location3", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 89, "text": "Hur känner du dig?"}
{"category": "LocationDialogue Location3", "line_index": 90, "text": "Mår du bättre?"}
{"category": "LocationDialogue Location3", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 92, "text": "Ja..."}
{"category": "LocationDialogue Location3", "line_index": 93, "text": "Det fungerade snabbt..."}
{"category": "LocationDialogue Location3", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 95, "text": "[player], vi är i ett spel."}
{"category": "LocationDialogue Location3", "line_index": 96, "text": "Saker och ting är mycket enklare här."}
{"category": "LocationDialogue Location3", "line_index": 97, "text": "Även den minsta insatsen"}
{"category": "LocationDialogue Location3", "line_index": 98, "text": "ger stora resultat."}
{"category": "LocationDialogue Location3", "line_index": 99, "text": "Allt är en del av spelkonceptet:"}
{"category": "LocationDialogue Location3", "line_index": 100, "text": "Förenkling."}
{"category": "LocationDialogue Location3", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 102, "text": "Ett exempel, tack?"}
{"category": "LocationDialogue Location3", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 104, "text": "Till exempel, ta morötter."}
{"category": "LocationDialogue Location3", "line_index": 105, "text": "Du skär en,"}
{"category": "LocationDialogue Location3", "line_index": 106, "text": "men det är som om du skär tre."}
{"category": "LocationDialogue Location3", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 108, "text": "Allt det här kommer väldigt plötsligt."}
{"category": "LocationDialogue Location3", "line_index": 109, "text": "Jag är rädd, mer än lite."}
{"category": "LocationDialogue Location3", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 112, "text": "Vad är det för fel?"}
{"category": "LocationDialogue Location3", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 114, "text": "Jag hittade kassetter i luftventilationen."}
{"category": "LocationDialogue Location3", "line_index": 115, "text": "Det stod namn på dem."}
{"category": "LocationDialogue Location3", "line_index": 116, "text": "Vad är grejen med det?"}
{"category": "LocationDialogue Location3", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 118, "text": "Kassetter?"}
{"category": "LocationDialogue Location3", "line_index": 119, "text": "Vilka kassetter?"}
{"category": "LocationDialogue Location3", "line_index": 120, "text": "Låt oss räkna ut det tillsammans."}
{"category": "LocationDialogue Location3", "line_index": 121, "text": "Men senare."}
{"category": "LocationDialogue Location3", "line_index": 122, "text": "Just nu måste vi äta."}
{"category": "LocationDialogue Location3", "line_index": 123, "text": "Ge mig saxen, är du snäll."}
{"category": "LocationDialogue Location3", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 125, "text": "// Ring"}
{"category": "LocationDialogue Location3", "line_index": 126, "text": "En ring?"}
{"category": "LocationDialogue Location3", "line_index": 127, "text": "// Spegel"}
{"category": "LocationDialogue Location3", "line_index": 128, "text": "Varför finns det ingen reflektion?"}
{"category": "LocationDialogue Location3", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 130, "text": "Åh, just det!"}
{"category": "LocationDialogue Location3", "line_index": 131, "text": "Jag glömde slå på reflektioner."}
{"category": "LocationDialogue Location3", "line_index": 132, "text": "Så där ja."}
{"category": "LocationDialogue Location3", "line_index": 133, "text": "Reflektionerna är tillbaka!"}
{"category": "LocationDialogue Location3", "line_index": 134, "text": "Förresten..,"}
{"category": "LocationDialogue Location3", "line_index": 135, "text": "jag visste faktiskt inte ens vad reflektioner var förut."}
{"category": "LocationDialogue Location3", "line_index": 136, "text": "De existerade inte i min värld-"}
{"category": "LocationDialogue Location3", "line_index": 137, "text": "inte förrän någon uppdatering, så klart. :)"}
{"category": "LocationDialogue Location3", "line_index": 138, "text": "Finns det massor av reflektioner"}
{"category": "LocationDialogue Location3", "line_index": 139, "text": "i din värld?"}
{"category": "LocationDialogue Location3", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 141, "text": "Ja, så klart."}
{"category": "LocationDialogue Location3", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 144, "text": "Kommer du ihåg"}
{"category": "LocationDialogue Location3", "line_index": 145, "text": "de tre objekten du hittade?"}
{"category": "LocationDialogue Location3", "line_index": 146, "text": "De som du placerade på skannern?"}
{"category": "LocationDialogue Location3", "line_index": 147, "text": "Tja, um..."}
{"category": "LocationDialogue Location3", "line_index": 148, "text": "Dessa objekt"}
{"category": "LocationDialogue Location3", "line_index": 149, "text": "är kopplade till den här versionen av världen."}
{"category": "LocationDialogue Location3", "line_index": 150, "text": "Det är därför du är här nu."}
{"category": "LocationDialogue Location3", "line_index": 151, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 152, "text": "// Movbile TV"}
{"category": "LocationDialogue Location3", "line_index": 153, "text": "Det är den bärbara TV:n"}
{"category": "LocationDialogue Location3", "line_index": 154, "text": "Jag köpte till dig."}
{"category": "LocationDialogue Location3", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 156, "text": "Japp!"}
{"category": "LocationDialogue Location3", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 158, "text": "Du sa till mig"}
{"category": "LocationDialogue Location3", "line_index": 159, "text": "att den var trasig."}
{"category": "LocationDialogue Location3", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 161, "text": "Jo, jag ville"}
{"category": "LocationDialogue Location3", "line_index": 162, "text": "överraska dig!"}
{"category": "LocationDialogue Location3", "line_index": 163, "text": "Jag berättade en liten vit lögn"}
{"category": "LocationDialogue Location3", "line_index": 164, "text": "för att få dig hit, in i min värld."}
{"category": "LocationDialogue Location3", "line_index": 165, "text": "Den fungerar nu - visar information!"}
{"category": "LocationDialogue Location3", "line_index": 166, "text": "Åh, och förresten..."}
{"category": "LocationDialogue Location3", "line_index": 167, "text": "Jag är lite av en tekniker!"}
{"category": "LocationDialogue Location3", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 169, "text": "// Skolduk"}
{"category": "LocationDialogue Location3", "line_index": 170, "text": "Vad är det här för något?"}
{"category": "LocationDialogue Location3", "line_index": 171, "text": "En skoluniform?"}
{"category": "LocationDialogue Location3", "line_index": 172, "text": "Varför skulle du behöva det?"}
{"category": "LocationDialogue Location3", "line_index": 173, "text": "Går du verkligen i skolan?"}
{"category": "LocationDialogue Location3", "line_index": 174, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 175, "text": "Går till skolan?"}
{"category": "LocationDialogue Location3", "line_index": 176, "text": "Nej, inte alls."}
{"category": "LocationDialogue Location3", "line_index": 177, "text": "Men jag älskar uniformen"}
{"category": "LocationDialogue Location3", "line_index": 178, "text": "Tycker du inte att jag ser söt ut"}
{"category": "LocationDialogue Location3", "line_index": 179, "text": "i den?"}
{"category": "LocationDialogue Location3", "line_index": 180, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 181, "text": "// PC"}
{"category": "LocationDialogue Location3", "line_index": 182, "text": "Fungerar datorn?"}
{"category": "LocationDialogue Location3", "line_index": 183, "text": "Eller är det bara en skrivbordsdekoration?"}
{"category": "LocationDialogue Location3", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 185, "text": "Självklart fungerar den."}
{"category": "LocationDialogue Location3", "line_index": 186, "text": "Allting här"}
{"category": "LocationDialogue Location3", "line_index": 187, "text": "fungerar precis som i din värld."}
{"category": "LocationDialogue Location3", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 189, "text": "Tillbaka i min värld,"}
{"category": "LocationDialogue Location3", "line_index": 190, "text": "sitter jag mycket vid min dator..."}
{"category": "LocationDialogue Location3", "line_index": 191, "text": "Och jobbar hårt."}
{"category": "LocationDialogue Location3", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 193, "text": "Jag vet, jag vet."}
{"category": "LocationDialogue Location3", "line_index": 194, "text": "Det är på grund av ditt jobb"}
{"category": "LocationDialogue Location3", "line_index": 195, "text": "så har du gett mig"}
{"category": "LocationDialogue Location3", "line_index": 196, "text": "så lite uppmärksamhet."}
{"category": "LocationDialogue Location3", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 198, "text": "Man måste ju försörja sig, du vet."}
{"category": "LocationDialogue Location3", "line_index": 199, "text": "Men... hur vet du att jag sitter mycket vid datorn?"}
{"category": "LocationDialogue Location3", "line_index": 200, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 201, "text": "Din mobilkamera... den är på ibland."}
{"category": "LocationDialogue Location3", "line_index": 202, "text": "Jag är ledsen."}
{"category": "LocationDialogue Location3", "line_index": 203, "text": "Jag har tittat på dig i smyg >A<"}
{"category": "LocationDialogue Location3", "line_index": 204, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 205, "text": "Det är inte alls okej."}
{"category": "LocationDialogue Location3", "line_index": 206, "text": "Men vad som helst."}
{"category": "LocationDialogue Location3", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 208, "text": "// Paraply"}
{"category": "LocationDialogue Location3", "line_index": 209, "text": "Jag har spelat massor"}
{"category": "LocationDialogue Location3", "line_index": 210, "text": "men jag har aldrig sett det regna här."}
{"category": "LocationDialogue Location3", "line_index": 211, "text": "Varför ha ett paraply?"}
{"category": "LocationDialogue Location3", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 213, "text": "Det regnar - bara väldigt sällan."}
{"category": "LocationDialogue Location3", "line_index": 214, "text": "Du har bara inte sett det än."}
{"category": "LocationDialogue Location3", "line_index": 215, "text": "Kanske en dag kommer du att göra det."}
{"category": "LocationDialogue Location3", "line_index": 216, "text": "Och då kommer du att behöva ett paraply."}
{"category": "LocationDialogue Location3", "line_index": 217, "text": "Tycker du inte det?"}
{"category": "LocationDialogue Location3", "line_index": 218, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 219, "text": "// Elektrisk panel"}
{"category": "LocationDialogue Location3", "line_index": 220, "text": "Varför finns det en elektrisk panel här?"}
{"category": "LocationDialogue Location3", "line_index": 221, "text": "Och om vi är i ett spel,"}
{"category": "LocationDialogue Location3", "line_index": 222, "text": "vad är den till för?"}
{"category": "LocationDialogue Location3", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 224, "text": "För det första,"}
{"category": "LocationDialogue Location3", "line_index": 225, "text": "är vi i ett spel."}
{"category": "LocationDialogue Location3", "line_index": 226, "text": "Så att fråga ”varför” är..."}
{"category": "LocationDialogue Location3", "line_index": 227, "text": "...meningslöst."}
{"category": "LocationDialogue Location3", "line_index": 228, "text": "Men det gör det"}
{"category": "LocationDialogue Location3", "line_index": 229, "text": "starta om elektriciteten."}
{"category": "LocationDialogue Location3", "line_index": 230, "text": "Allt här är gjort baserat"}
{"category": "LocationDialogue Location3", "line_index": 231, "text": "på din värld."}
{"category": "LocationDialogue Location3", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 233, "text": "// Utgångsdörr"}
{"category": "LocationDialogue Location3", "line_index": 234, "text": "Kan vi gå ut?"}
{"category": "LocationDialogue Location3", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 236, "text": "Nja..."}
{"category": "LocationDialogue Location3", "line_index": 237, "text": "Inte än."}
{"category": "LocationDialogue Location3", "line_index": 238, "text": "Kanske senare."}
{"category": "LocationDialogue Location3", "line_index": 239, "text": "Vi stannar här just nu."}
{"category": "LocationDialogue Location3", "line_index": 240, "text": "Här hemma."}
{"category": "LocationDialogue Location3", "line_index": 241, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 242, "text": "// Böcker"}
{"category": "LocationDialogue Location3", "line_index": 243, "text": "Du har massor av böcker här."}
{"category": "LocationDialogue Location3", "line_index": 244, "text": "Har du läst dem alla?"}
{"category": "LocationDialogue Location3", "line_index": 245, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 246, "text": "Det har jag, varenda en."}
{"category": "LocationDialogue Location3", "line_index": 247, "text": "Att vara här ensam"}
{"category": "LocationDialogue Location3", "line_index": 248, "text": "är verkligen, verkligen tråkigt."}
{"category": "LocationDialogue Location3", "line_index": 249, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 250, "text": "// TV i rum kök"}
{"category": "LocationDialogue Location3", "line_index": 251, "text": "Varför skaffa en andra TV?"}
{"category": "LocationDialogue Location3", "line_index": 252, "text": "Och en gammal till och med?"}
{"category": "LocationDialogue Location3", "line_index": 253, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 254, "text": "Tycker du inte om den?"}
{"category": "LocationDialogue Location3", "line_index": 255, "text": "Jag kan ta bort den..."}
{"category": "LocationDialogue Location3", "line_index": 256, "text": "Men för att svara..."}
{"category": "LocationDialogue Location3", "line_index": 257, "text": "Den är till för dekoration,"}
{"category": "LocationDialogue Location3", "line_index": 258, "text": "för att lysa upp köket."}
{"category": "LocationDialogue Location3", "line_index": 259, "text": "Men den fungerar också!"}
{"category": "LocationDialogue Location3", "line_index": 260, "text": "Jag kan titta på alla"}
{"category": "LocationDialogue Location3", "line_index": 261, "text": "klassiska programmen!"}
{"category": "LocationDialogue Location3", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 263, "text": "// Mobiltelefon"}
{"category": "LocationDialogue Location3", "line_index": 264, "text": "Det där är min telefon."}
{"category": "LocationDialogue Location3", "line_index": 265, "text": "Och den ligger inte längre i min ficka."}
{"category": "LocationDialogue Location3", "line_index": 266, "text": "Hur i hela friden hamnade den här?"}
{"category": "LocationDialogue Location3", "line_index": 267, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 268, "text": "Uhm, det är inte viktigt."}
{"category": "LocationDialogue Location3", "line_index": 269, "text": "Hej, jag har en idé!"}
{"category": "LocationDialogue Location3", "line_index": 270, "text": "Vi tar ett foto!"}
{"category": "LocationDialogue Location3", "line_index": 271, "text": "Le!"}
{"category": "LocationDialogue Location3", "line_index": 272, "text": "Det blev ju en jättebra bild!"}
{"category": "LocationDialogue Location3", "line_index": 273, "text": "En minnessak för dig."}
{"category": "LocationDialogue Location3", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 275, "text": "Jag har en fråga."}
{"category": "LocationDialogue Location3", "line_index": 276, "text": "Om jag"}
{"category": "LocationDialogue Location3", "line_index": 277, "text": "kör ett spel på den,"}
{"category": "LocationDialogue Location3", "line_index": 278, "text": "kommer jag att se dig där?"}
{"category": "LocationDialogue Location3", "line_index": 279, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 280, "text": "Nej, det fungerar inte på det sättet."}
{"category": "LocationDialogue Location3", "line_index": 281, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 282, "text": "Cool Juice"}
{"category": "LocationDialogue Location3", "line_index": 283, "text": "Stark JUICE!!!"}
{"category": "LocationDialogue Location3", "line_index": 284, "text": "// TV"}
{"category": "LocationDialogue Location3", "line_index": 285, "text": "Hur många kanaler"}
{"category": "LocationDialogue Location3", "line_index": 286, "text": "har du?"}
{"category": "LocationDialogue Location3", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 288, "text": "Det funkar inte så."}
{"category": "LocationDialogue Location3", "line_index": 289, "text": "Den är ansluten till Internet."}
{"category": "LocationDialogue Location3", "line_index": 290, "text": "Så du kan titta på vad som helst,"}
{"category": "LocationDialogue Location3", "line_index": 291, "text": "åtminstone allt som finns tillgängligt på webben."}
{"category": "LocationDialogue Location3", "line_index": 292, "text": "Vänta lite."}
{"category": "LocationDialogue Location3", "line_index": 293, "text": "Err, oops."}
{"category": "LocationDialogue Location3", "line_index": 294, "text": "Vad är det där för något?"}
{"category": "LocationDialogue Location3", "line_index": 295, "text": "En cirkel av kattungar?"}
{"category": "LocationDialogue Location3", "line_index": 296, "text": "Åh, titta."}
{"category": "LocationDialogue Location3", "line_index": 297, "text": "Vet du vad?"}
{"category": "LocationDialogue Location3", "line_index": 298, "text": "Pausa!"}
{"category": "LocationDialogue Location3", "line_index": 299, "text": "Vill du ha lite juice?"}
{"category": "LocationDialogue Location3", "line_index": 300, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 301, "text": "Så märkliga annonser..."}
{"category": "LocationDialogue Location3", "line_index": 302, "text": "Död juice?"}
{"category": "LocationDialogue Location3", "line_index": 303, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 304, "text": "Ja, och den här juicen"}
{"category": "LocationDialogue Location3", "line_index": 305, "text": "är direkt från juicereklamen."}
{"category": "LocationDialogue Location3", "line_index": 306, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 308, "text": "Ah, smaken..."}
{"category": "LocationDialogue Location3", "line_index": 309, "text": "Jag gillar den,"}
{"category": "LocationDialogue Location3", "line_index": 310, "text": "och ändå kan jag inte säga vad den smakar som."}
{"category": "LocationDialogue Location3", "line_index": 311, "text": "Allt är väldigt förvirrande."}
{"category": "LocationDialogue Location3", "line_index": 312, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 313, "text": "Eller hur?"}
{"category": "LocationDialogue Location3", "line_index": 314, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 315, "text": "// Mita blyg"}
{"category": "LocationDialogue Location3", "line_index": 316, "text": "Vad är det du håller på med?"}
{"category": "LocationDialogue Location3", "line_index": 317, "text": "Stirra inte, snälla."}
{"category": "LocationDialogue Location3", "line_index": 318, "text": "Du gör mig generad."}
{"category": "LocationDialogue Location3", "line_index": 319, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 320, "text": "// Statyetten"}
{"category": "LocationDialogue Location3", "line_index": 321, "text": "Det är en läskig figur."}
{"category": "LocationDialogue Location3", "line_index": 322, "text": "Gillar du"}
{"category": "LocationDialogue Location3", "line_index": 323, "text": "gillar du sådana saker?"}
{"category": "LocationDialogue Location3", "line_index": 324, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 325, "text": "Tycker du att den är läskig?"}
{"category": "LocationDialogue Location3", "line_index": 326, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 327, "text": "Ja, det tycker jag."}
{"category": "LocationDialogue Location3", "line_index": 328, "text": "Det ser nästan ut som om den är förhäxad..."}
{"category": "LocationDialogue Location3", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 330, "text": "Nä, definitivt inte förhäxad."}
{"category": "LocationDialogue Location3", "line_index": 331, "text": "Och inte läskig heller."}
{"category": "LocationDialogue Location3", "line_index": 332, "text": "Jag tycker den är ganska söt!"}
{"category": "LocationDialogue Location3", "line_index": 333, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 334, "text": "Du kanske har rätt..."}
{"category": "LocationDialogue Location3", "line_index": 335, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 336, "text": "Mita?"}
{"category": "LocationDialogue Location3", "line_index": 337, "text": "Vad är det som händer?"}
{"category": "LocationDialogue Location3", "line_index": 338, "text": "// Mita kök"}
{"category": "LocationDialogue Location3", "line_index": 339, "text": "Vad sägs om en pratstund"}
{"category": "LocationDialogue Location3", "line_index": 340, "text": "innan vi sätter igång?"}
{"category": "LocationDialogue Location3", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 342, "text": "// Starta Äta"}
{"category": "LocationDialogue Location3", "line_index": 343, "text": "Bon appétit."}
{"category": "LocationDialogue Location3", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 345, "text": "// Uppdrag 1"}
{"category": "LocationDialogue Location3", "line_index": 346, "text": "Det är det, eller hur?"}
{"category": "LocationDialogue Location3", "line_index": 347, "text": "Du kan stanna."}
{"category": "LocationDialogue Location3", "line_index": 348, "text": "Jag har inget emot det alls."}
{"category": "LocationDialogue Location3", "line_index": 349, "text": "Faktiskt, så är jag"}
{"category": "LocationDialogue Location3", "line_index": 350, "text": "ALLT FÖR DET!"}
{"category": "LocationDialogue Location3", "line_index": 351, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 352, "text": "// Quest 2"}
{"category": "LocationDialogue Location3", "line_index": 353, "text": "Vill du gå tillbaka?"}
{"category": "LocationDialogue Location3", "line_index": 354, "text": "Men varför vill du det?"}
{"category": "LocationDialogue Location3", "line_index": 355, "text": "Det är så varmt här..."}
{"category": "LocationDialogue Location3", "line_index": 356, "text": "Och mysigt också."}
{"category": "LocationDialogue Location3", "line_index": 357, "text": "Plus att jag är här."}
{"category": "LocationDialogue Location3", "line_index": 358, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 359, "text": "Nej, du missförstår."}
{"category": "LocationDialogue Location3", "line_index": 360, "text": "Jag skulle gärna stanna."}
{"category": "LocationDialogue Location3", "line_index": 361, "text": "Jag är bara... orolig."}
{"category": "LocationDialogue Location3", "line_index": 362, "text": "Orolig för att jag glömde något hemma..."}
{"category": "LocationDialogue Location3", "line_index": 363, "text": "Jag kom hit helt plötsligt"}
{"category": "LocationDialogue Location3", "line_index": 364, "text": "och hade inte tid"}
{"category": "LocationDialogue Location3", "line_index": 365, "text": "att förbereda mig."}
{"category": "LocationDialogue Location3", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 367, "text": "Åh... förlåt. Jag tänkte inte så mycket."}
{"category": "LocationDialogue Location3", "line_index": 368, "text": "// Quest 3"}
{"category": "LocationDialogue Location3", "line_index": 369, "text": "En dröm? Så du vill fly?"}
{"category": "LocationDialogue Location3", "line_index": 370, "text": "Och glömma att det här någonsin hänt?"}
{"category": "LocationDialogue Location3", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 372, "text": "Nej, så är det inte."}
{"category": "LocationDialogue Location3", "line_index": 373, "text": "Det här stället känns bara..."}
{"category": "LocationDialogue Location3", "line_index": 374, "text": "...konstig. Onaturlig."}
{"category": "LocationDialogue Location3", "line_index": 375, "text": "Men du..."}
{"category": "LocationDialogue Location3", "line_index": 376, "text": "...du verkar så verklig."}
{"category": "LocationDialogue Location3", "line_index": 377, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 378, "text": "Verkar jag verklig?"}
{"category": "LocationDialogue Location3", "line_index": 379, "text": "Jag är VÄLDIGT verklig,"}
{"category": "LocationDialogue Location3", "line_index": 380, "text": "din dumskalle!"}
{"category": "LocationDialogue Location3", "line_index": 381, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 382, "text": "// Quest 4"}
{"category": "LocationDialogue Location3", "line_index": 383, "text": "Det är bara så det är"}
{"category": "LocationDialogue Location3", "line_index": 384, "text": "i den här världen."}
{"category": "LocationDialogue Location3", "line_index": 385, "text": "Du kanske tycker att det är konstigt"}
{"category": "LocationDialogue Location3", "line_index": 386, "text": "att du inte kan se saker"}
{"category": "LocationDialogue Location3", "line_index": 387, "text": "på långt avstånd."}
{"category": "LocationDialogue Location3", "line_index": 388, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 389, "text": "Jag tyckte inte att det var så konstigt."}
{"category": "LocationDialogue Location3", "line_index": 390, "text": "Ärligt talat, det ser stiligt ut."}
{"category": "LocationDialogue Location3", "line_index": 391, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 392, "text": "Ja, det tycker jag också."}
{"category": "LocationDialogue Location3", "line_index": 393, "text": "Det är för att undvika lagg, du vet."}
{"category": "LocationDialogue Location3", "line_index": 394, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 395, "text": "Undvika lagg?"}
{"category": "LocationDialogue Location3", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 397, "text": "Japp! Det finns fortfarande några buggar som inte är åtgärdade."}
{"category": "LocationDialogue Location3", "line_index": 398, "text": "Låt oss bara hoppas att du inte träffar några."}
{"category": "LocationDialogue Location3", "line_index": 399, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 400, "text": "// Quest 5"}
{"category": "LocationDialogue Location3", "line_index": 401, "text": "Sax eller kniv, va?"}
{"category": "LocationDialogue Location3", "line_index": 402, "text": "Jag kunde ha använt en kniv för att skära upp såspaketet."}
{"category": "LocationDialogue Location3", "line_index": 403, "text": "Men jag ville att allt"}
{"category": "LocationDialogue Location3", "line_index": 404, "text": "skulle vara perfekt"}
{"category": "LocationDialogue Location3", "line_index": 405, "text": "när du kom tillbaka."}
{"category": "LocationDialogue Location3", "line_index": 406, "text": "Jag älskar att överraska dig."}
{"category": "LocationDialogue Location3", "line_index": 407, "text": "Och det tog inte ens så lång tid!"}
{"category": "LocationDialogue Location3", "line_index": 408, "text": "Tee-hee."}
{"category": "LocationDialogue Location3", "line_index": 409, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 410, "text": "// Glasögon"}
{"category": "LocationDialogue Location3", "line_index": 411, "text": "Har du glasögon?"}
{"category": "LocationDialogue Location3", "line_index": 412, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 413, "text": "Inte direkt."}
{"category": "LocationDialogue Location3", "line_index": 414, "text": "Men jag kan, om du vill."}
{"category": "LocationDialogue Location3", "line_index": 415, "text": "Ser de bra ut på mig?"}
{"category": "LocationDialogue Location3", "line_index": 416, "text": "// Ja"}
{"category": "LocationDialogue Location3", "line_index": 417, "text": "Så där ja!"}
{"category": "LocationDialogue Location3", "line_index": 418, "text": "Jag behåller dem på."}
{"category": "LocationDialogue Location3", "line_index": 419, "text": "// Nej"}
{"category": "LocationDialogue Location3", "line_index": 420, "text": "Jaha..."}
{"category": "LocationDialogue Location3", "line_index": 421, "text": "Vad som helst..."}
{"category": "LocationDialogue Location3", "line_index": 422, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 423, "text": "// Använd såsen"}
{"category": "LocationDialogue Location3", "line_index": 424, "text": "Okej..,"}
{"category": "LocationDialogue Location3", "line_index": 425, "text": "vad är det här för sås?"}
{"category": "LocationDialogue Location3", "line_index": 426, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 427, "text": "Det är kärlekssås!"}
{"category": "LocationDialogue Location3", "line_index": 428, "text": "Fullproppad med kärlek!"}
{"category": "LocationDialogue Location3", "line_index": 429, "text": "Och... en kontrasterande syn på världen."}
{"category": "LocationDialogue Location3", "line_index": 430, "text": "Ovanligt, tycker du inte det?"}
{"category": "LocationDialogue Location3", "line_index": 431, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 432, "text": "Verkligen..."}
{"category": "LocationDialogue Location3", "line_index": 433, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 434, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location3", "line_index": 435, "text": "Är det där din konsol?"}
{"category": "LocationDialogue Location3", "line_index": 436, "text": "Den ser så cool ut."}
