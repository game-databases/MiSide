{"category": "LocationDialogue Location15", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Där är du ju!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Varför lämnade du kärnan?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Jag sa åt dig att vänta på mig!"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Jag trodde att du skulle vara borta längre..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Nåväl, okej..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Jag tror att jag har hittat något..."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Jag tror det är ett index..."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Vi får se om det fungerar!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Nu sticker vi härifrån."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "Galna Mita..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Jag tror att hon är upptagen med en ny spelare."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Så förhoppningsvis är hon för upptagen för att bry sig om oss..."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Mita?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Vänta på mig."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Tappade du något?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Vänta, du träffade henne igen!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Mita..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Fånga!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Men hur..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "...vem är du?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Du är... du lever!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Minns du inte?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Känner jag igen dig?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Vad är det som händer..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Vad ska jag göra nu?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Jag kan inte ta mig ut..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "Vad menar du med ”komma ut”?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Vänta lite..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "Det där är ringen..."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "Och det där?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Inte en aning om vad det är."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "Det är ett index!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Du hittade det!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Jag vet inte vad jag ska säga."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Vi måste tillbaka till kärnan."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "Och du..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Du kanske borde följa med mig..."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Uhm, vad?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Visst..."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Vänta här."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Mm-hmm."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Jag sätter mig här."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Skit också..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "Det var nära ögat."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "Så... gjorde vi det?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Bra."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Jag är i rätt version."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Hejsan!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Du är en spelare, eller hur?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Vad heter du?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Jag vill lämna det här stället..."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Vill du åka så snart?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "Hur kom du hit från första början?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Nåväl..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Visst, du kan gå..."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Försök bara med dörren."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Lycka till med den!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "En vägg?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Hmm, det är helt fel."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Kanske..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "finns det något i källaren som kan hjälpa dig."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Jag upptäckte nyligen"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "en dörr i min garderob..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Det visade sig att den leder till en källare."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Men den är full av skräp,"}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "skräp och en massa fin utrustning."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Man måste slå in någon slags kod eller något."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Jag fattar inte riktigt."}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "Och jag bryr mig inte."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "Det är också lite obekvämt, jag menar, riktigt obekvämt."}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Vill du ta en titt?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Uhm, okej."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Spelaren tänker"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Jag tror inte"}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "att hon minns någonting..."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Gjorde vi det?"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "Startade vi om henne?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Då är allt jag behöver göra"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "ta mig ut ur det här jävla spelet..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Inte så snabbt."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Jag skulle vilja krama dig."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Va?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Kramar"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Det var kul att se dig."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Ahh..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "det är riktig synd"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "att du och jag"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "fick spendera så lite tid tillsammans."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Err..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "Vad är det du pratar om?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Jag menar,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "du kunde ha stannat med mig..."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "Allt är mitt fel..."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Den där garderoben och... ljuden."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Jag borde ha dödat henne tidigare!"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Vänta lite nu,"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "Gjorde du inte...?"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Hur kan du komma ihåg något av det?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "HA!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Trodde du verkligen att det skulle vara så lätt?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Du är bara en idiot..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Precis som alla andra spelare..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Vi har klarat oss bra, titta!"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "Den RIKTIGA"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "du"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "behövs inte längre."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Förlåt, tee-hee."}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Jag kan inte tro det..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Gjorde vi fel...?"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Nej... Jag startade om dig, jag är säker på det..."}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Du fattar fortfarande inte..."}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Ha-ha-ha!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Jag är så duktig skådespelare!"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Du skulle ha sett ditt ansikte, sötnos!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "Det här är så roligt!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Varför är du så här?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Vad är det för fel på dig?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Ja..."}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Vad är det för fel på mig?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Jag fattar inte..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Varför berättar du inte för mig varför jag är så här?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Varför jag aldrig kommer att bli en riktig Mita?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Min version, den har aldrig"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "existerat i första hand!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Jag skinnar bara de här naiva dårarna,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "gömmer mig under deras skinn..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Det finns inget sätt du kan"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "starta om mig!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Otroligt..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Du..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "De är inte problemet!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "Du är den som inte borde existera!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "Och nu du också..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Det gör ont att höra dig säga det."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "Och ändå!"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Det är dags för dig att gå!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Vi ses snart igen!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Alla är redo!"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "Det är"}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "dags att få ut dig ur konsolen!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "Vi ses senare!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Du kommer att bli min favoritkassett..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "En spelare med ett intressant namn."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// kärnkonsol - nope program"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Det är nog inte det."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Det är inte rätt heller."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Nope, fel."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Det är inte det."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Jag måste hitta alternativet för karaktärsåterställning."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "Det är fel version."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Oops, mitt misstag."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Det är inte den."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Jag behöver en annan."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// kärnkonsol - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Något är fel"}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "med indexet."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Jag måste ändra indexet,"}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "det passar inte."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Varför kök"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Är du hungrig?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Jag är bra på att hacka morötter. :)"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Varför badrum"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Ah, jag antar"}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "att du ville gå in ensam?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Varför sovrummet tillbaka"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Varför går vi bara i cirklar?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Varför återvända hit?"}
