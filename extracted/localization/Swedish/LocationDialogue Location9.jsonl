{"category": "LocationDialogue Location9", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Hej, du där!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Hej, du!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Vill du gå ut?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Hjälp mig då att hitta nyckeln!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Nyckelsökning"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Skit också! Nyckeln är borta!"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Ingenting här..."}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "noll, zip, nada!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Hittade den!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// Den vanliga konversationen"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Jag trodde att du skulle vara kortare!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "Du är lång..."}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "precis som min syster!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "Din syster? Vad är det med henne?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Ja, min syster."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Säg inte att du aldrig har träffat henne!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Eh... Jag har träffat henne... Tror jag?"}
{"category": "LocationDialogue Location9", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Är du en idiot?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "Erm..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "Det visar sig att du är det..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "Kom igen, hjälp mig bara att hitta nyckeln!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// Nästa arbete"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Kom igen nu."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Sätt järnet i röret!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Tack så mycket!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "Ge mig nu träet!"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Tack så mycket!"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Lite mer hjälp, tack!"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Allt är klart! Nu..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "Wow, det är vackert."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Tryck på den, kom igen!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Gör dig redo..."}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "Där, ta den!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "Nyckeln är din!"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// Quest 1 (Är du Mita?)"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Jag är ChibiMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Massor av linjer,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "enklaste modellerna, och-"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "bäst av allt - underbart hår!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// Quest 2 (Har vi sett varandra än?)"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Dumskalle!"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "Du är ganska söt, vet du,"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "ställer såna dumma frågor."}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Fast..,"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "det här är första gången jag träffar dig!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Men lyssna..."}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Om du snor min underbara look,"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "ska jag få dig att ångra det!"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// Quest 3 (Varför är du här?)"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Fattar du inte?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "Det här är en checkpoint-"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "ett test av ditt förstånd!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "Kom igen nu!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Jag är här för att vägleda de hopplöst vilsna!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// Quest 4 (Varför hjälper du mig?)"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "Vad är det som gör dig så speciell?"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "Varför inte hjälpa dig i alla fall?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "Va?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Så dumt..."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Du dök bara upp från ingenstans!"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Du borde inte vara här,"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "så jag hjälper dig!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Hej då, dumskalle!"}
