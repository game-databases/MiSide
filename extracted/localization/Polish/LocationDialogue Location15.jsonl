{"category": "LocationDialogue Location15", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Tutaj jesteś!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Dlaczego opuściłeś rdzeń?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Mówiłam ci, abyś zaczekał!"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Długo cię nie było, myślałem, że..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "No dobra..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Wydaje mi się, że coś znalazłam..."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "To chyba indeks..."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Musimy sprawdzić, czy zadziała!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Wynośmy się stąd."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "Szalona Mita..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Jest chyba zajęta nowym graczem."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Przy odrobinie szczęścia uda nam się."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Mita?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Zaczekaj na mnie."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Zgubiłeś coś?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Może poznacie się na nowo?!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Mita..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Łap!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Jak..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Kim jesteś?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Ty... Ty żyjesz!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Nie pamiętasz?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "My się znamy?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Co tu się dzieje..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Co ja teraz zrobię?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Nie dam rady uciec..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "Co masz na myśli?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Chwila..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "Pierścień..."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "A to?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Nie mam pojęcia, co to."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "To jej indeks!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Jednak ci się udało!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Nie wiem, co powiedzieć."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Musimy wracać do rdzenia."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "A ty..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Chyba powinnaś iść ze mną."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Emm, słucham?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "No dobra..."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Zaczekaj tu."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Okej."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Usiądę sobie tutaj."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Cholera..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "Było naprawdę blisko."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "A więc... Udało nam się?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Dobra."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Jestem w poprawnej wersji."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Cześć!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Jesteś graczem, prawda?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Jak masz na imię?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Chciałbym opuścić to miejsce..."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Chcesz już iść?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "Jak w ogóle się tu dostałeś?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Hmm..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Cóż, możesz iść.."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Spróbuj po prostu wyjść z domu!"}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Powodzonka!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Ściana?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Nie, to nie powinno tak być."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "A może..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "Pomoże ci to, co znajduje się w piwnicy..."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Niedawno odkryłam, całkiem przypadkowo"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "ukryte drzwi w mojej szafie..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Prowadzą do piwnicy."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Jest pełna gratów,"}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "i jeszcze jakiś dziwny sprzęt..."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Trzeba wprowadzić jakieś kody..."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Nie bardzo to rozumiem."}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "I szczerze? Mało mnie to interesuje."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "A poza tym, tam jest naprawdę nieprzytulnie!"}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Rzucisz okiem?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "No dobra."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Chyba zapomniała..."}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "Straciła pamięć..."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Udało nam się?"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "Zresetowaliśmy ją?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "W takim razie"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "muszę tylko uciec z tej pieprzonej gry..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Zaczekaj."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Chciałabym cię przytulić."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Co?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Miło było cię poznać..."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Ahh..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "Wielka szkoda..."}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "Że ty i ja,"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "spędziliśmy ze sobą tak mało czasu."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Nie rozumiem..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "O czym ty mówisz?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "No wiesz,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "mogłeś ze mną zostać..."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "To wszystko moja wina..."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Ta szafa i... stukanie."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Mogłam ją wcześniej ZABIĆ!"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Czekaj,"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "czy ty...?"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Jakim cudem wszystko pamiętasz?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "HA!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Naprawdę myślałeś, że to takie proste?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Jesteś głupcem..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Jak wszyscy inni..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "A zdążyliśmy idealnie, patrz!"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "Już"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "nie potrzebuję"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "cię żywego."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Sorka."}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Nie wierze..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Co poszło nie tak...?"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Daję sobie uciąć głowę, że cię zresetowałem..."}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Wciąż nie rozumiesz...?"}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Ha-ha-ha!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Cudowna ze mnie aktorka!"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Powinieneś był zobaczyć się w lustrze!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "To takie zabawne!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Dlaczego taka jesteś?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Co jest z tobą nie tak?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Nie tak...?"}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Co jest ZE MNĄ nie tak?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "A może ty mi powiesz..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Co jest ze mną nie tak?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Dlaczego nigdy nie będę prawdziwą Mitą?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Może dlatego, że moja wersja domu..."}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "Nigdy nie istniała?"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Zdzieram skórę z tych naiwnych laleczek,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "ukrywam się pod ich maskami,"}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "mnie nie da się"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "zresetować!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Nie mogę w to uwierzyć."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Ty..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "To nie w innych tkwi problem!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "To ty nie powinnaś istnieć!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "I ty też przeciwko mnie?..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "To boli, wiesz?"}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "Mimo wszystko."}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Czas na ciebie!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Widzimy się niedługo!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Wszystko gotowe."}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "Myślę,"}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "że już czas wyciągnąć cię z konsoli!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "Do zobaczenia!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Będziesz moją ulubioną kasetą..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Graczu o ciekawym imieniu!"}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "To chyba nie to."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Ani to."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Pudło."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Nie, to nie to."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Muszę znaleźć okienko resetu postaci..."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "To błędna wersja."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Oj, mój błąd."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "To nie to."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Trzeba poprawić."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Coś jest nie tak."}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "Indeks jest nieprawidłowy."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Muszę poprawić indeks."}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "Nie pasuje."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Burczy ci w brzuszku?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Umiem świetnie kroić marcheweczki!"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "O, chyba..."}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "Chyba wolisz być sam..."}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Czemu się tak kręcisz po mieszkaniu?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Jaki w tym sens?"}
