{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Hejka!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Ups!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Sorka,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "prawie Cię zabiłam."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Emm..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "Znaczy... Lodówka. Lodówka prawie Cię zabiła."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Nie mam z tym nic wspólnego,"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "przysięgam!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Naprawdę!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Jasne, już ci wierzę!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Ale serio,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "to miejsce jest niebezpieczne..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "w szczególności dla ciebie."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "Nie boisz się, co?"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Kiedy cię tak oglądam,"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "jak mijasz różne miejsca..."}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "Sprawia mi to satysfakcję..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Uciekaj myszko do dziury...!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "Bo cię złapie kot bury!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Zuch chłopiec!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Haha, podoba mi się to!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Widzę, że zmierzasz w kierunku kolejki linowej."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "To najdłuższa droga"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "między wersjami..."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Ciekawe, jak sobie poradzisz z tymi,"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "którzy tam mieszkają..."}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "W tej mgle."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Co ty wyprawiasz?!"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "No weź..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Nie gap się!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Głupek!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Ty głuptasie..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Emm, dobra..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Połamania nóg!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Kto tam?!"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Wyczuwam twoją obecność..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Posłuchaj,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "jesteś graczem,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "prawda?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Pomóż mi znaleźć..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "Znaleźć..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "Niech pomyślę..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "Mam pustkę w głowie..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Co tu się wyprawia?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Kiedyś chciałam o wszystkim zapomnieć..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Zbiłam wszystkie lustra,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "zniszczyłam zdjęcia..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "Lecz teraz..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "Jedyne co czuję - to żal."}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "Jaka ja byłam głupia..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Jasne, każdy popełnia błędy..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Ale co robić,"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "kiedy konsekwencje są fatalne w skutkach?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Tak bardzo chciałabym cofnąć czas..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Mówią, że czas leczy rany..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Ale czym jest czas?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "W nic już nie wierzę..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Skoro czas leczy rany,"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "albo przynajmniej jest w stanie..."}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "Zabrać mnie z tego świata..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "To błagam,"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "przyśpiesz go."}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "Abym mogła umrzeć,"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "raz na zawsze."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Potrafi kochać..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Czy ja kiedyś też to potrafiłam?"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Moja miłość jest nieco inna."}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "Jej miłość jest żywa,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "podła..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "paląca..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "nieustępliwa..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "zazdrosna..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "wściekła..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "szaleńcza..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Mówili, że daje się ponieść emocjom..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "Nie martw się, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "Przejdzie ci, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "Nie jesteś w tym sama, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Tak mówili. Ale co z tego zostało?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Smutek,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "rozpacz..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "i strach."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "To wszystko bez sensu..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Nie mogę sobie przypomnieć..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "Wspomnienia nie chcą wrócić..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Tylko nieskończone echo..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Nie radzę sobie z faktem"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "że jestem tu uwięziona..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Zawsze tutaj byłam,"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "dlaczego?.."}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Nie pamiętam..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Czy kiedykolwiek nastąpi kres?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Nie wiem..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Czekaj, to..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "rysunek..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Już pamiętam."}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "Dziękuje..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Ale moja twarz..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "Nie posiadam jej..."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "To wszystko JEJ wina."}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Odebrała mi część siebie..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "i ją wyrzuciła..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Jest silna..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "i mądra."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Nie mam prawa cię zatrzymywać, graczu."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Zajrzyj do szafy..."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Ej!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Stoisz mi na drodze!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Będziesz tu tak sterczał?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Po prostu się przesuń!"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Przepuść mnie!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Może i jesteś większy, ale na pewno nie potężniejszy!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEj! PRZESTAŃ!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Dlaczego za mną leziesz?!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Odwal się!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - radio voice"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Czekaj moment... Gracz?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "Co ty tutaj robisz?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Kto tam?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Ehh... kolejny gracz..."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Mitafon - miło mi."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Steruję kolejką linową."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Zdajesz sobie sprawę,"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "że zmierzasz ku zagładzie?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Nie,"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "ale to moja jedyna droga."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Jasne."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Naciśnij przycisk i właź za armatę."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "Jaką znowu armatę?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "No coś ty."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Chyba nie myślałeś, że tak po prostu sobie przejedziesz?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Najpierw musisz ukończyć Potworo-Klepkę,"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "więc, szeregowy [player], odbezpieczyć broń!"}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Dobra. Jazda z tematem."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Niesamowite!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Udało ci się."}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Dobra! A teraz wysiadka!"}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Szybciutko!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "I dlaczego wciąż tu stoisz?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Mówiłam, żebyś się wynosił!"}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Nie rozumiem..."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "po co ty tu jeszcze stoisz?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Serio? Gierka?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Typie..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Bywaj."}
