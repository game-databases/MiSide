{"category": "LocationDialogue Location9", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Hej, ty!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Cześć!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Chcesz się stąd wydostać?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "To nie stój tak i pomóż mi znaleźć klucz!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Cholera! Nie ma go!"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Nic tu nie ma—"}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "Nic a nic!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Mam cię!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// The usual conversation"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Huh, myślałam, że będziesz niższy!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "A jesteś ogromniasty!"}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "Tak jak moja siostrzyczka!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "Twoja... siostrzyczka?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Tak, moja siostrzyczka."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Nie gadaj, że jej nie spotkałeś!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Em... Spotkałem... Chyba..."}
{"category": "LocationDialogue Location9", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Nie rób z siebie idioty!"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "Emm..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "Eh, chyba już na to za późno..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "No dalej, po prostu pomóż mi znaleźć ten klucz!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// Next work"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Chodź."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Włóż to żelastwo do rury!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Dzięki, kochanieńki!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "Teraz drewno..."}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Dziękuję!"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Pomożesz, proszę?"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Gotowe. I teraz..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "Whoa... Ale śliczne."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "No dawaj! Wciskaj!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Teraz uważaj..."}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "proszę, weź go!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "Klucz jest twój."}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// Quest 1 (Jesteś Mita?)"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Jestem MiniMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Masa linii,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "najprostszy model, i—"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "co najważniejsze - piękne włoski!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// Quest 2 (Czy myśmy się gdzieś nie widzieli?)"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Głuptas!"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "To trochę urocze, wiesz?"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "Pytasz o takie bzdury..."}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Ale nie,"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "to nasze pierwsze spotkanie!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Ale poczekaj..."}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Ostrzegam, jeśli ktoś skradł moją stylówę,"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "to nawet Szalona Mita mnie nie powstrzyma!"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// Quest 3 (Dlaczego tu jesteś?)"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Nie rozumiesz?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "To punkt kontrolny—"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "test bystrości!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "No dawaj!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Jestem tu po to, żeby wskazać drogę zaginionym duszyczkom!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// Quest 4 (Dlaczego mi pomagasz?)"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "A kim ty jesteś?"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "Żeby ci NIE pomagać?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "Co?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Taki niemądry..."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Pojawiłeś się znikąd."}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Nie powinno cię tu być,"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "więc ci pomagam!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Pa-Pa, głuptasku!"}
