{"category": "LocationDialogue Location6", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "Mita?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "Skąd się tu wziąłeś?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Jesteś... Mita?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Ale jakaś... inna..."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "Cóż za spostrzegawczość."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "Jednak masz rację, jestem Mita."}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "Ale nie ta, którą poznałeś wcześniej."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Uważaj, ona knuje coś..."}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "Złowieszczego."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "Co? Złowieszczego?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "Cholera!"}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "Jeśli nam się uda, wszystko ci wyjaśnię."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Obok sofy jest klucz, przynieś mi go."}
{"category": "LocationDialogue Location6", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Ale..."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "Nie mamy na to czasu!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Daj mi klucz."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Weź ten pierścień."}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "Co?"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Chcesz się stąd wydostać?"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "Umm, no tak..."}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Więc go zakładaj."}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "To rzadki artefakt,"}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "i bardzo możliwe, że niedługo ci się przyda."}
{"category": "LocationDialogue Location6", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Okej..."}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "Tak przy okazji, jestem"}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Mmm,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "Jestem... Mita."}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// MitaKind quest 1"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "Widzisz tę konsolę?"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "Podnieś ją."}
{"category": "LocationDialogue Location6", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "To nagranie?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "Kto tam z nią jest?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "Nie, to dzieje się na żywo."}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "To inny gracz."}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Wykorzystuje go."}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Uważaj, bo ty też..."}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "Możesz stać się kasetą..."}
{"category": "LocationDialogue Location6", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "Muszę się stąd wydostać."}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "Ty także."}
{"category": "LocationDialogue Location6", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "To prawda."}
{"category": "LocationDialogue Location6", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "Czyli ona nas wykorzystuje?"}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "Tylko po co?"}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "Co się stanie, jak wyjmę tę kasetę?"}
{"category": "LocationDialogue Location6", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "Prawdopodobnie"}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "nieodwracalnie ją uszkodzisz."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "A co za tym idzie..."}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "Gracz umrze."}
{"category": "LocationDialogue Location6", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "..."}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "A jeśli po prostu wyłączę konsolę?"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "Możliwe, że to zadziała..."}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Warto spróbować. Powinien gdzieś być czerwony przycisk."}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Widzisz go?"}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "Jest."}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "Wciśnij."}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// MitaKind quest 2"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Muszę tu zostać."}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "Jest parę pytań, które muszę jej zadać."}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "Chcę się o niej czegoś dowiedzieć."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "Choć pewnie nie będzie zbyt chętna do rozmowy..."}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// MitaKind quest 3"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "Jesteśmy w mojej wersji gry."}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "Dotrzymywałam towarzystwa innemu graczowi."}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "Ale nagle coś się zmieniło."}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "Pojawiła się ona..."}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "Zmieniła gracza w kasetę."}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "A mnie zamknęła tutaj."}
{"category": "LocationDialogue Location6", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Czekaj, co?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "Jak to zmieniła w kasetę?"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "Ale dlaczego?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "Po co jej gracze?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "Ona jest szalona..."}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Bawi się nimi, wykorzystuje ich do spełnienia chorych fantazji!"}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "A później zamienia wszystkich w kasety..."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Niektórzy nie wiedzieli, co się dzieje..."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "A inni... nie stawiali nawet oporu..."}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "To straszne..."}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "Musisz nam pomóc!"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "Ja? Ale jak?"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "Potrzebujemy się nawzajem!"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "Jeśli mi pomożesz, ja pomogę tobie!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "To może być nasza jedyna szansa."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "Pierścień zaprowadzi cię do prawidłowej wersji."}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "Tam się spotkamy."}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// MitaKind quest 4"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "Dalej nie rozumiem,"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "co tu się odwaliło?.."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Tamta Mita..."}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "Czy ona chciała mnie zabić?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "Zabić?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Czeka cię znacznie gorszy los..."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "Musisz się pośpieszyć."}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Hide!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "Cholera, kryj się!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Co? Czemu?"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Szybko, zaraz tu będzie!"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "Pierścień zaprowadzi cię w bezpieczne miejsce!"}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "Proszę, proszę, powiesz mi, gdzie on jest?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "Czemu miałabym?"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "Przecież nie zamierzasz go zabić, prawda?"}
{"category": "LocationDialogue Location6", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Hah, czyli nie chcesz po dobroci."}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Niech ci będzie, lubię wyzwania."}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "Wiem, że gdzieś tu jest."}
{"category": "LocationDialogue Location6", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "Czemu jesteś dla nas taka złośliwa?"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "Nawet nie możesz nam tego wyjaśnić!"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "Poza tym..."}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "Po co ci gracze?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "To nie zabawki!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "Co w ciebie wstąpiło?!"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "Hah, morda w kubeł, podróbko!"}
