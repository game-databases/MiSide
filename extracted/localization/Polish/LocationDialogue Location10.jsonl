{"category": "LocationDialogue Location10", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "Czekaj! Czekaj!"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "Nie tak głośno..."}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "Droga przed nami jest niebezpieczna."}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "Tak właściwie..."}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "jak się tu dostałeś?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "Emm..."}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "Pierścień otwiera właściwe drzwi."}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "Szczerze mówiąc, nie wiem, jak to działa."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "Pierścień?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "Co jest nie tak z tym miejscem?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "Jest tu okropnie ciemno."}
{"category": "LocationDialogue Location10", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "Później ci powiem."}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "Na razie zmierzaj ku wyjściu."}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "Spotkajmy się przy maszynie do gier."}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Pośpiesz się!"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// After mini-gamę"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "I jak, już rozumiesz sens gry?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "Że pod moją skórą są kości, a pod waszą - model szkieletu?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "Whoa!"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "To dość niepokojące, kiedy przedstawiasz to w ten sposób."}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "Ale mniej więcej tak to wygląda."}
{"category": "LocationDialogue Location10", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "Dobra, ale po co mi ta wiedza?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "Myślisz, że robiłam sobie jaja, kiedy mówiłam,"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "że droga przed nami jest niebezpieczna?"}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "Natkniesz się na zapomniane modele..."}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "Te, których się pozbyto, te agresywne i \"zepsute\"."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "Po co robić sobie \"pod górkę\"?"}
{"category": "LocationDialogue Location10", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "Nie mam wyboru..."}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Po prostu pójdę"}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "gdziekolwiek poprowadzą mnie drzwi."}
{"category": "LocationDialogue Location10", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "Wow!"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "W takim razie nie odwracaj się do nich plecami."}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "I pamiętaj - nie trać ich z zasięgu wzroku!"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "Są nieśmiałe, kiedy na nie patrzysz,"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "na tyle, że przestają się ruszać."}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "Nie zapominaj!"}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// Quest 1 (Dlaczego są tu inne Mity?)"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "Są nowe. Prosto z fabryki."}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "Potrzebują trochę czasu,"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "wiesz, by zyskały \"świadomość\"."}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "A potem je odprowadzam,"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "prościutko do ich domów."}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// Quest 2 (Dlaczego na dole jest tak ciemno?)"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "My, Mity, jesteśmy tworzone w ciemności,"}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "więc musimy w niej przez jakiś czas zostać."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Wyobraź sobie ból,"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "kiedy z mroku zostałybyśmy wrzucone wprost do światła..."}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// Quest 3 (A co TY tu robisz?)"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "Nadal nie ogarniasz?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "Pomagam nowym Mitom się zadomowić!"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "W końcu kto im pomoże, jak nie ja?"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "No chyba nie ty?"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// Quest 4 (Po co to wszystko na taką skalę?)"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "Po co to wszystko na taką skalę?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "Czy wystarczy miejsca dla wszystkich?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Czekaj, nie gadaj, że nie rozumiesz,"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "jak działa ten świat..."}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "Nie wiesz, że jest nieskończony?"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "Nieskończony?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "Uhm..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "Co masz na myśli?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "Skoro 1.9 jest najnowszą wersją,"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "to musi być tylko 19 światów."}
{"category": "LocationDialogue Location10", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "Boziu... Ty naprawdę nie ogarniasz,"}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "jak działa ten świat."}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Podejdźmy do tablicy."}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "Spróbuję ci to wyjaśnić."}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "Co ty na to?"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// Quest 5 (Jaką jest twoja wersja?)"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Czekaj,"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "nie widzieliśmy się czasem w ostatniej wersji gry?"}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "A może mi się tylko wydaje?"}
{"category": "LocationDialogue Location10", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "Tak... to możliwe."}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Jestem z wersji 1.5."}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "Byłeś tam?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Tak! "}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "To właśnie tam się pojawiłem,"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "kiedy wrzucono mnie do tego świata!"}
{"category": "LocationDialogue Location10", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "Wow!"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "Ale jak...?"}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "Czekaj, w której wersji domu byłeś?"}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "Jest wersja, w której \"ja\" nie potrafi przestać się mazać,"}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "wersja, w której \"ja\" lubi się bawić,"}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "wersja, w której \"ja\" ma słabą pamięć i lubi zastraszać innych..."}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "Długo by wymieniać..."}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Powiedz mi, co pamiętasz?"}
{"category": "LocationDialogue Location10", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Było mrocznie."}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "Na ścianach były napisy,"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "na przykład..."}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "\"Pobawimy się?\""}
{"category": "LocationDialogue Location10", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "Ah,"}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "szkoda..."}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "To \"ja\","}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "która zastrasza innych i ma sklerozę."}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// Mita wants to tell you [No]"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Dzięki, ale wolę nie wiedzieć."}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Dam sobie radę bez tego."}
{"category": "LocationDialogue Location10", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "W porządku, twój wybór."}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// Mita wants to tell you [Yes]."}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "Jasne, dawaj."}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "Mam tylko nadzieję, że nie będzie, jak na lekcjach"}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "i nie zasnę z nudów."}
{"category": "LocationDialogue Location10", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "Wiesz, zawsze możesz wyjść,"}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "albo zostać i posłuchać,"}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "jeśli cię to ciekawi."}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "Gracz pobiera MiSide."}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "Siedzi zadowolony i gra."}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "W ten sposób stworzył nowy dom"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "i nową Mite."}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "To dwuwymiarowa reprezentacja."}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "To, są wersje gry,"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "pokazane jako linie."}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "Domy ustawione są na liniach."}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "Powiedzmy, że pobierasz wersję 1.14,"}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "więc w tej wersji rodzi się:"}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "nowe życie, Mita i jej dom."}
{"category": "LocationDialogue Location10", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "Niebiosa..."}
{"category": "LocationDialogue Location10", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Jeśli czegoś nie rozumiesz,"}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "pytaj śmiało,"}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "a postaram się wytłumaczyć."}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// He asks about the only circle"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "Czemu tu jest pojedyncze kółko?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "Ta wersja została wydana tylko raz,"}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "nigdy jej nie powtórzono."}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "To jedyna unikalna wersja gry."}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "Tego typu wersje są specjalne"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "i nie da się ich pominąć."}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "Śpiąca Mita przesiaduje właśnie w niej."}
{"category": "LocationDialogue Location10", "line_index": 171, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "Śpiąca Mita?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "Bo inni przechodzą przez jej wersje"}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "i nie dają jej się wyspać?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "Nie, to nie tak."}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "Możesz przejść tuż obok niej,"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "a ona nawet się nie zorientuje."}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// He asks about the shaded circle"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "Dlaczego to kółko jest zamalowane?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "Umm, to tutaj?"}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "To dzieło Ślicznej Mity."}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "Ona to narysowała."}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "Kłóciłyśmy się,"}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "jak najszybciej dostać się do wersji 1.11."}
{"category": "LocationDialogue Location10", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "A więc? Kto wygrał?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "Oczywiście, że JA!"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "Spójrz, jesteśmy tu"}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "w wersji 1.15,"}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "indeks domu 809."}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "Musimy dotrzeć do wersji 1.11,"}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "indeks domu 805."}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Więc, jej droga prowadziła tak."}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "Ale próbowałyśmy ją skrócić,"}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "i śliczna Mita zasugerowała nową ścieżkę."}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "Ale ja narysowałam najprostszą drogę."}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "To przecież oczywiste!"}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Patrz."}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "Stąd możesz przejść prosto do wybranej wersji."}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Nawet jeśli wydaje nam się, że dom stoi nam na drodze,"}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "to tak nie jest!"}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "Wracając, twój pierścień działa w ten sam sposób."}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "Dokąd zmierzasz?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "Do Rdzenia."}
{"category": "LocationDialogue Location10", "line_index": 210, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "Rdzenia?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "Hmm... Pomyślmy..."}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Jeśli chcesz najkrótszą drogę,"}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "będziesz musiał przejść przez wersję 1.11."}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "A dalej na pewno spotkasz naszą śpiącą królewnę."}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Wydaje mi się, że Mita, która cię tam wysłała,"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "kroczyła tą samą ścieżką."}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "A może po prostu nie ogarnęła, że zmierzasz inną trasą."}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "A może po prostu jest genialna"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "I znalazła jeszcze krótszą drogę!"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Chyba rozumiem."}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// He asks about the inscription"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "A to?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "Aa.. To jest dla fajnej Mity."}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "Dotrze tu za kilka godzin."}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "Niech przestawi te pudła"}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "i ustawi kanapę."}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "Bo mnie już tyłek boli!"}
{"category": "LocationDialogue Location10", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Emm..."}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "Może pomóc?"}
{"category": "LocationDialogue Location10", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "Nie. To zadanie fajnej Mity."}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Jest twarda."}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// He asks about the drawings"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "To tylko rysunek,"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "czy może"}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "ma to głębsze znaczenie?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 244, "text": "Coś ty,"}
{"category": "LocationDialogue Location10", "line_index": 245, "text": "to tylko bazgroły."}
