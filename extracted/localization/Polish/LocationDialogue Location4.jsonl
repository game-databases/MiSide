{"category": "LocationDialogue Location4", "line_index": 0, "text": "Mita?"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "Ooo, już ci lepiej?"}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "Skąd się tu wzięłaś?"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": "Przecież przed chwilą byłaś obok mnie."}
{"category": "LocationDialogue Location4", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 5, "text": "Nie, wydawało ci się."}
{"category": "LocationDialogue Location4", "line_index": 6, "text": "Zamarłeś przed lustrem."}
{"category": "LocationDialogue Location4", "line_index": 7, "text": "Więc zostawiłam cię w spokoju."}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "Czemu rozmieszczenie pokoi się zmieniło?"}
{"category": "LocationDialogue Location4", "line_index": 9, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "Przestawiłam je,"}
{"category": "LocationDialogue Location4", "line_index": 11, "text": "żebyś mógł się poczuć bardziej jak w domu."}
{"category": "LocationDialogue Location4", "line_index": 12, "text": "Na szczęście,"}
{"category": "LocationDialogue Location4", "line_index": 13, "text": "tutaj możemy aranżować pokoje,"}
{"category": "LocationDialogue Location4", "line_index": 14, "text": "jak tylko chcemy."}
{"category": "LocationDialogue Location4", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 16, "text": "Nie musiałaś."}
{"category": "LocationDialogue Location4", "line_index": 17, "text": "Prawie się już przyzwyczaiłem."}
{"category": "LocationDialogue Location4", "line_index": 18, "text": "W każdym razie uważam, że w ten sposób będzie nam tu lepiej."}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Mita card game"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "Dobrze."}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "Zagramy?"}
{"category": "LocationDialogue Location4", "line_index": 22, "text": "Zasady gry są proste:"}
{"category": "LocationDialogue Location4", "line_index": 23, "text": "Moneta dyktuje, na które statystyki gramy."}
{"category": "LocationDialogue Location4", "line_index": 24, "text": "Na przykład zdrowie."}
{"category": "LocationDialogue Location4", "line_index": 25, "text": "Każdy z nas wystawia kartę,"}
{"category": "LocationDialogue Location4", "line_index": 26, "text": "i jeśli na twojej karcie"}
{"category": "LocationDialogue Location4", "line_index": 27, "text": "symbol zdrowia ma większą wartość"}
{"category": "LocationDialogue Location4", "line_index": 28, "text": "niż u mnie,"}
{"category": "LocationDialogue Location4", "line_index": 29, "text": "to wygrywasz."}
{"category": "LocationDialogue Location4", "line_index": 30, "text": "Weź swoje karty."}
{"category": "LocationDialogue Location4", "line_index": 31, "text": "Zobaczmy..."}
{"category": "LocationDialogue Location4", "line_index": 32, "text": "Wow!"}
{"category": "LocationDialogue Location4", "line_index": 33, "text": "Trafiły się niezłe karty!"}
{"category": "LocationDialogue Location4", "line_index": 34, "text": "Ja pierwsza!"}
{"category": "LocationDialogue Location4", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 44, "text": "Dajesz!"}
{"category": "LocationDialogue Location4", "line_index": 45, "text": "Twoja kolej!"}
{"category": "LocationDialogue Location4", "line_index": 46, "text": "No."}
{"category": "LocationDialogue Location4", "line_index": 47, "text": "Twoja kolej!"}
{"category": "LocationDialogue Location4", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 49, "text": "Gramy na zdrowie!"}
{"category": "LocationDialogue Location4", "line_index": 50, "text": "Teraz tylko atak!"}
{"category": "LocationDialogue Location4", "line_index": 51, "text": "Skup się na obronie!"}
{"category": "LocationDialogue Location4", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 54, "text": "Zwyciężasz!"}
{"category": "LocationDialogue Location4", "line_index": 55, "text": "Wygrałeś!"}
{"category": "LocationDialogue Location4", "line_index": 56, "text": "Tym razem ci się udało."}
{"category": "LocationDialogue Location4", "line_index": 57, "text": "Ożeż ty..."}
{"category": "LocationDialogue Location4", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 59, "text": "Wygrałam!"}
{"category": "LocationDialogue Location4", "line_index": 60, "text": "Tym razem to ja wygrałam!"}
{"category": "LocationDialogue Location4", "line_index": 61, "text": "Udało mi się!"}
{"category": "LocationDialogue Location4", "line_index": 62, "text": "Ha, mam cię!"}
{"category": "LocationDialogue Location4", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 64, "text": "Remis."}
{"category": "LocationDialogue Location4", "line_index": 65, "text": "Wow, remis!"}
{"category": "LocationDialogue Location4", "line_index": 66, "text": "Tym razem to remis!"}
{"category": "LocationDialogue Location4", "line_index": 67, "text": "Ehh, ta sama liczba..."}
{"category": "LocationDialogue Location4", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 79, "text": "// The card gamę is interrupted"}
{"category": "LocationDialogue Location4", "line_index": 80, "text": "Co to za dźwięk?"}
{"category": "LocationDialogue Location4", "line_index": 81, "text": "Ten z szafy."}
{"category": "LocationDialogue Location4", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 83, "text": "Dźwięk?"}
{"category": "LocationDialogue Location4", "line_index": 84, "text": "Jaki dźwięk?"}
{"category": "LocationDialogue Location4", "line_index": 85, "text": "Ja nic nie słyszałam."}
{"category": "LocationDialogue Location4", "line_index": 86, "text": "A ty coś słyszałeś?"}
{"category": "LocationDialogue Location4", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 88, "text": "Jakieś pukanie, jakby ktoś tam był."}
{"category": "LocationDialogue Location4", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 90, "text": "Ale..."}
{"category": "LocationDialogue Location4", "line_index": 91, "text": "Tam nikogo nie ma..."}
{"category": "LocationDialogue Location4", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 93, "text": "Chciałbym to sprawdzić."}
{"category": "LocationDialogue Location4", "line_index": 94, "text": "Trochę mnie to przeraża."}
{"category": "LocationDialogue Location4", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 96, "text": "Ale czemu...?"}
{"category": "LocationDialogue Location4", "line_index": 97, "text": "Znowu to samo..."}
{"category": "LocationDialogue Location4", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 105, "text": "Co jest z tobą nie tak!?"}
{"category": "LocationDialogue Location4", "line_index": 106, "text": "To zwykła szafa..."}
{"category": "LocationDialogue Location4", "line_index": 107, "text": "Trzymam tam swoją bieliznę...!"}
{"category": "LocationDialogue Location4", "line_index": 108, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 109, "text": "Coś przede mną ukrywasz?"}
{"category": "LocationDialogue Location4", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 111, "text": "Czemu mi nie wierzysz?"}
{"category": "LocationDialogue Location4", "line_index": 112, "text": "Co znów robię źle?"}
{"category": "LocationDialogue Location4", "line_index": 113, "text": "Ja chcę tylko..."}
{"category": "LocationDialogue Location4", "line_index": 114, "text": "chcę żebyś ze mną został..."}
{"category": "LocationDialogue Location4", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 116, "text": "Chciałbym, ale...?"}
{"category": "LocationDialogue Location4", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 118, "text": "Dlaczego tak się uparłeś na tę szafę?!"}
{"category": "LocationDialogue Location4", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 120, "text": "Chcę tylko wiedzieć, co to za odgłos!"}
{"category": "LocationDialogue Location4", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 122, "text": "Czy to dlatego,"}
{"category": "LocationDialogue Location4", "line_index": 123, "text": "że ten świat"}
{"category": "LocationDialogue Location4", "line_index": 124, "text": "To tylko cztery pokoje?"}
{"category": "LocationDialogue Location4", "line_index": 125, "text": "To dla ciebie za mało?"}
{"category": "LocationDialogue Location4", "line_index": 126, "text": "Czemu po prostu nie możesz ze mną zostać?"}
{"category": "LocationDialogue Location4", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 129, "text": "// Don't stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 130, "text": "Rozumiem."}
{"category": "LocationDialogue Location4", "line_index": 131, "text": "Znowu to samo..."}
{"category": "LocationDialogue Location4", "line_index": 132, "text": "Skoro tak chcesz wiedzieć, co tam jest,"}
{"category": "LocationDialogue Location4", "line_index": 133, "text": "to za chwilę..."}
{"category": "LocationDialogue Location4", "line_index": 134, "text": "Się dowiesz!"}
{"category": "LocationDialogue Location4", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 139, "text": "Co do..."}
{"category": "LocationDialogue Location4", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 141, "text": "Czasami się to zdarza."}
{"category": "LocationDialogue Location4", "line_index": 142, "text": "Pokój nie zdążył się załadować."}
{"category": "LocationDialogue Location4", "line_index": 143, "text": "Poczekaj chwilkę."}
{"category": "LocationDialogue Location4", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 145, "text": "Dziwne."}
{"category": "LocationDialogue Location4", "line_index": 146, "text": "Jesteśmy w czyimś telefonie? "}
{"category": "LocationDialogue Location4", "line_index": 147, "text": "Może w jakimś przestarzałym, ze starym procesorem?"}
{"category": "LocationDialogue Location4", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 149, "text": "Nie o to chodzi."}
{"category": "LocationDialogue Location4", "line_index": 150, "text": "Niestety, nie wszystko jest tutaj"}
{"category": "LocationDialogue Location4", "line_index": 151, "text": "idealne..."}
{"category": "LocationDialogue Location4", "line_index": 152, "text": "Jesteśmy ładowani"}
{"category": "LocationDialogue Location4", "line_index": 153, "text": "Przez rdzeń świata."}
{"category": "LocationDialogue Location4", "line_index": 154, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 155, "text": "Rdzeń świata?"}
{"category": "LocationDialogue Location4", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 157, "text": "Typowe, co nie?"}
{"category": "LocationDialogue Location4", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 159, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 161, "text": "Możemy "}
{"category": "LocationDialogue Location4", "line_index": 162, "text": "pograć na konsoli,"}
{"category": "LocationDialogue Location4", "line_index": 163, "text": "albo w karty."}
{"category": "LocationDialogue Location4", "line_index": 164, "text": "Wybieraj."}
{"category": "LocationDialogue Location4", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 167, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 168, "text": "// Mita play fight"}
{"category": "LocationDialogue Location4", "line_index": 169, "text": "Chcesz zawalczyć?"}
{"category": "LocationDialogue Location4", "line_index": 170, "text": "Musisz wygrać"}
{"category": "LocationDialogue Location4", "line_index": 171, "text": "cztery razy."}
{"category": "LocationDialogue Location4", "line_index": 172, "text": "No dawaj."}
{"category": "LocationDialogue Location4", "line_index": 173, "text": "Nie martw się,"}
{"category": "LocationDialogue Location4", "line_index": 174, "text": "na początku dam ci fory."}
{"category": "LocationDialogue Location4", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 176, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 177, "text": "Dobrze ci idzie."}
{"category": "LocationDialogue Location4", "line_index": 178, "text": "Ale teraz się przygotuj!"}
{"category": "LocationDialogue Location4", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 180, "text": "Wow!"}
{"category": "LocationDialogue Location4", "line_index": 181, "text": "No dobra."}
{"category": "LocationDialogue Location4", "line_index": 182, "text": "Teraz gram na serio."}
{"category": "LocationDialogue Location4", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 184, "text": "Nieźle!"}
{"category": "LocationDialogue Location4", "line_index": 185, "text": "Zobaczymy, czy uda ci się"}
{"category": "LocationDialogue Location4", "line_index": 186, "text": "Pokonać mnie teraz!"}
{"category": "LocationDialogue Location4", "line_index": 187, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 188, "text": "Jesteś"}
{"category": "LocationDialogue Location4", "line_index": 189, "text": "Normalnie"}
{"category": "LocationDialogue Location4", "line_index": 190, "text": "Niesamowity! Masz zwinne palce!"}
{"category": "LocationDialogue Location4", "line_index": 191, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 193, "text": "Co się dzieje?"}
{"category": "LocationDialogue Location4", "line_index": 194, "text": "Nudzi cię to?"}
{"category": "LocationDialogue Location4", "line_index": 195, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 196, "text": "Zrobiłam to!"}
{"category": "LocationDialogue Location4", "line_index": 197, "text": "Fatality!"}
{"category": "LocationDialogue Location4", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 199, "text": "Ehh,"}
{"category": "LocationDialogue Location4", "line_index": 200, "text": "weź się w garść, albo będę cię nazywać przegrywem!"}
{"category": "LocationDialogue Location4", "line_index": 201, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 202, "text": "Co z tobą?"}
{"category": "LocationDialogue Location4", "line_index": 203, "text": "Wycisnęłam z ciebie całe mleczko!"}
{"category": "LocationDialogue Location4", "line_index": 204, "text": "Nie dałeś z siebie wszystkiego -"}
{"category": "LocationDialogue Location4", "line_index": 205, "text": "dlatego wygrałam!"}
{"category": "LocationDialogue Location4", "line_index": 206, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 208, "text": "A więc."}
{"category": "LocationDialogue Location4", "line_index": 209, "text": "Może zagramy w karty?"}
{"category": "LocationDialogue Location4", "line_index": 210, "text": "Są w sypialni."}
{"category": "LocationDialogue Location4", "line_index": 211, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 214, "text": "// Door > [ERROR]"}
{"category": "LocationDialogue Location4", "line_index": 215, "text": "Huh, o co chodzi?"}
{"category": "LocationDialogue Location4", "line_index": 216, "text": "Gdzie są..."}
{"category": "LocationDialogue Location4", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 218, "text": "Ohh."}
{"category": "LocationDialogue Location4", "line_index": 219, "text": "Przepraszam..."}
{"category": "LocationDialogue Location4", "line_index": 220, "text": "Pobrałam sobie"}
{"category": "LocationDialogue Location4", "line_index": 221, "text": "mały pliczek z internetu."}
{"category": "LocationDialogue Location4", "line_index": 222, "text": "Chciałam trochę ozdobić"}
{"category": "LocationDialogue Location4", "line_index": 223, "text": "obszar wokół domu."}
{"category": "LocationDialogue Location4", "line_index": 224, "text": "Ale jak widać,"}
{"category": "LocationDialogue Location4", "line_index": 225, "text": "musiało być coś nie tak z tym plikiem."}
{"category": "LocationDialogue Location4", "line_index": 226, "text": "Później to naprawię."}
{"category": "LocationDialogue Location4", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 228, "text": "Dlatego nie możemy opuścić domu?"}
{"category": "LocationDialogue Location4", "line_index": 229, "text": "Dokładnie."}
{"category": "LocationDialogue Location4", "line_index": 230, "text": "// Mita shy"}
{"category": "LocationDialogue Location4", "line_index": 231, "text": "Hej..."}
{"category": "LocationDialogue Location4", "line_index": 232, "text": "Co się dzieje?"}
{"category": "LocationDialogue Location4", "line_index": 233, "text": "Czegoś potrzebujesz?"}
{"category": "LocationDialogue Location4", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 236, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 237, "text": "// Wall Clock"}
{"category": "LocationDialogue Location4", "line_index": 238, "text": "Hej, ten zegar,"}
{"category": "LocationDialogue Location4", "line_index": 239, "text": "pokazuje aktualny czas?"}
{"category": "LocationDialogue Location4", "line_index": 240, "text": "Czy może czas z gry?"}
{"category": "LocationDialogue Location4", "line_index": 241, "text": "Jest połączony z moim telefonem?"}
{"category": "LocationDialogue Location4", "line_index": 242, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 243, "text": "A więc, umm..."}
{"category": "LocationDialogue Location4", "line_index": 244, "text": "Szczerze, to nie wiem."}
{"category": "LocationDialogue Location4", "line_index": 245, "text": "Ale czas nie ma tu znaczenia..."}
{"category": "LocationDialogue Location4", "line_index": 246, "text": "Nieważne, czy jest wcześnie, czy późno -"}
{"category": "LocationDialogue Location4", "line_index": 247, "text": "dziewczyna taka jak ja"}
{"category": "LocationDialogue Location4", "line_index": 248, "text": "jest zawsze pełna energii!"}
{"category": "LocationDialogue Location4", "line_index": 249, "text": "Nigdy się nie męczę!"}
{"category": "LocationDialogue Location4", "line_index": 250, "text": "Możemy mieć wieczną wiosnę,"}
{"category": "LocationDialogue Location4", "line_index": 251, "text": "lub urządzić sobie wieczny romantyczny wieczór!"}
{"category": "LocationDialogue Location4", "line_index": 252, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 253, "text": "Interesujące..."}
{"category": "LocationDialogue Location4", "line_index": 254, "text": "I trochę straszne."}
{"category": "LocationDialogue Location4", "line_index": 255, "text": "Stać ciągle w czasie, na zawsze..."}
{"category": "LocationDialogue Location4", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 258, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 259, "text": "// Photos of Mita"}
{"category": "LocationDialogue Location4", "line_index": 260, "text": "Ładne zdjęcia."}
{"category": "LocationDialogue Location4", "line_index": 261, "text": "Obstawiam, że to ty?"}
{"category": "LocationDialogue Location4", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 263, "text": "Ano."}
{"category": "LocationDialogue Location4", "line_index": 264, "text": "Też mi się podobają."}
{"category": "LocationDialogue Location4", "line_index": 265, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 266, "text": "Kto je zrobił?"}
{"category": "LocationDialogue Location4", "line_index": 267, "text": "Czyli są tutaj jeszcze inne osoby?"}
{"category": "LocationDialogue Location4", "line_index": 268, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 269, "text": "Można tak powiedzieć."}
{"category": "LocationDialogue Location4", "line_index": 270, "text": "Kiedyś ci je przedstawię."}
{"category": "LocationDialogue Location4", "line_index": 271, "text": "Ale jeszcze nie teraz."}
{"category": "LocationDialogue Location4", "line_index": 272, "text": "Teraz chcę cię mieć tylko dla siebie."}
{"category": "LocationDialogue Location4", "line_index": 273, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 275, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 276, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 277, "text": "// Portal"}
{"category": "LocationDialogue Location4", "line_index": 278, "text": "Gdzie jest portal?"}
{"category": "LocationDialogue Location4", "line_index": 279, "text": "Albo jakkolwiek to się nazywało?.."}
{"category": "LocationDialogue Location4", "line_index": 280, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 281, "text": "Użyłam odrobinę"}
{"category": "LocationDialogue Location4", "line_index": 282, "text": "magii"}
{"category": "LocationDialogue Location4", "line_index": 283, "text": "i przeniosłam go"}
{"category": "LocationDialogue Location4", "line_index": 284, "text": "gdzieś indziej."}
{"category": "LocationDialogue Location4", "line_index": 285, "text": "Nie potrzebujemy go już."}
{"category": "LocationDialogue Location4", "line_index": 286, "text": "Będzie nam przeszkadzał."}
{"category": "LocationDialogue Location4", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 288, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 289, "text": "// Mirror in the bedroom"}
{"category": "LocationDialogue Location4", "line_index": 290, "text": "Lustro bez odbić..."}
{"category": "LocationDialogue Location4", "line_index": 291, "text": "To naprawdę niepokojące..."}
{"category": "LocationDialogue Location4", "line_index": 292, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 293, "text": "Możemy włączyć odbicia,"}
{"category": "LocationDialogue Location4", "line_index": 294, "text": "jeśli tylko chcesz."}
{"category": "LocationDialogue Location4", "line_index": 295, "text": "Ale czy naprawdę ich potrzebujemy?"}
{"category": "LocationDialogue Location4", "line_index": 296, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 297, "text": "Oczywiście, że tak."}
{"category": "LocationDialogue Location4", "line_index": 298, "text": "Chyba że... ma to jakieś konsekwencje?"}
{"category": "LocationDialogue Location4", "line_index": 299, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 300, "text": "Tak."}
{"category": "LocationDialogue Location4", "line_index": 301, "text": "Będziemy się zacinać i wolniej poruszać."}
{"category": "LocationDialogue Location4", "line_index": 302, "text": "Widziałeś kiedyś jakąś kreskówkę z niskim klatkarzem?"}
{"category": "LocationDialogue Location4", "line_index": 303, "text": "Będzie tak mniej więcej cały czas."}
{"category": "LocationDialogue Location4", "line_index": 304, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 305, "text": "Rozumiem."}
{"category": "LocationDialogue Location4", "line_index": 306, "text": "Może lepiej zostawmy je wyłączone..."}
{"category": "LocationDialogue Location4", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 308, "text": "Ej, [player],"}
{"category": "LocationDialogue Location4", "line_index": 309, "text": "serio lubisz lustra, co?"}
{"category": "LocationDialogue Location4", "line_index": 310, "text": "Masz nadzieję, że zobaczysz tam swój uśmiech?"}
{"category": "LocationDialogue Location4", "line_index": 311, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 312, "text": "Co? Nie..."}
{"category": "LocationDialogue Location4", "line_index": 313, "text": "Jestem po prostu zmęczony"}
{"category": "LocationDialogue Location4", "line_index": 314, "text": "po całej tej pracy."}
{"category": "LocationDialogue Location4", "line_index": 315, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 316, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 317, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 318, "text": "// Blue sneakers"}
{"category": "LocationDialogue Location4", "line_index": 319, "text": "To twoje?"}
{"category": "LocationDialogue Location4", "line_index": 320, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 321, "text": "Nie, te są twoje."}
{"category": "LocationDialogue Location4", "line_index": 322, "text": "Nie pamiętasz?"}
{"category": "LocationDialogue Location4", "line_index": 323, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 324, "text": "Nie przypominam sobie, żebym takie miał..."}
{"category": "LocationDialogue Location4", "line_index": 325, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 326, "text": "To teraz już masz."}
{"category": "LocationDialogue Location4", "line_index": 327, "text": "Możesz je nosić,"}
{"category": "LocationDialogue Location4", "line_index": 328, "text": "gdy wyjdziemy na dwór."}
{"category": "LocationDialogue Location4", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 330, "text": "A co z ubraniami?"}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "Wszystko, co mam, to tylko te,"}
{"category": "LocationDialogue Location4", "line_index": 332, "text": "które mam na sobie."}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "Można tu jakoś zdobyć inne?"}
{"category": "LocationDialogue Location4", "line_index": 334, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 335, "text": "Oczywiście."}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "Widziałam, co nosisz -"}
{"category": "LocationDialogue Location4", "line_index": 337, "text": "I jeśli mam być szczera, to masz słaby gust."}
{"category": "LocationDialogue Location4", "line_index": 338, "text": "W każdym razie, pomogę ci się porządnie ubrać."}
{"category": "LocationDialogue Location4", "line_index": 339, "text": "Ale wszystko w swoim czasie."}
{"category": "LocationDialogue Location4", "line_index": 340, "text": "Obiecuję."}
{"category": "LocationDialogue Location4", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 342, "text": "Okej."}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Games on TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "W co chcesz pograć?"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Game milk"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "To bijatyka!"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "Zobaczmy, kto kogo pierwszy stłucze na zsiadłe mleko."}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "Szaleństwo, nie?"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": "Myślę, że wystarczy już mleka na ten moment. Może zagramy w coś innego?"}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Gamę penguins"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "W tej grze jesteś pingwinem."}
{"category": "LocationDialogue Location4", "line_index": 354, "text": "Musisz się ślizgać i zbierać śnieżki."}
{"category": "LocationDialogue Location4", "line_index": 355, "text": "Już w to graliśmy..."}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "Czekaj, co?"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "Mówisz serio? Myślałam, że mnie..."}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "Jestem taka szczęśliwa!"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "I nawet trochę zszokowana..."}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "W takim razie..."}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "Proszę..."}
{"category": "LocationDialogue Location4", "line_index": 364, "text": "Zostań ze mną, już na zawsze!"}
{"category": "LocationDialogue Location4", "line_index": 365, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 367, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 368, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 369, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 370, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 372, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 373, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 374, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 375, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 376, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 377, "text": "// A gamę about penguins"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "To bardzo proste:"}
{"category": "LocationDialogue Location4", "line_index": 379, "text": "Musisz zbierać śnieżki."}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "Kto zbierze więcej - wygrywa!"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "Zagrajmy dwie rundy, okej?"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// The first map"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "Wow, jak ci się udało zebrać aż tyle?"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "Hee-hee! Mam najwięcej śnieżek!"}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "Lepiej się postaraj!"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "Ha, 1:1!"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// The second map"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "Świetny z ciebie pingwinek!"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "Powinieneś iść na prawdziwe lodowisko!"}
{"category": "LocationDialogue Location4", "line_index": 390, "text": "Pfft, jesteś taki ślamazarny."}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "Może rewanż?"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "Wow, remis! Tego się nie spodziewałam!"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// The gamę is over"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "Więc chcesz w coś jeszcze pograć?"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "Czy masz dość?"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "Po co ci to?"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "Chyba jesteś uzależniony?"}
