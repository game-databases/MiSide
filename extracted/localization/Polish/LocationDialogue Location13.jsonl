{"category": "LocationDialogue Location13", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 1, "text": "Pierścień!"}
{"category": "LocationDialogue Location13", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 3, "text": "// Answer 1 (Gdzie się podziewałaś?)"}
{"category": "LocationDialogue Location13", "line_index": 4, "text": "Próbowałam dostać się do rdzenia."}
{"category": "LocationDialogue Location13", "line_index": 5, "text": "Oczywiście w jednym kawałku."}
{"category": "LocationDialogue Location13", "line_index": 6, "text": "O to chodziło od początku, prawda?"}
{"category": "LocationDialogue Location13", "line_index": 7, "text": "Dlatego musiałam też unikać"}
{"category": "LocationDialogue Location13", "line_index": 8, "text": "Szalonej Mity, prawda? "}
{"category": "LocationDialogue Location13", "line_index": 9, "text": "I znaleźć też informacje,"}
{"category": "LocationDialogue Location13", "line_index": 10, "text": "o zapleczu tego cholernego wszechświata, prawda?"}
{"category": "LocationDialogue Location13", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 12, "text": "Emm, no tak..."}
{"category": "LocationDialogue Location13", "line_index": 13, "text": "Ale jak ty ustawiłaś tę drogę na pierścieniu?"}
{"category": "LocationDialogue Location13", "line_index": 14, "text": "Dlaczego skończyłem w zepsutej wersji?"}
{"category": "LocationDialogue Location13", "line_index": 15, "text": "Pełnej niebezpieczeństw?"}
{"category": "LocationDialogue Location13", "line_index": 16, "text": "Ledwo udało mi się uciec."}
{"category": "LocationDialogue Location13", "line_index": 17, "text": "Skacząc przez okno w nieskończony mrok."}
{"category": "LocationDialogue Location13", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 19, "text": "Przepraszam, zapomniałam ci wytłumaczyć,"}
{"category": "LocationDialogue Location13", "line_index": 20, "text": "co musisz zrobić, aby uciec..."}
{"category": "LocationDialogue Location13", "line_index": 21, "text": "Ale tak, taki był plan."}
{"category": "LocationDialogue Location13", "line_index": 22, "text": "Od początku wystarczyło skoczyć..."}
{"category": "LocationDialogue Location13", "line_index": 23, "text": "I cóż... udało ci się!"}
{"category": "LocationDialogue Location13", "line_index": 24, "text": "Dobra robota!"}
{"category": "LocationDialogue Location13", "line_index": 25, "text": "W porządku, trzymajmy się planu."}
{"category": "LocationDialogue Location13", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 27, "text": "// Answer 2 (Jak się tu dostałaś?)"}
{"category": "LocationDialogue Location13", "line_index": 28, "text": "Musiałeś chyba sporo przejść,"}
{"category": "LocationDialogue Location13", "line_index": 29, "text": "skoro zapomniałeś, o czym mówiłam."}
{"category": "LocationDialogue Location13", "line_index": 30, "text": "Jestem Mita. Mogę podróżować między wersjami kiedy zapragnę."}
{"category": "LocationDialogue Location13", "line_index": 31, "text": "Pamiętasz?"}
{"category": "LocationDialogue Location13", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 33, "text": "Ale nie każda Mita to potrafi,"}
{"category": "LocationDialogue Location13", "line_index": 34, "text": "widziałem kilka."}
{"category": "LocationDialogue Location13", "line_index": 35, "text": "Strasznie przez to cierpiały."}
{"category": "LocationDialogue Location13", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 37, "text": "Niestety, ich wersje są zepsute,"}
{"category": "LocationDialogue Location13", "line_index": 38, "text": "a światy pełne błędów..."}
{"category": "LocationDialogue Location13", "line_index": 39, "text": "Cholera..."}
{"category": "LocationDialogue Location13", "line_index": 40, "text": "Wiesz, kto za tym wszystkim stoi, prawda?"}
{"category": "LocationDialogue Location13", "line_index": 41, "text": "Szalona Mita."}
{"category": "LocationDialogue Location13", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 43, "text": "Powiedz mi coś, czego nie wiem..."}
{"category": "LocationDialogue Location13", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 45, "text": "// Answer 3 (Kim była Mita sprzed chwili?)"}
{"category": "LocationDialogue Location13", "line_index": 46, "text": "To Brzydka Mita."}
{"category": "LocationDialogue Location13", "line_index": 47, "text": "Agresywna i głupia."}
{"category": "LocationDialogue Location13", "line_index": 48, "text": "Nie da się jej przemówić do rozsądku,"}
{"category": "LocationDialogue Location13", "line_index": 49, "text": "jej cały świat - to Szalona Mita."}
{"category": "LocationDialogue Location13", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 51, "text": "Ta... Zauważyłem."}
{"category": "LocationDialogue Location13", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 53, "text": "Dawaj, musimy dostać się do rdzenia."}
{"category": "LocationDialogue Location13", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 55, "text": "// Answer 4 (Jak działa pierścień?)"}
{"category": "LocationDialogue Location13", "line_index": 56, "text": "Ten pierścień..."}
{"category": "LocationDialogue Location13", "line_index": 57, "text": "To jedyna droga do rdzenia?"}
{"category": "LocationDialogue Location13", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 59, "text": "Owszem."}
{"category": "LocationDialogue Location13", "line_index": 60, "text": "Oczywiście, gdybyśmy mieli portal,"}
{"category": "LocationDialogue Location13", "line_index": 61, "text": "moglibyśmy go użyć."}
{"category": "LocationDialogue Location13", "line_index": 62, "text": "Ale cóż, dobre i to."}
{"category": "LocationDialogue Location13", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 64, "text": "Czy ten pierścień w ogóle ma jakieś zalety?"}
{"category": "LocationDialogue Location13", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 66, "text": "Oczywiście!"}
{"category": "LocationDialogue Location13", "line_index": 67, "text": "Łatwo się go nosi,"}
{"category": "LocationDialogue Location13", "line_index": 68, "text": "i zapamiętuje wersje,"}
{"category": "LocationDialogue Location13", "line_index": 69, "text": "które odwiedziłeś."}
{"category": "LocationDialogue Location13", "line_index": 70, "text": "Więc możesz łatwo znaleźć do nich drogę."}
{"category": "LocationDialogue Location13", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 72, "text": "// Answer 5 (Do czego Szalona Mita mnie potrzebuje?)"}
{"category": "LocationDialogue Location13", "line_index": 73, "text": "Dlaczego Szalona Mita nie da mi spokoju?"}
{"category": "LocationDialogue Location13", "line_index": 74, "text": "Wciągnęła mnie w swoją niebezpieczną grę,"}
{"category": "LocationDialogue Location13", "line_index": 75, "text": "jednak wciąż żyję..."}
{"category": "LocationDialogue Location13", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 77, "text": "Ciężko powiedzieć..."}
{"category": "LocationDialogue Location13", "line_index": 78, "text": "Możliwe, że szuka odpowiedniego gracza..."}
{"category": "LocationDialogue Location13", "line_index": 79, "text": "Takiego, który ją zaakceptuje i pokocha."}
{"category": "LocationDialogue Location13", "line_index": 80, "text": "Mimo wszystko, Mita to Mita!"}
{"category": "LocationDialogue Location13", "line_index": 81, "text": "Z racji, że oczywiście to się nie stanie,"}
{"category": "LocationDialogue Location13", "line_index": 82, "text": "zmienia graczy w kasety,"}
{"category": "LocationDialogue Location13", "line_index": 83, "text": "aby nikt nie mógł jej już uciec..."}
{"category": "LocationDialogue Location13", "line_index": 84, "text": "Przynajmniej tak zgaduję."}
{"category": "LocationDialogue Location13", "line_index": 85, "text": "Wracając, skupmy się na tym, co ważne."}
{"category": "LocationDialogue Location13", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 87, "text": "// Answer 6 (Czy to rdzeń?)"}
{"category": "LocationDialogue Location13", "line_index": 88, "text": "To jest to?"}
{"category": "LocationDialogue Location13", "line_index": 89, "text": "Rdzeń?"}
{"category": "LocationDialogue Location13", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 91, "text": "Zaiste. Rdzeń."}
{"category": "LocationDialogue Location13", "line_index": 92, "text": "Spróbuję wytłumaczyć."}
{"category": "LocationDialogue Location13", "line_index": 93, "text": "Wy, gracze, nie jesteście z tego świata..."}
{"category": "LocationDialogue Location13", "line_index": 94, "text": "Co znaczy, że nie potrzebujecie pozwolenia, aby tam wejść."}
{"category": "LocationDialogue Location13", "line_index": 95, "text": "Cóż, przynajmniej tak mi się wydaje."}
{"category": "LocationDialogue Location13", "line_index": 96, "text": "Wracając, jestem pewna,"}
{"category": "LocationDialogue Location13", "line_index": 97, "text": "że rozwiązanie naszych wszystkich problemów,"}
{"category": "LocationDialogue Location13", "line_index": 98, "text": "znajduje się w środku!"}
{"category": "LocationDialogue Location13", "line_index": 99, "text": "[player], spróbuj wejść."}
{"category": "LocationDialogue Location13", "line_index": 100, "text": "Udało ci się..."}
{"category": "LocationDialogue Location13", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 102, "text": "// Look on CoreMita"}
{"category": "LocationDialogue Location13", "line_index": 103, "text": "Ostrożnie, [player]!"}
{"category": "LocationDialogue Location13", "line_index": 104, "text": "To cię obserwuje!"}
{"category": "LocationDialogue Location13", "line_index": 105, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 106, "text": "Co to?"}
{"category": "LocationDialogue Location13", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 108, "text": "Nie mam pojęcia..."}
{"category": "LocationDialogue Location13", "line_index": 109, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 110, "text": "Fajnie..."}
{"category": "LocationDialogue Location13", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 113, "text": "No co tam?"}
{"category": "LocationDialogue Location13", "line_index": 114, "text": "Hej!"}
{"category": "LocationDialogue Location13", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 116, "text": "Chyba znalazłem!"}
{"category": "LocationDialogue Location13", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 118, "text": "Wspaniale! Dobra robota!"}
{"category": "LocationDialogue Location13", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 120, "text": "Jednak muszę podać wersję gry."}
{"category": "LocationDialogue Location13", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 122, "text": "Jasne... Jej wersja to"}
{"category": "LocationDialogue Location13", "line_index": 123, "text": "00.98."}
{"category": "LocationDialogue Location13", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 125, "text": "Bingo!"}
{"category": "LocationDialogue Location13", "line_index": 126, "text": "Okej, a który indeks?"}
{"category": "LocationDialogue Location13", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 128, "text": "Indeks?"}
{"category": "LocationDialogue Location13", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 130, "text": "Potrzebuję indeksu."}
{"category": "LocationDialogue Location13", "line_index": 131, "text": "Czekaj, nie gadaj, że nie wiesz...?"}
{"category": "LocationDialogue Location13", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 134, "text": "To ma sens..."}
{"category": "LocationDialogue Location13", "line_index": 135, "text": "Każda Mita ma własny indeks,"}
{"category": "LocationDialogue Location13", "line_index": 136, "text": "aby przypadkiem nie zresetować całej wersji gry..."}
{"category": "LocationDialogue Location13", "line_index": 137, "text": "To absurdalne!"}
{"category": "LocationDialogue Location13", "line_index": 138, "text": "Nie mogę uwierzyć, że o tym zapomniałam..."}
{"category": "LocationDialogue Location13", "line_index": 139, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 144, "text": "// Answer 1 (Co jest z tobą nie tak?)"}
{"category": "LocationDialogue Location13", "line_index": 145, "text": "To nic takiego..."}
{"category": "LocationDialogue Location13", "line_index": 146, "text": "Jest dobrze."}
{"category": "LocationDialogue Location13", "line_index": 147, "text": "Choć tak wiele się zmieniło..."}
{"category": "LocationDialogue Location13", "line_index": 148, "text": "Muszę pomyśleć..."}
{"category": "LocationDialogue Location13", "line_index": 149, "text": "Daj mi chwilę."}
{"category": "LocationDialogue Location13", "line_index": 150, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 151, "text": "// Answer 2 (Może jest jakiś sposób aby go poznać?)"}
{"category": "LocationDialogue Location13", "line_index": 152, "text": "Ja..."}
{"category": "LocationDialogue Location13", "line_index": 153, "text": "Myślę, że... To obłęd!"}
{"category": "LocationDialogue Location13", "line_index": 154, "text": "Totalne szaleństwo!"}
{"category": "LocationDialogue Location13", "line_index": 155, "text": "To jak szukanie igły w stogu..."}
{"category": "LocationDialogue Location13", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 157, "text": "O co chodzi?"}
{"category": "LocationDialogue Location13", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 159, "text": "Niektóre miejsca są przepełnione informacjami!"}
{"category": "LocationDialogue Location13", "line_index": 160, "text": "Wiesz, to jakby wybebeszać cały świat!"}
{"category": "LocationDialogue Location13", "line_index": 161, "text": "Dzienniki, więcej dzienników, dane..."}
{"category": "LocationDialogue Location13", "line_index": 162, "text": "Chwila... Może to jest to?!"}
{"category": "LocationDialogue Location13", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 164, "text": "Hm? Co jest?"}
{"category": "LocationDialogue Location13", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 166, "text": "Znam pewne miejsce!"}
{"category": "LocationDialogue Location13", "line_index": 167, "text": "Zaczekaj tu."}
{"category": "LocationDialogue Location13", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 169, "text": "Gdzie idziesz?"}
{"category": "LocationDialogue Location13", "line_index": 170, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 171, "text": "// Answer 3 (A co gdyby zaatakować szaloną Mitę?)"}
{"category": "LocationDialogue Location13", "line_index": 172, "text": "Wspominałaś, że każda Mita,"}
{"category": "LocationDialogue Location13", "line_index": 173, "text": "powraca do ustawień fabrycznych po śmierci..."}
{"category": "LocationDialogue Location13", "line_index": 174, "text": "A gdyby tak..."}
{"category": "LocationDialogue Location13", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 176, "text": "Zabić Szaloną Mite?"}
{"category": "LocationDialogue Location13", "line_index": 177, "text": "Mówisz poważnie?"}
{"category": "LocationDialogue Location13", "line_index": 178, "text": "Jak chcesz sobie poradzić z psychopatką dzierżącą piłę łańcuchową?"}
{"category": "LocationDialogue Location13", "line_index": 179, "text": "I pamiętaj - ona kroi nożem nie tylko marchewki!"}
{"category": "LocationDialogue Location13", "line_index": 180, "text": "A z jakiegoś powodu jest przerażająco silna!"}
{"category": "LocationDialogue Location13", "line_index": 181, "text": "To cud, że jeszcze żyjemy..."}
{"category": "LocationDialogue Location13", "line_index": 182, "text": "Chodź, musimy zająć się rdzeniem."}
{"category": "LocationDialogue Location13", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 185, "text": "// core console entry"}
{"category": "LocationDialogue Location13", "line_index": 186, "text": "Trzeba podać login..."}
{"category": "LocationDialogue Location13", "line_index": 187, "text": "Ale jaki?"}
{"category": "LocationDialogue Location13", "line_index": 188, "text": "Mita, wiesz coś o tym?"}
{"category": "LocationDialogue Location13", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 190, "text": "Może jest gdzieś napisany?"}
{"category": "LocationDialogue Location13", "line_index": 191, "text": "Rozejrzyj się."}
{"category": "LocationDialogue Location13", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 193, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location13", "line_index": 194, "text": "To chyba nie to."}
{"category": "LocationDialogue Location13", "line_index": 195, "text": "Ani to."}
{"category": "LocationDialogue Location13", "line_index": 196, "text": "Pudło."}
{"category": "LocationDialogue Location13", "line_index": 197, "text": "Nie, to nie to."}
{"category": "LocationDialogue Location13", "line_index": 198, "text": "Muszę znaleźć opcje resetu postaci."}
{"category": "LocationDialogue Location13", "line_index": 199, "text": "// core console - nope version"}
{"category": "LocationDialogue Location13", "line_index": 200, "text": "To błędna wersja."}
{"category": "LocationDialogue Location13", "line_index": 201, "text": "Oj, mój błąd."}
{"category": "LocationDialogue Location13", "line_index": 202, "text": "To nie to."}
{"category": "LocationDialogue Location13", "line_index": 203, "text": "Trzeba poprawić."}
{"category": "LocationDialogue Location13", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location13", "line_index": 205, "text": "Coś jest nie tak."}
{"category": "LocationDialogue Location13", "line_index": 206, "text": "Indeks jest nieprawidłowy."}
{"category": "LocationDialogue Location13", "line_index": 207, "text": "Muszę poprawić indeks."}
{"category": "LocationDialogue Location13", "line_index": 208, "text": "Nie pasuje."}
{"category": "LocationDialogue Location13", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 210, "text": "// Answer 4 (Little people - Chibi)"}
{"category": "LocationDialogue Location13", "line_index": 211, "text": "Po drodze spotkałem"}
{"category": "LocationDialogue Location13", "line_index": 212, "text": "wiele mini ludzików..."}
{"category": "LocationDialogue Location13", "line_index": 213, "text": "Kim one są?"}
{"category": "LocationDialogue Location13", "line_index": 214, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 215, "text": "Chibi?"}
{"category": "LocationDialogue Location13", "line_index": 216, "text": "Jakby ci to wytłumaczyć..."}
{"category": "LocationDialogue Location13", "line_index": 217, "text": "To takie zjawisko..."}
{"category": "LocationDialogue Location13", "line_index": 218, "text": "Każda Mita ma swoją malutką wersje,"}
{"category": "LocationDialogue Location13", "line_index": 219, "text": "gracze też je mają..."}
{"category": "LocationDialogue Location13", "line_index": 220, "text": "Wiesz, że możemy je przyzwać?"}
{"category": "LocationDialogue Location13", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 222, "text": "Co? Jak?"}
{"category": "LocationDialogue Location13", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 224, "text": "Patrz na to!"}
{"category": "LocationDialogue Location13", "line_index": 225, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 226, "text": "Ale magia..."}
{"category": "LocationDialogue Location13", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 228, "text": "Ale coś jest nie tak z moimi słodziakami,"}
{"category": "LocationDialogue Location13", "line_index": 229, "text": "są w większości martwe."}
{"category": "LocationDialogue Location13", "line_index": 230, "text": "Jest niby ten jeden..."}
{"category": "LocationDialogue Location13", "line_index": 231, "text": "ale cóż,"}
{"category": "LocationDialogue Location13", "line_index": 232, "text": "biega tylko w kółko bez celu."}
