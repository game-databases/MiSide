{"category": "LocationDialogue Location20", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Mila! Nieee! Jesteś chora!"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Ha-ha! Co to ma być?"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "Nowy wyraz twarzy?"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "Nie wstydź się, pozwól mi się przyjrzeć!"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "Oglądanie tego samego grymasu robi się z czasem nudne!"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\""}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "Jak się masz, mój mały wędrowcze??"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "Ciągle gdzieś biegasz, nie masz dość?"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Co zrobiłaś Mili?"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "Oh, czyli nie jesteś jeszcze zmęczony!"}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Idealnie! Zagrajmy więc w pewną grę!"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "Niech cię..."}
{"category": "LocationDialogue Location20", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "Zacznijmy od małego testu!"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "Sprawdzimy twoją koordynację!"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "Oraz umiejętność adaptacji!"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "Co, jeśli jest coś z tobą nie tak!?"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "Co, jeśli nie zasługujesz nawet"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "na to ciało, z którego jesteś taki dumny!?"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "Spójrz..."}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "Który ci się bardziej podoba?"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "Prawy?"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "A może"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "lewy?"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "Serio?"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "Ma to w ogóle jakieś znaczenie?"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "Po prostu się z tobą droczę!"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "Dźganie nożem to już przeżytek,"}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "nie uważasz?"}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "Zaplanowałam dla nas coś lepszego,"}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "na przykład..."}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "Obczaj to!"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Potrzebujemy do tego muzyki!"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "Co myślisz o tej melodii?"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "Sprawia, że moja krew pulsuje!"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "No to zaczynamy!"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "Najpierw zasady!"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rules"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "Gdy gra muzyka,"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "możesz się poruszać."}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "Ale gdy muzyka zamilknie..."}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "ANI DRGNIJ!"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "Albo cię zabiję, hi-hi~"}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "W skrócie: dobiegnij do końca,"}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "zanim skończy się muzyka."}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "Zaczynajmy!"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "Dalej stoisz w miejscu?"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Biegnij, kochaniutki, BIEGNIJ!"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "Oh!"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Spójrz na siebie! Jesteś taki posłuszny!"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Doskonały okaz."}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Chcę cię mieć tylko dla siebie!"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "To było za łatwe, prawda?"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "Wypuść mnie w końcu!"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "To nie koniec!"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "Znam jeszcze inne gry!"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "Na przykład..."}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Zamknę oczy..."}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "A gdy je otworzę,"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "lepiej, żebym cię nie widziała!"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "Rozumiesz?"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "Jeśli cię zobaczę, będzie kara!"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Gotowy? Zaczynajmy!"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "To bez sensu..."}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "Udało ci się!"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Jesteś w tym świetny!"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "Ale teraz będzie trudniej."}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "O wiele trudniej!"}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Chowaj się, biegnij, przeżyj—"}
{"category": "LocationDialogue Location20", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "Ugh! Niech cię diabli!"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Player falls"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "Chyba udało mi się uciec..."}
