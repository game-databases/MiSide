{"category": "LocationDialogue Location12", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Zostań tu."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Chyba coś upuściłam. Zaraz wracam."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "Potem ruszymy po kolejny, nowy świat...."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Dobrze."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Pobawmy się!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Chcę mojego misia!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "Zgubiłam go..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "ZNAJDŹ GO!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Ej..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "Na co się patrzysz?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Quest 1 (Kim jesteś?)"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Jestem Mita."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "Najlepsiejsza Mita."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "Pierwsza Mita."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "Tak mówiła Mita, moja Mita."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Quest 2 (Dlaczego tak wyglądasz?)"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "Jak?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "Niby jak?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "Jak wyglądam?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "Moja Mita mówi, że jestem pięknym oryginałem."}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "To ja!"}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Quest 3 (Co robiła tutaj Mita?)"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Zabierze mnie stąd."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Będziemy mieszkać w innym świecie."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "Moja Mita mnie zaprosiła."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Zabierze mnie i będziemy się bawić."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Quest 4 (Po co ci ta przytulanka?)"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "Bo jesteś jak miś,"}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "który się zgubił,"}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "przypominasz mi mojego misia..."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Quest 5 (Dlaczego Mita była zła?)"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "Moja..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "Mita."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Chce się bawić."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Ona chce tylko..."}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "MNIE."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Jesteśmy wyjątkowe,"}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "jedyne w swoim rodzaju."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Mita i moja Mita,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0.8A oraz 8M54*."}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Quest 6 (Wierzysz jej?)"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "Moja Mita."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "Moja najulubieńsza."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "Moja Mita."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "Moja jedyna przyjaciółka."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "To ty!"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Hej."}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Pobawmy się!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Pokażę ci jak..."}
