{"category": "LocationDialogue Location17", "line_index": 0, "text": "// Player thinks + Make coffee"}
{"category": "LocationDialogue Location17", "line_index": 1, "text": "Będę potrzebował czyjejś pomocy."}
{"category": "LocationDialogue Location17", "line_index": 2, "text": "Mam nadzieję, że ta Mita nie gryzie..."}
{"category": "LocationDialogue Location17", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 4, "text": "Marnuję swój czas..."}
{"category": "LocationDialogue Location17", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 9, "text": "// Player tries to wake up MitaDreamer"}
{"category": "LocationDialogue Location17", "line_index": 10, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 11, "text": "Mita, wstawaj!"}
{"category": "LocationDialogue Location17", "line_index": 12, "text": "Mita!"}
{"category": "LocationDialogue Location17", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 14, "text": "Mita, pobudka!"}
{"category": "LocationDialogue Location17", "line_index": 15, "text": "Potrzebuję twojej pomocy."}
{"category": "LocationDialogue Location17", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 17, "text": "Kim ty jesteeeeeś?"}
{"category": "LocationDialogue Location17", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 19, "text": "Musisz mi pomóc z dźwigniami."}
{"category": "LocationDialogue Location17", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 21, "text": "Jakimi dźwigniami?"}
{"category": "LocationDialogue Location17", "line_index": 22, "text": "Daj mi spać..."}
{"category": "LocationDialogue Location17", "line_index": 23, "text": "Albo przynieś mi kawę."}
{"category": "LocationDialogue Location17", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 25, "text": "Przecież są niedaleko..."}
{"category": "LocationDialogue Location17", "line_index": 26, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 27, "text": "Mi-taa!"}
{"category": "LocationDialogue Location17", "line_index": 28, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 31, "text": "// Player gives away the coffee"}
{"category": "LocationDialogue Location17", "line_index": 32, "text": "Mita,"}
{"category": "LocationDialogue Location17", "line_index": 33, "text": "masz swoją kawę."}
{"category": "LocationDialogue Location17", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 37, "text": "// MitaDreamer exercise"}
{"category": "LocationDialogue Location17", "line_index": 38, "text": "Dźwignie..."}
{"category": "LocationDialogue Location17", "line_index": 39, "text": "powiadasz..."}
{"category": "LocationDialogue Location17", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 41, "text": "Tak."}
{"category": "LocationDialogue Location17", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 43, "text": "Skąd o nich wiesz?"}
{"category": "LocationDialogue Location17", "line_index": 44, "text": "W sumie głupie pytanie..."}
{"category": "LocationDialogue Location17", "line_index": 45, "text": "Patrząc na to,"}
{"category": "LocationDialogue Location17", "line_index": 46, "text": "ile już tu jesteś... "}
{"category": "LocationDialogue Location17", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 48, "text": "Poczekaj chwilkę,"}
{"category": "LocationDialogue Location17", "line_index": 49, "text": "muszę usiąść."}
{"category": "LocationDialogue Location17", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 51, "text": "Dobra, to..?"}
{"category": "LocationDialogue Location17", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 53, "text": "Nie wiem co powiedzieć..."}
{"category": "LocationDialogue Location17", "line_index": 54, "text": "Muszę iść dalej,"}
{"category": "LocationDialogue Location17", "line_index": 55, "text": "pierścień wskazuje mi drogę."}
{"category": "LocationDialogue Location17", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 57, "text": "Masz jej pierścień?"}
{"category": "LocationDialogue Location17", "line_index": 58, "text": "No to nie dziwię się,"}
{"category": "LocationDialogue Location17", "line_index": 59, "text": "że znalazłeś to miejsce."}
{"category": "LocationDialogue Location17", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 61, "text": "Dokładnie."}
{"category": "LocationDialogue Location17", "line_index": 62, "text": "Więc, pomożesz mi?"}
{"category": "LocationDialogue Location17", "line_index": 63, "text": "No wiesz, z dźwigniami?"}
{"category": "LocationDialogue Location17", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 65, "text": "Spoko."}
{"category": "LocationDialogue Location17", "line_index": 66, "text": "Pomogę."}
{"category": "LocationDialogue Location17", "line_index": 67, "text": "Już... idę..."}
{"category": "LocationDialogue Location17", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 70, "text": "Mita, no dawaj..."}
{"category": "LocationDialogue Location17", "line_index": 71, "text": "Chodźmy już."}
{"category": "LocationDialogue Location17", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 73, "text": "Huh?.."}
{"category": "LocationDialogue Location17", "line_index": 74, "text": "Dobrze."}
{"category": "LocationDialogue Location17", "line_index": 75, "text": "Chodźmy."}
{"category": "LocationDialogue Location17", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 78, "text": "// MitaDreamer fall"}
{"category": "LocationDialogue Location17", "line_index": 79, "text": "Wstawaj."}
{"category": "LocationDialogue Location17", "line_index": 80, "text": "Jesteś aż tak senna?"}
{"category": "LocationDialogue Location17", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 82, "text": "// MitaDreamer again sleep"}
{"category": "LocationDialogue Location17", "line_index": 83, "text": "Obudź się."}
{"category": "LocationDialogue Location17", "line_index": 84, "text": "Już prawie jesteśmy."}
{"category": "LocationDialogue Location17", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 87, "text": "// Switches"}
{"category": "LocationDialogue Location17", "line_index": 88, "text": "Dobra,"}
{"category": "LocationDialogue Location17", "line_index": 89, "text": "jestem gotowa."}
{"category": "LocationDialogue Location17", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 91, "text": "Też jestem gotów."}
{"category": "LocationDialogue Location17", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 93, "text": "Dobra."}
{"category": "LocationDialogue Location17", "line_index": 94, "text": "Zacznę"}
{"category": "LocationDialogue Location17", "line_index": 95, "text": "odliczać."}
{"category": "LocationDialogue Location17", "line_index": 96, "text": "I pociągniemy je razem."}
{"category": "LocationDialogue Location17", "line_index": 97, "text": "Okej?"}
{"category": "LocationDialogue Location17", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 99, "text": "Po prostu nie zaśnij, okej?"}
{"category": "LocationDialogue Location17", "line_index": 100, "text": "Zaczynaj."}
{"category": "LocationDialogue Location17", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 103, "text": "3"}
{"category": "LocationDialogue Location17", "line_index": 104, "text": "2"}
{"category": "LocationDialogue Location17", "line_index": 105, "text": "1"}
{"category": "LocationDialogue Location17", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 107, "text": "// Player lose 1"}
{"category": "LocationDialogue Location17", "line_index": 108, "text": "Zasypiasz?"}
{"category": "LocationDialogue Location17", "line_index": 109, "text": "No dawaj,"}
{"category": "LocationDialogue Location17", "line_index": 110, "text": "jeszcze raz..."}
{"category": "LocationDialogue Location17", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 112, "text": "// Player lose 2"}
{"category": "LocationDialogue Location17", "line_index": 113, "text": "Znowu?"}
{"category": "LocationDialogue Location17", "line_index": 114, "text": "No weź,"}
{"category": "LocationDialogue Location17", "line_index": 115, "text": "zas..."}
{"category": "LocationDialogue Location17", "line_index": 116, "text": "Ja tu zasypiam..."}
{"category": "LocationDialogue Location17", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 118, "text": "// Player lose 3"}
{"category": "LocationDialogue Location17", "line_index": 119, "text": "Zaraz... usnę..."}
{"category": "LocationDialogue Location17", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 122, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 123, "text": "Wspaniale,"}
{"category": "LocationDialogue Location17", "line_index": 124, "text": "dziękuję, Mita."}
{"category": "LocationDialogue Location17", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 126, "text": "Mm-hmm."}
{"category": "LocationDialogue Location17", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 129, "text": "Drzwi..."}
{"category": "LocationDialogue Location17", "line_index": 130, "text": "takie..."}
{"category": "LocationDialogue Location17", "line_index": 131, "text": "wolne..."}
{"category": "LocationDialogue Location17", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 134, "text": "Idę spać..."}
{"category": "LocationDialogue Location17", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 136, "text": "// Why kitchen?"}
{"category": "LocationDialogue Location17", "line_index": 137, "text": "Po co przyszliśmy do kuchni?"}
{"category": "LocationDialogue Location17", "line_index": 138, "text": "Jak zasnę na zimnej podłodze,"}
{"category": "LocationDialogue Location17", "line_index": 139, "text": "to będzie twoja wina."}
{"category": "LocationDialogue Location17", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 141, "text": "// Why bathroom?"}
{"category": "LocationDialogue Location17", "line_index": 142, "text": "Nie rozumiem..."}
{"category": "LocationDialogue Location17", "line_index": 143, "text": "Za jaką dźwignię mam tu pociągnąć?"}
{"category": "LocationDialogue Location17", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 145, "text": "// Put button"}
{"category": "LocationDialogue Location17", "line_index": 146, "text": "Nic się nie stało?"}
{"category": "LocationDialogue Location17", "line_index": 147, "text": "Do czego w ogóle ten przycisk?"}
{"category": "LocationDialogue Location17", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 149, "text": "// Cofee"}
{"category": "LocationDialogue Location17", "line_index": 150, "text": "Jeszcze kawy?"}
{"category": "LocationDialogue Location17", "line_index": 151, "text": "Czy znowu mi zaśniesz?"}
{"category": "LocationDialogue Location17", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 153, "text": "Coo?"}
{"category": "LocationDialogue Location17", "line_index": 154, "text": "Nieeee..."}
{"category": "LocationDialogue Location17", "line_index": 155, "text": "Ta kawa jest okropna..."}
{"category": "LocationDialogue Location17", "line_index": 156, "text": "Wszystko jest w porządku..."}
{"category": "LocationDialogue Location17", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 158, "text": "// Button"}
{"category": "LocationDialogue Location17", "line_index": 159, "text": "Mita? Przycisk nie działa... Słyszysz mnie?"}
{"category": "LocationDialogue Location17", "line_index": 160, "text": "Haloo?"}
