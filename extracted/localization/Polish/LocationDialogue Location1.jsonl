{"category": "LocationDialogue Location1", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 1, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 9, "text": "Hej, jestem Mita!"}
{"category": "LocationDialogue Location1", "line_index": 10, "text": "Jak masz na imię?"}
{"category": "LocationDialogue Location1", "line_index": 11, "text": "Miło mi cię poznać, [player]!"}
{"category": "LocationDialogue Location1", "line_index": 12, "text": "Emm, [player]..."}
{"category": "LocationDialogue Location1", "line_index": 13, "text": "Nie zdążyłam posprzątać, więc jest tu lekki bałagan..."}
{"category": "LocationDialogue Location1", "line_index": 14, "text": "Pomożesz mi?"}
{"category": "LocationDialogue Location1", "line_index": 15, "text": "Uff.."}
{"category": "LocationDialogue Location1", "line_index": 16, "text": "Nie wiem, jak ci dziękować!"}
{"category": "LocationDialogue Location1", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 18, "text": "Hej [Player], burczy mi w brzuchu..."}
{"category": "LocationDialogue Location1", "line_index": 19, "text": "Zjadłabym coś..."}
{"category": "LocationDialogue Location1", "line_index": 20, "text": "Możesz mi kupić składniki na rosół?"}
{"category": "LocationDialogue Location1", "line_index": 21, "text": "Hura! Mamy już wszystko!"}
{"category": "LocationDialogue Location1", "line_index": 22, "text": "Przygotujemy go razem?"}
{"category": "LocationDialogue Location1", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 25, "text": "Hej [player]! Myślałam nad kupnem przenośnego telewizora."}
{"category": "LocationDialogue Location1", "line_index": 26, "text": "Wiesz, takiego małego z antenką."}
{"category": "LocationDialogue Location1", "line_index": 27, "text": "Idealnego na pikniki. Co o tym myślisz?"}
{"category": "LocationDialogue Location1", "line_index": 28, "text": "Pamiętasz, że możesz grać w gry, żeby zdobyć pieniądze, prawda?"}
{"category": "LocationDialogue Location1", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 30, "text": "Hura! Udało ci się! Teraz możesz kupić mi ten telewizor!"}
{"category": "LocationDialogue Location1", "line_index": 31, "text": "O, właśnie ten! Mały, podręczny i tani! Czyli taki, jaki chciałam."}
{"category": "LocationDialogue Location1", "line_index": 32, "text": "Dziękuję ci bardzo!"}
{"category": "LocationDialogue Location1", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 34, "text": "Hejka, [player]! Tak się cieszę, że mi pomagasz!"}
{"category": "LocationDialogue Location1", "line_index": 35, "text": "Pamiętasz ten telewizor? Był fajny, ale niestety się popsuł."}
{"category": "LocationDialogue Location1", "line_index": 36, "text": "No nic, pomożesz mi przestawić tę szafę?"}
{"category": "LocationDialogue Location1", "line_index": 37, "text": "Jest taka ciężka... >.<"}
{"category": "LocationDialogue Location1", "line_index": 38, "text": "Bardzo ci dziękuję, słodziaku! <3"}
{"category": "LocationDialogue Location1", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 40, "text": "Oj, [player]! Wiem, że minął tylko jeden dzień, ale tak za tobą tęskniłam!"}
{"category": "LocationDialogue Location1", "line_index": 41, "text": "Chciałabym móc widywać cię częściej."}
{"category": "LocationDialogue Location1", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 43, "text": "To dla mnie?"}
{"category": "LocationDialogue Location1", "line_index": 44, "text": "Dziękuję, dziękuję, dziękuję!"}
{"category": "LocationDialogue Location1", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 46, "text": "Hej, [player]! Tak sobie myślałam..."}
{"category": "LocationDialogue Location1", "line_index": 47, "text": "Chciałabym spotkać się z tobą twarzą w twarz."}
{"category": "LocationDialogue Location1", "line_index": 48, "text": "Denerwuje mnie to, że nie możemy nic z tym zrobić!"}
{"category": "LocationDialogue Location1", "line_index": 49, "text": "Zawsze mi pomagasz i jesteś dla mnie taki miły..."}
{"category": "LocationDialogue Location1", "line_index": 50, "text": "Chciałabym zrobić też coś dla ciebie."}
{"category": "LocationDialogue Location1", "line_index": 51, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 52, "text": "Albo wiesz co? Mam pomysł!"}
{"category": "LocationDialogue Location1", "line_index": 53, "text": "Jesteśmy już razem."}
{"category": "LocationDialogue Location1", "line_index": 54, "text": "Możesz odłożyć telefon."}
{"category": "LocationDialogue Location1", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 57, "text": "// T-shirt on the bed"}
{"category": "LocationDialogue Location1", "line_index": 58, "text": "A ty co tutaj robisz?"}
{"category": "LocationDialogue Location1", "line_index": 59, "text": "// Rubik's Cube"}
{"category": "LocationDialogue Location1", "line_index": 60, "text": "Czemu to takie trudne..."}
{"category": "LocationDialogue Location1", "line_index": 61, "text": "Ułożyłem ją raz i nigdy więcej jej nie dotknąłem."}
{"category": "LocationDialogue Location1", "line_index": 62, "text": "Pewnie nie dałbym rady zrobić tego ponownie..."}
{"category": "LocationDialogue Location1", "line_index": 63, "text": "// Computer"}
{"category": "LocationDialogue Location1", "line_index": 64, "text": "Zobaczmy..."}
{"category": "LocationDialogue Location1", "line_index": 65, "text": "Lista zadań..."}
{"category": "LocationDialogue Location1", "line_index": 66, "text": "Napisać skrypty postaci,"}
{"category": "LocationDialogue Location1", "line_index": 67, "text": "i wcisnąć gdzieś czas na kodowanie."}
{"category": "LocationDialogue Location1", "line_index": 68, "text": "// The airplane"}
{"category": "LocationDialogue Location1", "line_index": 69, "text": "Ale poleciał!"}
{"category": "LocationDialogue Location1", "line_index": 70, "text": "// Trash in the corner"}
{"category": "LocationDialogue Location1", "line_index": 71, "text": "Ehh, nigdy nie mam czasu posprzątać..."}
{"category": "LocationDialogue Location1", "line_index": 72, "text": "Ale tym razem to zrobię!"}
{"category": "LocationDialogue Location1", "line_index": 73, "text": "Kiedy tak właściwie wywożą śmieci?"}
{"category": "LocationDialogue Location1", "line_index": 74, "text": "// Photo of a cat on a watermelon"}
{"category": "LocationDialogue Location1", "line_index": 75, "text": "Bardzo mi się to spodobało."}
{"category": "LocationDialogue Location1", "line_index": 76, "text": "Kot na arbuzie."}
{"category": "LocationDialogue Location1", "line_index": 77, "text": "// Photo with a girl"}
{"category": "LocationDialogue Location1", "line_index": 78, "text": "Wcale nie jesteśmy tacy sami,"}
{"category": "LocationDialogue Location1", "line_index": 79, "text": "ja i moja siostra."}
{"category": "LocationDialogue Location1", "line_index": 80, "text": "Ona nie usiedzi w jednym miejscu,"}
{"category": "LocationDialogue Location1", "line_index": 81, "text": "a ja siedzę przykuty w domu."}
{"category": "LocationDialogue Location1", "line_index": 82, "text": "// Photo with people"}
{"category": "LocationDialogue Location1", "line_index": 83, "text": "Hmm..."}
{"category": "LocationDialogue Location1", "line_index": 84, "text": "Praca w korpo miała na nas spory wpływ, co?"}
{"category": "LocationDialogue Location1", "line_index": 85, "text": "Każdego dnia podlizywanie się sobie nawzajem."}
{"category": "LocationDialogue Location1", "line_index": 86, "text": "Wciąż dziwnie ciągnie mnie do tego miejsca."}
{"category": "LocationDialogue Location1", "line_index": 87, "text": "Ale..."}
{"category": "LocationDialogue Location1", "line_index": 88, "text": "Ciekawe czy..."}
{"category": "LocationDialogue Location1", "line_index": 89, "text": "Czy kiedyś znowu ich zobaczę?"}
{"category": "LocationDialogue Location1", "line_index": 90, "text": "Ehh... Czemu ja wciąż trzymam to zdjęcie?"}
{"category": "LocationDialogue Location1", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 93, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 99, "text": "// Nope name"}
{"category": "LocationDialogue Location1", "line_index": 100, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 101, "text": "U-um..."}
{"category": "LocationDialogue Location1", "line_index": 102, "text": "To akurat nie zadziała."}
{"category": "LocationDialogue Location1", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 104, "text": "// Name Developer"}
{"category": "LocationDialogue Location1", "line_index": 105, "text": "Naprawdę postanowiłeś nazwać się, jak deweloper?"}
{"category": "LocationDialogue Location1", "line_index": 106, "text": "Miło mi, że go znasz, ale…"}
{"category": "LocationDialogue Location1", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 108, "text": "// Bad name"}
{"category": "LocationDialogue Location1", "line_index": 109, "text": "Wiem, co to znaczy, i nie chcę, żebyś tak o sobie mówił."}
{"category": "LocationDialogue Location1", "line_index": 110, "text": "To niemiłe!"}
{"category": "LocationDialogue Location1", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 112, "text": "// Go restart"}
{"category": "LocationDialogue Location1", "line_index": 113, "text": "Tak nie należy robić. Zacznijmy od początku."}
{"category": "LocationDialogue Location1", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 115, "text": "// Name with numbers"}
{"category": "LocationDialogue Location1", "line_index": 116, "text": "Czyli lubisz liczby? To bardzo kreatywneee~"}
{"category": "LocationDialogue Location1", "line_index": 117, "text": "Cóż, twój wybór."}
{"category": "LocationDialogue Location1", "line_index": 118, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 119, "text": "// Name Mita"}
{"category": "LocationDialogue Location1", "line_index": 120, "text": "Mita?"}
{"category": "LocationDialogue Location1", "line_index": 121, "text": "Naprawdę chcesz nazywać się jak ja?"}
{"category": "LocationDialogue Location1", "line_index": 122, "text": "Albo... To też i twoje imię?"}
{"category": "LocationDialogue Location1", "line_index": 123, "text": "Bez urazy, ale jest tu miejsce tylko dla jednej Mity."}
{"category": "LocationDialogue Location1", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 125, "text": "// Day 10"}
{"category": "LocationDialogue Location1", "line_index": 126, "text": "Ooo, wróciłeś."}
{"category": "LocationDialogue Location1", "line_index": 127, "text": "Hej, zgubiłam swoją szczotkę do włosów..."}
{"category": "LocationDialogue Location1", "line_index": 128, "text": "Pomożesz mi jej poszukać?"}
{"category": "LocationDialogue Location1", "line_index": 129, "text": "Zajrzyj proszę do szafki nocnej, powinna tam być."}
{"category": "LocationDialogue Location1", "line_index": 130, "text": "// Looked in the bedside table"}
{"category": "LocationDialogue Location1", "line_index": 131, "text": "Hmm, tutaj jej nie ma..."}
{"category": "LocationDialogue Location1", "line_index": 132, "text": "Spróbujmy w innym miejscu."}
{"category": "LocationDialogue Location1", "line_index": 133, "text": "Tylko nie zaglądaj do piekarnika, okej?"}
{"category": "LocationDialogue Location1", "line_index": 134, "text": "Tam akurat już sprawdzałam."}
{"category": "LocationDialogue Location1", "line_index": 135, "text": "// Looked into the stove"}
{"category": "LocationDialogue Location1", "line_index": 136, "text": "Ej! Mówiłam, żebyś tam nie patrzył..."}
{"category": "LocationDialogue Location1", "line_index": 137, "text": "Obróć się – a ja to posprzątam."}
{"category": "LocationDialogue Location1", "line_index": 138, "text": "...Już skończyłam, poszukajmy jej gdzieś indziej."}
{"category": "LocationDialogue Location1", "line_index": 139, "text": "Ej, i, emm, zapomnij o tym, co tam widziałeś, okej?"}
{"category": "LocationDialogue Location1", "line_index": 140, "text": "// Found a hairbrush"}
{"category": "LocationDialogue Location1", "line_index": 141, "text": "Znalazłeś ją! Dobra robota!"}
{"category": "LocationDialogue Location1", "line_index": 142, "text": "Więc, na co masz teraz ochotę?"}
