{"category": "LocationDialogue Location8", "line_index": 0, "text": "// The first meeting"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "Kim ty jesteś?"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "Co ci się stało?"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "Nie potrafisz mówić?"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "Zaczekaj..."}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "Chcesz opuścić to miejsce?"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "Tak..."}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "Muszę przedostać się"}
{"category": "LocationDialogue Location8", "line_index": 11, "text": "do poprzedniej wersji gry."}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "Poprzedniej wersji?..."}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "Dlaczego chcesz przejść"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "do poprzedniej wersji?"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "Dlaczego nie chcesz zostać"}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "i być moim"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "drugim przyjacielem?..."}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Skipping all dialogs"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "Rozumiem..."}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Standing by the window (Random)"}
{"category": "LocationDialogue Location8", "line_index": 24, "text": "Drzwi cię stąd nie wyprowadzą."}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "Wygląda na to, że się spieszysz..."}
{"category": "LocationDialogue Location8", "line_index": 26, "text": "Bieganie w kółko ci nie pomoże."}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "Tak bardzo chcesz uciec?"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "Wyjrzyj przez okno..."}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Aren't you Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "Gracz... Jesteś graczem, prawda?"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": "Możemy się pobawić..."}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "Jeśli odnajdę w sobie wystarczająco siły,"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": "będziemy mogli się pobawić."}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (What happened to you?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "Nie mam pewności... Nie wiem..."}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "Nie sądzę, aby stało się coś... złego..."}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "Ale wszystko, co dobre... rozmywa się..."}
{"category": "LocationDialogue Location8", "line_index": 41, "text": "Przynajmniej został mi przyjaciel."}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "Dlaczego mnie zostawili?"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "Czy nie byłam wystarczająca?"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "Boję się."}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Quest 3 (Become a second friend?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "Przyjaciele..."}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "Zostało ich tak niewielu."}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "Tylko jeden..."}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "Jest mi przykro, graczu."}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "Zostaniesz moim przyjacielem?"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "Z wielką chęcią,"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "ale muszę iść dalej..."}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "Serduszko mi pęka..."}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Is this your house?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "Dom?"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "Graczu...zmieniłeś się..."}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "Twoje ramiona są krótsze i nie wyglądasz na zdenerwowanego..."}
{"category": "LocationDialogue Location8", "line_index": 62, "text": "Graczu, stałeś się milszy, łagodniejszy."}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "Eee..."}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "Co masz na myśli?"}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "Jest dobrze..."}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "bo... już więcej... nie będę cierpieć?"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (How do I leave this place?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "Naprawdę zamierzasz mnie zostawić?"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "Czy to już jest moje..."}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "przeznaczenie?"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "Ja..."}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": "Drzwi na nic się nie przydadzą."}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Hołd player (Random)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "Dlaczego chcesz odejść?"}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "Zostań tu..."}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "Pobaw się ze mną..."}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "Graczu..."}
