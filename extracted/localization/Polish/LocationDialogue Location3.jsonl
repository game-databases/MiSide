{"category": "LocationDialogue Location3", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 1, "text": "Witaj, [player]!"}
{"category": "LocationDialogue Location3", "line_index": 2, "text": "W końcu mogę cię poznać!"}
{"category": "LocationDialogue Location3", "line_index": 3, "text": "Jestem tak podekscytowana!"}
{"category": "LocationDialogue Location3", "line_index": 4, "text": "Wiem, że masz wiele pytań..."}
{"category": "LocationDialogue Location3", "line_index": 5, "text": "Ale tak w skrócie,"}
{"category": "LocationDialogue Location3", "line_index": 6, "text": "zbudowałam tę specjalną maszynę,"}
{"category": "LocationDialogue Location3", "line_index": 7, "text": "żeby cię tu do mnie sprowadzić."}
{"category": "LocationDialogue Location3", "line_index": 8, "text": "Niestety, przeniosło cię do złej wersji..."}
{"category": "LocationDialogue Location3", "line_index": 9, "text": "W której to..."}
{"category": "LocationDialogue Location3", "line_index": 10, "text": "W sumie, to długa historia!"}
{"category": "LocationDialogue Location3", "line_index": 11, "text": "Cieszę się, że cię widzę."}
{"category": "LocationDialogue Location3", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 13, "text": "// Answer 1 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 14, "text": "Tak."}
{"category": "LocationDialogue Location3", "line_index": 15, "text": "No co ty, [player], zapomniałeś?"}
{"category": "LocationDialogue Location3", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 17, "text": "// Answer 2 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 18, "text": "Chcesz już wracać?"}
{"category": "LocationDialogue Location3", "line_index": 19, "text": "Mogłabym ci z tym pomóc... Ale co ze mną?"}
{"category": "LocationDialogue Location3", "line_index": 20, "text": "Proszę, zostań ze mną jeszcze chwilę..."}
{"category": "LocationDialogue Location3", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 22, "text": "// Answer 3 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 23, "text": "Pozwól, że ci wyjaśnię..."}
{"category": "LocationDialogue Location3", "line_index": 24, "text": "I oto jesteś."}
{"category": "LocationDialogue Location3", "line_index": 25, "text": "Zrozumiałeś?"}
{"category": "LocationDialogue Location3", "line_index": 26, "text": "Umm... Niezbyt."}
{"category": "LocationDialogue Location3", "line_index": 27, "text": "W porządku!"}
{"category": "LocationDialogue Location3", "line_index": 28, "text": "Najważniejsze, że jesteśmy w końcu razem."}
{"category": "LocationDialogue Location3", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 31, "text": "Jesteś głodny?"}
{"category": "LocationDialogue Location3", "line_index": 32, "text": "Może coś ugotujemy?"}
{"category": "LocationDialogue Location3", "line_index": 33, "text": "Masz,"}
{"category": "LocationDialogue Location3", "line_index": 34, "text": "pomóż mi pokroić marcheweczki."}
{"category": "LocationDialogue Location3", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 36, "text": "Skąd tu te warzywa?"}
{"category": "LocationDialogue Location3", "line_index": 37, "text": "Przed chwilą ich tu nie było."}
{"category": "LocationDialogue Location3", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 39, "text": "[player], przecież jesteśmy w grze."}
{"category": "LocationDialogue Location3", "line_index": 40, "text": "Nie obijaj się, pomóż mi."}
{"category": "LocationDialogue Location3", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 42, "text": "Dziękuję!"}
{"category": "LocationDialogue Location3", "line_index": 43, "text": "Przyniesiesz mi nożyczki?"}
{"category": "LocationDialogue Location3", "line_index": 44, "text": "Powinny być w łazience."}
{"category": "LocationDialogue Location3", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 46, "text": "Chodź, siadaj do stołu."}
{"category": "LocationDialogue Location3", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 49, "text": "// Kitchen"}
{"category": "LocationDialogue Location3", "line_index": 50, "text": "Chciałbyś trochę sosu?"}
{"category": "LocationDialogue Location3", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 52, "text": "Nie, dzięki."}
{"category": "LocationDialogue Location3", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 54, "text": "No szkoda."}
{"category": "LocationDialogue Location3", "line_index": 55, "text": "Bez sosu to nie to samo!"}
{"category": "LocationDialogue Location3", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 58, "text": "Dziękuję."}
{"category": "LocationDialogue Location3", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 60, "text": "Już skończyłeś?"}
{"category": "LocationDialogue Location3", "line_index": 61, "text": "Ehh, moja porcja wydaje się -"}
{"category": "LocationDialogue Location3", "line_index": 62, "text": "nie kończyć..."}
{"category": "LocationDialogue Location3", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 65, "text": "// Help"}
{"category": "LocationDialogue Location3", "line_index": 66, "text": "Co ci jest?"}
{"category": "LocationDialogue Location3", "line_index": 67, "text": "Powiedz mi, co widzisz."}
{"category": "LocationDialogue Location3", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 69, "text": "Serce... wali jak szalone,"}
{"category": "LocationDialogue Location3", "line_index": 70, "text": "i mam mroczki przed oczami."}
{"category": "LocationDialogue Location3", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 72, "text": "Dobra."}
{"category": "LocationDialogue Location3", "line_index": 73, "text": "Wiem już, o co chodzi."}
{"category": "LocationDialogue Location3", "line_index": 74, "text": "Dasz radę wstać?"}
{"category": "LocationDialogue Location3", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 78, "text": "Co to?"}
{"category": "LocationDialogue Location3", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 80, "text": "Tabletki."}
{"category": "LocationDialogue Location3", "line_index": 81, "text": "Poczujesz się po nich lepiej."}
{"category": "LocationDialogue Location3", "line_index": 82, "text": "Podejdź do lustra."}
{"category": "LocationDialogue Location3", "line_index": 83, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 84, "text": "Weź je."}
{"category": "LocationDialogue Location3", "line_index": 85, "text": "No już, szybciutko."}
{"category": "LocationDialogue Location3", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 89, "text": "I jak, lepiej?"}
{"category": "LocationDialogue Location3", "line_index": 90, "text": "Pomogło?"}
{"category": "LocationDialogue Location3", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 92, "text": "Tak."}
{"category": "LocationDialogue Location3", "line_index": 93, "text": "Tak szybko zadziałały..."}
{"category": "LocationDialogue Location3", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 95, "text": "[player], przecież jesteśmy w grze."}
{"category": "LocationDialogue Location3", "line_index": 96, "text": "Wszystko jest tutaj prostsze."}
{"category": "LocationDialogue Location3", "line_index": 97, "text": "Nawet najmniejsze rzeczy,"}
{"category": "LocationDialogue Location3", "line_index": 98, "text": "dają wspaniałe rezultaty."}
{"category": "LocationDialogue Location3", "line_index": 99, "text": "To jest jedna z koncepcji tej gry:"}
{"category": "LocationDialogue Location3", "line_index": 100, "text": "Uproszczanie."}
{"category": "LocationDialogue Location3", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 102, "text": "Jakiś przykład?"}
{"category": "LocationDialogue Location3", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 104, "text": "Marcheweczka!"}
{"category": "LocationDialogue Location3", "line_index": 105, "text": "Kroisz jedną,"}
{"category": "LocationDialogue Location3", "line_index": 106, "text": "a wydaje się, jakbyś pokroił ze trzy."}
{"category": "LocationDialogue Location3", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 108, "text": "Słuchaj, wszystko dzieje się tak szybko."}
{"category": "LocationDialogue Location3", "line_index": 109, "text": "Jestem przerażony... Tak bardzo, że nawet nie wiem, jak to ująć."}
{"category": "LocationDialogue Location3", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 112, "text": "Coś się stało?"}
{"category": "LocationDialogue Location3", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 114, "text": "Znalazłem kasety w wentylacji."}
{"category": "LocationDialogue Location3", "line_index": 115, "text": "Miały na sobie imiona."}
{"category": "LocationDialogue Location3", "line_index": 116, "text": "O co z nimi chodzi?"}
{"category": "LocationDialogue Location3", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 118, "text": "Kasety?"}
{"category": "LocationDialogue Location3", "line_index": 119, "text": "Jakie znowu kasety?"}
{"category": "LocationDialogue Location3", "line_index": 120, "text": "Pokażesz mi, okej?"}
{"category": "LocationDialogue Location3", "line_index": 121, "text": "Ale to później."}
{"category": "LocationDialogue Location3", "line_index": 122, "text": "Na razie coś zjedzmy."}
{"category": "LocationDialogue Location3", "line_index": 123, "text": "Podasz mi nożyczki?"}
{"category": "LocationDialogue Location3", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 125, "text": "// Pierścień"}
{"category": "LocationDialogue Location3", "line_index": 126, "text": "Pierścień?"}
{"category": "LocationDialogue Location3", "line_index": 127, "text": "// lustro"}
{"category": "LocationDialogue Location3", "line_index": 128, "text": "To sztuczne lustro?"}
{"category": "LocationDialogue Location3", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 130, "text": "O kurczaczki!"}
{"category": "LocationDialogue Location3", "line_index": 131, "text": "Zapomniałam włączyć odbicia."}
{"category": "LocationDialogue Location3", "line_index": 132, "text": "No i proszę."}
{"category": "LocationDialogue Location3", "line_index": 133, "text": "Wszystko już widać!"}
{"category": "LocationDialogue Location3", "line_index": 134, "text": "To zabawne, bo,"}
{"category": "LocationDialogue Location3", "line_index": 135, "text": "wcześniej nawet nie wiedziałam, czym są odbicia."}
{"category": "LocationDialogue Location3", "line_index": 136, "text": "Coś takiego nie istniało w moim świecie -"}
{"category": "LocationDialogue Location3", "line_index": 137, "text": "do momentu aż nie dodali ich w którejś z aktualizacji."}
{"category": "LocationDialogue Location3", "line_index": 138, "text": "U ciebie jest dużo odbić?"}
{"category": "LocationDialogue Location3", "line_index": 139, "text": "W sensie, w twoim świecie?"}
{"category": "LocationDialogue Location3", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 141, "text": "No.. jest ich dużo."}
{"category": "LocationDialogue Location3", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 144, "text": "Czy pamiętasz"}
{"category": "LocationDialogue Location3", "line_index": 145, "text": "Te trzy rzeczy?"}
{"category": "LocationDialogue Location3", "line_index": 146, "text": "Te, które musiałeś położyć do skanowania?"}
{"category": "LocationDialogue Location3", "line_index": 147, "text": "Więc, em..."}
{"category": "LocationDialogue Location3", "line_index": 148, "text": "Te rzeczy,"}
{"category": "LocationDialogue Location3", "line_index": 149, "text": "związane są z tą wersją gry."}
{"category": "LocationDialogue Location3", "line_index": 150, "text": "Dlatego musiałeś ich użyć, żeby się tu dostać."}
{"category": "LocationDialogue Location3", "line_index": 151, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 152, "text": "// Movbile TV"}
{"category": "LocationDialogue Location3", "line_index": 153, "text": "Przecież to ten telewizor,"}
{"category": "LocationDialogue Location3", "line_index": 154, "text": "który ci kupiłem!"}
{"category": "LocationDialogue Location3", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 156, "text": "Nom!"}
{"category": "LocationDialogue Location3", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 158, "text": "Powiedziałaś mi,"}
{"category": "LocationDialogue Location3", "line_index": 159, "text": "że jest zepsuty."}
{"category": "LocationDialogue Location3", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 161, "text": "To dlatego, że chciałam zrobić ci"}
{"category": "LocationDialogue Location3", "line_index": 162, "text": "niespodziankę!"}
{"category": "LocationDialogue Location3", "line_index": 163, "text": "Powiedziałam ci malutkie kłamstewko,"}
{"category": "LocationDialogue Location3", "line_index": 164, "text": "ale to nieważne, w końcu dzięki temu tu jesteś."}
{"category": "LocationDialogue Location3", "line_index": 165, "text": "Teraz ten telewizor wyświetla informacje."}
{"category": "LocationDialogue Location3", "line_index": 166, "text": "I tak przy okazji..."}
{"category": "LocationDialogue Location3", "line_index": 167, "text": "Jest we mnie coś z inżyniera!"}
{"category": "LocationDialogue Location3", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 169, "text": "// School cloth"}
{"category": "LocationDialogue Location3", "line_index": 170, "text": "Co to jest?"}
{"category": "LocationDialogue Location3", "line_index": 171, "text": "Mundurek szkolny?"}
{"category": "LocationDialogue Location3", "line_index": 172, "text": "Po co ci on?"}
{"category": "LocationDialogue Location3", "line_index": 173, "text": "Chodzisz do szkoły?"}
{"category": "LocationDialogue Location3", "line_index": 174, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 175, "text": "Do szkoły?"}
{"category": "LocationDialogue Location3", "line_index": 176, "text": "Coś ty."}
{"category": "LocationDialogue Location3", "line_index": 177, "text": "Ale bardzo mi się podoba."}
{"category": "LocationDialogue Location3", "line_index": 178, "text": "Nie powiesz przecież, że nie wyglądam w nim słodko,"}
{"category": "LocationDialogue Location3", "line_index": 179, "text": "prawda?"}
{"category": "LocationDialogue Location3", "line_index": 180, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 181, "text": "// PC"}
{"category": "LocationDialogue Location3", "line_index": 182, "text": "Czy ten komputer działa?"}
{"category": "LocationDialogue Location3", "line_index": 183, "text": "Czy to tylko atrapa?"}
{"category": "LocationDialogue Location3", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 185, "text": "Oczywiście, że działa."}
{"category": "LocationDialogue Location3", "line_index": 186, "text": "Wszystko tutaj"}
{"category": "LocationDialogue Location3", "line_index": 187, "text": "Działa jak w twoim świecie."}
{"category": "LocationDialogue Location3", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 189, "text": "W moim świecie, co?"}
{"category": "LocationDialogue Location3", "line_index": 190, "text": "Spędzałem tam dużo czasu przed komputerem..."}
{"category": "LocationDialogue Location3", "line_index": 191, "text": "Bardzo ciężko pracowałem..."}
{"category": "LocationDialogue Location3", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 193, "text": "Wiem."}
{"category": "LocationDialogue Location3", "line_index": 194, "text": "To właśnie przez twoją pracę,"}
{"category": "LocationDialogue Location3", "line_index": 195, "text": "spędzałeś ze mną"}
{"category": "LocationDialogue Location3", "line_index": 196, "text": "tak mało czasu."}
{"category": "LocationDialogue Location3", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 198, "text": "No, wiesz, za coś trzeba żyć..."}
{"category": "LocationDialogue Location3", "line_index": 199, "text": "W sumie... skąd o tym wszystkim wiesz?"}
{"category": "LocationDialogue Location3", "line_index": 200, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 201, "text": "Twoja kamerka w telefonie... czasami była włączona."}
{"category": "LocationDialogue Location3", "line_index": 202, "text": "Przepraszam."}
{"category": "LocationDialogue Location3", "line_index": 203, "text": "Zdarzało mi się czasem zerknąć..."}
{"category": "LocationDialogue Location3", "line_index": 204, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 205, "text": "Emm... to niezbyt legalne."}
{"category": "LocationDialogue Location3", "line_index": 206, "text": "No ale nieważne."}
{"category": "LocationDialogue Location3", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 208, "text": "// Umbrella"}
{"category": "LocationDialogue Location3", "line_index": 209, "text": "Spędziłem w tej grze tonę czasu,"}
{"category": "LocationDialogue Location3", "line_index": 210, "text": "ale nigdy nie widziałem, żeby padał deszcz."}
{"category": "LocationDialogue Location3", "line_index": 211, "text": "Więc po co ci parasol?"}
{"category": "LocationDialogue Location3", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 213, "text": "Deszcz pada, ale bardzo rzadko."}
{"category": "LocationDialogue Location3", "line_index": 214, "text": "Po prostu go jeszcze nie widziałeś."}
{"category": "LocationDialogue Location3", "line_index": 215, "text": "Może kiedyś go zobaczysz."}
{"category": "LocationDialogue Location3", "line_index": 216, "text": "A wtedy na pewno przyda ci się parasol."}
{"category": "LocationDialogue Location3", "line_index": 217, "text": "Czyż nie?"}
{"category": "LocationDialogue Location3", "line_index": 218, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 219, "text": "// Electrical panel"}
{"category": "LocationDialogue Location3", "line_index": 220, "text": "Skrzynka z bezpiecznikami?"}
{"category": "LocationDialogue Location3", "line_index": 221, "text": "Przecież jesteśmy w grze,"}
{"category": "LocationDialogue Location3", "line_index": 222, "text": "to po co ci ona?"}
{"category": "LocationDialogue Location3", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 224, "text": "No właśnie,"}
{"category": "LocationDialogue Location3", "line_index": 225, "text": "jesteśmy W GRZE."}
{"category": "LocationDialogue Location3", "line_index": 226, "text": "Więc pytanie, po co..."}
{"category": "LocationDialogue Location3", "line_index": 227, "text": "Jest bez sensu."}
{"category": "LocationDialogue Location3", "line_index": 228, "text": "Co nie oznacza, że nic nie robią."}
{"category": "LocationDialogue Location3", "line_index": 229, "text": "Możemy tutaj zresetować bezpieczniki."}
{"category": "LocationDialogue Location3", "line_index": 230, "text": "Wszystko tutaj działa,"}
{"category": "LocationDialogue Location3", "line_index": 231, "text": "jak w twoim świecie."}
{"category": "LocationDialogue Location3", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 233, "text": "// Exit door"}
{"category": "LocationDialogue Location3", "line_index": 234, "text": "Może wyjdziemy na zewnątrz?"}
{"category": "LocationDialogue Location3", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 236, "text": "Emm..."}
{"category": "LocationDialogue Location3", "line_index": 237, "text": "Jeszcze nie."}
{"category": "LocationDialogue Location3", "line_index": 238, "text": "Może później."}
{"category": "LocationDialogue Location3", "line_index": 239, "text": "Na razie zostańmy tutaj."}
{"category": "LocationDialogue Location3", "line_index": 240, "text": "W końcu nie ma to jak w domu, nie?"}
{"category": "LocationDialogue Location3", "line_index": 241, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 242, "text": "// Books"}
{"category": "LocationDialogue Location3", "line_index": 243, "text": "Masz tutaj masę książek."}
{"category": "LocationDialogue Location3", "line_index": 244, "text": "Przeczytałaś je wszystkie?"}
{"category": "LocationDialogue Location3", "line_index": 245, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 246, "text": "Tak, każdą jedną z nich."}
{"category": "LocationDialogue Location3", "line_index": 247, "text": "Ciągle jestem tu sama..."}
{"category": "LocationDialogue Location3", "line_index": 248, "text": "Jest strasznie, ale to strasznie nudno."}
{"category": "LocationDialogue Location3", "line_index": 249, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 250, "text": "// TV in room kitchen"}
{"category": "LocationDialogue Location3", "line_index": 251, "text": "Po co ci drugi telewizor?"}
{"category": "LocationDialogue Location3", "line_index": 252, "text": "I to jeszcze taki stary?"}
{"category": "LocationDialogue Location3", "line_index": 253, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 254, "text": "Nie podoba ci się?"}
{"category": "LocationDialogue Location3", "line_index": 255, "text": "Jeśli chcesz, mogę go zabrać..."}
{"category": "LocationDialogue Location3", "line_index": 256, "text": "Ale jak już musisz wiedzieć..."}
{"category": "LocationDialogue Location3", "line_index": 257, "text": "To służy on do dekoracji,"}
{"category": "LocationDialogue Location3", "line_index": 258, "text": "urozmaica to wyposażenie kuchni."}
{"category": "LocationDialogue Location3", "line_index": 259, "text": "A przy okazji działa!"}
{"category": "LocationDialogue Location3", "line_index": 260, "text": "Mogę oglądać na nim"}
{"category": "LocationDialogue Location3", "line_index": 261, "text": "stare kreskówki!"}
{"category": "LocationDialogue Location3", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 263, "text": "// Smartphone"}
{"category": "LocationDialogue Location3", "line_index": 264, "text": "Czy to czasem nie mój telefon?"}
{"category": "LocationDialogue Location3", "line_index": 265, "text": "Przecież miałem go w kieszeni!"}
{"category": "LocationDialogue Location3", "line_index": 266, "text": "Skąd on się tu u licha wziął?"}
{"category": "LocationDialogue Location3", "line_index": 267, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 268, "text": "Emm, to nie jest ważne..."}
{"category": "LocationDialogue Location3", "line_index": 269, "text": "Mam pomysł!"}
{"category": "LocationDialogue Location3", "line_index": 270, "text": "Zróbmy sobie razem zdjęcie!"}
{"category": "LocationDialogue Location3", "line_index": 271, "text": "Patrz!"}
{"category": "LocationDialogue Location3", "line_index": 272, "text": "Świetnie wyszedłeś!"}
{"category": "LocationDialogue Location3", "line_index": 273, "text": "To dla ciebie, na pamiątkę."}
{"category": "LocationDialogue Location3", "line_index": 274, "text": "// Gracz"}
{"category": "LocationDialogue Location3", "line_index": 275, "text": "Mam pytanie."}
{"category": "LocationDialogue Location3", "line_index": 276, "text": "Czy jeśli..."}
{"category": "LocationDialogue Location3", "line_index": 277, "text": "włączę w nim grę,"}
{"category": "LocationDialogue Location3", "line_index": 278, "text": "będę w stanie cię w niej zobaczyć?"}
{"category": "LocationDialogue Location3", "line_index": 279, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 280, "text": "Nie, to tak nie działa."}
{"category": "LocationDialogue Location3", "line_index": 281, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 282, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 283, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 284, "text": "// TV"}
{"category": "LocationDialogue Location3", "line_index": 285, "text": "Ten telewizor działa?"}
{"category": "LocationDialogue Location3", "line_index": 286, "text": "Ile masz kanałów?"}
{"category": "LocationDialogue Location3", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 288, "text": "To działa troszkę inaczej..."}
{"category": "LocationDialogue Location3", "line_index": 289, "text": "Mam na nim dostęp do internetu."}
{"category": "LocationDialogue Location3", "line_index": 290, "text": "Dzięki temu możemy oglądać wszystko,"}
{"category": "LocationDialogue Location3", "line_index": 291, "text": "co jest dostępne w sieci."}
{"category": "LocationDialogue Location3", "line_index": 292, "text": "Czekaj moment,"}
{"category": "LocationDialogue Location3", "line_index": 293, "text": "Emm, ups."}
{"category": "LocationDialogue Location3", "line_index": 294, "text": "Co to jest?"}
{"category": "LocationDialogue Location3", "line_index": 295, "text": "Kotki w kółku?"}
{"category": "LocationDialogue Location3", "line_index": 296, "text": "O, patrz!"}
{"category": "LocationDialogue Location3", "line_index": 297, "text": "A wiesz co?"}
{"category": "LocationDialogue Location3", "line_index": 298, "text": "Momencik!"}
{"category": "LocationDialogue Location3", "line_index": 299, "text": "Chcesz trochę soku?"}
{"category": "LocationDialogue Location3", "line_index": 300, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 301, "text": "Dziwne są te reklamy..."}
{"category": "LocationDialogue Location3", "line_index": 302, "text": "Sok umarł?"}
{"category": "LocationDialogue Location3", "line_index": 303, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 304, "text": "Tak, i ten sok..."}
{"category": "LocationDialogue Location3", "line_index": 305, "text": "jest z soku!"}
{"category": "LocationDialogue Location3", "line_index": 306, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 308, "text": "Mm, ten smak..."}
{"category": "LocationDialogue Location3", "line_index": 309, "text": "Podoba mi się,"}
{"category": "LocationDialogue Location3", "line_index": 310, "text": "jednak ciężko powiedzieć, jak smakuje, czy nawet pachnie."}
{"category": "LocationDialogue Location3", "line_index": 311, "text": "Nie rozumiem, jak to działa..."}
{"category": "LocationDialogue Location3", "line_index": 312, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 313, "text": "Dobra..."}
{"category": "LocationDialogue Location3", "line_index": 314, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 315, "text": "// Mita shy"}
{"category": "LocationDialogue Location3", "line_index": 316, "text": "Co robisz?"}
{"category": "LocationDialogue Location3", "line_index": 317, "text": "Nie patrz się tak na mnie..."}
{"category": "LocationDialogue Location3", "line_index": 318, "text": "Zawstydzasz mnie."}
{"category": "LocationDialogue Location3", "line_index": 319, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 320, "text": "// The statuette"}
{"category": "LocationDialogue Location3", "line_index": 321, "text": "Co za straszna figurka."}
{"category": "LocationDialogue Location3", "line_index": 322, "text": "Czy"}
{"category": "LocationDialogue Location3", "line_index": 323, "text": "podobają ci się takie rzeczy?"}
{"category": "LocationDialogue Location3", "line_index": 324, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 325, "text": "Przeraża cię?"}
{"category": "LocationDialogue Location3", "line_index": 326, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 327, "text": "Trochę."}
{"category": "LocationDialogue Location3", "line_index": 328, "text": "Wygląda jak jakaś nawiedzona..."}
{"category": "LocationDialogue Location3", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 330, "text": "No.. Na pewno nie jest nawiedzona."}
{"category": "LocationDialogue Location3", "line_index": 331, "text": "A tym bardziej straszna."}
{"category": "LocationDialogue Location3", "line_index": 332, "text": "Według mnie – jest urocza!"}
{"category": "LocationDialogue Location3", "line_index": 333, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 334, "text": "Może i masz rację..."}
{"category": "LocationDialogue Location3", "line_index": 335, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 336, "text": "Mita?"}
{"category": "LocationDialogue Location3", "line_index": 337, "text": "Co się dzieje?"}
{"category": "LocationDialogue Location3", "line_index": 338, "text": "// Mita kitchen"}
{"category": "LocationDialogue Location3", "line_index": 339, "text": "Zanim zaczniemy jeść,"}
{"category": "LocationDialogue Location3", "line_index": 340, "text": "może trochę pogadamy?"}
{"category": "LocationDialogue Location3", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 342, "text": "// Start Eat"}
{"category": "LocationDialogue Location3", "line_index": 343, "text": "Smacznego!"}
{"category": "LocationDialogue Location3", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 345, "text": "// Quest 1"}
{"category": "LocationDialogue Location3", "line_index": 346, "text": "Prawda?"}
{"category": "LocationDialogue Location3", "line_index": 347, "text": "Jeśli chcesz, możesz zostać."}
{"category": "LocationDialogue Location3", "line_index": 348, "text": "Nie przeszkadza mi to."}
{"category": "LocationDialogue Location3", "line_index": 349, "text": "A tak właściwie..."}
{"category": "LocationDialogue Location3", "line_index": 350, "text": "JESTEM NA TAK!"}
{"category": "LocationDialogue Location3", "line_index": 351, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 352, "text": "// Quest 2"}
{"category": "LocationDialogue Location3", "line_index": 353, "text": "Chcesz wracać?"}
{"category": "LocationDialogue Location3", "line_index": 354, "text": "Ale czemu?"}
{"category": "LocationDialogue Location3", "line_index": 355, "text": "Przecież tu jest tak miło..."}
{"category": "LocationDialogue Location3", "line_index": 356, "text": "I przytulnie..."}
{"category": "LocationDialogue Location3", "line_index": 357, "text": "A na dodatek jestem tu ja!"}
{"category": "LocationDialogue Location3", "line_index": 358, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 359, "text": "Nie rozumiesz."}
{"category": "LocationDialogue Location3", "line_index": 360, "text": "Bardzo chciałbym zostać."}
{"category": "LocationDialogue Location3", "line_index": 361, "text": "Po prostu.... martwię się."}
{"category": "LocationDialogue Location3", "line_index": 362, "text": "Martwię się, że zostawiłem coś ważnego w domu..."}
{"category": "LocationDialogue Location3", "line_index": 363, "text": "Nie miałem nawet czasu,"}
{"category": "LocationDialogue Location3", "line_index": 364, "text": "aby się przygotować."}
{"category": "LocationDialogue Location3", "line_index": 365, "text": "Pojawiłem się tutaj tak nagle."}
{"category": "LocationDialogue Location3", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 367, "text": "Przepraszam.... Nie pomyślałam o tym."}
{"category": "LocationDialogue Location3", "line_index": 368, "text": "// Quest 3"}
{"category": "LocationDialogue Location3", "line_index": 369, "text": "Śnie? Czyli chcesz się z niego obudzić?"}
{"category": "LocationDialogue Location3", "line_index": 370, "text": "I... szybko o nim zapomnieć?"}
{"category": "LocationDialogue Location3", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 372, "text": "Nie o to chodzi."}
{"category": "LocationDialogue Location3", "line_index": 373, "text": "To miejsce wydaje się takie..."}
{"category": "LocationDialogue Location3", "line_index": 374, "text": "Dziwne. Nienaturalne."}
{"category": "LocationDialogue Location3", "line_index": 375, "text": "Ale ty..."}
{"category": "LocationDialogue Location3", "line_index": 376, "text": "Ty wydajesz się taka prawdziwa."}
{"category": "LocationDialogue Location3", "line_index": 377, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 378, "text": "Wydaję się?"}
{"category": "LocationDialogue Location3", "line_index": 379, "text": "Ja JESTEM prawdziwa,"}
{"category": "LocationDialogue Location3", "line_index": 380, "text": "głupol!"}
{"category": "LocationDialogue Location3", "line_index": 381, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 382, "text": "// Quest 4"}
{"category": "LocationDialogue Location3", "line_index": 383, "text": "W tym świecie"}
{"category": "LocationDialogue Location3", "line_index": 384, "text": "Po prostu tak już jest."}
{"category": "LocationDialogue Location3", "line_index": 385, "text": "Może cię to zaskoczy,"}
{"category": "LocationDialogue Location3", "line_index": 386, "text": "ale jeśli spojrzysz przez okno,"}
{"category": "LocationDialogue Location3", "line_index": 387, "text": "to nic nie zobaczysz."}
{"category": "LocationDialogue Location3", "line_index": 388, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 389, "text": "W sumie nie jest tak źle."}
{"category": "LocationDialogue Location3", "line_index": 390, "text": "Nawet mi to pasuje."}
{"category": "LocationDialogue Location3", "line_index": 391, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 392, "text": "Też tak uważam!"}
{"category": "LocationDialogue Location3", "line_index": 393, "text": "Wydaję mi się, że to wszystko po to, aby uniknąć lagów."}
{"category": "LocationDialogue Location3", "line_index": 394, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 395, "text": "Lagów?"}
{"category": "LocationDialogue Location3", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 397, "text": "Mhm, niestety. Występują tu różne błędy."}
{"category": "LocationDialogue Location3", "line_index": 398, "text": "Mam nadzieję, że na żaden nie trafimy."}
{"category": "LocationDialogue Location3", "line_index": 399, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 400, "text": "// Quest 5"}
{"category": "LocationDialogue Location3", "line_index": 401, "text": "Czemu nie użyłam noża?"}
{"category": "LocationDialogue Location3", "line_index": 402, "text": "Mogłam to zrobić."}
{"category": "LocationDialogue Location3", "line_index": 403, "text": "Ale chciałam, żeby wszystko było"}
{"category": "LocationDialogue Location3", "line_index": 404, "text": "zapięte na ostatni guzik."}
{"category": "LocationDialogue Location3", "line_index": 405, "text": "Przygotowane specjalnie dla ciebie."}
{"category": "LocationDialogue Location3", "line_index": 406, "text": "Uwielbiam cię zaskakiwać."}
{"category": "LocationDialogue Location3", "line_index": 407, "text": "Na szczęście przygotowania nie były zbyt długie!"}
{"category": "LocationDialogue Location3", "line_index": 408, "text": "Hii-hii."}
{"category": "LocationDialogue Location3", "line_index": 409, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 410, "text": "// Glasses"}
{"category": "LocationDialogue Location3", "line_index": 411, "text": "Nosisz okulary?"}
{"category": "LocationDialogue Location3", "line_index": 412, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 413, "text": "Nie."}
{"category": "LocationDialogue Location3", "line_index": 414, "text": "Ale mogę je założyć, jeśli chcesz."}
{"category": "LocationDialogue Location3", "line_index": 415, "text": "I jak, pasują mi?"}
{"category": "LocationDialogue Location3", "line_index": 416, "text": "// Yes"}
{"category": "LocationDialogue Location3", "line_index": 417, "text": "Naprawdę?"}
{"category": "LocationDialogue Location3", "line_index": 418, "text": "W takim razie je zostawię."}
{"category": "LocationDialogue Location3", "line_index": 419, "text": "// No"}
{"category": "LocationDialogue Location3", "line_index": 420, "text": "Nie...?"}
{"category": "LocationDialogue Location3", "line_index": 421, "text": "No nic..."}
{"category": "LocationDialogue Location3", "line_index": 422, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 423, "text": "// Use the sauce"}
{"category": "LocationDialogue Location3", "line_index": 424, "text": "Jasne,"}
{"category": "LocationDialogue Location3", "line_index": 425, "text": "a co to za sos?"}
{"category": "LocationDialogue Location3", "line_index": 426, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 427, "text": "To płynna miłość!"}
{"category": "LocationDialogue Location3", "line_index": 428, "text": "Wypełnia cię uczuciem,"}
{"category": "LocationDialogue Location3", "line_index": 429, "text": "i... daje ciekawe spojrzenie na świat."}
{"category": "LocationDialogue Location3", "line_index": 430, "text": "Ciekawe, nieprawdaż?"}
{"category": "LocationDialogue Location3", "line_index": 431, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 432, "text": "No pewnie..."}
{"category": "LocationDialogue Location3", "line_index": 433, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 434, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location3", "line_index": 435, "text": "To twoja konsolka?"}
{"category": "LocationDialogue Location3", "line_index": 436, "text": "Ale fajna!"}
