{"category": "LocationDialogue Location8", "line_index": 0, "text": "// The first meeting"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "Who are you?"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "What happened to you?"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "Can you speak?"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "Wait..."}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "Are you leaving?"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "Yes."}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "I need to get"}
{"category": "LocationDialogue Location8", "line_index": 11, "text": "to an earlier version..."}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "An earlier version?"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "Why would you go"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "anywhere else?"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "You can just stay here..."}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "And become"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "my second friend..."}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Skipping all dialogs"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "I see..."}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Standing by the window (Random)"}
{"category": "LocationDialogue Location8", "line_index": 24, "text": "The doors aren't the way out."}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "You're in a hurry..."}
{"category": "LocationDialogue Location8", "line_index": 26, "text": "Running in circles won't save you."}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "You want to leave that much?"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "Look outside..."}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Aren't you Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "Player... you're a player, aren't you?"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": "Would you play with me?"}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "If I can find the strength,"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": "I would really like to play..."}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (What happened to you?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "I'm not sure... I don't know."}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "I don't think anything bad has happened..."}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "But everything good seems to be slipping away..."}
{"category": "LocationDialogue Location8", "line_index": 41, "text": "At least I still have a friend."}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "All the other players are gone now..."}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "Did I make them go away...?"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "I'm scared..."}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Your second friend?"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "Friends..."}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "They're all going away..."}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "Only one remains..."}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "I'm sad, player."}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "Will you be my new friend?"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "I'd love to,"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "but I have to keep going..."}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "But why...? My heart aches..."}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Is this your house?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "Home?"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "Player... You've changed..."}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "Your arms are shorter, and your face isn't as angry..."}
{"category": "LocationDialogue Location8", "line_index": 62, "text": "Player, you've grown softer, kinder."}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "I..."}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "don't know what you're talking about..."}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "It's okay..."}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "Nobody will hurt me anymore, right?"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (How do I leave this place?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "Are you really leaving me?"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "Is this just..."}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "my fate?"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "I..."}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": "The doors won't help you."}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Hold player (Random)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "Why are you leaving?"}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "Stay here..."}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "Let's play..."}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "Hey, player..."}
