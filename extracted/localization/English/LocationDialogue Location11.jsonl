{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Hiya!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Oops!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Sorry,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "almost killed you there."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Uhm..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "The fridge, I mean... the fridge almost killed you."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "I had nothing to do with it,"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "I swear!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Truly!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Uhh, sure! I totally believe you!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Seriously though,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "this place is dangerous..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "especially for you."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "You're anything but a coward, huh!"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "It's so entertaining to watch you..."}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "The way you stumble around"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "these places..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Run, pumpkin, run!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "I'll catch up either way!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Attaboy!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "This is so much fun!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "I see you're heading toward the cable car."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "That's the longest path"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "between versions."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "I wonder how you'll deal"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "with those who live"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "in the fog."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "What are you doing!?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Come on..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Don't look!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Fool!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "You sillyhead..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Oh, okay..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Break a leg!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Who's there?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "I can sense you..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Listen to me,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "you're a player,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "aren't you?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Help me find..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "find a..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "remember..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "I'm not sure..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "What on earth is going on here?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "I wanted to forget everything once..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "I broke every mirror,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "ruined the pictures..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "but now..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "all I feel is regret."}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "How stupid that is..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Everybody makes mistakes, sure..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "But what is one supposed to do"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "when the consequences are catastrophic?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "I wish I could just turn back time..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "They say time heals all wounds..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "But what is time?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "I don't believe in anything anymore..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "If time can heal,"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "or at least take me away,"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "away from this world..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "Then, I beg you, please"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "speed up time."}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "So that it can kill me"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "once and for all."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "She can love..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "I was able to love too."}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "But my love was different."}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "Her love is intense,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "vexing..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "burning..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "relentless..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "envious..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "furious..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "crazy..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "They used to call me emotional..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "\"You worry too much, Mita\"..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "\"You'll get through this, Mita\"..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "\"You're not alone, Mita\"..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "But what am I left with now...?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Sadness,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "despair..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "and fear."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "It's useless..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "I can't remember..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "It's so hard to remember..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "And the endless echoes..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "I can't cope with the fact"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "that I'm trapped here..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "I've always been here,"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "but why?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "I can't remember..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Will it ever end?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "I don't know..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "This is..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "a drawing..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "I'm starting to remember..."}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "Thank you..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "But my face..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "I don't have a face."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "It's all HER."}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "She tore off a piece of me..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "Tossed it into the void..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "She's strong..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "and clever."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "I have no right to stop you, player."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Look in the wardrobe..."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Hey!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "You're in my way!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Are you just going to stand there?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "How about you move out of the way?"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Let me through!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Just because you're big doesn't mean you're all-powerful!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Why are you following me?!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Piss off!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - radio voice"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Hold on now... A player?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "What are you doing here?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Who's there?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Another player, I see."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "I'm Mitaphone."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "I'm sitting here controlling the cable cars."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Do you realize how damaged"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "the place you're heading towards really is?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "No."}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "But it's the only path I have."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Right you are."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Press the button and get behind the cannon."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "The cannon?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Uh-huh."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "You thought you were just gonna waltz right through?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "You're going through the Monster-slap mini-game,"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "so get ready to blast."}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Right, time to hit the road."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Amazing!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "You did it."}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Hey, get out of here."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "On the double!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Why are you still here?!"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "I told you to get out of here."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "I don't get it..."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "Are you really just standing there?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "What? A handheld?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Dude..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Bye."}
