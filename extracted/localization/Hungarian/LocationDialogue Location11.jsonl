{"category": "LocationDialogue Location11", "line_index": 0, "text": "﻿"}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Halihó!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Hoppá!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Bocsi,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "majdnem megöltelek."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Akarom mondani..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "A hűtő... a hűtő ölt meg téged majdnem."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Így igaz, nem csináltam semmit."}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "Semmi közöm sincs"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "a hűtőhöz!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Aham, persze."}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "De tényleg,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "veszélyes ez a hely."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "Főleg a magadfajtáknak."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "Te aztán tényleg vakmerő vagy!"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Olyan jó nézni,"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "ahogy pályáról pályára"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "szenveded magad át..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "„Szállj, kismadár,”"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "„Nézd meg, hogy merre jár!”"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Bármerre mész,"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "én megtalállak!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Látom, a vonatok felé vetted az irányt."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "Az az egyik leghosszabb"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "út a verziók között..."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Kíváncsi vagyok, túl fogod-e"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "élni azt a vonatutat..."}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "Ki tudja, mi bújik meg a ködben..."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Hol van a szemed?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "De most komolyan!"}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Ez nem vicces!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Hagyd abba!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Te butus disznó...!"}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Hát jó..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Kéz és lábtörést!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Ki van ott?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Érzem az aurád..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Te..."}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "te egy játékos vagy,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "nem?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Segíts nekem..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "Keresek egy..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "egy..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "Nem tudom..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Üres az elmém..."}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Mindent el akartam felejteni..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "A tükröket is tönkretettem,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "a képeket is széttéptem,"}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "de a végére..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "nagyon megbántam mindent..."}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "Olyan hülye vagyok..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "„Mindenki követ el hibákat,” való igaz..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "de mihez kezdjek akkor,"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "ha a következmény visszafordíthatatlan?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Bárcsak visszamehetnék az időben..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Azt mondják, hogy idővel minden jobb lesz..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Mennyi az az idő?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Nem hiszek többé az ilyenekben..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "De ha tényleg igaz,"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "Ha tényleg csak..."}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "időre lenne szükségem..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "Akkor könyörgök,"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "hadd gyorsuljon fel az az idő..."}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "Így gyorsabban megöregedhetnék,"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "és végre meghalhatok..."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Ő szeret másokat."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Én szerettem valakit?"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Az ő szeretete más volt;"}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "Élénk,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "megvetendő..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "lángoló..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "könyörtelen..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "irigyelhető..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "dühös..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "tébolyult..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Azt mondták sokat sírok..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "„Ne aggódj, Mita...”"}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "„Minden rendben lesz, Mita...”"}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "„Nem vagy egyedül, Mita...”"}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "De mi maradt meg?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "A bánat..."}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "letörtség..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "és a félelem..."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Mihaszna..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Nem megy..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "Nem emlékszek semmire sem..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Mihaszna vagyok..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Örökre itt ragadtam,"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "és ezt muszáj elfogadnom..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Mindig is itt voltam,"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "de miért?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Nem emlékszem..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Mikor lesz ennek vége?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Nem bírom tovább..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Ez egy..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "rajz?"}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Most már emlékszem..."}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "köszönöm..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "De az arcom..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "Nincs arcom..."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "Mind miatta van..."}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Elvett egy darabot belőlem..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "és azt eldobta..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Ő erős,"}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "túl jár mindenki eszén."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Én nem állíthatlak meg téged, játékos."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Kérlek, nézz bele a szekrénybe."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Hé!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "El az útból!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Nem mozdulsz el innét?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Nem állok jót magamért!"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Félre!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Attól még hogy magas vagy, nem jelenti azt, hogy erős is."}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Ne kövess már!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Kopj le!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - radio voice"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Egy pillanat... Egy játékos?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "Mit keresel itt, játékos?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Ki van ott?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Üdv, játékos."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Mitafon vagyok."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Én irányítom az itteni kocsit."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Ugye tudod,"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "hogy ez a vonat egyenesen a pokolba megy?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "De sajnos"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "nincs más választásom."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Ahogy mondod."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Nyomd meg a gombot, és állj az ágyú mögé."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "Ágyú?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Pff, persze!"}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Azt hitted, hogy csak úgy hátradölhetsz?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Tele van a pálya szörnyekkel."}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "Szóval légy résen!"}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Akkor guruljunk!"}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Ügyi voltál!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Megcsináltad!"}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Na, most szedd a lábad,"}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "és tünés innen!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Mit ácsorogsz még itt?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Azt mondtam, hogy el innen!"}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Még mindig itt vagy?"}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "Nem megmondtam, hogy ne is lássalak?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Most... komolyan Tetriszezel?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Butuska..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Legyen biztonságos napod."}
