{"category": "LocationDialogue Location13", "line_index": 0, "text": "﻿"}
{"category": "LocationDialogue Location13", "line_index": 1, "text": "A gyűrűd!"}
{"category": "LocationDialogue Location13", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 3, "text": "// Answer 1 (Where have you been all this time?)"}
{"category": "LocationDialogue Location13", "line_index": 4, "text": "A lehető legrövidebb utat próbáltam keresni neked,"}
{"category": "LocationDialogue Location13", "line_index": 5, "text": "hogy épségben a Maghoz érhess."}
{"category": "LocationDialogue Location13", "line_index": 6, "text": "Ez volt a terv, nem?"}
{"category": "LocationDialogue Location13", "line_index": 7, "text": "Téboly-Mitát mindenáron megkerülni,"}
{"category": "LocationDialogue Location13", "line_index": 8, "text": "mindent megtudni e világ működéséről,"}
{"category": "LocationDialogue Location13", "line_index": 9, "text": "túlélni..."}
{"category": "LocationDialogue Location13", "line_index": 10, "text": "Nem?"}
{"category": "LocationDialogue Location13", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 12, "text": "Hát..."}
{"category": "LocationDialogue Location13", "line_index": 13, "text": "Szerintem nem üzemelt rendesen a gyűrű."}
{"category": "LocationDialogue Location13", "line_index": 14, "text": "A folyosó ajtaja... ugyanoda hozott vissza,"}
{"category": "LocationDialogue Location13", "line_index": 15, "text": "nem tudtam megmenekülni."}
{"category": "LocationDialogue Location13", "line_index": 16, "text": "Az ajtók nem tettek semmit,"}
{"category": "LocationDialogue Location13", "line_index": 17, "text": "így kitörtem az ablakot, és onnan leugrottam."}
{"category": "LocationDialogue Location13", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 19, "text": "Ne haragudj, nem igazán részleteztem,"}
{"category": "LocationDialogue Location13", "line_index": 20, "text": "hogy a folyosón belül hova tovább."}
{"category": "LocationDialogue Location13", "line_index": 21, "text": "Az volt a terv,"}
{"category": "LocationDialogue Location13", "line_index": 22, "text": "hogy azon az ablakon"}
{"category": "LocationDialogue Location13", "line_index": 23, "text": "ugrasz ki."}
{"category": "LocationDialogue Location13", "line_index": 24, "text": "És látom, sikerült neked! Ügyi vagy!"}
{"category": "LocationDialogue Location13", "line_index": 25, "text": "Innentől könnyű dolgunk lesz."}
{"category": "LocationDialogue Location13", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 27, "text": "// Answer 2 (How did you get here?)"}
{"category": "LocationDialogue Location13", "line_index": 28, "text": "Én az a Mita vagyok,"}
{"category": "LocationDialogue Location13", "line_index": 29, "text": "amelyik különböző verziókon át tud mozogni."}
{"category": "LocationDialogue Location13", "line_index": 30, "text": "Nem emlékszel?"}
{"category": "LocationDialogue Location13", "line_index": 31, "text": "Sok mindenen mehettél keresztül, hogy ezt elfelejtsd."}
{"category": "LocationDialogue Location13", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 33, "text": "Ezt nem tudja minden Mita, igaz?"}
{"category": "LocationDialogue Location13", "line_index": 34, "text": "Láttam olyan Mitákat,"}
{"category": "LocationDialogue Location13", "line_index": 35, "text": "akik menekülni akartak, de nem tudtak."}
{"category": "LocationDialogue Location13", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 37, "text": "Az ő verziójuk meg lettek rongálva,"}
{"category": "LocationDialogue Location13", "line_index": 38, "text": "a világuk nem funkcionáltak. Ezt mind már elmondtam."}
{"category": "LocationDialogue Location13", "line_index": 39, "text": "Szegények..."}
{"category": "LocationDialogue Location13", "line_index": 40, "text": "Azt legalább tudod, hogy ki állhat emögött?"}
{"category": "LocationDialogue Location13", "line_index": 41, "text": "Téboly-Mita."}
{"category": "LocationDialogue Location13", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 43, "text": "Igen, mindenképpen ő."}
{"category": "LocationDialogue Location13", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 45, "text": "// Answer 3 (Who was this Mita just now?)"}
{"category": "LocationDialogue Location13", "line_index": 46, "text": "Ő volt Rusnya-Mita."}
{"category": "LocationDialogue Location13", "line_index": 47, "text": "Egy erőszakos, bumburnyák változata a Mitáknak."}
{"category": "LocationDialogue Location13", "line_index": 48, "text": "Nincs ki éppen mind a négy kereke,"}
{"category": "LocationDialogue Location13", "line_index": 49, "text": "és csak Téboly-Mitára hallgat."}
{"category": "LocationDialogue Location13", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 51, "text": "Észrevettem."}
{"category": "LocationDialogue Location13", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 53, "text": "Gyerünk, el kell jutnunk a Maghoz."}
{"category": "LocationDialogue Location13", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 55, "text": "// Answer 4 (How does the ring work?)"}
{"category": "LocationDialogue Location13", "line_index": 56, "text": "Csak a gyűrűvel"}
{"category": "LocationDialogue Location13", "line_index": 57, "text": "juthattam ide a Maghoz?"}
{"category": "LocationDialogue Location13", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 59, "text": "Igen."}
{"category": "LocationDialogue Location13", "line_index": 60, "text": "Vagyis, ha a portál"}
{"category": "LocationDialogue Location13", "line_index": 61, "text": "működött volna,"}
{"category": "LocationDialogue Location13", "line_index": 62, "text": "seperc alatt ide érhettünk volna."}
{"category": "LocationDialogue Location13", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 64, "text": "Tud mást is a gyűrű?"}
{"category": "LocationDialogue Location13", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 66, "text": "Hát persze!"}
{"category": "LocationDialogue Location13", "line_index": 67, "text": "Megjegyzi azokat a verziókat,"}
{"category": "LocationDialogue Location13", "line_index": 68, "text": "ahová eddig jártál,"}
{"category": "LocationDialogue Location13", "line_index": 69, "text": "és simán visszajuthatsz oda."}
{"category": "LocationDialogue Location13", "line_index": 70, "text": "És kényelmes hordani."}
{"category": "LocationDialogue Location13", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 72, "text": "// Answer 5 (Why does Mad Mita need me?)"}
{"category": "LocationDialogue Location13", "line_index": 73, "text": "Mi rosszat tettem Téboly-Mitának?"}
{"category": "LocationDialogue Location13", "line_index": 74, "text": "Életveszélynek tett ki engem a tébolyult játékaival,"}
{"category": "LocationDialogue Location13", "line_index": 75, "text": "ahelyett, hogy azonnal megöljön engem."}
{"category": "LocationDialogue Location13", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 77, "text": "Arra tippelek,"}
{"category": "LocationDialogue Location13", "line_index": 78, "text": "hogy egy olyan játékos után kutat,"}
{"category": "LocationDialogue Location13", "line_index": 79, "text": "aki elfogadja őt, olyannak, amilyen."}
{"category": "LocationDialogue Location13", "line_index": 80, "text": "Mivel Mita egy... Mita,"}
{"category": "LocationDialogue Location13", "line_index": 81, "text": "nyilvánvalóan nem fog találni olyan játékost,"}
{"category": "LocationDialogue Location13", "line_index": 82, "text": "aki viszont szeretné őt,"}
{"category": "LocationDialogue Location13", "line_index": 83, "text": "ezért mindenkit kazettává alakít."}
{"category": "LocationDialogue Location13", "line_index": 84, "text": "Legalább is ez a teóriám."}
{"category": "LocationDialogue Location13", "line_index": 85, "text": "Na, koncentráljunk a lényegre!"}
{"category": "LocationDialogue Location13", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 87, "text": "// Answer 6 (Is this the core?)"}
{"category": "LocationDialogue Location13", "line_index": 88, "text": "Ez lenne az?"}
{"category": "LocationDialogue Location13", "line_index": 89, "text": "A Mag?"}
{"category": "LocationDialogue Location13", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 91, "text": "Igen, ez a Mag."}
{"category": "LocationDialogue Location13", "line_index": 92, "text": "Ti játékosokat nem a játék alkotta meg,"}
{"category": "LocationDialogue Location13", "line_index": 93, "text": "így szerintem gond nélkül be tudsz térni a kapun át."}
{"category": "LocationDialogue Location13", "line_index": 94, "text": "Vagyis azt hiszem, hogy ez így van."}
{"category": "LocationDialogue Location13", "line_index": 95, "text": "Én abban a hitben élek,"}
{"category": "LocationDialogue Location13", "line_index": 96, "text": "hogy minden problémánkra"}
{"category": "LocationDialogue Location13", "line_index": 97, "text": "itt leljük, ebben a szobában"}
{"category": "LocationDialogue Location13", "line_index": 98, "text": "a megoldást."}
{"category": "LocationDialogue Location13", "line_index": 99, "text": "[player], nyomás befelé."}
{"category": "LocationDialogue Location13", "line_index": 100, "text": "El se hiszem, hogy ide sikerült érned."}
{"category": "LocationDialogue Location13", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 102, "text": "// Look on CoreMita"}
{"category": "LocationDialogue Location13", "line_index": 103, "text": "Vigyázz, [player]."}
{"category": "LocationDialogue Location13", "line_index": 104, "text": "Téged figyel."}
{"category": "LocationDialogue Location13", "line_index": 105, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 106, "text": "Kicsoda?"}
{"category": "LocationDialogue Location13", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 108, "text": "Én se tudom..."}
{"category": "LocationDialogue Location13", "line_index": 109, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 110, "text": "Az jó..."}
{"category": "LocationDialogue Location13", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 113, "text": "Mit kér?"}
{"category": "LocationDialogue Location13", "line_index": 114, "text": "Na?"}
{"category": "LocationDialogue Location13", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 116, "text": "Szerintem megvan."}
{"category": "LocationDialogue Location13", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 118, "text": "Ügyi vagy!"}
{"category": "LocationDialogue Location13", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 120, "text": "De verziószámot kér."}
{"category": "LocationDialogue Location13", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 122, "text": "Máris mondom..."}
{"category": "LocationDialogue Location13", "line_index": 123, "text": "00.98."}
{"category": "LocationDialogue Location13", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 125, "text": "Tökéletes!"}
{"category": "LocationDialogue Location13", "line_index": 126, "text": "Karakterindex?"}
{"category": "LocationDialogue Location13", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 128, "text": "Hogy... index?"}
{"category": "LocationDialogue Location13", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 130, "text": "Az indexet is kéri."}
{"category": "LocationDialogue Location13", "line_index": 131, "text": "Vagy nem tudod?"}
{"category": "LocationDialogue Location13", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 134, "text": "Végülis van benne logika."}
{"category": "LocationDialogue Location13", "line_index": 135, "text": "Minden Mita rendelkezik külön indexszel."}
{"category": "LocationDialogue Location13", "line_index": 136, "text": "Nagy gondot okozna,"}
{"category": "LocationDialogue Location13", "line_index": 137, "text": "ha egy egész verziót állítanál vissza."}
{"category": "LocationDialogue Location13", "line_index": 138, "text": "Hogy erre miért nem gondoltam..."}
{"category": "LocationDialogue Location13", "line_index": 139, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 144, "text": "// Answer 1 (What's wrong with you?)"}
{"category": "LocationDialogue Location13", "line_index": 145, "text": "Jól, de most ne ezzel törődjünk."}
{"category": "LocationDialogue Location13", "line_index": 146, "text": "A slamasztikát kéne rendbe tenni."}
{"category": "LocationDialogue Location13", "line_index": 147, "text": "Azt hittem, sínen vagyunk..."}
{"category": "LocationDialogue Location13", "line_index": 148, "text": "Csak gondolkodni kell,"}
{"category": "LocationDialogue Location13", "line_index": 149, "text": "és minden rendben lesz."}
{"category": "LocationDialogue Location13", "line_index": 150, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 151, "text": "// Answer 2 (Maybe there's a way to get to know him?)"}
{"category": "LocationDialogue Location13", "line_index": 152, "text": "Most..."}
{"category": "LocationDialogue Location13", "line_index": 153, "text": "Komolyan?"}
{"category": "LocationDialogue Location13", "line_index": 154, "text": "Ez őrület!"}
{"category": "LocationDialogue Location13", "line_index": 155, "text": "Mintha egy szénában akarnád keresni..."}
{"category": "LocationDialogue Location13", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 157, "text": "Miről beszélsz?"}
{"category": "LocationDialogue Location13", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 159, "text": "A hibák extra információkat is kiszivárogtatnak…"}
{"category": "LocationDialogue Location13", "line_index": 160, "text": "Tudod, mint amikor részletesen átvizsgálunk egy világot..."}
{"category": "LocationDialogue Location13", "line_index": 161, "text": "Rendszernaplók, naplók, naplók, fontos adatok..."}
{"category": "LocationDialogue Location13", "line_index": 162, "text": "És mi van ha ebben rejlik a válasz?"}
{"category": "LocationDialogue Location13", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 164, "text": "Micsoda? Nem értek semmit."}
{"category": "LocationDialogue Location13", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 166, "text": "Tudok egy helyet."}
{"category": "LocationDialogue Location13", "line_index": 167, "text": "Itt várj!"}
{"category": "LocationDialogue Location13", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 169, "text": "Hová mész?"}
{"category": "LocationDialogue Location13", "line_index": 170, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 171, "text": "// Answer 3 (What if we attack Mad Mita?)"}
{"category": "LocationDialogue Location13", "line_index": 172, "text": "Említetted,"}
{"category": "LocationDialogue Location13", "line_index": 173, "text": "ha egy Mita meghal, búcsút mondhat emlékének..."}
{"category": "LocationDialogue Location13", "line_index": 174, "text": "Mi lenne, ha..."}
{"category": "LocationDialogue Location13", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 176, "text": "Szerinted képes lennél"}
{"category": "LocationDialogue Location13", "line_index": 177, "text": "a saját kezeddel megölni Téboly-Mitát?"}
{"category": "LocationDialogue Location13", "line_index": 178, "text": "Arról a Mitáról beszélünk, "}
{"category": "LocationDialogue Location13", "line_index": 179, "text": "aki láncfűrészt tart a lakásában!"}
{"category": "LocationDialogue Location13", "line_index": 180, "text": "Ő nemcsak répákat szeletelget."}
{"category": "LocationDialogue Location13", "line_index": 181, "text": "Rettentően veszélyes megközelíteni őt!"}
{"category": "LocationDialogue Location13", "line_index": 182, "text": "Az a csoda, hogy még életben vagyunk!"}
{"category": "LocationDialogue Location13", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 185, "text": "// core console entry"}
{"category": "LocationDialogue Location13", "line_index": 186, "text": "Bejelentkezési adatok szükségesek..."}
{"category": "LocationDialogue Location13", "line_index": 187, "text": "De milyen adatok?"}
{"category": "LocationDialogue Location13", "line_index": 188, "text": "Mita, te nem tudod?"}
{"category": "LocationDialogue Location13", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 190, "text": "Lehet valahol ki van írva."}
{"category": "LocationDialogue Location13", "line_index": 191, "text": "Nézz körbe, talán megtalálod."}
{"category": "LocationDialogue Location13", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 193, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location13", "line_index": 194, "text": "Szerintem nem ez lesz az."}
{"category": "LocationDialogue Location13", "line_index": 195, "text": "Ez se az."}
{"category": "LocationDialogue Location13", "line_index": 196, "text": "Rossz helyen keresem..."}
{"category": "LocationDialogue Location13", "line_index": 197, "text": "Nem ez az."}
{"category": "LocationDialogue Location13", "line_index": 198, "text": "Olyat kell találnom, ami azt írja, hogy karakter-visszaállítás."}
{"category": "LocationDialogue Location13", "line_index": 199, "text": "// core console - nope version"}
{"category": "LocationDialogue Location13", "line_index": 200, "text": "Nem ez a verzió."}
{"category": "LocationDialogue Location13", "line_index": 201, "text": "Hoppá, nem ezt akartam."}
{"category": "LocationDialogue Location13", "line_index": 202, "text": "Nem, nem ez az."}
{"category": "LocationDialogue Location13", "line_index": 203, "text": "Nem."}
{"category": "LocationDialogue Location13", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location13", "line_index": 205, "text": "Nem jó,"}
{"category": "LocationDialogue Location13", "line_index": 206, "text": "rossz az index."}
{"category": "LocationDialogue Location13", "line_index": 207, "text": "Nem jó,"}
{"category": "LocationDialogue Location13", "line_index": 208, "text": "nem fér ki."}
{"category": "LocationDialogue Location13", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 210, "text": "// Answer 4 (Little people - Chibi)"}
{"category": "LocationDialogue Location13", "line_index": 211, "text": "Láttam egy dobozt,"}
{"category": "LocationDialogue Location13", "line_index": 212, "text": "tele apró emberkékkel..."}
{"category": "LocationDialogue Location13", "line_index": 213, "text": "Azok mik voltak?"}
{"category": "LocationDialogue Location13", "line_index": 214, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 215, "text": "A csibikre gondolsz?"}
{"category": "LocationDialogue Location13", "line_index": 216, "text": "Hol is kezdjem...?"}
{"category": "LocationDialogue Location13", "line_index": 217, "text": "Minden Mitának"}
{"category": "LocationDialogue Location13", "line_index": 218, "text": "van csibikivetülése,"}
{"category": "LocationDialogue Location13", "line_index": 219, "text": "és játékosok is rendelkeznek ilyesmivel."}
{"category": "LocationDialogue Location13", "line_index": 220, "text": "Mi a miénket bármikor meg tudjuk idézni."}
{"category": "LocationDialogue Location13", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 222, "text": "Mi, tényleg?"}
{"category": "LocationDialogue Location13", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 224, "text": "Aham, ezt nézd!"}
{"category": "LocationDialogue Location13", "line_index": 225, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 226, "text": "Mintha varázslat lenne..."}
{"category": "LocationDialogue Location13", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 228, "text": "Az én csibijeimmel gondok vannak."}
{"category": "LocationDialogue Location13", "line_index": 229, "text": "A legtöbbjük halottként érkeznek meg."}
{"category": "LocationDialogue Location13", "line_index": 230, "text": "Persze van egy olyan,"}
{"category": "LocationDialogue Location13", "line_index": 231, "text": "ami, nos,"}
{"category": "LocationDialogue Location13", "line_index": 232, "text": "körbe-körbe karikába kalandozgat."}
