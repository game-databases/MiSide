{"category": "LocationDialogue Location17", "line_index": 0, "text": "﻿// Player thinks + Make coffee"}
{"category": "LocationDialogue Location17", "line_index": 1, "text": "Segítség kellene."}
{"category": "LocationDialogue Location17", "line_index": 2, "text": "Remélem az itteni Mita ártalmatlan."}
{"category": "LocationDialogue Location17", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 4, "text": "Egyáltalán mit művelek...?"}
{"category": "LocationDialogue Location17", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 9, "text": "// Player tries to wake up MitaDreamer"}
{"category": "LocationDialogue Location17", "line_index": 10, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 11, "text": "Mita, ébresztő!"}
{"category": "LocationDialogue Location17", "line_index": 12, "text": "Mita!"}
{"category": "LocationDialogue Location17", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 14, "text": "Ébresztő, hétalvó!"}
{"category": "LocationDialogue Location17", "line_index": 15, "text": "Segíts nekem!"}
{"category": "LocationDialogue Location17", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 17, "text": "Ki vaaaaaaagy?"}
{"category": "LocationDialogue Location17", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 19, "text": "Segíts a kapcsolókkal."}
{"category": "LocationDialogue Location17", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 21, "text": "Milyen kapcsolókkal?"}
{"category": "LocationDialogue Location17", "line_index": 22, "text": "Én csak aludni akarok..."}
{"category": "LocationDialogue Location17", "line_index": 23, "text": "csinálj kávét..."}
{"category": "LocationDialogue Location17", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 25, "text": "De nincs messze a kávéfőző..."}
{"category": "LocationDialogue Location17", "line_index": 26, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 27, "text": "Mitaaa!"}
{"category": "LocationDialogue Location17", "line_index": 28, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 31, "text": "// Player gives away the coffee"}
{"category": "LocationDialogue Location17", "line_index": 32, "text": "Mita,"}
{"category": "LocationDialogue Location17", "line_index": 33, "text": "ezt neked hoztam."}
{"category": "LocationDialogue Location17", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 37, "text": "// MitaDreamer exercise"}
{"category": "LocationDialogue Location17", "line_index": 38, "text": "Szóval..."}
{"category": "LocationDialogue Location17", "line_index": 39, "text": "kapcsolók?"}
{"category": "LocationDialogue Location17", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 41, "text": "Igen!"}
{"category": "LocationDialogue Location17", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 43, "text": "Honnan tudsz a kapcsolókról?"}
{"category": "LocationDialogue Location17", "line_index": 44, "text": "Miket kérdezek..."}
{"category": "LocationDialogue Location17", "line_index": 45, "text": "Biztos sok mindenről tudsz,"}
{"category": "LocationDialogue Location17", "line_index": 46, "text": "hogyha már idáig eljutottál..."}
{"category": "LocationDialogue Location17", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 48, "text": "Egy pillanat,"}
{"category": "LocationDialogue Location17", "line_index": 49, "text": "le kell ülnöm..."}
{"category": "LocationDialogue Location17", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 51, "text": "Folytathatod..."}
{"category": "LocationDialogue Location17", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 53, "text": "Nem értek igazán én se semmit,"}
{"category": "LocationDialogue Location17", "line_index": 54, "text": "de a gyűrű mondja, hogy oda kell mennem,"}
{"category": "LocationDialogue Location17", "line_index": 55, "text": "így odamegyek."}
{"category": "LocationDialogue Location17", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 57, "text": "Nálad van a gyűrűje?"}
{"category": "LocationDialogue Location17", "line_index": 58, "text": "Akkor már értem,"}
{"category": "LocationDialogue Location17", "line_index": 59, "text": "hogy kerülsz ide..."}
{"category": "LocationDialogue Location17", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 61, "text": "Így igaz."}
{"category": "LocationDialogue Location17", "line_index": 62, "text": "Na, akkor kérlek,"}
{"category": "LocationDialogue Location17", "line_index": 63, "text": "segítenél már a kapcsolókkal?"}
{"category": "LocationDialogue Location17", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 65, "text": "Persze..."}
{"category": "LocationDialogue Location17", "line_index": 66, "text": "Igen..."}
{"category": "LocationDialogue Location17", "line_index": 67, "text": "Kapcsolók..."}
{"category": "LocationDialogue Location17", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 70, "text": "Mita, ébredj..."}
{"category": "LocationDialogue Location17", "line_index": 71, "text": "Kelj fel."}
{"category": "LocationDialogue Location17", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 73, "text": "Ó?"}
{"category": "LocationDialogue Location17", "line_index": 74, "text": "Persze..."}
{"category": "LocationDialogue Location17", "line_index": 75, "text": "Menjünk..."}
{"category": "LocationDialogue Location17", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 78, "text": "// MitaDreamer fall"}
{"category": "LocationDialogue Location17", "line_index": 79, "text": "Ébredj!"}
{"category": "LocationDialogue Location17", "line_index": 80, "text": "Majd utána aludhatsz."}
{"category": "LocationDialogue Location17", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 82, "text": "// MitaDreamer again sleep"}
{"category": "LocationDialogue Location17", "line_index": 83, "text": "Ébresztő."}
{"category": "LocationDialogue Location17", "line_index": 84, "text": "Már majdnem ott vagyunk."}
{"category": "LocationDialogue Location17", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 87, "text": "// Switches"}
{"category": "LocationDialogue Location17", "line_index": 88, "text": "Rendben,"}
{"category": "LocationDialogue Location17", "line_index": 89, "text": "készen állok..."}
{"category": "LocationDialogue Location17", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 91, "text": "Én is."}
{"category": "LocationDialogue Location17", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 93, "text": "Akkor"}
{"category": "LocationDialogue Location17", "line_index": 94, "text": "háromig"}
{"category": "LocationDialogue Location17", "line_index": 95, "text": "számolok,"}
{"category": "LocationDialogue Location17", "line_index": 96, "text": "és egyszerre meghúzzuk a kart."}
{"category": "LocationDialogue Location17", "line_index": 97, "text": "Rendicsek?"}
{"category": "LocationDialogue Location17", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 99, "text": "Csak el ne aludj."}
{"category": "LocationDialogue Location17", "line_index": 100, "text": "Mehet."}
{"category": "LocationDialogue Location17", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 103, "text": "három..."}
{"category": "LocationDialogue Location17", "line_index": 104, "text": "kettő..."}
{"category": "LocationDialogue Location17", "line_index": 105, "text": "Egy..."}
{"category": "LocationDialogue Location17", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 107, "text": "// Player lose 1"}
{"category": "LocationDialogue Location17", "line_index": 108, "text": "Nem húztad meg..."}
{"category": "LocationDialogue Location17", "line_index": 109, "text": "Jó,"}
{"category": "LocationDialogue Location17", "line_index": 110, "text": "próbáljuk újra..."}
{"category": "LocationDialogue Location17", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 112, "text": "// Player lose 2"}
{"category": "LocationDialogue Location17", "line_index": 113, "text": "Most komolyan?"}
{"category": "LocationDialogue Location17", "line_index": 114, "text": "Kérlek..."}
{"category": "LocationDialogue Location17", "line_index": 115, "text": "Mindjárt el..."}
{"category": "LocationDialogue Location17", "line_index": 116, "text": "Mindjárt elalszok..."}
{"category": "LocationDialogue Location17", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 118, "text": "// Player lose 3"}
{"category": "LocationDialogue Location17", "line_index": 119, "text": "Mindjárt elalszok itt helyben..."}
{"category": "LocationDialogue Location17", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 122, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 123, "text": "Szép munka!"}
{"category": "LocationDialogue Location17", "line_index": 124, "text": "Köszönöm, Mita."}
{"category": "LocationDialogue Location17", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 126, "text": "Semmiség..."}
{"category": "LocationDialogue Location17", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 129, "text": "Olyan..."}
{"category": "LocationDialogue Location17", "line_index": 130, "text": "lassan..."}
{"category": "LocationDialogue Location17", "line_index": 131, "text": "nyílik..."}
{"category": "LocationDialogue Location17", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 134, "text": "Megyek csicsikálni..."}
{"category": "LocationDialogue Location17", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 136, "text": "// Why kitchen?"}
{"category": "LocationDialogue Location17", "line_index": 137, "text": "Miért vagyunk a konyhában?"}
{"category": "LocationDialogue Location17", "line_index": 138, "text": "A te hibád, ha a hideg padlóra"}
{"category": "LocationDialogue Location17", "line_index": 139, "text": "esek össze..."}
{"category": "LocationDialogue Location17", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 141, "text": "// Why bathroom?"}
{"category": "LocationDialogue Location17", "line_index": 142, "text": "Nem értelek..."}
{"category": "LocationDialogue Location17", "line_index": 143, "text": "a fürdőszobában van a kapcsoló?"}
{"category": "LocationDialogue Location17", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 145, "text": "// Put button"}
{"category": "LocationDialogue Location17", "line_index": 146, "text": "Nem történt semmi."}
{"category": "LocationDialogue Location17", "line_index": 147, "text": "Akkor mire jó ez a gomb?"}
{"category": "LocationDialogue Location17", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 149, "text": "// Cofee"}
{"category": "LocationDialogue Location17", "line_index": 150, "text": "Kell még kávé?"}
{"category": "LocationDialogue Location17", "line_index": 151, "text": "Csak nehogy elaludj."}
{"category": "LocationDialogue Location17", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 153, "text": "Mi?"}
{"category": "LocationDialogue Location17", "line_index": 154, "text": "Neeeem..."}
{"category": "LocationDialogue Location17", "line_index": 155, "text": "Undorító ez a kávé..."}
{"category": "LocationDialogue Location17", "line_index": 156, "text": "Minden a legnagyobb rendben..."}
{"category": "LocationDialogue Location17", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 158, "text": "// Button"}
{"category": "LocationDialogue Location17", "line_index": 159, "text": "Mita? Nem csinál semmit a gomb... Mit tegyek?"}
{"category": "LocationDialogue Location17", "line_index": 160, "text": "Mita?"}
