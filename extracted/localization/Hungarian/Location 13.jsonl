{"category": "Location 13", "line_index": 0, "text": "// Quest none"}
{"category": "Location 13", "line_index": 1, "text": "Mindegy."}
{"category": "Location 13", "line_index": 2, "text": "// Quest \"First\""}
{"category": "Location 13", "line_index": 3, "text": "Merre voltál eddig?"}
{"category": "Location 13", "line_index": 4, "text": "Hogy kerültél ide?"}
{"category": "Location 13", "line_index": 5, "text": "Az imént melyik Mitával találkoztam?"}
{"category": "Location 13", "line_index": 6, "text": "Hogy működik a gyűrű?"}
{"category": "Location 13", "line_index": 7, "text": "Téboly-Mita miért viselkedik így velem?"}
{"category": "Location 13", "line_index": 8, "text": "Ez lenne a Mag?"}
{"category": "Location 13", "line_index": 9, "text": "// Quest \"Second\""}
{"category": "Location 13", "line_index": 10, "text": "Jól vagy?"}
{"category": "Location 13", "line_index": 11, "text": "Valahogyan csak megtaláljuk az indexszet."}
{"category": "Location 13", "line_index": 12, "text": "És ha megtámadjuk Téboly-Mitát?"}
{"category": "Location 13", "line_index": 13, "text": "Miniemberkék"}
