{"category": "LocationDialogue Location4", "line_index": 0, "text": "﻿Mita?"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "Ó, már magadhoz tértél?"}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "Hogy kerültél ide?"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": "Az előbb még a közelemben voltál..."}
{"category": "LocationDialogue Location4", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 5, "text": "Nem, dehogy."}
{"category": "LocationDialogue Location4", "line_index": 6, "text": "Le voltál fagyva a tükör előtt."}
{"category": "LocationDialogue Location4", "line_index": 7, "text": "Elmentem onnan."}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "Mi történt a szobákkal?"}
{"category": "LocationDialogue Location4", "line_index": 9, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "Végeztem egy kis átalakítást,"}
{"category": "LocationDialogue Location4", "line_index": 11, "text": "hogy számodra otthonosabb legyen."}
{"category": "LocationDialogue Location4", "line_index": 12, "text": "A szobák"}
{"category": "LocationDialogue Location4", "line_index": 13, "text": "úgy lettek kialakítva,"}
{"category": "LocationDialogue Location4", "line_index": 14, "text": "hogy sokkal természetesebbnek hasson."}
{"category": "LocationDialogue Location4", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 16, "text": "Nem kellett volna."}
{"category": "LocationDialogue Location4", "line_index": 17, "text": "Már kezdtem megszokni."}
{"category": "LocationDialogue Location4", "line_index": 18, "text": "Hidd el, így sokkal jobb lesz."}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Mita card game"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "Hát,"}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "akkor kezdjük is el!"}
{"category": "LocationDialogue Location4", "line_index": 22, "text": "Elmondom röviden a szabályokat."}
{"category": "LocationDialogue Location4", "line_index": 23, "text": "A kupakban találsz egy tárgyat."}
{"category": "LocationDialogue Location4", "line_index": 24, "text": "Ha például egy szívet látsz benne,"}
{"category": "LocationDialogue Location4", "line_index": 25, "text": "és a te kártyádon"}
{"category": "LocationDialogue Location4", "line_index": 26, "text": "amit te leraksz,"}
{"category": "LocationDialogue Location4", "line_index": 27, "text": "több szív van,"}
{"category": "LocationDialogue Location4", "line_index": 28, "text": "mint az enyémen,"}
{"category": "LocationDialogue Location4", "line_index": 29, "text": "akkor te nyertél."}
{"category": "LocationDialogue Location4", "line_index": 30, "text": "Akkor vedd el a paklid."}
{"category": "LocationDialogue Location4", "line_index": 31, "text": "Én jövök."}
{"category": "LocationDialogue Location4", "line_index": 32, "text": "Váó!"}
{"category": "LocationDialogue Location4", "line_index": 33, "text": "De jó paklit húztam!"}
{"category": "LocationDialogue Location4", "line_index": 34, "text": "Én kezdek!"}
{"category": "LocationDialogue Location4", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 44, "text": "Most te."}
{"category": "LocationDialogue Location4", "line_index": 45, "text": "Te jössz."}
{"category": "LocationDialogue Location4", "line_index": 46, "text": "Így ni!"}
{"category": "LocationDialogue Location4", "line_index": 47, "text": "Te jössz."}
{"category": "LocationDialogue Location4", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 49, "text": "Szívre koncentrálj."}
{"category": "LocationDialogue Location4", "line_index": 50, "text": "Kardra koncentrálj."}
{"category": "LocationDialogue Location4", "line_index": 51, "text": "Pajzsra koncentrálj."}
{"category": "LocationDialogue Location4", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 54, "text": "Megy ez neked!"}
{"category": "LocationDialogue Location4", "line_index": 55, "text": "Nyertél!"}
{"category": "LocationDialogue Location4", "line_index": 56, "text": "Te nyertél!"}
{"category": "LocationDialogue Location4", "line_index": 57, "text": "Tiéd a pont!"}
{"category": "LocationDialogue Location4", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 59, "text": "Nyertem!"}
{"category": "LocationDialogue Location4", "line_index": 60, "text": "Enyém a pont!"}
{"category": "LocationDialogue Location4", "line_index": 61, "text": "A győzelem az enyém!"}
{"category": "LocationDialogue Location4", "line_index": 62, "text": "Haha, legyőzhetetlen vagyok!"}
{"category": "LocationDialogue Location4", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 64, "text": "Döntetlen."}
{"category": "LocationDialogue Location4", "line_index": 65, "text": "Egyikünk se nyert."}
{"category": "LocationDialogue Location4", "line_index": 66, "text": "Döntetlen lett?"}
{"category": "LocationDialogue Location4", "line_index": 67, "text": "Ugyanannyi."}
{"category": "LocationDialogue Location4", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 79, "text": "// The card game is interrupted"}
{"category": "LocationDialogue Location4", "line_index": 80, "text": "Mi ez a hang?"}
{"category": "LocationDialogue Location4", "line_index": 81, "text": "A szekrényből jön."}
{"category": "LocationDialogue Location4", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 83, "text": "Hang?"}
{"category": "LocationDialogue Location4", "line_index": 84, "text": "Milyen hang?"}
{"category": "LocationDialogue Location4", "line_index": 85, "text": "Nem hallok semmit."}
{"category": "LocationDialogue Location4", "line_index": 86, "text": "Mit hallottál pontosan?"}
{"category": "LocationDialogue Location4", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 88, "text": "Mintha valaki a szekrényből kopogna..."}
{"category": "LocationDialogue Location4", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 90, "text": "De ott..."}
{"category": "LocationDialogue Location4", "line_index": 91, "text": "nincs senki."}
{"category": "LocationDialogue Location4", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 93, "text": "Ki szeretném nyitni a szekrényt."}
{"category": "LocationDialogue Location4", "line_index": 94, "text": "A végére akarok járni ennek."}
{"category": "LocationDialogue Location4", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 96, "text": "De miért?"}
{"category": "LocationDialogue Location4", "line_index": 97, "text": "Megint..."}
{"category": "LocationDialogue Location4", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 105, "text": "Te meg mit művelsz?"}
{"category": "LocationDialogue Location4", "line_index": 106, "text": "Ott csak..."}
{"category": "LocationDialogue Location4", "line_index": 107, "text": "az alsóneműim vannak...!"}
{"category": "LocationDialogue Location4", "line_index": 108, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 109, "text": "Valamit rejtegetsz előlem?"}
{"category": "LocationDialogue Location4", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 111, "text": "Csak higgy nekem!"}
{"category": "LocationDialogue Location4", "line_index": 112, "text": "Mi rosszat tettem?"}
{"category": "LocationDialogue Location4", "line_index": 113, "text": "Csak..."}
{"category": "LocationDialogue Location4", "line_index": 114, "text": "együtt akarok lenni veled."}
{"category": "LocationDialogue Location4", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 116, "text": "Én is, de..."}
{"category": "LocationDialogue Location4", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 118, "text": "Miért érdekel téged annyira ez a szekrény?"}
{"category": "LocationDialogue Location4", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 120, "text": "Csak tudni szeretném, mi ez a kopogás!"}
{"category": "LocationDialogue Location4", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 122, "text": "Azért,"}
{"category": "LocationDialogue Location4", "line_index": 123, "text": "mert csak négy szoba van?"}
{"category": "LocationDialogue Location4", "line_index": 124, "text": "Túl kicsi neked a világom?"}
{"category": "LocationDialogue Location4", "line_index": 125, "text": "Velem miért nem elégszel meg?"}
{"category": "LocationDialogue Location4", "line_index": 126, "text": "Maradj velem!"}
{"category": "LocationDialogue Location4", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 129, "text": "// Don't stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 130, "text": "Értem..."}
{"category": "LocationDialogue Location4", "line_index": 131, "text": "Már megint..."}
{"category": "LocationDialogue Location4", "line_index": 132, "text": "Ha ennyire tudni akarod, mi van a szekrényben,"}
{"category": "LocationDialogue Location4", "line_index": 133, "text": "akkor megtudod..."}
{"category": "LocationDialogue Location4", "line_index": 134, "text": "...most rögtön!"}
{"category": "LocationDialogue Location4", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 139, "text": "Mi a..."}
{"category": "LocationDialogue Location4", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 141, "text": "Néha van ilyen."}
{"category": "LocationDialogue Location4", "line_index": 142, "text": "Lassan tölt be a szoba."}
{"category": "LocationDialogue Location4", "line_index": 143, "text": "Várj egy kicsit."}
{"category": "LocationDialogue Location4", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 145, "text": "Ez olyan fura."}
{"category": "LocationDialogue Location4", "line_index": 146, "text": "Másnak a telefonjában vagyunk?"}
{"category": "LocationDialogue Location4", "line_index": 147, "text": "Mert ez a telefon olyan lassú."}
{"category": "LocationDialogue Location4", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 149, "text": "Nem, nem."}
{"category": "LocationDialogue Location4", "line_index": 150, "text": "A világban nem minden olyan"}
{"category": "LocationDialogue Location4", "line_index": 151, "text": "tökéletes..."}
{"category": "LocationDialogue Location4", "line_index": 152, "text": "A „Mag” működteti"}
{"category": "LocationDialogue Location4", "line_index": 153, "text": "ezt a világot."}
{"category": "LocationDialogue Location4", "line_index": 154, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 155, "text": "A „Mag?”"}
{"category": "LocationDialogue Location4", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 157, "text": "Tipikus, tudom."}
{"category": "LocationDialogue Location4", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 159, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 161, "text": "Miért ne"}
{"category": "LocationDialogue Location4", "line_index": 162, "text": "videójátékozunk?"}
{"category": "LocationDialogue Location4", "line_index": 163, "text": "Vagy kártyázhatunk is."}
{"category": "LocationDialogue Location4", "line_index": 164, "text": "Tiéd a választás."}
{"category": "LocationDialogue Location4", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 167, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 168, "text": "// Mita play fight"}
{"category": "LocationDialogue Location4", "line_index": 169, "text": "Harcra fel!"}
{"category": "LocationDialogue Location4", "line_index": 170, "text": "A cél az,"}
{"category": "LocationDialogue Location4", "line_index": 171, "text": "hogy négyszer legyőzz!"}
{"category": "LocationDialogue Location4", "line_index": 172, "text": "Sok sikert!"}
{"category": "LocationDialogue Location4", "line_index": 173, "text": "Ne aggódj,"}
{"category": "LocationDialogue Location4", "line_index": 174, "text": "visszafogom magam."}
{"category": "LocationDialogue Location4", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 176, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 177, "text": "Szép volt!"}
{"category": "LocationDialogue Location4", "line_index": 178, "text": "Na most kösd fel a gatyád!"}
{"category": "LocationDialogue Location4", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 180, "text": "Váó!"}
{"category": "LocationDialogue Location4", "line_index": 181, "text": "Jól van,"}
{"category": "LocationDialogue Location4", "line_index": 182, "text": "innentől nincs kegyelem."}
{"category": "LocationDialogue Location4", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 184, "text": "Te kis...!"}
{"category": "LocationDialogue Location4", "line_index": 185, "text": "Nézzük, most le tudsz"}
{"category": "LocationDialogue Location4", "line_index": 186, "text": "győzni?"}
{"category": "LocationDialogue Location4", "line_index": 187, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 188, "text": "Hát"}
{"category": "LocationDialogue Location4", "line_index": 189, "text": "te..."}
{"category": "LocationDialogue Location4", "line_index": 190, "text": "elképeztő vagy! Elég profi vagy ebben!"}
{"category": "LocationDialogue Location4", "line_index": 191, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 193, "text": "Na most mi van?"}
{"category": "LocationDialogue Location4", "line_index": 194, "text": "Ez így unalmas."}
{"category": "LocationDialogue Location4", "line_index": 195, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 196, "text": "Hát..."}
{"category": "LocationDialogue Location4", "line_index": 197, "text": "Egy újabb tej lekeverve. Ebből nem épülsz fel!"}
{"category": "LocationDialogue Location4", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 199, "text": "Csak..."}
{"category": "LocationDialogue Location4", "line_index": 200, "text": "adj bele mindent, vagy örökre vesztes maradsz!"}
{"category": "LocationDialogue Location4", "line_index": 201, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 202, "text": "Ó, komolyan?"}
{"category": "LocationDialogue Location4", "line_index": 203, "text": "Most felmostam veled a padlót!"}
{"category": "LocationDialogue Location4", "line_index": 204, "text": "Csak próbálkozz erősebben."}
{"category": "LocationDialogue Location4", "line_index": 205, "text": "Ehhez a hozzáállás miatt nyerek mindig!"}
{"category": "LocationDialogue Location4", "line_index": 206, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 208, "text": "Hát jó."}
{"category": "LocationDialogue Location4", "line_index": 209, "text": "Akkor kártyázzunk,"}
{"category": "LocationDialogue Location4", "line_index": 210, "text": "a hálószobámban."}
{"category": "LocationDialogue Location4", "line_index": 211, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 214, "text": "// Door > [ERROR]"}
{"category": "LocationDialogue Location4", "line_index": 215, "text": "Mi ez?"}
{"category": "LocationDialogue Location4", "line_index": 216, "text": "Hol van a..."}
{"category": "LocationDialogue Location4", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 218, "text": "Hoppá,"}
{"category": "LocationDialogue Location4", "line_index": 219, "text": "bocsi!"}
{"category": "LocationDialogue Location4", "line_index": 220, "text": "Valamit letöltöttem"}
{"category": "LocationDialogue Location4", "line_index": 221, "text": "az internetről."}
{"category": "LocationDialogue Location4", "line_index": 222, "text": "Azt akartam,"}
{"category": "LocationDialogue Location4", "line_index": 223, "text": "hogy gyönyörű legyen a környék,"}
{"category": "LocationDialogue Location4", "line_index": 224, "text": "de úgy tűnik,"}
{"category": "LocationDialogue Location4", "line_index": 225, "text": "hogy valami gond van a fájllal."}
{"category": "LocationDialogue Location4", "line_index": 226, "text": "Később kijavítom."}
{"category": "LocationDialogue Location4", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 228, "text": "Ezért nem mehetünk ki a házból?"}
{"category": "LocationDialogue Location4", "line_index": 229, "text": "Igen, ezért."}
{"category": "LocationDialogue Location4", "line_index": 230, "text": "// Mita shy"}
{"category": "LocationDialogue Location4", "line_index": 231, "text": "Na..."}
{"category": "LocationDialogue Location4", "line_index": 232, "text": "Mi van veled?"}
{"category": "LocationDialogue Location4", "line_index": 233, "text": "Szeretnél valamit tőlem?"}
{"category": "LocationDialogue Location4", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 236, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 237, "text": "// Wall Clock"}
{"category": "LocationDialogue Location4", "line_index": 238, "text": "Ez az óra, "}
{"category": "LocationDialogue Location4", "line_index": 239, "text": "milyen időt mutat?"}
{"category": "LocationDialogue Location4", "line_index": 240, "text": "A játékbeli időt?"}
{"category": "LocationDialogue Location4", "line_index": 241, "text": "vagy ez szinkronizálva van a telefonommal?"}
{"category": "LocationDialogue Location4", "line_index": 242, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 243, "text": "Hát..."}
{"category": "LocationDialogue Location4", "line_index": 244, "text": "...nem igazán tudom."}
{"category": "LocationDialogue Location4", "line_index": 245, "text": "De az idő nem számít."}
{"category": "LocationDialogue Location4", "line_index": 246, "text": "Az se, ha este, vagy reggel van."}
{"category": "LocationDialogue Location4", "line_index": 247, "text": "A magamfajta lányok"}
{"category": "LocationDialogue Location4", "line_index": 248, "text": "mindig televannak energiával!"}
{"category": "LocationDialogue Location4", "line_index": 249, "text": "Sosem fáradok el!"}
{"category": "LocationDialogue Location4", "line_index": 250, "text": "Örökre tavasz lehet!"}
{"category": "LocationDialogue Location4", "line_index": 251, "text": "Vagy akár örökre dél!"}
{"category": "LocationDialogue Location4", "line_index": 252, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 253, "text": "Érdekes..."}
{"category": "LocationDialogue Location4", "line_index": 254, "text": "És egyben elég bizarr."}
{"category": "LocationDialogue Location4", "line_index": 255, "text": "Furcsa, hogy az idő megállhat..."}
{"category": "LocationDialogue Location4", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 258, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 259, "text": "// Photos of Mita"}
{"category": "LocationDialogue Location4", "line_index": 260, "text": "Gyönyörű fotók."}
{"category": "LocationDialogue Location4", "line_index": 261, "text": "Gondolom ezeken te szerepelsz."}
{"category": "LocationDialogue Location4", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 263, "text": "Igen."}
{"category": "LocationDialogue Location4", "line_index": 264, "text": "Nekem is tetszenek."}
{"category": "LocationDialogue Location4", "line_index": 265, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 266, "text": "Ki készítette őket?"}
{"category": "LocationDialogue Location4", "line_index": 267, "text": "Mások is vannak ebben a világban?"}
{"category": "LocationDialogue Location4", "line_index": 268, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 269, "text": "Mondhatni."}
{"category": "LocationDialogue Location4", "line_index": 270, "text": "Majd bemutatom őket."}
{"category": "LocationDialogue Location4", "line_index": 271, "text": "De majd később."}
{"category": "LocationDialogue Location4", "line_index": 272, "text": "Addig hadd legyünk együtt."}
{"category": "LocationDialogue Location4", "line_index": 273, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 275, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 276, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 277, "text": "// Portal"}
{"category": "LocationDialogue Location4", "line_index": 278, "text": "Hová tünt a portál?"}
{"category": "LocationDialogue Location4", "line_index": 279, "text": "Vagy a hogyishívják?"}
{"category": "LocationDialogue Location4", "line_index": 280, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 281, "text": "Áthelyeztem"}
{"category": "LocationDialogue Location4", "line_index": 282, "text": "máshová"}
{"category": "LocationDialogue Location4", "line_index": 283, "text": "a varázserőmmel."}
{"category": "LocationDialogue Location4", "line_index": 284, "text": "De ne aggódj,"}
{"category": "LocationDialogue Location4", "line_index": 285, "text": "már nincs szükségünk rá."}
{"category": "LocationDialogue Location4", "line_index": 286, "text": "Csak a helyet foglalja."}
{"category": "LocationDialogue Location4", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 288, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 289, "text": "// Mirror in the bedroom"}
{"category": "LocationDialogue Location4", "line_index": 290, "text": "De fura egy olyan tükröt bámulni,"}
{"category": "LocationDialogue Location4", "line_index": 291, "text": "ami nem tükrözik vissza."}
{"category": "LocationDialogue Location4", "line_index": 292, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 293, "text": "A tükrözést be lehet kapcsolni,"}
{"category": "LocationDialogue Location4", "line_index": 294, "text": "ha szeretnéd."}
{"category": "LocationDialogue Location4", "line_index": 295, "text": "De nagyon fontos?"}
{"category": "LocationDialogue Location4", "line_index": 296, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 297, "text": "Persze."}
{"category": "LocationDialogue Location4", "line_index": 298, "text": "Vagy rossz ötlet?"}
{"category": "LocationDialogue Location4", "line_index": 299, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 300, "text": "Hát..."}
{"category": "LocationDialogue Location4", "line_index": 301, "text": "egyre jobban akadozni fogunk."}
{"category": "LocationDialogue Location4", "line_index": 302, "text": "Láttál már darabos rajzfilmet?"}
{"category": "LocationDialogue Location4", "line_index": 303, "text": "Ugyanolyan lassú, és idegesítő lesz itt is."}
{"category": "LocationDialogue Location4", "line_index": 304, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 305, "text": "Rendben."}
{"category": "LocationDialogue Location4", "line_index": 306, "text": "Akkor ne csináljunk vele semmit."}
{"category": "LocationDialogue Location4", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 308, "text": "Te aztán nagyon szereted"}
{"category": "LocationDialogue Location4", "line_index": 309, "text": "a tükröket, [player]!"}
{"category": "LocationDialogue Location4", "line_index": 310, "text": "Biztos akarsz lenni abban, hogy nem mosolyogsz?"}
{"category": "LocationDialogue Location4", "line_index": 311, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 312, "text": "Hogy mi?"}
{"category": "LocationDialogue Location4", "line_index": 313, "text": "Nem, dehogy, csak"}
{"category": "LocationDialogue Location4", "line_index": 314, "text": "nagyon fáradt vagyok így munka után."}
{"category": "LocationDialogue Location4", "line_index": 315, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 316, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 317, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 318, "text": "// Blue sneakers"}
{"category": "LocationDialogue Location4", "line_index": 319, "text": "Az a cipellő, a tiéd?"}
{"category": "LocationDialogue Location4", "line_index": 320, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 321, "text": "Nem, a tiéd,"}
{"category": "LocationDialogue Location4", "line_index": 322, "text": "nem emlékszel rá?"}
{"category": "LocationDialogue Location4", "line_index": 323, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 324, "text": "Ilyet én nem hordok."}
{"category": "LocationDialogue Location4", "line_index": 325, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 326, "text": "Most már igen."}
{"category": "LocationDialogue Location4", "line_index": 327, "text": "Majd hordani fogod őket,"}
{"category": "LocationDialogue Location4", "line_index": 328, "text": "ha majd kettesben sétálunk."}
{"category": "LocationDialogue Location4", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 330, "text": "És mi van a ruháimmal?"}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "Ez az egyetlen göncöm"}
{"category": "LocationDialogue Location4", "line_index": 332, "text": "ebben a világban."}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "Hol fogok tudni venni újat?"}
{"category": "LocationDialogue Location4", "line_index": 334, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 335, "text": "Nem kell aggódnod emiatt."}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "De... láttam a ruhatáradat..."}
{"category": "LocationDialogue Location4", "line_index": 337, "text": "Őszintén, a stílusod nincs a toppon."}
{"category": "LocationDialogue Location4", "line_index": 338, "text": "Semmi baj, majd együtt megoldjunk."}
{"category": "LocationDialogue Location4", "line_index": 339, "text": "De majd később."}
{"category": "LocationDialogue Location4", "line_index": 340, "text": "Megígérem."}
{"category": "LocationDialogue Location4", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 342, "text": "Hát jó."}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Games on TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "Mivel játsszunk?"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Game milk"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "Ú, ez egy verekedős játék!"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "Nézzük, ki veszti el előbb a tejét!"}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "Csodás játék!"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": "Szerintem játsszunk valami mással!"}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Game penguins"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "Ebben a játékban csúszkálunk,"}
{"category": "LocationDialogue Location4", "line_index": 354, "text": "mint egy pingvin!"}
{"category": "LocationDialogue Location4", "line_index": 355, "text": "Remek játék!"}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "Vagyis.. várjunk..."}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "Komolyan mondod? Tényleg?"}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "Annyira, de annyira boldog vagyok most!"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "És egy kicsit zavarodott…"}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "De jól van!"}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "Kérlek, maradj velem!"}
{"category": "LocationDialogue Location4", "line_index": 364, "text": "Örökkön örökké!"}
{"category": "LocationDialogue Location4", "line_index": 365, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 367, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 368, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 369, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 370, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 372, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 373, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 374, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 375, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 376, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 377, "text": "// A game about penguins"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "Nagyon könnyű!"}
{"category": "LocationDialogue Location4", "line_index": 379, "text": "Hógolyókat kell gyűjtened!"}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "Az nyer, aki a legtöbbet összegyűjti!"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "Menjünk akkor két menetet!"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// The first map"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "De sokat gyűjtöttél össze!"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "Hehe, én többet gyűjtöttem!"}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "Siess!"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "Döntetlen!"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// The second map"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "Te egy született pingvin vagy!"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "A pályán van a helyed!"}
{"category": "LocationDialogue Location4", "line_index": 390, "text": "Jaj, de lassú vagy!"}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "De ne zavartasd magad!"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "Döntetlen? Nem semmi!"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// The game is over"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "Akkor, játsszunk valami mással?"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "Vagy elég ennyi?"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "Na, most miért játszasz?"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "Milyen cuki játékod van!"}
