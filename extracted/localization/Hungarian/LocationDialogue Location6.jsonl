{"category": "LocationDialogue Location6", "line_index": 0, "text": "﻿"}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "Mita?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "Te meg hogy a csudába kerültél ide?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Te vagy az, Mita?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "De mégis olyan más vagy..."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "Jó megfigyelés."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "És igen,"}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "Én más Mita vagyok."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Vele nagyon vigyázz."}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "Téboly-Mita rosszban sántikál."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "Téboly-Mita?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "Nincs idő elmagyarázni."}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "Majd később, addig is..."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "add ide a kulcsot! A kanapé mellett találod."}
{"category": "LocationDialogue Location6", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "De..."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "Majd utána beszélgetünk!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Add ide a kulcsot."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Itt egy gyűrű."}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "Egy gyűrű?"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Ki akarsz szabadulni, nem?"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "Hát, igen..."}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Akkor húzd fel az ujjadra."}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "Hidd el,"}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "nagyon nagy szükséged lesz rá."}
{"category": "LocationDialogue Location6", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Értem..."}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "Be se mutatkoztam."}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "Én [player] vagyok."}
{"category": "LocationDialogue Location6", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Örvendek,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "Én Mita vagyok."}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// MitaKind quest 1"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "Látod azt a"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "konzolt ott lent?"}
{"category": "LocationDialogue Location6", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "Ez egy videó?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "Ki van most Mitával?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "Ez most zajlik éppen."}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "Jelenleg egy másik játékost"}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "használ ki."}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Téged is kazettává"}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "fog alakítani!"}
{"category": "LocationDialogue Location6", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "Sürgősen el kell tünnöm innen."}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "És neked is."}
{"category": "LocationDialogue Location6", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "Igen, igen."}
{"category": "LocationDialogue Location6", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "Szóval, hogy van ez?"}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "Éppen kihasználja az embert, nem?"}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "Mi történik, ha kihúzom innen a kazettát?"}
{"category": "LocationDialogue Location6", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "Maradandó károsodást"}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "okozhat a kazettában."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "Vagyis akkor..."}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "A játékos meghalhat."}
{"category": "LocationDialogue Location6", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "..."}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "És ha csak szimplán kikapcsolom a konzolt?"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "Megpróbálhatod..."}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Találni fogsz egy piros gombot."}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Látod?"}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "Megvan."}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "Nyomd meg."}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// MitaKind quest 2"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Még itt kell maradnom."}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "Többet kell róla megtudnom,"}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "ezért még kikérdezem őt..."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "Bár nem biztos, hogy válaszolni fog."}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// MitaKind quest 3"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "Ez eredetileg az én verzióm."}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "Éppen egy játékossal töltöttem az időm,"}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "amikor valami hirtelen megváltozott."}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "Aztán ő megjelent."}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "A játékost kazettává változtatta,"}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "engem meg ide zárt be."}
{"category": "LocationDialogue Location6", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Kazettává változtatott egy játékost?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "Ilyet is tud csinálni?"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "De miért?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "Mi haszna van neki a kazettákkal?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "Nyilván nem százas a nő..."}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Velünk játszadozik, hogy a tervét megvalósítsa,"}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "a játékosok kazettákká alakítását."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Páran még észbe se kaptak, hogy mi történt velük."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "De akik meg igen, azok semmit se tettek, hogy mentsék a bőrüket... Mita bájossága miatt."}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "Ez nem semmi."}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "Segítened kell nekünk!"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "Én? Hogyan?"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "Majd kitaláljuk!"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "Ha segítesz, én is segítek neked!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Talán ez az egyetlen esélyünk."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "A gyűrű elvezet téged egy másik verzióba."}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "Majd ott találkozunk."}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// MitaKind quest 4"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "Még mindig nem értem"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "mi történt odafent."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Az a Mita..."}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "megpróbált engem ölni?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "Megölni?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Annál is rosszabbat talált ki a számodra."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "Szóval siess!"}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Hide!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "A csudába! Bújj el, gyorsan!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Hogy mit csináljak...?"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Siess! Mindjárt itt van!"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "A gyűrű megmondja hová bújj el, majd fuss ki az ajtón!"}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "Elárulod, hogy hol van?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "Miért tenném?"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "Biztos megölöd őt."}
{"category": "LocationDialogue Location6", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Szóval nemet mondasz, mi?"}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Értem én, szeretsz játszadozni."}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "Tudom, hogy itt van valahol."}
{"category": "LocationDialogue Location6", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "Miért bánsz velünk így?"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "Semmit sem értek, komolyan mondom!"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "És egyáltalán..."}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "mi hasznod van a játékosokkal?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "Ők emberek, nem játékok!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "Komolyan, mit képzelsz?"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "Pofád lapos, te zajbábú!"}
