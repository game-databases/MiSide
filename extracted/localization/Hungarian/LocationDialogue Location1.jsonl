{"category": "LocationDialogue Location1", "line_index": 0, "text": "﻿"}
{"category": "LocationDialogue Location1", "line_index": 1, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 9, "text": "Halihó! Mita vagyok!"}
{"category": "LocationDialogue Location1", "line_index": 10, "text": "Téged hogy hívnak?"}
{"category": "LocationDialogue Location1", "line_index": 11, "text": "Örvendek, [player]!"}
{"category": "LocationDialogue Location1", "line_index": 12, "text": "Izé..."}
{"category": "LocationDialogue Location1", "line_index": 13, "text": "az van, hogy sok itt a kupi, mert nagyon kellett sietnem..."}
{"category": "LocationDialogue Location1", "line_index": 14, "text": "Fel tudod takarítani ezt a sok limlomot itt?"}
{"category": "LocationDialogue Location1", "line_index": 15, "text": "Hűha..."}
{"category": "LocationDialogue Location1", "line_index": 16, "text": "Nagyon köszönöm!"}
{"category": "LocationDialogue Location1", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 18, "text": "[Player], megéheztem..."}
{"category": "LocationDialogue Location1", "line_index": 19, "text": "Húslevest szeretnék csinálni..."}
{"category": "LocationDialogue Location1", "line_index": 20, "text": "Megveszed nekem a hozzávalókat?"}
{"category": "LocationDialogue Location1", "line_index": 21, "text": "Hűha! Pont ez kellett!"}
{"category": "LocationDialogue Location1", "line_index": 22, "text": "Főzzük meg együtt, jó?"}
{"category": "LocationDialogue Location1", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 25, "text": "Nagyon szeretnék egy minitévét venni..."}
{"category": "LocationDialogue Location1", "line_index": 26, "text": "Nagyon kicsi, és antennái is vannak. Ha kell, bármikor magammal vihetem, ahová megyek!"}
{"category": "LocationDialogue Location1", "line_index": 27, "text": "Azt tudtad, hogy úgy is kereshetsz pénzt, ha minijátékokkal játszasz?"}
{"category": "LocationDialogue Location1", "line_index": 28, "text": "Azzal a pénzzel meg tudod nekem venni a tévét?"}
{"category": "LocationDialogue Location1", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 30, "text": "Ezaz! Sikerült! Elég pénz gyűlt össze!"}
{"category": "LocationDialogue Location1", "line_index": 31, "text": "Igen, pont ez kellett! Kicsi, és olcsó darab!"}
{"category": "LocationDialogue Location1", "line_index": 32, "text": "Köszönöm!"}
{"category": "LocationDialogue Location1", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 34, "text": "Szia, [player]! Olyan segítőkész vagy!"}
{"category": "LocationDialogue Location1", "line_index": 35, "text": "Az a tévé... Sajnos elromlott..."}
{"category": "LocationDialogue Location1", "line_index": 36, "text": "Na mindegy, ezt a szekrényt át tudod helyezni nekem, kérlek?"}
{"category": "LocationDialogue Location1", "line_index": 37, "text": "Nekem nem megy, mert túúúúl nehéz... >.<"}
{"category": "LocationDialogue Location1", "line_index": 38, "text": "Nagyon köszönöm, édesem! <3"}
{"category": "LocationDialogue Location1", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 40, "text": "Ó, [player]! Alig telt el egy nap, de már annyira hiányoztál!"}
{"category": "LocationDialogue Location1", "line_index": 41, "text": "Bárcsak többször is meglátogatnál engem."}
{"category": "LocationDialogue Location1", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 43, "text": "Ez az enyém?"}
{"category": "LocationDialogue Location1", "line_index": 44, "text": "Köszönöm, köszönöm, nagyon köszönöm!"}
{"category": "LocationDialogue Location1", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 46, "text": "Szia, [player]! Törtem valamin a fejem..."}
{"category": "LocationDialogue Location1", "line_index": 47, "text": "Együtt lehetnénk, kettesben..."}
{"category": "LocationDialogue Location1", "line_index": 48, "text": "Olyan rossz, hogy ez lehetetlen..."}
{"category": "LocationDialogue Location1", "line_index": 49, "text": "Olyan rendes vagy hozzám, és sokat is segítesz nekem..."}
{"category": "LocationDialogue Location1", "line_index": 50, "text": "Bár viszonozni tudnám mindezt, amit tettél értem..."}
{"category": "LocationDialogue Location1", "line_index": 51, "text": "Hmm..."}
{"category": "LocationDialogue Location1", "line_index": 52, "text": "Van is egy ötletem..."}
{"category": "LocationDialogue Location1", "line_index": 53, "text": "Most már velem vagy!"}
{"category": "LocationDialogue Location1", "line_index": 54, "text": "Tedd le a telefont!"}
{"category": "LocationDialogue Location1", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 57, "text": "// T-shirt on the bed"}
{"category": "LocationDialogue Location1", "line_index": 58, "text": "Te meg mit téblábolsz az ágyamon?"}
{"category": "LocationDialogue Location1", "line_index": 59, "text": "// Rubik's Cube"}
{"category": "LocationDialogue Location1", "line_index": 60, "text": "Hát, eddig nem sok hasznát vettem ennek..."}
{"category": "LocationDialogue Location1", "line_index": 61, "text": "Egyszer megoldottam, aztán hozzá se értem többé."}
{"category": "LocationDialogue Location1", "line_index": 62, "text": "Lehet, mert másodjára már nem sikerülne?"}
{"category": "LocationDialogue Location1", "line_index": 63, "text": "// Computer"}
{"category": "LocationDialogue Location1", "line_index": 64, "text": "Nézzük..."}
{"category": "LocationDialogue Location1", "line_index": 65, "text": "Mik is a napi teendőim..."}
{"category": "LocationDialogue Location1", "line_index": 66, "text": "Karakter reakciók szkriptelése,"}
{"category": "LocationDialogue Location1", "line_index": 67, "text": "és talán még egy kis kódolás is..."}
{"category": "LocationDialogue Location1", "line_index": 68, "text": "// The airplane"}
{"category": "LocationDialogue Location1", "line_index": 69, "text": "Csak úgy szárnyal."}
{"category": "LocationDialogue Location1", "line_index": 70, "text": "// Trash in the corner"}
{"category": "LocationDialogue Location1", "line_index": 71, "text": "Sosincs időm kivinni a szemetet..."}
{"category": "LocationDialogue Location1", "line_index": 72, "text": "De hamarosan tényleg kiviszem."}
{"category": "LocationDialogue Location1", "line_index": 73, "text": "...mikor szokták kivinni a szemetet?"}
{"category": "LocationDialogue Location1", "line_index": 74, "text": "// Photo of a cat on a watermelon"}
{"category": "LocationDialogue Location1", "line_index": 75, "text": "Imádom..."}
{"category": "LocationDialogue Location1", "line_index": 76, "text": "Egy dinnyén restelő macska..."}
{"category": "LocationDialogue Location1", "line_index": 77, "text": "// Photo with a girl"}
{"category": "LocationDialogue Location1", "line_index": 78, "text": "Kicsit se hasonlítunk"}
{"category": "LocationDialogue Location1", "line_index": 79, "text": "a nővéremmel."}
{"category": "LocationDialogue Location1", "line_index": 80, "text": "Sokat járt ki a házból,"}
{"category": "LocationDialogue Location1", "line_index": 81, "text": "én meg, mint mindig, a házban ragadtam."}
{"category": "LocationDialogue Location1", "line_index": 82, "text": "// Photo with people"}
{"category": "LocationDialogue Location1", "line_index": 83, "text": "Hmm..."}
{"category": "LocationDialogue Location1", "line_index": 84, "text": "Az irodai élet tényleg belénk fúrta"}
{"category": "LocationDialogue Location1", "line_index": 85, "text": "az etikettet, igazam van?"}
{"category": "LocationDialogue Location1", "line_index": 86, "text": "Még mindig érzem azt a kapcsot..."}
{"category": "LocationDialogue Location1", "line_index": 87, "text": "De vajon"}
{"category": "LocationDialogue Location1", "line_index": 88, "text": "látni fogom"}
{"category": "LocationDialogue Location1", "line_index": 89, "text": "őket újra?"}
{"category": "LocationDialogue Location1", "line_index": 90, "text": "Egyáltalán minek tettem ki ezt a fotót?"}
{"category": "LocationDialogue Location1", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 93, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 99, "text": "// Nope name"}
{"category": "LocationDialogue Location1", "line_index": 100, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 101, "text": "Jaj ne..."}
{"category": "LocationDialogue Location1", "line_index": 102, "text": "Ezt a nevet nem fogadhatom el..."}
{"category": "LocationDialogue Location1", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 104, "text": "// Name Developer"}
{"category": "LocationDialogue Location1", "line_index": 105, "text": "Biztos a játékfejlesztő nevét választod?"}
{"category": "LocationDialogue Location1", "line_index": 106, "text": "Kicsit hízelgő..."}
{"category": "LocationDialogue Location1", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 108, "text": "// Bad name"}
{"category": "LocationDialogue Location1", "line_index": 109, "text": "Így nem hívhatod magad."}
{"category": "LocationDialogue Location1", "line_index": 110, "text": "Sajnálom, de nem engedhetem."}
{"category": "LocationDialogue Location1", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 112, "text": "// Go restart"}
{"category": "LocationDialogue Location1", "line_index": 113, "text": "Újra megkérdezem a neved, és légyszi, válaszolj rendesen. Jó?"}
{"category": "LocationDialogue Location1", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 115, "text": "// Name with numbers"}
{"category": "LocationDialogue Location1", "line_index": 116, "text": "Számokkal hivatod magad? Mármint, nem túl kreatív..."}
{"category": "LocationDialogue Location1", "line_index": 117, "text": "de nem ítélkezem."}
{"category": "LocationDialogue Location1", "line_index": 118, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 119, "text": "// Name Mita"}
{"category": "LocationDialogue Location1", "line_index": 120, "text": "Mita?"}
{"category": "LocationDialogue Location1", "line_index": 121, "text": "Rólam nevezted el magad?"}
{"category": "LocationDialogue Location1", "line_index": 122, "text": "vagy... téged is így hívnak?"}
{"category": "LocationDialogue Location1", "line_index": 123, "text": "Bocsi, de szerintem jobb lesz, ha én leszek az egyetlen Mita. ♪"}
{"category": "LocationDialogue Location1", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 125, "text": "// Day 10"}
{"category": "LocationDialogue Location1", "line_index": 126, "text": "Ó, hát itt vagy!"}
{"category": "LocationDialogue Location1", "line_index": 127, "text": "Elvesztettem a hajkefémet..."}
{"category": "LocationDialogue Location1", "line_index": 128, "text": "Meg tudod nekem keresni?"}
{"category": "LocationDialogue Location1", "line_index": 129, "text": "Lehet az éjjeliszekrényemben lesz, talán ott hagytam..."}
{"category": "LocationDialogue Location1", "line_index": 130, "text": "// Looked in the bedside table"}
{"category": "LocationDialogue Location1", "line_index": 131, "text": "Hmm, úgy látszik itt nincs."}
{"category": "LocationDialogue Location1", "line_index": 132, "text": "Lehet, máshol van?"}
{"category": "LocationDialogue Location1", "line_index": 133, "text": "Kérlek a sütőt ne nézd meg."}
{"category": "LocationDialogue Location1", "line_index": 134, "text": "Ott már kerestem."}
{"category": "LocationDialogue Location1", "line_index": 135, "text": "// Looked into the stove"}
{"category": "LocationDialogue Location1", "line_index": 136, "text": "Hé! Mondtam, hogy ne nézd meg ott!"}
{"category": "LocationDialogue Location1", "line_index": 137, "text": "Jó, fordulj meg, feltakarítok."}
{"category": "LocationDialogue Location1", "line_index": 138, "text": "Kész is! Folytassuk a keresést!"}
{"category": "LocationDialogue Location1", "line_index": 139, "text": "És... nem láttál semmit, jó?"}
{"category": "LocationDialogue Location1", "line_index": 140, "text": "// Found a hairbrush"}
{"category": "LocationDialogue Location1", "line_index": 141, "text": "Megtaláltad! Hálás vagyok!"}
{"category": "LocationDialogue Location1", "line_index": 142, "text": "Olyan kedves vagy!"}
