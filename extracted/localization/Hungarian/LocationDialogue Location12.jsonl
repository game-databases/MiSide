{"category": "LocationDialogue Location12", "line_index": 0, "text": "﻿"}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Te itt maradsz!"}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Szerintem elvesztettem valamit. Mindjárt jövök."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "Aztán majd visszajövök érted..."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Oké."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Játsszunk!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Plüssit akarom!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "Elvesztettem..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "KERESD MEG!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Hé..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "mit bámulsz?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Quest 1 (Who are you?)"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Mita vagyok."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "A legjobb Mita."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "A legelső Mita."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "Ezt mondta az én Mitám."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Quest 2 (Why do you look like that?)"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "Miért?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "Miért?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "Miért?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "Mitám azt mondta, hogy gyönyörű vagyok, és eredeti."}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "Én gyönyörű vagyok."}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Quest 3 (What was Mita doing here?)"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Elvisz engem..."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Elvisz engem egy új világba."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "Mitám meghívott az új világba."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Ott fogunk élni, és játszani az új világban."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Quest 4 (Why do you need a teddy bear?)"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "Olyan vagy,"}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "mint a plüssim."}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "Te is elvesztél, akárcsak a plüssim."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Quest 5 (Why is Mita angry?)"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "A..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "Mitám."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Játszani akar."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Csak velem akar"}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "játszani..."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Egyediek vagyunk,"}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "és nincs más."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Mita és Mitám...,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0.8A és 8Ě54*."}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Quest 6 (Do you believe Mita?)"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "Mitám."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "Legjobb barátom."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "Mitám."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "Nála nincs jobb barát."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "Te..."}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Te..."}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Játsszunk!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Megmutatom, hogy kell."}
