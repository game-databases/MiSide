{"category": "LocationDialogue Location10", "line_index": 0, "text": "﻿"}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "Ácsi, ácsi."}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "Ne olyan hangosan..."}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "Nagyon veszélyes tovább menned."}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "Egyáltalán"}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "te hogy kerülsz ide?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "Nos..."}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "A gyűrű vezetett ide."}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "Nem tudom pontosan hogyan."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "Gyűrű?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "Mi lelte ezt a helyet?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "Az orromig se látok."}
{"category": "LocationDialogue Location10", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "Majd elmondok mindent."}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "Most menj a főbejáraton át a játékgéphez. "}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "Ott találkozunk."}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Szedd a lábad, ne maradj le!"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// After mini-game"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "Most már érted?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "Azt, hogy én hús-vér ember vagyok, a Miták meg csontvázmodellekből vannak összeszerelve?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "Jesszumpepi...!"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "Olyan rémisztően hangzik, ha így rakod össze..."}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "de igen, kábé így van."}
{"category": "LocationDialogue Location10", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "És ezt miért jó tudnom?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "Nem hiába mondtam,"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "hogy innentől nagy veszély vár rád."}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "Azok az elhagyatott modellek..."}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "amelyek „hibás” jelzővel vannak ellátva..."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "nagyon veszélyesek, és meg is ölhetnek téged."}
{"category": "LocationDialogue Location10", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "Most mit csináljak?"}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Tudod mit? Inkább megyek,"}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "és az ajtókra bízom magam."}
{"category": "LocationDialogue Location10", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "Hát."}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "A lényeg, hogy ne fordíts hátat nekik."}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "Mindig a szemed előtt tartsd őket."}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "Ha őket bámulod, nem fognak elmozdulni."}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "Nagyon szégyenlősek."}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "Ezt jól jegyezd meg."}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// Quest 1 (Why are there other Mitas down there?)"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "Ezek új prototípusok."}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "Még időre van szükségük,"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "hogy tudatra ébredjenek."}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "Miután az megvan,"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "elvezetem őket az új otthonukba."}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// Quest 2 (Why is it so dark downstairs?)"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "Minket a sötétben „alkottak,”"}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "és így időre van szükségünk átszokni a világosságra."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Nem jó érzés,"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "ha a sötétség hirtelen szemvakító világosságra vált."}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// Quest 3 (What are you doing here?)"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "Nem egyértelmű?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "Az új Mitákat segítem ki."}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "Nélkülem nem jutnának sokra."}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "De veled sem."}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// Quest 4 (Why do we need this conveyor?)"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "Mire való az a futószalag?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "Minden Mita számára jut hely?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Ne mondd, hogy nem tudod"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "hogy működik ez a világ..."}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "Azt se tudod, hogy az végtelen?"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "Végtelen?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "És..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "hogy érted, hogy végtelen?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "Ha az 1.9-es verzió a legfrissebb,"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "nem azt jelenti, hogy csak 19 világ van?"}
{"category": "LocationDialogue Location10", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "Ó, jesszumpepi,"}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "bizony be kell foltozni a hiányosságokat..."}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Ha szeretnéd,"}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "elmagyarázok mindent"}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "ezen a táblán."}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// Quest 5 (What is your version?)"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Várj,"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "olyan ismerős vagy nekem..."}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "Nem találkoztunk már?"}
{"category": "LocationDialogue Location10", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "Lehetséges."}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Én az 1.5-ös verzióból származom."}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "Jártál már ott?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Igen."}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "Abba a verzióba érkeztem,"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "amikor ebbe a világba teleportáltak!"}
{"category": "LocationDialogue Location10", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "Nohát!"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "Hogy lehetséges?"}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "Melyik házindexben voltál?"}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "Létezik egy olyan „én,” amelyik folyton nyafog..."}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "meg amelyik szeret viccelődni..."}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "olyan is van, amelyik sokat felejt, és szeret bújócskázni..."}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "Hosszú a lista."}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Mondd, ő melyik volt?"}
{"category": "LocationDialogue Location10", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Sötét volt a házban."}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "A falakon meg írások voltak."}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "Olyanok, mint"}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "„Játszunk?”"}
{"category": "LocationDialogue Location10", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "Ó,"}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "érdekes..."}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "Pont azzal az „énnel” találkoztál"}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "amelyik szeret bújócskázni."}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// Mita wants to tell you [No]"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Köszi, de nem kell."}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Jobb, hogy nem tudok semmit."}
{"category": "LocationDialogue Location10", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "Ahogy akarod."}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// Mita wants to tell you [Yes]."}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "Felőlem, mondd."}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "De ez ugye nem olyan, mint a suliban?"}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "Annyira unatkoztam ott, hogy elaludtam."}
{"category": "LocationDialogue Location10", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "Nem kényszerítelek,"}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "de ha érdekel,"}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "akkor elmondom."}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "Egy játékos letölti a MiSide-ot,"}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "és elindítja a programot."}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "Ezzel így"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "egy új ház jön létre egy új Mitával."}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "A táblán lévő elemek ezt jól reprezentálják."}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "A vonalak mutatják"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "a különböző verziókat."}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "A verziókon belül házakat találsz."}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "Mondjuk letöltöd az 1.14-es verziót."}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "Ekkor egy új élet jön létre,"}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "azaz egy új Mita, és egy új ház."}
{"category": "LocationDialogue Location10", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "Bámulatos..."}
{"category": "LocationDialogue Location10", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Kérdezz bármit"}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "amit a táblán látsz,"}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "és megpróbálom kifejteni neked."}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// He asks about the only circle"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "Itt miért csak egy nagy kör van?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "Azt a verziót"}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "csak egyetlen egyszer adták ki."}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "Ez a legkülönlegesebb verziója az egész játéknak."}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "Azért is különleges,"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "mert nincs átjárója más verziókhoz."}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "Hétalvó-Mita él ott, az 1.1-es verzióban."}
{"category": "LocationDialogue Location10", "line_index": 171, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "Hétalvó-Mita?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "Vagyis olyan szupererővel rendelkezik,"}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "hogy minden odatévedőt örökre elaltat?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "Dehogyis."}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "Akármilyen hangos zajt csapsz a füle mellett,"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "lehetetlen felkelteni őt."}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// He asks about the shaded circle"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "Ez a kör miért van besatírozva?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "Azért, mert"}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "Ari-Mitával versenyeztünk."}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "Ő satírozta be."}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "Azon ment a verseny,"}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "hogy ki tud az 1.11-es verzióba érni gyorsabban."}
{"category": "LocationDialogue Location10", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "És ki nyert?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "Én, ki más?"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "Ezt nézd..."}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "az 1.15-ös verzióban vagyunk,"}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "a 809-es házindexben."}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "onnan az 1.11-es verzióba,"}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "a 805-ös házindexbe kellene érni."}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Általában így tudunk átmenni a másik verzióba."}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "De azt megpróbáltuk lerövidíteni."}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "Ari-Mita ezt az utat vetette fel."}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "Én meg előálltam"}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "a világ legrövidebb útjával."}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Mégpedig ezzel, itt ni."}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "Ez az út közvetlenül az 1.11-eshez vezet."}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Egy hajszálon múlt,"}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "hogy az a ház blokkolja az utat."}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "A gyűrűd hasonlóképpen működik."}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "Hová tartasz?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "A Maghoz."}
{"category": "LocationDialogue Location10", "line_index": 210, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "A Maghoz, mi?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "Hmm..."}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Ha a legrövidebb utat keresed,"}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "Neked az 1.11-es verzión keresztül kell menned."}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "Biztosan találkozni fogsz Hétalvó-Mitával."}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Szerintem a te Mitád, az, aki ideküldött,"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "ő is azon az úton ment."}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "Egyáltalán tudja, te melyik úton mész?"}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "Vagy lehet, hogy ő előre gondolt,"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "és tud egy ennél rövidebb utat?"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Szerintem értem."}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// He asks about the inscription"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "Ez meg mi?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "Ez Fitt-Mitának van."}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "Pár óra múlva itt lesz."}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "Az ő feladata, a dobozokat elvinni,"}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "és a kanapét a dobozok helyére tenni."}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "Én nem bírom el!"}
{"category": "LocationDialogue Location10", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Hát..."}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "Segíthetek?"}
{"category": "LocationDialogue Location10", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "Bocsi, ez kizárólag Fitt-Mita feladata."}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Ő nagyon fitt."}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// He asks about the drawings"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "Ennek van valami fontos jelentősége?"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "vagy"}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "ez csak egy sima rajz?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 244, "text": "Nincs."}
{"category": "LocationDialogue Location10", "line_index": 245, "text": "Ez csak egy sima irka-firka."}
