{"category": "Achievements", "line_index": 0, "text": "Tejből tejföl"}
{"category": "Achievements", "line_index": 1, "text": "Csettintésből sötétség"}
{"category": "Achievements", "line_index": 2, "text": "A lé már nem él"}
{"category": "Achievements", "line_index": 3, "text": "Majd ha fagy!"}
{"category": "Achievements", "line_index": 4, "text": "Széfbe zárt élet"}
{"category": "Achievements", "line_index": 5, "text": "Légy a légykirály"}
{"category": "Achievements", "line_index": 6, "text": "Ó, drága Mita!"}
{"category": "Achievements", "line_index": 7, "text": "Megvagy!"}
{"category": "Achievements", "line_index": 8, "text": "A szeretet fincsi szósza"}
{"category": "Achievements", "line_index": 9, "text": "Feladat teljesítve!"}
{"category": "Achievements", "line_index": 10, "text": "Taposs a gázra!"}
{"category": "Achievements", "line_index": 11, "text": "Csak a fejemet ne!"}
{"category": "Achievements", "line_index": 12, "text": "Megszerezve hát mind!"}
{"category": "Achievements", "line_index": 13, "text": "Mizújs, Mita?"}
{"category": "Achievements", "line_index": 14, "text": "Itt a vége, fuss el véle!"}
{"category": "Achievements", "line_index": 15, "text": "Teljes sebességgel előre!"}
{"category": "Achievements", "line_index": 16, "text": "Ez egy teljesítmény?"}
{"category": "Achievements", "line_index": 17, "text": "Tánclábú!"}
{"category": "Achievements", "line_index": 18, "text": "A kígyó kígyózik"}
{"category": "Achievements", "line_index": 19, "text": "Belépés megtagadva!"}
{"category": "Achievements", "line_index": 20, "text": "Kockázatos játszma 1."}
{"category": "Achievements", "line_index": 21, "text": "Kockázatos játszma 2."}
{"category": "Achievements", "line_index": 22, "text": "Pokolian profi!"}
{"category": "Achievements", "line_index": 23, "text": "Csont nélkül?!"}
{"category": "Achievements", "line_index": 24, "text": "A répa jót tesz a szemnek"}
{"category": "Achievements", "line_index": 25, "text": "Teljes teljesítmény teljesítő"}
