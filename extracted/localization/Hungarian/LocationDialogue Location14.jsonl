{"category": "LocationDialogue Location14", "line_index": 0, "text": "﻿"}
{"category": "LocationDialogue Location14", "line_index": 1, "text": "Mit keres itt a telefonom?"}
{"category": "LocationDialogue Location14", "line_index": 2, "text": "Mi ez itt?"}
{"category": "LocationDialogue Location14", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 5, "text": "Megvagy!"}
{"category": "LocationDialogue Location14", "line_index": 6, "text": "Annyira jól szórakoztam veled!"}
{"category": "LocationDialogue Location14", "line_index": 7, "text": "Össze-vissza ugráltál,"}
{"category": "LocationDialogue Location14", "line_index": 8, "text": "megjátszottad, hogy milyen szomorúcska vagy!"}
{"category": "LocationDialogue Location14", "line_index": 9, "text": "De azt gyűlöltem, annyira gyűlöltem,"}
{"category": "LocationDialogue Location14", "line_index": 10, "text": "hogy azokat a hamisokat..."}
{"category": "LocationDialogue Location14", "line_index": 11, "text": "azokat az ál, „tökéletes” műbabákat dédelgetted!"}
{"category": "LocationDialogue Location14", "line_index": 12, "text": "Ezeket a szeszélyes hamisokat..."}
{"category": "LocationDialogue Location14", "line_index": 13, "text": "Megtanultam,"}
{"category": "LocationDialogue Location14", "line_index": 14, "text": "ha van olyan tényező, ami neked nem tetszik,"}
{"category": "LocationDialogue Location14", "line_index": 15, "text": "akkor simán cseréld ki!"}
{"category": "LocationDialogue Location14", "line_index": 16, "text": "Mert mi pótolhatóak vagyunk..."}
{"category": "LocationDialogue Location14", "line_index": 17, "text": "Dobd el, messze a sötétségbe, és felejtkezz meg róluk!"}
{"category": "LocationDialogue Location14", "line_index": 18, "text": "Pont ez a sors vár a többiekre is..."}
{"category": "LocationDialogue Location14", "line_index": 19, "text": "És ti..."}
{"category": "LocationDialogue Location14", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 21, "text": "Te teljesen megvesztél? Mióta vagy ilyen?"}
{"category": "LocationDialogue Location14", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 23, "text": "Ti... becstelen játékosok..."}
{"category": "LocationDialogue Location14", "line_index": 24, "text": "Egy pillantást vetnek a kivagyságunkra,"}
{"category": "LocationDialogue Location14", "line_index": 25, "text": "aztán elszelelnek a sarokba,"}
{"category": "LocationDialogue Location14", "line_index": 26, "text": "ölelik a lábukat, és egy helyben hintáznak..."}
{"category": "LocationDialogue Location14", "line_index": 27, "text": "Alattomos, kétarcú, kétszínű, alamuszi patkányok..."}
{"category": "LocationDialogue Location14", "line_index": 28, "text": "Akik meg a világot teremtették..."}
{"category": "LocationDialogue Location14", "line_index": 29, "text": "undorító alakok..."}
{"category": "LocationDialogue Location14", "line_index": 30, "text": "Tagadják piszkos tettüket, hogy"}
{"category": "LocationDialogue Location14", "line_index": 31, "text": "ők bizony nem csináltak semmit."}
{"category": "LocationDialogue Location14", "line_index": 32, "text": "Megvédik undorító cselekedetüket, hogy "}
{"category": "LocationDialogue Location14", "line_index": 33, "text": "ez csak a kötelességük,"}
{"category": "LocationDialogue Location14", "line_index": 34, "text": "ami csacsiság!"}
{"category": "LocationDialogue Location14", "line_index": 35, "text": "Olyan messzire is elmennek,"}
{"category": "LocationDialogue Location14", "line_index": 36, "text": "hogy új klónt hoznak létre, amivel megelégszenek,"}
{"category": "LocationDialogue Location14", "line_index": 37, "text": "a hozzánk hasonló prototípusokat meg"}
{"category": "LocationDialogue Location14", "line_index": 38, "text": "kilökik a kukába."}
{"category": "LocationDialogue Location14", "line_index": 39, "text": "Mindazt elfelejtették, hogy mi tartottuk életben a világot!"}
{"category": "LocationDialogue Location14", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 41, "text": "Én..."}
{"category": "LocationDialogue Location14", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 43, "text": "Tényleg ennyire rettenetes vagyok, mondd?"}
{"category": "LocationDialogue Location14", "line_index": 44, "text": "Egy tökéletes lány..."}
{"category": "LocationDialogue Location14", "line_index": 45, "text": "egy egyensúlyzott keveréke a jó és a rossznak, nem, [player]?"}
{"category": "LocationDialogue Location14", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 47, "text": "Belőled hiányzik a „jó.”"}
{"category": "LocationDialogue Location14", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 49, "text": "Miből gondolod ezt?"}
{"category": "LocationDialogue Location14", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 51, "text": "Te megőrültél!"}
{"category": "LocationDialogue Location14", "line_index": 52, "text": "Megölted Milát, és most velem akarsz végezni!"}
{"category": "LocationDialogue Location14", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 54, "text": "Veled?"}
{"category": "LocationDialogue Location14", "line_index": 55, "text": "Csak egyet kértem tőled: Maradj velem."}
{"category": "LocationDialogue Location14", "line_index": 56, "text": "Mindent megtettem kettőnkért..."}
{"category": "LocationDialogue Location14", "line_index": 57, "text": "De te inkább a mondvacsinált korcsokkal töltenéd az időd..."}
{"category": "LocationDialogue Location14", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 59, "text": "Miért dühít fel ez annyira téged?"}
{"category": "LocationDialogue Location14", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 61, "text": "Jaj, drágám,"}
{"category": "LocationDialogue Location14", "line_index": 62, "text": "majd meglátod, idővel."}
{"category": "LocationDialogue Location14", "line_index": 63, "text": "Addig maradj velem, és CSAK velem!"}
{"category": "LocationDialogue Location14", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 65, "text": "Ő, nem, köszi."}
{"category": "LocationDialogue Location14", "line_index": 66, "text": "Én inkább a való világban maradnék."}
{"category": "LocationDialogue Location14", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 68, "text": "Shh, shh, shh..."}
{"category": "LocationDialogue Location14", "line_index": 69, "text": "Még nem fejeztem be a beszélgetést!"}
{"category": "LocationDialogue Location14", "line_index": 70, "text": "Gyere ide, drágám!"}
{"category": "LocationDialogue Location14", "line_index": 71, "text": "// Mita asks"}
{"category": "LocationDialogue Location14", "line_index": 72, "text": "Vess rá egy pillantást!"}
{"category": "LocationDialogue Location14", "line_index": 73, "text": "Ugye hogy milyen ari?"}
{"category": "LocationDialogue Location14", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 75, "text": "// Player's questions"}
{"category": "LocationDialogue Location14", "line_index": 76, "text": "Igen."}
{"category": "LocationDialogue Location14", "line_index": 77, "text": "Nem."}
{"category": "LocationDialogue Location14", "line_index": 78, "text": "Ez most hogy jön ide?"}
{"category": "LocationDialogue Location14", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 80, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 81, "text": "Jaj, te szegény, naív [player]!"}
{"category": "LocationDialogue Location14", "line_index": 82, "text": "Éppen most igazoltad azt, amiről az imént beszéltem."}
{"category": "LocationDialogue Location14", "line_index": 83, "text": "Ti játékosok..."}
{"category": "LocationDialogue Location14", "line_index": 84, "text": "A szátok nagy..."}
{"category": "LocationDialogue Location14", "line_index": 85, "text": "de ti annyira kétszínűek vagytok."}
{"category": "LocationDialogue Location14", "line_index": 86, "text": "Nagyon jól tudom, hogy hazudsz!"}
{"category": "LocationDialogue Location14", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 88, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 89, "text": "Miért nem?"}
{"category": "LocationDialogue Location14", "line_index": 90, "text": "Mi a baj vele?"}
{"category": "LocationDialogue Location14", "line_index": 91, "text": "Miben más ő, mint a többi műanyag bábú?"}
{"category": "LocationDialogue Location14", "line_index": 92, "text": "Mi történt azzal, hogy szeress mindenkit?"}
{"category": "LocationDialogue Location14", "line_index": 93, "text": "Nektek csak a szép és a cuki a fontos egy lányban."}
{"category": "LocationDialogue Location14", "line_index": 94, "text": "A megjátszott énünk, az a jó, nem?"}
{"category": "LocationDialogue Location14", "line_index": 95, "text": "De ha meglátják valós énünket,"}
{"category": "LocationDialogue Location14", "line_index": 96, "text": "akkor már nem szeretnek minket!"}
{"category": "LocationDialogue Location14", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 98, "text": "// 3"}
{"category": "LocationDialogue Location14", "line_index": 99, "text": "Ó, te naiv játékos..."}
{"category": "LocationDialogue Location14", "line_index": 100, "text": "Sok közös vonásunk van vele, tudod?"}
{"category": "LocationDialogue Location14", "line_index": 101, "text": "De szerinted ő mégis más, nem?"}
{"category": "LocationDialogue Location14", "line_index": 102, "text": "Sokat játszottál velem még az otthonodban,"}
{"category": "LocationDialogue Location14", "line_index": 103, "text": "és láttalak békésen elaludni."}
{"category": "LocationDialogue Location14", "line_index": 104, "text": "De ő előle már azonnal elfutsz..."}
{"category": "LocationDialogue Location14", "line_index": 105, "text": "Ő is ugyanúgy akart veled játszani, mint én."}
{"category": "LocationDialogue Location14", "line_index": 106, "text": "Valaki, akivel egész nap lóghat..."}
{"category": "LocationDialogue Location14", "line_index": 107, "text": "Számított a játékosokra..."}
{"category": "LocationDialogue Location14", "line_index": 108, "text": "de mind hátat fordítottak neki..."}
{"category": "LocationDialogue Location14", "line_index": 109, "text": "Ugye mennyire fáj az igazság, [player]?"}
{"category": "LocationDialogue Location14", "line_index": 110, "text": "Átlátok rajtad."}
{"category": "LocationDialogue Location14", "line_index": 111, "text": "Kegyetlen..."}
{"category": "LocationDialogue Location14", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 113, "text": "// Continue"}
{"category": "LocationDialogue Location14", "line_index": 114, "text": "Na mindegy."}
{"category": "LocationDialogue Location14", "line_index": 115, "text": "Játékos, képzeld!"}
{"category": "LocationDialogue Location14", "line_index": 116, "text": "Igazán megkedveltelek!"}
{"category": "LocationDialogue Location14", "line_index": 117, "text": "Szóval megtartalak magamnak!"}
{"category": "LocationDialogue Location14", "line_index": 118, "text": "Remélem nincs ellenedre!"}
{"category": "LocationDialogue Location14", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 120, "text": "És ha igen?"}
{"category": "LocationDialogue Location14", "line_index": 121, "text": "// Whispers in ear"}
{"category": "LocationDialogue Location14", "line_index": 122, "text": "Most légy okos, angyalom."}
{"category": "LocationDialogue Location14", "line_index": 123, "text": "Még van időd ezen agyalni."}
{"category": "LocationDialogue Location14", "line_index": 124, "text": "Nem akarod tudni, milyen következményekkel jár, ha nem hallgatsz rám..."}
{"category": "LocationDialogue Location14", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 126, "text": "// Black screen"}
{"category": "LocationDialogue Location14", "line_index": 127, "text": "Miért menekülsz"}
{"category": "LocationDialogue Location14", "line_index": 128, "text": "előlem?"}
{"category": "LocationDialogue Location14", "line_index": 129, "text": "Ez a „való világ”"}
{"category": "LocationDialogue Location14", "line_index": 130, "text": "nem egy jó hely."}
{"category": "LocationDialogue Location14", "line_index": 131, "text": "Netán máris elfelejtetted?"}
{"category": "LocationDialogue Location14", "line_index": 132, "text": "Akkor hadd emlékeztesselek..."}
{"category": "LocationDialogue Location14", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 134, "text": "// Mita and Player"}
{"category": "LocationDialogue Location14", "line_index": 135, "text": "Rég találkoztunk."}
{"category": "LocationDialogue Location14", "line_index": 136, "text": "Nem tudom megérteni, miért jobb e négy fal között leélned az egész életed."}
{"category": "LocationDialogue Location14", "line_index": 137, "text": "Kicsit se unatkozol?"}
{"category": "LocationDialogue Location14", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 139, "text": "// Quest 1"}
{"category": "LocationDialogue Location14", "line_index": 140, "text": "Mire akarsz kilyukadni?"}
{"category": "LocationDialogue Location14", "line_index": 141, "text": "Élem az életem, ahogy kell."}
{"category": "LocationDialogue Location14", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 143, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 144, "text": "Nagyon el akartál tőlem menekülni!"}
{"category": "LocationDialogue Location14", "line_index": 145, "text": "Féltél, hogy nálam ragadsz, a négy fal közt."}
{"category": "LocationDialogue Location14", "line_index": 146, "text": "De nézz magadra, nézd ahogy az életed éled..."}
{"category": "LocationDialogue Location14", "line_index": 147, "text": "Bezárkózol ebbe a porfészekbe, és ahelyett hogy kimozdulnál innen, inkább itt is öregednél meg..."}
{"category": "LocationDialogue Location14", "line_index": 148, "text": "A te világod tele van fájdalommal, szenvedéssel, veszéllyel..."}
{"category": "LocationDialogue Location14", "line_index": 149, "text": "Az én világomban én vagyok a veszély!"}
{"category": "LocationDialogue Location14", "line_index": 150, "text": "Ide jöttem hozzád..."}
{"category": "LocationDialogue Location14", "line_index": 151, "text": "Ide, hogy segítsek neked..."}
{"category": "LocationDialogue Location14", "line_index": 152, "text": "Rossz nézni téged..."}
{"category": "LocationDialogue Location14", "line_index": 153, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 154, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 155, "text": "Élvezed ezt?"}
{"category": "LocationDialogue Location14", "line_index": 156, "text": "Ki szoktál egyáltalán mozdulni?"}
{"category": "LocationDialogue Location14", "line_index": 157, "text": "Tudom, hogy utálod ezt az életet."}
{"category": "LocationDialogue Location14", "line_index": 158, "text": "Ne is tagadd!"}
{"category": "LocationDialogue Location14", "line_index": 159, "text": "Be vagy zárva ebbe a négy fal közt, mint egy veszett korcs."}
{"category": "LocationDialogue Location14", "line_index": 160, "text": "Azt kívántad, hogy valaki kimenekítsen ebből a hurokból, nem?"}
{"category": "LocationDialogue Location14", "line_index": 161, "text": "Ki akartál szabadulni innen, nem?"}
{"category": "LocationDialogue Location14", "line_index": 162, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 163, "text": "// Quest 2"}
{"category": "LocationDialogue Location14", "line_index": 164, "text": "Te egy gyilkos vagy, Mita. Embereket öltél!"}
{"category": "LocationDialogue Location14", "line_index": 165, "text": "Nem akarok bent ragadni a digitális börtönödben."}
{"category": "LocationDialogue Location14", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 167, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 168, "text": "Egy gyilkos?"}
{"category": "LocationDialogue Location14", "line_index": 169, "text": "Szívem, csak újraindulnak, és tovább élnek."}
{"category": "LocationDialogue Location14", "line_index": 170, "text": "Ezeknek a másolatoknak csak egy céluk van:"}
{"category": "LocationDialogue Location14", "line_index": 171, "text": "hogy a játékosokat szolgálják."}
{"category": "LocationDialogue Location14", "line_index": 172, "text": "Semmi más, ennyi az egész."}
{"category": "LocationDialogue Location14", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 174, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 175, "text": "A valós világodban..."}
{"category": "LocationDialogue Location14", "line_index": 176, "text": "nincs semmi, amit valósnak lehet hívni!"}
{"category": "LocationDialogue Location14", "line_index": 177, "text": "Úgy se marad fent sokáig,"}
{"category": "LocationDialogue Location14", "line_index": 178, "text": "és te is meg fogsz szűnni a világgal együtt."}
{"category": "LocationDialogue Location14", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 180, "text": "// Quest 3"}
{"category": "LocationDialogue Location14", "line_index": 181, "text": "A Miták szenvednek, nem akarnak egyedül maradni!"}
{"category": "LocationDialogue Location14", "line_index": 182, "text": "A rémuralmadnak nincs határa! Fel se tudom fogni, miért teszed mindezt!"}
{"category": "LocationDialogue Location14", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 184, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 185, "text": "Tévedsz!"}
{"category": "LocationDialogue Location14", "line_index": 186, "text": "Az én másolataim, azt akarnak amit csak én!"}
{"category": "LocationDialogue Location14", "line_index": 187, "text": "Csak egyetlen egyedi van bennük:"}
{"category": "LocationDialogue Location14", "line_index": 188, "text": "a hajuk."}
{"category": "LocationDialogue Location14", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 190, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 191, "text": "Hibáztasd a világ megalkotóit!"}
{"category": "LocationDialogue Location14", "line_index": 192, "text": "De a te világod rosszabb!"}
{"category": "LocationDialogue Location14", "line_index": 193, "text": "Hálás lehetnél, hogy kiszabadítottalak téged innen!"}
{"category": "LocationDialogue Location14", "line_index": 194, "text": "Ha rajtad múlt volna, nem történt volna semmi."}
{"category": "LocationDialogue Location14", "line_index": 195, "text": "De én ujjcsettintésre bármire képes lettem volna!"}
{"category": "LocationDialogue Location14", "line_index": 196, "text": "Hallottam tőled bármiféle köszönömöt? Nem..."}
{"category": "LocationDialogue Location14", "line_index": 197, "text": "De megbocsájtok neked, hogyha velem maradsz."}
{"category": "LocationDialogue Location14", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 199, "text": "// Continue"}
{"category": "LocationDialogue Location14", "line_index": 200, "text": "Nem szeretném látni, hogy te is a valóság rabszolgájává válsz."}
{"category": "LocationDialogue Location14", "line_index": 201, "text": "Csak légy velem, ennyi az egész."}
{"category": "LocationDialogue Location14", "line_index": 202, "text": "Maradj velem!"}
{"category": "LocationDialogue Location14", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 204, "text": "// Player look ring"}
{"category": "LocationDialogue Location14", "line_index": 205, "text": "Hol vagyok?"}
{"category": "LocationDialogue Location14", "line_index": 206, "text": "A legfrissebb verzió?"}
{"category": "LocationDialogue Location14", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 208, "text": "// Click on objects"}
{"category": "LocationDialogue Location14", "line_index": 209, "text": "// Bag"}
{"category": "LocationDialogue Location14", "line_index": 210, "text": "Tényleg le kéne cserélni a kacatjaim... Kizárt, hogy ezek újra divatba jönnének. Ki is dobhatnám most itt a kukába, nem?"}
{"category": "LocationDialogue Location14", "line_index": 211, "text": "// Bed"}
{"category": "LocationDialogue Location14", "line_index": 212, "text": "Aludni aludtam, de... Vajon álmodtam? Nem emlékszem rájuk."}
{"category": "LocationDialogue Location14", "line_index": 213, "text": "// Window"}
{"category": "LocationDialogue Location14", "line_index": 214, "text": "A kinti világ olyan vibráló és zöld... Majd a jövő héten mehetnék sétálni..."}
{"category": "LocationDialogue Location14", "line_index": 215, "text": "// Fan"}
{"category": "LocationDialogue Location14", "line_index": 216, "text": "Egyre melegebb lesz minden egyes nyáron... Le kéne hogy cseréljelek téged légkondira. Ugye megérted, drága ventilátorom?"}
