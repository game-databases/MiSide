{"category": "LocationDialogue Location8", "line_index": 0, "text": "﻿// The first meeting"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "Te meg ki vagy?"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "Mi a bajod?"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "Szólalj már meg!"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "Várj..."}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "El akarsz innen menni?"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "Igen..."}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "Vissza kell mennem."}
{"category": "LocationDialogue Location8", "line_index": 11, "text": "Vissza, az előző verzióba."}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "Az előző verzióba?"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "Miért akarsz innen"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "elmenni?"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "Miért nem maradsz itt,"}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "és leszel a"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "második barátom?"}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Skipping all dialogs"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "Hát jó..."}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Standing by the window (Random)"}
{"category": "LocationDialogue Location8", "line_index": 24, "text": "Hiába próbálsz megszökni..."}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "...az ajtók úgyse segítenek."}
{"category": "LocationDialogue Location8", "line_index": 26, "text": "Ugye tudod, hogy csak körbe-körbe futsz?"}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "Nagyon siethetsz..."}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "Nézz ki ezen az ablakon."}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Aren't you Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "Te egy játékos vagy, nem?"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": "Akkor együtt játszhatunk!"}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "Ha lesz életerőm..."}
{"category": "LocationDialogue Location8", "line_index": 35, "text": "Játssz velem, és akkor lesz életerőm!"}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (What happened to you?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "Bizonytalan vagyok..."}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "Nem hiszem, hogy bármi történt volna."}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "De azt hiszem, hogy minden ami jó volt, már rossz."}
{"category": "LocationDialogue Location8", "line_index": 41, "text": "De legalább van egy barátom."}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "Miért futottak el a többiek tőlem?"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "Nem voltam elég nekik?"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "Annyira... félek..."}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Quest 3 (Become a second friend?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "Nincs sok..."}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "barátom."}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "Csak egy van."}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "Olyan szomorú vagyok."}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "Te nem akarsz a barátom lenni?"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "Nagyon szívesen leszek,"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "de sietnem kell..."}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "A szívem... fáj..."}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Is this your house?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "Ház?"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "Játékos.. te olyan más vagy..."}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "Rövidebbek lettek a karjaid, és már nem vagy olyan félelmetes..."}
{"category": "LocationDialogue Location8", "line_index": 62, "text": "Te sokkal kedvesebb lettél, játékos!"}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "Fogalmam sincs,"}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "miről beszélsz."}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "Semmi gond."}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "Már nem fáj többé."}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (How do I leave this place?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "Te is el akarsz tőlem menekülni?"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "Ez lenne az én..."}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "végzetem?"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "A végzeted?"}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": "Az ajtók nem segítenek."}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Hold player (Random)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "Ne menj el."}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "Maradj még..."}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "Játsszunk együtt!"}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "Játékos..."}
