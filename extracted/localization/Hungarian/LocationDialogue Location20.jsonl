{"category": "LocationDialogue Location20", "line_index": 0, "text": "﻿"}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Mila! Ne! Te nem vagy normális!"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Nocsak, mit látnak szemeim?"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "Az arcodon végre látom az érzéseid!"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "Gyerünk, fordulj meg, hadd lássak többet!"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "Őszintén, már annyira untam a monotón képed!"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\""}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "Hogy vagyunk ma, szegény kicsi vándorlóm?"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "Látom, még mindig nem untad meg a futást!"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Mit tettél Milával?"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "Még mindig a múltban ragadtál, gyermekem?"}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Tudod mit? Mi lenne, ha eljátszadozgatnánk egy icipicit?"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "Te-"}
{"category": "LocationDialogue Location20", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "Kezdésképpen miért ne teszteljük le"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "az irányérzékedet?"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "Légy résen!"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "Ki tudja, lehet leépültél!"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "Lehet hogy meg se érdemled,"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "hogy hordjad azt a BŐRT magadon!"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "Nocsak, mik ezek?"}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "Melyik fogja kiszúrni előbb a szemed?"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "A jobb,"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "vagy talán"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "a bal?"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "Jaj, drágám!"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "Egyáltalán számít ez?"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "Csak veled szórakozok!"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "A szurkálás már úgy is régimódi!"}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "Annyi baj legyen!"}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "Ennél jobban fogunk szórakozni, ígérem!"}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "Most figyelj..."}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "Ide nézz!"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Zene nélkül unalmas lenne!"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "Mit gondolsz, tetszik a szám?"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "Olyan vérpezsdítő!"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "Most hegyezd a füled,"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "mert elmondom a szabályokat!"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rules"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "Addig fuss,"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "amíg szól a szám."}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "De amint leáll a melódia,"}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "EGY PORCIKÁDAT SE MOZDÍTSD!"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "Különben az életeddel fizetsz."}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "Juss át a pályán,"}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "mielőtt végetér a szám."}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "Akkor kezdjük!"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "Kíváncsi vagyok, meddig bírod."}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Most csak fusssssss!"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "Ó!"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Nézd hogy hallgat rám!"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Hogy engedelmeskedik nekem..."}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Annnnyira akarlak magamnak!"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "Ugye hogy egyszerű volt?"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "Engedj el!"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "Na de ne hidd azt, hogy ilyen könnyű dolgod lesz végig!"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "Nem csak ezzel a játékkal készültem ma neked!"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "Következő játék:"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Befogom csukni a szemem,"}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "és ha kinyitom,"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "imádkozz,"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "hogy ne vegyelek észre!"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "De viszont ha észreveszlek, megbüntetlek!"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Akkor kezdődjék a játék!"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "Ennek mi értelme van..."}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "Ez is sikerült!"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Ez annyira, de annyira vérpezsdítő!"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "De ennél nehezebb lesz!"}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "SOKKAL nehezebb!"}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Menekülj, ha tudsz!"}
{"category": "LocationDialogue Location20", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "A pokolba veled!"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Player falls"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "Szerintem sikerült megszöknöm..."}
