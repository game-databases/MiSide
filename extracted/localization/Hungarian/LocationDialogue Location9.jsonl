{"category": "LocationDialogue Location9", "line_index": 0, "text": "﻿"}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Hé, te!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Üdv!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Meg akarsz innen lógni, jól értem?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Akkor segíts! A kulcsot keresem!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Nem látok semmilyen kulcsot!"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Itt nincs semmi!"}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "Üres, mint a türelmem!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Hát itt van!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// The usual conversation"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Ó, azt hittem kisebb vagy!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "Te is magas vagy..."}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "mint a rokonom!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "A rokonod? Az kicsoda?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Igen, a rokonom."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Ne mondd, hogy még nem találkoztál vele!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Ő... találkozni? Asszem megvolt."}
{"category": "LocationDialogue Location9", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Fejedre ejtettek kiskorodban?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "Tessék?"}
{"category": "LocationDialogue Location9", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "És a felfogásod is lassú."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "Mindegy, csak találjuk már meg a kulcsot!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// Next work"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Ide gyere!"}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Tedd a vasakat a csőbe!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Köszönöm."}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "Ide adod a fákat?"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Köszönöm."}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Kis segítség?"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Köszönöm. Na most..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "Lassan szépül..."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Nyomd meg."}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Tessék,"}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "vedd el a kulcsot."}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "A tiéd."}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// Quest 1 (Are you Mita?)"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Becses nevem „CsibiMita.fbx!”"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Tengernyi kódokkal,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "egyszerű anyaggal,"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "és a legszebb hajjal megáldva."}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// Quest 2 (Have we seen each other yet?)"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Butuska!"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "Ne legyél már ennyire cuki"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "a kérdéseiddel!"}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "De nem,"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "még ezelőtt nem találkoztunk."}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "De én..."}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "De ha ellopod a kinézetem,"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "meglakolsz."}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// Quest 3 (Why are you here?)"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Nem egyértelmű?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "Ez egy ellenőrző pont:"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "a megoldóképességeidet ellenőrizzük!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "Én vagyok az,"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "aki a szerencsétleneket segíti ki."}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// Quest 4 (Why are you helping me?)"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "Szerinted?"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "Te talán különleges vagy, vagy mi?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "Hogyan?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Ügyifogyi..."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "A semmiből érkeztél ide, nem?"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Mivel nem szabadna itt lenned,"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "segítek kijutni innen."}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Ég veled, butuska!"}
