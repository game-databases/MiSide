{"category": "LocationDialogue Location15", "line_index": 0, "text": "﻿"}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Hát itt vagy."}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Miért hagytad el a Magot?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Mondtam, hogy várj meg!"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Aggódtam, mert túl sokáig tartott."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Na mindegy."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Találtam valamit!"}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Szerintem az index lesz az."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Reméljük, hogy működni fog."}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Most kiengedlek."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "Reméljük Téboly-Mita"}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "nem ér rá velünk foglalkozni..."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Most másvalakivel van elfoglalva."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Mita?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Várj meg!"}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Csak nem ezt keresed?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Nem voltam világos az imént?"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Mita..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Aki kapja, marja!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Miért..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Ki vagy te?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Te... te még élsz?"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Nem emlékszel rám?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Ismernem kéne téged?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Miért van ez..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Most mihez kezdjek?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Most hogy jussak ki?"}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "Mit értesz az alatt hogy „ki?”"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Várj..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "az ott a gyűrű?"}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "És az ott?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Fogalmam sincs, mi ez."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "Ez az index!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Hát megtaláltad!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Nem tudom, erre mit válaszoljak."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Vissza kell mennem a Maghoz..."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "Te meg..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Te is jöhetnél."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Hogyan?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Hát jó."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Itt várj."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Rendben,"}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "ide leülök."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "A rosseb..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "Egy hajszálon múlt."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "Vajon sikerült?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Ezaz."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "A jó verzióban vagyok."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Halihó!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Te egy új játékos vagy?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Hogy hívnak?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Le akarok innen lépni..."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Máris elmész?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "Honnan jöttél?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Nem fontos."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Rendben, elengedlek."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Az ajtón át kijuthatsz innen."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Sok sikert!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Egy fal?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Ez furcsa."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Lehet,"}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "van valami a pincében ami segíthet."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Nemrég találtam egy pincét"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "a szekrényemben."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Ott fura kacatok,"}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "és ketyerék vannak."}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "Elég bizarr."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Azt hiszem valami kódot kell beütni..."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Nem igazán értem,"}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "és nem is szeretném."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "Nagyon ijesztő a hely, nem túlzok."}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Odamész?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Hát, jó."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Szerintem"}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "mindent elfelejtett."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Vajon tényleg sikerült"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "visszaállítani őt?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Most már csak egyenes út"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "ebből az istenverte világból!"}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Kérlek várj."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Hadd öleljelek át."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Hogy mi?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Köszönöm, hogy itt voltál."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Aww,"}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "olyan szomorú,"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "hogy mi ketten"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "nem töltöttünk olyan sok időt..."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Hogy..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "micsoda?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Hát hogy..."}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "velem maradhattál volna."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "Én rontottam el az egészet"}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "a szekrénnyel, meg a rejtélyes zajjal..."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Már előbb megölhettem volna őt..."}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Várj egy percet..."}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "Te mind"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "emlékszel ezekre??"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "Te"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "komolyan azt hitted, ilyen könnyű megszabadulni tőlem?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Te butuska..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Nem különbözöl a többi játékostól, tudod?"}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Ezt nézd!"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "Ez a te"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "drágaságos kazettád!"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "Felőlem mehetsz, már elértem a célom."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Bocsika, hihi!"}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Nem hiszem el!"}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Egész biztos vagyok,"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "hogy visszaállítottalak téged!"}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Még mindig nem érted..."}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "HAHAHAHAHAHAHAHA!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Olyan jól tudok színészkedni!"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Láttad volna a meglepett arcod, drágám!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "Ez annyira vérpezsdítő!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Mi ütött beléd?"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Miért vagy ilyen?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Na igen..."}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Mi üthetett belém?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Ki tudja."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Te mondd meg, mi ütött belém?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Miért nem viselkedek úgy, mint egy Mita?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Tudod..."}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "nekem sose volt se verzióm, se indexszámom..."}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Én más Mitákat nyúztam szét, és bújtam meg bennük."}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "átvettem a helyüket..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Ezért nem tudsz engem sose"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "visszaállítani!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Ezt nem hiszem el!"}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Te..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "Te vagy a probléma forrása!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "Neked nem szabadna létezned!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "Te is ezt mondod?"}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Annyira fáj, hogy ezt hallom tőled..."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "Sebaj!"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Itt az idő, hogy végre eltűnj innen!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Majd még találkozunk!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Már minden készen áll!"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "Ideje"}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "kidobni téged a konzolból!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "Ég veled!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Máris te vagy a kedvenc kazettám!"}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Olyan érdekes neved van, játékos!"}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Szerintem nem ez lesz az."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Ez se az."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Rossz helyen keresem..."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Nem ez az."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Olyat kell találnom, ami azt írja, hogy karakter-visszaállítás."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "Nem ez a verzió."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Hoppá, nem ezt akartam."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Nem, nem ez az."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Nem."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Nem jó,"}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "rossz az index."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Nem jó,"}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "nem fér ki."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Nem vagy éhes?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Szívesen szeletelek neked répát! :)"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Szerintem"}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "ezt egyedül is el tudod intézni."}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Most ugyanoda értünk ahonnan indultunk."}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Hová megyünk pontosan?"}
