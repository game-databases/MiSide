{"category": "LocationDialogue Location12", "line_index": 0, "text": "// Mita"}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Reste là."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Je pense avoir fait tomber un truc. Je serai bientôt de retour."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "Ensuite, on ira à la recherche d'un autre monde."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": "// MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "D'accord."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": "// MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Faisons un jeu !"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Je veux mon ours en peluche !"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "Je l'ai perdu..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "Trouve-le !"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": "// MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Toi..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "Qu'est-ce que tu regardes ?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Answer 1 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Je suis Mita."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "La meilleure Mita."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "La première Mita."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "C'est ce que Mita a dit. Ma Mita."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Answer 2 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "À quoi je ressemble ?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "À quoi je ressemble ?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "À quoi je ressemble ?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "Ma Mita dit que je suis belle et originale."}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "C'est à ça que je ressemble."}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Answer 3 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Elle va m'amener avec elle."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Nous allons vivre dans un nouveau monde."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "Ma Mita m'a invitée."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Elle va m'amener avec elle. Nous allons jouer."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Answer 4 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "L'ours en peluche - c'est toi."}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "Et tu es perdu,"}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "comme mon ours en peluche."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Answer 5 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "Ma..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "Mita."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Elle veut jouer."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Elle n'accepte personne d'autre."}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "Seulement moi."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Nous sommes spéciales."}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "Nous sommes uniques."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Mita et ma Mita,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0.8A et 8М54*"}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Answer 6 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "Ma Mita..."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "Ma meilleure amie..."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "Ma Mita."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "Ma seule amie."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": "// MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "C'est toi !"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Regarde."}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Faisons un jeu !"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Je vais te montrer."}
