{"category": "LocationDialogue Location17", "line_index": 0, "text": "// Player"}
{"category": "LocationDialogue Location17", "line_index": 1, "text": "On dirait que je ne peux pas faire ça seul."}
{"category": "LocationDialogue Location17", "line_index": 2, "text": "J'espère que la Mita d'ici ne mord pas..."}
{"category": "LocationDialogue Location17", "line_index": 3, "text": "// Coffee - Player"}
{"category": "LocationDialogue Location17", "line_index": 4, "text": "Pourquoi je perds mon temps à faire ça..."}
{"category": "LocationDialogue Location17", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 9, "text": "// Tries to wake up Mita - Player"}
{"category": "LocationDialogue Location17", "line_index": 10, "text": "Mita ?"}
{"category": "LocationDialogue Location17", "line_index": 11, "text": "Mita, réveille-toi !"}
{"category": "LocationDialogue Location17", "line_index": 12, "text": "Mita."}
{"category": "LocationDialogue Location17", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 14, "text": "Mita, réveille-toi !"}
{"category": "LocationDialogue Location17", "line_index": 15, "text": "J'ai besoin de ton aide."}
{"category": "LocationDialogue Location17", "line_index": 16, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 17, "text": "Qui es-tuuu ?"}
{"category": "LocationDialogue Location17", "line_index": 18, "text": "// Player"}
{"category": "LocationDialogue Location17", "line_index": 19, "text": "Aide-moi avec les leviers."}
{"category": "LocationDialogue Location17", "line_index": 20, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 21, "text": "Quels leviers ?"}
{"category": "LocationDialogue Location17", "line_index": 22, "text": "Laisse-moi dormir..."}
{"category": "LocationDialogue Location17", "line_index": 23, "text": "Ou va me faire un café."}
{"category": "LocationDialogue Location17", "line_index": 24, "text": "// Player"}
{"category": "LocationDialogue Location17", "line_index": 25, "text": "C'est à deux pas d'ici."}
{"category": "LocationDialogue Location17", "line_index": 26, "text": "Mita ?"}
{"category": "LocationDialogue Location17", "line_index": 27, "text": "Mi-ita !"}
{"category": "LocationDialogue Location17", "line_index": 28, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 31, "text": "// Player gives away the coffee - Player"}
{"category": "LocationDialogue Location17", "line_index": 32, "text": "Mita,"}
{"category": "LocationDialogue Location17", "line_index": 33, "text": "voilà ton café."}
{"category": "LocationDialogue Location17", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 37, "text": "// MitaDream exercise - MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 38, "text": "Donc tu parlais"}
{"category": "LocationDialogue Location17", "line_index": 39, "text": "de leviers ?"}
{"category": "LocationDialogue Location17", "line_index": 40, "text": "// Player"}
{"category": "LocationDialogue Location17", "line_index": 41, "text": "Oui"}
{"category": "LocationDialogue Location17", "line_index": 42, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 43, "text": "Comment tu sais pour les leviers ?"}
{"category": "LocationDialogue Location17", "line_index": 44, "text": "Enfin, pourquoi je demande ça..."}
{"category": "LocationDialogue Location17", "line_index": 45, "text": "Si tu es là,"}
{"category": "LocationDialogue Location17", "line_index": 46, "text": "tu dois déjà savoir beaucoup de choses..."}
{"category": "LocationDialogue Location17", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 48, "text": "Un instant,"}
{"category": "LocationDialogue Location17", "line_index": 49, "text": "il faut que je m'assoie."}
{"category": "LocationDialogue Location17", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 51, "text": "Et donc ?"}
{"category": "LocationDialogue Location17", "line_index": 52, "text": "// Player"}
{"category": "LocationDialogue Location17", "line_index": 53, "text": "Je ne sais pas quoi te dire..."}
{"category": "LocationDialogue Location17", "line_index": 54, "text": "Mais je dois continuer d'avancer."}
{"category": "LocationDialogue Location17", "line_index": 55, "text": "Je dois suivre la route tracée par l'anneau."}
{"category": "LocationDialogue Location17", "line_index": 56, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 57, "text": "Tu as son anneau ?"}
{"category": "LocationDialogue Location17", "line_index": 58, "text": "Ça explique"}
{"category": "LocationDialogue Location17", "line_index": 59, "text": "comment tu es arrivé là."}
{"category": "LocationDialogue Location17", "line_index": 60, "text": "// Player"}
{"category": "LocationDialogue Location17", "line_index": 61, "text": "C'est ça."}
{"category": "LocationDialogue Location17", "line_index": 62, "text": "Donc est-ce que tu peux m'aider ?"}
{"category": "LocationDialogue Location17", "line_index": 63, "text": "Avec les leviers ?"}
{"category": "LocationDialogue Location17", "line_index": 64, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 65, "text": "D'accord."}
{"category": "LocationDialogue Location17", "line_index": 66, "text": "Je vais t'aider..."}
{"category": "LocationDialogue Location17", "line_index": 67, "text": "Avec les leviers..."}
{"category": "LocationDialogue Location17", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 69, "text": "// Player"}
{"category": "LocationDialogue Location17", "line_index": 70, "text": "Mita, encore ?"}
{"category": "LocationDialogue Location17", "line_index": 71, "text": "Allons-y maintenant."}
{"category": "LocationDialogue Location17", "line_index": 72, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 73, "text": "Ah ?"}
{"category": "LocationDialogue Location17", "line_index": 74, "text": "Très bien."}
{"category": "LocationDialogue Location17", "line_index": 75, "text": "Allons-y."}
{"category": "LocationDialogue Location17", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 78, "text": "// fall mitadream - Player"}
{"category": "LocationDialogue Location17", "line_index": 79, "text": "Debout."}
{"category": "LocationDialogue Location17", "line_index": 80, "text": "Tu as vraiment si sommeil que ça ?"}
{"category": "LocationDialogue Location17", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 82, "text": "// again sleep mitadream - Player"}
{"category": "LocationDialogue Location17", "line_index": 83, "text": "Réveille-toi."}
{"category": "LocationDialogue Location17", "line_index": 84, "text": "On est déjà arrivé."}
{"category": "LocationDialogue Location17", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 86, "text": "// Switches"}
{"category": "LocationDialogue Location17", "line_index": 87, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 88, "text": "Ok,"}
{"category": "LocationDialogue Location17", "line_index": 89, "text": "je suis prête."}
{"category": "LocationDialogue Location17", "line_index": 90, "text": "// Player"}
{"category": "LocationDialogue Location17", "line_index": 91, "text": "Moi aussi."}
{"category": "LocationDialogue Location17", "line_index": 92, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 93, "text": "Bien."}
{"category": "LocationDialogue Location17", "line_index": 94, "text": "Je vais lancer"}
{"category": "LocationDialogue Location17", "line_index": 95, "text": "le décompte."}
{"category": "LocationDialogue Location17", "line_index": 96, "text": "Après quoi on tirera ensemble les leviers vers le bas."}
{"category": "LocationDialogue Location17", "line_index": 97, "text": "Ok ?"}
{"category": "LocationDialogue Location17", "line_index": 98, "text": "// Player"}
{"category": "LocationDialogue Location17", "line_index": 99, "text": "Essaie juste de ne pas t'endormir."}
{"category": "LocationDialogue Location17", "line_index": 100, "text": "Lance le décompte."}
{"category": "LocationDialogue Location17", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 102, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 103, "text": "3"}
{"category": "LocationDialogue Location17", "line_index": 104, "text": "2"}
{"category": "LocationDialogue Location17", "line_index": 105, "text": "1"}
{"category": "LocationDialogue Location17", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 107, "text": "// Player lose 1 - MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 108, "text": "Qu'est-ce que tu fais ?"}
{"category": "LocationDialogue Location17", "line_index": 109, "text": "Bon,"}
{"category": "LocationDialogue Location17", "line_index": 110, "text": "recommençons..."}
{"category": "LocationDialogue Location17", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 112, "text": "// Player lose 2 - MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 113, "text": "Encore ?"}
{"category": "LocationDialogue Location17", "line_index": 114, "text": "Juste encore une fois."}
{"category": "LocationDialogue Location17", "line_index": 115, "text": "Je"}
{"category": "LocationDialogue Location17", "line_index": 116, "text": "Je vais m'endormir..."}
{"category": "LocationDialogue Location17", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 118, "text": "// Player lose 3 - MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 119, "text": "Je vais finir par m'endormir..."}
{"category": "LocationDialogue Location17", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 122, "text": "// Win - Player"}
{"category": "LocationDialogue Location17", "line_index": 123, "text": "C'est bon,"}
{"category": "LocationDialogue Location17", "line_index": 124, "text": "merci, Mita."}
{"category": "LocationDialogue Location17", "line_index": 125, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 126, "text": "Mm-hmm."}
{"category": "LocationDialogue Location17", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 128, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 129, "text": "Quelle..."}
{"category": "LocationDialogue Location17", "line_index": 130, "text": "lenteur..."}
{"category": "LocationDialogue Location17", "line_index": 131, "text": "cette porte..."}
{"category": "LocationDialogue Location17", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 133, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 134, "text": "Je vais me recoucher..."}
{"category": "LocationDialogue Location17", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 136, "text": "// Why kitchen? - MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 137, "text": "Pourquoi on est venu ici ?"}
{"category": "LocationDialogue Location17", "line_index": 138, "text": "Si je m'endors sur le sol froid de la cuisine,"}
{"category": "LocationDialogue Location17", "line_index": 139, "text": "ça sera de ta faute."}
{"category": "LocationDialogue Location17", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 141, "text": "// Why bathroom? - MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 142, "text": "Je ne comprend pas..."}
{"category": "LocationDialogue Location17", "line_index": 143, "text": "C'est quels leviers que tu voulais tirer ?"}
{"category": "LocationDialogue Location17", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 145, "text": "// Put button - Player"}
{"category": "LocationDialogue Location17", "line_index": 146, "text": "Rien ne s'est passé ?"}
{"category": "LocationDialogue Location17", "line_index": 147, "text": "Alors pourquoi ce bouton est ici ?"}
{"category": "LocationDialogue Location17", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 149, "text": "// Cofee - Player"}
{"category": "LocationDialogue Location17", "line_index": 150, "text": "Pourquoi ne pas reprendre du café ?"}
{"category": "LocationDialogue Location17", "line_index": 151, "text": "Tu vas encore t'endormir."}
{"category": "LocationDialogue Location17", "line_index": 152, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 153, "text": "Hein ?"}
{"category": "LocationDialogue Location17", "line_index": 154, "text": "Nooon"}
{"category": "LocationDialogue Location17", "line_index": 155, "text": "Ce café est dégoutant..."}
{"category": "LocationDialogue Location17", "line_index": 156, "text": "Ça ira..."}
{"category": "LocationDialogue Location17", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 158, "text": "// Button - Player"}
{"category": "LocationDialogue Location17", "line_index": 159, "text": "Mita ? Est-ce que tu m'entends ? Le bouton ne fonctionne pas."}
{"category": "LocationDialogue Location17", "line_index": 160, "text": "Toujours là ?"}
