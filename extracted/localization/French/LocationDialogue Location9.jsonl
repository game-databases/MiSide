{"category": "LocationDialogue Location9", "line_index": 0, "text": "// Mita Chibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Hé, toi !"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Salut !"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Tu veux sortir d'ici ?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Alors aide-moi à trouver la clé !"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search - MitaChibi  - [not]"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Fichtre ! Pas de clé !"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "C'est vide !"}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "Zéro, zip, nada !"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Trouvée !"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Je t'imaginais plus petit !"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "Mais tu es tellement grand !"}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "Comme sœurette !"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "Hm... sœurette ?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "C'est ça, sœurette."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Ne fais pas comme si tu ne l'avais pas déjà rencontrée !"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Rencontrée ? C'est le moins que l'on puisse dire."}
{"category": "LocationDialogue Location9", "line_index": 22, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Est-ce que tu es bête ?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "Euh..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "On dirait bien que oui..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "Allez, aide-moi à trouver la clé !"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Voilà."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Mets les lingots dans la cheminée !"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Merci !"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "Maintenant fais descendre les bûches !"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Merci !"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Aide-moi avec ça !"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Tout est prêt ! Et maintenant..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "Waouh, que c'est joli."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Allez, appuie là !"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Tadaa !"}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "C'est bon, prends-la !"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "La clé est à toi !"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// quest 1 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Je suis ChibiMita.fbx !"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Avec juste quelques arrêtes,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "le plus simple des modèles,"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "et de superbes cheveux !"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// quest 2 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Monsieur le grand dadais,"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "tu as l'air bien gentil"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "à poser des questions stupides."}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Cela dit,"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "c'est la première fois qu'on se voit !"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Mais... // Player"}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Si quelqu'un me vole ma superbe apparence,"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "alors il aura affaire à moi !"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// quest 3 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Tu n'as pas encore compris ?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "C'est un point de contrôle !"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "Pour voir ce que tu as dans le crâne !"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "Vas-y maintenant !"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Je suis là pour guider ceux qui se sont perdus !"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// quest 4 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "Et qui es-tu donc"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "pour que je ne t'aide pas ?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "Hein ?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Idiot."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Tu débarques de nulle part !"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Tu ne devrais pas être ici,"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "alors je te viens en aide !"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Bye bye, bécasse !"}
