{"category": "LocationDialogue Location15", "line_index": 0, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Ah tu es là !"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Pourquoi tu n'es pas resté dans le Cœur ?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Je t'avais bien dit de m'attendre, non ?"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Tu es partie trop longtemps, et je pensais que..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Bon, très bien..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Je pense avoir trouvé quelque chose."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "On dirait bien un index."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Il nous faudra voir si ça fonctionne !"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Allez sortons d'ici."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "La Mita Folle..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Je pense qu'elle est occupée avec un nouveau joueur."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Alors j'imagine qu'elle ne fera pas attention à nous..."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Mita ?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Attends-moi."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": "// Mita killer"}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Tu as perdu quelque chose !?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Ce doit être ça !"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Mita..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Attrape !"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Mais comment..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Qui es-tu ?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Tu... Tu es en vie !"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Tu ne te souviens de rien ?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Est-ce qu'on se connaît ?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Et maintenant..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Qu'est-ce que je suis censé faire ?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Je ne sortirai jamais d'ici..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "Qu'entends-tu par \"sortir\" ?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Attends..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "Tu as l'anneau."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "Et ça ?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Je ne sais pas ce que c'est."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "C'est un index !"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Tu l'as donc trouvé !"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Je ne sais pas quoi dire."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "On doit retourner dans le Cœur."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "Et quant à toi..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Tu devrais peut-être venir avec moi."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Où ça ?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Bon, d'accord."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Attends ici."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Mm-hmm."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Je vais m'asseoir là."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Bon sang..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "J’ai failli y passer..."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "Alors... c'est réussi ?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Voyons..."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Je suis dans la bonne version."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Salut !"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Tu es un joueur, n'est-ce pas ?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Quel est ton nom ?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Je veux quitter cet endroit."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Tu veux déjà partir ?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "Comment es-tu arrivé ici pour commencer ?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Hmm..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Bien, tu peux partir."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Essaye de passer par la porte d'entrée."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Bonne chance avec ça !"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Un mur ?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Oh, ça ne devrait pas être comme ça."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Peut-être..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "que quelque chose au sous-sol pourrait t'aider."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "J'ai récemment découvert"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "une porte dans mon placard..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Il se trouve que c'est un sous-sol."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Visiblement, c'est pour ranger du bazar."}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "Il y a aussi tout un tas de matériel sophistiqué."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Il faut entrer un genre de code ou quelque chose comme ça."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Je ne sais pas ce que c'est"}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "et je veux pas le savoir."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "En fait l'endroit me met mal à l'aise. Alors non merci !"}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Tu veux bien y jeter un œil ?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Hm... D'accord."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "J'ai l'impression..."}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "qu'elle ne se souvient de rien."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Alors, on a réussi,"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "elle a bien redémarré ?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Il n'y a plus qu'une chose à faire,"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "sortir de ce foutu jeu..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Attends."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Je voudrais te faire un câlin."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Hein ?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Mita - hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Ça m'a fait plaisir de te voir."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Ahh..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "Quel dommage"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "que toi et moi"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "n'ayons passé que si peu de temps ensemble..."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Je ne comprends pas..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "de quoi tu parles ?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Je veux dire,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "tu aurais pu rester avec moi."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "C'est de ma faute."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Ce placard. Et... ces sons."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "J'aurais dû la TUER plus tôt !"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Attends une minute."}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "Ne me dis pas..."}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Comment tu te souviens de ça ?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "AH !"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Tu pensais vraiment que ce serait aussi simple ?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Tu es si naïf..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Enfin, comme tous les autres..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Mais tout va bien, regarde ! // Shows timer"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "Désormais,"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "le \"VRAI\" toi"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "n'est plus nécessaire..."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Je suis désolée !"}
{"category": "LocationDialogue Location15", "line_index": 148, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Je n'y crois pas..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Ça n'a pas fonctionné ? // Hides timer"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Non, je suis certain de t'avoir redémarré !"}
{"category": "LocationDialogue Location15", "line_index": 152, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Tu n'as donc toujours rien compris... // Hands down"}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Ah-ah-ah-ah !"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Quelle bonne actrice je fais ! // Hand on head"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Tu aurais dû voir ta tête, chéri !"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "Qu'est-ce que c'est amusant !"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Pourquoi tu es comme ça ?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Qu'est-ce qui ne va pas avec toi ?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "C'est vrai ça... // Shows real face"}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Qu'est-ce qui ne va pas avec moi ?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Je n'en suis pas sûr moi-même..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Peut-être pourrais-tu me dire, toi, pourquoi je suis comme ça ?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Pourquoi je ne peux pas être une Mita ?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Car cette version de moi"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "n'a jamais existé !"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Je ne fais que dépecer ces idiotes naïves,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "pour me cacher sous leur peau..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Il n'y a aucun moyen"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "de me redémarrer !"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Je n'arrive pas à y croire..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Toi..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "Le problème ne vient pas d'elles !"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "C'est toi qui ne devrais pas exister !"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "Alors toi aussi..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Ça me fait mal de t'entendre dire ça."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "Et pourtant ! // Steps back"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Il est temps pour toi de partir !"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "On se reverra bientôt !"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Il est l'heure,"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "je pense."}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "Le moment est venu de te retirer de la console !"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "À la prochaine !"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Tu seras ma cartouche préférée..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Un joueur avec un nom intéressant."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm - Player"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Ça ne doit pas être ça."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Ça ne correspond pas non plus."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Nope."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "C'est pas ce dont j'ai besoin."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Je dois trouver la réinitialisation de personnage."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "Ce n'est pas la bonne version."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Oups, j'ai fait une faute."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Ce n'est pas ça."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Je dois corriger ça."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Quelque chose ne va pas."}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "L'index n'est pas bon."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Je dois entrer l'index à nouveau."}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "Ça ne marche pas."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen - MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Tu as faim ?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Je suis douée pour couper des carottes."}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom - MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Oups, je suppose..."}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "que tu voulais venir ici seul ?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back - MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Tu as décidé de tourner en rond ?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Pourquoi revenir ici ?"}
