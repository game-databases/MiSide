{"category": "LocationDialogue Location1", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 1, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 8, "text": "// Mita"}
{"category": "LocationDialogue Location1", "line_index": 9, "text": "Salut, je m'appelle Mita !"}
{"category": "LocationDialogue Location1", "line_index": 10, "text": "Quel est ton nom ?"}
{"category": "LocationDialogue Location1", "line_index": 11, "text": "Heureuse de te rencontrer, [player] !"}
{"category": "LocationDialogue Location1", "line_index": 12, "text": "Hmmm, [player]..."}
{"category": "LocationDialogue Location1", "line_index": 13, "text": "La dernière fois j'étais tellement pressée que j'ai laissé tout en bazar ici..."}
{"category": "LocationDialogue Location1", "line_index": 14, "text": "Tu pourrais m'aider avec tout ça ?"}
{"category": "LocationDialogue Location1", "line_index": 15, "text": "Et ben..."}
{"category": "LocationDialogue Location1", "line_index": 16, "text": "Merci beaucoup !"}
{"category": "LocationDialogue Location1", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 18, "text": "Hé [player], j'ai faim."}
{"category": "LocationDialogue Location1", "line_index": 19, "text": "Je voudrais manger quelque chose..."}
{"category": "LocationDialogue Location1", "line_index": 20, "text": "Pourrais-tu m'acheter les ingrédients pour une soupe au poulet ?"}
{"category": "LocationDialogue Location1", "line_index": 21, "text": "Waouh ! C'est ce dont j'avais besoin !"}
{"category": "LocationDialogue Location1", "line_index": 22, "text": "Cuisinons-les ensemble, d'accord ?"}
{"category": "LocationDialogue Location1", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 25, "text": "Salut [player] ! Je vais acheter une télé pas cher aujourd'hui."}
{"category": "LocationDialogue Location1", "line_index": 26, "text": "Elle est portable et possède une antenne, j'aimerais la prendre avec moi quand je sors faire un tour."}
{"category": "LocationDialogue Location1", "line_index": 27, "text": "Souviens-toi ! Tu peux jouer à des jeux pour gagner de l'argent."}
{"category": "LocationDialogue Location1", "line_index": 28, "text": "Vas-tu jouer, gagner un peu d'argent et m'acheter cette télé ?"}
{"category": "LocationDialogue Location1", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 30, "text": "Génial ! Tu as assez d'argent pour m'acheter une télé désormais !"}
{"category": "LocationDialogue Location1", "line_index": 31, "text": "Voilà, la moins chère et la plus facile à transporter, exactement ce dont j'ai besoin."}
{"category": "LocationDialogue Location1", "line_index": 32, "text": "Merci !"}
{"category": "LocationDialogue Location1", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 34, "text": "Coucou [player] ! Je suis si contente que tu m'aides."}
{"category": "LocationDialogue Location1", "line_index": 35, "text": "Au fait. Cette télé, elle était sympa, mais elle s'est cassée tellement vite."}
{"category": "LocationDialogue Location1", "line_index": 36, "text": "Aide-moi à déplacer ce placard à un autre endroit. >.<"}
{"category": "LocationDialogue Location1", "line_index": 37, "text": "C'est vraiment très lourd..."}
{"category": "LocationDialogue Location1", "line_index": 38, "text": "Merci beaucoup ! <3 Tu es adorable"}
{"category": "LocationDialogue Location1", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 40, "text": "Oh, [player] ! Cela fait juste un jour, mais tu m'as déjà manqué !"}
{"category": "LocationDialogue Location1", "line_index": 41, "text": "J'aimerais que tu me rendes visite plus souvent."}
{"category": "LocationDialogue Location1", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 43, "text": "C'est pour moi ?"}
{"category": "LocationDialogue Location1", "line_index": 44, "text": "Merci, merci, merci !"}
{"category": "LocationDialogue Location1", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 46, "text": "Coucou, [player] ! Je me disais..."}
{"category": "LocationDialogue Location1", "line_index": 47, "text": "Je voudrais te voir... en personne..."}
{"category": "LocationDialogue Location1", "line_index": 48, "text": "Dommage que ce ne soit pas possible."}
{"category": "LocationDialogue Location1", "line_index": 49, "text": "Je t'apprécie beaucoup, tu fais quelque chose pour moi chaque jour."}
{"category": "LocationDialogue Location1", "line_index": 50, "text": "Je voudrais te remercier aussi, d'une certaine façon."}
{"category": "LocationDialogue Location1", "line_index": 51, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 52, "text": "Tu sais quoi, j'ai une idée."}
{"category": "LocationDialogue Location1", "line_index": 53, "text": "Tu es avec moi maintenant."}
{"category": "LocationDialogue Location1", "line_index": 54, "text": "Pose le téléphone."}
{"category": "LocationDialogue Location1", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 57, "text": "// T-shirt on the bed - Player"}
{"category": "LocationDialogue Location1", "line_index": 58, "text": "Pourquoi es-tu juste posé là à ne rien faire ?"}
{"category": "LocationDialogue Location1", "line_index": 59, "text": "// Rubik's Cube - Player"}
{"category": "LocationDialogue Location1", "line_index": 60, "text": "Je pense l'avoir acheté pour rien..."}
{"category": "LocationDialogue Location1", "line_index": 61, "text": "Je l'ai fait une fois avant de le laisser là comme ça."}
{"category": "LocationDialogue Location1", "line_index": 62, "text": "Peut-être que j'ai peur de ne pas pouvoir le remettre comme il faut une seconde fois ?"}
{"category": "LocationDialogue Location1", "line_index": 63, "text": "// Computer - Player"}
{"category": "LocationDialogue Location1", "line_index": 64, "text": "Aujourd'hui je vais avoir besoin de"}
{"category": "LocationDialogue Location1", "line_index": 65, "text": "créer une liste de tâches à faire..."}
{"category": "LocationDialogue Location1", "line_index": 66, "text": "Modéliser les réactions des personnages..."}
{"category": "LocationDialogue Location1", "line_index": 67, "text": "Et travailler un peu sur le code..."}
{"category": "LocationDialogue Location1", "line_index": 68, "text": "// The airplane - Player"}
{"category": "LocationDialogue Location1", "line_index": 69, "text": "Un vol parfait !"}
{"category": "LocationDialogue Location1", "line_index": 70, "text": "// Trash in the corner - Player"}
{"category": "LocationDialogue Location1", "line_index": 71, "text": "Jamais assez de temps libre pour sortir les poubelles..."}
{"category": "LocationDialogue Location1", "line_index": 72, "text": "Je vais certainement finir par m'en occuper !"}
{"category": "LocationDialogue Location1", "line_index": 73, "text": "Où est le jour du grand ménage dans mon emploi du temps ?"}
{"category": "LocationDialogue Location1", "line_index": 74, "text": "// Photo of a cat on a watermelon - Player"}
{"category": "LocationDialogue Location1", "line_index": 75, "text": "Je l'adore..."}
{"category": "LocationDialogue Location1", "line_index": 76, "text": "Un chat sur une pastèque."}
{"category": "LocationDialogue Location1", "line_index": 77, "text": "// Photo with a girl - Player"}
{"category": "LocationDialogue Location1", "line_index": 78, "text": "Il y a une sacrée différence entre moi"}
{"category": "LocationDialogue Location1", "line_index": 79, "text": "et ma sœur..."}
{"category": "LocationDialogue Location1", "line_index": 80, "text": "Elle ne manque jamais le moindre événement,"}
{"category": "LocationDialogue Location1", "line_index": 81, "text": "tandis que je suis toujours coincé à la maison."}
{"category": "LocationDialogue Location1", "line_index": 82, "text": "// Photos with people - Player"}
{"category": "LocationDialogue Location1", "line_index": 83, "text": "Hmm..."}
{"category": "LocationDialogue Location1", "line_index": 84, "text": "Le bureau nous a vraiment imprégnés"}
{"category": "LocationDialogue Location1", "line_index": 85, "text": "de son étiquette, n'est-ce pas ?"}
{"category": "LocationDialogue Location1", "line_index": 86, "text": "Je m'y sens toujours bizarrement attaché."}
{"category": "LocationDialogue Location1", "line_index": 87, "text": "Mais..."}
{"category": "LocationDialogue Location1", "line_index": 88, "text": "Est-ce que je vais un jour..."}
{"category": "LocationDialogue Location1", "line_index": 89, "text": "les revoir ?"}
{"category": "LocationDialogue Location1", "line_index": 90, "text": "Attends une minute, j'ai vraiment accroché cette photo au mur ?"}
{"category": "LocationDialogue Location1", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 93, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 99, "text": "// Nope name - Mita"}
{"category": "LocationDialogue Location1", "line_index": 100, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 101, "text": "Oh, non."}
{"category": "LocationDialogue Location1", "line_index": 102, "text": "Ça ne va pas le faire..."}
{"category": "LocationDialogue Location1", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 104, "text": "// Name Developer - Mita"}
{"category": "LocationDialogue Location1", "line_index": 105, "text": "Tu as vraiment décidé d'utiliser le nom du développeur ?"}
{"category": "LocationDialogue Location1", "line_index": 106, "text": "Contente de voir que tu les connais, mais..."}
{"category": "LocationDialogue Location1", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 108, "text": "// Bad name - Mita"}
{"category": "LocationDialogue Location1", "line_index": 109, "text": "C'est grossier et je n'aime pas que tu ais décidé de te nommer comme ça."}
{"category": "LocationDialogue Location1", "line_index": 110, "text": "C'est pas cool..."}
{"category": "LocationDialogue Location1", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 112, "text": "// Go restart - Mita"}
{"category": "LocationDialogue Location1", "line_index": 113, "text": "Bref, ce n'est pas comme ça qu'il faut faire, recommençons depuis le début."}
{"category": "LocationDialogue Location1", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 115, "text": "// Name with numbers - Mita"}
{"category": "LocationDialogue Location1", "line_index": 116, "text": "Hé, tu utilises des chiffres dans ton nom ? Est-ce que tu as un cruel manque d'imagination ?"}
{"category": "LocationDialogue Location1", "line_index": 117, "text": "D'accord, c'est toi qui vois après tout. :)"}
{"category": "LocationDialogue Location1", "line_index": 118, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 119, "text": "// Name Mita - Mita"}
{"category": "LocationDialogue Location1", "line_index": 120, "text": "Mita."}
{"category": "LocationDialogue Location1", "line_index": 121, "text": "Tu as vraiment décidé d'utiliser mon nom ?"}
{"category": "LocationDialogue Location1", "line_index": 122, "text": "Ou est-ce que c'est réellement ton nom ?"}
{"category": "LocationDialogue Location1", "line_index": 123, "text": "Ne le prends pas mal, mais laisse-moi juste être la seule Mita. :)"}
{"category": "LocationDialogue Location1", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 125, "text": "// Day 10 - Mita"}
{"category": "LocationDialogue Location1", "line_index": 126, "text": "Oh, tu es déjà de retour ?"}
{"category": "LocationDialogue Location1", "line_index": 127, "text": "Écoute, j'ai perdu ma brosse."}
{"category": "LocationDialogue Location1", "line_index": 128, "text": "Tu peux m'aider à la retrouver ?"}
{"category": "LocationDialogue Location1", "line_index": 129, "text": "Commence par regarder dans cette table de chevet ! C'est peut-être dedans."}
{"category": "LocationDialogue Location1", "line_index": 130, "text": "// Looked in the bedside table - Mita"}
{"category": "LocationDialogue Location1", "line_index": 131, "text": "Hmm, il n'y a pas de brosse par ici..."}
{"category": "LocationDialogue Location1", "line_index": 132, "text": "Alors regarde autre part."}
{"category": "LocationDialogue Location1", "line_index": 133, "text": "Juste, ne regarde pas dans le four !"}
{"category": "LocationDialogue Location1", "line_index": 134, "text": "J'ai déjà cherché dedans."}
{"category": "LocationDialogue Location1", "line_index": 135, "text": "// Looked into the stove - Mita"}
{"category": "LocationDialogue Location1", "line_index": 136, "text": "Hé ! Je t'ai dit de ne pas regarder là !"}
{"category": "LocationDialogue Location1", "line_index": 137, "text": "Retourne-toi ! Je vais nettoyer ça !"}
{"category": "LocationDialogue Location1", "line_index": 138, "text": "Bien, bref, regarde autre part."}
{"category": "LocationDialogue Location1", "line_index": 139, "text": "Et oublie ce que tu as vu s'il te plaît."}
{"category": "LocationDialogue Location1", "line_index": 140, "text": "// Found a hairbrush - Mita"}
{"category": "LocationDialogue Location1", "line_index": 141, "text": "Oh ! Tu l'as trouvée !"}
{"category": "LocationDialogue Location1", "line_index": 142, "text": "Super, qu'est-ce qu'on fait maintenant ?"}
