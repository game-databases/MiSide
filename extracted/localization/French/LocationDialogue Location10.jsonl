{"category": "LocationDialogue Location10", "line_index": 0, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "Attends, attends !"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "Ne parle pas trop fort..."}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "C'est dangereux d'aller plus loin."}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "Bref..."}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "Comment es-tu arrivé ici ?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "Euh..."}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "L'anneau m'ouvre les bonnes portes"}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "Je ne sais pas vraiment comment ça fonctionne."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "L'anneau ?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "Qu'est-ce qui ne va pas avec cet endroit ?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "Pourquoi c'est aussi sombre ?"}
{"category": "LocationDialogue Location10", "line_index": 15, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "Je t'expliquerai plus tard,"}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "rends-toi vers la sortie,"}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "on se retrouve devant la borne d'arcade."}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Allez, allez, ne traîne pas !"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": "// After mini-game"}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "Alors ? Tu as compris ce que raconte ce jeu ?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "Sous ma peau se trouvent des os tandis que sous la tienne se trouve un mannequin ?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "Wouah !"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "Ça a l'air inquiétant."}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "Mais j'ai bien peur que ce soit tout à fait ça !"}
{"category": "LocationDialogue Location10", "line_index": 33, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "Je comprends, mais pourquoi j'aurais besoin de cette information ?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "Je pense t'avoir déjà dit"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "que c'était dangereux d'aller plus loin ?"}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "C'est là-bas que tu vas rencontrer ces mannequins..."}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "Ceux qui ont été éliminés, ceux qui ne correspondaient pas."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "Ceux-là sont plus agressifs que d'habitude. C'est ce que tu veux ?"}
{"category": "LocationDialogue Location10", "line_index": 41, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "Qu'est-ce que je suis censé faire ?"}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Quelque soit là où mènent les portes,"}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "c'est là que j'irais."}
{"category": "LocationDialogue Location10", "line_index": 45, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "Waouh !"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "Alors ne leur tourne pas le dos."}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "Et ne les quitte pas des yeux !"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "Ils sont bien trop timides quand on les regarde,"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "à tel point qu'ils s'immobiliseront."}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "Je pense que ça devrait t'aider !"}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// quest 1 - MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "Elles viennent juste de recevoir leur peau,"}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "maintenant elles ont besoin de temps"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "pour prendre conscience d'elles-mêmes."}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "Ensuite je dois conduire chacune d'elles"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "jusqu'à sa maison."}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// quest 2 - MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "Les Mitas sont basiquement \"nées\" dans l'obscurité."}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "Alors elles doivent commencer par se tenir un moment debout dans le noir..."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Est-ce que tu imagines"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "à quel point c'est douloureux pour elles d'être directement exposées à la lumière ?"}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// quest 3 - MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "Tu n'as pas encore compris ?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "J'aide les pauvres petites Mitas à s'adapter !"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "Qui d'autre va le faire sinon moi ?"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "Toi ?"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// quest 4 - Player"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "Pourquoi faut-il utiliser cette machine ?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "Il n'y a pas assez de place pour tout le monde ?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Attends, est-ce que tu comprends au moins"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "comment ce monde fonctionne ?"}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "Et le fait qu'il est infini ?"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "Infini ?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "Hmm..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "Mais comment ?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "Si la dernière version est la 1.9,"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "cela signifie qu'il n'y a que 19 mondes."}
{"category": "LocationDialogue Location10", "line_index": 91, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "Oh, bon sang, on dirait bien"}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "que tu n'imagines pas ce monde correctement."}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Je peux te montrer sur ce tableau."}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "Je peux tout t'expliquer."}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "Ça te va ?"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// quest 5 - Player"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Je pense"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "que je t'ai vue dans la dernière version."}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "Ou du moins je pense t'avoir vue."}
{"category": "LocationDialogue Location10", "line_index": 102, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "C'est possible !"}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Ma version est la 1.5."}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "Tu y es allé ?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Oui."}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "La première fois que je suis arrivé ici."}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "J'y étais !"}
{"category": "LocationDialogue Location10", "line_index": 110, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "Waouh !"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "Mais comment..."}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "Je me demande quel était l'index de cette maison."}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "Il y a une \"moi\" qui aime se plaindre en permanence."}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "Il y a aussi une \"moi\" qui aime jouer tout le temps."}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "Et il y a une \"moi\" qui persécute sans cesse puis passe à autre chose."}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "Oh, la liste est longue..."}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Tu te souviens de comment c'était ?"}
{"category": "LocationDialogue Location10", "line_index": 119, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Il faisait sombre."}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "Avec des inscriptions,"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "quelque chose comme..."}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "\"Tu veux jouer ?\""}
{"category": "LocationDialogue Location10", "line_index": 124, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "Oh."}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "Pas de chance."}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "C'est celle-la,"}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "celle qui persécute sans cesse puis passe à autre chose."}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// MSHairs wants to tell you [No] - Player"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Je n'en ai pas besoin."}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Je peux me débrouiller sans."}
{"category": "LocationDialogue Location10", "line_index": 133, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "Hmm, d'accord."}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// MSHairs wants to tell you [Yes] - Player"}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "D'accord, dis-moi tout."}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "J'espère que ça ne sera pas comme au lycée,"}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "où je m'endormais tellement je m'ennuyais."}
{"category": "LocationDialogue Location10", "line_index": 140, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "Tu peux partir si tu le souhaites."}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "Mais si tu es intéressé,"}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "alors écoute bien."}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "Un joueur a téléchargé MiSide sur son téléphone."}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "Il s'assoit confortablement et se met à jouer."}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "Il a ainsi créé une nouvelle maison,"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "et une nouvelle Mita."}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "Voilà une représentation en deux dimensions."}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "Là ce sont les versions,"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "elles sont représentées par des lignes."}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "Sur ces lignes se trouvent les maisons."}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "Tu as alors téléchargé le jeu en version 1.14."}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "Et donc dans cette version est née"}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "une nouvelle Mita, ainsi que sa maison."}
{"category": "LocationDialogue Location10", "line_index": 155, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "Et ben."}
{"category": "LocationDialogue Location10", "line_index": 157, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Tu peux me demander au sujet de certaines choses"}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "qui sont dessinées ici."}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "J'essaierais de t'expliquer."}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// He asks about the only circle - Player"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "Pourquoi il n'y a qu'un seul cercle ?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "Cette version n'a été disponible qu'une seule fois."}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "Elle n'est plus distribuée d'aucune manière,"}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "voilà pourquoi il n'y en a qu'un seul."}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "De plus, la particularité des versions comme ça,"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "est qu'il n'est pas possible de les contourner."}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "La Mita Endormie vit dans cette version, la 1.1."}
{"category": "LocationDialogue Location10", "line_index": 171, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "Endormie ?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "C'est parce que tout le monde passe par là,"}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "et que ça l'empêche de dormir ?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "Non."}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "Je peux juste passer devant sa porte,"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "sans même la voir."}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// He asks about the shaded circle - Player"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "Pourquoi ce cercle est grisé ?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "En fait, ce dessin là"}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "est dû à la Jolie Mita."}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "Elle l'a dessiné."}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "Elle et moi étions en train de débattre"}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "de comment aller plus vite en version 1.11."}
{"category": "LocationDialogue Location10", "line_index": 188, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "Et qui a gagné le débat ?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "MOI, bien sûr !"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "Regarde, on est ici."}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "Version 1.15."}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "Maison numéro 809."}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "On doit se rendre en version 1.11."}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "À la maison 805."}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Initialement, le chemin était comme ça."}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "On a cherché un chemin encore plus court."}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "Alors la Jolie Mita a suggéré ce chemin."}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "Mais j'en ai dessiné un encore plus simple."}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "C'est une évidence !"}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Regarde."}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "En partant d'ici, on peut directement aller dans la version souhaitée."}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Même si on dirait qu'une maison se trouve sur le chemin,"}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "ce qui empêcherait de passer."}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "D'ailleurs, ton anneau fonctionne sur le même principe."}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "Où est-ce qu'elles t'ont envoyé ?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "Je me dirige vers le Cœur."}
{"category": "LocationDialogue Location10", "line_index": 210, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "Le Cœur ?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "Hmm..."}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Si on t'a fait prendre un raccourci,"}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "alors tu vas aussi passer par la version 1.11."}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "Après quoi tu arriveras chez la Mita Endormie."}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Je pense que la Mita qui t'a envoyé"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "a pris le même chemin."}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "Ou alors elle ne l'a pas réalisé et tu passeras par une autre version."}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "Ou alors c'est une génie,"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "qui peut trouver un chemin encore plus court !"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Je pense avoir compris, je crois."}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// He asks about the inscription - Player"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "Et ça ?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "C'est pour la Mita Cool."}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "Elle sera là dans quelques heures."}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "Je lui ferais déplacer ces cartons ailleurs."}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "Et mettre enfin le canapé ici !"}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "Mon derrière me fait mal !"}
{"category": "LocationDialogue Location10", "line_index": 232, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Arf..."}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "Je peux t'aider ?"}
{"category": "LocationDialogue Location10", "line_index": 235, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "Non, laisse ça à la Mita Cool."}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Elle est forte."}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// He asks about the drawings - Player"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "C'est juste un dessin ?"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "Ou"}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "ça signifie aussi quelque chose ?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 244, "text": "Ouais."}
{"category": "LocationDialogue Location10", "line_index": 245, "text": "C'est juste un dessin."}
