{"category": "LocationDialogue Location20", "line_index": 0, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Mila ! Non ! Tu es complétement malade !"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": "// Mita"}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Ah ah ! MAIS QUE VOIS-JE ?"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "Est-ce là une nouvelle expression sur ton visage ?"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "Allez, encore, encore !"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "J'en ai marre de juste observer !"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\" - Mita"}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "Comment ça va, monsieur je-ne-tiens-pas-en-place ?"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "Toujours pas fatigué de courir partout ?"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Qu'est-ce que tu as fait à Mila ?"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": "// Mita"}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "Je vois que tu as encore de l'énergie !"}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Jouons encore ensemble !"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "Toi..."}
{"category": "LocationDialogue Location20", "line_index": 18, "text": "// Mita"}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "Commençons par un petit test !"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "Testons tes réflexes !"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "Voyons-voir comment tu te comporte !"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "Que ferait-on si quelque chose n'allait pas avec toi !?"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "Et si tu n'étais pas digne de cette PEAU,"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "que tu portes fièrement ?"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes - Mita"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "Regarde,"}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "lequel tu préfères ?"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "Droite"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "ou"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "gauche ?"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes - Mita"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "Tu es sérieux ?"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "C'est quoi la différence ?"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "Je plaisantais !"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "Oublions ça, poignarder les gens c'est dépassé..."}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "Allez"}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "J'ai de meilleures idées."}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "Et pour commencer..."}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder - Mita"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "Regarde ce que j'ai trouvé !"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Il nous faut un peu de musique !"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "Qu'est-ce que tu penses de cette mélodie ?"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "Elle me rend toute excitée !"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "Mais d'abord,"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "les règles !"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rule - Mita"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "Tant que cette musique continue,"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "tu peux te déplacer."}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "Mais si elle s'arrête,"}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "tu dois t'immobiliser !"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "Sinon, tu meurs."}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "Regarde, tu dois arriver jusqu'au bout."}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "Tu vas y arriver."}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "C'est parti pour la musique !"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "Qu'est-ce que tu fais encore planté là ?"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Cours, mon garçon, cours !"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder - Mita"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "Oh !"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Tu es si obéissant !"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Un spécimen exemplaire !"}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Je te veux pour moi toute seule !"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "Mais c'était super facile, n'est-ce pas ?"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "Laisse-moi partir !"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": "// Mita"}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "Ne te relâche pas !"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "On a encore plein de jeux à faire !"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "Très bien !"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Maintenant, je vais fermer les yeux..."}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "Et quand je les réouvre,"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "tu dois avoir disparu de mon champ de vision !"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "Tu as bien compris ?"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "Si je te vois, tu seras puni !"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Allez, commençons !"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "C'est inutile."}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide - Mita"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "Tu as réussi !"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Tu t'en sors bien ! Comme c'est excitant !"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "Ça va devenir plus difficile maintenant !"}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "Bien plus difficile."}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Cache-toi ! Cours ! Et tourne en rond !"}
{"category": "LocationDialogue Location20", "line_index": 87, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "Va au diable !"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Player fall - Player"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "Je pense m'en être échappé."}
