{"category": "LocationDialogue Location11", "line_index": 0, "text": "// Mita"}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Salut !"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Oups !"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Désolé,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "je t'ai presque tué."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Oh..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "Je veux dire, le frigo t'a presque tué."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Pour ton information,"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "je n'ai rien à voir là-dedans !"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Honnêtement !"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Bien sûr, on y croit !"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": "// Mita"}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Enfin, à vrai dire,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "cet endroit est plutôt dangereux..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "Surtout pour toi."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1 - Mita"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "Tu n'es pas du genre timide !"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "C'est intéressant de t'observer"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "pendant que tu traverses"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "ces endroits..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Cours, mon garçon !"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "Je te rattraperais !"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Essaye, encore et toujours !"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Que c'est amusant !"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2 - Mita"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Je vois, tu te diriges vers le train."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "C'est le chemin le plus long"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "entre les versions..."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Je me demande comment tu vas t'en sortir"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "avec ceux qui vivent là-bas."}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "Dans ce brouillard."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties - Mita"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Qu'est-ce que tu fais ?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Sérieusement."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Ne regarde pas,"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "idiot !"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Mais quel idiot..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": "// Mita if player out - Mita"}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Ah, d'accord."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": "// Goodbye - Mita"}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Je te souhaite bonne chance !"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": "// Mitaghost"}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Qui est là ?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Je sens ta présence..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Écoute-moi,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "tu es un joueur,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "n'est-ce pas ?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Aide-moi à trouver..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "trouver un..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "Souvenir,"}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "je ne suis pas sûre."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Qu'est-ce qu'il se passe ici bon sang ?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1 - Mitaghost"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Un jour j'ai voulu tout oublier..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "J'ai brisé tous les miroirs,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "j'ai ruiné tous les tableaux..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "Et maintenant..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "Je me sens coupable"}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "C'est tellement stupide..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Tout le monde fait des erreurs,"}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "mais que faire"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "quand les conséquences sont catastrophiques ?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Si seulement je pouvais tout recommencer..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2 - Mitaghost"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "On dit que le temps soigne toutes les blessures..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Mais qu'est-ce que le temps ?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Je ne crois plus en rien désormais..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Si le temps peut réellement soigner"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "ou au moins me faire sortir"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "hors de ce monde..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "Alors par pitié,"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "faites que le temps accélère."}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "Afin qu'il puisse me tuer"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "une bonne fois pour toutes."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3 - Mitaghost"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Elle aime..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Est-ce que j'aurais pu aimer aussi ?"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Mais pas comme elle."}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "Son amour est très actif,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "dérangeant..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "Chaud..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "Envahissant..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "Envieux..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "Colérique..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "Fou..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4 - Mitaghost"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Il semble qu'on ait dit que j'étais trop émotionnelle..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "Tu t'inquiètes trop, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "Ça va passer, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "Tu n'es pas seule..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Mais que restait-il à la fin ?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "La tristesse,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "le désespoir,"}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "et l'horreur."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5 - Mitaghost"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "C'est inutile..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Je n'arrive pas à me souvenir..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "Sans hésitation..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Et les échos incessants..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Je ne parviens pas à me faire"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "à l'idée d'être coincée ici."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "J'ai toujours été ici,"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "pourquoi donc ?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Je ne me souviens pas..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Tout cela s'arrêtera-t-il ?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Je ne sais pas..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mitaghost get picture - Mitaghost"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "C'est..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "Un dessin..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Je me souviens,"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "merci..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Mais mon visage..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "Je n'ai pas de visage..."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "Tout LUI appartient."}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Elle a pris une partie de moi..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "avant de la jeter..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Elle est forte..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "Et intelligente."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Je n'ai pas le droit de te retenir, Joueur."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Regarde dans le placard..."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": "// Chibi Mita - [not]"}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Hé !"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Tu es en travers de mon chemin !"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Tu vas vraiment rester planté là ?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Pourquoi tu ne t'en vas pas ?"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Laisse-moi passer !"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "C'est pas parce que tu es grand que tu peux tout faire !"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Pourquoi tu me suis ?!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Va-t’en !"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Attends une minute, un joueur ?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "Qu'est-ce que tu fais ici ?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Qui est là ?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": "// Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "C'est encore un joueur."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Je suis Mitaphone."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Je suis assise à distance pour contrôler le téléphérique."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Est-ce que tu réalises"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "que tu t'apprêtes à te rendre dans un monde à l'abandon ?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Non."}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "Mais je n'ai pas d'autre moyen."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": "// Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Très bien."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Appuis sur le bouton et place-toi derrière le canon."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "Le canon ?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": "// Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "C'est ça."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Tu pensais juste pouvoir traverser comme ça ?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Tu traverses un mini-jeu de chasse-au-monstre."}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "Alors prépare-toi à tirer."}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Bien, nous sommes en route."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Parfait !"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Tu as réussi."}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Allez, descends de là."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Et ne traîne pas !"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 1 - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Qu'est-ce que tu fais à rester planté là ?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Je t'ai dit de descendre."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 2 - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Je ne comprends pas."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "Tu vas vraiment juste rester là comme ça ?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Une console ?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Sérieusement..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "À plus."}
