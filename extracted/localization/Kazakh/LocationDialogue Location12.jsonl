{"category": "LocationDialogue Location12", "line_index": 0, "text": "// Mita"}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Мұнда отыр."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Мен бірнәрсе түсіріп алдым. Қазір қайтып келемін."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "Сосын біз кезекті жаңа әлемге барамыз."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": "// MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Жақсы."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": "// MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Ойнайық!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Аюды қалаймын!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "Мен оны жоғалтып алдым..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "Оны тап!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": "// MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Сен..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "Ал неге қарап тұрсың?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Answer 1 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Мен Мита."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "Ең жақсы Мита."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "Бірінші Мита."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "Солай Мита айтты. Менің Митам."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Answer 2 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "Қалай мен көрінемін?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "Қалай мен көрінемін?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "Қалай мен көрінемін?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "Менің Митам айтты, мен әдемі және ерекше."}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "Солай мен көрінемін."}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Answer 3 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Ол мені алып кетеді."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Біз жаңа әлемде өмір сүреміз."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "Менің Митам мені шақырды."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Ол мені алып кетеді. Біз ойнаймыз."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Answer 4 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "Аю — бұл сен."}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "Және сен жоғалып кеттің,"}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "Менің аюым сияқты."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Answer 5 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "Менің..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "Митам."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Ойнағысы келеді."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Ол алып кеткісі келеді"}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "Тек мені."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Біз ерекшеміз."}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "Біз жалғызбыз."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Мита және менің Митам,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0.8A және 8М54*"}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Answer 6 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "Менің Митам..."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "Менің ең жақын досым..."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "Менің Митам."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "Менің жалғыз досым."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": "// MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "Бұл — сен!"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Қара."}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Ойнаймыз!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Мен саған көрсетемін."}
