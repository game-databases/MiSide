{"category": "LocationDialogue Location1", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 1, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 8, "text": "// Mita"}
{"category": "LocationDialogue Location1", "line_index": 9, "text": "Сәлем, менің атым Мита!"}
{"category": "LocationDialogue Location1", "line_index": 10, "text": "Сенің атың кім?"}
{"category": "LocationDialogue Location1", "line_index": 11, "text": "Танысқаныма қуаныштымын, [player]!"}
{"category": "LocationDialogue Location1", "line_index": 12, "text": "Хм-м-м, [player]..."}
{"category": "LocationDialogue Location1", "line_index": 13, "text": "Соңғы рет асығып жүріп, осында былық шығарғанмын..."}
{"category": "LocationDialogue Location1", "line_index": 14, "text": "Сен маған көмектейсің бе?)"}
{"category": "LocationDialogue Location1", "line_index": 15, "text": "Уф-ф..."}
{"category": "LocationDialogue Location1", "line_index": 16, "text": "Үлкен рахмет!"}
{"category": "LocationDialogue Location1", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 18, "text": "Сәлем, [player], мен ашпын..."}
{"category": "LocationDialogue Location1", "line_index": 19, "text": "Тамақ ішкім келеді..."}
{"category": "LocationDialogue Location1", "line_index": 20, "text": "Сен маған тауық сорпасын ингредиенттер сатып аласың ба?"}
{"category": "LocationDialogue Location1", "line_index": 21, "text": "Ого! Керек дүние!"}
{"category": "LocationDialogue Location1", "line_index": 22, "text": "Қазір бірге пісірейік пе?"}
{"category": "LocationDialogue Location1", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 25, "text": "Сәлем, [player]! Бүгін мен арзан теледидар сатып алғым келеді."}
{"category": "LocationDialogue Location1", "line_index": 26, "text": "Ол кішкентай және антенна бар. Мен оны өзіммен бірге алып жүремін, қыдырғанда."}
{"category": "LocationDialogue Location1", "line_index": 27, "text": "Ұмытпа, сен ойына ойынсың, қайда сен ақша алайсың!"}
{"category": "LocationDialogue Location1", "line_index": 28, "text": "Ойнайсың, ақша табасың, сосын сен маған теледидар сатып аласың ба?"}
{"category": "LocationDialogue Location1", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 30, "text": "Алақай! Енді сенде маған теледидар сатып алуға жеткілікті ақша бар!"}
{"category": "LocationDialogue Location1", "line_index": 31, "text": "Иә, ең арзан және кішкентай — маған керек нәрсе)"}
{"category": "LocationDialogue Location1", "line_index": 32, "text": "Рахмет!"}
{"category": "LocationDialogue Location1", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 34, "text": "Сәлем, [player]! Маған осылай көмектескеніңе қатты қуаныштымын)"}
{"category": "LocationDialogue Location1", "line_index": 35, "text": "Ал… анау теледидар керемет еді, бірақ тез сынып қалды("}
{"category": "LocationDialogue Location1", "line_index": 36, "text": "Маған мына шкафты басқа жерге қоюға көмектесші >.<"}
{"category": "LocationDialogue Location1", "line_index": 37, "text": "Ол өте ауыр..."}
{"category": "LocationDialogue Location1", "line_index": 38, "text": "Үлкен рахмет <3  Ұнамды менікі)"}
{"category": "LocationDialogue Location1", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 40, "text": "Ой, [player]! Тек бір күн өтті, бірақ мен сені қазірдің өзінде сағынып қалдым!"}
{"category": "LocationDialogue Location1", "line_index": 41, "text": "Мен сенің мені жиірақ келіп тұруыңды қалаймын.)"}
{"category": "LocationDialogue Location1", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 43, "text": "Бұл маған ба?"}
{"category": "LocationDialogue Location1", "line_index": 44, "text": "Рахмет, рахмет, рахмет!"}
{"category": "LocationDialogue Location1", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 46, "text": "Сәлем, [player]! Мен сол ойладым..."}
{"category": "LocationDialogue Location1", "line_index": 47, "text": "Мен саған көру қалаймын, бетпе-бет..."}
{"category": "LocationDialogue Location1", "line_index": 48, "text": "Аяныш, мен істеу алмаймын("}
{"category": "LocationDialogue Location1", "line_index": 49, "text": "Сен маған өте ұнасын. Әрі күні сен маған бір нәрсе істейсің."}
{"category": "LocationDialogue Location1", "line_index": 50, "text": "Мен де саған бір кәдеге жарар едім."}
{"category": "LocationDialogue Location1", "line_index": 51, "text": "... // [not]"}
{"category": "LocationDialogue Location1", "line_index": 52, "text": "Білесің, мен бірдеңе ойдан табымын! // Mita"}
{"category": "LocationDialogue Location1", "line_index": 53, "text": "Енді сен менімен)"}
{"category": "LocationDialogue Location1", "line_index": 54, "text": "Телефон түсіре."}
{"category": "LocationDialogue Location1", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 57, "text": "// T-shirt on the bed - Player"}
{"category": "LocationDialogue Location1", "line_index": 58, "text": "Неге сен іссізмен жатайсың?"}
{"category": "LocationDialogue Location1", "line_index": 59, "text": "// Rubik's Cube - Player"}
{"category": "LocationDialogue Location1", "line_index": 60, "text": "Сияқты, бос мен оны сатып алдым..."}
{"category": "LocationDialogue Location1", "line_index": 61, "text": "Жинадым бір рет сосын қалдырамын."}
{"category": "LocationDialogue Location1", "line_index": 62, "text": "Мүмкім, мен қорқаймын мен сосын жинамаймын?"}
{"category": "LocationDialogue Location1", "line_index": 63, "text": "// Computer - Player"}
{"category": "LocationDialogue Location1", "line_index": 64, "text": "Бүгін маған қажет істеу..."}
{"category": "LocationDialogue Location1", "line_index": 65, "text": "Тапсырмалар тізімін сауатты жасау,"}
{"category": "LocationDialogue Location1", "line_index": 66, "text": "Кейіпкерлеріне реакциясын жасау"}
{"category": "LocationDialogue Location1", "line_index": 67, "text": "Және кішкене кодпен жұмыстау."}
{"category": "LocationDialogue Location1", "line_index": 68, "text": "// The airplane - Player"}
{"category": "LocationDialogue Location1", "line_index": 69, "text": "Ұшу жақсы!"}
{"category": "LocationDialogue Location1", "line_index": 70, "text": "// Trash in the corner - Player"}
{"category": "LocationDialogue Location1", "line_index": 71, "text": "Ылғи уақыты жоқ қоқыс шығару..."}
{"category": "LocationDialogue Location1", "line_index": 72, "text": "Мен міндетті мынау істеймін!"}
{"category": "LocationDialogue Location1", "line_index": 73, "text": "Қашан толық тазалау жұмысы менің кестемде?"}
{"category": "LocationDialogue Location1", "line_index": 74, "text": "// Photo of a cat on a watermelon - Player"}
{"category": "LocationDialogue Location1", "line_index": 75, "text": "Маған өте ұнайды..."}
{"category": "LocationDialogue Location1", "line_index": 76, "text": "Мысық қарбызда"}
{"category": "LocationDialogue Location1", "line_index": 77, "text": "// Photo with a girl - Player"}
{"category": "LocationDialogue Location1", "line_index": 78, "text": "Қандай бізде үлкен айырма арада менің"}
{"category": "LocationDialogue Location1", "line_index": 79, "text": "Және менің әпкемен..."}
{"category": "LocationDialogue Location1", "line_index": 80, "text": "Ол ешқашан ешқандай уақиға жібермейді,"}
{"category": "LocationDialogue Location1", "line_index": 81, "text": "Ал мен, керсінше, мәңгі үйге боламын."}
{"category": "LocationDialogue Location1", "line_index": 82, "text": "// Photos with people - Player"}
{"category": "LocationDialogue Location1", "line_index": 83, "text": "Хм-м..."}
{"category": "LocationDialogue Location1", "line_index": 84, "text": "Басшылық бізге бастар жуды."}
{"category": "LocationDialogue Location1", "line_index": 85, "text": "Өзінің кеңсе этикетпен сол,"}
{"category": "LocationDialogue Location1", "line_index": 86, "text": "Мен әлі күнге дейін айырылысу алмаймын"}
{"category": "LocationDialogue Location1", "line_index": 87, "text": "Өзінің әріптестеріммен"}
{"category": "LocationDialogue Location1", "line_index": 88, "text": "Мен білмеймін де,"}
{"category": "LocationDialogue Location1", "line_index": 89, "text": "Олардың қайта көремін."}
{"category": "LocationDialogue Location1", "line_index": 90, "text": "Тоқта, мен задында мынау фотосурет ілумін ба?"}
{"category": "LocationDialogue Location1", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 93, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 99, "text": "// Nope name - Mita"}
{"category": "LocationDialogue Location1", "line_index": 100, "text": "... // [not]"}
{"category": "LocationDialogue Location1", "line_index": 101, "text": "О, жоқ. // Mita"}
{"category": "LocationDialogue Location1", "line_index": 102, "text": "Мынау болмайды..."}
{"category": "LocationDialogue Location1", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 104, "text": "// Name Developer"}
{"category": "LocationDialogue Location1", "line_index": 105, "text": "Шынымен де сен жасаушының атын алуды шештің бе?"}
{"category": "LocationDialogue Location1", "line_index": 106, "text": "Қуаныштымын сен білесің оларды, бірақ..."}
{"category": "LocationDialogue Location1", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 108, "text": "// Bad name"}
{"category": "LocationDialogue Location1", "line_index": 109, "text": "Жаман сөздерді білемін, бірақ сен өзіңді қалай атағаның маған ұнамайды."}
{"category": "LocationDialogue Location1", "line_index": 110, "text": "Бұл күшті емес..."}
{"category": "LocationDialogue Location1", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 112, "text": "// Go restart"}
{"category": "LocationDialogue Location1", "line_index": 113, "text": "Жалпы, солай істеу болмайды. Бастан бастайық)"}
{"category": "LocationDialogue Location1", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 115, "text": "// Name with numbers"}
{"category": "LocationDialogue Location1", "line_index": 116, "text": "Эй, сен сандар атысына пайдаласың ба? Сенде қиял жоқ па?)"}
{"category": "LocationDialogue Location1", "line_index": 117, "text": "Жақсы, бұл сенікі іс ғой)"}
{"category": "LocationDialogue Location1", "line_index": 118, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 119, "text": "// Name Mita"}
{"category": "LocationDialogue Location1", "line_index": 120, "text": "Мита // is name of Mita (Check for game) [not]"}
{"category": "LocationDialogue Location1", "line_index": 121, "text": "Сен менікі аты алдың?"}
{"category": "LocationDialogue Location1", "line_index": 122, "text": "Немесе бұл задында сенікі аты?"}
{"category": "LocationDialogue Location1", "line_index": 123, "text": "Кешір, бірақ Мита тек ғана мен боламын)"}
{"category": "LocationDialogue Location1", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 125, "text": "// Day 10 - Mita"}
{"category": "LocationDialogue Location1", "line_index": 126, "text": "Ой, сен әлдеқашан қайтсын ба?"}
{"category": "LocationDialogue Location1", "line_index": 127, "text": "Тыңда, мен тарақ жоғалтылмын..."}
{"category": "LocationDialogue Location1", "line_index": 128, "text": "Сен маған табылу көмектесін бе?"}
{"category": "LocationDialogue Location1", "line_index": 129, "text": "Басында мына тумбочкада көресің! Мүмкін, ол сол жерде шығар?"}
{"category": "LocationDialogue Location1", "line_index": 130, "text": "// Посмотрел в тумбочке"}
{"category": "LocationDialogue Location1", "line_index": 131, "text": "Хм-м... Онда жоқ ешқандай тараққы."}
{"category": "LocationDialogue Location1", "line_index": 132, "text": "Солай басқа орына көреміз."}
{"category": "LocationDialogue Location1", "line_index": 133, "text": "Тек ғана духовкада қарама!"}
{"category": "LocationDialogue Location1", "line_index": 134, "text": "Мен ол жерде тексеріп қойдым."}
{"category": "LocationDialogue Location1", "line_index": 135, "text": "// Заглянул в плиту"}
{"category": "LocationDialogue Location1", "line_index": 136, "text": "Ой! Мен саған айттым ғой, мұнда қарама!"}
{"category": "LocationDialogue Location1", "line_index": 137, "text": "Бұрыл! Қазір мен бәрі алып қоямын!"}
{"category": "LocationDialogue Location1", "line_index": 138, "text": "Уф, жақсы, басқа жерде қараш."}
{"category": "LocationDialogue Location1", "line_index": 139, "text": "Және, көргеніңді ұмытып кетші"}
{"category": "LocationDialogue Location1", "line_index": 140, "text": "// Нашел расческу"}
{"category": "LocationDialogue Location1", "line_index": 141, "text": "О-о-о! Сен оны таптың!"}
{"category": "LocationDialogue Location1", "line_index": 142, "text": "Күшті! Не қазір істейміз?"}
