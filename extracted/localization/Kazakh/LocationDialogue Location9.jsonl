{"category": "LocationDialogue Location9", "line_index": 0, "text": "// Mita Chibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Эй, сен!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Сәлем!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Шығуға ниетің бар ма?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Онда маған кілтті табуға көмектесші!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search - MitaChibi  - [not]"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "А-ай! Осында кілтті жоқ! "}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Осында ештеңе жоқ!"}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "Абсолюттік ештеңе!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Таптым!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Мен ойлаған, сен аласалау боларсың!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "Ал сен қандай биік екенсің!"}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "Сіңлідейсің!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "Эм… Сіңілі?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Иә, сіңлі."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Сірә, оны көрмегендей!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Көргенім жоқ! Бұл тым жеңіл айтылған."}
{"category": "LocationDialogue Location9", "line_index": 22, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Сен ақамақсың ба?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "Эм-м..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "Сонымен ақымақсың..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "Қане, кілтті қайдан іздеу керек екенін көрсет!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Міне."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Темірді құбырға таста!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Рахмет!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "Ал қазір маған отын түсір!"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Рахмет!"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Енді осында маған көмектесші!"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Болды! Қазір..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "Қарашы, қалай әдемі..."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Бас, жылдам!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Хоба!"}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "Болды, ала бер!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "Кілтің сенікі!"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// quest 1 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Мен ChibiMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Бір топ жолдармен,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "Ең қарапайым арматурамен,"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "Және керемет шаштармен!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// quest 2 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Мистер биік ақымақ,"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "Сен өте сүйкімді көрінесің,"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "Орынсыз сұрақтары қою.)"}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Бірақ,"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "Сені бірінші рет көріп тұрмын!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Бірақ... // Player"}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Егер біреу менің ғажайып бейнемді ұрлап кетсе, // MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "Онда ол оның ар-намысына болады"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// quest 3 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Сен түсінбедің бе?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "Бұл – өткізу пункті!"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "Миға сұрау салыңыздар!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "Өтіп кетіңіздер!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Мен ақымақтықпен адасқандарды шығарып саламын!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// quest 4 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "Сен кімсің,"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "Саған көмек көрсетпеу үшін?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "Не?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Ессіз."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Қайдан шығып қалдың?"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Мұнда болмағаның жөн,"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "Сондықтан көмектесіп жатырмын!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Сау бол, ақымақшым!) // Mita [not]"}
