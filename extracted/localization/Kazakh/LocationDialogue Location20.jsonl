{"category": "LocationDialogue Location20", "line_index": 0, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Мила! Жоқ! Сен аурусың!"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": "// Mita"}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Ха-ха! МЕН НЕ КӨРІП ТҰРМЫН?"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "Бұл сенің жүзіңдегі жаңа эмоция ма?"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "Көбірек, көбірек, көбірек!"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "Маған жай қарап тұру жалықтырды!"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\" - Mita"}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "Ал қалай, менің тыншымасым,"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "Әлі де қайда болса да сандалып жүруден шаршамадың ба?"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Сен Миламен не істедің?"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": "// Mita"}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "Демек, шаршамадың!"}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Кел, тағы да бірге ойнайық!"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "Сен..."}
{"category": "LocationDialogue Location20", "line_index": 18, "text": "// Mita"}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "Кішкентай тесттен бастайық!"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "Координацияңды тексеріп көрейік!"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "Мінез-құлқыңды сынап көрейік!"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "Кенет сенімен бірдеңе дұрыс емес шығар?"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "Кенет сен сол ТЕРІНІ"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "Мақтанып киюге лайық емессің?"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "Міне, қара,"}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "Қандай таңдайсың?"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "Оң жақтағы"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "Немесе"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "Сол жақтағы?"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "Шын айтасың ба?"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "Қандай айырмашылық бар?"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "Мен жай ғана әзілдедім ғой!)"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "Қойшы. Пышақтасу – өткен ғасырдың ісі."}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "Жарайды онда."}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "Менде бұдан да қызығырақ ойлар бар."}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "Әуелі..."}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "Қарашы, менде не бар!"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Бізге кішкене музыка керек."}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "Әуені қалай?"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "Мені ол керемет қуантады!"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "Мен бастаймын"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "Ережеден!"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rule"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "Әуен ойнап тұрған кезде,"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "Қозғала аласың."}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "Егер әуен тоқтаса,"}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "Қозғалма,"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "Әйтпесе өлесің!"}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "Қара: сен соңына дейін жетуің керек."}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "Шамаң жетсе —"}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "Ойынды жалғастырамыз!"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "Ал неге тұрсың?"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Жүгір, балақай жүгір!"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder - Mita"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "Оу!"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Сен сондай тыңдағышсың!"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Тамаша үлгі!"}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Сені өзіме алғым келеді!"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "Бірақ бұл өте оңай болды, солай емес пе?"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "Менің жібер!"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": "// Mita"}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "Босаңсыма!"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "Әлі талай ойын алда!"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "Сонымен! // Close eyes"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Енді мен көзімді жабамын."}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "Ал ашқан кезде, // open eyes"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "Сенің із-түзсіз жоқ болғаның жөн!"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "Түсіндің бе?"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "Егер көріп қалсам — жазалаймын!"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Окей, бастайық!"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "Бұл бос әурешілік."}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide - Mita"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "Жетіп алдың!"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Жарайсың! Бұл керемет әсер береді!"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "Енді қиын болады!"}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "Бірнеше ес-се-е қиын..."}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Тығыл! Жүгір! Сосын айнал!"}
{"category": "LocationDialogue Location20", "line_index": 87, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "Сені шайтан алсын!"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Player fall - Player"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "Сірә, аман қалдым…"}
