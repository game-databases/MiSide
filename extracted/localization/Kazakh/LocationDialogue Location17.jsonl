{"category": "LocationDialogue Location17", "line_index": 0, "text": "// Player thinks"}
{"category": "LocationDialogue Location17", "line_index": 1, "text": "Сияқты, мұнда жалғыз жеңе алмаймын."}
{"category": "LocationDialogue Location17", "line_index": 2, "text": "Осындағы Мита тістемейді деп үміттенемін..."}
{"category": "LocationDialogue Location17", "line_index": 3, "text": "// Coffee"}
{"category": "LocationDialogue Location17", "line_index": 4, "text": "Мен уақытымды неге жұмсап жүрмін..."}
{"category": "LocationDialogue Location17", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 9, "text": "// Player tries to wake up Mitu "}
{"category": "LocationDialogue Location17", "line_index": 10, "text": "Мита? // Try 1"}
{"category": "LocationDialogue Location17", "line_index": 11, "text": "Мита, оян. // Try 2"}
{"category": "LocationDialogue Location17", "line_index": 12, "text": "Ми-ита. // Try 3"}
{"category": "LocationDialogue Location17", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 14, "text": "Мита, оян!"}
{"category": "LocationDialogue Location17", "line_index": 15, "text": "Маған сенің көмектесі керек."}
{"category": "LocationDialogue Location17", "line_index": 16, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 17, "text": "Сен кі-імсің?"}
{"category": "LocationDialogue Location17", "line_index": 18, "text": "// Player"}
{"category": "LocationDialogue Location17", "line_index": 19, "text": "Тетікпен маған көмектесші."}
{"category": "LocationDialogue Location17", "line_index": 20, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 21, "text": "Қандай тағы тетік?"}
{"category": "LocationDialogue Location17", "line_index": 22, "text": "Ұйықтай берші..."}
{"category": "LocationDialogue Location17", "line_index": 23, "text": "Немесе маған кофе істеп берісші."}
{"category": "LocationDialogue Location17", "line_index": 24, "text": "// Player"}
{"category": "LocationDialogue Location17", "line_index": 25, "text": "Мұнда екі қадам жасау керек..."}
{"category": "LocationDialogue Location17", "line_index": 26, "text": "Мита?"}
{"category": "LocationDialogue Location17", "line_index": 27, "text": "Ми-ита!"}
{"category": "LocationDialogue Location17", "line_index": 28, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 31, "text": "// Player gives away the coffee"}
{"category": "LocationDialogue Location17", "line_index": 32, "text": "Мита."}
{"category": "LocationDialogue Location17", "line_index": 33, "text": "Міне, кофең."}
{"category": "LocationDialogue Location17", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 37, "text": "// MitaDream exercise"}
{"category": "LocationDialogue Location17", "line_index": 38, "text": "Сен тетіктер "}
{"category": "LocationDialogue Location17", "line_index": 39, "text": "Туралы айттың ба?"}
{"category": "LocationDialogue Location17", "line_index": 40, "text": "// Player"}
{"category": "LocationDialogue Location17", "line_index": 41, "text": "Иә."}
{"category": "LocationDialogue Location17", "line_index": 42, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 43, "text": "Ал сен оларды қайдан білесің?"}
{"category": "LocationDialogue Location17", "line_index": 44, "text": "Бірақ мен не сұрап тұрмын..."}
{"category": "LocationDialogue Location17", "line_index": 45, "text": "Егер сен осында болсаң,"}
{"category": "LocationDialogue Location17", "line_index": 46, "text": "Онда сен көп нәрсені білесің..."}
{"category": "LocationDialogue Location17", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 48, "text": "Тоқта,"}
{"category": "LocationDialogue Location17", "line_index": 49, "text": "Отыру керек."}
{"category": "LocationDialogue Location17", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 51, "text": "Ал сосың?"}
{"category": "LocationDialogue Location17", "line_index": 52, "text": "// Player"}
{"category": "LocationDialogue Location17", "line_index": 53, "text": "Білмеймін, саған не айтуға..."}
{"category": "LocationDialogue Location17", "line_index": 54, "text": "Бірақ маған әрі қарай өту керек."}
{"category": "LocationDialogue Location17", "line_index": 55, "text": "Сақина салып жатқан маршрутпен..."}
{"category": "LocationDialogue Location17", "line_index": 56, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 57, "text": "Сенде оның сақинасы бар ма?"}
{"category": "LocationDialogue Location17", "line_index": 58, "text": "Онда түсінікті,"}
{"category": "LocationDialogue Location17", "line_index": 59, "text": "Қалай сен осында келгенің..."}
{"category": "LocationDialogue Location17", "line_index": 60, "text": "// Player"}
{"category": "LocationDialogue Location17", "line_index": 61, "text": "Дұрыс."}
{"category": "LocationDialogue Location17", "line_index": 62, "text": "Онда сен маған көмектесесің бе?"}
{"category": "LocationDialogue Location17", "line_index": 63, "text": "Тетіктермен?"}
{"category": "LocationDialogue Location17", "line_index": 64, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 65, "text": "Әрине. // Sle"}
{"category": "LocationDialogue Location17", "line_index": 66, "text": "Көмектесемін... // Slee"}
{"category": "LocationDialogue Location17", "line_index": 67, "text": "Тетіктермен... // Sleep"}
{"category": "LocationDialogue Location17", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 69, "text": "// Player"}
{"category": "LocationDialogue Location17", "line_index": 70, "text": "Мита, тағы да ма?"}
{"category": "LocationDialogue Location17", "line_index": 71, "text": "Жүр кеттік."}
{"category": "LocationDialogue Location17", "line_index": 72, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 73, "text": "А?"}
{"category": "LocationDialogue Location17", "line_index": 74, "text": "Жарайды"}
{"category": "LocationDialogue Location17", "line_index": 75, "text": "Кеттік."}
{"category": "LocationDialogue Location17", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 78, "text": "// fall mitadream - Player"}
{"category": "LocationDialogue Location17", "line_index": 79, "text": "Тұршы."}
{"category": "LocationDialogue Location17", "line_index": 80, "text": "Саған шынымен қатты ұйықтағың келе ме?"}
{"category": "LocationDialogue Location17", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 82, "text": "// again sleep mitadream - Player"}
{"category": "LocationDialogue Location17", "line_index": 83, "text": "Оя-ян."}
{"category": "LocationDialogue Location17", "line_index": 84, "text": "Біз әлдеқашан келдік қой."}
{"category": "LocationDialogue Location17", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 86, "text": "// Switches"}
{"category": "LocationDialogue Location17", "line_index": 87, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 88, "text": "Жақсы,"}
{"category": "LocationDialogue Location17", "line_index": 89, "text": "Мен дайынмын."}
{"category": "LocationDialogue Location17", "line_index": 90, "text": "// Player"}
{"category": "LocationDialogue Location17", "line_index": 91, "text": "Мен де дайынмын."}
{"category": "LocationDialogue Location17", "line_index": 92, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 93, "text": "Ал..."}
{"category": "LocationDialogue Location17", "line_index": 94, "text": "Мен бастаймын"}
{"category": "LocationDialogue Location17", "line_index": 95, "text": "Санауды,"}
{"category": "LocationDialogue Location17", "line_index": 96, "text": "Және біз бірге тетіктерді басамыз."}
{"category": "LocationDialogue Location17", "line_index": 97, "text": "Жа-қсы ма? // slow sleep"}
{"category": "LocationDialogue Location17", "line_index": 98, "text": "// Player"}
{"category": "LocationDialogue Location17", "line_index": 99, "text": "Сен тек ұйықтап қалма."}
{"category": "LocationDialogue Location17", "line_index": 100, "text": "Санауды баста."}
{"category": "LocationDialogue Location17", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 102, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 103, "text": "3"}
{"category": "LocationDialogue Location17", "line_index": 104, "text": "2"}
{"category": "LocationDialogue Location17", "line_index": 105, "text": "1"}
{"category": "LocationDialogue Location17", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 107, "text": "// Player lose 1 - MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 108, "text": "Сен не?"}
{"category": "LocationDialogue Location17", "line_index": 109, "text": "Ал,"}
{"category": "LocationDialogue Location17", "line_index": 110, "text": "Тағы бір рет"}
{"category": "LocationDialogue Location17", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 112, "text": "// Player lose 2 - MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 113, "text": "Тағы да?"}
{"category": "LocationDialogue Location17", "line_index": 114, "text": "Және сәл ғана,"}
{"category": "LocationDialogue Location17", "line_index": 115, "text": "Ал мен "}
{"category": "LocationDialogue Location17", "line_index": 116, "text": "Ұйықтап қаламын..."}
{"category": "LocationDialogue Location17", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 118, "text": "// Player lose 3 - MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 119, "text": "Қазір ұйықтап қаламын..."}
{"category": "LocationDialogue Location17", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 122, "text": "// Player Win"}
{"category": "LocationDialogue Location17", "line_index": 123, "text": "Керемет."}
{"category": "LocationDialogue Location17", "line_index": 124, "text": "Рахмет, Мита."}
{"category": "LocationDialogue Location17", "line_index": 125, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 126, "text": "Угум."}
{"category": "LocationDialogue Location17", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 128, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 129, "text": "Соншама..."}
{"category": "LocationDialogue Location17", "line_index": 130, "text": "Баяу..."}
{"category": "LocationDialogue Location17", "line_index": 131, "text": "Есіктер..."}
{"category": "LocationDialogue Location17", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 133, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 134, "text": "Мен ұйықтау барамын..."}
{"category": "LocationDialogue Location17", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 136, "text": "// Why kitchen? - MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 137, "text": "Неге біз мұнда келдік?"}
{"category": "LocationDialogue Location17", "line_index": 138, "text": "Егер мен асүйдің суық еденінде ұйықтап қалсам,"}
{"category": "LocationDialogue Location17", "line_index": 139, "text": "Онда кінәлі сен боласың."}
{"category": "LocationDialogue Location17", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 141, "text": "// Why bathroom? - MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 142, "text": "Түсінбеймін..."}
{"category": "LocationDialogue Location17", "line_index": 143, "text": "Ал қандай тетіктерді сен мұнда тартқың келді?"}
{"category": "LocationDialogue Location17", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 145, "text": "// Put button - Player"}
{"category": "LocationDialogue Location17", "line_index": 146, "text": "Ештеңе болған жоқ па?"}
{"category": "LocationDialogue Location17", "line_index": 147, "text": "Онда бұл түйме не үшін мұнда?"}
{"category": "LocationDialogue Location17", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 149, "text": "// Cofee - Player"}
{"category": "LocationDialogue Location17", "line_index": 150, "text": "Бәлкім, тағы да кофе ішесің бе?"}
{"category": "LocationDialogue Location17", "line_index": 151, "text": "Қазір тағы да ұйықтап қаласың ғой."}
{"category": "LocationDialogue Location17", "line_index": 152, "text": "// MitaDream"}
{"category": "LocationDialogue Location17", "line_index": 153, "text": "Не?"}
{"category": "LocationDialogue Location17", "line_index": 154, "text": "Жоооқ."}
{"category": "LocationDialogue Location17", "line_index": 155, "text": "Ал бұл кофенің дәмі сұмдық..."}
{"category": "LocationDialogue Location17", "line_index": 156, "text": "Менің жағдайым жақсы…"}
{"category": "LocationDialogue Location17", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 158, "text": "// Button - Player"}
{"category": "LocationDialogue Location17", "line_index": 159, "text": "Мита? Түйме істемейді, естіп тұрсың ба?"}
{"category": "LocationDialogue Location17", "line_index": 160, "text": "Әу?"}
