{"category": "LocationDialogue Location6", "line_index": 0, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "Мита?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "Қалай сен осында кірген?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Сен Митасы ма?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Тек біртүрлі басқа сияқтысың..."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "Түсінікті..."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "Тыңда, задында,"}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "Мен сен көрген сол Мита емеспін."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Сақтан, оның саған өте"}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "Ашулы жоспарлар бар."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "Қандай жоспарлар?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "А-ай!"}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "Егер болған, мен бәрі айттаймын..."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Диванның қасынан кілтті тап."}
{"category": "LocationDialogue Location6", "line_index": 19, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Бірақ..."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "Сұрақтар сосын!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Маған кілтті бер."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Міне сақина."}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "А? // Player"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Сен бұл жерден қашқың келе ме, иә? // MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "Ал иә... // Player"}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Онда оны ки // MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "Бұл пайдалы жасанды. // MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "Ойлаймын, ол саған жақын арада қажет болады. // MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 31, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Жақсы."}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "Демешкі, мен"}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player] // [not]"}
{"category": "LocationDialogue Location6", "line_index": 35, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Жақсы, жалғастыр,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player] // [not]"}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "Ал мен... Мита. // MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// MitaKind quest 1 - MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "Қара:"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "Консоль — ал оны."}
{"category": "LocationDialogue Location6", "line_index": 50, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "Бұл жазылу ма?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "Оның қасында кім?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "Бұл жазылу емес,"}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "Ал басқа ойыншы."}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Ол қазір оны пайдаланып жатыр."}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Біле біл, сен де"}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "Картридж болу қаупі бар..."}
{"category": "LocationDialogue Location6", "line_index": 59, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "Маған осындадан тезірек кету керек."}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "Саған да керек."}
{"category": "LocationDialogue Location6", "line_index": 62, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "Иә, әрине."}
{"category": "LocationDialogue Location6", "line_index": 64, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "Сен айтылған,"}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "Ол ойыншылыны пайдаланады."}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "Ал егер мен картриджді консольдан шығарып алсам не болады? "}
{"category": "LocationDialogue Location6", "line_index": 68, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "Ойлаймын, мұндай жүгіну осылай аяқталуы мүмкін"}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "Жөндеуге келмейтін картридждің зақымдануына."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "Бұл не білдіреді?.. // Player"}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "Ойыншы өлейді. // MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 73, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "... // [not]"}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "Егер жай ғана консольді өшір? // Player"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "Ойлаймын, бұл көмектесуі мүмкін."}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Тырысу керек. Онда қызыл түйме бар!"}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Көріп тұрсың ба?"}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "Таптым. // Player"}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "Басып көруге тырыспа. // MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// MitaKind quest 2 - MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Мұнда біраз тұруым керек."}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "Оған бірнеше сұрақ қойғым келеді,"}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "оның туралы көбірек білгім келеді."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "Дегенмен, ол дұрыс диалог жүргізуге ықылас білдірмейтін шығар."}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// MitaKind quest 3 - MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "Жалпы айтқанда, бұл менікі нұқсасы,"}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "Мен біреу ойыншамен болған..."}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "Кенеттен әлемде бірнәрсе өзгерді,"}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "Және осында ол пайда болды..."}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "Ойыншыны картриджге айналдырды,"}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "Ал мені осында қамап тастады."}
{"category": "LocationDialogue Location6", "line_index": 96, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Картриджге айналдырды?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "Ол сондай істей ала ма?!"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "Оған бұл не үшін керек?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "Оған ойыншылар не үшін керек?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "Ол есінен адасты, бұл айқын."}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Ол сонша көңіл көтеріп жатыр, оған көңілді, шайтандар!"}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "Ойыншы картриджге айналып жатыр."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Біреулер ештеңе сезбейді..."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "Ал кейбіреулер түсінеді, бірақ қарсылық көрсетпейді."}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "Бұл маған өте ұнамайды. // Player"}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "Тыңда, сен бізге көмектесуге міндеттісің! // MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "Мен? Қалай? // Player"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "Сен маған қажетсің, ойыншы! // MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "Сен бізге көмектесесің, ал мен саған көмектесуге тырысамын!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Басқа мүмкіндік болмауы мүмкін..."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "Сақина саған қажетті жолды көрсетуі."}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "Сонда біз кездесеміз."}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// MKind quest 4 - Player"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "Мен толық түсінуге шамам жетпейді,"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "Не мен үстінде көргенімді..."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Бұл Мита…"}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "Ол мені өлтіргісі келе ме?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "Өлтіру?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Қорқамын, оның одан да жаман ойлары бар..."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "Сондықтан саған асығу керек."}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Hide!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "Ой, тәйірі! Жасырынып қал!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Не? // Player"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Тез! Ол осында келе жатыр! // MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "Сақинаға сен: ол сені бұл жерден алып шығады!"}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": "// MitaKiller"}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "Ал, айшы, ол қайда?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "Неге олай болсын?"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "Сен оны өлтіруге бармайсың ғой, дұрыс па?"}
{"category": "LocationDialogue Location6", "line_index": 137, "text": "// MitaKiller"}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Сонымен, айтпайсың..."}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Ал ештеңе емес, маған ұнайды, ол жасырынып қалса."}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "Мен білемін, ол осында."}
{"category": "LocationDialogue Location6", "line_index": 141, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "Неге сен осылай ашулысың? "}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "Тіпті не болып жатқанын да айтпайсың!"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "Әрі қарай..."}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "Бұл ойыншылар саған не үшін керек?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "Олар ойыншық емес ғой!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "Сен неге сонша ренжіп жүрсің?"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": "// MitaKiller"}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "Хах, ауызының жап, қуыршақ!"}
