{"category": "LocationDialogue Location11", "line_index": 0, "text": "// Mita"}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Сәлем!)"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Ай!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Кешір,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "Мен сені өлтіре жаздадым..."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Ай..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "Яғни, мұздатқыш сені өлтіре жаздады."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Мен емеспін)"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "Рас-рас айтамын!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Адал!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Міне алдым және сендім!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": "// Mita"}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Ал, жалпы айтқанда,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "Мұнда қауіпті болу..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "Әсіресе саған."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "Ал сен қорқақ емес екенсің!"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Саған қарау қызықты,"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "Қалай сен "}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "Бұл жерлерден өтесің..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Жүгір-жүгір, балам!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "Сені әлі қуып жетемін!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Талпын-талпын!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Бұл қуанышты!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Көремін, сен фуникулерге барасың."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "Бұл ең ұзақ жол"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "Нұсқалар арасында."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Қызықты, қалай сен"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "Анаумен, кім солда өмір сүреді,"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "Тұманда."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Сен не?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Ал..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Қарама!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Өй, сұмырай!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Сұмырай..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": "// Mita if player out"}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Ал, жарайды..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": "// Goodbye"}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Аман болсың!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": "// Mitaghost"}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Кім осында?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Мен сені сезіп тұрмын..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Тыңда,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "Сен ойыншысың,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "Солай ма?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Маған табуға көмектесші..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "Табу..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "Еске түсіру..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "Мен сенімді емеспін..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Бұл жерде не болып жатыр? // Player"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1 - Mitaghost"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Бір кезде мен бәрін ұмытқым келді..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Бүкіл айналарды сындырдым,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "Суреттерді бүлдірдім..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "Ал енді..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "Мен өзімді кінәлі сезінемін"}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "Және бұл сондай ақымақтық..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Барлығы қателеседі,"}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Бірақ не істеу керек,"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "Егер салдары апатты болса?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Бәрін кері қайтару мүмкін болса ғой..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Айтады, уақыт емдейді..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Бірақ уақыт деген не?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Мен енді ештеңеге сенбеймін..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Егер уақыт емдей алса"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "Немесе ең болмаса мені алып кетсе"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "Осы әлемнен,"}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "Онда сенен өтінемін,"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "Уақытты тездет,"}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "Ол мені өлтіруі үшін"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "Соңғы рет."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Ол жақсы көреді..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Мен де жақсы көре алатын едім."}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Бірақ оның сияқты емес."}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "Оның махаббаты өте белсенді,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "Беймаза,"}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "Ыстық,"}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "Құштар,"}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "Күншіл,"}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "Ашулы,"}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "Ақылсыз..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Сияқты, мені эмоциялық деп атайтын..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "«Сен өте көп уайымдайсың, Мита»..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "«Сен орындайсың, Мита»..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "«Сен жалғыз емессің»..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Бірақ не болды нәтижесінде?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Қайғы,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "Үмітсіздік..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "Және қорқыныш."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Пайдасыз...."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Ешбір елестету алмаймын..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "Қолымнан ештеңе келмейді..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Және осы бітпейтін жаңғырық..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Бұл оймен өмір сүре алмаймын,"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "Мен осында қамалып қалдым..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Мен әрдайым осында болдым."}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "Неге?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Ойда ұстамамын…"}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Бұл шынымен аяқтала ма?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Білмеймін…"}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mitaghost get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Бұл..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "Сурет..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Мен елестетемін!"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "Рахмет саған..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Бірақ менің бетім..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "Менде беті жоқ."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "Бұл бәріне ОЛ!"}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Менің бір бөлігімді жұлып алды!"}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "Және бостықта тасталды..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Ол қатты..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "Және ақылды."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Мен сені бөгей алмаймын, ойыншы."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Шкафқа қара."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": "// Chibi Mita - [not]"}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Эй!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Сен менің жолымды бөгеп тұрсың!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Осылай тұра бересің бе?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Мүмкін, шетке кетерсің?"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Өтуге рұқсат берші!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Егер сен үлкен болсаң, бұл сен бәріне құдіретті деген сөз емес!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Неге сен мені қудалайсың?!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Қойшы мені!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Тоқта, ойыншы ма?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "Ал сен не үшін мұнда келген?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Кім мұнда?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": "// Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Жаңа ойыншы, солай."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Мен Мита-фон."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Отырып, алыстан фуникулерді басқарамын."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Сен түсінесің,"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "Сен қазір қирандыға бара жатырсың ба?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Жоқ."}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "Бірақ менде басқа жолы жоқ."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": "// Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Түсіндікті."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Түймені бас та, зеңбіректің артына отыр."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "Зеңбіре?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": "// Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Аһа."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Ойласың, жай кетесің?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Сен «Монстру-шлёпс» мини-ойыны арқылы өтесің,"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "Сондықтан атылуға дайындал)"}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Ал, біз жолға шығамыз."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Керемет!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Сен орындадың!"}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Жүр, мұнда шық. "}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Ширақ және тез!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 1 - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Сен неге тұрсың? "}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Мен саған мұнда шығу айттым."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 2 - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Мен түсінбеймін."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "Сен шынымен ғана тұрсың ба?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Қандай приставка?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Бра-ат..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Сау бол."}
