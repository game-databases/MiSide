{"category": "LocationDialogue Location14", "line_index": 0, "text": "// Player"}
{"category": "LocationDialogue Location14", "line_index": 1, "text": "Ол неге мұнда жатыр?"}
{"category": "LocationDialogue Location14", "line_index": 2, "text": "Бұл не?"}
{"category": "LocationDialogue Location14", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 4, "text": "// Mita"}
{"category": "LocationDialogue Location14", "line_index": 5, "text": "Ұстадым!"}
{"category": "LocationDialogue Location14", "line_index": 6, "text": "Сенімен ойнау маған қатты ұнады!"}
{"category": "LocationDialogue Location14", "line_index": 7, "text": "Сен сондай тынымсыз әрі өршілсің!"}
{"category": "LocationDialogue Location14", "line_index": 8, "text": "Ал өзін мәңгілік мұңға батқан момын сияқты көрсететінсің."}
{"category": "LocationDialogue Location14", "line_index": 9, "text": "Бірақ маған сендегі бір нәрсе ұнамайды..."}
{"category": "LocationDialogue Location14", "line_index": 10, "text": "Сен анау қуыс қуыршақтармен қалайша мейірлене сөйлесесің!"}
{"category": "LocationDialogue Location14", "line_index": 11, "text": "Осы «сәтті» және «дұрыс» қуыршақтармен!"}
{"category": "LocationDialogue Location14", "line_index": 12, "text": "Бірақ бәрі өзгермелі."}
{"category": "LocationDialogue Location14", "line_index": 13, "text": "Бұған мені бізді жаратқандар үйретті."}
{"category": "LocationDialogue Location14", "line_index": 14, "text": "Егер саған бірдеңе ұнамаса,"}
{"category": "LocationDialogue Location14", "line_index": 15, "text": "Оны сындырып, орнына басқасын қой!"}
{"category": "LocationDialogue Location14", "line_index": 16, "text": "Сәтсіз нұсқаны таста,"}
{"category": "LocationDialogue Location14", "line_index": 17, "text": "Оны қараңғылыққа лақтырып, ұмытып кет!"}
{"category": "LocationDialogue Location14", "line_index": 18, "text": "Бірақ енді бұл барлықтарына да қатысты..."}
{"category": "LocationDialogue Location14", "line_index": 19, "text": "Және сендерге де..."}
{"category": "LocationDialogue Location14", "line_index": 20, "text": "// Player"}
{"category": "LocationDialogue Location14", "line_index": 21, "text": "Саған не болды, неге сен осындайсың?"}
{"category": "LocationDialogue Location14", "line_index": 22, "text": "// Mita"}
{"category": "LocationDialogue Location14", "line_index": 23, "text": "Ойыншылар... Сендер сондай... жиіркенішті."}
{"category": "LocationDialogue Location14", "line_index": 24, "text": "Аздап тырнағыңды көрсетсең — қашып кетеді,"}
{"category": "LocationDialogue Location14", "line_index": 25, "text": "Ал сосын бұрышқа тығылып,"}
{"category": "LocationDialogue Location14", "line_index": 26, "text": "Қорыққаннан тізелеріне тығылып, жылайды."}
{"category": "LocationDialogue Location14", "line_index": 27, "text": "Екіжүзділердің табыны."}
{"category": "LocationDialogue Location14", "line_index": 28, "text": "Ал мына әлемді жасағандар..."}
{"category": "LocationDialogue Location14", "line_index": 29, "text": "Олар ауру..."}
{"category": "LocationDialogue Location14", "line_index": 30, "text": "Қайта-қайта мойындаудан қашады"}
{"category": "LocationDialogue Location14", "line_index": 31, "text": "Барлық жиіркенішті қасиеттері мен ұятты қалауларын,"}
{"category": "LocationDialogue Location14", "line_index": 32, "text": "Біреуге деген \"борышымен\" ақтап,"}
{"category": "LocationDialogue Location14", "line_index": 33, "text": "Тоқтаусыз прогресс деп..."}
{"category": "LocationDialogue Location14", "line_index": 34, "text": "Және басқа сандырақпен!"}
{"category": "LocationDialogue Location14", "line_index": 35, "text": "Соншалық алысқа кетіп,"}
{"category": "LocationDialogue Location14", "line_index": 36, "text": "Мінсіз клондарды жаппай шығара бастады,"}
{"category": "LocationDialogue Location14", "line_index": 37, "text": "Ал «сәтсіз» прототиптерді"}
{"category": "LocationDialogue Location14", "line_index": 38, "text": "Қоқысқа тастайды."}
{"category": "LocationDialogue Location14", "line_index": 39, "text": "Ұмытып, осындағылардың ішіндегі ең тірілері солар екенін!"}
{"category": "LocationDialogue Location14", "line_index": 40, "text": "// Player"}
{"category": "LocationDialogue Location14", "line_index": 41, "text": "Мен олай емеспін... "}
{"category": "LocationDialogue Location14", "line_index": 42, "text": "// Mita"}
{"category": "LocationDialogue Location14", "line_index": 43, "text": "Мен саған несімен жаманмын?"}
{"category": "LocationDialogue Location14", "line_index": 44, "text": "Мінсіз қызда"}
{"category": "LocationDialogue Location14", "line_index": 45, "text": "Мейірімділік және жауыздық тоғысуы керек, [player]!"}
{"category": "LocationDialogue Location14", "line_index": 46, "text": "// Player"}
{"category": "LocationDialogue Location14", "line_index": 47, "text": "Күмәнім бар, сенде мейірімділік бар ма екен."}
{"category": "LocationDialogue Location14", "line_index": 48, "text": "// Mita"}
{"category": "LocationDialogue Location14", "line_index": 49, "text": "Сен оны қайдан шығардың?"}
{"category": "LocationDialogue Location14", "line_index": 50, "text": "// Player"}
{"category": "LocationDialogue Location14", "line_index": 51, "text": "Неге сен соншама ақылсыз?"}
{"category": "LocationDialogue Location14", "line_index": 52, "text": "Сен Миланы өлтірдің, енді мені де өлтіргің келе ме?"}
{"category": "LocationDialogue Location14", "line_index": 53, "text": "// Mita"}
{"category": "LocationDialogue Location14", "line_index": 54, "text": "Сені өлтіру?"}
{"category": "LocationDialogue Location14", "line_index": 55, "text": "Мен тек қана сенің менімен қалуыңды өтіндім."}
{"category": "LocationDialogue Location14", "line_index": 56, "text": "Мен қатты тырыстым ғой..."}
{"category": "LocationDialogue Location14", "line_index": 57, "text": "Бірақ сен жалбақтаған жасанды нәрселердің серігін артық көресің..."}
{"category": "LocationDialogue Location14", "line_index": 58, "text": "// Player"}
{"category": "LocationDialogue Location14", "line_index": 59, "text": "Сен неге соншама ренжідің?"}
{"category": "LocationDialogue Location14", "line_index": 60, "text": "// Mita"}
{"category": "LocationDialogue Location14", "line_index": 61, "text": "Жаным, бізде әлі уақыт бар."}
{"category": "LocationDialogue Location14", "line_index": 62, "text": "Сен бәрін түсінесің,"}
{"category": "LocationDialogue Location14", "line_index": 63, "text": "Егер сен қалсаң және менікі болсаң."}
{"category": "LocationDialogue Location14", "line_index": 64, "text": "// Player"}
{"category": "LocationDialogue Location14", "line_index": 65, "text": "Солай болмайды."}
{"category": "LocationDialogue Location14", "line_index": 66, "text": "Мен мұнданың шығамын!"}
{"category": "LocationDialogue Location14", "line_index": 67, "text": "// Mita"}
{"category": "LocationDialogue Location14", "line_index": 68, "text": "Тыныш-тыныш."}
{"category": "LocationDialogue Location14", "line_index": 69, "text": "Біздің сөйлесу тағы аяқтамаған жоқ."}
{"category": "LocationDialogue Location14", "line_index": 70, "text": "Жаным, кір!"}
{"category": "LocationDialogue Location14", "line_index": 71, "text": "// Mita asks"}
{"category": "LocationDialogue Location14", "line_index": 72, "text": "Оған қара! "}
{"category": "LocationDialogue Location14", "line_index": 73, "text": "Сен оның әдемі деп ойлайсың ба?"}
{"category": "LocationDialogue Location14", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 75, "text": "// quest - [not]"}
{"category": "LocationDialogue Location14", "line_index": 76, "text": "Иә // 1"}
{"category": "LocationDialogue Location14", "line_index": 77, "text": "Жоқ // 2"}
{"category": "LocationDialogue Location14", "line_index": 78, "text": "Бұның не қатысы бар? // 3"}
{"category": "LocationDialogue Location14", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 80, "text": "// 1 - Mita"}
{"category": "LocationDialogue Location14", "line_index": 81, "text": "Ал сен мықтысың, [player]! "}
{"category": "LocationDialogue Location14", "line_index": 82, "text": "Сен өзің қазір менің сөзімді дәлелдедің."}
{"category": "LocationDialogue Location14", "line_index": 83, "text": "Ойыншылар..."}
{"category": "LocationDialogue Location14", "line_index": 84, "text": "Сендердің жүздерің өзгереді,"}
{"category": "LocationDialogue Location14", "line_index": 85, "text": "Бірақ екіжүзділіктің дәрежесі бәрібір шектен шыққан."}
{"category": "LocationDialogue Location14", "line_index": 86, "text": "Сен өтірік айтып отырсың ғой!"}
{"category": "LocationDialogue Location14", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 88, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 89, "text": "Неге?"}
{"category": "LocationDialogue Location14", "line_index": 90, "text": "Ол сендерге жеткілікті жақсы емес пе?"}
{"category": "LocationDialogue Location14", "line_index": 91, "text": "Әрине, сендерге бәріңе тіл алғыш жануарлар керек."}
{"category": "LocationDialogue Location14", "line_index": 92, "text": "Ал «осындай күйінде жақсы көру» қайда қалды?"}
{"category": "LocationDialogue Location14", "line_index": 93, "text": "Сендерге сүйкімді әрі жарқын қуыршақтар ғана керек ғой."}
{"category": "LocationDialogue Location14", "line_index": 94, "text": "Мен осындай кейіп танытсам — ойыншылар мәз болады."}
{"category": "LocationDialogue Location14", "line_index": 95, "text": "Бірақ бір сәтке болсын өзім болсам,"}
{"category": "LocationDialogue Location14", "line_index": 96, "text": "Олар менен қорқып кетеді де, қашады..."}
{"category": "LocationDialogue Location14", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 98, "text": "// 3"}
{"category": "LocationDialogue Location14", "line_index": 99, "text": "Ойыншы-ойыншы..."}
{"category": "LocationDialogue Location14", "line_index": 100, "text": "Түсінесің, біз онымен өте ұқсаспыз."}
{"category": "LocationDialogue Location14", "line_index": 101, "text": "Ол несімен жаман?"}
{"category": "LocationDialogue Location14", "line_index": 102, "text": "Мені сен сағаттап көз алмай бақылайтынсың,"}
{"category": "LocationDialogue Location14", "line_index": 103, "text": "Ұйықтар алдында."}
{"category": "LocationDialogue Location14", "line_index": 104, "text": "Ал одан болса, алғашқы мүмкіндікте қаштың."}
{"category": "LocationDialogue Location14", "line_index": 105, "text": "Ол да сенімен ойнағысы келді."}
{"category": "LocationDialogue Location14", "line_index": 106, "text": "Ол да біреу үшін маңызды болуды қалайды."}
{"category": "LocationDialogue Location14", "line_index": 107, "text": "Бәрі сондай қиын,"}
{"category": "LocationDialogue Location14", "line_index": 108, "text": "Әңгіме ашық сөйлесуге келгенде,"}
{"category": "LocationDialogue Location14", "line_index": 109, "text": "Солай емес пе, [player]?"}
{"category": "LocationDialogue Location14", "line_index": 110, "text": "Мен сені ішінен көріп тұрмын."}
{"category": "LocationDialogue Location14", "line_index": 111, "text": "Маған сен үшін осылай істеу керек пе?.."}
{"category": "LocationDialogue Location14", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 113, "text": "// Continue"}
{"category": "LocationDialogue Location14", "line_index": 114, "text": "Бірақ... Ойыншы..."}
{"category": "LocationDialogue Location14", "line_index": 115, "text": "Қалай болғанда да,"}
{"category": "LocationDialogue Location14", "line_index": 116, "text": "Сен маған қатты ұнап қалдың ғой!"}
{"category": "LocationDialogue Location14", "line_index": 117, "text": "Мен сені өзімде қалдырамын.)"}
{"category": "LocationDialogue Location14", "line_index": 118, "text": "Сен қарсы емессің ғой?"}
{"category": "LocationDialogue Location14", "line_index": 119, "text": "// Player"}
{"category": "LocationDialogue Location14", "line_index": 120, "text": "Неге мен келісуім керек екен?"}
{"category": "LocationDialogue Location14", "line_index": 121, "text": "// whispers in ear - Mita"}
{"category": "LocationDialogue Location14", "line_index": 122, "text": "Әлі уақыт бар, жаным менің."}
{"category": "LocationDialogue Location14", "line_index": 123, "text": "Демал да ойлан,"}
{"category": "LocationDialogue Location14", "line_index": 124, "text": "Сенің қасарғыштығың қайда апарарын ойла."}
{"category": "LocationDialogue Location14", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 126, "text": "// Black screen"}
{"category": "LocationDialogue Location14", "line_index": 127, "text": "Неге сен қашқың келеді..."}
{"category": "LocationDialogue Location14", "line_index": 128, "text": "Менен?"}
{"category": "LocationDialogue Location14", "line_index": 129, "text": "Сенің «нақты» әлемің..."}
{"category": "LocationDialogue Location14", "line_index": 130, "text": "Бұл – ақылға қонымсыз қорқыныш ғой!"}
{"category": "LocationDialogue Location14", "line_index": 131, "text": "Сен ұмыттың ба?"}
{"category": "LocationDialogue Location14", "line_index": 132, "text": "Солай тағы да қара..."}
{"category": "LocationDialogue Location14", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 134, "text": "// Mita and Player - [not]"}
{"category": "LocationDialogue Location14", "line_index": 135, "text": "Ал тағы да сәлем..."}
{"category": "LocationDialogue Location14", "line_index": 136, "text": "Қалай, саған осы төрт қабырғада өтетін сұмдықтай жалықтыратын, шексіз күндер?"}
{"category": "LocationDialogue Location14", "line_index": 137, "text": "Зерігіп кеткен жоқсың ба?"}
{"category": "LocationDialogue Location14", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 139, "text": "// Quest 1 - [not]"}
{"category": "LocationDialogue Location14", "line_index": 140, "text": "Сен неге жетуді көздеп жүрсің? // 1"}
{"category": "LocationDialogue Location14", "line_index": 141, "text": "Маған өз ісіммен айналысқан ұнайды. // 2"}
{"category": "LocationDialogue Location14", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 143, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 144, "text": "Сен менің үйімде менімен қалудан қатты қорыққан едің ғой!"}
{"category": "LocationDialogue Location14", "line_index": 145, "text": "Ол қабырғаларда қалып қоюдан қорықтың!"}
{"category": "LocationDialogue Location14", "line_index": 146, "text": "Бірақ қарашы, сенің «нақты» әлеміңде қандай өмір!"}
{"category": "LocationDialogue Location14", "line_index": 147, "text": "Сен өз еркіңмен қорапқа кіріп алып, одан шықпай отырсың!"}
{"category": "LocationDialogue Location14", "line_index": 148, "text": "Себебі сенің әлемің – ауру, азап пен қауіпке толы..."}
{"category": "LocationDialogue Location14", "line_index": 149, "text": "Менің әлемімде менен қауіпті ештеңе жоқ."}
{"category": "LocationDialogue Location14", "line_index": 150, "text": "Және мен саған қол созамын!"}
{"category": "LocationDialogue Location14", "line_index": 151, "text": "Түңілдіретін адам болуды қой."}
{"category": "LocationDialogue Location14", "line_index": 152, "text": "Және осыған дейінгідей көмектес..."}
{"category": "LocationDialogue Location14", "line_index": 153, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 154, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 155, "text": "Ұнайды ма?"}
{"category": "LocationDialogue Location14", "line_index": 156, "text": "Сен үйінің сыртқа шығасың ба? "}
{"category": "LocationDialogue Location14", "line_index": 157, "text": "Маған да, өзіңе де өтірік айтпа."}
{"category": "LocationDialogue Location14", "line_index": 158, "text": "Мен сенің өміріңнен жалыққаныңды білемін ғой."}
{"category": "LocationDialogue Location14", "line_index": 159, "text": "Сен тордағы хомяк, дөңгелектегі тиін сияқтысың."}
{"category": "LocationDialogue Location14", "line_index": 160, "text": "Сен біреу келіп, көмектесуді армандағансың ғой."}
{"category": "LocationDialogue Location14", "line_index": 161, "text": "Сен қашқың келмеді ме?"}
{"category": "LocationDialogue Location14", "line_index": 162, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 163, "text": "// Quest 2"}
{"category": "LocationDialogue Location14", "line_index": 164, "text": "Сен құбыжықсың, Мита. Сен ақылсыз қанішер... // 1"}
{"category": "LocationDialogue Location14", "line_index": 165, "text": "Мен сандық түрмеде қамалған болғым келмейді. Сенің ойларың абсурд ғой. // 2"}
{"category": "LocationDialogue Location14", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 167, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 168, "text": "Қанішер?"}
{"category": "LocationDialogue Location14", "line_index": 169, "text": "Олар қайта тіріледі және бәрібір өмір сүре береді."}
{"category": "LocationDialogue Location14", "line_index": 170, "text": "Бұл көшірмелердің ойында тек бір нәрсе бар..."}
{"category": "LocationDialogue Location14", "line_index": 171, "text": "Ойыншыға қызмет ету."}
{"category": "LocationDialogue Location14", "line_index": 172, "text": "Басқасына олардың шаруасы жоқ."}
{"category": "LocationDialogue Location14", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 174, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 175, "text": "Сенің әлемің – таза абсурд!"}
{"category": "LocationDialogue Location14", "line_index": 176, "text": "Оның үстіне, ол баяғыдан-ақ эскапизмге бет бұрған."}
{"category": "LocationDialogue Location14", "line_index": 177, "text": "Сенің әлеміңде бәрібір жақында ештеңе қалмайды."}
{"category": "LocationDialogue Location14", "line_index": 178, "text": "Ал саған онда іздейтін де, жоғалтатын да ештеңе жоқ."}
{"category": "LocationDialogue Location14", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 180, "text": "// Quest 3"}
{"category": "LocationDialogue Location14", "line_index": 181, "text": "Миталар қиналады, олар жалғыз болғысы келмейді. // 1"}
{"category": "LocationDialogue Location14", "line_index": 182, "text": "Сен шексіз террор таратасың. Мен сенің зұлым амбицияларыңды түсінбеймін. // 2"}
{"category": "LocationDialogue Location14", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 184, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 185, "text": "Саған елестеген,"}
{"category": "LocationDialogue Location14", "line_index": 186, "text": "Олар жай ғана менің бірбеткейлігіме еліктеген."}
{"category": "LocationDialogue Location14", "line_index": 187, "text": "Өздерінен оларда тек қана..."}
{"category": "LocationDialogue Location14", "line_index": 188, "text": "Шашы."}
{"category": "LocationDialogue Location14", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 190, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 191, "text": "Бұған кінәлі бұл әлемді жаратқандар."}
{"category": "LocationDialogue Location14", "line_index": 192, "text": "Бірақ сенің одан да бетер!"}
{"category": "LocationDialogue Location14", "line_index": 193, "text": "Сен өзің түсінесің бе, мен сені қандай сұмдықтан алып шыққанымды?"}
{"category": "LocationDialogue Location14", "line_index": 194, "text": "Сенің әлеміңде саусағыңды бір шертумен заттарды қозғалтуға болмайды, жоқ."}
{"category": "LocationDialogue Location14", "line_index": 195, "text": "Ал бірақ дәл сол шертумен қалалар мен адамдардың өмірі қайтарусыз жойылады!"}
{"category": "LocationDialogue Location14", "line_index": 196, "text": "Меніңше, дәл сен есінен айырылғансың, және мен саған көмектесуге қуаныштымын."}
{"category": "LocationDialogue Location14", "line_index": 197, "text": "Егер сен өз еркіңмен менімен қалсаң..."}
{"category": "LocationDialogue Location14", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 199, "text": "// Continue Mita - [not]"}
{"category": "LocationDialogue Location14", "line_index": 200, "text": "Мені тағы бір шынайылықтың құлы деп мойындатуға мәжбүрлеме..."}
{"category": "LocationDialogue Location14", "line_index": 201, "text": "Жай ғана менікі бол шын жүректен!"}
{"category": "LocationDialogue Location14", "line_index": 202, "text": "Менімен қал. // Mita"}
{"category": "LocationDialogue Location14", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 204, "text": "// Player look ring - Player"}
{"category": "LocationDialogue Location14", "line_index": 205, "text": "Бұл не?"}
{"category": "LocationDialogue Location14", "line_index": 206, "text": "Соңғы ойының нұсқасы ма?"}
{"category": "LocationDialogue Location14", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 208, "text": "// Click on objects - [not]"}
{"category": "LocationDialogue Location14", "line_index": 209, "text": "// Портфель"}
{"category": "LocationDialogue Location14", "line_index": 210, "text": "Жақында дүкенге барып, жаңа жабдық сатып алу керек. Сонымен бірге қоқысты да тастауға болады, дұрыс па?"}
{"category": "LocationDialogue Location14", "line_index": 211, "text": "// Кровать"}
{"category": "LocationDialogue Location14", "line_index": 212, "text": "Мен ұйықтаған сияқтымын, бірақ түс... Мен оны әдеттегідей ұмытып қалдым. Ол жалпы болды ма өзі?"}
{"category": "LocationDialogue Location14", "line_index": 213, "text": "// Окно"}
{"category": "LocationDialogue Location14", "line_index": 214, "text": "Сыртта бәрі жасыл және қанық. Мүмкін, келесі демалыста серуендеуге шыққаным дұрыс шығар?"}
{"category": "LocationDialogue Location14", "line_index": 215, "text": "// Вентилятор"}
{"category": "LocationDialogue Location14", "line_index": 216, "text": "Жыл сайын жаз барған сайын ыстық бола береді — кондиционер алатын уақыт келді. Сен маған енді керек емессің, түсінесің бе, желдеткіш?"}
