{"category": "LocationDialogue Location13", "line_index": 0, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 1, "text": "Сақина!"}
{"category": "LocationDialogue Location13", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 3, "text": "// Answer 1 (Где ты была все это время?) - MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 4, "text": "Мен сені ядроға"}
{"category": "LocationDialogue Location13", "line_index": 5, "text": "Аман-есен жеткізудің жолын іздедім."}
{"category": "LocationDialogue Location13", "line_index": 6, "text": "Бастапқы жоспар солай болды, солай ма?"}
{"category": "LocationDialogue Location13", "line_index": 7, "text": "Сонымен қатар, маған Ақылсыз Митамен"}
{"category": "LocationDialogue Location13", "line_index": 8, "text": "Жолықпаудың амалын табу керек болды, солай ма?"}
{"category": "LocationDialogue Location13", "line_index": 9, "text": "Ал сондай-ақ, мынау қарғыс атқан"}
{"category": "LocationDialogue Location13", "line_index": 10, "text": "Әлемнің бэкенді туралы кез келген ақпаратты табу керек болды, солай ма?!"}
{"category": "LocationDialogue Location13", "line_index": 11, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 12, "text": "Эм... Мүмкін, солай."}
{"category": "LocationDialogue Location13", "line_index": 13, "text": "Бірақ сен сақинада маршрутты қалай баптадың,"}
{"category": "LocationDialogue Location13", "line_index": 14, "text": "Мен бірден багқа толы нұсқаға тап болдым,"}
{"category": "LocationDialogue Location13", "line_index": 15, "text": "Толған қауіп-қатерге?"}
{"category": "LocationDialogue Location13", "line_index": 16, "text": "Ол жерден шығудың жалғыз жолы —"}
{"category": "LocationDialogue Location13", "line_index": 17, "text": "Шексіз түнекке секіру болды."}
{"category": "LocationDialogue Location13", "line_index": 18, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 19, "text": "Кешір, мен нақтылауды ұмытып кетіппін,"}
{"category": "LocationDialogue Location13", "line_index": 20, "text": "Не істеу керек болған..."}
{"category": "LocationDialogue Location13", "line_index": 21, "text": "Бірақ осылай жоспарланған еді!"}
{"category": "LocationDialogue Location13", "line_index": 22, "text": "Сен сыртқа секіресің."}
{"category": "LocationDialogue Location13", "line_index": 23, "text": "Қарасам, сен оны орындапсың!"}
{"category": "LocationDialogue Location13", "line_index": 24, "text": "Жарайсың)"}
{"category": "LocationDialogue Location13", "line_index": 25, "text": "Енді жоспармен жүреміз, түсінесің бе?"}
{"category": "LocationDialogue Location13", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 27, "text": "// Answer 2 (Как ты сюда попала?) - MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 28, "text": "Саған көп нәрсе көруге тура келген"}
{"category": "LocationDialogue Location13", "line_index": 29, "text": "Сен біздің әңгімеміздің бөлшектерін ұмытыпсың"}
{"category": "LocationDialogue Location13", "line_index": 30, "text": "Мен — Мита, мен еркін"}
{"category": "LocationDialogue Location13", "line_index": 31, "text": "ауыса аламын, есіңде ме?"}
{"category": "LocationDialogue Location13", "line_index": 32, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 33, "text": "Барлық Миталар мұны жасай алмайды,"}
{"category": "LocationDialogue Location13", "line_index": 34, "text": "Мен көрген ғой!"}
{"category": "LocationDialogue Location13", "line_index": 35, "text": "Және олар сөзсіз қиналған."}
{"category": "LocationDialogue Location13", "line_index": 36, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 37, "text": "Тоқта. Оларның нұсқалар сынған,"}
{"category": "LocationDialogue Location13", "line_index": 38, "text": "Әлемдерде багтар бар, мен айттым ғой."}
{"category": "LocationDialogue Location13", "line_index": 39, "text": "Құдай-ау..."}
{"category": "LocationDialogue Location13", "line_index": 40, "text": "Сен білесің ғой, кім бұл істеген —"}
{"category": "LocationDialogue Location13", "line_index": 41, "text": "Ақылсыз Мита."}
{"category": "LocationDialogue Location13", "line_index": 42, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 43, "text": "Иә, мен мұны растаймын..."}
{"category": "LocationDialogue Location13", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 45, "text": "// Answer 3 (Что это за Мита была только что?) - MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 46, "text": "Бұл Кейіпсіз Мита."}
{"category": "LocationDialogue Location13", "line_index": 47, "text": "Агрессиялық және ақымақ."}
{"category": "LocationDialogue Location13", "line_index": 48, "text": "Онымен сөйлесу мүмкін емес."}
{"category": "LocationDialogue Location13", "line_index": 49, "text": "Оның әлемі Ақылсыз Митаның төңірегінде айналады."}
{"category": "LocationDialogue Location13", "line_index": 50, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 51, "text": "Иә, мен байқадым."}
{"category": "LocationDialogue Location13", "line_index": 52, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 53, "text": "Кеттік, бізге ядроны ретке келтіру керек."}
{"category": "LocationDialogue Location13", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 55, "text": "// Answer 4 (Как работает кольцо?) - Player"}
{"category": "LocationDialogue Location13", "line_index": 56, "text": "Сақина кесірінен"}
{"category": "LocationDialogue Location13", "line_index": 57, "text": "Ядроға осылай жетуге тура келді ме?"}
{"category": "LocationDialogue Location13", "line_index": 58, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 59, "text": "Иә."}
{"category": "LocationDialogue Location13", "line_index": 60, "text": "Егер портал жасау мүмкін болса,"}
{"category": "LocationDialogue Location13", "line_index": 61, "text": "Онда бірден"}
{"category": "LocationDialogue Location13", "line_index": 62, "text": "Сені осында ауыстыруға болар еді."}
{"category": "LocationDialogue Location13", "line_index": 63, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 64, "text": "Ал, сақинаның қандай да бір пайдасы бар ма? "}
{"category": "LocationDialogue Location13", "line_index": 65, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 66, "text": "Әрине!"}
{"category": "LocationDialogue Location13", "line_index": 67, "text": "Оны кию оңай."}
{"category": "LocationDialogue Location13", "line_index": 68, "text": "Сондай-ақ, ол өткен нұсқаларды есте сақтайды,"}
{"category": "LocationDialogue Location13", "line_index": 69, "text": "Сен болған нұсқаларды."}
{"category": "LocationDialogue Location13", "line_index": 70, "text": "Және сен оларға қайта орала аласың."}
{"category": "LocationDialogue Location13", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 72, "text": "// Answer 5 (Зачем я нужен Безумной Мите?) - Player"}
{"category": "LocationDialogue Location13", "line_index": 73, "text": "Неге мен Ақылсыз Митаға керекпін?"}
{"category": "LocationDialogue Location13", "line_index": 74, "text": "Ол менімен қауіпті ойындар ойнайды,"}
{"category": "LocationDialogue Location13", "line_index": 75, "text": "Бірақ мен әлі тірімін."}
{"category": "LocationDialogue Location13", "line_index": 76, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 77, "text": "Менің ойымша,"}
{"category": "LocationDialogue Location13", "line_index": 78, "text": "Ол өзіне лайық ойыншыны тапқысы келеді,"}
{"category": "LocationDialogue Location13", "line_index": 79, "text": "Оны сол қалпында қабылдайтын ойыншыны. "}
{"category": "LocationDialogue Location13", "line_index": 80, "text": "Дегенмен, Мита – ол Мита! "}
{"category": "LocationDialogue Location13", "line_index": 81, "text": "Бірақ бұл екіталай екені анық"}
{"category": "LocationDialogue Location13", "line_index": 82, "text": "Сондықтан да ол картридждерді пайдаланады: "}
{"category": "LocationDialogue Location13", "line_index": 83, "text": "Осылайша, одан ешкім ешқашан қашып кете алмайды."}
{"category": "LocationDialogue Location13", "line_index": 84, "text": "Меніңше, солай."}
{"category": "LocationDialogue Location13", "line_index": 85, "text": "Маңызды нәрсеге оралайық."}
{"category": "LocationDialogue Location13", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 87, "text": "// Answer 6 (Это ядро?) - Player"}
{"category": "LocationDialogue Location13", "line_index": 88, "text": "Бұл сол ма?"}
{"category": "LocationDialogue Location13", "line_index": 89, "text": "Ядро ма?"}
{"category": "LocationDialogue Location13", "line_index": 90, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 91, "text": "Ядро."}
{"category": "LocationDialogue Location13", "line_index": 92, "text": "Мен мұны әлдеқашан түсіндіруге тырыстым,"}
{"category": "LocationDialogue Location13", "line_index": 93, "text": "Ойыншылар бұл әлемнің бөлігі емес"}
{"category": "LocationDialogue Location13", "line_index": 94, "text": "Сондықтан оларға мұнда ерекше рұқсат қажет емес. "}
{"category": "LocationDialogue Location13", "line_index": 95, "text": "Бұл... тек менің болжамдарым ғана."}
{"category": "LocationDialogue Location13", "line_index": 96, "text": "Бірақ мен толық сенімдімін, "}
{"category": "LocationDialogue Location13", "line_index": 97, "text": "Бұл бөлменің ішінде"}
{"category": "LocationDialogue Location13", "line_index": 98, "text": "Барлық мәселеміздің шешімі бар! "}
{"category": "LocationDialogue Location13", "line_index": 99, "text": "[player], кіріп көр."}
{"category": "LocationDialogue Location13", "line_index": 100, "text": "Шынымен кірдің ғой..."}
{"category": "LocationDialogue Location13", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 102, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 103, "text": "Абайла, [player]!"}
{"category": "LocationDialogue Location13", "line_index": 104, "text": "Ол сені бақылап тұр."}
{"category": "LocationDialogue Location13", "line_index": 105, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 106, "text": "Бұл кім?"}
{"category": "LocationDialogue Location13", "line_index": 107, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 108, "text": "Мен толық түсініп тұрған жоқпын..."}
{"category": "LocationDialogue Location13", "line_index": 109, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 110, "text": "Күшті..."}
{"category": "LocationDialogue Location13", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 112, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 113, "text": "Ал не болды?"}
{"category": "LocationDialogue Location13", "line_index": 114, "text": "Эй!"}
{"category": "LocationDialogue Location13", "line_index": 115, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 116, "text": "Сияқты, мен таптым!"}
{"category": "LocationDialogue Location13", "line_index": 117, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 118, "text": "Күшті! Тамаша!"}
{"category": "LocationDialogue Location13", "line_index": 119, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 120, "text": "Нұсқаны көрсету керек. "}
{"category": "LocationDialogue Location13", "line_index": 121, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 122, "text": "Иә, мен оның нұсқасын таныдым..."}
{"category": "LocationDialogue Location13", "line_index": 123, "text": "00.98"}
{"category": "LocationDialogue Location13", "line_index": 124, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 125, "text": "Бар!"}
{"category": "LocationDialogue Location13", "line_index": 126, "text": "Жақсы, ал индекс қандай?"}
{"category": "LocationDialogue Location13", "line_index": 127, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 128, "text": "Индекс?"}
{"category": "LocationDialogue Location13", "line_index": 129, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 130, "text": "Индексті көрсету керек. "}
{"category": "LocationDialogue Location13", "line_index": 131, "text": "Таба қояйын: сен білмейсің ғой?"}
{"category": "LocationDialogue Location13", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 133, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 134, "text": "Тоқта, бұл қисынды ғой: "}
{"category": "LocationDialogue Location13", "line_index": 135, "text": "Әрбір Митаның өз индексі бар."}
{"category": "LocationDialogue Location13", "line_index": 136, "text": "Бүкіл нұсқаны қайта іске қосудың қажеті жоқ қой..."}
{"category": "LocationDialogue Location13", "line_index": 137, "text": "Қандай сандырақ!"}
{"category": "LocationDialogue Location13", "line_index": 138, "text": "Мен бұны қалай ойламадым?.. "}
{"category": "LocationDialogue Location13", "line_index": 139, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 144, "text": "// Answer 1 (Что с тобой?) - MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 145, "text": "Менімен бәрі жақсы."}
{"category": "LocationDialogue Location13", "line_index": 146, "text": "Егер барлық бәлелерімізді есепке алмасақ."}
{"category": "LocationDialogue Location13", "line_index": 147, "text": "Бәрі күшті, бірақ ештеңе өзгермеген... "}
{"category": "LocationDialogue Location13", "line_index": 148, "text": "Ойлану керек."}
{"category": "LocationDialogue Location13", "line_index": 149, "text": "Толық тоқырау..."}
{"category": "LocationDialogue Location13", "line_index": 150, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 151, "text": "// Answer 2 (Может есть способ узнать его?) - MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 152, "text": "Мен..."}
{"category": "LocationDialogue Location13", "line_index": 153, "text": "Ойлап тұрмын... Сандырақ!"}
{"category": "LocationDialogue Location13", "line_index": 154, "text": "Бұл Ақылсыздық, ха!"}
{"category": "LocationDialogue Location13", "line_index": 155, "text": "Бұл бүргені іздегенмен бірдей ғой. "}
{"category": "LocationDialogue Location13", "line_index": 156, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 157, "text": "Сен не болды? "}
{"category": "LocationDialogue Location13", "line_index": 158, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 159, "text": "Глюк басқан жерлер кейде ақпаратқа толып кетеді,  "}
{"category": "LocationDialogue Location13", "line_index": 160, "text": "Әлемнің ішек-қарындарын сыртқа шығарып тастағандай! "}
{"category": "LocationDialogue Location13", "line_index": 161, "text": "Логтар, логтар, логтар, деректер? "}
{"category": "LocationDialogue Location13", "line_index": 162, "text": "Ал егер шынымен сыртқа шығарып тастаған болса ше?"}
{"category": "LocationDialogue Location13", "line_index": 163, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 164, "text": "ә? Не болды?"}
{"category": "LocationDialogue Location13", "line_index": 165, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 166, "text": "Мен бір жерді білемін! "}
{"category": "LocationDialogue Location13", "line_index": 167, "text": "Мұнда күт."}
{"category": "LocationDialogue Location13", "line_index": 168, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 169, "text": "Сен қайда?"}
{"category": "LocationDialogue Location13", "line_index": 170, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 171, "text": "// Answer 3 (А что если атаковать Безумную Миту?) - Player"}
{"category": "LocationDialogue Location13", "line_index": 172, "text": "Сен айттың ғой, кез келген Мита"}
{"category": "LocationDialogue Location13", "line_index": 173, "text": "Өлгеннен кейін қайта іске қосылады."}
{"category": "LocationDialogue Location13", "line_index": 174, "text": "Ал егер біз..."}
{"category": "LocationDialogue Location13", "line_index": 175, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 176, "text": "Ал егер біз Ақылсыз Митаны өлтірсек ше?"}
{"category": "LocationDialogue Location13", "line_index": 177, "text": "Сен шынымен айтып тұрсың ба? "}
{"category": "LocationDialogue Location13", "line_index": 178, "text": "Ал сен бензопилалы қызға қалай шабуыл жасамақсың? "}
{"category": "LocationDialogue Location13", "line_index": 179, "text": "Тоқта, ол пышақты тек сәбіз турау үшін қолданбайды ғой!"}
{"category": "LocationDialogue Location13", "line_index": 180, "text": "Және ол бір себеппен сұмдық күшті! "}
{"category": "LocationDialogue Location13", "line_index": 181, "text": "Біз әлі тіріміз дегеннің өзі таңғаларлық... "}
{"category": "LocationDialogue Location13", "line_index": 182, "text": "Жүр, бізге ядромен айналысу керек."}
{"category": "LocationDialogue Location13", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 184, "text": "// core console entry"}
{"category": "LocationDialogue Location13", "line_index": 185, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 186, "text": "Кіруді растау керек,"}
{"category": "LocationDialogue Location13", "line_index": 187, "text": "Бірақ ол қандай?"}
{"category": "LocationDialogue Location13", "line_index": 188, "text": "Мита, сен білесің бе?"}
{"category": "LocationDialogue Location13", "line_index": 189, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 190, "text": "Мүмкін, ол бір жерде көрсетілген шығар?"}
{"category": "LocationDialogue Location13", "line_index": 191, "text": "Іздеп көресің бе? "}
{"category": "LocationDialogue Location13", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 193, "text": "// core console - nope programm - Player"}
{"category": "LocationDialogue Location13", "line_index": 194, "text": "Мүмкін, бұл ол емес. // 1"}
{"category": "LocationDialogue Location13", "line_index": 195, "text": "Бұл да келмейді. // 2"}
{"category": "LocationDialogue Location13", "line_index": 196, "text": "Жо-оқ. // 3"}
{"category": "LocationDialogue Location13", "line_index": 197, "text": "Бұл маған керек нәрсе емес.  // 4"}
{"category": "LocationDialogue Location13", "line_index": 198, "text": "Маған кейіпкерді қайта жүктеуді табу керек // 5"}
{"category": "LocationDialogue Location13", "line_index": 199, "text": "// core console - nope version"}
{"category": "LocationDialogue Location13", "line_index": 200, "text": "Бұл дұрыс нұсқа емес. // 1"}
{"category": "LocationDialogue Location13", "line_index": 201, "text": "Әй, қателестім. // 2"}
{"category": "LocationDialogue Location13", "line_index": 202, "text": "Бұл емес. // 3"}
{"category": "LocationDialogue Location13", "line_index": 203, "text": "Түзету керек.. // 4"}
{"category": "LocationDialogue Location13", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location13", "line_index": 205, "text": "Бірдеңе дұрыс емес. // 1"}
{"category": "LocationDialogue Location13", "line_index": 206, "text": "Индекс қате. // 2"}
{"category": "LocationDialogue Location13", "line_index": 207, "text": "Индексті қайта енгізу керек."}
{"category": "LocationDialogue Location13", "line_index": 208, "text": "Келмейді. // 4"}
{"category": "LocationDialogue Location13", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 210, "text": "// Answer 4 (Little people - Chibi) - Player"}
{"category": "LocationDialogue Location13", "line_index": 211, "text": "Білесің бе, мен жолымда"}
{"category": "LocationDialogue Location13", "line_index": 212, "text": "Кішкентай адамдарды кездестірдім. "}
{"category": "LocationDialogue Location13", "line_index": 213, "text": "Олар кім?"}
{"category": "LocationDialogue Location13", "line_index": 214, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 215, "text": "Чиби ме?"}
{"category": "LocationDialogue Location13", "line_index": 216, "text": "Қалай түсіндіруді білмеймін... "}
{"category": "LocationDialogue Location13", "line_index": 217, "text": "Бұл — біздің әлемнің ерекше құбылысы."}
{"category": "LocationDialogue Location13", "line_index": 218, "text": "Әр Митаның чиби-проекциясы бар."}
{"category": "LocationDialogue Location13", "line_index": 219, "text": "Бірақ олар ойыншыларда да пайда болуы мүмкін..."}
{"category": "LocationDialogue Location13", "line_index": 220, "text": "Миталар оларды шақыра алады, білесің бе?"}
{"category": "LocationDialogue Location13", "line_index": 221, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 222, "text": "Қалайша?"}
{"category": "LocationDialogue Location13", "line_index": 223, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 224, "text": "Қазір, қара!"}
{"category": "LocationDialogue Location13", "line_index": 225, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 226, "text": "Мынау бір сиқыр ғой…"}
{"category": "LocationDialogue Location13", "line_index": 227, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 228, "text": "Бірақ менің чибилеріммен әдетте бір нәрсе дұрыс емес: "}
{"category": "LocationDialogue Location13", "line_index": 229, "text": "Олардың көбісі өлі туылады."}
{"category": "LocationDialogue Location13", "line_index": 230, "text": "Дегенмен... біреуі бірдеңе істей алады."}
{"category": "LocationDialogue Location13", "line_index": 231, "text": "Немесе жоқ."}
{"category": "LocationDialogue Location13", "line_index": 232, "text": "Ол жай ғана айналып жүгіріп жүр."}
