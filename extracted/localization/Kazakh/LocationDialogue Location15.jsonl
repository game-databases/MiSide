{"category": "LocationDialogue Location15", "line_index": 0, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Ал сен мұндасың!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Неге сен ядродан кеттің?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Мен саған мені күтуді бұйырған едім, солай ма?"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Мен сені ұзақ жоқ деп ойлап..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Ал жарайды..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Сияқты, мен бірдеңе таптым."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Бұл, шамасы, индекс."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Бұл істей ме, тезірек білу керек!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Жүр, бұл жерден кетейік."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "Ақылсыз Мита..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Ол қазір жаңа ойыншылармен айналысып жатыр деп ойлаймын."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Демек, оған біз керек емеспіз, жорамалдаймын..."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Мита? "}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Менің күтші."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": "// Mita killler"}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Бірдеңе жоғалттың ба!?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Онымен тағы бір рет таныс!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Мита..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Ұста!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Қалайша бұлай..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Сен кімсің?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Сен... тірісің!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Сен ештеңе есіңе түсірмейсің бе?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Мен сені танимын ба?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Бірақ қалайша..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Енді не істеймін?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Мен шыға алмаймын..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "«Шығу» деген не?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": "// Player "}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Тоқта..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "Бұл сақина ғой."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "Ал мынау не?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Мен білмеймін, бұл не)"}
{"category": "LocationDialogue Location15", "line_index": 48, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "Бұл индекс!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Сен оны бәрібір таптың!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Мен не айтарымды білмеймін."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Ядроға қайту керек."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "Ал сен..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Мүмкін, саған менімен бірге барған дұрыс болар."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Не?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Жарайды."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Осы жерде күт."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Аһа."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Мен осында отырып тұрамын."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Бәле..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "Сәл өлдім..."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "Ал... бізде бәрі сәтті болды ма?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Солай..."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Мен дәл осы нұсқадамын."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": "// Mitа"}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Сәлем!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Сен ойыншы ма?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Сенің атың кім?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Мен бұл жерден кеткім келеді."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Сен бұрыннан кеткің келді ме?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "Жалпы, сен мұнда қалай келдің?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Хм-м..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "А-а-ал, кетуға болады."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Жәй ғана үйден шығып көрші)"}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Сәтіллік саған!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Қабырға ма?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Әй, солай болу тиіс емес."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Мүмкін..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "Саған жертөледегі нәрсе көмектесуі мүмкін."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Жақында мен кездейсоқ"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "Мен шкафымда есік тауып алдым..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Бұл жертөле болған."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Ол анық әртүрлі ескі-құсқыны сақтау үшін керек."}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "Ал онда қызық техника сақталған."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Әлдебір кодтарды енгізу керек сияқты..."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Мен мүлде түсінбеймін"}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "Және түсінгім де келмеймін)"}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "Ал онда өте жайсыз. Мүлде!"}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Көресің бе?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Эм... Жарайды."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Сияқты..."}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "Ол бәрін ұмытып қалған."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Демек, біз оны қайта"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "Келтіре алдық па?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Бұл қарғыс атқан ойын"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "Тек шығу ғана қалды..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Тоқта."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Мен сені құшақтағым келеді."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Не?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Mita - hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Сені көргеніме қуаныштымын!"}
{"category": "LocationDialogue Location15", "line_index": 120, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Э-эх..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "Аяныш,"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "Біздер солай"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "Кішкене уақытты өткіздіміз..."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Түсінмедім..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "Сен не туралы айтасың?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Мен онынан,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "Сен менімен қала алар едің."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "Мен онынан кінәлі."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Сол шкаф. Және... дыбыстар."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Оны ертерек ӨЛТІРУІМ керек еді."}
{"category": "LocationDialogue Location15", "line_index": 134, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Тоқта."}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "Сен ұмыттың ба..."}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Сен оны қайдан білесің?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "ХА!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Сен шынымен бәрі осылай оңай болады деп ойладың ба?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Ал сен ақымақсың..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Алайда барлықты сияқта..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Дәл уақытында үлгердік, қара! // Показывает часы"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "Енді сен,"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "«Тірсің»,"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "Керек емессің..."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Кешірші)"}
{"category": "LocationDialogue Location15", "line_index": 148, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Қалайша..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Болмады ма? // Мита убирает часы"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Жоқ, мен сені қайта ретке келтіре алдым!"}
{"category": "LocationDialogue Location15", "line_index": 152, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Сен ештеңе түсінбедің... // Мита опускает руки"}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Ха-ха-ха-ха!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Мен қандай жақсы актрисамын, ә! // Хватает за голову"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Сен өз бетіңді көрсең ғой, жаным!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "Қалай қызық!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Неге сен солайсың?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Сенімен не дұрыс емес?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Ал шынымен... // Мита показывает настоящий облик"}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Менде не дұрыс емес?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Мен де білмеймін..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Мүмкін, сен маған айтасың, неге мен осындаймын?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Неге мен ешқашан Мита болмаймын?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Менің нұсқам ешқашан"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "Болған емес ғой!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Мен жай ғана аңғал ақымақтардың терісін сыпырамын,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "Олардың терісінің астына тығыламын..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Мені жай ғана"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "Қайта ретке келтіре алмайсың!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Сене алмаймын..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Сен..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "Мәселе оларда емес!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "Сен мүлде болмауың керек еді!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "Ал сен де..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Сенен мұны есту ауыр("}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "Және әйтсе де! // Отходит назад"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Сенің уақытың келді!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Жақында тағы да жолығысамыз!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Барлығы дайын,"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "Ойламын."}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "Сені консольден шығаратын уақыт келді!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "Көріскенше!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Сен менің сүйікті картриджім боласың..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Қызықты есімді ойыншы."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm - Player"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Мүмкін, осы емес. // 1"}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Бұл да жарамайды. // 2"}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Жоқ. // 3"}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Маған керек нәрсе емес. // 4"}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Маған кейіпкерді қайта іске қосу керек. // 5"}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "Бұл сол нұсқа емес. // 1"}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Әй, қателестім. // 2"}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Бұл ол емес.  // 3"}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Түзету керек.  // 4"}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Бірдеңе дұрыс емес. // 1"}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "Индекс қате. // 2"}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Индексті қайталау керек. // 3"}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "Сәйкес келмейді. // 4"}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen - MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Сен тамақ ішкің келе ме?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Мен сәбізді керемет турай аламын)"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom - MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Әй, мүмкін..."}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "Сен бұл жерге жалғыз кіргің келе ме?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
