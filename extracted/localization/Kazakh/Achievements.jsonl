{"category": "Achievements", "line_index": 0, "text": "Қымыз."}
{"category": "Achievements", "line_index": 1, "text": "Қараңғылық шерту."}
{"category": "Achievements", "line_index": 2, "text": "Өлі шырын."}
{"category": "Achievements", "line_index": 3, "text": "Пингвиндігіжеңісі."}
{"category": "Achievements", "line_index": 4, "text": "Өмір сейфі."}
{"category": "Achievements", "line_index": 5, "text": "Шыбынның жеңісі."}
{"category": "Achievements", "line_index": 6, "text": "Ой ұлы Митасы!"}
{"category": "Achievements", "line_index": 7, "text": "Мен сені таптым!"}
{"category": "Achievements", "line_index": 8, "text": "Дәмді махаббат."}
{"category": "Achievements", "line_index": 9, "text": "Шарттар орындалды."}
{"category": "Achievements", "line_index": 10, "text": "Жылдамда!"}
{"category": "Achievements", "line_index": 11, "text": "Бастан шапалақ!"}
{"category": "Achievements", "line_index": 12, "text": "Ойыншылардың бәрі менде."}
{"category": "Achievements", "line_index": 13, "text": "Сәлем, Мита."}
{"category": "Achievements", "line_index": 14, "text": "Бұл соңы ма?"}
{"category": "Achievements", "line_index": 15, "text": "Шегіне жеткенше жылдамдадым!"}
{"category": "Achievements", "line_index": 16, "text": "Бұл бір табыс па?"}
{"category": "Achievements", "line_index": 17, "text": "Ұлы би."}
{"category": "Achievements", "line_index": 18, "text": "Ұзын құйрық."}
{"category": "Achievements", "line_index": 19, "text": "Сен өтпейсің!"}
{"category": "Achievements", "line_index": 20, "text": "Логтар бірінші фазада."}
{"category": "Achievements", "line_index": 21, "text": "Логтар екінші фазада."}
{"category": "Achievements", "line_index": 22, "text": "Тозақ жеңісі."}
{"category": "Achievements", "line_index": 23, "text": "Зақымсыз ба?!"}
{"category": "Achievements", "line_index": 24, "text": "Сәбіз."}
{"category": "Achievements", "line_index": 25, "text": "Тірі өмірің жоқ па?"}
