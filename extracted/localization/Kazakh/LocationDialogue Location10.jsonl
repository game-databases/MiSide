{"category": "LocationDialogue Location10", "line_index": 0, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "Тоқта-тоқта!"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "Тек қана ақырын сөйле."}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "Алға бару қауіпті."}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "Және жалпы айтқанда..."}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "Сен мұнда қалай тап болдың?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "Эм..."}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "Сақина маған керек есіктер ашады,"}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "Мен тек қана оның қалай істейтінін білмеймін..."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "Сақина?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "Мына жерге не болған?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "Неге мұнда сонша қараңғы?"}
{"category": "LocationDialogue Location10", "line_index": 15, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "Мен саған кейін айтамын."}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "Шығу жағына бар."}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "Мені ойын автоматында кездестіресің."}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": "// MitaShorthairs (Показывает куда идти)"}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Бар-бар, бөгелме!"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": "// After mini-game"}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "Ал не? Сен мынау ойынның мағынасы түсін ба?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "Менің терімнің астында сүйектер, ал сендердікі манекен бе?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "Ого!"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "Қорқынышты естіледі.("}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "Қорқамын, дәл солай!"}
{"category": "LocationDialogue Location10", "line_index": 33, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "Түсіндім, бірақ неге маған бұл ақпарат керек?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "Ойлайсың ба, мен саған бұл жай ғана айтылдым,"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "Алға жүру қауіпті деп?"}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "Онда сен осы манекендермен кездесесің..."}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "Сол, сәтсіз шыққандар, «жарамсыз» деп танылғандар."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "Олар әдеттегіден агрессивтірек — саған бұл керек пе?"}
{"category": "LocationDialogue Location10", "line_index": 41, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "Ал маған не істеу керек?"}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Қайда есік ашылса,"}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "Сол жаққа барамын."}
{"category": "LocationDialogue Location10", "line_index": 45, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "Әй, сен қызық екенсің!"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "Онда оларға арқанды бұрма"}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "Және олардан көр алмай қара!"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "Олар сен қарағанда қатты ұялады,"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "Соншалық, қатып қалады."}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "Ойлаймын, бұл көмектеседі!"}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// quest 1 - MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "Олар тек скин алды."}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "Енді оларға аздап уақыт керек,"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "Өзін түсіну үшін."}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "Сосын мен әрқайсысыны"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "Өз үйіне апаруым керек."}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// quest 2 - MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "Миталар негізі қараңғылықта «дүниеге келеді»."}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "Сол үшін алдымен оларға біраз уақыт қараңғылықта тұру керек..."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Елестетші,"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "Жарыққа бірден шығу оларға қаншалықты ауыр?"}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// quest 3 - MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "Ал сен әлі түсінбедің бе?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "Мен бишара Миталарға бейімделуге көмектесемін!"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "Оларға кім көмектеседі, егер мен емес?"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "Сен бе?)"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// quest 4 - Player"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "Неге бұл конвейер?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "Бәріне орын жетеді деп ойлайсың ба?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Тоқта, сен жалпы түсінесің бе,"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "Біздің әлем қалай құрылғанын?"}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "Және оның шексіз екенін?"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "Шексіз?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "Хм-м..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "Бірақ қалай?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "Егер ең соңғы нұсқа 1.9 болса,"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "Онда әлемдер барлығы 19 ғана ғой."}
{"category": "LocationDialogue Location10", "line_index": 91, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "Ой бай! Сен "}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "Бұл әлемді мүлде дұрыс елестетпейді екенсің."}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Мен саған осы мектеп тақтасында"}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "Бәрін түсіндіріп бере аламын.."}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "Қаласаң ба?"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// quest 5 - Player"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Маған солай көрінеді,"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "Мен сені ең жаңа нұсқаларда көрген сияқтымын."}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "Немесе маған елестеді..."}
{"category": "LocationDialogue Location10", "line_index": 102, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "Мүмкін!"}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Менің нұқсам — 1.5"}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "Онда болған ба едің?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Иә."}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "Бірінші рет мұнда келгенімде,"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "Мен дәл сол жерде болдым!"}
{"category": "LocationDialogue Location10", "line_index": 110, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "Ого!"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "Ол қалай болды?"}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "Қызық, сен қай үйдің индексіне түстің."}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "Мен бармын, ол әрдайым жылағанды жақсы көреді."}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "Сондай-ақ, мен бармын, ол әрдайым ойнағанды жақсы көреді."}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "Және мен бармын, ол әрдайым ұмытып, қорқытады."}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "Әй, тізе берсең ұзаққа созылады..."}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Бірдеңе есіңде ме?"}
{"category": "LocationDialogue Location10", "line_index": 119, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Қараңғы болды."}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "Және жазбалар!"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "Әлдене сияқты"}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "«Ойнаймыз»."}
{"category": "LocationDialogue Location10", "line_index": 124, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "Әй...)"}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "Қандай ұят."}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "Бұл алайда болған,"}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "Бұл, демек, сол ұмытшақ әрі қорқытатын мен."}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// MSHairs wants to tell you [No] - Player"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Керек емес."}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Қалай да осысыз болып кетемін."}
{"category": "LocationDialogue Location10", "line_index": 133, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "Хм, окей."}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// MSHairs wants to tell you [Yes] - Player"}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "Жақсы, айт."}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "Сенемін, бұл мектеп сияқты болмайды"}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "Және мен зерігуден ұйықтамаймын."}
{"category": "LocationDialogue Location10", "line_index": 140, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "Егер кеткің келсе – кет"}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "Ал егер саған қызықты,"}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "Солай тыңда."}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "Ойыншы MiSide-ты телефонына жүктеді.. // She went to the blackboard"}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "Қуанып отырып ойнайды."}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "Осылайша ол жаңа үй жасады"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "Және жаңа Митасы. // Points to the board"}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "Мұнда екіөлшемді көрініс салынған."}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "Міне нұсқалар, // Points to versions"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "Олар сызық есебінде көрінеді. // Points to lines"}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "Осы сызықтарына үйілер орналасылады. // Points to circles"}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "Яғни, ойын 1.14 нұсқасында жүктелген"}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "Демек, осы нұсқада пайда болады"}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "Жаңа өмір, Мита және онның үйі."}
{"category": "LocationDialogue Location10", "line_index": 155, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "Мәссаған..."}
{"category": "LocationDialogue Location10", "line_index": 157, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Нақты заттарды сұрауыңа болады,"}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "Қай жерде суреттелген."}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "Түсіндіруге тырысамын."}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// He asks about the only circle - Player"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "Неге мұнда жалғыз дөңгелек?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "Бұл нұсқа тек бір рет шығарылған."}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "Ол енді ешбір таралмайды,"}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "Сол себепті ол жалғыз."}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "Сондай-ақ, бұл нұсқаның ерекшелігі,"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "Жанынан өтіп кету мүмкін емес."}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "Осы 1.1-нұсқада Ұйқылы Мита өмір сүреді."}
{"category": "LocationDialogue Location10", "line_index": 171, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "Ұйқылы?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "Бұл себеп, бәрі оның арқылы барады,"}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "Ұйқыны бермейді ме?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "Жоқ."}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "Мен жай ғана оның есігінің жанынан өте аламын,"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "Ішіне кірмей-ақ."}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// He asks about the shaded circle - Player"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "Неге бұл дөңгелек сызылған?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "Жалпы айтқанда, бұл сурет осында"}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "Сүйікті Мита үшін:"}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "Бұл ол суреттеген."}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "Біз одан дауласылған,"}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "Қалай тезірек 1.11 нұсқасына жетуге болады?"}
{"category": "LocationDialogue Location10", "line_index": 188, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "Ал кім бұл дауында кім жеңді?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "Әрине мен ғой!"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "Қара, біз мұндамыз, // Points to the version 1"}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "1.15 нұсқасы"}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "Үйдің индексі — 809 // Points to the circle 1"}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "Бізге 1.11 нұсқасына жету керек // Points to the version 2"}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "Үйдің индексі 805 // Points to the circle 2"}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Алғашында оның жолы осылай болды. // Draws a line to a circle 1"}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "Біз одан да қысқа жол іздедік."}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "Сосын Сүйікті осындай жол ұсынды. // Draws a line to a circle 2"}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "Бірақ мен ең оңай жолды бірден сызып қойдым."}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "Ол айдан анық қой!"}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Қара. // Draws a line to a circle 3"}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "Осы жерден тікелей керек нұсқаға өтуге болады."}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Бірақ мына үй кедергі келтіреді, // Draws a line to a circle 3"}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "Ол жолды жауып тастайтын сияқты."}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "Айтпақшы, сенің сақинаң да осы принциппен жұмыс істейді."}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "Сені қайда жіберді?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "Мен ядроға барамын."}
{"category": "LocationDialogue Location10", "line_index": 210, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "Ядроға?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "Қызықты..."}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Егер сені қысқа жолмен жіберген болса,"}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "Онда сен де 1.11 нұсқасына барасың."}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "Одан кейін сен міндетті түрде Ұйқылы Митаға жетесің."}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Ойлаймын, сені бағыттаған Мита"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "Сол жолды есептеп шыққан."}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "Немесе ол есептемей, сен басқа нұсқаларға да соғасың."}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "Немесе ол нағыз данышпан,"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "Қайтадан одан да қысқа жолды ойлап тапқан!"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Түсіндім, мүмкін."}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// He asks about the inscription - Player"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "Ал мынау?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "Бұл Күшті Мита үшін."}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "Бірнеше сағаттан кейін ол осында келеді."}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "Қораптарды өзі жинасын!"}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "Және ақыры мына жерге диван қойсын!"}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "Бүкіл денем ауырып кетті!"}
{"category": "LocationDialogue Location10", "line_index": 232, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Эм-м..."}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "Мен көмектесейін бе?"}
{"category": "LocationDialogue Location10", "line_index": 235, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "Жоқ, бұл Күшті Мита үшін."}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Ол күшті."}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// He asks about the drawings - Player"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "Бұл жай сурет пе?"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "Немесе"}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "Тағы да бір мағынасы бар ма?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 244, "text": "Иә,"}
{"category": "LocationDialogue Location10", "line_index": 245, "text": "Жай сурет."}
