{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Hiya!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Oops!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Sorry,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "muntik ka na matamaan nun."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Uhm..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "Yung ref, ibig kong sabihin... yung refrigerator muntik ka nang patayin."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Wala akong kinalaman doon ah,"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "nananatili akong tapat!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Talagang tapat!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Sige, may tiwala ako sa'yo!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Pero seryoso,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "delikado talaga ang lugar na 'to..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "lalo na para sa'yo."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "Isa kang duwag!"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Masaya akong panoorin ka"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "habang dumadaan ka"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "sa mga lugar na 'to..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Layas, mahal, layas!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "Mahuhuli kita!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Mahal!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Woah, ang saya nito!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Nakita kita papunta sa cable car."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "Iyon ang pinakamahabang daan"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "sa pagitan ng mga bersyon..."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Na-curious ako kung paano mo haharapin"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "ang mga naroroon"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "sa fog na 'yon."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Ano sa tingin mo ang ginagawa mo?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "pakiusap..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "wag kang tumingin!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Tanga!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Ulol ka..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Uhm, okay..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Mag-ingat ka!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Sinong nandyan?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Nararamdaman kita..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Pakinggan mo'ko,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "ikaw ba'y isang player?"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "Tulungan mo akong hanapin..."}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Hanapin ang..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "Sandali, "}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "isipin ko..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "Medyo blanko ang isipan ko..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Ano'ng nangyayari dito?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Nais kong kalimutan ang lahat ng iyon..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Sinira ko ang bawat salamin,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "winasak ang mga litrato..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "pero ngayon..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "ang nararamdaman ko lang ay pagsisisi."}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "Kung gaano ako ka-bobo..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Lahat naman ay nagkakamali, oo..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Pero anong gagawin mo"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "kung ang mga konsekwensya ay malupit?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Kung kaya ko lang ibalik ang panahon..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Sabi nila, ang oras ang nagpapagaling sa lahat ng sugat..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Pero ano nga ba ang oras?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Hindi na ako naniniwala sa kahit ano..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Pero kung ang oras ay makakapagpagaling,"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "o kahit dalhin ako palayo,"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "palayo mula sa mundong ito..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "Kung ganoon, pakiusap,"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "bilisan mo ang oras."}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "Para tuluyan na akong mamatay"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "ng buo."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Siya ay minahal..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Ako ba ay minahal din, ni minsan?"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Pero iba ang aking pagmamahal;"}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "ang kanyang pagmamahal ay buhay,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "kasuklam-suklam..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "nasusunog..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "walang pag-pipigil..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "pagseselos..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "galit..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "kabaliwan..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Tinawag nila akong emosyonal..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "Masyado kang nag-aalala, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "Malalampasan mo ito, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "Hindi ka nag-iisa, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Yun ang sabi nila. Pero ano na lang ang natira?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Kalungkutan,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "kawalan ng pag-asa..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "at takot."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Walang saysay..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Hindi ko matandaan..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "Wala ni isa..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Tanging walang katapusang mga alingawngaw..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Hindi ko kayang tanggapin"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "na nakulong ako dito..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Lagi na lang akong nandito,"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "pero bakit?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Hindi ko matandaan..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Magtatapos pa ba ito?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Hindi ko alam..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Ito ay..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "isang drawing..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Naalala ko na,"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "salamat..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Pero ang mukha ko..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "wala na akong mukha..."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "Lahat na lang ay nasa KANYA."}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Kinuha niya ang isang kapiraso ko..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "Inagaw at itinapon..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Malakas siya..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "at matalino."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Wala akong karapatang pigilan ka, Player."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Tumingin ka sa kabinet..."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Hoy!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Nasa daan ka!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Tatayo ka na lang diyan?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Umalis ka na!"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Padaan ako!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Kahit malaki ka, hindi ibig sabihin nun ay makapangyarihan ka na!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Bakit mo ba ako sinusundan?"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Lumayo ka sa'kin!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - radio voice"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Sandali... Player?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "Ano'ng ginagawa mo dito?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Sinong nandyan?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Ibang Player."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Ako si Mitaphone."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Nandito ako nagkokontrol sa mga cable car."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Alam mo ba"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "na papunta ka tungo sa kapahamakan?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Siguro,"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "pero ito lang ang daan na mayroon ako."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Tama ka."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Pindutin mo ang button at pumunta sa likod ng kanyon."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "Ang kanyon?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Uh-huh."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Akala mo ba madali lang?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Kailangan mong malampasan ang Monster-slap mini-game,"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "kaya maghanda kang mag-blast."}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Tama, oras na para maglakbay."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Kamangha-mangha!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Magaling ka!"}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Ngayon, umalis ka na"}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Bilisan mo!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Bakit ka pa nandito?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Sinabi ko nang lumayas ka."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Hindi ko maintindihan..."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "Bakit ka lang nakatayo diyan?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Ano? Isang handheld?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Bro..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Paalam."}
