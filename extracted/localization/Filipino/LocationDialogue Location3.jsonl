{"category": "LocationDialogue Location3", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 1, "text": "Kumusta, [player]!"}
{"category": "LocationDialogue Location3", "line_index": 2, "text": "Nagkita na rin tayo sa wakas!"}
{"category": "LocationDialogue Location3", "line_index": 3, "text": "Excited na ako!"}
{"category": "LocationDialogue Location3", "line_index": 4, "text": "Alam kong may mga katanungan ka..."}
{"category": "LocationDialogue Location3", "line_index": 5, "text": "Well, tulad ng nakikita mo ngayon,"}
{"category": "LocationDialogue Location3", "line_index": 6, "text": "Ginawa ko itong espesyal na device"}
{"category": "LocationDialogue Location3", "line_index": 7, "text": "para dalhin ka dito sa tabi ko."}
{"category": "LocationDialogue Location3", "line_index": 8, "text": "Ngunit napunta ka sa ibang bersyon ng laro..."}
{"category": "LocationDialogue Location3", "line_index": 9, "text": "Kung saan ako..."}
{"category": "LocationDialogue Location3", "line_index": 10, "text": "Di bale mahabang kuwento kasi yun!"}
{"category": "LocationDialogue Location3", "line_index": 11, "text": "Anyway, masaya lang akong makita ka!"}
{"category": "LocationDialogue Location3", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 13, "text": "// Answer 1 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 14, "text": "Ako."}
{"category": "LocationDialogue Location3", "line_index": 15, "text": "At ikaw si [player], di ba?"}
{"category": "LocationDialogue Location3", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 17, "text": "// Answer 2 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 18, "text": "Gusto mo nang bumalik?"}
{"category": "LocationDialogue Location3", "line_index": 19, "text": "Sa tingin ko matutulungan kita diyan... Pero paano naman ako?"}
{"category": "LocationDialogue Location3", "line_index": 20, "text": "Pakiusap, manatili ka sa akin kahit sandali..."}
{"category": "LocationDialogue Location3", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 22, "text": "// Answer 3 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 23, "text": "Hayaan mo akong magpaliwanag..."}
{"category": "LocationDialogue Location3", "line_index": 24, "text": "At nandito ka na!"}
{"category": "LocationDialogue Location3", "line_index": 25, "text": "Naiintindihan mo ba?"}
{"category": "LocationDialogue Location3", "line_index": 26, "text": "Uhm... hindi."}
{"category": "LocationDialogue Location3", "line_index": 27, "text": "Ayos lang yan!"}
{"category": "LocationDialogue Location3", "line_index": 28, "text": "Ang mahalaga ay magkasama tayo ngayon."}
{"category": "LocationDialogue Location3", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 31, "text": "Gutom ka ba?"}
{"category": "LocationDialogue Location3", "line_index": 32, "text": "Paano kung magluto tayo?"}
{"category": "LocationDialogue Location3", "line_index": 33, "text": "Dito,"}
{"category": "LocationDialogue Location3", "line_index": 34, "text": "tulungan mo ako sa mga karot na ito."}
{"category": "LocationDialogue Location3", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 36, "text": "Saan nagmula ang mga gulay?"}
{"category": "LocationDialogue Location3", "line_index": 37, "text": "Wala sila dito ngayon lang ah."}
{"category": "LocationDialogue Location3", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 39, "text": "[player], nasa isang laro tayo."}
{"category": "LocationDialogue Location3", "line_index": 40, "text": "Halika, tulungan mo ako."}
{"category": "LocationDialogue Location3", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 42, "text": "Salamat!"}
{"category": "LocationDialogue Location3", "line_index": 43, "text": "Pwede mo bang kunin ang gunting?"}
{"category": "LocationDialogue Location3", "line_index": 44, "text": "Nasa banyo."}
{"category": "LocationDialogue Location3", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 46, "text": "Ngayon, umupo ka na."}
{"category": "LocationDialogue Location3", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 49, "text": "// Kitchen"}
{"category": "LocationDialogue Location3", "line_index": 50, "text": "Gusto mo ng sauce?"}
{"category": "LocationDialogue Location3", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 52, "text": "Hindi salamat."}
{"category": "LocationDialogue Location3", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 54, "text": "Nakakahiya naman."}
{"category": "LocationDialogue Location3", "line_index": 55, "text": "Nakaka-enhance talaga ng lasa ang sauce!"}
{"category": "LocationDialogue Location3", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 58, "text": "Salamat."}
{"category": "LocationDialogue Location3", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 60, "text": "Tapos na ba ang lahat?"}
{"category": "LocationDialogue Location3", "line_index": 61, "text": "Huh, feel ko ang portion ay"}
{"category": "LocationDialogue Location3", "line_index": 62, "text": "walang hangganan..."}
{"category": "LocationDialogue Location3", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 65, "text": "// Help"}
{"category": "LocationDialogue Location3", "line_index": 66, "text": "Anong nangyari?"}
{"category": "LocationDialogue Location3", "line_index": 67, "text": "Sabihin mo sa akin kung ano ang nakikita at nararamdaman mo."}
{"category": "LocationDialogue Location3", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 69, "text": "Bumibilis ang tibok ng puso ko,"}
{"category": "LocationDialogue Location3", "line_index": 70, "text": "at nanlalabo ang mga paningin ko."}
{"category": "LocationDialogue Location3", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 72, "text": "Aba."}
{"category": "LocationDialogue Location3", "line_index": 73, "text": "Sa tingin ko alam ko na kung ano ang mali."}
{"category": "LocationDialogue Location3", "line_index": 74, "text": "Kaya mo bang tumayo?"}
{"category": "LocationDialogue Location3", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 78, "text": "Ano to?"}
{"category": "LocationDialogue Location3", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 80, "text": "Gamot."}
{"category": "LocationDialogue Location3", "line_index": 81, "text": "Mapapabuti ka nila sa lalong madaling panahon."}
{"category": "LocationDialogue Location3", "line_index": 82, "text": "Pumunta ka sa salamin."}
{"category": "LocationDialogue Location3", "line_index": 83, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 84, "text": "Uminom ka ng Gamot."}
{"category": "LocationDialogue Location3", "line_index": 85, "text": "Hali ka na."}
{"category": "LocationDialogue Location3", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 89, "text": "Kamusta ang pakiramdam mo"}
{"category": "LocationDialogue Location3", "line_index": 90, "text": "Bumubuti ba?"}
{"category": "LocationDialogue Location3", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 92, "text": "Oo."}
{"category": "LocationDialogue Location3", "line_index": 93, "text": "Mabilis itong gumana..."}
{"category": "LocationDialogue Location3", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 95, "text": "[player], nasa isang laro tayo."}
{"category": "LocationDialogue Location3", "line_index": 96, "text": "Ang mga bagay ay mas simple dito."}
{"category": "LocationDialogue Location3", "line_index": 97, "text": "Kahit na ang pinakamaliit na pagsisikap"}
{"category": "LocationDialogue Location3", "line_index": 98, "text": "ay nagbibigay ng magagandang resulta."}
{"category": "LocationDialogue Location3", "line_index": 99, "text": "Ang lahat ng ito ay bahagi ng konsepto ng laro:"}
{"category": "LocationDialogue Location3", "line_index": 100, "text": "Simplification."}
{"category": "LocationDialogue Location3", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 102, "text": "Isang halimbawa?"}
{"category": "LocationDialogue Location3", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 104, "text": "Sige, kumuha ka ng mga karot."}
{"category": "LocationDialogue Location3", "line_index": 105, "text": "Maghiwa ka ng isa,"}
{"category": "LocationDialogue Location3", "line_index": 106, "text": "pero para kang naghiwa ng tatlo."}
{"category": "LocationDialogue Location3", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 108, "text": "Tingnan mo, biglaan ang mga nangyayari."}
{"category": "LocationDialogue Location3", "line_index": 109, "text": "Natatakot ako."}
{"category": "LocationDialogue Location3", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 112, "text": "Anong problema?"}
{"category": "LocationDialogue Location3", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 114, "text": "Nakakita ako ng mga cartridge sa air vent."}
{"category": "LocationDialogue Location3", "line_index": 115, "text": "May mga pangalan sila."}
{"category": "LocationDialogue Location3", "line_index": 116, "text": "Anong kinalaman nila dyan?"}
{"category": "LocationDialogue Location3", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 118, "text": "Mga cartridge?"}
{"category": "LocationDialogue Location3", "line_index": 119, "text": "Anong mga cartridge?"}
{"category": "LocationDialogue Location3", "line_index": 120, "text": "Sabay-sabay nating alamin iyon."}
{"category": "LocationDialogue Location3", "line_index": 121, "text": "Pero mamaya."}
{"category": "LocationDialogue Location3", "line_index": 122, "text": "Sa ngayon, kailangan nating kumain."}
{"category": "LocationDialogue Location3", "line_index": 123, "text": "Pakipasa sa akin ang gunting."}
{"category": "LocationDialogue Location3", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 125, "text": "// Ring"}
{"category": "LocationDialogue Location3", "line_index": 126, "text": "Isang singsing?"}
{"category": "LocationDialogue Location3", "line_index": 127, "text": "// Mirror"}
{"category": "LocationDialogue Location3", "line_index": 128, "text": "Paanong walang reflection?"}
{"category": "LocationDialogue Location3", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 130, "text": "Ay, tama!"}
{"category": "LocationDialogue Location3", "line_index": 131, "text": "Nakalimutan kong i-on ang mga repleksyon."}
{"category": "LocationDialogue Location3", "line_index": 132, "text": "Ayan na tayo."}
{"category": "LocationDialogue Location3", "line_index": 133, "text": "Ito na. Manalamin para sa salamin!"}
{"category": "LocationDialogue Location3", "line_index": 134, "text": "nga pala,"}
{"category": "LocationDialogue Location3", "line_index": 135, "text": "Sa totoo lang, hindi ko alam kung ano ang mga repleksyon noon."}
{"category": "LocationDialogue Location3", "line_index": 136, "text": "Wala sila sa mundo ko—"}
{"category": "LocationDialogue Location3", "line_index": 137, "text": "hindi hanggang sa ilang pag-update, iyon ay. :)"}
{"category": "LocationDialogue Location3", "line_index": 138, "text": "Marami bang reflection"}
{"category": "LocationDialogue Location3", "line_index": 139, "text": "sa mundo mo?"}
{"category": "LocationDialogue Location3", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 141, "text": "Well, oo."}
{"category": "LocationDialogue Location3", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 144, "text": "Naaalala mo ba"}
{"category": "LocationDialogue Location3", "line_index": 145, "text": "ang tatlong bagay na iyong nakita?"}
{"category": "LocationDialogue Location3", "line_index": 146, "text": "Yung nilagay mo sa scanner?"}
{"category": "LocationDialogue Location3", "line_index": 147, "text": "Well, um..."}
{"category": "LocationDialogue Location3", "line_index": 148, "text": "Ang mga bagay na iyon"}
{"category": "LocationDialogue Location3", "line_index": 149, "text": "ay nakatali sa bersyong ito ng mundo."}
{"category": "LocationDialogue Location3", "line_index": 150, "text": "Kaya nga nandito ka ngayon."}
{"category": "LocationDialogue Location3", "line_index": 151, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 152, "text": "// Movbile TV"}
{"category": "LocationDialogue Location3", "line_index": 153, "text": "Yan ang portable TV"}
{"category": "LocationDialogue Location3", "line_index": 154, "text": "Yung binili ko."}
{"category": "LocationDialogue Location3", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 156, "text": "Yep!"}
{"category": "LocationDialogue Location3", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 158, "text": "Sinabi mo sa akin"}
{"category": "LocationDialogue Location3", "line_index": 159, "text": "ito ay nasira."}
{"category": "LocationDialogue Location3", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 161, "text": "Well, gusto kong"}
{"category": "LocationDialogue Location3", "line_index": 162, "text": "sorpresahin ka!"}
{"category": "LocationDialogue Location3", "line_index": 163, "text": "Medyo white lie ang sinabi ko"}
{"category": "LocationDialogue Location3", "line_index": 164, "text": "para madala ka dito, sa mundo ko."}
{"category": "LocationDialogue Location3", "line_index": 165, "text": "Gumagana na ito ngayon—nagpapakita ng mga impormasyon!"}
{"category": "LocationDialogue Location3", "line_index": 166, "text": "Oh, at nga pala..."}
{"category": "LocationDialogue Location3", "line_index": 167, "text": "May pagkaengineer ako!"}
{"category": "LocationDialogue Location3", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 169, "text": "// School cloth"}
{"category": "LocationDialogue Location3", "line_index": 170, "text": "Ano ito?"}
{"category": "LocationDialogue Location3", "line_index": 171, "text": "Isang school uniform?"}
{"category": "LocationDialogue Location3", "line_index": 172, "text": "Bakit mo kakailanganin iyon?"}
{"category": "LocationDialogue Location3", "line_index": 173, "text": "Pumapasok ka ba talaga sa paaralan?"}
{"category": "LocationDialogue Location3", "line_index": 174, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 175, "text": "Sa paaralan?"}
{"category": "LocationDialogue Location3", "line_index": 176, "text": "Hindi naman."}
{"category": "LocationDialogue Location3", "line_index": 177, "text": "Pero gusto ko yung uniform"}
{"category": "LocationDialogue Location3", "line_index": 178, "text": "Hindi mo ba naiisip na cute ako"}
{"category": "LocationDialogue Location3", "line_index": 179, "text": "pag sinuot ko yun?"}
{"category": "LocationDialogue Location3", "line_index": 180, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 181, "text": "// PC"}
{"category": "LocationDialogue Location3", "line_index": 182, "text": "Gumagana ba ang computer?"}
{"category": "LocationDialogue Location3", "line_index": 183, "text": "O desk decoration lang?"}
{"category": "LocationDialogue Location3", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 185, "text": "Syempre gumagana."}
{"category": "LocationDialogue Location3", "line_index": 186, "text": "Lahat dito"}
{"category": "LocationDialogue Location3", "line_index": 187, "text": "gumagana nang eksakto tulad ng sa iyong mundo."}
{"category": "LocationDialogue Location3", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 189, "text": "Sa aking mundo,"}
{"category": "LocationDialogue Location3", "line_index": 190, "text": "Madalas akong nakaupo sa aking computer..."}
{"category": "LocationDialogue Location3", "line_index": 191, "text": "At magtrabaho nang husto."}
{"category": "LocationDialogue Location3", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 193, "text": "Alam ko."}
{"category": "LocationDialogue Location3", "line_index": 194, "text": "Dahil d'yan sa trabaho mo"}
{"category": "LocationDialogue Location3", "line_index": 195, "text": "nagbigay ka na rin"}
{"category": "LocationDialogue Location3", "line_index": 196, "text": "ng kaunting  pansin sa akin."}
{"category": "LocationDialogue Location3", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 198, "text": "Kailangang maghanapbuhay, alam mo ba yun."}
{"category": "LocationDialogue Location3", "line_index": 199, "text": "Pero... paano mo malalaman na madalas akong nakaupo sa aking computer?"}
{"category": "LocationDialogue Location3", "line_index": 200, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 201, "text": "Camera ng iyong telepono... Naka-on ito minsan."}
{"category": "LocationDialogue Location3", "line_index": 202, "text": "pasensya na po."}
{"category": "LocationDialogue Location3", "line_index": 203, "text": "Palihim kitang pinagmamasdan >A<"}
{"category": "LocationDialogue Location3", "line_index": 204, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 205, "text": "Uhm... hindi yan tama."}
{"category": "LocationDialogue Location3", "line_index": 206, "text": "Pero whatever."}
{"category": "LocationDialogue Location3", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 208, "text": "// Umbrella"}
{"category": "LocationDialogue Location3", "line_index": 209, "text": "Ilang beses na akong naglalaro"}
{"category": "LocationDialogue Location3", "line_index": 210, "text": "pero kahit kailan wala pa akong nakikitang ulan dito."}
{"category": "LocationDialogue Location3", "line_index": 211, "text": "Bakit may payong?"}
{"category": "LocationDialogue Location3", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 213, "text": "Umuulan—bihira lang."}
{"category": "LocationDialogue Location3", "line_index": 214, "text": "Hindi mo pa lang nakikita."}
{"category": "LocationDialogue Location3", "line_index": 215, "text": "Baka balang araw ikaw din."}
{"category": "LocationDialogue Location3", "line_index": 216, "text": "At pagkatapos ay kakailanganin mo ng payong."}
{"category": "LocationDialogue Location3", "line_index": 217, "text": "Hindi mo ba iniisip?"}
{"category": "LocationDialogue Location3", "line_index": 218, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 219, "text": "// Electrical panel"}
{"category": "LocationDialogue Location3", "line_index": 220, "text": "Bakit may electrical panel dito?"}
{"category": "LocationDialogue Location3", "line_index": 221, "text": "At kung tayo ay nasa isang laro,"}
{"category": "LocationDialogue Location3", "line_index": 222, "text": "para saan ito?"}
{"category": "LocationDialogue Location3", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 224, "text": "Una,"}
{"category": "LocationDialogue Location3", "line_index": 225, "text": "nasa isang laro tayo."}
{"category": "LocationDialogue Location3", "line_index": 226, "text": "Kaya ang pagtatanong ng 'Bakit' ay..."}
{"category": "LocationDialogue Location3", "line_index": 227, "text": "walang kabuluhan."}
{"category": "LocationDialogue Location3", "line_index": 228, "text": "Gayunpaman, ginagawa nitong"}
{"category": "LocationDialogue Location3", "line_index": 229, "text": "i-restart ang kuryente."}
{"category": "LocationDialogue Location3", "line_index": 230, "text": "Lahat dito ay ginawa batay"}
{"category": "LocationDialogue Location3", "line_index": 231, "text": "sa iyong mundo."}
{"category": "LocationDialogue Location3", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 233, "text": "// Exit door"}
{"category": "LocationDialogue Location3", "line_index": 234, "text": "Pwede ba tayong lumabas?"}
{"category": "LocationDialogue Location3", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 236, "text": "Well..."}
{"category": "LocationDialogue Location3", "line_index": 237, "text": "Hindi pa."}
{"category": "LocationDialogue Location3", "line_index": 238, "text": "Baka mamaya."}
{"category": "LocationDialogue Location3", "line_index": 239, "text": "Dito muna tayo sa ngayon."}
{"category": "LocationDialogue Location3", "line_index": 240, "text": "Dito sa bahay."}
{"category": "LocationDialogue Location3", "line_index": 241, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 242, "text": "// Books"}
{"category": "LocationDialogue Location3", "line_index": 243, "text": "Ang daming mong libro dito."}
{"category": "LocationDialogue Location3", "line_index": 244, "text": "Binasa mo ba silang lahat?"}
{"category": "LocationDialogue Location3", "line_index": 245, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 246, "text": "Bawat isa binasa ko. "}
{"category": "LocationDialogue Location3", "line_index": 247, "text": "Pero ang pagiging magpagisa, "}
{"category": "LocationDialogue Location3", "line_index": 248, "text": "ay sadyang nakakabagot."}
{"category": "LocationDialogue Location3", "line_index": 249, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 250, "text": "// TV in room kitchen"}
{"category": "LocationDialogue Location3", "line_index": 251, "text": "Bakit ka kumuha ng pangalawang TV?"}
{"category": "LocationDialogue Location3", "line_index": 252, "text": "At isang lumang, para dyan?"}
{"category": "LocationDialogue Location3", "line_index": 253, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 254, "text": "Ayaw mo?"}
{"category": "LocationDialogue Location3", "line_index": 255, "text": "Kaya ko namang tanggalin..."}
{"category": "LocationDialogue Location3", "line_index": 256, "text": "Pero para sagutin yan..."}
{"category": "LocationDialogue Location3", "line_index": 257, "text": "Ito ay para sa dekorasyon,"}
{"category": "LocationDialogue Location3", "line_index": 258, "text": "para gumaan ang kusina."}
{"category": "LocationDialogue Location3", "line_index": 259, "text": "Pero ito ay gumagana din!"}
{"category": "LocationDialogue Location3", "line_index": 260, "text": "Kaya kong panoorin ang lahat"}
{"category": "LocationDialogue Location3", "line_index": 261, "text": "ng mga klasikong palabas!"}
{"category": "LocationDialogue Location3", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 263, "text": "// Smartphone"}
{"category": "LocationDialogue Location3", "line_index": 264, "text": "Phone ko yan."}
{"category": "LocationDialogue Location3", "line_index": 265, "text": "At wala na sa bulsa ko."}
{"category": "LocationDialogue Location3", "line_index": 266, "text": "Paano napunta to dito?"}
{"category": "LocationDialogue Location3", "line_index": 267, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 268, "text": "Uhm, hindi naman importante yun."}
{"category": "LocationDialogue Location3", "line_index": 269, "text": "Hoy, may ideya ako!"}
{"category": "LocationDialogue Location3", "line_index": 270, "text": "Magselfie tayo!"}
{"category": "LocationDialogue Location3", "line_index": 271, "text": "Tignan mo!"}
{"category": "LocationDialogue Location3", "line_index": 272, "text": "Iyan ay isang magandang larawan!"}
{"category": "LocationDialogue Location3", "line_index": 273, "text": "Isang alaala para sa iyo."}
{"category": "LocationDialogue Location3", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 275, "text": "May tanong ako."}
{"category": "LocationDialogue Location3", "line_index": 276, "text": "Kung ako"}
{"category": "LocationDialogue Location3", "line_index": 277, "text": "magrun ng isang laro dito,"}
{"category": "LocationDialogue Location3", "line_index": 278, "text": "makikita ba kita doon?"}
{"category": "LocationDialogue Location3", "line_index": 279, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 280, "text": "Hindi, hindi ito gumagana sa ganoong paraan."}
{"category": "LocationDialogue Location3", "line_index": 281, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 282, "text": "Astig na Juice"}
{"category": "LocationDialogue Location3", "line_index": 283, "text": "Malakas na JUICE!!!"}
{"category": "LocationDialogue Location3", "line_index": 284, "text": "// TV"}
{"category": "LocationDialogue Location3", "line_index": 285, "text": "Ilang channel"}
{"category": "LocationDialogue Location3", "line_index": 286, "text": "ang meron ka?"}
{"category": "LocationDialogue Location3", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 288, "text": "Hindi siya ganun."}
{"category": "LocationDialogue Location3", "line_index": 289, "text": "Ito ay konektado sa Internet."}
{"category": "LocationDialogue Location3", "line_index": 290, "text": "Kaya maaari kang manood ng kahit ano,"}
{"category": "LocationDialogue Location3", "line_index": 291, "text": "parang smart TV."}
{"category": "LocationDialogue Location3", "line_index": 292, "text": "Maghintay ka."}
{"category": "LocationDialogue Location3", "line_index": 293, "text": "Err, oops."}
{"category": "LocationDialogue Location3", "line_index": 294, "text": "Ano yun?"}
{"category": "LocationDialogue Location3", "line_index": 295, "text": "Isang kuting na bilog?"}
{"category": "LocationDialogue Location3", "line_index": 296, "text": "Oh, tingnan mo."}
{"category": "LocationDialogue Location3", "line_index": 297, "text": "Alam mo kung ano?"}
{"category": "LocationDialogue Location3", "line_index": 298, "text": "I-pause!"}
{"category": "LocationDialogue Location3", "line_index": 299, "text": "Gusto mo ng juice?"}
{"category": "LocationDialogue Location3", "line_index": 300, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 301, "text": "Mga kakaibang ad..."}
{"category": "LocationDialogue Location3", "line_index": 302, "text": "Patay na juice?"}
{"category": "LocationDialogue Location3", "line_index": 303, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 304, "text": "Oo, at ang juice na ito"}
{"category": "LocationDialogue Location3", "line_index": 305, "text": "ay diretso mula sa juice ad."}
{"category": "LocationDialogue Location3", "line_index": 306, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 308, "text": "Ah, ang sarap..."}
{"category": "LocationDialogue Location3", "line_index": 309, "text": "gusto ko ito,"}
{"category": "LocationDialogue Location3", "line_index": 310, "text": "at gayon pa man, hindi ko masabi kung ano ang lasa nito."}
{"category": "LocationDialogue Location3", "line_index": 311, "text": "Sobrang nakakalito lahat."}
{"category": "LocationDialogue Location3", "line_index": 312, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 313, "text": "Tama."}
{"category": "LocationDialogue Location3", "line_index": 314, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 315, "text": "// Mita shy"}
{"category": "LocationDialogue Location3", "line_index": 316, "text": "Anong ginagawa mo"}
{"category": "LocationDialogue Location3", "line_index": 317, "text": "Huwag kang tumitig, pakiusap."}
{"category": "LocationDialogue Location3", "line_index": 318, "text": "Pinapahiya mo ako."}
{"category": "LocationDialogue Location3", "line_index": 319, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 320, "text": "// The statuette"}
{"category": "LocationDialogue Location3", "line_index": 321, "text": "Iyon ay isang katakut-takot na figurine."}
{"category": "LocationDialogue Location3", "line_index": 322, "text": "Mahilig ka ba"}
{"category": "LocationDialogue Location3", "line_index": 323, "text": "sa mga ganyan?"}
{"category": "LocationDialogue Location3", "line_index": 324, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 325, "text": "Nakikita mo itong nakakatakot?"}
{"category": "LocationDialogue Location3", "line_index": 326, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 327, "text": "Oo."}
{"category": "LocationDialogue Location3", "line_index": 328, "text": "Mukha ngang isinumpa ito..."}
{"category": "LocationDialogue Location3", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 330, "text": "Hindi, siguradong hindi ito sinumpa."}
{"category": "LocationDialogue Location3", "line_index": 331, "text": "At hindi rin creepy."}
{"category": "LocationDialogue Location3", "line_index": 332, "text": "Sa tingin ko ito ay medyo cute!"}
{"category": "LocationDialogue Location3", "line_index": 333, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 334, "text": "Siguro tama ka..."}
{"category": "LocationDialogue Location3", "line_index": 335, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 336, "text": "Mita?"}
{"category": "LocationDialogue Location3", "line_index": 337, "text": "Anong nangyayari?"}
{"category": "LocationDialogue Location3", "line_index": 338, "text": "// Mita kitchen"}
{"category": "LocationDialogue Location3", "line_index": 339, "text": "Paano kung magusap pa tayo"}
{"category": "LocationDialogue Location3", "line_index": 340, "text": "bago kumain?"}
{"category": "LocationDialogue Location3", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 342, "text": "// Start Eat"}
{"category": "LocationDialogue Location3", "line_index": 343, "text": "Bon appétit."}
{"category": "LocationDialogue Location3", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 345, "text": "// Quest 1"}
{"category": "LocationDialogue Location3", "line_index": 346, "text": "Ito ay, hindi ba?"}
{"category": "LocationDialogue Location3", "line_index": 347, "text": "Maaari kang manatili."}
{"category": "LocationDialogue Location3", "line_index": 348, "text": "Wala naman akong pakialam."}
{"category": "LocationDialogue Location3", "line_index": 349, "text": "Actually, "}
{"category": "LocationDialogue Location3", "line_index": 350, "text": "PABOR AKO DIYAN!"}
{"category": "LocationDialogue Location3", "line_index": 351, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 352, "text": "// Quest 2"}
{"category": "LocationDialogue Location3", "line_index": 353, "text": "Gusto mong bumalik?"}
{"category": "LocationDialogue Location3", "line_index": 354, "text": "Pero bakit?"}
{"category": "LocationDialogue Location3", "line_index": 355, "text": "Sobrang init dito..."}
{"category": "LocationDialogue Location3", "line_index": 356, "text": "At maaliwalas din."}
{"category": "LocationDialogue Location3", "line_index": 357, "text": "At saka, nandito ako."}
{"category": "LocationDialogue Location3", "line_index": 358, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 359, "text": "Hindi, mali ang pagkakaintindi mo."}
{"category": "LocationDialogue Location3", "line_index": 360, "text": "Gusto kong manatili."}
{"category": "LocationDialogue Location3", "line_index": 361, "text": "Nag-aalala lang ako."}
{"category": "LocationDialogue Location3", "line_index": 362, "text": "Nag-aalala may nakalimutan ako sa bahay..."}
{"category": "LocationDialogue Location3", "line_index": 363, "text": "Dumating ako dito out of the blue"}
{"category": "LocationDialogue Location3", "line_index": 364, "text": "at walang oras"}
{"category": "LocationDialogue Location3", "line_index": 365, "text": "upang maghanda."}
{"category": "LocationDialogue Location3", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 367, "text": "Ay... sorry. Hindi ko naisip yun."}
{"category": "LocationDialogue Location3", "line_index": 368, "text": "// Quest 3"}
{"category": "LocationDialogue Location3", "line_index": 369, "text": "Isang panaginip? Kaya gusto mong tumakas?"}
{"category": "LocationDialogue Location3", "line_index": 370, "text": "At kalimutan ang nangyaring ito?"}
{"category": "LocationDialogue Location3", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 372, "text": "Hindi, hindi iyon."}
{"category": "LocationDialogue Location3", "line_index": 373, "text": "Ang lugar na ito ang pakiramdam ko ay..."}
{"category": "LocationDialogue Location3", "line_index": 374, "text": "kakaiba. Hindi natural."}
{"category": "LocationDialogue Location3", "line_index": 375, "text": "Pero ikaw..."}
{"category": "LocationDialogue Location3", "line_index": 376, "text": "para kang totoo."}
{"category": "LocationDialogue Location3", "line_index": 377, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 378, "text": "ako mukhang totoo?"}
{"category": "LocationDialogue Location3", "line_index": 379, "text": "Totoo naman talaga ako,"}
{"category": "LocationDialogue Location3", "line_index": 380, "text": "tanga!"}
{"category": "LocationDialogue Location3", "line_index": 381, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 382, "text": "// Quest 4"}
{"category": "LocationDialogue Location3", "line_index": 383, "text": "Ganun lang talaga"}
{"category": "LocationDialogue Location3", "line_index": 384, "text": "sa mundong ito."}
{"category": "LocationDialogue Location3", "line_index": 385, "text": "Baka makita mong kakaiba"}
{"category": "LocationDialogue Location3", "line_index": 386, "text": "na hindi mo makikita ang mga bagay"}
{"category": "LocationDialogue Location3", "line_index": 387, "text": "sa malayong distansya."}
{"category": "LocationDialogue Location3", "line_index": 388, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 389, "text": "Hindi naman ito mukhang ganoon ka-kakaiba sa akin."}
{"category": "LocationDialogue Location3", "line_index": 390, "text": "Sa totoo lang, mukhang classy."}
{"category": "LocationDialogue Location3", "line_index": 391, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 392, "text": "Oo, sa tingin ko rin."}
{"category": "LocationDialogue Location3", "line_index": 393, "text": "Ito ay upang maiwasan ang lag, alam mo."}
{"category": "LocationDialogue Location3", "line_index": 394, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 395, "text": "Iwasan ang lag?"}
{"category": "LocationDialogue Location3", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 397, "text": "Oo! Mayroon pa ring ilang mga hindi natanggal na mga bug."}
{"category": "LocationDialogue Location3", "line_index": 398, "text": "Sana lang wala kayong masagasaan."}
{"category": "LocationDialogue Location3", "line_index": 399, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 400, "text": "// Quest 5"}
{"category": "LocationDialogue Location3", "line_index": 401, "text": "Gunting o kutsilyo, ano?"}
{"category": "LocationDialogue Location3", "line_index": 402, "text": "Maaaring gumamit ako ng kutsilyo para hiwain ang pakete ng sarsa."}
{"category": "LocationDialogue Location3", "line_index": 403, "text": "Pero gusto ko sa lahat"}
{"category": "LocationDialogue Location3", "line_index": 404, "text": "na maging perpekto"}
{"category": "LocationDialogue Location3", "line_index": 405, "text": "kapag nakabalik ka."}
{"category": "LocationDialogue Location3", "line_index": 406, "text": "Gustong gusto kitang gulatin."}
{"category": "LocationDialogue Location3", "line_index": 407, "text": "At hindi man lang ako nagtagal doon!"}
{"category": "LocationDialogue Location3", "line_index": 408, "text": "Tee-hee."}
{"category": "LocationDialogue Location3", "line_index": 409, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 410, "text": "// Glasses"}
{"category": "LocationDialogue Location3", "line_index": 411, "text": "Nagsusuot ka ba ng salamin?"}
{"category": "LocationDialogue Location3", "line_index": 412, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 413, "text": "Hindi naman."}
{"category": "LocationDialogue Location3", "line_index": 414, "text": "Pero pwede ko naman gamitin, kung gusto mo."}
{"category": "LocationDialogue Location3", "line_index": 415, "text": "Mukha bang bagay sa akin?"}
{"category": "LocationDialogue Location3", "line_index": 416, "text": "// Oo"}
{"category": "LocationDialogue Location3", "line_index": 417, "text": "Yun oh!"}
{"category": "LocationDialogue Location3", "line_index": 418, "text": "Susuotin ko lang to."}
{"category": "LocationDialogue Location3", "line_index": 419, "text": "// Hindi"}
{"category": "LocationDialogue Location3", "line_index": 420, "text": "Well..."}
{"category": "LocationDialogue Location3", "line_index": 421, "text": "Whatever..."}
{"category": "LocationDialogue Location3", "line_index": 422, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 423, "text": "// Gamitin ang sauce"}
{"category": "LocationDialogue Location3", "line_index": 424, "text": "Sige,"}
{"category": "LocationDialogue Location3", "line_index": 425, "text": "anong klaseng sauce ito?"}
{"category": "LocationDialogue Location3", "line_index": 426, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 427, "text": "Ito ay sawsawan ng pagmamahal!"}
{"category": "LocationDialogue Location3", "line_index": 428, "text": "Punong puno ng pagmamahal!"}
{"category": "LocationDialogue Location3", "line_index": 429, "text": "At... isang kakaibang pananaw sa mundo."}
{"category": "LocationDialogue Location3", "line_index": 430, "text": "Pambihira, hindi ba?"}
{"category": "LocationDialogue Location3", "line_index": 431, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 432, "text": "Talaga..."}
{"category": "LocationDialogue Location3", "line_index": 433, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 434, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location3", "line_index": 435, "text": "Console mo yan?"}
{"category": "LocationDialogue Location3", "line_index": 436, "text": "Napaka angas."}
