{"category": "LocationDialogue Location17", "line_index": 0, "text": "// Player thinks + Make coffee"}
{"category": "LocationDialogue Location17", "line_index": 1, "text": "Kailangan ko ng tulong."}
{"category": "LocationDialogue Location17", "line_index": 2, "text": "Sana ung Mita dito hindi nangangagat..."}
{"category": "LocationDialogue Location17", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 4, "text": "Bakit ba ako nagsasayang ng oras para lang dito..."}
{"category": "LocationDialogue Location17", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 9, "text": "// Player tries to wake up MitaDreamer"}
{"category": "LocationDialogue Location17", "line_index": 10, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 11, "text": "Mita, gising!"}
{"category": "LocationDialogue Location17", "line_index": 12, "text": "Mita!"}
{"category": "LocationDialogue Location17", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 14, "text": "Mita, gising na!"}
{"category": "LocationDialogue Location17", "line_index": 15, "text": "Kailangan ko ng tulong mo."}
{"category": "LocationDialogue Location17", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 17, "text": "Sino ka baaaaaaa?"}
{"category": "LocationDialogue Location17", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 19, "text": "Tulungan moko sa mga switch."}
{"category": "LocationDialogue Location17", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 21, "text": "Anong switch?"}
{"category": "LocationDialogue Location17", "line_index": 22, "text": "Hayaan mokong matulog..."}
{"category": "LocationDialogue Location17", "line_index": 23, "text": "O pwede mo akong timplahan ng kape."}
{"category": "LocationDialogue Location17", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 25, "text": "Ang coffee-maker ay nandun lang."}
{"category": "LocationDialogue Location17", "line_index": 26, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 27, "text": "Mi-ita!"}
{"category": "LocationDialogue Location17", "line_index": 28, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 31, "text": "// Player gives away the coffee"}
{"category": "LocationDialogue Location17", "line_index": 32, "text": "Mita,"}
{"category": "LocationDialogue Location17", "line_index": 33, "text": "ito na kape mo."}
{"category": "LocationDialogue Location17", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 37, "text": "// MitaDreamer exercise"}
{"category": "LocationDialogue Location17", "line_index": 38, "text": "Switches,"}
{"category": "LocationDialogue Location17", "line_index": 39, "text": "yung sabi mo?"}
{"category": "LocationDialogue Location17", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 41, "text": "Oo."}
{"category": "LocationDialogue Location17", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 43, "text": "Bat mo alam yun?"}
{"category": "LocationDialogue Location17", "line_index": 44, "text": "Teka, ba't ko ba yun tinatanong..."}
{"category": "LocationDialogue Location17", "line_index": 45, "text": "dito ka nakatira,"}
{"category": "LocationDialogue Location17", "line_index": 46, "text": "maaring may alam ka dito..."}
{"category": "LocationDialogue Location17", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 48, "text": "Teka lang,"}
{"category": "LocationDialogue Location17", "line_index": 49, "text": "gusto kong umupo."}
{"category": "LocationDialogue Location17", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 51, "text": "At?"}
{"category": "LocationDialogue Location17", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 53, "text": "Hindi ko alam kung paano ko ito sasabin..."}
{"category": "LocationDialogue Location17", "line_index": 54, "text": "Pero kailangan kong pumunta doon,"}
{"category": "LocationDialogue Location17", "line_index": 55, "text": "sinusudan ang daanan gamit ang singsing."}
{"category": "LocationDialogue Location17", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 57, "text": "Nasa iyo ang singsing NIYA?"}
{"category": "LocationDialogue Location17", "line_index": 58, "text": "Di nakapagtataka"}
{"category": "LocationDialogue Location17", "line_index": 59, "text": "na nakita mo ako dito."}
{"category": "LocationDialogue Location17", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 61, "text": "Tama."}
{"category": "LocationDialogue Location17", "line_index": 62, "text": "So, pwede mo ba akong tulungan?"}
{"category": "LocationDialogue Location17", "line_index": 63, "text": "Sa switches?"}
{"category": "LocationDialogue Location17", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 65, "text": "Sige"}
{"category": "LocationDialogue Location17", "line_index": 66, "text": "Tutulungan kita."}
{"category": "LocationDialogue Location17", "line_index": 67, "text": "Sa mga switches..."}
{"category": "LocationDialogue Location17", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 70, "text": "Mita, sige na..."}
{"category": "LocationDialogue Location17", "line_index": 71, "text": "Tara na."}
{"category": "LocationDialogue Location17", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 73, "text": "Uh?"}
{"category": "LocationDialogue Location17", "line_index": 74, "text": "Sige."}
{"category": "LocationDialogue Location17", "line_index": 75, "text": "Tara."}
{"category": "LocationDialogue Location17", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 78, "text": "// MitaDreamer fall"}
{"category": "LocationDialogue Location17", "line_index": 79, "text": "Tumayo ka."}
{"category": "LocationDialogue Location17", "line_index": 80, "text": "Ganyan ka ba talaga ka antukin?"}
{"category": "LocationDialogue Location17", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 82, "text": "// MitaDreamer again sleep"}
{"category": "LocationDialogue Location17", "line_index": 83, "text": "Gising na."}
{"category": "LocationDialogue Location17", "line_index": 84, "text": "Nandito na tayo."}
{"category": "LocationDialogue Location17", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 87, "text": "// Switches"}
{"category": "LocationDialogue Location17", "line_index": 88, "text": "Okay,"}
{"category": "LocationDialogue Location17", "line_index": 89, "text": "handa na ako."}
{"category": "LocationDialogue Location17", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 91, "text": "Handa narin ako."}
{"category": "LocationDialogue Location17", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 93, "text": "Mabuti."}
{"category": "LocationDialogue Location17", "line_index": 94, "text": "Sisimulan ko na"}
{"category": "LocationDialogue Location17", "line_index": 95, "text": "ang pagbibilang."}
{"category": "LocationDialogue Location17", "line_index": 96, "text": "At hihilahin natin ang switch."}
{"category": "LocationDialogue Location17", "line_index": 97, "text": "Okay?"}
{"category": "LocationDialogue Location17", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 99, "text": "Basta manatili ka lang gising, OK?"}
{"category": "LocationDialogue Location17", "line_index": 100, "text": "Ngayon na."}
{"category": "LocationDialogue Location17", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 103, "text": "3"}
{"category": "LocationDialogue Location17", "line_index": 104, "text": "2"}
{"category": "LocationDialogue Location17", "line_index": 105, "text": "1"}
{"category": "LocationDialogue Location17", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 107, "text": "// Player lose 1"}
{"category": "LocationDialogue Location17", "line_index": 108, "text": "Lutang kaba?"}
{"category": "LocationDialogue Location17", "line_index": 109, "text": "sige na,"}
{"category": "LocationDialogue Location17", "line_index": 110, "text": "gawin natin ulit..."}
{"category": "LocationDialogue Location17", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 112, "text": "// Player lose 2"}
{"category": "LocationDialogue Location17", "line_index": 113, "text": "Isa pa?"}
{"category": "LocationDialogue Location17", "line_index": 114, "text": "Sige na,"}
{"category": "LocationDialogue Location17", "line_index": 115, "text": "ako'y..."}
{"category": "LocationDialogue Location17", "line_index": 116, "text": "Inaantok na..."}
{"category": "LocationDialogue Location17", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 118, "text": "// Player lose 3"}
{"category": "LocationDialogue Location17", "line_index": 119, "text": "nakakaantok na talaga..."}
{"category": "LocationDialogue Location17", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 122, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 123, "text": "Magaling,"}
{"category": "LocationDialogue Location17", "line_index": 124, "text": "salamat, Mita."}
{"category": "LocationDialogue Location17", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 126, "text": "Mm-hmm."}
{"category": "LocationDialogue Location17", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 129, "text": "Ang mga pinto..."}
{"category": "LocationDialogue Location17", "line_index": 130, "text": "Ang..."}
{"category": "LocationDialogue Location17", "line_index": 131, "text": "Bagal..."}
{"category": "LocationDialogue Location17", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 134, "text": "Hihiga na ako..."}
{"category": "LocationDialogue Location17", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 136, "text": "// Why kitchen?"}
{"category": "LocationDialogue Location17", "line_index": 137, "text": "Bat dito sa kusina?"}
{"category": "LocationDialogue Location17", "line_index": 138, "text": "Kung makakatulog ako dito sa sahig,"}
{"category": "LocationDialogue Location17", "line_index": 139, "text": "kasalanan mo'to."}
{"category": "LocationDialogue Location17", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 141, "text": "// Why bathroom?"}
{"category": "LocationDialogue Location17", "line_index": 142, "text": "Hindi ko maintindihan..."}
{"category": "LocationDialogue Location17", "line_index": 143, "text": "Anong switch ba ang kailangan mo dito?"}
{"category": "LocationDialogue Location17", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 145, "text": "// Put button"}
{"category": "LocationDialogue Location17", "line_index": 146, "text": "Walang nangyari?"}
{"category": "LocationDialogue Location17", "line_index": 147, "text": "Anong ginagawa nito dito?"}
{"category": "LocationDialogue Location17", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 149, "text": "// Coffee"}
{"category": "LocationDialogue Location17", "line_index": 150, "text": "Isa pang kape?"}
{"category": "LocationDialogue Location17", "line_index": 151, "text": "Or makakatulog ka nananamn ulit."}
{"category": "LocationDialogue Location17", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 153, "text": "Ano?"}
{"category": "LocationDialogue Location17", "line_index": 154, "text": "Nooo..."}
{"category": "LocationDialogue Location17", "line_index": 155, "text": "Walang lasa tong tinimpa mong kape..."}
{"category": "LocationDialogue Location17", "line_index": 156, "text": "Ayos lang ako..."}
{"category": "LocationDialogue Location17", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 158, "text": "// Button"}
{"category": "LocationDialogue Location17", "line_index": 159, "text": "Mita? Hindi gumagana ang pindutan... Naririnig mo ba ako?"}
{"category": "LocationDialogue Location17", "line_index": 160, "text": "Hello?"}
