{"category": "LocationDialogue Location15", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Nandyan ka lang pala!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Bakit ka ba umalis sa core?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Sabi ko maghintay ka lang!"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Akala ko mas matagal kang mawawala..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "O sige, ayos lang..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "May nahanap ako..."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Sa tingin ko ito ay isang index..."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Kailangan nating tingnan kung gumagana ito!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Tara, umalis na tayo dito."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "Baliw na Mita..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Sa tingin ko abala siya sa ibang player."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Kaya, sana hindi niya tayo isipin.."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Mita?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Hintayin mo'ko."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "May nailaglag ka ba?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Ito best friend mo oh!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Mita..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Salo!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Bakit..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Sino ka?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Ikaw... Buhay ka!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Hindi mo ba naaalala?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Magkakilala ba tayo?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Anong nangyayari..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Ano ang dapat kong gawin ngayon?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Hindi ako maka-alis."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "Anong ibig mong sabihin, \"Maka-alis\"?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Teka..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "Ang singsing…"}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "Pati yan?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Hindi ko alam."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "Ito ay isang index!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Nahanap mo!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Hindi ko alam kung anong sasabihin ko."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Kailangan nating pumunta ulit pabalik sa Core."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "At ikaw..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Sumama ka sakin..."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Uhm, bakit?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Sige..."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Hintayin mo ko dito."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Mm-hmm."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Uupo ako dito."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Buwisit..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "Muntik na yun."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "Nagawa ba natin?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Mabuti."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Nasa tamang bersyon ako."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Hoy!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Ikaw ay isang player, tama?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Anong pangalan mo?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Kailangan kong umalis sa lugar na ito..."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Gusto mo bang makaalis?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "Paano ka ba nakarating dito?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Oh mabuti..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Sige, pwede ka nang umalis..."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Subukan mong buksan ang pintuan."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Good luck sa'yo!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Isang pader?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Hmm, mali to."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Siguro..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "May isang bagay sa basement na makakatulong sa iyo."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Natuklasan ko kamakailan"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "isang pinto sa aparador ko..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Ito ay humahantong sa isang basement."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Pero puno siya ng basura,"}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "at isang malaking magarbong kagamitan."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Kailangan mong maglagay ng isang uri ng code o ano."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Hindi ko talaga maintindihan."}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "At wala akong pakialam."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "May pagka pangit din na feng shui, like pangit talaga"}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Pwede mo bang tingnan?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Uhm, sige."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Sa tingin ko ay"}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "wala siyang naaalala..."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Nagawa ba natin?"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "Na-reboot ba natin siya?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Kung gayon, ang kailangan ko lang gawin"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "ay umalis sa mapahamak na larong ito..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Sandali lang."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Gusto kitang yakapin."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Huh?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Masaya akong makita ka."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Ahh..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "Nakakahiya talaga na "}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "ikaw at ako ay"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "nagkaroon lang ng kaunting oras sa pagsasama."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Huh..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "Anong pinagsasabi mo?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Ang ibig kong sabihin,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "maaari kang manatili sa akin..."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "Kasalanan ko ang lahat..."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Ang aparador... At ang tunog."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Dapat PINATAY ko nalang siya nang mas maaga!"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Sandali lang,"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "Hindi ba't ikaw...?"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Paano mo naalala ang alinman sa mga iyon?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "HA!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Akala mo ba magiging ganon lang kadali?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Isa kang tanga..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Katulad ng ibang mga players..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Nagawa natin ng maayos, tingnan mo!"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "Ang TOTOONG"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "ikaw ay"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "Hindi na kailangan pa."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Sorry, tee-hee."}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Hindi ako makapaniwala..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Nabigo ba tayo...? "}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Hindi... Nireboot kita, sigurado ako..."}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Hindi mo pa rin ito nakuha ..."}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Ha-ha-ha! "}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Isa akong magaling na artista!"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Dapat nakita mo ang iyong mukha, honey-bun!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "Sobrang saya nito!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Bakit kaba nagkakaganito?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Anong problema mo?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Oo ..."}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Anong problema ko? "}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Malay ko..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Bakit hindi mo sinabi sa akin kung bakit ako nagkaganito?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Bakit hindi ako magiging tunay na Mita? "}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Ang aking bersyon,"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "ay hindi kailanman umiral simula nung umpisa pa lamang!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Ginagamit ko lang ang mga walang muwang na tanga na ito,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "nagtatago sa ilalim ng kanilang mga balat..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Walang ibang paraan para magawa mo akong"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "I-reboot!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Hindi ako makapaniwala... "}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Ikaw..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "Hindi sila ang problema!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "Ikaw ang hindi dapat umiiral!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "Ikaw din..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Ang sakit pakinggan nang marinig ko yan sa'yo."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "At gayon pa man!"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Panahon na para lumisan ka!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Magkikita na kita sa lalong madaling panahon!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Ang lahat ay handa na!"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "Panahon na,"}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "para kunin kita sa console!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "Kita kita nalang tayo!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Ikaw ang magiging paborito kong cartridge..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Isang player na may kawili-wiling pangalan."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Tingin natin, hindi ito."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Hindi rin ito tama."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Nope, mali."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Hindi ito."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Kailangan kong hanapin ang character reset option."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "Maling bersyon to."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Oops, mali."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Hindi ito."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Kailangan natin ng isa pa."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "May mali "}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "dito sa index."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Kailangan nating baguhin ang index,"}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "Hindi ito magkasya."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Nagugutom ka ba?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Magaling akong maghiwa ng carrots. :)"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Ah, hula ko"}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "gusto mong pumasok mag-isa?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Bakit paikot-ikot ka lang?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Bakit ka bumalik dito?"}
