{"category": "LocationDialogue Location6", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "Mita?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "Paano ka nakarating dito?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Ikaw si Mita diba?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Pero parang may iba sayo..."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "Observative."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "Pero tama ka,"}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "hindi ako si Mita na nakilala mo."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Mag-ingat ka, siya’y may "}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "masamang binabalak."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "Ha? Masama?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "Wala nang oras para ipaliwanag:"}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "kung magtagumpay man ang lahat ng ito, sasabihin ko ang lahat."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Kunin mo ang susi. Nasa tabi ng sofa."}
{"category": "LocationDialogue Location6", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Pero..."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "Mamaya ka na magtanong!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Ibigay mo muna ang susi sakin."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Kunin mo tong singsing."}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "Ha?"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Gusto mong makaalis dito diba?"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "Uh, oo..."}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Kung gano'n, isuot mo 'yan."}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "Mahusay na artifact 'yan,"}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "malamang kakailanganin mo ito sa lalong madaling panahon.."}
{"category": "LocationDialogue Location6", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Sige..."}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "Oo nga pala, ako pala si"}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Mmm,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "Ako si... Mita."}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// MitaKind quest 1"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "Nakikita mo"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "'yung console na yan? Kunin mo."}
{"category": "LocationDialogue Location6", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "Nanunood ba tayo ng isang recording?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "Sino 'yung kasama niya?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "Nangyayari 'yan ngayon."}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "Isa pang player."}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Ginagamit niya siya."}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Pwede ka rin niyang"}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "gawing isang cartridge."}
{"category": "LocationDialogue Location6", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "Kailangan ko nang makaalis agad."}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "At ikaw rin."}
{"category": "LocationDialogue Location6", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "Oo, kailangan natin yun."}
{"category": "LocationDialogue Location6", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "So, sinasabi mo"}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "ginagamit niya siya."}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "Kung bubunutin ko ang cartridge, anong mangyayari?"}
{"category": "LocationDialogue Location6", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "Posibleng masira "}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "nang tuluyan ang cartridge."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "Ibig sabihin..."}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "mamamatay ang player."}
{"category": "LocationDialogue Location6", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "..."}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "Paano kung patayin ko na lang to?"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "Pwede 'yan..."}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Sulit subukan. May pulang power button diyan!"}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Kita mo?"}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "Nakita ko na."}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "Pindutin mo."}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// MitaKind quest 2"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Kailangan kong manatili."}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "May mga tanong akong kailangang itanong sa kanya"}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "para malaman pa ang tungkol sa kanya."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "Kahit na malamang ay hindi siya makikipagtulungan..."}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// MitaKind quest 3"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "Aaminin ko, ito ang bersyon ko."}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "Pinapasaya ko ang isang player,"}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "nang biglang may nagbago."}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "Tapos dumating siya..."}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "Ginawa niyang cartridge ang Player"}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "at ikinulong ako."}
{"category": "LocationDialogue Location6", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Teka, ginawa niyang cartridge?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "Kaya ba niyang gawin 'yun?"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "Pero bakit?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "Ano ang kailangan niya sa mga player?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "Halatang baliw siya..."}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Nilalaro niya lang kami, at ginagamit kami para sa sarili niyang mga plano!"}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "Ginagawa niyang cartridge ang mga player..."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Yung iba, hindi man lang napapansin ang nangyayari sa kanila..."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "At yung iba, kahit alam, hindi naman lumalaban... Gah!"}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "Ang dilim ng twist na 'to..."}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "Kailangan mo kaming tulungan!"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "Ako? Pero paano?"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "Kailangan kita!"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "Kung tutulungan mo kami, tutulungan din kita!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Ito lang ang pagkakataon natin."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "Ang singsing ang magdadala sayo sa tamang bersyon."}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "Magkikita tayo doon."}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// MitaKind quest 4"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "Hindi ko pa rin maintindihan"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "ang nakita ko doon sa taas..."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Yung Mita na yun..."}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "Sinubukan niya akong patayin?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "Patayin?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Mas masama pa diyan ang iniisip niya para sayo..."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "Kailangan mong magmadali."}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Hide!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "Oh, syet! Magtago ka!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Teka, ano...?"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Bilisan mo, papunta na siya!"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "Sundan mo ang singsingm, ililigtas ka niyan!"}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "Sasabihin mo ba sakin kung nasaan siya?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "Bakit ko naman sasabihin?"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "Hindi mo siya papatayin diba?"}
{"category": "LocationDialogue Location6", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Ah, ayaw mong sabihin sakin."}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Hah, gusto ko 'yang hamon mo."}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "Alam kong nandito lang siya sa paligid."}
{"category": "LocationDialogue Location6", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "Bakit ang sama mo sa amin?"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "Ni hindi mo sinasabi samin kung ano ang mga nangyayari!"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "At saka..."}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "Ano ang kailangan mo sa mga player?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "Hindi sila mga laruan!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "Anong nangyayari sayo?!"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "Tama na! Manahimik ka manika!"}
