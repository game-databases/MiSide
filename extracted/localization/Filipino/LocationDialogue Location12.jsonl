{"category": "LocationDialogue Location12", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Dito ka lang."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "May naiwan ako. Balik lang ako."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "Pagkatapos, pupunta tayo sa ibang mundo..."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Sige."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Maglaro tayo!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Teddy gusto ko!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "Naiwala ko siya ..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "Hanapin mo SIYA!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Oy..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "Anong tinitingin tingin mo dyan?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Quest 1 (Sino ka?)"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Ako si Mita."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "Ang pinakamagaling na Mita."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "Ang unang Mita."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "Yan ang sabi ni Mita, ang aking Mita."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Quest 2 (Bakit ganyan ang itsura mo?)"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "Anong itsura ko?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "Anong itsura ko?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "Anong itsura ko?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "Sabi ng Mita ko, maganda at orihinal ako."}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "Ako 'yon!"}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Quest 3 (Anong ginagawa ni Mita dito?)"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Dadalhin niya ako."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Kami ay mabubuhay sa isang bagong mundo."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "Niyaya ako ng Mita ko."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Dadalhin niya ako. At maglalaro kami."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Quest 4 (Bakit kailangan mo ng teddy bear?)"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "Ikaw ay isang cuddly bear,"}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "at ikaw ay nawawala,"}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "parang cuddly bear ko lang."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Quest 5 (Bakit galit si Mita?)"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "Ang aking..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "Mita."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Nais niyang maglaro."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Siya lang ang nagnanais"}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "sa akin."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Kami ay kakaiba,"}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "kami lang ang mayroon."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Si Mita at ang aking Mita,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0.8A at 8�54*"}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Quest 6 (Naniniwala ka ba kay Mita?)"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "Ang aking Mita."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "Ang aking pinakamatalik na kaibigan."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "Ang aking Mita."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "Ang aking tanging kaibigan."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "Ikaw pala!"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Hoy."}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Maglaro tayo!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Ipapakita ko sayo kung paano."}
