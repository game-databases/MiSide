{"category": "LocationDialogue Location20", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Mila! Hindi! Isa ka ngang baliw!"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Ha-ha! ANO TO?"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "Bagong expression ba yang nakikita ko?"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "Gusto ko yan, pakitaan mo pa ako!"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "Palibasa ‘kakainip tinan ‘yang simangot mo!"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\""}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "Kamusta na, aking malikot na manlalakbay? "}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "Tumakbo ka pa rin? Hindi ka ba napapagod? "}
{"category": "LocationDialogue Location20", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Anong ginawa mo kay Mila? "}
{"category": "LocationDialogue Location20", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "Ah, ‘di pa rin pagod."}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Ayos! Maglaro pa tayo!  "}
{"category": "LocationDialogue Location20", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 18, "text": "Peste…"}
{"category": "LocationDialogue Location20", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "Ito simpleng rules lang!"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "Subukan natin ang iyong koordinasyon!"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "Ngayon ang iyong kakayahang pagkilos!"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "Paano kung may mali sayo!?"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "Paano kaya kung hindi karapat-dapat ang BALAT mo sa iyong katawan?!"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": "na ipinagmamalaki mong suotin!?"}
{"category": "LocationDialogue Location20", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "Tignan mo..."}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "Alin dito ang nakuhanan mo ng pansin?"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "Yung kanan?"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "O"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": "Yung kaliwa?"}
{"category": "LocationDialogue Location20", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "Oh, seryoso?"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "May halaga ba ang tanong?"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "Nakikipaglokohan lang ako sa'yo!"}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "Ang pananaksak ay sadyang nakakabagot."}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "Bahala na!"}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "Marami pa akong planong para sa magandang laro na ito,"}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "tulad ng..."}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Tingnan mo!"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "Kailangan natin ng Musika!"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "Ano sa palagay mo ang melodyang ito?"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "Nakakapagpasigla ng dugo ko!"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "Magsisimula ako"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "sa mga patakaran!"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "// Show rules"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "Habang tumutugtug ang musika,"}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "pwede kang gumalaw."}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "Pero kapag huminto ang musika,"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "WAG KANG GAGALAW!"}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "O mamamatay ka. Nakuha mo?"}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "Simple lang: makarating ka sa dulo"}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "bago matapos ang musika."}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "Simulan na natin!"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Tatayo ka lang diyan?"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": "Takbo, aking mahal, takbo!"}
{"category": "LocationDialogue Location20", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "// Ready recorder"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Oh!"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Ahah! Tinan mo sarili mo! Sunod-sunodran!"}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Isang perpektong halimbawa."}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "Ikaw ay akin!"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": "Yun ay napakamadali, tama?"}
{"category": "LocationDialogue Location20", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 68, "text": "Pakawalan mo na ako!"}
{"category": "LocationDialogue Location20", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "Huwag kang masyadong maging komportable!"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "Meron pa tayong lalaruin!"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Ito ang susunod:"}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "Tatakpan ko ang aking mga mata…"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "at pagbukas ko,"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "dapat hindi na kita makikita!"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "Nakuha mo?"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Kung makita kita, ikaw ay mapaparusahan!"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": "Mabuti! Simulan na natin!"}
{"category": "LocationDialogue Location20", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 80, "text": "Walang silbe ang lahat ng ito..."}
{"category": "LocationDialogue Location20", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "// Ready hide"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Nagawa mo!"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "Maganda ang ginawa mo, nakaka-excite!"}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "Pero ito'y mas magiging mahirap."}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Napaka HIRAP."}
{"category": "LocationDialogue Location20", "line_index": 87, "text": "Tago, Takbo, Ikot—"}
{"category": "LocationDialogue Location20", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 89, "text": "Gah, hayop ka!"}
{"category": "LocationDialogue Location20", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "// Player falls"}
{"category": "LocationDialogue Location20", "line_index": 92, "text": "Nakatakas yata ako..."}
