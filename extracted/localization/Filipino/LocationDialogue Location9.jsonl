{"category": "LocationDialogue Location9", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Hoy, ikaw!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Hi!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Gusto mong makaalis?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Kailangan mo akong tulungang hanapin ang susi!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Hala! Wala pang susi dito!"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Wala dito—"}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "zero, wala, wala!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Nakita ko na!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// The usual conversation"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Huh, akala ko mas magiging pandak ka pa dyan!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "Matangkad ka—"}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "parang si ate!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "Ang ate mo? Anong tungkol sa kanya?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Oo, ang ate ko."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Huwag mong sabihin na hindi mo pa siya nakikita!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Uh... nakilala ko siya... siguro?"}
{"category": "LocationDialogue Location9", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Bobo ka ba?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "Erm..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "Tanga ka talaga..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "Sige na, tulungan mo na akong hanapin ang susi!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// Next work"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Halika."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Ilagay mo ang bakal sa tubo!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Salamat!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "Ngayon, kunin mo ang kahoy!"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Salamat!"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Kailangan ko pa ng tulong, please!"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Tapos na! Ngayon..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "Wow, ang ganda."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Pindutin mo, tara!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Maghanda..."}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "Ayan, kunin mo na!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "Sayo na yan!"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// Quest 1 (Are you Mita?)"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Ako si ChibiMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Maraming linya,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "pinakasimpleng modelo, at—"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "ang may pinaka-magandang buhok!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// Quest 2 (Have we seen each other yet?)"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Bobo!"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "Medyo cute ka, alam mo ba yun,"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "nagtatanong ng mga kalokohang ganun."}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Pero,"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "ito ang unang pagkakataon ko na makikilala kita!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Pero pakinggan mo..."}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Kung nanakawin mo ang aking kamangha-manghang itsura,"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "pagsisisihan mo yan!"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// Quest 3 (Why are you here?)"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Hindi mo ba gets?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "Ito ay isang checkpoint—"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "isang pagsubok ng iyong talino!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "Sige na!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Nandito ako para gabayan ang mga naliligaw!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// Quest 4 (Why are you helping me?)"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "Anong nagpa-special sayo?"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "Bakit hindi kita tutulungan kahit na?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "Ano?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Ulol ka..."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Bigla ka na lang sumulpot!"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Hindi ka dapat nandito,"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "kaya tinulungan kita!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Paalam, tanga!"}
