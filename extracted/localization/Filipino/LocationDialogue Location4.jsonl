{"category": "LocationDialogue Location4", "line_index": 0, "text": "Mita?"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "Ah, gising ka na pala?"}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "Paano ka nakarating dito?"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": "Katabi mo lang ako kanina ah."}
{"category": "LocationDialogue Location4", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 5, "text": "Hindi."}
{"category": "LocationDialogue Location4", "line_index": 6, "text": "Nanigas ka sa harap ng salamin."}
{"category": "LocationDialogue Location4", "line_index": 7, "text": "Kaya umalis ako."}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "Bakit nagbago ang mga silid?"}
{"category": "LocationDialogue Location4", "line_index": 9, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "Inayos ko ulit ang lugar"}
{"category": "LocationDialogue Location4", "line_index": 11, "text": "para mas maging feel at home ka."}
{"category": "LocationDialogue Location4", "line_index": 12, "text": "Dito,"}
{"category": "LocationDialogue Location4", "line_index": 13, "text": "pwede na tayong magpalit ng kwarto"}
{"category": "LocationDialogue Location4", "line_index": 14, "text": "kung sa paano natin gusto."}
{"category": "LocationDialogue Location4", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 16, "text": "Hindi mo kailangang gawin ito."}
{"category": "LocationDialogue Location4", "line_index": 17, "text": "Nasasanay na ako sa layout."}
{"category": "LocationDialogue Location4", "line_index": 18, "text": "Sa alinmang paraan, sa tingin ko mas magiging komportable ka sa layout na ito."}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Mita card game"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "Tama,"}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "laro tayo?"}
{"category": "LocationDialogue Location4", "line_index": 22, "text": "Ang laro ay gumagana na kung saan:"}
{"category": "LocationDialogue Location4", "line_index": 23, "text": "Ang chip na ito ay nagpapahiwatig ng isang uri,"}
{"category": "LocationDialogue Location4", "line_index": 24, "text": "tulad ng health."}
{"category": "LocationDialogue Location4", "line_index": 25, "text": "Bawat isa sa atin ay kukuha ng tig isang baraha,"}
{"category": "LocationDialogue Location4", "line_index": 26, "text": "at kung ang baraha mo ay may mas mataas"}
{"category": "LocationDialogue Location4", "line_index": 27, "text": "na health stat"}
{"category": "LocationDialogue Location4", "line_index": 28, "text": "kaysa sa akin,"}
{"category": "LocationDialogue Location4", "line_index": 29, "text": "panalo ka."}
{"category": "LocationDialogue Location4", "line_index": 30, "text": "Kunin mo yung mga baraha."}
{"category": "LocationDialogue Location4", "line_index": 31, "text": "Ako na."}
{"category": "LocationDialogue Location4", "line_index": 32, "text": "Aba!"}
{"category": "LocationDialogue Location4", "line_index": 33, "text": "Nakuha ko rin!"}
{"category": "LocationDialogue Location4", "line_index": 34, "text": "mauuna na ako!"}
{"category": "LocationDialogue Location4", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 44, "text": "OK!"}
{"category": "LocationDialogue Location4", "line_index": 45, "text": "Ikaw na!"}
{"category": "LocationDialogue Location4", "line_index": 46, "text": "Uh-huh."}
{"category": "LocationDialogue Location4", "line_index": 47, "text": "Ikaw na!"}
{"category": "LocationDialogue Location4", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 49, "text": "Ang may pinakamataas na Health stat ay mananalo!"}
{"category": "LocationDialogue Location4", "line_index": 50, "text": "Ito ay tungkol sa pag-atake!"}
{"category": "LocationDialogue Location4", "line_index": 51, "text": "Pokus sa depensa!"}
{"category": "LocationDialogue Location4", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 54, "text": "Nanalo ka!"}
{"category": "LocationDialogue Location4", "line_index": 55, "text": "Nanalo ka!"}
{"category": "LocationDialogue Location4", "line_index": 56, "text": "Nakuha mo'ko."}
{"category": "LocationDialogue Location4", "line_index": 57, "text": "Oh ikaw..."}
{"category": "LocationDialogue Location4", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 59, "text": "Panalo ako!"}
{"category": "LocationDialogue Location4", "line_index": 60, "text": "Ako ang nanalo!"}
{"category": "LocationDialogue Location4", "line_index": 61, "text": "Nanalo ako!"}
{"category": "LocationDialogue Location4", "line_index": 62, "text": "Hah, nakuha mo!"}
{"category": "LocationDialogue Location4", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 64, "text": "Pantay-pantay."}
{"category": "LocationDialogue Location4", "line_index": 65, "text": "Lahat pantay-pantay!"}
{"category": "LocationDialogue Location4", "line_index": 66, "text": "Ngayon ay isang draw na!"}
{"category": "LocationDialogue Location4", "line_index": 67, "text": "Ang parehong halaga..."}
{"category": "LocationDialogue Location4", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 79, "text": "// The card game is interrupted"}
{"category": "LocationDialogue Location4", "line_index": 80, "text": "Ano yung ingay?"}
{"category": "LocationDialogue Location4", "line_index": 81, "text": "Galing siya sa aparador."}
{"category": "LocationDialogue Location4", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 83, "text": "Tunog?"}
{"category": "LocationDialogue Location4", "line_index": 84, "text": "Anong tunog?"}
{"category": "LocationDialogue Location4", "line_index": 85, "text": "Wala akong narinig."}
{"category": "LocationDialogue Location4", "line_index": 86, "text": "Ano sa tingin mo ang narinig mo?"}
{"category": "LocationDialogue Location4", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 88, "text": "May kumakatok, parang may tao."}
{"category": "LocationDialogue Location4", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 90, "text": "Pero..."}
{"category": "LocationDialogue Location4", "line_index": 91, "text": "Walang tao doon..."}
{"category": "LocationDialogue Location4", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 93, "text": "Gusto kong buksan at suriin."}
{"category": "LocationDialogue Location4", "line_index": 94, "text": "Medyo kinikilabutan ako."}
{"category": "LocationDialogue Location4", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 96, "text": "Pero bakit...?"}
{"category": "LocationDialogue Location4", "line_index": 97, "text": "Ito na naman tayo..."}
{"category": "LocationDialogue Location4", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 105, "text": "Anong problema mo!?"}
{"category": "LocationDialogue Location4", "line_index": 106, "text": "Ito ay isang aparador..."}
{"category": "LocationDialogue Location4", "line_index": 107, "text": "Hoy nandito mga suot panloob ko...!"}
{"category": "LocationDialogue Location4", "line_index": 108, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 109, "text": "May tinatago ka ba sa akin?"}
{"category": "LocationDialogue Location4", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 111, "text": "Bakit hindi ka na lang maniwala sa akin?"}
{"category": "LocationDialogue Location4", "line_index": 112, "text": "Anong maling nagawa ko?"}
{"category": "LocationDialogue Location4", "line_index": 113, "text": "Ang gusto ko..."}
{"category": "LocationDialogue Location4", "line_index": 114, "text": "ang gusto ko lang naman ay makasama ka."}
{"category": "LocationDialogue Location4", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 116, "text": "Gusto ko yan, pero...?"}
{"category": "LocationDialogue Location4", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 118, "text": "Bakit mo ba iniisip ang aparador na yan?!"}
{"category": "LocationDialogue Location4", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 120, "text": "Gusto kong malaman kung ano ang katok na yun!"}
{"category": "LocationDialogue Location4", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 122, "text": "Dahil ba"}
{"category": "LocationDialogue Location4", "line_index": 123, "text": "ang mundong ito"}
{"category": "LocationDialogue Location4", "line_index": 124, "text": "ay apat lang ang kwarto?"}
{"category": "LocationDialogue Location4", "line_index": 125, "text": "Hindi pa ba sapat yun para sayo?"}
{"category": "LocationDialogue Location4", "line_index": 126, "text": "Bakit hindi moko kayang samahan?"}
{"category": "LocationDialogue Location4", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 129, "text": "// Don't stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 130, "text": "Naiintindihan ko."}
{"category": "LocationDialogue Location4", "line_index": 131, "text": "Ito nanaman..."}
{"category": "LocationDialogue Location4", "line_index": 132, "text": "Kung gusto mong tingnan ang loob ng aparador, "}
{"category": "LocationDialogue Location4", "line_index": 133, "text": "sige alamin mo "}
{"category": "LocationDialogue Location4", "line_index": 134, "text": "kung ano man ang laman niyan!"}
{"category": "LocationDialogue Location4", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 139, "text": "Ano ang..."}
{"category": "LocationDialogue Location4", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 141, "text": "Nangyayari yan minsan."}
{"category": "LocationDialogue Location4", "line_index": 142, "text": "Nagloload ang silid."}
{"category": "LocationDialogue Location4", "line_index": 143, "text": "Sandali lang."}
{"category": "LocationDialogue Location4", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 145, "text": "Kakaiba ito."}
{"category": "LocationDialogue Location4", "line_index": 146, "text": "Nasa loob ba tayo ng selpon ng isang tao?"}
{"category": "LocationDialogue Location4", "line_index": 147, "text": "Siguro isang mabagal na may mahabang oras ng paglo-load?"}
{"category": "LocationDialogue Location4", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 149, "text": "Hindi naman."}
{"category": "LocationDialogue Location4", "line_index": 150, "text": "Pero hindi lahat ay perpekto"}
{"category": "LocationDialogue Location4", "line_index": 151, "text": "sa mundong ito..."}
{"category": "LocationDialogue Location4", "line_index": 152, "text": "Kinakarga kami"}
{"category": "LocationDialogue Location4", "line_index": 153, "text": "kasama ang core."}
{"category": "LocationDialogue Location4", "line_index": 154, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 155, "text": "Core?"}
{"category": "LocationDialogue Location4", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 157, "text": "Tipikal diba?"}
{"category": "LocationDialogue Location4", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 159, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 161, "text": "Sabagay, gusto mo bang"}
{"category": "LocationDialogue Location4", "line_index": 162, "text": "maglaro ng console game?"}
{"category": "LocationDialogue Location4", "line_index": 163, "text": "O mga baraha?"}
{"category": "LocationDialogue Location4", "line_index": 164, "text": "Pumili ka."}
{"category": "LocationDialogue Location4", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 167, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 168, "text": "// Mita play fight"}
{"category": "LocationDialogue Location4", "line_index": 169, "text": "Gusto mong lumaban?"}
{"category": "LocationDialogue Location4", "line_index": 170, "text": "Kailangan mong manalo"}
{"category": "LocationDialogue Location4", "line_index": 171, "text": "apat na beses."}
{"category": "LocationDialogue Location4", "line_index": 172, "text": "Ilabas mo."}
{"category": "LocationDialogue Location4", "line_index": 173, "text": "Huwag kang mag-alala, di muna kita"}
{"category": "LocationDialogue Location4", "line_index": 174, "text": "pahihirapan sa simula ng laban."}
{"category": "LocationDialogue Location4", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 176, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 177, "text": "Mabait na bata."}
{"category": "LocationDialogue Location4", "line_index": 178, "text": "Magpokus ka!"}
{"category": "LocationDialogue Location4", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 180, "text": "Aba!"}
{"category": "LocationDialogue Location4", "line_index": 181, "text": "Tama, okay."}
{"category": "LocationDialogue Location4", "line_index": 182, "text": "Magseseryoso na ako."}
{"category": "LocationDialogue Location4", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 184, "text": "Wow!"}
{"category": "LocationDialogue Location4", "line_index": 185, "text": "Tingnan natin kung kaya mo,"}
{"category": "LocationDialogue Location4", "line_index": 186, "text": "talunin mo ako ngayon!"}
{"category": "LocationDialogue Location4", "line_index": 187, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 188, "text": "Ang simple"}
{"category": "LocationDialogue Location4", "line_index": 189, "text": "mo"}
{"category": "LocationDialogue Location4", "line_index": 190, "text": "Kahanga-hanga! Ang galing mo!"}
{"category": "LocationDialogue Location4", "line_index": 191, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 193, "text": "Ano ang problema?"}
{"category": "LocationDialogue Location4", "line_index": 194, "text": "Huh, nakakatamad."}
{"category": "LocationDialogue Location4", "line_index": 195, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 196, "text": "Well,"}
{"category": "LocationDialogue Location4", "line_index": 197, "text": "yun lang. Naniniwala ka ba sa tadhana?"}
{"category": "LocationDialogue Location4", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 199, "text": "Pagkatapos,"}
{"category": "LocationDialogue Location4", "line_index": 200, "text": "kumilos ka o ikaw ay magiging isang talunan magpakailanman!"}
{"category": "LocationDialogue Location4", "line_index": 201, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 202, "text": "Ano bang problema mo?"}
{"category": "LocationDialogue Location4", "line_index": 203, "text": "Pinunas ko pagmumukha mo sa sahig."}
{"category": "LocationDialogue Location4", "line_index": 204, "text": "Hindi mo naman ibinigay ang lahat—"}
{"category": "LocationDialogue Location4", "line_index": 205, "text": "kaya ako nanalo!"}
{"category": "LocationDialogue Location4", "line_index": 206, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 208, "text": "Sige, kung ganun."}
{"category": "LocationDialogue Location4", "line_index": 209, "text": "Paano kaya kung maglaro tayo ng ilang mga baraha?"}
{"category": "LocationDialogue Location4", "line_index": 210, "text": "Nasa kwarto sila."}
{"category": "LocationDialogue Location4", "line_index": 211, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 214, "text": "// Door > [ERROR]"}
{"category": "LocationDialogue Location4", "line_index": 215, "text": "Huh, anong nangyayari?"}
{"category": "LocationDialogue Location4", "line_index": 216, "text": "Nasaan..."}
{"category": "LocationDialogue Location4", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 218, "text": "Uh-oh."}
{"category": "LocationDialogue Location4", "line_index": 219, "text": "Sorry..."}
{"category": "LocationDialogue Location4", "line_index": 220, "text": "May na-download ako"}
{"category": "LocationDialogue Location4", "line_index": 221, "text": "mula sa net."}
{"category": "LocationDialogue Location4", "line_index": 222, "text": "Gusto kong magpaganda"}
{"category": "LocationDialogue Location4", "line_index": 223, "text": "sa labas ng kaunti."}
{"category": "LocationDialogue Location4", "line_index": 224, "text": "Pero mukhang"}
{"category": "LocationDialogue Location4", "line_index": 225, "text": "may mali sa file."}
{"category": "LocationDialogue Location4", "line_index": 226, "text": "Aayusin ko nalang mamaya."}
{"category": "LocationDialogue Location4", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 228, "text": "Kaya ba hindi tayo makalabas ng bahay?"}
{"category": "LocationDialogue Location4", "line_index": 229, "text": "Oo, kaya lang."}
{"category": "LocationDialogue Location4", "line_index": 230, "text": "// Mita shy"}
{"category": "LocationDialogue Location4", "line_index": 231, "text": "Hoy..."}
{"category": "LocationDialogue Location4", "line_index": 232, "text": "Ano bang problema mo?"}
{"category": "LocationDialogue Location4", "line_index": 233, "text": "May gusto ka ba?"}
{"category": "LocationDialogue Location4", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 236, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 237, "text": "// Wall Clock"}
{"category": "LocationDialogue Location4", "line_index": 238, "text": "Ang orasan,"}
{"category": "LocationDialogue Location4", "line_index": 239, "text": "anong oras ang ipinapakita nito?"}
{"category": "LocationDialogue Location4", "line_index": 240, "text": "Ang kasalukuyang oras sa laro?"}
{"category": "LocationDialogue Location4", "line_index": 241, "text": "O naka-sync ba ito sa aking selpon?"}
{"category": "LocationDialogue Location4", "line_index": 242, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 243, "text": "Well, uhm..."}
{"category": "LocationDialogue Location4", "line_index": 244, "text": "Sa totoo lang hindi ko alam."}
{"category": "LocationDialogue Location4", "line_index": 245, "text": "Pero hindi mahalaga ang oras dito..."}
{"category": "LocationDialogue Location4", "line_index": 246, "text": "Maaga man o hindi,"}
{"category": "LocationDialogue Location4", "line_index": 247, "text": "isang malakas na babaeng katulad ko"}
{"category": "LocationDialogue Location4", "line_index": 248, "text": "ay laging puno ng enerhiya—"}
{"category": "LocationDialogue Location4", "line_index": 249, "text": "Hindi ako napapagod!"}
{"category": "LocationDialogue Location4", "line_index": 250, "text": "Maaari tayong magkaroon ng walang hanggang tagsibol,"}
{"category": "LocationDialogue Location4", "line_index": 251, "text": "o walang katapusang hapon!"}
{"category": "LocationDialogue Location4", "line_index": 252, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 253, "text": "Interesting yan..."}
{"category": "LocationDialogue Location4", "line_index": 254, "text": "Pero medyo nakakatakot din."}
{"category": "LocationDialogue Location4", "line_index": 255, "text": "Natigil sa iisang sandali, magpakailanman......"}
{"category": "LocationDialogue Location4", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 258, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 259, "text": "// Photos of Mita"}
{"category": "LocationDialogue Location4", "line_index": 260, "text": "Ganda ng mga litrato."}
{"category": "LocationDialogue Location4", "line_index": 261, "text": "Hulaan ko, sayo ba to?"}
{"category": "LocationDialogue Location4", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 263, "text": "Oo."}
{"category": "LocationDialogue Location4", "line_index": 264, "text": "Nagustuhan ko rin ang mga iyan."}
{"category": "LocationDialogue Location4", "line_index": 265, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 266, "text": "Sino ang kumuha ng mga litrato?"}
{"category": "LocationDialogue Location4", "line_index": 267, "text": "May iba pa bang mga tao sa mundong ito?"}
{"category": "LocationDialogue Location4", "line_index": 268, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 269, "text": "Oo."}
{"category": "LocationDialogue Location4", "line_index": 270, "text": "Ipapakilala kita."}
{"category": "LocationDialogue Location4", "line_index": 271, "text": "Hindi nga lang ngayon."}
{"category": "LocationDialogue Location4", "line_index": 272, "text": "Sa ngayon, gusto lang kitang makasama."}
{"category": "LocationDialogue Location4", "line_index": 273, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 275, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 276, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 277, "text": "// Portal"}
{"category": "LocationDialogue Location4", "line_index": 278, "text": "Saan napunta ang portal?"}
{"category": "LocationDialogue Location4", "line_index": 279, "text": "O kung ano man ang tawag dun?"}
{"category": "LocationDialogue Location4", "line_index": 280, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 281, "text": "Gumamit ako ng"}
{"category": "LocationDialogue Location4", "line_index": 282, "text": "kaunting magic"}
{"category": "LocationDialogue Location4", "line_index": 283, "text": "at inilipat ito"}
{"category": "LocationDialogue Location4", "line_index": 284, "text": "sa ibang lugar."}
{"category": "LocationDialogue Location4", "line_index": 285, "text": "Hindi na natin iyon kailangan."}
{"category": "LocationDialogue Location4", "line_index": 286, "text": "Gambala lang yan dito."}
{"category": "LocationDialogue Location4", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 288, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 289, "text": "// Mirror in the bedroom"}
{"category": "LocationDialogue Location4", "line_index": 290, "text": "Nakatingin ako sa salamin pero "}
{"category": "LocationDialogue Location4", "line_index": 291, "text": "wala akong nakakakitang repleksyon, nakakatakot naman."}
{"category": "LocationDialogue Location4", "line_index": 292, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 293, "text": "Maaari nating i-on ang mga repleksyon"}
{"category": "LocationDialogue Location4", "line_index": 294, "text": "kung gusto mo talaga."}
{"category": "LocationDialogue Location4", "line_index": 295, "text": "Pero, kailangan ba talaga natin iyon?"}
{"category": "LocationDialogue Location4", "line_index": 296, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 297, "text": "Syempre lahat tayo."}
{"category": "LocationDialogue Location4", "line_index": 298, "text": "O... may kahihinatnan ba ang pag-on sa kanila?"}
{"category": "LocationDialogue Location4", "line_index": 299, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 300, "text": "Oo."}
{"category": "LocationDialogue Location4", "line_index": 301, "text": "Tayo ay mauutal at mas mabagal ang paggalaw."}
{"category": "LocationDialogue Location4", "line_index": 302, "text": "Nakakita na kaba ng cartoon na may mababang frame sa bawat segundo?"}
{"category": "LocationDialogue Location4", "line_index": 303, "text": "Magiging ganoon para sa atin, sa lahat ng oras."}
{"category": "LocationDialogue Location4", "line_index": 304, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 305, "text": "Nakuha ko."}
{"category": "LocationDialogue Location4", "line_index": 306, "text": "Kung gayon marahil mas mabuting panatilihin nating patayin ang mga pagmuni-muni..."}
{"category": "LocationDialogue Location4", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 308, "text": "Hoy, [player],"}
{"category": "LocationDialogue Location4", "line_index": 309, "text": "siguradong mahilig ka sa salamin, di ba?"}
{"category": "LocationDialogue Location4", "line_index": 310, "text": "Natatakot kang makakita ng ngiti sa iyong mukha?"}
{"category": "LocationDialogue Location4", "line_index": 311, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 312, "text": "Ha? Hindi talaga..."}
{"category": "LocationDialogue Location4", "line_index": 313, "text": "Pagod lang ako"}
{"category": "LocationDialogue Location4", "line_index": 314, "text": "Pagkatapos ng lahat ng gawain."}
{"category": "LocationDialogue Location4", "line_index": 315, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 316, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 317, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 318, "text": "// Blue sneakers"}
{"category": "LocationDialogue Location4", "line_index": 319, "text": "Sa iyo ba ito?"}
{"category": "LocationDialogue Location4", "line_index": 320, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 321, "text": "Hindi, sayo yan."}
{"category": "LocationDialogue Location4", "line_index": 322, "text": "Hindi mo ba naaalala?"}
{"category": "LocationDialogue Location4", "line_index": 323, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 324, "text": "Wala akong matandaang may sneakers na ganyan."}
{"category": "LocationDialogue Location4", "line_index": 325, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 326, "text": "Ngayon oo."}
{"category": "LocationDialogue Location4", "line_index": 327, "text": "Maaari mong isuot ang mga ito"}
{"category": "LocationDialogue Location4", "line_index": 328, "text": "paglabas natin."}
{"category": "LocationDialogue Location4", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 330, "text": "Paano ang tungkol sa mga damit?"}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "Lahat ng meron ako sa mundong ito"}
{"category": "LocationDialogue Location4", "line_index": 332, "text": "yung mga damit na suot ko."}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "Anumang paraan para makakuha ako ng mga bago?"}
{"category": "LocationDialogue Location4", "line_index": 334, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 335, "text": "Syempre meron."}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "Kahit na, nakita ko ang suot mo—"}
{"category": "LocationDialogue Location4", "line_index": 337, "text": "and honestly, hindi maganda ang taste mo."}
{"category": "LocationDialogue Location4", "line_index": 338, "text": "Alinmang paraan, tutulungan kitang makakuha ng ilan."}
{"category": "LocationDialogue Location4", "line_index": 339, "text": "Hindi lang ngayon."}
{"category": "LocationDialogue Location4", "line_index": 340, "text": "Ito ay isang pangako."}
{"category": "LocationDialogue Location4", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 342, "text": "Okay."}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Games on TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "Ano ang gusto mong laruin?"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Game milk"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "Ito ay isang larong panlaban!"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "Tingnan natin kung sino ang unang umasim!"}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "What a game!"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": "Sapat na ang gatas natin sa ngayon, gumawa tayo ng iba."}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Game penguins"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "Sa larong ito, isa kang penguin"}
{"category": "LocationDialogue Location4", "line_index": 354, "text": "na dumudulas sa paligid."}
{"category": "LocationDialogue Location4", "line_index": 355, "text": "Tama, iyon ang laro."}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "Huh, ano?"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "Seryoso ka? Akala ko ikaw ay..."}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "Tuwang tuwa ako!"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "At medyo nalilito..."}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "Pero..."}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "Manatili ka sa akin—"}
{"category": "LocationDialogue Location4", "line_index": 364, "text": "palagi at magpakailanman."}
{"category": "LocationDialogue Location4", "line_index": 365, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 367, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 368, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 369, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 370, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 372, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 373, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 374, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 375, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 376, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 377, "text": "// A game about penguins"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "Ito ay sobrang simple:"}
{"category": "LocationDialogue Location4", "line_index": 379, "text": "mangolekta ka lang ng snowballs."}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "Ang mangolekta ng higit pa ang siyang panalo!"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "Maglaro tayo ng dalawang rounds, okay?!"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// The first map"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "Wow, paano ka nakakuha ng ganyan karami?"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "Tee-hee! Mayroon akong pinakamaraming snowballs!"}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "Mas mabuting abutin!"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "Ha, 1:1!"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// The second map"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "Isa kang natural na penguin!"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "Dapat ka naming dalhin sa totoong yelo!"}
{"category": "LocationDialogue Location4", "line_index": 390, "text": "Pfft, ang bagal mo naman."}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "Iniisip mo pa ba ang huling round?"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "Woah, isang kurbata! Ngayon ay bihira na!"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// The game is over"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "Tama, gusto mong maglaro ng iba?"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "O tapos ka na?"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "Ano ang kailangan mo diyan?"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "Sobrang hilig mo ba talaga sa laro?"}
