{"category": "LocationDialogue Location8", "line_index": 0, "text": "// The first meeting"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "Sino ka?"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "Anong nangyari?"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "Hindi ka ba makapagsalita?"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "Sandali..."}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "Gusto mo bang umalis, diba?"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "Oo..."}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "Kailangan kong bumalik"}
{"category": "LocationDialogue Location8", "line_index": 11, "text": "sa nakaraang bersyon."}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "Nakaraang bersyon?"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "Bakit aalis at pupunta"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "sa ibang lugar?"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "Kung pwede ka naman dito"}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "at maging"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "ikalawang kaibigan ko?"}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Skipping all dialogs"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "Okay..."}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Standing by the window (Random)"}
{"category": "LocationDialogue Location8", "line_index": 24, "text": "Hindi mo matatagpuan ang daan palabas sa pamamagitan ng mga pinto."}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "Mukhang nagmamadali ka..."}
{"category": "LocationDialogue Location8", "line_index": 26, "text": "Hindi ka pa rin ligtas kahit tumakbo ka pa nang pabalik balik."}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "Gusto mo talagang tumakas?"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "Tumingin ka sa labas ng mga bintana..."}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Ikaw ba si Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "Player... player ka, diba?"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": "Pwede tayong maglaro nang magkasama."}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "Kung makakakita ako ng lakas,"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": "ang kailangan lang natin gawin ay maglaro."}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (Anong nangyari sayo?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "Hindi ako sigurado, at hindi ko talaga alam..."}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "Parang wala namang masamang nangyari..."}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "Pero parang lahat ng mabuti ay unti-unting nawawala..."}
{"category": "LocationDialogue Location8", "line_index": 41, "text": "Kahit na, mayroon pa akong kaibigan."}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "Bakit nila ako iniwan?"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "Hindi ba sapat ako?"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "Natatakot ako..."}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Quest 3 (Maging pangalawang kaibigan?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "Mga kaibigan..."}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "Kaunti na lang ang natira."}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "Isa na lang ang natira..."}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "Malungkot ako, player."}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "Pwede mo ba ako maging kaibigan?"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "Gusto ko sanang maging kaibigan,"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "pero kailangan kong magpatuloy..."}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "Nananakit ang puso ko..."}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Bahay mo to?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "Bahay?"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "Player... nagbago ka..."}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "Mas maikli na ang mga braso mo, at hindi ka na mukhang galit..."}
{"category": "LocationDialogue Location8", "line_index": 62, "text": "Player, naging mas malambot ka, mas mabait."}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "Hindi ako sigurado..."}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "kung anong ibig sabihin nun."}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "Ayos lang..."}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "dahil hindi na ako masasaktan, hindi ba?"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (Paano ako makakaalis dito?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "Iiwan mo ba talaga ako?"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "Baka ito lang ang aking..."}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "tadhana?"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "Uh..."}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": "Walang kwenta yan, di ka tutulungan ng mga pintuan dito."}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Hold player (Random)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "Bakit ka aalis?"}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "Dito ka lang..."}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "Maglaro tayo..."}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "Player..."}
