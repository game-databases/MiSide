{"category": "LocationDialogue Location10", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "Čekaj, polako!"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "Budi tih..."}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "Opasno je ići dalje."}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "Nego..."}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "kako si došao ovde?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "Ovaj..."}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "Prsten otvara odgovarajuća vrata."}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "Iskreno, pojma nemam kako funkcioniše."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "Prsten?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "Šta je ovo mesto?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "Previše je mračno."}
{"category": "LocationDialogue Location10", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "Reći ću ti kasnije."}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "Za sada, idi do izlaza."}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "Sretnimo se u arkadnoj mašini."}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Požuri, ne odugovlači!"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// After mini-game"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "Pa, kapiraš li poentu igre sada?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "Ja sam napravljen od krvi i mesa, a vi od modela skeletona?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "Ou!"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "Zvuči jezivo kad tako kažeš."}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "Ali, da. To je suština."}
{"category": "LocationDialogue Location10", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "Dobro, ali zašto treba to da razumem?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "Misliš da sam se šalila kad sam ti rekla"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "da je opasno ići dalje?"}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "Naići ćeš na... napuštene modele..."}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "One koje su \"greška\"."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "Agresivne su i možda budu pokušale da te ubiju."}
{"category": "LocationDialogue Location10", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "Šta onda treba da radim?"}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Samo ću ići"}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "gde god se vrata otvore."}
{"category": "LocationDialogue Location10", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "Vau!"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "Onda im ne okreći leđa."}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "I ne ispuštaj ih iz vidokruga!"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "Postide se kad ih gledaš,"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "toliko da se ukoče u mestu."}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "Upamti to!"}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// Quest 1 (Why are there other Mitas down there?)"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "One su sveže napravljene."}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "Treba im vremena"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "da dobiju svest o sebi."}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "Onda ih ja vodim"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "ka njihovim ličnim kućama."}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// Quest 2 (Why is it so dark downstairs?)"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "Mi Mite smo \"napravljene\" u mraku,"}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "zbog toga moramo da ostanemo tu neko vreme."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Zamisli"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "bol koji osetiš kad iz mraka izađeš na svetlost..."}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// Quest 3 (What are you doing here?)"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "I dalje ne razumeš?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "Pomažem novim Mitama!"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "Ko će im drugi pomoći da nema mene?"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "Ti?"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// Quest 4 (Why do we need this conveyor?)"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "Čemu služi ova pokretna traka?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "Ima li mesta ovde za sve?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Čekaj, nemoj mi reći da ne razumeš"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "kako ovaj svet funkcioniše..."}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "I da je beskonačan?"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "Beskonačan?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "Ovaj..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "Šta hoćeš da kažeš?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "Ako je verzija 1.9 poslednja,"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "onda to znači da postoji 19 svetova."}
{"category": "LocationDialogue Location10", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "Gospode, ti uopšte ne razumeš"}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "kako ovaj svet funkcioniše."}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Iskoristiću ovu tablu"}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "da ti sve objasnim."}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "Hoćeš li da čuješ?"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// Quest 5 (What is your version?)"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Čekaj,"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "zar te nisam sreo u najskorijoj verziji?"}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "Ili sam možda umislio."}
{"category": "LocationDialogue Location10", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "Pa, moguće je."}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Ja sam iz verzije 1.5."}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "Jesi li bio u toj verziji?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Jesam."}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "Tu sam se i stvorio"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "kada sam došao na ovaj svet!"}
{"category": "LocationDialogue Location10", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "Ou!"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "Ali kako...?"}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "Koji je bio indeks broj kuće u kojoj si bio?"}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "Postoji još jedna \"ja\" koja se non-stop žali,"}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "\"ja\" koja se samo glupira,"}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "\"ja\" sa lošim sećanjem i koja voli da maltretira druge..."}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "I ko zna šta još..."}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Reci mi ćega se sećaš."}
{"category": "LocationDialogue Location10", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Bilo je mračno."}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "Na zidu je pisalo"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "nešto tipa..."}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "\"Igraj se sa mnom.\""}
{"category": "LocationDialogue Location10", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "Ah,"}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "pa da..."}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "To je bila \"ja\""}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "koja maltretira i zaboravlja sve."}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// Mita wants to tell you [No]"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Hvala, ali ne hvala."}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Ići će mi bolje ako ne budem znao."}
{"category": "LocationDialogue Location10", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "U redu, kako ti želiš."}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// Mita wants to tell you [Yes]."}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "U redu, može."}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "Samo se nadam da neće biti kao u školi,"}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "gde bih zaspao koliko mi bude dosadno."}
{"category": "LocationDialogue Location10", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "Možeš da izađeš u bilo kom trenutku,"}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "ili ostani i slušaj"}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "ako te interesuje."}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "Igrač skine MiSide"}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "i igra koliko god želi."}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "Onda, igrač napravi novu kuću"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "i novu Mitu."}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "Ovo je 2D prikaz."}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "Ovo su verzije,"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "prikazane kao linije."}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "Kuće se postave na ovim linijama."}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "Na primer, kada bi skinuo verziju 1.14,"}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "što bi značilo novi život,"}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "nova Mita i nova kuća."}
{"category": "LocationDialogue Location10", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "Čoveče..."}
{"category": "LocationDialogue Location10", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Možeš da pitaš za detalje"}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "u ovom crtežu,"}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "a ja ću se potruditi da ti objasnim."}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// He asks about the only circle"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "Zašto ima samo jedan krug?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "Ta verzija je izbačena samo jednom,"}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "i nikada više."}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "To je jedina verzija koja je zapravo jedinstvena."}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "Plus, ove verzije su posebne"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "i nemaju nijedan put do drugih verzija."}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "Pospana Mita boravi u ovoj verziji, 1.1."}
{"category": "LocationDialogue Location10", "line_index": 171, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "Pospana Mita?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "Zato što nikad ne uspe da spava"}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "sa svima koji prolaze kroz njenu verziju?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "Ne, nije to."}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "Možeš da prolaziš pored nje i praviš buku,"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "ali nemoguće ju je probuditi."}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// He asks about the shaded circle"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "Zašto je ovaj krug ovakav?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "Ah, takva je"}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "zbog Lepe Mite."}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "Ona ga je tako nacrtala."}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "Raspravljali smo"}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "ko će najbrže stići do verzije 1.11."}
{"category": "LocationDialogue Location10", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "I, ko je pobedio?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "JA, naravno!"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "Vidi, mi smo ovde,"}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "u verziji 1.15,"}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "indeks kuće je 809."}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "Moramo da stignemo do verzije 1.11,"}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "kuće sa indeksom 805."}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Ona je išla ovim putem."}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "Pokušavali smo da pronađemo kraću rutu,"}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "pa je Lepa Mita predložila ovu."}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "A onda sam ja nacrtala najjednostavniju ovde."}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "Prosto, zar ne?"}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Vidi."}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "Odavde možeš direktno doći do odgovarajuće verzije."}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Iako možda deluje da je ova kuća prepreka na putu,"}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "da ti blokira put..."}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "U svakom slučaju, tvoj prsten funkcioniše prema istom principu."}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "Gde si se uputio?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "Ka Jezgru."}
{"category": "LocationDialogue Location10", "line_index": 210, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "Jezgru?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "Hm..."}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Ako želiš najkraću rutu,"}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "moraćeš da prođeš i kroz verziju 1.11."}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "Tu ćeš sigurno naleteti na Pospanu Mitu."}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Mislim da je Mita koja te je poslala"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "išla istim putem."}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "Ili možda nije shvatila da ćeš ti ići drugim putem."}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "Ili je možda genije"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "i pronašla još kraću rutu!"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Mislim da razumem."}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// He asks about the inscription"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "Šta je ovo?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "To je za Kul Mitu."}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "Biće ovde za nekoliko sati."}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "Pomeriće ove kutije"}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "i postaviće sofu tu."}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "Zadnjica me boli!"}
{"category": "LocationDialogue Location10", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Uh..."}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "Možda mogu da pomognem?"}
{"category": "LocationDialogue Location10", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "Ne, to je posao Kul Mite."}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Jaka je ona."}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// He asks about the drawings"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "Je l' ovo samo običan crtež"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "ili"}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "ima neko značenje?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 244, "text": "Da,"}
{"category": "LocationDialogue Location10", "line_index": 245, "text": "to je obična škrabotina."}
