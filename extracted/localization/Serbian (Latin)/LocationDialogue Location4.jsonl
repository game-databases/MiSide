{"category": "LocationDialogue Location4", "line_index": 0, "text": "Mita?"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "Ah, budan si?"}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "Kako si došla ovde?"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": "Do maločas si bila pored mene."}
{"category": "LocationDialogue Location4", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 5, "text": "Ne, nisam."}
{"category": "LocationDialogue Location4", "line_index": 6, "text": "Stojao si ispred ogledala."}
{"category": "LocationDialogue Location4", "line_index": 7, "text": "Pa sam otišla."}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "Zašto su se sobe promenile?"}
{"category": "LocationDialogue Location4", "line_index": 9, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "Preuredila sam prostorije"}
{"category": "LocationDialogue Location4", "line_index": 11, "text": "kako bi ti bilo lakše."}
{"category": "LocationDialogue Location4", "line_index": 12, "text": "Ovde"}
{"category": "LocationDialogue Location4", "line_index": 13, "text": "možemo da menjamo sobe"}
{"category": "LocationDialogue Location4", "line_index": 14, "text": "kako god želimo."}
{"category": "LocationDialogue Location4", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 16, "text": "Nisi morala."}
{"category": "LocationDialogue Location4", "line_index": 17, "text": "Taman sam se navikao."}
{"category": "LocationDialogue Location4", "line_index": 18, "text": "Mislim da će ti ovako biti bolje."}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Mita card game"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "U redu,"}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "hoćemo li da igramo?"}
{"category": "LocationDialogue Location4", "line_index": 22, "text": "Igra se ovako:"}
{"category": "LocationDialogue Location4", "line_index": 23, "text": "Ovaj čip pokazuje vrstu,"}
{"category": "LocationDialogue Location4", "line_index": 24, "text": "kao što je zdravlje."}
{"category": "LocationDialogue Location4", "line_index": 25, "text": "Oboje odigramo kartu"}
{"category": "LocationDialogue Location4", "line_index": 26, "text": "i ako tvoja karta ima veći"}
{"category": "LocationDialogue Location4", "line_index": 27, "text": "poen zdravlja"}
{"category": "LocationDialogue Location4", "line_index": 28, "text": "od moje,"}
{"category": "LocationDialogue Location4", "line_index": 29, "text": "ti pobeđuješ."}
{"category": "LocationDialogue Location4", "line_index": 30, "text": "Uzmi karte."}
{"category": "LocationDialogue Location4", "line_index": 31, "text": "Moj potez."}
{"category": "LocationDialogue Location4", "line_index": 32, "text": "Uhu!"}
{"category": "LocationDialogue Location4", "line_index": 33, "text": "Dobre karte!"}
{"category": "LocationDialogue Location4", "line_index": 34, "text": "Ja ću prva!"}
{"category": "LocationDialogue Location4", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 44, "text": "U redu!"}
{"category": "LocationDialogue Location4", "line_index": 45, "text": "Tvoj potez!"}
{"category": "LocationDialogue Location4", "line_index": 46, "text": "Aha."}
{"category": "LocationDialogue Location4", "line_index": 47, "text": "Tvoj potez!"}
{"category": "LocationDialogue Location4", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 49, "text": "Najveći poen zdravlja pobeđuje!"}
{"category": "LocationDialogue Location4", "line_index": 50, "text": "Sve je u napadu!"}
{"category": "LocationDialogue Location4", "line_index": 51, "text": "Fokusiraj se na odbranu!"}
{"category": "LocationDialogue Location4", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 54, "text": "Pobedio si!"}
{"category": "LocationDialogue Location4", "line_index": 55, "text": "Pobedio si!"}
{"category": "LocationDialogue Location4", "line_index": 56, "text": "Sredio si me."}
{"category": "LocationDialogue Location4", "line_index": 57, "text": "Uf, ti..."}
{"category": "LocationDialogue Location4", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 59, "text": "Pobedila sam!"}
{"category": "LocationDialogue Location4", "line_index": 60, "text": "Pobeda je moja!"}
{"category": "LocationDialogue Location4", "line_index": 61, "text": "Pobedila sam!"}
{"category": "LocationDialogue Location4", "line_index": 62, "text": "Hah, sredila sam te!"}
{"category": "LocationDialogue Location4", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 64, "text": "Nerešeno."}
{"category": "LocationDialogue Location4", "line_index": 65, "text": "Isti smo!"}
{"category": "LocationDialogue Location4", "line_index": 66, "text": "Nerešeno!"}
{"category": "LocationDialogue Location4", "line_index": 67, "text": "Isti broj poena..."}
{"category": "LocationDialogue Location4", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 79, "text": "// The card game is interrupted"}
{"category": "LocationDialogue Location4", "line_index": 80, "text": "Kakav je to zvuk?"}
{"category": "LocationDialogue Location4", "line_index": 81, "text": "Dolazi iz ormara."}
{"category": "LocationDialogue Location4", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 83, "text": "Zvuk?"}
{"category": "LocationDialogue Location4", "line_index": 84, "text": "Kakav zvuk?"}
{"category": "LocationDialogue Location4", "line_index": 85, "text": "Ja ništa nisam čula."}
{"category": "LocationDialogue Location4", "line_index": 86, "text": "Šta si čuo?"}
{"category": "LocationDialogue Location4", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 88, "text": "Kucanje, kao da je neko u ormaru."}
{"category": "LocationDialogue Location4", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 90, "text": "Ali..."}
{"category": "LocationDialogue Location4", "line_index": 91, "text": "Tu nema nikoga..."}
{"category": "LocationDialogue Location4", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 93, "text": "Otvoriću ga i pogledaću šta je."}
{"category": "LocationDialogue Location4", "line_index": 94, "text": "Uplašilo me je."}
{"category": "LocationDialogue Location4", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 96, "text": "Ali zašto...?"}
{"category": "LocationDialogue Location4", "line_index": 97, "text": "Ponovo..."}
{"category": "LocationDialogue Location4", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 105, "text": "Šta to radiš!?"}
{"category": "LocationDialogue Location4", "line_index": 106, "text": "To je ormar..."}
{"category": "LocationDialogue Location4", "line_index": 107, "text": "Tu mi stoji donji veš...!"}
{"category": "LocationDialogue Location4", "line_index": 108, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 109, "text": "Kriješ li nešto od mene?"}
{"category": "LocationDialogue Location4", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 111, "text": "Zašto mi ne veruješ?"}
{"category": "LocationDialogue Location4", "line_index": 112, "text": "Šta radim pogrešno?"}
{"category": "LocationDialogue Location4", "line_index": 113, "text": "Samo želim..."}
{"category": "LocationDialogue Location4", "line_index": 114, "text": "Samo želim da budeš sa mnom."}
{"category": "LocationDialogue Location4", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 116, "text": "I ja bih to želeo, ali...?"}
{"category": "LocationDialogue Location4", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 118, "text": "Zašto si toliko zacrtao da vidiš šta je unutra?!"}
{"category": "LocationDialogue Location4", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 120, "text": "Hoću da vidim kakvo je to kucanje!"}
{"category": "LocationDialogue Location4", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 122, "text": "Je l' zato što"}
{"category": "LocationDialogue Location4", "line_index": 123, "text": "u ovom svetu"}
{"category": "LocationDialogue Location4", "line_index": 124, "text": "ima samo četiri sobe?"}
{"category": "LocationDialogue Location4", "line_index": 125, "text": "To ti nije dovoljno?"}
{"category": "LocationDialogue Location4", "line_index": 126, "text": "Zašto samo ne možeš da budeš sa mnom?"}
{"category": "LocationDialogue Location4", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 129, "text": "// Don't stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 130, "text": "Shvatam."}
{"category": "LocationDialogue Location4", "line_index": 131, "text": "Opet ovo..."}
{"category": "LocationDialogue Location4", "line_index": 132, "text": "Ako želiš da proveriš šta je u ormaru,"}
{"category": "LocationDialogue Location4", "line_index": 133, "text": "onda to uradi"}
{"category": "LocationDialogue Location4", "line_index": 134, "text": "i vidi šta je unutra!"}
{"category": "LocationDialogue Location4", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 139, "text": "Šta..."}
{"category": "LocationDialogue Location4", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 141, "text": "To se dešava s vremena na vreme."}
{"category": "LocationDialogue Location4", "line_index": 142, "text": "Soba se i dalje učitava."}
{"category": "LocationDialogue Location4", "line_index": 143, "text": "Samo sačekaj malo."}
{"category": "LocationDialogue Location4", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 145, "text": "Ovo je toliko čudno."}
{"category": "LocationDialogue Location4", "line_index": 146, "text": "Jesmo li u nečijem telefonu?"}
{"category": "LocationDialogue Location4", "line_index": 147, "text": "U nekoj sporoj krntiji?"}
{"category": "LocationDialogue Location4", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 149, "text": "Ne, ne."}
{"category": "LocationDialogue Location4", "line_index": 150, "text": "Nije sve tako savršeno"}
{"category": "LocationDialogue Location4", "line_index": 151, "text": "u ovom svetu..."}
{"category": "LocationDialogue Location4", "line_index": 152, "text": "Bivamo učitavani"}
{"category": "LocationDialogue Location4", "line_index": 153, "text": "zajedno sa jezgrom ovog sveta."}
{"category": "LocationDialogue Location4", "line_index": 154, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 155, "text": "Jezgrom?"}
{"category": "LocationDialogue Location4", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 157, "text": "Tipično, zar ne?"}
{"category": "LocationDialogue Location4", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 159, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 161, "text": "Nego, mogli bismo"}
{"category": "LocationDialogue Location4", "line_index": 162, "text": "da igramo neku igricu"}
{"category": "LocationDialogue Location4", "line_index": 163, "text": "ili da igramo karte"}
{"category": "LocationDialogue Location4", "line_index": 164, "text": "Ti biraj."}
{"category": "LocationDialogue Location4", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 167, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 168, "text": "// Mita play fight"}
{"category": "LocationDialogue Location4", "line_index": 169, "text": "Hoćeš borbu?"}
{"category": "LocationDialogue Location4", "line_index": 170, "text": "Moraš da pobediš"}
{"category": "LocationDialogue Location4", "line_index": 171, "text": "četiri puta."}
{"category": "LocationDialogue Location4", "line_index": 172, "text": "Navali."}
{"category": "LocationDialogue Location4", "line_index": 173, "text": "Ne brini,"}
{"category": "LocationDialogue Location4", "line_index": 174, "text": "pustiću te malo u početku."}
{"category": "LocationDialogue Location4", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 176, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 177, "text": "Dobar dečko."}
{"category": "LocationDialogue Location4", "line_index": 178, "text": "Bolje obrati pažnju!"}
{"category": "LocationDialogue Location4", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 180, "text": "Uu!"}
{"category": "LocationDialogue Location4", "line_index": 181, "text": "Dobro, u redu."}
{"category": "LocationDialogue Location4", "line_index": 182, "text": "Sad ću da se uozbiljim."}
{"category": "LocationDialogue Location4", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 184, "text": "Vau!"}
{"category": "LocationDialogue Location4", "line_index": 185, "text": "Da vidimo možeš li me"}
{"category": "LocationDialogue Location4", "line_index": 186, "text": "pobediti sada!"}
{"category": "LocationDialogue Location4", "line_index": 187, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 188, "text": "Ti si"}
{"category": "LocationDialogue Location4", "line_index": 189, "text": "jednostavno"}
{"category": "LocationDialogue Location4", "line_index": 190, "text": "neverovatan! Baš si dobar u ovome!"}
{"category": "LocationDialogue Location4", "line_index": 191, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 193, "text": "Šta je bilo?"}
{"category": "LocationDialogue Location4", "line_index": 194, "text": "Pf, ovo je dosadno."}
{"category": "LocationDialogue Location4", "line_index": 195, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 196, "text": "Pa,"}
{"category": "LocationDialogue Location4", "line_index": 197, "text": "to je to. Veruješ li u sudbinu?"}
{"category": "LocationDialogue Location4", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 199, "text": "Onda"}
{"category": "LocationDialogue Location4", "line_index": 200, "text": "se uozbilji ili ćeš ostati gubitnik zauvek!"}
{"category": "LocationDialogue Location4", "line_index": 201, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 202, "text": "Šta je sa tobom danas?"}
{"category": "LocationDialogue Location4", "line_index": 203, "text": "Obrisala sam pod tobom."}
{"category": "LocationDialogue Location4", "line_index": 204, "text": "Nisi dao sve od sebe—"}
{"category": "LocationDialogue Location4", "line_index": 205, "text": "zato sam pobedila!"}
{"category": "LocationDialogue Location4", "line_index": 206, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 208, "text": "U redu, onda."}
{"category": "LocationDialogue Location4", "line_index": 209, "text": "Šta misliš da igramo karte?"}
{"category": "LocationDialogue Location4", "line_index": 210, "text": "U spavaćoj sobi su."}
{"category": "LocationDialogue Location4", "line_index": 211, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 214, "text": "// Door > [ERROR]"}
{"category": "LocationDialogue Location4", "line_index": 215, "text": "Ha, šta se dešava?"}
{"category": "LocationDialogue Location4", "line_index": 216, "text": "Gde je..."}
{"category": "LocationDialogue Location4", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 218, "text": "O-o."}
{"category": "LocationDialogue Location4", "line_index": 219, "text": "Izvini..."}
{"category": "LocationDialogue Location4", "line_index": 220, "text": "Skinula sam nešto"}
{"category": "LocationDialogue Location4", "line_index": 221, "text": "sa neta."}
{"category": "LocationDialogue Location4", "line_index": 222, "text": "Htela sam malo"}
{"category": "LocationDialogue Location4", "line_index": 223, "text": "da ulepšam spoljašnjost."}
{"category": "LocationDialogue Location4", "line_index": 224, "text": "Ali izgleda"}
{"category": "LocationDialogue Location4", "line_index": 225, "text": "da je bila neka greška sa fajlom."}
{"category": "LocationDialogue Location4", "line_index": 226, "text": "Popraviću kasnije."}
{"category": "LocationDialogue Location4", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 228, "text": "Zbog toga ne možemo napolje?"}
{"category": "LocationDialogue Location4", "line_index": 229, "text": "Da, zbog toga."}
{"category": "LocationDialogue Location4", "line_index": 230, "text": "// Mita shy"}
{"category": "LocationDialogue Location4", "line_index": 231, "text": "Hej..."}
{"category": "LocationDialogue Location4", "line_index": 232, "text": "Šta je sa tobom?"}
{"category": "LocationDialogue Location4", "line_index": 233, "text": "Šta ti treba?"}
{"category": "LocationDialogue Location4", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 236, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 237, "text": "// Wall Clock"}
{"category": "LocationDialogue Location4", "line_index": 238, "text": "Ovaj sat ovde,"}
{"category": "LocationDialogue Location4", "line_index": 239, "text": "koje vreme pokazuje?"}
{"category": "LocationDialogue Location4", "line_index": 240, "text": "Trenutno vreme u ovoj igri?"}
{"category": "LocationDialogue Location4", "line_index": 241, "text": "Ili je sinhronizovan sa mojim telefonom?"}
{"category": "LocationDialogue Location4", "line_index": 242, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 243, "text": "Pa, ovaj..."}
{"category": "LocationDialogue Location4", "line_index": 244, "text": "Iskreno, ne znam."}
{"category": "LocationDialogue Location4", "line_index": 245, "text": "Ali vreme ovde nije bitno..."}
{"category": "LocationDialogue Location4", "line_index": 246, "text": "Bilo kasno ili rano,"}
{"category": "LocationDialogue Location4", "line_index": 247, "text": "jaka devojka poput mene"}
{"category": "LocationDialogue Location4", "line_index": 248, "text": "je uvek puna energije—"}
{"category": "LocationDialogue Location4", "line_index": 249, "text": "Nikad se ne umaram!"}
{"category": "LocationDialogue Location4", "line_index": 250, "text": "Ovde možemo da imamo beskonačno proleće,"}
{"category": "LocationDialogue Location4", "line_index": 251, "text": "ili neograničeno popodne!"}
{"category": "LocationDialogue Location4", "line_index": 252, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 253, "text": "Interesantno..."}
{"category": "LocationDialogue Location4", "line_index": 254, "text": "ali ujedno i jezivo."}
{"category": "LocationDialogue Location4", "line_index": 255, "text": "Biti zauvek zaglavljen u jednom trenutku..."}
{"category": "LocationDialogue Location4", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 258, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 259, "text": "// Photos of Mita"}
{"category": "LocationDialogue Location4", "line_index": 260, "text": "Dobre fotke."}
{"category": "LocationDialogue Location4", "line_index": 261, "text": "Pretpostavljam da su ovo tvoje slike?"}
{"category": "LocationDialogue Location4", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 263, "text": "Aha."}
{"category": "LocationDialogue Location4", "line_index": 264, "text": "I meni se sviđaju."}
{"category": "LocationDialogue Location4", "line_index": 265, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 266, "text": "Ko ih je uslikao?"}
{"category": "LocationDialogue Location4", "line_index": 267, "text": "Ima li drugih ljudi u ovom svetu?"}
{"category": "LocationDialogue Location4", "line_index": 268, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 269, "text": "Moglo bi se reći."}
{"category": "LocationDialogue Location4", "line_index": 270, "text": "Upoznaću te jednom."}
{"category": "LocationDialogue Location4", "line_index": 271, "text": "Ali ne još."}
{"category": "LocationDialogue Location4", "line_index": 272, "text": "Za sada želim da budem sama sa tobom."}
{"category": "LocationDialogue Location4", "line_index": 273, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 275, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 276, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 277, "text": "// Portal"}
{"category": "LocationDialogue Location4", "line_index": 278, "text": "Gde je portal nestao?"}
{"category": "LocationDialogue Location4", "line_index": 279, "text": "Ili kako god se to zvalo?"}
{"category": "LocationDialogue Location4", "line_index": 280, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 281, "text": "Iskoristila sam"}
{"category": "LocationDialogue Location4", "line_index": 282, "text": "malu magiju"}
{"category": "LocationDialogue Location4", "line_index": 283, "text": "i pomerila ga"}
{"category": "LocationDialogue Location4", "line_index": 284, "text": "negde drugde."}
{"category": "LocationDialogue Location4", "line_index": 285, "text": "Više nam nije potreban."}
{"category": "LocationDialogue Location4", "line_index": 286, "text": "Smetao bi nam."}
{"category": "LocationDialogue Location4", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 288, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 289, "text": "// Mirror in the bedroom"}
{"category": "LocationDialogue Location4", "line_index": 290, "text": "Kad gledam u ogledalo"}
{"category": "LocationDialogue Location4", "line_index": 291, "text": "bez odraza, bude mi malo jezivo."}
{"category": "LocationDialogue Location4", "line_index": 292, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 293, "text": "Možemo uključiti odraze"}
{"category": "LocationDialogue Location4", "line_index": 294, "text": "ako zaista želiš."}
{"category": "LocationDialogue Location4", "line_index": 295, "text": "Ali, da li nam zaista trebaju?"}
{"category": "LocationDialogue Location4", "line_index": 296, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 297, "text": "Naravno."}
{"category": "LocationDialogue Location4", "line_index": 298, "text": "Ili... hoće li biti posledica ako ih upalimo?"}
{"category": "LocationDialogue Location4", "line_index": 299, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 300, "text": "Hoće."}
{"category": "LocationDialogue Location4", "line_index": 301, "text": "Bagovaćemo i kretaćemo se sporije."}
{"category": "LocationDialogue Location4", "line_index": 302, "text": "Jesi li ikada video crtać sa malo sličica po sekundi?"}
{"category": "LocationDialogue Location4", "line_index": 303, "text": "To bi se i nama desilo."}
{"category": "LocationDialogue Location4", "line_index": 304, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 305, "text": "Razumem."}
{"category": "LocationDialogue Location4", "line_index": 306, "text": "Onda je možda bolje da ih ne palimo..."}
{"category": "LocationDialogue Location4", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 308, "text": "Nego, [player],"}
{"category": "LocationDialogue Location4", "line_index": 309, "text": "tebi se baš dopadaju ogledala, zar ne?"}
{"category": "LocationDialogue Location4", "line_index": 310, "text": "Plašiš li se osmeha na tom tvom licu?"}
{"category": "LocationDialogue Location4", "line_index": 311, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 312, "text": "Ha? Ne baš..."}
{"category": "LocationDialogue Location4", "line_index": 313, "text": "Samo sam umoran"}
{"category": "LocationDialogue Location4", "line_index": 314, "text": "nakon toliko posla."}
{"category": "LocationDialogue Location4", "line_index": 315, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 316, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 317, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 318, "text": "// Blue sneakers"}
{"category": "LocationDialogue Location4", "line_index": 319, "text": "Jesu li ovo tvoje patike?"}
{"category": "LocationDialogue Location4", "line_index": 320, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 321, "text": "Ne, tvoje su."}
{"category": "LocationDialogue Location4", "line_index": 322, "text": "Zar se ne sećaš?"}
{"category": "LocationDialogue Location4", "line_index": 323, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 324, "text": "Ne pamtim da sam ikad imao ovakve patike."}
{"category": "LocationDialogue Location4", "line_index": 325, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 326, "text": "Sada ih imaš."}
{"category": "LocationDialogue Location4", "line_index": 327, "text": "Možeš da ih obuješ"}
{"category": "LocationDialogue Location4", "line_index": 328, "text": "kada budemo izlazili napolje."}
{"category": "LocationDialogue Location4", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 330, "text": "Šta je sa odećom?"}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "Sve što imam u ovom svetu"}
{"category": "LocationDialogue Location4", "line_index": 332, "text": "jeste odeća koju trenutno nosim."}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "Mogu li nekako da nabavim novu?"}
{"category": "LocationDialogue Location4", "line_index": 334, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 335, "text": "Naravno da možeš."}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "Inače, videla sam šta oblačiš—"}
{"category": "LocationDialogue Location4", "line_index": 337, "text": "i iskreno, nemaš neki ukus."}
{"category": "LocationDialogue Location4", "line_index": 338, "text": "Bilo kako bilo, pomoći ću ti u tome."}
{"category": "LocationDialogue Location4", "line_index": 339, "text": "Ali ne sada."}
{"category": "LocationDialogue Location4", "line_index": 340, "text": "Obećavam da hoću."}
{"category": "LocationDialogue Location4", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 342, "text": "U redu."}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Games on TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "Šta želiš da igramo?"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Game milk"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "Ovo je borilačka igra!"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "Da vidimo ko će pobediti!"}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "Kakva igra!"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": "Imali smo dovoljno mleka, hajde da radimo nešto drugo."}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Game penguins"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "U ovoj igri, ti si pingvin"}
{"category": "LocationDialogue Location4", "line_index": 354, "text": "koji kliza."}
{"category": "LocationDialogue Location4", "line_index": 355, "text": "U redu, to je ta igra."}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "Ha, šta?"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "Ozbiljno? Mislila sam da ćeš..."}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "Tako sam srećna!"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "I malo zbunjena..."}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "Ali..."}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "Ostani sa mnom, molim te—"}
{"category": "LocationDialogue Location4", "line_index": 364, "text": "uvek i zauvek."}
{"category": "LocationDialogue Location4", "line_index": 365, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 367, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 368, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 369, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 370, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 372, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 373, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 374, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 375, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 376, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 377, "text": "// A game about penguins"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "Prosta je:"}
{"category": "LocationDialogue Location4", "line_index": 379, "text": "samo prikupljaj grudve snega."}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "Ko više skupi, pobeđuje!"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "Igraćemo dve runde, u redu?!"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// The first map"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "Vau, kako si prikupio toliko?"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "He-he, ja sam skupila najviše!"}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "Bolje bi ti bilo da se fokusiraš!"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "Ha, 1:1!"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// The second map"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "Ti si prirodno pingvin!"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "Mogao bi da probaš na pravom ledu!"}
{"category": "LocationDialogue Location4", "line_index": 390, "text": "Pf, spor si."}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "I dalje misliš o poslednjoj rundi?"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "Uu, nerešeno! To je retkost!"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// The game is over"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "U redu, hoćeš da igramo nešto drugo?"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "Ili si gotov?"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "Šta će ti to?"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "Nisi neki gejmer, a?"}
