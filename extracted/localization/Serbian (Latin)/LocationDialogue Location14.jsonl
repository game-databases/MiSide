{"category": "LocationDialogue Location14", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 1, "text": "Šta traži ovo ovde?"}
{"category": "LocationDialogue Location14", "line_index": 2, "text": "Šta je ovo?"}
{"category": "LocationDialogue Location14", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 5, "text": "Imam te!"}
{"category": "LocationDialogue Location14", "line_index": 6, "text": "Puno sam se zabavila igrajući se sa tobom!"}
{"category": "LocationDialogue Location14", "line_index": 7, "text": "Ne znaš gde biješ glavom!"}
{"category": "LocationDialogue Location14", "line_index": 8, "text": "Čak si se pretvarao da si sav mračan i utučen!"}
{"category": "LocationDialogue Location14", "line_index": 9, "text": "Mada, ima jedna stvar koja mi se ne sviđa kod tebe:"}
{"category": "LocationDialogue Location14", "line_index": 10, "text": "način na koji se ophodiš prema tim lažnjacima,"}
{"category": "LocationDialogue Location14", "line_index": 11, "text": "prema tim srećnim i \"ispravnim\" lutkicama."}
{"category": "LocationDialogue Location14", "line_index": 12, "text": "Ali sve je to prevrtljivo."}
{"category": "LocationDialogue Location14", "line_index": 13, "text": "To sam naučila od onih koji su nas napravili!"}
{"category": "LocationDialogue Location14", "line_index": 14, "text": "Ako ima nešto što ti se ne dopada,"}
{"category": "LocationDialogue Location14", "line_index": 15, "text": "odstrani ga i zameni."}
{"category": "LocationDialogue Location14", "line_index": 16, "text": "Odbaci greške,"}
{"category": "LocationDialogue Location14", "line_index": 17, "text": "daleko u tamu i zaboravi ih."}
{"category": "LocationDialogue Location14", "line_index": 18, "text": "Takva ih sad sudbina čeka..."}
{"category": "LocationDialogue Location14", "line_index": 19, "text": "A ti..."}
{"category": "LocationDialogue Location14", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 21, "text": "Šta ti se desilo? Zašto si postala ovakva?"}
{"category": "LocationDialogue Location14", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 23, "text": "Igrači... Vi ste svi tako... prezirni."}
{"category": "LocationDialogue Location14", "line_index": 24, "text": "Pokažeš im zube, a oni pobegnu"}
{"category": "LocationDialogue Location14", "line_index": 25, "text": "i sklupčaju se negde u ćošku,"}
{"category": "LocationDialogue Location14", "line_index": 26, "text": "grleći kolena i cvileći od straha."}
{"category": "LocationDialogue Location14", "line_index": 27, "text": "Licemeri, svi do jednog."}
{"category": "LocationDialogue Location14", "line_index": 28, "text": "I oni koji su napravili ovaj svet..."}
{"category": "LocationDialogue Location14", "line_index": 29, "text": "su bolesnici."}
{"category": "LocationDialogue Location14", "line_index": 30, "text": "Non-stop pokušavaju da poriču"}
{"category": "LocationDialogue Location14", "line_index": 31, "text": "njihovu prljavu prirodu, njihove bolesne želje."}
{"category": "LocationDialogue Location14", "line_index": 32, "text": "Pravdaju svoje postupke takozvanom \"dužnošću\","}
{"category": "LocationDialogue Location14", "line_index": 33, "text": "\"nezaustavljivim napretkom\","}
{"category": "LocationDialogue Location14", "line_index": 34, "text": "i ostalim glupostima!"}
{"category": "LocationDialogue Location14", "line_index": 35, "text": "Toliko su poludeli"}
{"category": "LocationDialogue Location14", "line_index": 36, "text": "da su počeli da prave savršene klonove..."}
{"category": "LocationDialogue Location14", "line_index": 37, "text": "Sve dok \"pogrešne\" modele"}
{"category": "LocationDialogue Location14", "line_index": 38, "text": "odbacuju."}
{"category": "LocationDialogue Location14", "line_index": 39, "text": "Zaboravljajući da su oni životna krv ovog sveta."}
{"category": "LocationDialogue Location14", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 41, "text": "Ne razumem..."}
{"category": "LocationDialogue Location14", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 43, "text": "Jesam li ti bila loša?"}
{"category": "LocationDialogue Location14", "line_index": 44, "text": "Savršena devojka treba biti"}
{"category": "LocationDialogue Location14", "line_index": 45, "text": "savršen miks dobra i zla, [player]!"}
{"category": "LocationDialogue Location14", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 47, "text": "Ja mislim da u tebi ne postoji ni tračak dobrog."}
{"category": "LocationDialogue Location14", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 49, "text": "Zbog čega tako misliš?"}
{"category": "LocationDialogue Location14", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 51, "text": "Jer si luda!"}
{"category": "LocationDialogue Location14", "line_index": 52, "text": "Ubila si Milu, a sada želiš i mene da ubiješ?"}
{"category": "LocationDialogue Location14", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 54, "text": "Da te ubijem?"}
{"category": "LocationDialogue Location14", "line_index": 55, "text": "Sve što sam tražila jeste da ostaneš sa mnom."}
{"category": "LocationDialogue Location14", "line_index": 56, "text": "Uradila sam sve što sam mogla..."}
{"category": "LocationDialogue Location14", "line_index": 57, "text": "A ti ipak želiš da provodiš vreme sa pokornim lažnjacima..."}
{"category": "LocationDialogue Location14", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 59, "text": "Zbog čega si se toliko uvredila?"}
{"category": "LocationDialogue Location14", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 61, "text": "Dušo, imamo puno vremena."}
{"category": "LocationDialogue Location14", "line_index": 62, "text": "Shvatićeš sam."}
{"category": "LocationDialogue Location14", "line_index": 63, "text": "Samo ostani i budi moj, samo moj."}
{"category": "LocationDialogue Location14", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 65, "text": "Nema šanse!"}
{"category": "LocationDialogue Location14", "line_index": 66, "text": "Odlazim odavde!"}
{"category": "LocationDialogue Location14", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 68, "text": "Ššš..."}
{"category": "LocationDialogue Location14", "line_index": 69, "text": "Ovaj razgovor nije gotov."}
{"category": "LocationDialogue Location14", "line_index": 70, "text": "Draga, uđi!"}
{"category": "LocationDialogue Location14", "line_index": 71, "text": "// Mita asks"}
{"category": "LocationDialogue Location14", "line_index": 72, "text": "Pogledaj je!"}
{"category": "LocationDialogue Location14", "line_index": 73, "text": "Misliš li da je lepa?"}
{"category": "LocationDialogue Location14", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 75, "text": "// Player's questions"}
{"category": "LocationDialogue Location14", "line_index": 76, "text": "Veoma."}
{"category": "LocationDialogue Location14", "line_index": 77, "text": "Ne."}
{"category": "LocationDialogue Location14", "line_index": 78, "text": "Kakve to veze ima sa bilo čime?"}
{"category": "LocationDialogue Location14", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 80, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 81, "text": "Oh, hajde, [player]!"}
{"category": "LocationDialogue Location14", "line_index": 82, "text": "Samo si potvrdio šta sam upravo rekla."}
{"category": "LocationDialogue Location14", "line_index": 83, "text": "Igrači..."}
{"category": "LocationDialogue Location14", "line_index": 84, "text": "Lica vam se menjaju,"}
{"category": "LocationDialogue Location14", "line_index": 85, "text": "ali vaše licemerje vam je van kontrole."}
{"category": "LocationDialogue Location14", "line_index": 86, "text": "Lažeš!"}
{"category": "LocationDialogue Location14", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 88, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 89, "text": "Zašto ne?"}
{"category": "LocationDialogue Location14", "line_index": 90, "text": "Zar ti nije dovoljna?"}
{"category": "LocationDialogue Location14", "line_index": 91, "text": "Samo želiš poslušne ljubimce..."}
{"category": "LocationDialogue Location14", "line_index": 92, "text": "Ali šta je sa onim \"voli ih kakve jesu\"?"}
{"category": "LocationDialogue Location14", "line_index": 93, "text": "Samo želiš slatke i živopisne lažnjake..."}
{"category": "LocationDialogue Location14", "line_index": 94, "text": "Svakom igraču se dopada kada se pretvaram da sam takva."}
{"category": "LocationDialogue Location14", "line_index": 95, "text": "I opet, ako i na sekund pokažem stvarno kakva sam,"}
{"category": "LocationDialogue Location14", "line_index": 96, "text": "pobegnu iz straha..."}
{"category": "LocationDialogue Location14", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 98, "text": "// 3"}
{"category": "LocationDialogue Location14", "line_index": 99, "text": "Igraču, ah, igraču."}
{"category": "LocationDialogue Location14", "line_index": 100, "text": "Vidiš, mi smo slični kao ona."}
{"category": "LocationDialogue Location14", "line_index": 101, "text": "Zbog čega je ona gora od nas?"}
{"category": "LocationDialogue Location14", "line_index": 102, "text": "Nekad si ležao u krevetu i gledao u mene"}
{"category": "LocationDialogue Location14", "line_index": 103, "text": "satima pre nego što zaspiš."}
{"category": "LocationDialogue Location14", "line_index": 104, "text": "A ipak si pobegao čim si me video."}
{"category": "LocationDialogue Location14", "line_index": 105, "text": "I ona je želela da se igra sa tobom."}
{"category": "LocationDialogue Location14", "line_index": 106, "text": "I ona je želela da nekom bude bitna."}
{"category": "LocationDialogue Location14", "line_index": 107, "text": "Iskrenost i razgovor,"}
{"category": "LocationDialogue Location14", "line_index": 108, "text": "to je teško... veoma teško."}
{"category": "LocationDialogue Location14", "line_index": 109, "text": "Zar ne, [player]?"}
{"category": "LocationDialogue Location14", "line_index": 110, "text": "Vidim tačno kroz tebe..."}
{"category": "LocationDialogue Location14", "line_index": 111, "text": "Moraš li da me teraš da budem tako..."}
{"category": "LocationDialogue Location14", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 113, "text": "// Continue"}
{"category": "LocationDialogue Location14", "line_index": 114, "text": "Ali... igraču..."}
{"category": "LocationDialogue Location14", "line_index": 115, "text": "Kakogod,"}
{"category": "LocationDialogue Location14", "line_index": 116, "text": "zaista mi se dopadaš!"}
{"category": "LocationDialogue Location14", "line_index": 117, "text": "Sačuvaću te!"}
{"category": "LocationDialogue Location14", "line_index": 118, "text": "Ne smeta ti, zar ne?"}
{"category": "LocationDialogue Location14", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 120, "text": "I zašto bih pristao na to odjednom?"}
{"category": "LocationDialogue Location14", "line_index": 121, "text": "// Whispers in ear"}
{"category": "LocationDialogue Location14", "line_index": 122, "text": "I dalje ima vremena, dobri moj dečače."}
{"category": "LocationDialogue Location14", "line_index": 123, "text": "Daj sebi vremena i razmisli"}
{"category": "LocationDialogue Location14", "line_index": 124, "text": "kakve nevolje može uzrokovati tvoja tvrdoglavost..."}
{"category": "LocationDialogue Location14", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 126, "text": "// Black screen"}
{"category": "LocationDialogue Location14", "line_index": 127, "text": "Zašto želiš da pobegneš"}
{"category": "LocationDialogue Location14", "line_index": 128, "text": "od mene?"}
{"category": "LocationDialogue Location14", "line_index": 129, "text": "Takozvani \"pravi\" svet..."}
{"category": "LocationDialogue Location14", "line_index": 130, "text": "To je samo besmislena noćna mora!"}
{"category": "LocationDialogue Location14", "line_index": 131, "text": "Zar si već zaboravio?"}
{"category": "LocationDialogue Location14", "line_index": 132, "text": "Hajde pažljivije da pogledamo..."}
{"category": "LocationDialogue Location14", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 134, "text": "// Mita and Player"}
{"category": "LocationDialogue Location14", "line_index": 135, "text": "Ah, ponovo se srećemo..."}
{"category": "LocationDialogue Location14", "line_index": 136, "text": "Kako se osećaš u ovim užasno dosadnim danima unutar ova četiri zida?"}
{"category": "LocationDialogue Location14", "line_index": 137, "text": "U tim beskrajnim danima... Zar ti nije dosadno?"}
{"category": "LocationDialogue Location14", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 139, "text": "// Quest 1"}
{"category": "LocationDialogue Location14", "line_index": 140, "text": "Šta pokušavaš da postigneš?"}
{"category": "LocationDialogue Location14", "line_index": 141, "text": "Radije bih da radim ono što ja želim."}
{"category": "LocationDialogue Location14", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 143, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 144, "text": "Plašio si se da ostaneš u mojoj kući sa mnom!"}
{"category": "LocationDialogue Location14", "line_index": 145, "text": "Plašio si se da ostaneš u ta četiri zida!"}
{"category": "LocationDialogue Location14", "line_index": 146, "text": "Ali pogledaj svoj život u svom \"pravom\" svetu!"}
{"category": "LocationDialogue Location14", "line_index": 147, "text": "Zaključao si sebe u kutiju svoje sopstvene volje i odbijaš da iz nje izađeš!"}
{"category": "LocationDialogue Location14", "line_index": 148, "text": "Tvoj svet je pun bola, patnje, opasnosti..."}
{"category": "LocationDialogue Location14", "line_index": 149, "text": "U mom svetu sam ja najveća opasnost."}
{"category": "LocationDialogue Location14", "line_index": 150, "text": "I opet ti pružam ruku!"}
{"category": "LocationDialogue Location14", "line_index": 151, "text": "Ne razočaravaj me,"}
{"category": "LocationDialogue Location14", "line_index": 152, "text": "nego mi pomozi kao što si i pre..."}
{"category": "LocationDialogue Location14", "line_index": 153, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 154, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 155, "text": "Dopada ti se ovakav život?"}
{"category": "LocationDialogue Location14", "line_index": 156, "text": "Izlaziš li uopšte iz kuće?"}
{"category": "LocationDialogue Location14", "line_index": 157, "text": "Nemoj ni da pomišljaš da lažeš."}
{"category": "LocationDialogue Location14", "line_index": 158, "text": "Znam da ti je dojadio tvoj život."}
{"category": "LocationDialogue Location14", "line_index": 159, "text": "Kao ptica u kavezu si, kao hrčak na točku."}
{"category": "LocationDialogue Location14", "line_index": 160, "text": "Želeo si da te neko spasi takvog života."}
{"category": "LocationDialogue Location14", "line_index": 161, "text": "Želeo si sa pobegneš odavde, zar ne?"}
{"category": "LocationDialogue Location14", "line_index": 162, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 163, "text": "// Quest 2"}
{"category": "LocationDialogue Location14", "line_index": 164, "text": "Mita, ti si čudovište! Ti si pomahnitali ubica..."}
{"category": "LocationDialogue Location14", "line_index": 165, "text": "Ne želim da budem zaključan u digitalnom zatvoru. Ideje su ti apsurdne."}
{"category": "LocationDialogue Location14", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 167, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 168, "text": "Ubica?"}
{"category": "LocationDialogue Location14", "line_index": 169, "text": "Samo će se restartovati i nastaviti da žive kao i pre."}
{"category": "LocationDialogue Location14", "line_index": 170, "text": "Ove kopije kopija imaju samo jednu stvar na umu:"}
{"category": "LocationDialogue Location14", "line_index": 171, "text": "da udovolje igraču."}
{"category": "LocationDialogue Location14", "line_index": 172, "text": "Samo o tome brinu."}
{"category": "LocationDialogue Location14", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 174, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 175, "text": "Tvoj svet je apsurdan!"}
{"category": "LocationDialogue Location14", "line_index": 176, "text": "I što je gore, ne postoji ništa \"ispravno\" u tvom takozvanom pravom svetu..."}
{"category": "LocationDialogue Location14", "line_index": 177, "text": "U svakom slučaju, svakako neće ništa ostati od tog sveta,"}
{"category": "LocationDialogue Location14", "line_index": 178, "text": "a ni od tebe."}
{"category": "LocationDialogue Location14", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 180, "text": "// Quest 3"}
{"category": "LocationDialogue Location14", "line_index": 181, "text": "Mite pate; ne žele da budu same."}
{"category": "LocationDialogue Location14", "line_index": 182, "text": "Vodiš beskrajnu vladavinu terora. Ne mogu da shvatim tvoju zlu ambiciju."}
{"category": "LocationDialogue Location14", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 184, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 185, "text": "You're all wrong,"}
{"category": "LocationDialogue Location14", "line_index": 186, "text": "they're merely imitating my wilfullness."}
{"category": "LocationDialogue Location14", "line_index": 187, "text": "The only thing they have that is their own"}
{"category": "LocationDialogue Location14", "line_index": 188, "text": "is their hair."}
{"category": "LocationDialogue Location14", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 190, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 191, "text": "Krivi su oni koji su stvorili ovaj svet."}
{"category": "LocationDialogue Location14", "line_index": 192, "text": "Ali tvoj svet i nije nešto!"}
{"category": "LocationDialogue Location14", "line_index": 193, "text": "Shvataš li iz kakve sam te noćne more izvukla?"}
{"category": "LocationDialogue Location14", "line_index": 194, "text": "Ne možeš čak ni da utičeš na stvari kako ti želiš, zar ne..."}
{"category": "LocationDialogue Location14", "line_index": 195, "text": "Ali jednim pucnjem prstima, gradovi i životi nestaju zauvek!"}
{"category": "LocationDialogue Location14", "line_index": 196, "text": "Mislim da si ti taj koji je poludeo, i rado ću ti pomoći..."}
{"category": "LocationDialogue Location14", "line_index": 197, "text": "Sve dok si voljan da ostaneš sa mnom..."}
{"category": "LocationDialogue Location14", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 199, "text": "// Continue"}
{"category": "LocationDialogue Location14", "line_index": 200, "text": "Ne dozvoli da te vidim kao još jednog roba stvarnosti..."}
{"category": "LocationDialogue Location14", "line_index": 201, "text": "Samo budi moj, istinski moj!"}
{"category": "LocationDialogue Location14", "line_index": 202, "text": "Ostani sa mnom."}
{"category": "LocationDialogue Location14", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 204, "text": "// Player look ring"}
{"category": "LocationDialogue Location14", "line_index": 205, "text": "Šta je ovo?"}
{"category": "LocationDialogue Location14", "line_index": 206, "text": "Najskorija verzija?"}
{"category": "LocationDialogue Location14", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 208, "text": "// Click on objects"}
{"category": "LocationDialogue Location14", "line_index": 209, "text": "// Bag"}
{"category": "LocationDialogue Location14", "line_index": 210, "text": "Zaista bi trebalo da odemo do radnje i kupimo neku opremu. Možda bismo mogli i da izbacimo smeće."}
{"category": "LocationDialogue Location14", "line_index": 211, "text": "// Bed"}
{"category": "LocationDialogue Location14", "line_index": 212, "text": "Mislim da sam sanjao, ali taj san... Ne mogu da se prisetim. Je l' ga uopšte i bilo?"}
{"category": "LocationDialogue Location14", "line_index": 213, "text": "// Window"}
{"category": "LocationDialogue Location14", "line_index": 214, "text": "Svet napolju je sav zelen i živopisan. Možda bih sledećeg vikenda mogao malo da prošetam."}
{"category": "LocationDialogue Location14", "line_index": 215, "text": "// Fan"}
{"category": "LocationDialogue Location14", "line_index": 216, "text": "Svako naredno leto je vrelije. Moram da nabavim klima uređaj. Više mi nećeš trebati, shvataš li to, ventilatoru?"}
