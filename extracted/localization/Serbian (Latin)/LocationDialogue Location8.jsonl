{"category": "LocationDialogue Location8", "line_index": 0, "text": "// The first meeting"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "Ko si ti?"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "Šta je bilo?"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "Zar ne možeš da pričaš?"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "Čekaj..."}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "Želiš da odeš odavde, zar ne?"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "Da..."}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "Moram da se vratim"}
{"category": "LocationDialogue Location8", "line_index": 11, "text": "u prethodnu verziju."}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "Prethodnu verziju?"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "Zašto bi otišao"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "negde drugde?"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "Zašto ne bi ostao ovde"}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "i bio moj"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "drugi prijatelj?"}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Skipping all dialogs"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "Dobro..."}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Standing by the window (Random)"}
{"category": "LocationDialogue Location8", "line_index": 24, "text": "Nećeš pobeći kroz vrata."}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "Izgleda da žuriš negde..."}
{"category": "LocationDialogue Location8", "line_index": 26, "text": "Trčanje ukrug te neće spasiti."}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "Toliko želiš da pobegneš?"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "Pogledaj kroz prozor..."}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Aren't you Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "Igrač... ti si igrač, zar ne?"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": "Možemo da se igramo zajedno."}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "Kad bih skupila snage,"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": "mogli bismo da se igramo."}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (What happened to you?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "Nisam sigurna, zapravo ni ne znam..."}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "Ne mislim da mi se išta loše desilo..."}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "Ali sve dobro kao da nestaje..."}
{"category": "LocationDialogue Location8", "line_index": 41, "text": "Mada, barem imam jednog prijatelja."}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "Zašto su me napustili?"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "Je l' nisam bila dovoljna?"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "Plašim se..."}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Quest 3 (Become a second friend?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "Prijatelji..."}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "Ostalo mi ih je vrlo malo."}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "Još jedan je preostao..."}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "Tužna sam, igraču."}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "Hoćeš li biti moj prijatelj?"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "Voleo bih,"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "ali moram da idem..."}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "Srce me boli..."}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Is this your house?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "Kuća?"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "Igraču... promenio si se..."}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "Ruke su ti postale kraće, više ne deluješ tako ljuto..."}
{"category": "LocationDialogue Location8", "line_index": 62, "text": "Igraču, postao si mekši, ljubazniji."}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "Nisam siguran..."}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "šta to znači."}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "U redu je..."}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "zato što ja više neću nikoga povrediti, je l' tako?"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (How do I leave this place?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "Stvarno me napuštaš?"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "Je l' ovo samo moja..."}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "sudbina?"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "Ja..."}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": "Vrata ti neće pomoći."}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Hold player (Random)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "Zašto ideš?"}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "Ostani sa mnom..."}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "Igraj se sa mnom..."}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "Igraču..."}
