{"category": "LocationDialogue Location6", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "Mita?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "Kako si dospeo ovde?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Ti si Mita, zar ne?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Ali si nešto drugačija..."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "Vidim, opažljiv si."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "I u pravu si."}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "Ja nisam Mita koju si pre upoznao."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Pazi se, ona smera nešto"}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "zlokobno."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "Ha, zlokobno?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "Nema vremena za objašnjavanje:"}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "ako ovo upali, sve ću ti objasniti."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Uzmi ključ. Pored sofe je."}
{"category": "LocationDialogue Location6", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Ali..."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "Sačuvaj svoja pitanja za kasnije!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Daj mi ključ."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Uzmi ovaj prsten."}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "Ha?"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Želiš da izađeš odavde, zar ne?"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "Pa, da..."}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Onda ga stavi."}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "To je koristan artifakt,"}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "verovatno će ti uskoro biti potreban."}
{"category": "LocationDialogue Location6", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "U redu..."}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "Uzgred, ja sam"}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Znam,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "Ja sam... Mita."}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// MitaKind quest 1"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "Vidiš tu"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "konzolu? Uzmi je."}
{"category": "LocationDialogue Location6", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "Je l' ovo neki snimak?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "Ko je ovo sa njom?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "To se upravo sada dešava."}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "To je još jedan igrač."}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Iskorišćava ga."}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Možda će pokušati"}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "da i njega pretvori u kasetu."}
{"category": "LocationDialogue Location6", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "Odmah moram da pobegnem odavde."}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "Ti, takođe."}
{"category": "LocationDialogue Location6", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "Tako je."}
{"category": "LocationDialogue Location6", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "Dakle, kažeš"}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "da ga iskorišćava."}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "Ako izvučem kasetu, šta će se desiti?"}
{"category": "LocationDialogue Location6", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "To bi verovatno"}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "nepovratno oštetilo kasetu."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "Što znači..."}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "da će igrač umreti."}
{"category": "LocationDialogue Location6", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "..."}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "A šta ako samo isključim konzolu?"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "To bi moglo da upali..."}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Vredi pokušati. Na konzoli imaš crveno dugme!"}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Vidiš li ga?"}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "Evo ga."}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "Pritisni ga."}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// MitaKind quest 2"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Ja moram da ostanem."}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "Postoje pitanja koja želim da je pitam"}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "kako bih otkrila više o njoj."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "Mada, čisto sumnjam da će mi odgovoriti..."}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// MitaKind quest 3"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "Ovo je, zapravo, moja verzija."}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "Bila sam sa svojim igračem,"}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "a onda se nešto desilo odjednom."}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "Onda se ona pojavila..."}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "i pretvorila igrača u kasetu,"}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "a mene zaključala ovde."}
{"category": "LocationDialogue Location6", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Pretvorila ga je u kasetu?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "Može to da uradi?"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "Ali zašto?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "Šta će joj igrači?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "Očigledno je da je luda..."}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Poigrava se sa nama i koristi nas za svoje mahinacije!"}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "Igrače pretvara u kasete..."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Neki nisu ni skontali šta im se dešava..."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "A neki koji jesu se nisu opirali..."}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "To je baš jezivo..."}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "Moraš da nam pomogneš!"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "Ja? Ali kako?"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "Trebaš mi!"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "Ako nam pomogneš, ja ću tebi pomoći!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Ovo je možda naša poslednja šansa."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "Prsten će te navoditi u pravu verziju."}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "Tamo ćemo se naći."}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// MitaKind quest 4"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "I dalje ne razumem u potpunosti"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "šta sam video gore..."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Ta Mita..."}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "Je l' pokušala da me ubije?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "Ubije?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Imala je na umu mnogo goru stvar od toga..."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "Moraš da požuriš."}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Hide!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "Prokletstvo! Sakrij se!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Ček, šta...?"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Požuri, dolazi!"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "Prati prsten—odvešće te na sigurno!"}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "E, sad, hoćeš li mi reći gde je?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "Zašto bih?"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "Nećeš li ga ubiti?"}
{"category": "LocationDialogue Location6", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Dakle, odbijaš da kažeš."}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "U redu, prihvatam izazov."}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "Znam da je negde ovde."}
{"category": "LocationDialogue Location6", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "Zašto si tako zla prema nama?"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "Nećeš ni da mi kažeš o čemu se radi!"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "Pored toga..."}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "šta će ti igrači?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "Oni nisu igračke!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "Šta je ušlo u tebe?!"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "Tišina. Drži jezik za zubima, draga."}
