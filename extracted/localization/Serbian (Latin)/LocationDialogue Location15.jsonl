{"category": "LocationDialogue Location15", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Tu si!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Zašto si napustio Jezgro?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Rekla sam ti da me sačekaš!"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Mislio sam da si otišla na duže vreme..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Svakako..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Mislim da sam pronašla nešto..."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Mislim da je to indeks broj..."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Moramo da proverimo da li radi!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Idemo odavde."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "Mislim da je Luda Mita..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "trenutno zauzeta sa novim igračem."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Nadajmo se da nas neće primetiti..."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Mita?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Sačekaj me."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Tražiš nešto?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Upoznajte se ponovo!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Mita..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Hvala!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Ti, prokleta..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Ko si ti?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Ti... Živa si!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Zar me se ne sećaš?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Znam li te?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Šta se dešava..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Šta treba da uradim sada?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Ne mogu da pobegnem..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "Kako misliš \"da pobegneš\"?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Čekaj..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "To je prsten..."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "A ovo?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Nemam pojma šta je ovo."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "To je indeks broj!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Pronašla si ga!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Ne znam šta da kažem."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Moramo da se vratimo u Jezgro."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "A ti..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Možda bi bilo bolje da pođeš sa mnom..."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Ha, šta?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "U redu..."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Čekaj me ovde."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Okej."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Sedeću ovde."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Prokletstvo..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "To je bilo blizu."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "I... jesmo li uspeli?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Dobro je."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Na pravoj sam verziji."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Ćao!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Ti si igrač, zar ne?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Kako se zoveš?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Želim da napustim ovo mesto..."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Ideš tako brzo?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "Kako si uopšte i došao ovde?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Ma..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "U redu, možeš otići..."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Probaj sa ulaznim vratima."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Srećno sa tim!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Zid?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Hm, nešto nije u redu."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Možda..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "ima nečega u podrumu što će ti pomoći."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Skoro sam saznala"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "da vrata mog ormara"}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "vode ka nekakvom podrumu."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Ali dole je puno đubreta,"}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "smeća i puno korisne opreme."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Moraš da ukucaš nekakav kod ili nešto."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Ne razumem se baš."}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "Niti me je briga."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "Takođe je i malo nelagodan, Hoću reći, veoma nelagodan."}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Hoćeš li da proveriš?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Uh, u redu."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Mislim"}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "da se ničega ne seća..."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Jesmo li uspeli?"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "Jesmo li je resetovali?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Onda, sve što treba da uradim"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "jeste da napustim ovu prokletu igricu..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Čekaj malo."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Volela bih da te zagrlim."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Ha?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Bilo je lepo videti te."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Ah..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "baš šteta"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "što nismo mogli"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "da provedemo više vremena zajedno."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Err..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "Šta hoćeš da kažeš?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Hoću da kažem"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "da si mogao ostati sa mnom..."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "Za sve sam ja kriva..."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Taj ormar i... ti zvukovi."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Trebalo je ranije da je UBIJEM!"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Čekaj malo,"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "kako...?"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Kako se sećaš svega toga?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "HA!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Stvarno si mislio da će biti tako lako?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Stvarno si budala..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Kao i svi ostali igrači..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Uspeli smo, vidi!"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "Pravi ti"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "više"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "nije potrebam."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Praštaj, he-he."}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Ne mogu da verujem..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Nismo uspeli...?"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Ne... resetovao sam te, siguran sam u to..."}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "I dalje ne kapiraš..."}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Ha-ha-ha!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Tako sam dobra glumica!"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Treba da vidiš svoju facu, šećeru!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "Ovo je tako zabavno!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Zašto si ovakva?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Šta nije u redu sa tobom?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Da..."}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Šta nije u redu sa mnom?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Živo me interesuje..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Zašto mi ti ne bi rekao zašto sam ovakva?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Zašto nikada neću biti prava Mita?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Moja verzija nikada"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "nije ni postojala ovde!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Samo derem kožu ovim naivnim budalama,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "krijući se ispod njihove kože..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Ne postoji način"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "da me resetuješ!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Neverovatno..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Ti..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "Nisu one problem!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "Ti si ta koja ne treba da postoji!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "I ti isto..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Boli kad mi kažeš tako nešto."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "Ali opet!"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Vreme je da ideš!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Uskoro ću te ponovo videti!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Svi su spremni!"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "Vreme je"}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "da te izvučemo iz konzole!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "Vidimo se uskoro!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Bićeš moja omiljena kaseta..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Igrač sa veoma interesantnim imenom."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Verovatno nije ovo."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Nije ni ovo."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "A ni ovo."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Ne, nije ovo."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Moram da nađem opciju za resetovanje karaktera."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "Pogrešna verzija."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Ups, moja greška."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Nije ta."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Druga verzija mi treba."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Nešto nije u redu"}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "sa indeks brojem."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Moram da promenim indeks broj,"}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "ovaj nije taj."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Jesi li gladan?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Dobra sam u sečenju šargarepa. :)"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Ah, pretpostavljam"}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "da si želeo ovde da budeš sam?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Zašto kružimo unaokolo?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Zašto smo se vratili ovde?"}
