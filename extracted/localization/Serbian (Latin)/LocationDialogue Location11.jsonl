{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Pozdrav!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Ups!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Praštaj,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "zamalo te ubih."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "Frižider, to jest... frižider te je zamalo ubio."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Nisam ja ništa kriva,"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "Kunem se!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Majke mi!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Aha, verujem ti!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Ali ozbiljno,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "ovo mesto je opasno..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "pogotovo za tebe."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "Izgleda da uopšte nisi kukavica!"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Gledajući te"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "kako prolaziš"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "ova mesta je zabavno..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Beži, slatkišu, beži!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "Stići ći te!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Bravo, dečko!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Vau, ovo je zabavno!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Videla da ideš ka žičari."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "To je najduži put"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "između verzija..."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Pitam se kako ćeš se snaći"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "sa onima koji žive tu"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "u toj magli."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Šta misliš da radiš?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Molim te..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Ne gledaj!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Budalo!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Blesavko..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Oh, dobro..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Srećno!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Ko je to?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Mogu da te osetim..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Slušaj me,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "ti si igrač,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "zar ne?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Pomozi mi da pronađem..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "da pronađem..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "Čekaj da razmislim..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "um mi je zamućen..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Šta se za ime sveta dešava ovde?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Želela sam jednom sve da zaboravim..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Slomila sam svako ogledalo,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "pocepala sve fotografije..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "ali sada..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "sada žalim što sam to uradila."}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "Koliko sam samo bila glupa..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Svako pravi greške, da..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Ali šta radiš"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "kad su posledice katastrofalne?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Volela bih da mogu da vratim vreme..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Kažu da vreme rane leči..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Ali šta je vreme?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Više ni u šta ne verujem..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Ali ako vreme može da leči,"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "ili makar da me odvede,"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "daleko od ovog sveta..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "Onda te molim,"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "ubrzaj vreme."}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "I nek me ono konačno ubije,"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "jednom za svagda."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Ona je voljena..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Jesam li i ja volela, ikada?"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Ali moja ljubav je drugačija;"}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "njena ljubav je živopisna,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "vredna prezira..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "vatrena..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "nemilosrdna..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "zavidna..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "besna..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "luda..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Zvali su me osećajnom..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "\"Previše brineš, Mita\"..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "\"Proći ćeš kroz ovo, Mita\"..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "\"Nisi sama, Mita\"..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "To su mi pričali. I šta je ostalo?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Tuga,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "očajanje..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "i strah."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Beskosirna sam..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Ne mogu se setiti..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "ičega..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Samo beskrajni odjeci u glavi..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Ne mogu podneti činjenicu"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "da sam zarobljena ovde..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Oduvek sam bila ovde,"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "ali zašto?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Ne mogu da se setim..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Hoće li ikad prestati?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Ne znam..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Ovo je..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "crtež..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Sada se sećam,"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "hvala ti..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Ali, moje lice..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "Nemam svoje lice..."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "ONA je kriva."}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Uzela je deo mene..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "i bacila ga..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Snažna je..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "i pametna."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Nemam prava da te zaustavim, igraču."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Pogledaj u ormar..."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Hej!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Na putu si mi!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Samo ćeš stojati tu?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Samo mi se skloni sa puta!"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Pusti me da prođem!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Samo zato što si veliki, ne znači da si svemoćan!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Zašto me pratiš?!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Gubi se!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - radio voice"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Čekaj malo... Igraču?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "Šta ti radiš ovde?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Ko je to?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Još jedan igrač."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Ja sam Mitafon."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Ja kontrolišem žičaru."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Shvataš li"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "da si se uputio u svoju propast?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Možda,"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "Ali to mi je jedini put."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "U pravu si."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Pritisni dugme i sedi za top."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "Top?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Aha."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Mislio si da ćeš da kruziraš žičarom?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Moraš da uništiš čudovišta u ovoj mini-igri,"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "tako da se pripremi."}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "U redu, vreme je da krenemo."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Neverovatno!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Uspeo si."}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Hej, beži odavde."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Lepo i brzo!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Zašto si i dalje ovde?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Rekla sam ti da bežiš odavde."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Ne shvatam..."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "zašto samo stojiš tu?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Šta? Konzola?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Čoveče..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Ćao."}
