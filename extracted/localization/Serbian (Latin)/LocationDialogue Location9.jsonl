{"category": "LocationDialogue Location9", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Hej, ti!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Zdravo!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Želiš da odeš odavde?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Onda mi pomogni da pronađem ključ!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Pih! Nije tu!"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Nije ni ovde—"}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "Nije ni tu!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Eto ga!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// The usual conversation"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Mislila sam da si niži!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "Visok si—"}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "baš kao i moja sestra!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "Tvoja sestra? Šta sa njom?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Da, moja sestra."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Nemoj mi reći da je ne znaš!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Uh... upoznao sam je... valjda?"}
{"category": "LocationDialogue Location9", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Jesi ti budala?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "Izgleda da jesi..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "Hajde, pomogni mi da nađem ključ već jednom!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// Next work"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Dođi."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Istovari gvožđe u cev!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Hvala!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "Dodaj mi ovo drvo!"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Hvala!"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Još malo pomoći, molim!"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Gotovo! Sad..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "Vau, prelepo."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Pritisni dugme, hajde!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Pripremi se..."}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "Eto ga, uzmi ga!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "Ključ je tvoj!"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// Quest 1 (Are you Mita?)"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Ja sam ChibiMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Gomila linija kodova,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "najjednostavniji model i—"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "nešto najbolje—prelepa kosa!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// Quest 2 (Have we seen each other yet?)"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Blesavko!"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "Sladak si, znaš,"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "pitaš me tako blesava pitanja."}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Doduše,"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "prvi put te vidim!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Ali slušaj..."}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Ako ukradeš moj prelepi izgled,"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "zažalićeš!"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// Quest 3 (Why are you here?)"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "I dalje ne kapiraš?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "Ovo je čekpoint—"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "test tvoje pameti!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "Hajde sada!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Ovde sam da navodim beznadežno izgubljene!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// Quest 4 (Why are you helping me?)"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "Šta te čini posebnim?"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "Zašto ti ne bih pomogla?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "Šta?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Budalo..."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Došao si niotkuda!"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Ne bi trebalo da budeš ovde,"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "zato ti i pomažem!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Ćao, blesavko!"}
