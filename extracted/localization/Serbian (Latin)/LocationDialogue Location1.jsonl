{"category": "LocationDialogue Location1", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 1, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 9, "text": "Ćao, ja sam Mita!"}
{"category": "LocationDialogue Location1", "line_index": 10, "text": "Kako se ti zoveš?"}
{"category": "LocationDialogue Location1", "line_index": 11, "text": "Drago mi je, [player]!"}
{"category": "LocationDialogue Location1", "line_index": 12, "text": "Hej... [player],"}
{"category": "LocationDialogue Location1", "line_index": 13, "text": "Bila sam u žurbi i nisam stigla pa pospremim..."}
{"category": "LocationDialogue Location1", "line_index": 14, "text": "Možeš li mi pomoći?"}
{"category": "LocationDialogue Location1", "line_index": 15, "text": "Uh.."}
{"category": "LocationDialogue Location1", "line_index": 16, "text": "Puno ti hvala!"}
{"category": "LocationDialogue Location1", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 18, "text": "[Player], krče mi creva..."}
{"category": "LocationDialogue Location1", "line_index": 19, "text": "Veoma sam gladna..."}
{"category": "LocationDialogue Location1", "line_index": 20, "text": "Možeš li mi pomoći da nabavim sastojke za supu?"}
{"category": "LocationDialogue Location1", "line_index": 21, "text": "Jej! To je sve što mi treba!"}
{"category": "LocationDialogue Location1", "line_index": 22, "text": "Hoćemo zajedno da je spremimo?"}
{"category": "LocationDialogue Location1", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 25, "text": "Razmišljala sam da danas kupim prenosni televizor—"}
{"category": "LocationDialogue Location1", "line_index": 26, "text": "mali televizor sa antenom. Idealan za šetnje, slažeš li se?"}
{"category": "LocationDialogue Location1", "line_index": 27, "text": "Usput, možeš da igraš igre kako bi zaradio novac."}
{"category": "LocationDialogue Location1", "line_index": 28, "text": "Oh! Jesi li znao da možeš zaraditi novac igrajući igre?"}
{"category": "LocationDialogue Location1", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 30, "text": "Jej! Uspeo si! Sada imaš dovoljno da mi kupiš prenosni televizor!"}
{"category": "LocationDialogue Location1", "line_index": 31, "text": "Upravo taj! Mali, prenosiv i jeftin—baš kakvog želim."}
{"category": "LocationDialogue Location1", "line_index": 32, "text": "Hvala ti!"}
{"category": "LocationDialogue Location1", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 34, "text": "Ćao, [player]! Baš si mi od pomoći, iskreno."}
{"category": "LocationDialogue Location1", "line_index": 35, "text": "Ali... onaj televizor? Bio je kul, ali se već pokvario."}
{"category": "LocationDialogue Location1", "line_index": 36, "text": "Kakogod, možeš li mi pomoći da pomerim ovaj ormar?"}
{"category": "LocationDialogue Location1", "line_index": 37, "text": "Mnogo je težak... >.<"}
{"category": "LocationDialogue Location1", "line_index": 38, "text": "Hvala ti, dragi! <3"}
{"category": "LocationDialogue Location1", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 40, "text": "Oh, [player]! Prošao je samo jedan dan, ali već si mi puno nedostajao!"}
{"category": "LocationDialogue Location1", "line_index": 41, "text": "Volela bih da možeš češće da me posećuješ."}
{"category": "LocationDialogue Location1", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 43, "text": "Je l' ovo za mene?"}
{"category": "LocationDialogue Location1", "line_index": 44, "text": "Hvala ti puno, puno!"}
{"category": "LocationDialogue Location1", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 46, "text": "Hej, [player]! Razmišljala sam..."}
{"category": "LocationDialogue Location1", "line_index": 47, "text": "Želela bih da možemo da se upoznamo uživo."}
{"category": "LocationDialogue Location1", "line_index": 48, "text": "Frustrirajuće je što to ne možemo."}
{"category": "LocationDialogue Location1", "line_index": 49, "text": "Uvek mi pomažeš, svakog dana si dobar prema meni..."}
{"category": "LocationDialogue Location1", "line_index": 50, "text": "Želim da mogu i ja nešto za tebe da učinim."}
{"category": "LocationDialogue Location1", "line_index": 51, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 52, "text": "Oh, imam ideju!"}
{"category": "LocationDialogue Location1", "line_index": 53, "text": "Sada smo zajedno."}
{"category": "LocationDialogue Location1", "line_index": 54, "text": "Sada spusti telefon."}
{"category": "LocationDialogue Location1", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 57, "text": "// T-shirt on the bed"}
{"category": "LocationDialogue Location1", "line_index": 58, "text": "Šta će ovo ovde?"}
{"category": "LocationDialogue Location1", "line_index": 59, "text": "// Rubik's Cube"}
{"category": "LocationDialogue Location1", "line_index": 60, "text": "Pa, nije kao da mi je bila od koristi..."}
{"category": "LocationDialogue Location1", "line_index": 61, "text": "Rešio sam je jednom i više je nisam ni pipnuo."}
{"category": "LocationDialogue Location1", "line_index": 62, "text": "Možda sam shvatio da neću uspeti da je rešim ponovo?"}
{"category": "LocationDialogue Location1", "line_index": 63, "text": "// Computer"}
{"category": "LocationDialogue Location1", "line_index": 64, "text": "Da vidimo..."}
{"category": "LocationDialogue Location1", "line_index": 65, "text": "Da napravim listu zadataka..."}
{"category": "LocationDialogue Location1", "line_index": 66, "text": "Da skriptujem reakcije karaktera,"}
{"category": "LocationDialogue Location1", "line_index": 67, "text": "I možda da malo programiram."}
{"category": "LocationDialogue Location1", "line_index": 68, "text": "// The airplane"}
{"category": "LocationDialogue Location1", "line_index": 69, "text": "Stvoren je za let!"}
{"category": "LocationDialogue Location1", "line_index": 70, "text": "// Trash in the corner"}
{"category": "LocationDialogue Location1", "line_index": 71, "text": "Uf, nikad nemam vremena da izbacim smeće..."}
{"category": "LocationDialogue Location1", "line_index": 72, "text": "Ali uradiću to sad, stvarno!"}
{"category": "LocationDialogue Location1", "line_index": 73, "text": "Nego, kad je beše dan za čišćenje?"}
{"category": "LocationDialogue Location1", "line_index": 74, "text": "// Photo of a cat on a watermelon"}
{"category": "LocationDialogue Location1", "line_index": 75, "text": "Ona je bila najbolja…"}
{"category": "LocationDialogue Location1", "line_index": 76, "text": "Mačka koja se izležava na lubenici."}
{"category": "LocationDialogue Location1", "line_index": 77, "text": "// Photo with a girl"}
{"category": "LocationDialogue Location1", "line_index": 78, "text": "Moja sestra i ja"}
{"category": "LocationDialogue Location1", "line_index": 79, "text": "uopšte ne ličimo."}
{"category": "LocationDialogue Location1", "line_index": 80, "text": "Ona non-stop izlazi,"}
{"category": "LocationDialogue Location1", "line_index": 81, "text": "dok ja sve vreme čamim u kući."}
{"category": "LocationDialogue Location1", "line_index": 82, "text": "// Photo with people"}
{"category": "LocationDialogue Location1", "line_index": 83, "text": "Hm..."}
{"category": "LocationDialogue Location1", "line_index": 84, "text": "Kancelarijski život nam je zaista usadio"}
{"category": "LocationDialogue Location1", "line_index": 85, "text": "svoje manire, zar ne?"}
{"category": "LocationDialogue Location1", "line_index": 86, "text": "I dalje osećam neku čudnu povezanost."}
{"category": "LocationDialogue Location1", "line_index": 87, "text": "Ali"}
{"category": "LocationDialogue Location1", "line_index": 88, "text": "hoću li ih ikada"}
{"category": "LocationDialogue Location1", "line_index": 89, "text": "videti još jednom?"}
{"category": "LocationDialogue Location1", "line_index": 90, "text": "Čekaj, što sam uopšte i okačio ovu sliku na zid?"}
{"category": "LocationDialogue Location1", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 93, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 99, "text": "// Nope name"}
{"category": "LocationDialogue Location1", "line_index": 100, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 101, "text": "Oh, ne."}
{"category": "LocationDialogue Location1", "line_index": 102, "text": "Oh ne, tako nećemo moći."}
{"category": "LocationDialogue Location1", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 104, "text": "// Name Developer"}
{"category": "LocationDialogue Location1", "line_index": 105, "text": "Jesi li siguran da želiš da iskoristiš ime developera?"}
{"category": "LocationDialogue Location1", "line_index": 106, "text": "Meni se sviđa, ali..."}
{"category": "LocationDialogue Location1", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 108, "text": "// Bad name"}
{"category": "LocationDialogue Location1", "line_index": 109, "text": "Cenila bih ako ne bi koristio takvo ime."}
{"category": "LocationDialogue Location1", "line_index": 110, "text": "Uopšte ne zvuči lepo."}
{"category": "LocationDialogue Location1", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 112, "text": "// Go restart"}
{"category": "LocationDialogue Location1", "line_index": 113, "text": "Ne, ne radi se to tako. Hajmo ispočetka."}
{"category": "LocationDialogue Location1", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 115, "text": "// Name with numbers"}
{"category": "LocationDialogue Location1", "line_index": 116, "text": "Oh, koristićeš brojeve? Gde je tu kreativnost?"}
{"category": "LocationDialogue Location1", "line_index": 117, "text": "Kakogod, tvoj izbor!"}
{"category": "LocationDialogue Location1", "line_index": 118, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 119, "text": "// Name Mita"}
{"category": "LocationDialogue Location1", "line_index": 120, "text": "Mita?"}
{"category": "LocationDialogue Location1", "line_index": 121, "text": "Zaista hoćeš da koristiš moje ime?"}
{"category": "LocationDialogue Location1", "line_index": 122, "text": "Ili... je to zaista tvoje ime?"}
{"category": "LocationDialogue Location1", "line_index": 123, "text": "Bez uvrede, ali volela bih da budem jedina Mita ovde ♪"}
{"category": "LocationDialogue Location1", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 125, "text": "// Day 10"}
{"category": "LocationDialogue Location1", "line_index": 126, "text": "Oh, vratio si se!"}
{"category": "LocationDialogue Location1", "line_index": 127, "text": "Hej, izgubila sam četku za kosu…"}
{"category": "LocationDialogue Location1", "line_index": 128, "text": "Možeš li mi pomoći da je nađem?"}
{"category": "LocationDialogue Location1", "line_index": 129, "text": "Prvo proveri stočić pored kreveta—mislim da sam je tu ostavila."}
{"category": "LocationDialogue Location1", "line_index": 130, "text": "// Looked in the bedside table"}
{"category": "LocationDialogue Location1", "line_index": 131, "text": "Hm, nije tu..."}
{"category": "LocationDialogue Location1", "line_index": 132, "text": "Možda je negde drugde?"}
{"category": "LocationDialogue Location1", "line_index": 133, "text": "Samo nemoj da gledaš u rerni, važi?"}
{"category": "LocationDialogue Location1", "line_index": 134, "text": "Već sam proverila tu."}
{"category": "LocationDialogue Location1", "line_index": 135, "text": "// Looked into the stove"}
{"category": "LocationDialogue Location1", "line_index": 136, "text": "Hej! Rekla sam ti da ne gledaš tu!"}
{"category": "LocationDialogue Location1", "line_index": 137, "text": "Okreni se—počistiću ovo!"}
{"category": "LocationDialogue Location1", "line_index": 138, "text": "...Evo ga, gotovo. Pogledajmo negde drugde."}
{"category": "LocationDialogue Location1", "line_index": 139, "text": "Oh, i, ovaj... zaboravi šta si upravo video, u redu?"}
{"category": "LocationDialogue Location1", "line_index": 140, "text": "// Found a hairbrush"}
{"category": "LocationDialogue Location1", "line_index": 141, "text": "Pronašao si je! Dobar posao!"}
{"category": "LocationDialogue Location1", "line_index": 142, "text": "Šta ćemo dalje da radimo?"}
