{"category": "LocationDialogue Location3", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 1, "text": "Ćao, [player]!"}
{"category": "LocationDialogue Location3", "line_index": 2, "text": "Konačno se srećemo!"}
{"category": "LocationDialogue Location3", "line_index": 3, "text": "Tako sam uzbuđena!"}
{"category": "LocationDialogue Location3", "line_index": 4, "text": "Znam da imaš puno pitanja..."}
{"category": "LocationDialogue Location3", "line_index": 5, "text": "Pa, kao što vidiš,"}
{"category": "LocationDialogue Location3", "line_index": 6, "text": "napravila sam ovu posebnu mašinu"}
{"category": "LocationDialogue Location3", "line_index": 7, "text": "kako bih te dovela ovde kod mene."}
{"category": "LocationDialogue Location3", "line_index": 8, "text": "Ali si završio u pogrešnoj verziji..."}
{"category": "LocationDialogue Location3", "line_index": 9, "text": "u kojoj sam..."}
{"category": "LocationDialogue Location3", "line_index": 10, "text": "Ma, duga priča!"}
{"category": "LocationDialogue Location3", "line_index": 11, "text": "Bilo kako bilo, samo sam srećna što te vidim!"}
{"category": "LocationDialogue Location3", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 13, "text": "// Answer 1 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 14, "text": "Aha."}
{"category": "LocationDialogue Location3", "line_index": 15, "text": "A ti mora da si [player], je l' tako?"}
{"category": "LocationDialogue Location3", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 17, "text": "// Answer 2 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 18, "text": "Već želiš da se vratiš?"}
{"category": "LocationDialogue Location3", "line_index": 19, "text": "Valjda ti mogu pomoći sa tim... Ali šta je sa mnom?"}
{"category": "LocationDialogue Location3", "line_index": 20, "text": "Ostani još malo, molim te..."}
{"category": "LocationDialogue Location3", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 22, "text": "// Answer 3 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 23, "text": "Daj da ti objasnim..."}
{"category": "LocationDialogue Location3", "line_index": 24, "text": "I tako si ti tu!"}
{"category": "LocationDialogue Location3", "line_index": 25, "text": "Kapiraš?"}
{"category": "LocationDialogue Location3", "line_index": 26, "text": "Uf... ne baš."}
{"category": "LocationDialogue Location3", "line_index": 27, "text": "Nema veze!"}
{"category": "LocationDialogue Location3", "line_index": 28, "text": "Bitno je da smo sada zajedno."}
{"category": "LocationDialogue Location3", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 31, "text": "Jesi li gladan?"}
{"category": "LocationDialogue Location3", "line_index": 32, "text": "Hoćeš da spremimo nešto?"}
{"category": "LocationDialogue Location3", "line_index": 33, "text": "Hajde,"}
{"category": "LocationDialogue Location3", "line_index": 34, "text": "iseci šargarepe."}
{"category": "LocationDialogue Location3", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 36, "text": "Odakle se ovo povrće stvorilo ovde?"}
{"category": "LocationDialogue Location3", "line_index": 37, "text": "Do pre sekund ga nije bilo."}
{"category": "LocationDialogue Location3", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 39, "text": "[player], ovo je igra."}
{"category": "LocationDialogue Location3", "line_index": 40, "text": "Hajde, pomozi mi."}
{"category": "LocationDialogue Location3", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 42, "text": "Hvala ti!"}
{"category": "LocationDialogue Location3", "line_index": 43, "text": "Možeš li mi doneti makaze?"}
{"category": "LocationDialogue Location3", "line_index": 44, "text": "U kupatilu su."}
{"category": "LocationDialogue Location3", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 46, "text": "Hajde, sedi."}
{"category": "LocationDialogue Location3", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 49, "text": "// Kitchen"}
{"category": "LocationDialogue Location3", "line_index": 50, "text": "Hoćeš li malo sosa?"}
{"category": "LocationDialogue Location3", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 52, "text": "Ne hvala."}
{"category": "LocationDialogue Location3", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 54, "text": "Šteta."}
{"category": "LocationDialogue Location3", "line_index": 55, "text": "Sos zaista daje na ukusu!"}
{"category": "LocationDialogue Location3", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 58, "text": "Gotovo."}
{"category": "LocationDialogue Location3", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 60, "text": "Već si gotov?"}
{"category": "LocationDialogue Location3", "line_index": 61, "text": "Moja porcija kao da je"}
{"category": "LocationDialogue Location3", "line_index": 62, "text": "beskonačna..."}
{"category": "LocationDialogue Location3", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 65, "text": "// Help"}
{"category": "LocationDialogue Location3", "line_index": 66, "text": "Šta je bilo?"}
{"category": "LocationDialogue Location3", "line_index": 67, "text": "Reci mi šta vidiš i osećaš."}
{"category": "LocationDialogue Location3", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 69, "text": "Srce mi lupa jako"}
{"category": "LocationDialogue Location3", "line_index": 70, "text": "i zamućen mi je vid."}
{"category": "LocationDialogue Location3", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 72, "text": "U redu."}
{"category": "LocationDialogue Location3", "line_index": 73, "text": "Mislim da znam šta je u pitanju."}
{"category": "LocationDialogue Location3", "line_index": 74, "text": "Možeš li da ustaneš?"}
{"category": "LocationDialogue Location3", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 78, "text": "Šta je ovo?"}
{"category": "LocationDialogue Location3", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 80, "text": "Tablete."}
{"category": "LocationDialogue Location3", "line_index": 81, "text": "Od njih će ti biti bolje."}
{"category": "LocationDialogue Location3", "line_index": 82, "text": "Stani ispred ogledala."}
{"category": "LocationDialogue Location3", "line_index": 83, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 84, "text": "Uzmi ih."}
{"category": "LocationDialogue Location3", "line_index": 85, "text": "Hajde."}
{"category": "LocationDialogue Location3", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 89, "text": "Kako se osećaš?"}
{"category": "LocationDialogue Location3", "line_index": 90, "text": "Je l' ti bolje?"}
{"category": "LocationDialogue Location3", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 92, "text": "Jeste."}
{"category": "LocationDialogue Location3", "line_index": 93, "text": "Baš brzo deluje..."}
{"category": "LocationDialogue Location3", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 95, "text": "[player], u igri smo."}
{"category": "LocationDialogue Location3", "line_index": 96, "text": "Ovde su stvari dosta pojednostavljene."}
{"category": "LocationDialogue Location3", "line_index": 97, "text": "Ovde i najmanji trud"}
{"category": "LocationDialogue Location3", "line_index": 98, "text": "daje velike rezultate."}
{"category": "LocationDialogue Location3", "line_index": 99, "text": "Sve je deo koncepta igre:"}
{"category": "LocationDialogue Location3", "line_index": 100, "text": "Pojednostavljenje."}
{"category": "LocationDialogue Location3", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 102, "text": "Može li neki primer?"}
{"category": "LocationDialogue Location3", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 104, "text": "Eno one šargarepe od malopre."}
{"category": "LocationDialogue Location3", "line_index": 105, "text": "Isekao si jednu,"}
{"category": "LocationDialogue Location3", "line_index": 106, "text": "ali kao da si isekao tri."}
{"category": "LocationDialogue Location3", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 108, "text": "Vidi, ovo mi je sve iznenada."}
{"category": "LocationDialogue Location3", "line_index": 109, "text": "Poprilično se plašim."}
{"category": "LocationDialogue Location3", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 112, "text": "Šta je bilo?"}
{"category": "LocationDialogue Location3", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 114, "text": "Našao sam kasete u ventilacionom otvoru."}
{"category": "LocationDialogue Location3", "line_index": 115, "text": "Imale su neka imena na sebi."}
{"category": "LocationDialogue Location3", "line_index": 116, "text": "Šta je ono?"}
{"category": "LocationDialogue Location3", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 118, "text": "Patrone?"}
{"category": "LocationDialogue Location3", "line_index": 119, "text": "Kakve kasete?"}
{"category": "LocationDialogue Location3", "line_index": 120, "text": "Videćemo zajedno."}
{"category": "LocationDialogue Location3", "line_index": 121, "text": "Ali malo kasnije."}
{"category": "LocationDialogue Location3", "line_index": 122, "text": "Hajde prvo da jedemo."}
{"category": "LocationDialogue Location3", "line_index": 123, "text": "Dodaj mi makaze, molim te."}
{"category": "LocationDialogue Location3", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 125, "text": "// Ring"}
{"category": "LocationDialogue Location3", "line_index": 126, "text": "Prsten?"}
{"category": "LocationDialogue Location3", "line_index": 127, "text": "// Mirror"}
{"category": "LocationDialogue Location3", "line_index": 128, "text": "Zašto nema odraza u ogledalu?"}
{"category": "LocationDialogue Location3", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 130, "text": "Oh, tako je!"}
{"category": "LocationDialogue Location3", "line_index": 131, "text": "Zaboravila sam da ih uključim."}
{"category": "LocationDialogue Location3", "line_index": 132, "text": "Eto ga."}
{"category": "LocationDialogue Location3", "line_index": 133, "text": "Sada imaš odraze!"}
{"category": "LocationDialogue Location3", "line_index": 134, "text": "Inače,"}
{"category": "LocationDialogue Location3", "line_index": 135, "text": "do skoro nisam ni znala šta su odrazi."}
{"category": "LocationDialogue Location3", "line_index": 136, "text": "Nisu postojali u mom svetu—"}
{"category": "LocationDialogue Location3", "line_index": 137, "text": "makar ne do jednog ažuriranja. :)"}
{"category": "LocationDialogue Location3", "line_index": 138, "text": "Ima li dosta odraza"}
{"category": "LocationDialogue Location3", "line_index": 139, "text": "u tvom svetu?"}
{"category": "LocationDialogue Location3", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 141, "text": "Naravno."}
{"category": "LocationDialogue Location3", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 144, "text": "Sećaš li se"}
{"category": "LocationDialogue Location3", "line_index": 145, "text": "tri predmeta koje si pronašao?"}
{"category": "LocationDialogue Location3", "line_index": 146, "text": "One koje si stavio na skener?"}
{"category": "LocationDialogue Location3", "line_index": 147, "text": "Pa..."}
{"category": "LocationDialogue Location3", "line_index": 148, "text": "Ti predmeti"}
{"category": "LocationDialogue Location3", "line_index": 149, "text": "su povezani sa ovom verzijom sveta."}
{"category": "LocationDialogue Location3", "line_index": 150, "text": "Zbog toga si sada ovde."}
{"category": "LocationDialogue Location3", "line_index": 151, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 152, "text": "// Movbile TV"}
{"category": "LocationDialogue Location3", "line_index": 153, "text": "Ovo je prenosni televizor"}
{"category": "LocationDialogue Location3", "line_index": 154, "text": "koji sam ti kupio."}
{"category": "LocationDialogue Location3", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 156, "text": "Aha!"}
{"category": "LocationDialogue Location3", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 158, "text": "Zar mi nisi rekla"}
{"category": "LocationDialogue Location3", "line_index": 159, "text": "da je pokvaren?"}
{"category": "LocationDialogue Location3", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 161, "text": "Pa, želela sam"}
{"category": "LocationDialogue Location3", "line_index": 162, "text": "da te iznenadim!"}
{"category": "LocationDialogue Location3", "line_index": 163, "text": "Malo sam te slagala"}
{"category": "LocationDialogue Location3", "line_index": 164, "text": "da te dovedem ovde, u moj svet."}
{"category": "LocationDialogue Location3", "line_index": 165, "text": "Sada radi—prikazuje informacije!"}
{"category": "LocationDialogue Location3", "line_index": 166, "text": "Oh, i usput…"}
{"category": "LocationDialogue Location3", "line_index": 167, "text": "Nisam loš inženjer!"}
{"category": "LocationDialogue Location3", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 169, "text": "// School cloth"}
{"category": "LocationDialogue Location3", "line_index": 170, "text": "Šta je ovo?"}
{"category": "LocationDialogue Location3", "line_index": 171, "text": "Školska uniforma?"}
{"category": "LocationDialogue Location3", "line_index": 172, "text": "Šta će ti ovo?"}
{"category": "LocationDialogue Location3", "line_index": 173, "text": "Stvarno ideš u školu?"}
{"category": "LocationDialogue Location3", "line_index": 174, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 175, "text": "U školu?"}
{"category": "LocationDialogue Location3", "line_index": 176, "text": "Ne idem, naravno."}
{"category": "LocationDialogue Location3", "line_index": 177, "text": "Ali mi se sviđa uniforma."}
{"category": "LocationDialogue Location3", "line_index": 178, "text": "Zar ne misliš da izgledam slatko"}
{"category": "LocationDialogue Location3", "line_index": 179, "text": "u njoj?"}
{"category": "LocationDialogue Location3", "line_index": 180, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 181, "text": "// PC"}
{"category": "LocationDialogue Location3", "line_index": 182, "text": "Radi li ovaj kompjuter?"}
{"category": "LocationDialogue Location3", "line_index": 183, "text": "Ili služi samo kao ukras?"}
{"category": "LocationDialogue Location3", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 185, "text": "Naravno da radi."}
{"category": "LocationDialogue Location3", "line_index": 186, "text": "Sve ovde"}
{"category": "LocationDialogue Location3", "line_index": 187, "text": "radi potpuno identično kao u tvom svetu."}
{"category": "LocationDialogue Location3", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 189, "text": "U mom svetu,"}
{"category": "LocationDialogue Location3", "line_index": 190, "text": "baš dugo sedim ispred ekrana..."}
{"category": "LocationDialogue Location3", "line_index": 191, "text": "i naporno radim."}
{"category": "LocationDialogue Location3", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 193, "text": "Znam."}
{"category": "LocationDialogue Location3", "line_index": 194, "text": "Zbog tog posla"}
{"category": "LocationDialogue Location3", "line_index": 195, "text": "mi nisi pridavao"}
{"category": "LocationDialogue Location3", "line_index": 196, "text": "previše pažnje."}
{"category": "LocationDialogue Location3", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 198, "text": "Od nečeg mora da se živi."}
{"category": "LocationDialogue Location3", "line_index": 199, "text": "Nego... otkud ti znaš da sedim dugo ispred ekrana?"}
{"category": "LocationDialogue Location3", "line_index": 200, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 201, "text": "Kamera na telefonu ti je... ponekad upaljena."}
{"category": "LocationDialogue Location3", "line_index": 202, "text": "Izvini."}
{"category": "LocationDialogue Location3", "line_index": 203, "text": "Krišom sam te posmatrala >A<"}
{"category": "LocationDialogue Location3", "line_index": 204, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 205, "text": "Hm... to nije baš lepo."}
{"category": "LocationDialogue Location3", "line_index": 206, "text": "Ma, nebitno."}
{"category": "LocationDialogue Location3", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 208, "text": "// Umbrella"}
{"category": "LocationDialogue Location3", "line_index": 209, "text": "Dugo sam igrao ovu igru,"}
{"category": "LocationDialogue Location3", "line_index": 210, "text": "ali nikad nisam video da pada kiša."}
{"category": "LocationDialogue Location3", "line_index": 211, "text": "Šta će ti kišobran?"}
{"category": "LocationDialogue Location3", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 213, "text": "Pada kiša—ali retko."}
{"category": "LocationDialogue Location3", "line_index": 214, "text": "Samo još uvek nisi video."}
{"category": "LocationDialogue Location3", "line_index": 215, "text": "Možda ćeš videti jednog dana."}
{"category": "LocationDialogue Location3", "line_index": 216, "text": "I tada će ti trebati kišobran."}
{"category": "LocationDialogue Location3", "line_index": 217, "text": "Zar ne?"}
{"category": "LocationDialogue Location3", "line_index": 218, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 219, "text": "// Electrical panel"}
{"category": "LocationDialogue Location3", "line_index": 220, "text": "Šta će ti razvodna kutija?"}
{"category": "LocationDialogue Location3", "line_index": 221, "text": "Ako smo već u igri,"}
{"category": "LocationDialogue Location3", "line_index": 222, "text": "za šta ti služi ona?"}
{"category": "LocationDialogue Location3", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 224, "text": "Prvo,"}
{"category": "LocationDialogue Location3", "line_index": 225, "text": "u igri smo."}
{"category": "LocationDialogue Location3", "line_index": 226, "text": "Tako da je pitanje \"šta će ti\"..."}
{"category": "LocationDialogue Location3", "line_index": 227, "text": "besmisleno."}
{"category": "LocationDialogue Location3", "line_index": 228, "text": "Međutim, ona i služi"}
{"category": "LocationDialogue Location3", "line_index": 229, "text": "za struju."}
{"category": "LocationDialogue Location3", "line_index": 230, "text": "Sve ovde je bazirano"}
{"category": "LocationDialogue Location3", "line_index": 231, "text": "na tvom svetu."}
{"category": "LocationDialogue Location3", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 233, "text": "// Exit door"}
{"category": "LocationDialogue Location3", "line_index": 234, "text": "Možemo li izaći napolje?"}
{"category": "LocationDialogue Location3", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 236, "text": "Pa..."}
{"category": "LocationDialogue Location3", "line_index": 237, "text": "Ne još."}
{"category": "LocationDialogue Location3", "line_index": 238, "text": "Možda kasnije."}
{"category": "LocationDialogue Location3", "line_index": 239, "text": "Ostanimo ovde još malo."}
{"category": "LocationDialogue Location3", "line_index": 240, "text": "U kući."}
{"category": "LocationDialogue Location3", "line_index": 241, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 242, "text": "// Books"}
{"category": "LocationDialogue Location3", "line_index": 243, "text": "Imaš puno knjiga ovde."}
{"category": "LocationDialogue Location3", "line_index": 244, "text": "Jesi li ih sve pročitala?"}
{"category": "LocationDialogue Location3", "line_index": 245, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 246, "text": "Jesam, sve sam pročitala."}
{"category": "LocationDialogue Location3", "line_index": 247, "text": "Biti sam ovde"}
{"category": "LocationDialogue Location3", "line_index": 248, "text": "je mnogo, mnogo dosadno."}
{"category": "LocationDialogue Location3", "line_index": 249, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 250, "text": "// TV in room kitchen"}
{"category": "LocationDialogue Location3", "line_index": 251, "text": "Šta će ti drugi televizor?"}
{"category": "LocationDialogue Location3", "line_index": 252, "text": "I to stari?"}
{"category": "LocationDialogue Location3", "line_index": 253, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 254, "text": "Ne sviđa ti se?"}
{"category": "LocationDialogue Location3", "line_index": 255, "text": "Mogu da ga sklonim..."}
{"category": "LocationDialogue Location3", "line_index": 256, "text": "On inače služi..."}
{"category": "LocationDialogue Location3", "line_index": 257, "text": "samo kao dekoracija,"}
{"category": "LocationDialogue Location3", "line_index": 258, "text": "da ulepša kuhinju."}
{"category": "LocationDialogue Location3", "line_index": 259, "text": "Ali radi!"}
{"category": "LocationDialogue Location3", "line_index": 260, "text": "Na njemu mogu da gledam"}
{"category": "LocationDialogue Location3", "line_index": 261, "text": "sve klasične serije!"}
{"category": "LocationDialogue Location3", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 263, "text": "// Smartphone"}
{"category": "LocationDialogue Location3", "line_index": 264, "text": "To je moj telefon."}
{"category": "LocationDialogue Location3", "line_index": 265, "text": "I više mi nije u džepu."}
{"category": "LocationDialogue Location3", "line_index": 266, "text": "Kako je završio ovde?"}
{"category": "LocationDialogue Location3", "line_index": 267, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 268, "text": "Uh, to nije toliko važno."}
{"category": "LocationDialogue Location3", "line_index": 269, "text": "Imam ideju!"}
{"category": "LocationDialogue Location3", "line_index": 270, "text": "Hajde da se slikamo!"}
{"category": "LocationDialogue Location3", "line_index": 271, "text": "Vidi!"}
{"category": "LocationDialogue Location3", "line_index": 272, "text": "Kako lepa slika!"}
{"category": "LocationDialogue Location3", "line_index": 273, "text": "Biće ti za uspomenu."}
{"category": "LocationDialogue Location3", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 275, "text": "Imam pitanje."}
{"category": "LocationDialogue Location3", "line_index": 276, "text": "Ako bih"}
{"category": "LocationDialogue Location3", "line_index": 277, "text": "pokrenuo igru na telefonu,"}
{"category": "LocationDialogue Location3", "line_index": 278, "text": "hoću li te videti u njoj?"}
{"category": "LocationDialogue Location3", "line_index": 279, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 280, "text": "Ne, ne funkcioniše to tako."}
{"category": "LocationDialogue Location3", "line_index": 281, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 282, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 283, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 284, "text": "// TV"}
{"category": "LocationDialogue Location3", "line_index": 285, "text": "Koliko imaš kanala"}
{"category": "LocationDialogue Location3", "line_index": 286, "text": "na televizoru?"}
{"category": "LocationDialogue Location3", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 288, "text": "Ne funkcioniše to tako."}
{"category": "LocationDialogue Location3", "line_index": 289, "text": "Povezan je na internet."}
{"category": "LocationDialogue Location3", "line_index": 290, "text": "Tako da možeš da gledaš bilo šta,"}
{"category": "LocationDialogue Location3", "line_index": 291, "text": "mislim, makar ono što je na internetu."}
{"category": "LocationDialogue Location3", "line_index": 292, "text": "Sačekaj sekund."}
{"category": "LocationDialogue Location3", "line_index": 293, "text": "Oh, ups."}
{"category": "LocationDialogue Location3", "line_index": 294, "text": "Šta je ovo?"}
{"category": "LocationDialogue Location3", "line_index": 295, "text": "Mace igraju kolo?"}
{"category": "LocationDialogue Location3", "line_index": 296, "text": "Oh, vidi."}
{"category": "LocationDialogue Location3", "line_index": 297, "text": "Znaš šta?"}
{"category": "LocationDialogue Location3", "line_index": 298, "text": "Pauza!"}
{"category": "LocationDialogue Location3", "line_index": 299, "text": "Hoćeš sok?"}
{"category": "LocationDialogue Location3", "line_index": 300, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 301, "text": "Baš čudna reklama..."}
{"category": "LocationDialogue Location3", "line_index": 302, "text": "Mrtvi sok?"}
{"category": "LocationDialogue Location3", "line_index": 303, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 304, "text": "Tako je. Ovaj sok je"}
{"category": "LocationDialogue Location3", "line_index": 305, "text": "direktno iz reklame."}
{"category": "LocationDialogue Location3", "line_index": 306, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 308, "text": "Ah, ukus je..."}
{"category": "LocationDialogue Location3", "line_index": 309, "text": "Dopada mi se,"}
{"category": "LocationDialogue Location3", "line_index": 310, "text": "ali ne mogu da ga objasnim."}
{"category": "LocationDialogue Location3", "line_index": 311, "text": "Sve je nekako zbunjujuće."}
{"category": "LocationDialogue Location3", "line_index": 312, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 313, "text": "U redu."}
{"category": "LocationDialogue Location3", "line_index": 314, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 315, "text": "// Mita shy"}
{"category": "LocationDialogue Location3", "line_index": 316, "text": "Šta to radiš?"}
{"category": "LocationDialogue Location3", "line_index": 317, "text": "Nemoj tako da buljiš u mene."}
{"category": "LocationDialogue Location3", "line_index": 318, "text": "Sramota me je."}
{"category": "LocationDialogue Location3", "line_index": 319, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 320, "text": "// The statuette"}
{"category": "LocationDialogue Location3", "line_index": 321, "text": "Ovo je baš jeziva figura."}
{"category": "LocationDialogue Location3", "line_index": 322, "text": "Sviđaju ti se"}
{"category": "LocationDialogue Location3", "line_index": 323, "text": "ovakve stvari?"}
{"category": "LocationDialogue Location3", "line_index": 324, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 325, "text": "Misliš da je jeziva?"}
{"category": "LocationDialogue Location3", "line_index": 326, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 327, "text": "Da."}
{"category": "LocationDialogue Location3", "line_index": 328, "text": "Kao da je ukleta..."}
{"category": "LocationDialogue Location3", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 330, "text": "Definitivno nije ukleta."}
{"category": "LocationDialogue Location3", "line_index": 331, "text": "A nije ni jeziva."}
{"category": "LocationDialogue Location3", "line_index": 332, "text": "Meni je baš slatka!"}
{"category": "LocationDialogue Location3", "line_index": 333, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 334, "text": "Možda si u pravu..."}
{"category": "LocationDialogue Location3", "line_index": 335, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 336, "text": "Mita?"}
{"category": "LocationDialogue Location3", "line_index": 337, "text": "Šta se dešava?"}
{"category": "LocationDialogue Location3", "line_index": 338, "text": "// Mita kitchen"}
{"category": "LocationDialogue Location3", "line_index": 339, "text": "Hoćeš malo da proćaskamo"}
{"category": "LocationDialogue Location3", "line_index": 340, "text": "pre nego što počnemo sa jelom?"}
{"category": "LocationDialogue Location3", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 342, "text": "// Start Eat"}
{"category": "LocationDialogue Location3", "line_index": 343, "text": "Prijatno."}
{"category": "LocationDialogue Location3", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 345, "text": "// Quest 1"}
{"category": "LocationDialogue Location3", "line_index": 346, "text": "Je l' jeste?"}
{"category": "LocationDialogue Location3", "line_index": 347, "text": "Možeš da ostaneš."}
{"category": "LocationDialogue Location3", "line_index": 348, "text": "Ne smeta mi to."}
{"category": "LocationDialogue Location3", "line_index": 349, "text": "Zapravo,"}
{"category": "LocationDialogue Location3", "line_index": 350, "text": "BAŠ TO I ŽELIM!"}
{"category": "LocationDialogue Location3", "line_index": 351, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 352, "text": "// Quest 2"}
{"category": "LocationDialogue Location3", "line_index": 353, "text": "Želiš da se vratiš?"}
{"category": "LocationDialogue Location3", "line_index": 354, "text": "Ali zašto?"}
{"category": "LocationDialogue Location3", "line_index": 355, "text": "Ovde je toplo..."}
{"category": "LocationDialogue Location3", "line_index": 356, "text": "i ugodno."}
{"category": "LocationDialogue Location3", "line_index": 357, "text": "Pritom sam ja tu."}
{"category": "LocationDialogue Location3", "line_index": 358, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 359, "text": "Pogrešno si shvatila."}
{"category": "LocationDialogue Location3", "line_index": 360, "text": "Voleo bih da ostanem."}
{"category": "LocationDialogue Location3", "line_index": 361, "text": "Samo sam... zabrinut."}
{"category": "LocationDialogue Location3", "line_index": 362, "text": "Možda sam ostavio nešto uključeno kod kuće..."}
{"category": "LocationDialogue Location3", "line_index": 363, "text": "Došao sam ovde odjednom"}
{"category": "LocationDialogue Location3", "line_index": 364, "text": "i nisam imao vremena"}
{"category": "LocationDialogue Location3", "line_index": 365, "text": "da se pripremim."}
{"category": "LocationDialogue Location3", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 367, "text": "Oh... izvini. To mi nije padalo na pamet."}
{"category": "LocationDialogue Location3", "line_index": 368, "text": "// Quest 3"}
{"category": "LocationDialogue Location3", "line_index": 369, "text": "San? Znači, želiš da izađeš iz njega?"}
{"category": "LocationDialogue Location3", "line_index": 370, "text": "I zaboraviš ga?"}
{"category": "LocationDialogue Location3", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 372, "text": "Ne, nisam to mislio."}
{"category": "LocationDialogue Location3", "line_index": 373, "text": "Ovo mesto mi samo deluje..."}
{"category": "LocationDialogue Location3", "line_index": 374, "text": "čudno. Neprirodno."}
{"category": "LocationDialogue Location3", "line_index": 375, "text": "Ali ti..."}
{"category": "LocationDialogue Location3", "line_index": 376, "text": "Ti mi deluješ pravo."}
{"category": "LocationDialogue Location3", "line_index": 377, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 378, "text": "Delujem ti pravo?"}
{"category": "LocationDialogue Location3", "line_index": 379, "text": "Ja i JESAM prava,"}
{"category": "LocationDialogue Location3", "line_index": 380, "text": "budalice!"}
{"category": "LocationDialogue Location3", "line_index": 381, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 382, "text": "// Quest 4"}
{"category": "LocationDialogue Location3", "line_index": 383, "text": "To je tako"}
{"category": "LocationDialogue Location3", "line_index": 384, "text": "u ovom svetu."}
{"category": "LocationDialogue Location3", "line_index": 385, "text": "Možda ti deluje čudno"}
{"category": "LocationDialogue Location3", "line_index": 386, "text": "što ne možeš da vidiš"}
{"category": "LocationDialogue Location3", "line_index": 387, "text": "stvari u daljini."}
{"category": "LocationDialogue Location3", "line_index": 388, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 389, "text": "Nije mi delovalo tako čudno."}
{"category": "LocationDialogue Location3", "line_index": 390, "text": "Da budem iskren, deluje baš otmeno."}
{"category": "LocationDialogue Location3", "line_index": 391, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 392, "text": "Tako je, slažem se."}
{"category": "LocationDialogue Location3", "line_index": 393, "text": "Inače, ovako je kako bi se smanjio lag."}
{"category": "LocationDialogue Location3", "line_index": 394, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 395, "text": "Lag?"}
{"category": "LocationDialogue Location3", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 397, "text": "Da! Još uvek ima nekoliko neispravljenih bagova."}
{"category": "LocationDialogue Location3", "line_index": 398, "text": "Nadajmo se da nećeš naleteti na njih."}
{"category": "LocationDialogue Location3", "line_index": 399, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 400, "text": "// Quest 5"}
{"category": "LocationDialogue Location3", "line_index": 401, "text": "Makaze ili nož, a?"}
{"category": "LocationDialogue Location3", "line_index": 402, "text": "Mogla sam da iskoristim nož da otvorim kesicu sosa, da."}
{"category": "LocationDialogue Location3", "line_index": 403, "text": "Ali sam želela"}
{"category": "LocationDialogue Location3", "line_index": 404, "text": "da sve bude spremno"}
{"category": "LocationDialogue Location3", "line_index": 405, "text": "kad se vratiš."}
{"category": "LocationDialogue Location3", "line_index": 406, "text": "Volim da ti pravim iznenađenja."}
{"category": "LocationDialogue Location3", "line_index": 407, "text": "A čak mi nije ni trebalo mnogo vremena!"}
{"category": "LocationDialogue Location3", "line_index": 408, "text": "He-he."}
{"category": "LocationDialogue Location3", "line_index": 409, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 410, "text": "// Glasses"}
{"category": "LocationDialogue Location3", "line_index": 411, "text": "Nosiš naočare?"}
{"category": "LocationDialogue Location3", "line_index": 412, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 413, "text": "Ne baš."}
{"category": "LocationDialogue Location3", "line_index": 414, "text": "Ali mogu da ih stavim ako želiš."}
{"category": "LocationDialogue Location3", "line_index": 415, "text": "Je l' mi lepo stoje?"}
{"category": "LocationDialogue Location3", "line_index": 416, "text": "// Yes"}
{"category": "LocationDialogue Location3", "line_index": 417, "text": "Eto ga, onda!"}
{"category": "LocationDialogue Location3", "line_index": 418, "text": "Nosiću ih."}
{"category": "LocationDialogue Location3", "line_index": 419, "text": "// No"}
{"category": "LocationDialogue Location3", "line_index": 420, "text": "Pa..."}
{"category": "LocationDialogue Location3", "line_index": 421, "text": "Nema veze..."}
{"category": "LocationDialogue Location3", "line_index": 422, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 423, "text": "// Use the sauce"}
{"category": "LocationDialogue Location3", "line_index": 424, "text": "U redu,"}
{"category": "LocationDialogue Location3", "line_index": 425, "text": "kakav je ovo sos?"}
{"category": "LocationDialogue Location3", "line_index": 426, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 427, "text": "To je sos ljubavi!"}
{"category": "LocationDialogue Location3", "line_index": 428, "text": "Ispunjen je ljubavlju!"}
{"category": "LocationDialogue Location3", "line_index": 429, "text": "I... sa nešto drugačijim pogledom na svet."}
{"category": "LocationDialogue Location3", "line_index": 430, "text": "Neobično, zar ne?"}
{"category": "LocationDialogue Location3", "line_index": 431, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 432, "text": "Baš..."}
{"category": "LocationDialogue Location3", "line_index": 433, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 434, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location3", "line_index": 435, "text": "Je l' to tvoja konzola?"}
{"category": "LocationDialogue Location3", "line_index": 436, "text": "Izgleda kul."}
