{"category": "LocationDialogue Location20", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Mila! Ne! Ludačo!"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Ha-ha! ŠTA JE BILO?"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "Kakav ti je to izraz lica?"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "Hajde, daj da vidim!"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "Gledanje jednog te istog izraza je dosadno!"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\""}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "Kako ide, moja mala nemirna lutalice?"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "I dalje trčiš unaokolo? Još ti nije bilo dovoljno?"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Šta si uradila Mili?"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "Oh, znači još uvek nisi umoran!"}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Odlično! Hajde onda da igramo jednu igru!"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "Ti..."}
{"category": "LocationDialogue Location20", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "Započnimo sa malim testom!"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "Testirajmo tvoju koordinaciju!"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "I tvoja glumačka umeća!"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "Šta ako nešto nije u redu sa tobom!?"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "Šta ako ne zaslužuješ tu tvoju KOŽU"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "koju tako ponosno nosiš!?"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "Pogledaj..."}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "Koji ti se više sviđa?"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "Desni?"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "Ili"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "levi?"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "Zezaš li me?"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "Zar je uopšte i bitno?"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "Samo te zezam!"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "Klanje je svakako zastarelo."}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "Štagod!"}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "Isplanirala sam mnogo zabavnije igre,"}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "kao na primer..."}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "Vidi ovo!"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Treba nam muzika!"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "Sviđa li ti se ova melodija?"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "Meni razbuđuje krv u živama!"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "Počeću"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "sa pravilima!"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rules"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "Dok muzika svira,"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "možeš da se krećeš."}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "Ali kada stane,"}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "NE MRDAJ!"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "Inače si mrtav. Kapiraš?"}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "Jednostavno je: stigni do kraja"}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "pre nego što se pesma završi."}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "Krenimo!"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "I dalje stojiš?"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Trči, dragi, trči!"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "Oh!"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Vidi ti to! Kako si samo poslušan!"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Savršeno malo biće."}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Želim te samo za sebe!"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "Ovo je bilo prelako, zar ne?"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "Pusti me!"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "Ne opuštaj se još!"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "Imam još puno igara za tebe!"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "Evo sledeće:"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Zatvoriću oči..."}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "A kada ih otvorim,"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "bolje da te ne vidim!"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "Kapiraš?"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "Ako te budem videla, kazniću te!"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Odlično! Počnimo!"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "Ovo je besmisleno..."}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "Uspeo si!"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Odlično ti ide—ovo postaje uzbudljivo!"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "Ali sada će biti teže."}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "MNOGO teže."}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Sakrij se, trči, beži—"}
{"category": "LocationDialogue Location20", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "Prokletinjo!"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Player falls"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "Mislim da sam joj umakao..."}
