{"category": "LocationDialogue Location13", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 1, "text": "Prsten."}
{"category": "LocationDialogue Location13", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 3, "text": "// Answer 1 (Where have you been all this time?)"}
{"category": "LocationDialogue Location13", "line_index": 4, "text": "Tražila sam način da te odvedem do Jezgra."}
{"category": "LocationDialogue Location13", "line_index": 5, "text": "U jednom komadu, naravno."}
{"category": "LocationDialogue Location13", "line_index": 6, "text": "To je bio plan od samog početka, zar ne?"}
{"category": "LocationDialogue Location13", "line_index": 7, "text": "Zato sam morala da izbegavam"}
{"category": "LocationDialogue Location13", "line_index": 8, "text": "Ludu Mitu, zar ne?"}
{"category": "LocationDialogue Location13", "line_index": 9, "text": "Takođe sam morala da iskopam sve što mogu"}
{"category": "LocationDialogue Location13", "line_index": 10, "text": "o prokletom \"pozadinskom sistemu\" univerzuma, zar ne?"}
{"category": "LocationDialogue Location13", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 12, "text": "Ovaj... valjda...?"}
{"category": "LocationDialogue Location13", "line_index": 13, "text": "Ali kako si postavila rutu u prsten?"}
{"category": "LocationDialogue Location13", "line_index": 14, "text": "Zašto sam zavrpio u ubagovanoj verziji"}
{"category": "LocationDialogue Location13", "line_index": 15, "text": "prepunom opasnosti?"}
{"category": "LocationDialogue Location13", "line_index": 16, "text": "Pobegao sam samo"}
{"category": "LocationDialogue Location13", "line_index": 17, "text": "tako što sam skakao u beskrajnu tamu."}
{"category": "LocationDialogue Location13", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 19, "text": "Izvini, nisam ti detaljno objasnila"}
{"category": "LocationDialogue Location13", "line_index": 20, "text": "šta treba da uradiš..."}
{"category": "LocationDialogue Location13", "line_index": 21, "text": "Ali da, planirala sam"}
{"category": "LocationDialogue Location13", "line_index": 22, "text": "da obiđeš sve to..."}
{"category": "LocationDialogue Location13", "line_index": 23, "text": "I uspeo si!"}
{"category": "LocationDialogue Location13", "line_index": 24, "text": "Svaka čast!"}
{"category": "LocationDialogue Location13", "line_index": 25, "text": "U redu, idemo dalje sa planom."}
{"category": "LocationDialogue Location13", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 27, "text": "// Answer 2 (How did you get here?)"}
{"category": "LocationDialogue Location13", "line_index": 28, "text": "Sigurno si prošao kroz svašta,"}
{"category": "LocationDialogue Location13", "line_index": 29, "text": "s obzirom na to da si zaboravio o čemu smo pričali."}
{"category": "LocationDialogue Location13", "line_index": 30, "text": "Ja sam Mita, mogu da se krećem između verzija"}
{"category": "LocationDialogue Location13", "line_index": 31, "text": "kad god želim, sećaš se?"}
{"category": "LocationDialogue Location13", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 33, "text": "Ne mogu sve Mite to,"}
{"category": "LocationDialogue Location13", "line_index": 34, "text": "video sam neke koje ne mogu."}
{"category": "LocationDialogue Location13", "line_index": 35, "text": "I očigledno je da pate zbog toga."}
{"category": "LocationDialogue Location13", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 37, "text": "Tako je, njihove verzije su nestabilne,"}
{"category": "LocationDialogue Location13", "line_index": 38, "text": "njihovi svetovi ubagovani. Već sam ti to rekla."}
{"category": "LocationDialogue Location13", "line_index": 39, "text": "Prokletstvo..."}
{"category": "LocationDialogue Location13", "line_index": 40, "text": "Znaš ko je iza svega ovoga?"}
{"category": "LocationDialogue Location13", "line_index": 41, "text": "Luda Mita."}
{"category": "LocationDialogue Location13", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 43, "text": "Da, ovo je sigurno njeno maslo..."}
{"category": "LocationDialogue Location13", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 45, "text": "// Answer 3 (Who was this Mita just now?)"}
{"category": "LocationDialogue Location13", "line_index": 46, "text": "To je Ružna Mita."}
{"category": "LocationDialogue Location13", "line_index": 47, "text": "Agresivna i glupa."}
{"category": "LocationDialogue Location13", "line_index": 48, "text": "Ne možeš da je urazumeš,"}
{"category": "LocationDialogue Location13", "line_index": 49, "text": "njen ceo svet se okreće oko Lude Mite."}
{"category": "LocationDialogue Location13", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 51, "text": "Primetio sam to."}
{"category": "LocationDialogue Location13", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 53, "text": "Hajde, moramo stići do Jezgra."}
{"category": "LocationDialogue Location13", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 55, "text": "// Answer 4 (How does the ring work?)"}
{"category": "LocationDialogue Location13", "line_index": 56, "text": "A ovaj prsten,"}
{"category": "LocationDialogue Location13", "line_index": 57, "text": "to je jedini način da dođem do Jezgra?"}
{"category": "LocationDialogue Location13", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 59, "text": "Da."}
{"category": "LocationDialogue Location13", "line_index": 60, "text": "Da smo imali portal,"}
{"category": "LocationDialogue Location13", "line_index": 61, "text": "mogli smo samo da te"}
{"category": "LocationDialogue Location13", "line_index": 62, "text": "teleportujemo tamo."}
{"category": "LocationDialogue Location13", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 64, "text": "Ima li prsten neke prednosti?"}
{"category": "LocationDialogue Location13", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 66, "text": "Naravno!"}
{"category": "LocationDialogue Location13", "line_index": 67, "text": "Lako se nosi"}
{"category": "LocationDialogue Location13", "line_index": 68, "text": "i pamti verzije"}
{"category": "LocationDialogue Location13", "line_index": 69, "text": "u koje si bio,"}
{"category": "LocationDialogue Location13", "line_index": 70, "text": "tako da se lako možeš vratiti."}
{"category": "LocationDialogue Location13", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 72, "text": "// Answer 5 (Why does Mad Mita need me?)"}
{"category": "LocationDialogue Location13", "line_index": 73, "text": "Zašto me Luda Mita ne ostavi na miru?"}
{"category": "LocationDialogue Location13", "line_index": 74, "text": "Uvukla me je u svoju opasnu igru,"}
{"category": "LocationDialogue Location13", "line_index": 75, "text": "a i dalje sam živ..."}
{"category": "LocationDialogue Location13", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 77, "text": "Pretpostavljam"}
{"category": "LocationDialogue Location13", "line_index": 78, "text": "da traži pogodnog igrača..."}
{"category": "LocationDialogue Location13", "line_index": 79, "text": "Onog ko će je prihvatiti kakva jeste."}
{"category": "LocationDialogue Location13", "line_index": 80, "text": "Na kraju krajeva, Mita je Mita!"}
{"category": "LocationDialogue Location13", "line_index": 81, "text": "Pošto se to očigledno neće desiti,"}
{"category": "LocationDialogue Location13", "line_index": 82, "text": "pretvara igrače u kasete,"}
{"category": "LocationDialogue Location13", "line_index": 83, "text": "tako da niko od njih ne može pobeći..."}
{"category": "LocationDialogue Location13", "line_index": 84, "text": "To je, barem, moja pretpostavka."}
{"category": "LocationDialogue Location13", "line_index": 85, "text": "Kakogod, usredsredimo se na ono što je bitno."}
{"category": "LocationDialogue Location13", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 87, "text": "// Answer 6 (Is this the core?)"}
{"category": "LocationDialogue Location13", "line_index": 88, "text": "Je l' ovo"}
{"category": "LocationDialogue Location13", "line_index": 89, "text": "Jezgro?"}
{"category": "LocationDialogue Location13", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 91, "text": "Tako je. Ovo je Jezgro."}
{"category": "LocationDialogue Location13", "line_index": 92, "text": "Pokušala sam da objasnim,"}
{"category": "LocationDialogue Location13", "line_index": 93, "text": "vi igrači niste istinski deo ovog sveta..."}
{"category": "LocationDialogue Location13", "line_index": 94, "text": "Što znači da vam ne treba posebna dozvola da uđete."}
{"category": "LocationDialogue Location13", "line_index": 95, "text": "Barem ja tako mislim."}
{"category": "LocationDialogue Location13", "line_index": 96, "text": "Sve u svemu, sigurna sam"}
{"category": "LocationDialogue Location13", "line_index": 97, "text": "da rešenje za naše probleme"}
{"category": "LocationDialogue Location13", "line_index": 98, "text": "leže unutra!"}
{"category": "LocationDialogue Location13", "line_index": 99, "text": "[player], uđi."}
{"category": "LocationDialogue Location13", "line_index": 100, "text": "Zapravo si uspeo..."}
{"category": "LocationDialogue Location13", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 102, "text": "// Look on CoreMita"}
{"category": "LocationDialogue Location13", "line_index": 103, "text": "Pažljivo, [player]."}
{"category": "LocationDialogue Location13", "line_index": 104, "text": "Nadgleda te."}
{"category": "LocationDialogue Location13", "line_index": 105, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 106, "text": "Ko je to?"}
{"category": "LocationDialogue Location13", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 108, "text": "Ne znam ni ja..."}
{"category": "LocationDialogue Location13", "line_index": 109, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 110, "text": "Divno..."}
{"category": "LocationDialogue Location13", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 113, "text": "Šta je to?"}
{"category": "LocationDialogue Location13", "line_index": 114, "text": "Hej!"}
{"category": "LocationDialogue Location13", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 116, "text": "Mislim da sam pronašao!"}
{"category": "LocationDialogue Location13", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 118, "text": "To je super!"}
{"category": "LocationDialogue Location13", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 120, "text": "Ali moram da unesem odgovarajuću verziju."}
{"category": "LocationDialogue Location13", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 122, "text": "U redu, njena verzija je..."}
{"category": "LocationDialogue Location13", "line_index": 123, "text": "00.98"}
{"category": "LocationDialogue Location13", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 125, "text": "Bingo!"}
{"category": "LocationDialogue Location13", "line_index": 126, "text": "U redu, koji je indeks broj?"}
{"category": "LocationDialogue Location13", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 128, "text": "Uh, indeks broj?"}
{"category": "LocationDialogue Location13", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 130, "text": "Treba mi i indeks broj."}
{"category": "LocationDialogue Location13", "line_index": 131, "text": "Čekaj, nemoj mi reći da ne znaš...?"}
{"category": "LocationDialogue Location13", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 134, "text": "Hm, ima smisla..."}
{"category": "LocationDialogue Location13", "line_index": 135, "text": "Svaka Mita ima svoj indeks broj,"}
{"category": "LocationDialogue Location13", "line_index": 136, "text": "tako da ne možeš restartovati čitavu verziju..."}
{"category": "LocationDialogue Location13", "line_index": 137, "text": "To bi izazvalo haos!"}
{"category": "LocationDialogue Location13", "line_index": 138, "text": "Ne mogu da verujem da mi to nije padalo na pamet..."}
{"category": "LocationDialogue Location13", "line_index": 139, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 144, "text": "// Answer 1 (What's wrong with you?)"}
{"category": "LocationDialogue Location13", "line_index": 145, "text": "Uprkos svim našim nevoljama,"}
{"category": "LocationDialogue Location13", "line_index": 146, "text": "potpuno sam dobro."}
{"category": "LocationDialogue Location13", "line_index": 147, "text": "Sve je sjajno, ali mnogo toga se promenilo..."}
{"category": "LocationDialogue Location13", "line_index": 148, "text": "Moram da razmislim."}
{"category": "LocationDialogue Location13", "line_index": 149, "text": "I to je to."}
{"category": "LocationDialogue Location13", "line_index": 150, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 151, "text": "// Answer 2 (Maybe there's a way to get to know him?)"}
{"category": "LocationDialogue Location13", "line_index": 152, "text": "Mislim..."}
{"category": "LocationDialogue Location13", "line_index": 153, "text": "Mislim da je to... suludo!"}
{"category": "LocationDialogue Location13", "line_index": 154, "text": "Suludo je!"}
{"category": "LocationDialogue Location13", "line_index": 155, "text": "To je kao kad bismo tražili iglu u..."}
{"category": "LocationDialogue Location13", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 157, "text": "Šta to radiš?"}
{"category": "LocationDialogue Location13", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 159, "text": "Neke prepreke nestaju sa informacijama,"}
{"category": "LocationDialogue Location13", "line_index": 160, "text": "znaš, kao kad se svetu iščupaju iznutrice!"}
{"category": "LocationDialogue Location13", "line_index": 161, "text": "Zapisi, zapisi, zapisi, podaci?"}
{"category": "LocationDialogue Location13", "line_index": 162, "text": "Šta ako je to to?"}
{"category": "LocationDialogue Location13", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 164, "text": "Šta nije u redu?"}
{"category": "LocationDialogue Location13", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 166, "text": "Znam za jedno mesto!"}
{"category": "LocationDialogue Location13", "line_index": 167, "text": "Sačekaj ovde."}
{"category": "LocationDialogue Location13", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 169, "text": "Kuda ideš?"}
{"category": "LocationDialogue Location13", "line_index": 170, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 171, "text": "// Answer 3 (What if we attack Mad Mita?)"}
{"category": "LocationDialogue Location13", "line_index": 172, "text": "Rekla si da se svaka Mita"}
{"category": "LocationDialogue Location13", "line_index": 173, "text": "resetuje kada umre..."}
{"category": "LocationDialogue Location13", "line_index": 174, "text": "Šta ako bismo..."}
{"category": "LocationDialogue Location13", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 176, "text": "samo ubili Ludu Mitu?"}
{"category": "LocationDialogue Location13", "line_index": 177, "text": "Jesi li ozbiljan?"}
{"category": "LocationDialogue Location13", "line_index": 178, "text": "Kako misliš da se suočiš sa ludačom koja ima motornu testeru?"}
{"category": "LocationDialogue Location13", "line_index": 179, "text": "Ona seče šargarepe sa mnogo gorim stvarima od noževa!"}
{"category": "LocationDialogue Location13", "line_index": 180, "text": "I iz nekog razloga, zastrašujuće je moćna!"}
{"category": "LocationDialogue Location13", "line_index": 181, "text": "Čudo je što smo uopšte i živi..."}
{"category": "LocationDialogue Location13", "line_index": 182, "text": "Hajde, moramo da sredimo stvari u Jezgru."}
{"category": "LocationDialogue Location13", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 185, "text": "// core console entry"}
{"category": "LocationDialogue Location13", "line_index": 186, "text": "Moramo da unesemo lozinku..."}
{"category": "LocationDialogue Location13", "line_index": 187, "text": "Ali kako to da znam?"}
{"category": "LocationDialogue Location13", "line_index": 188, "text": "Mita, znaš li ti?"}
{"category": "LocationDialogue Location13", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 190, "text": "Možda je napisana tu negde?"}
{"category": "LocationDialogue Location13", "line_index": 191, "text": "Možeš li da pogledaš?"}
{"category": "LocationDialogue Location13", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 193, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location13", "line_index": 194, "text": "To verovatno nije to."}
{"category": "LocationDialogue Location13", "line_index": 195, "text": "Nije ni ovo."}
{"category": "LocationDialogue Location13", "line_index": 196, "text": "Ne, nije to."}
{"category": "LocationDialogue Location13", "line_index": 197, "text": "Nije ni to."}
{"category": "LocationDialogue Location13", "line_index": 198, "text": "Moram da nađem opciju za resetovanje karaktera."}
{"category": "LocationDialogue Location13", "line_index": 199, "text": "// core console - nope version"}
{"category": "LocationDialogue Location13", "line_index": 200, "text": "Pogrešna verzija."}
{"category": "LocationDialogue Location13", "line_index": 201, "text": "Ups, moja greška."}
{"category": "LocationDialogue Location13", "line_index": 202, "text": "Nije ni ta."}
{"category": "LocationDialogue Location13", "line_index": 203, "text": "Treba mi neka druga."}
{"category": "LocationDialogue Location13", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location13", "line_index": 205, "text": "Nešto nije u redu"}
{"category": "LocationDialogue Location13", "line_index": 206, "text": "sa indeks brojem."}
{"category": "LocationDialogue Location13", "line_index": 207, "text": "Moram da promenim indeks broj,"}
{"category": "LocationDialogue Location13", "line_index": 208, "text": "nije ovaj."}
{"category": "LocationDialogue Location13", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 210, "text": "// Answer 4 (Little people - Chibi)"}
{"category": "LocationDialogue Location13", "line_index": 211, "text": "Znaš. naleteo sam na nekoliko"}
{"category": "LocationDialogue Location13", "line_index": 212, "text": "mini-ljudi na putu do ovde..."}
{"category": "LocationDialogue Location13", "line_index": 213, "text": "Šta su ti mini-ljudi?"}
{"category": "LocationDialogue Location13", "line_index": 214, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 215, "text": "Mini modeli?"}
{"category": "LocationDialogue Location13", "line_index": 216, "text": "Uh, kako da ti objasnim...?"}
{"category": "LocationDialogue Location13", "line_index": 217, "text": "To je ovde fenomen..."}
{"category": "LocationDialogue Location13", "line_index": 218, "text": "Svaka mita ima svoju mini verziju,"}
{"category": "LocationDialogue Location13", "line_index": 219, "text": "a mogu je imati i igrači..."}
{"category": "LocationDialogue Location13", "line_index": 220, "text": "Znaš li da ih mi Mite možemo prizvati?"}
{"category": "LocationDialogue Location13", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 222, "text": "Ha? Kako?"}
{"category": "LocationDialogue Location13", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 224, "text": "Gledaj ovo!"}
{"category": "LocationDialogue Location13", "line_index": 225, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 226, "text": "Kao magija..."}
{"category": "LocationDialogue Location13", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 228, "text": "Ali nešto nije u redu sa mojim mini modelima,"}
{"category": "LocationDialogue Location13", "line_index": 229, "text": "većina se stvorilo mrtvo."}
{"category": "LocationDialogue Location13", "line_index": 230, "text": "Dok ova jedna..."}
{"category": "LocationDialogue Location13", "line_index": 231, "text": "Ali izgleda"}
{"category": "LocationDialogue Location13", "line_index": 232, "text": "da samo trči ukrug koliko vidim."}
