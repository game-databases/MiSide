{"category": "LocationDialogue Location13", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 1, "text": "L'anello."}
{"category": "LocationDialogue Location13", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 3, "text": "// Answer 1 (Where have you been all this time?)"}
{"category": "LocationDialogue Location13", "line_index": 4, "text": "Ho cercato un modo per portarti al Nucleo."}
{"category": "LocationDialogue Location13", "line_index": 5, "text": "Tutto intero, ovviamente."}
{"category": "LocationDialogue Location13", "line_index": 6, "text": "Era questo il piano fin dall'inizio, no?"}
{"category": "LocationDialogue Location13", "line_index": 7, "text": "È per questo che dovevo evitare"}
{"category": "LocationDialogue Location13", "line_index": 8, "text": "la Mita Folle, no?"}
{"category": "LocationDialogue Location13", "line_index": 9, "text": "Dovevo anche trovare tutte le informazioni che potevo"}
{"category": "LocationDialogue Location13", "line_index": 10, "text": "sul retro del dannato universo, giusto?"}
{"category": "LocationDialogue Location13", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 12, "text": "Ehm... credo...?"}
{"category": "LocationDialogue Location13", "line_index": 13, "text": "Ma come hai impostato il percorso dell'anello?"}
{"category": "LocationDialogue Location13", "line_index": 14, "text": "Perché sono finito in una versione buggata e"}
{"category": "LocationDialogue Location13", "line_index": 15, "text": "piena di pericoli?"}
{"category": "LocationDialogue Location13", "line_index": 16, "text": "Sono riuscito a fuggire solo"}
{"category": "LocationDialogue Location13", "line_index": 17, "text": "saltando nell'oscurità infinita."}
{"category": "LocationDialogue Location13", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 19, "text": "Scusa, ho dimenticato di dirti in dettaglio"}
{"category": "LocationDialogue Location13", "line_index": 20, "text": "cosa dovevi fare..."}
{"category": "LocationDialogue Location13", "line_index": 21, "text": "Ma sì, il piano era che tu"}
{"category": "LocationDialogue Location13", "line_index": 22, "text": "saltassi fin dall'inizio..."}
{"category": "LocationDialogue Location13", "line_index": 23, "text": "Ebbene, l'hai fatto!"}
{"category": "LocationDialogue Location13", "line_index": 24, "text": "Ottimo lavoro!"}
{"category": "LocationDialogue Location13", "line_index": 25, "text": "Bene, procediamo con il piano."}
{"category": "LocationDialogue Location13", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 27, "text": "// Answer 2 (How did you get here?)"}
{"category": "LocationDialogue Location13", "line_index": 28, "text": "Devi averne passate tante,"}
{"category": "LocationDialogue Location13", "line_index": 29, "text": "e hai dimenticato le cose di cui abbiamo parlato."}
{"category": "LocationDialogue Location13", "line_index": 30, "text": "Io sono Mita, posso passare da una versione all'altra"}
{"category": "LocationDialogue Location13", "line_index": 31, "text": "come meglio credo, ricordi?"}
{"category": "LocationDialogue Location13", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 33, "text": "Non tutte le Mita possono farlo,"}
{"category": "LocationDialogue Location13", "line_index": 34, "text": "Ne ho viste alcune che non ci riescono."}
{"category": "LocationDialogue Location13", "line_index": 35, "text": "E ovviamente soffrono."}
{"category": "LocationDialogue Location13", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 37, "text": "Sì, le loro versioni sono rotte,"}
{"category": "LocationDialogue Location13", "line_index": 38, "text": "i loro mondi sono danneggiati. Te l'ho già detto."}
{"category": "LocationDialogue Location13", "line_index": 39, "text": "Dannazione..."}
{"category": "LocationDialogue Location13", "line_index": 40, "text": "Sai chi c'è dietro tutto questo, vero?"}
{"category": "LocationDialogue Location13", "line_index": 41, "text": "Mita Folle."}
{"category": "LocationDialogue Location13", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 43, "text": "Sì, è lei di sicuro…"}
{"category": "LocationDialogue Location13", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 45, "text": "// Answer 3 (Who was this Mita just now?)"}
{"category": "LocationDialogue Location13", "line_index": 46, "text": "Quella è Mita Deforme."}
{"category": "LocationDialogue Location13", "line_index": 47, "text": "Aggressiva e stupida."}
{"category": "LocationDialogue Location13", "line_index": 48, "text": "Non si può parlare con lei in modo sensato,"}
{"category": "LocationDialogue Location13", "line_index": 49, "text": "tutto il suo mondo ruota intorno alla Mita Folle."}
{"category": "LocationDialogue Location13", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 51, "text": "Sì, l'ho notato."}
{"category": "LocationDialogue Location13", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 53, "text": "Andiamo, dobbiamo raggiungere il Nucleo."}
{"category": "LocationDialogue Location13", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 55, "text": "// Answer 4 (How does the ring work?)"}
{"category": "LocationDialogue Location13", "line_index": 56, "text": "E l'anello,"}
{"category": "LocationDialogue Location13", "line_index": 57, "text": "è l'unica via per il Nucleo?"}
{"category": "LocationDialogue Location13", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 59, "text": "Sì, è l'unica via d'accesso al Nucleo."}
{"category": "LocationDialogue Location13", "line_index": 60, "text": "Naturalmente, se avessimo avuto il portale"}
{"category": "LocationDialogue Location13", "line_index": 61, "text": "avremmo potuto semplicemente"}
{"category": "LocationDialogue Location13", "line_index": 62, "text": "teletrasportarci lì."}
{"category": "LocationDialogue Location13", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 64, "text": "C'è qualche vantaggio nell'anello?"}
{"category": "LocationDialogue Location13", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 66, "text": "Certo!"}
{"category": "LocationDialogue Location13", "line_index": 67, "text": "È facile da indossare,"}
{"category": "LocationDialogue Location13", "line_index": 68, "text": "e ricorda le versioni"}
{"category": "LocationDialogue Location13", "line_index": 69, "text": "che hai visitato in precedenza,"}
{"category": "LocationDialogue Location13", "line_index": 70, "text": "in modo da poterci tornare facilmente."}
{"category": "LocationDialogue Location13", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 72, "text": "// Answer 5 (Why does Mad Mita need me?)"}
{"category": "LocationDialogue Location13", "line_index": 73, "text": "Perché Mita Folle non mi lascia in pace?"}
{"category": "LocationDialogue Location13", "line_index": 74, "text": "Mi ha trascinato nel suo gioco pericoloso,"}
{"category": "LocationDialogue Location13", "line_index": 75, "text": "eppure sono ancora vivo..."}
{"category": "LocationDialogue Location13", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 77, "text": "La mia ipotesi è"}
{"category": "LocationDialogue Location13", "line_index": 78, "text": "che stia cercando un giocatore adatto..."}
{"category": "LocationDialogue Location13", "line_index": 79, "text": "Uno che la accetti per quello che è."}
{"category": "LocationDialogue Location13", "line_index": 80, "text": "Dopo tutto, Mita è Mita!"}
{"category": "LocationDialogue Location13", "line_index": 81, "text": "Dato che questo ovviamente non accadrà mai,"}
{"category": "LocationDialogue Location13", "line_index": 82, "text": "trasforma i giocatori in cartucce,"}
{"category": "LocationDialogue Location13", "line_index": 83, "text": "così nessuno potrà mai scappare..."}
{"category": "LocationDialogue Location13", "line_index": 84, "text": "Almeno questa è la mia ipotesi."}
{"category": "LocationDialogue Location13", "line_index": 85, "text": "Comunque, concentriamoci su ciò che è importante."}
{"category": "LocationDialogue Location13", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 87, "text": "// Answer 6 (Is this the core?)"}
{"category": "LocationDialogue Location13", "line_index": 88, "text": "È questo?"}
{"category": "LocationDialogue Location13", "line_index": 89, "text": "Il nucleo?"}
{"category": "LocationDialogue Location13", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 91, "text": "Esatto. Il nucleo."}
{"category": "LocationDialogue Location13", "line_index": 92, "text": "Ho cercato di spiegarti,"}
{"category": "LocationDialogue Location13", "line_index": 93, "text": "voi giocatori non fate veramente parte di questo mondo..."}
{"category": "LocationDialogue Location13", "line_index": 94, "text": "Cioè, non avete bisogno di un permesso speciale per entrare."}
{"category": "LocationDialogue Location13", "line_index": 95, "text": "O, almeno, questo è quello che credo io."}
{"category": "LocationDialogue Location13", "line_index": 96, "text": "Comunque, sono più che certa"}
{"category": "LocationDialogue Location13", "line_index": 97, "text": "che la soluzione a tutti i nostri problemi"}
{"category": "LocationDialogue Location13", "line_index": 98, "text": "può essere trovata all'interno!"}
{"category": "LocationDialogue Location13", "line_index": 99, "text": "[player], vai dentro."}
{"category": "LocationDialogue Location13", "line_index": 100, "text": "C'è l'hai veramente fatta."}
{"category": "LocationDialogue Location13", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 102, "text": "// Look on CoreMita"}
{"category": "LocationDialogue Location13", "line_index": 103, "text": "Attento, [player]."}
{"category": "LocationDialogue Location13", "line_index": 104, "text": "Ti sta osservando."}
{"category": "LocationDialogue Location13", "line_index": 105, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 106, "text": "Chi?"}
{"category": "LocationDialogue Location13", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 108, "text": "Non lo so nemmeno io..."}
{"category": "LocationDialogue Location13", "line_index": 109, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 110, "text": "Perfetto..."}
{"category": "LocationDialogue Location13", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 113, "text": "Che cos'è?"}
{"category": "LocationDialogue Location13", "line_index": 114, "text": "Ehi!"}
{"category": "LocationDialogue Location13", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 116, "text": "Credo di averlo trovato!"}
{"category": "LocationDialogue Location13", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 118, "text": "Fantastico! Sta andando tutto bene!"}
{"category": "LocationDialogue Location13", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 120, "text": "Ma devo specificare una versione."}
{"category": "LocationDialogue Location13", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 122, "text": "Giusto, la sua versione è..."}
{"category": "LocationDialogue Location13", "line_index": 123, "text": "0.98."}
{"category": "LocationDialogue Location13", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 125, "text": "Bingo!"}
{"category": "LocationDialogue Location13", "line_index": 126, "text": "Ok, e qual'è l'indice?"}
{"category": "LocationDialogue Location13", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 128, "text": "Uhm, indice?"}
{"category": "LocationDialogue Location13", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 130, "text": "Mi serve l'indice."}
{"category": "LocationDialogue Location13", "line_index": 131, "text": "Aspetta, non dirmi che non lo sai...?"}
{"category": "LocationDialogue Location13", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 134, "text": "Hmm, ha senso, però..."}
{"category": "LocationDialogue Location13", "line_index": 135, "text": "Ogni Mita ha un indice,"}
{"category": "LocationDialogue Location13", "line_index": 136, "text": "quindi non puoi semplicemente riavviare un'intera versione..."}
{"category": "LocationDialogue Location13", "line_index": 137, "text": "Questo causerebbe il caos più totale!"}
{"category": "LocationDialogue Location13", "line_index": 138, "text": "Non posso credere di non averci pensato..."}
{"category": "LocationDialogue Location13", "line_index": 139, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 144, "text": "// Answer 1 (What's wrong with you?)"}
{"category": "LocationDialogue Location13", "line_index": 145, "text": "Esclusi tutti i nostri problemi,"}
{"category": "LocationDialogue Location13", "line_index": 146, "text": "Sto benissimo."}
{"category": "LocationDialogue Location13", "line_index": 147, "text": "Tutto va bene, ma sono cambiate molte cose..."}
{"category": "LocationDialogue Location13", "line_index": 148, "text": "Ho bisogno di riflettere."}
{"category": "LocationDialogue Location13", "line_index": 149, "text": "Tutto qui."}
{"category": "LocationDialogue Location13", "line_index": 150, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 151, "text": "// Answer 2 (Maybe there's a way to get to know him?)"}
{"category": "LocationDialogue Location13", "line_index": 152, "text": "Io..."}
{"category": "LocationDialogue Location13", "line_index": 153, "text": "Credo... È una follia!"}
{"category": "LocationDialogue Location13", "line_index": 154, "text": "È una follia!"}
{"category": "LocationDialogue Location13", "line_index": 155, "text": "È come cercare un ago in un..."}
{"category": "LocationDialogue Location13", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 157, "text": "Cosa stai facendo?"}
{"category": "LocationDialogue Location13", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 159, "text": "Alcuni ostacoli si erodono con le informazioni,"}
{"category": "LocationDialogue Location13", "line_index": 160, "text": "come se il mondo fosse stato strappato via dalle viscere!"}
{"category": "LocationDialogue Location13", "line_index": 161, "text": "Registri, registri, registri, dati?"}
{"category": "LocationDialogue Location13", "line_index": 162, "text": "E se fosse tutto qui?"}
{"category": "LocationDialogue Location13", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 164, "text": "Che c'è? Qual è il problema?"}
{"category": "LocationDialogue Location13", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 166, "text": "Conosco un posto!"}
{"category": "LocationDialogue Location13", "line_index": 167, "text": "Aspetta qui."}
{"category": "LocationDialogue Location13", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 169, "text": "Dove stai andando?"}
{"category": "LocationDialogue Location13", "line_index": 170, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 171, "text": "// Answer 3 (What if we attack Mad Mita?)"}
{"category": "LocationDialogue Location13", "line_index": 172, "text": "Hai detto che qualsiasi Mita"}
{"category": "LocationDialogue Location13", "line_index": 173, "text": "si ripristina alle impostazioni di fabbrica alla morte..."}
{"category": "LocationDialogue Location13", "line_index": 174, "text": "E se noi..."}
{"category": "LocationDialogue Location13", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 176, "text": "uccidessimo Mita Folle?"}
{"category": "LocationDialogue Location13", "line_index": 177, "text": "Dici sul serio?"}
{"category": "LocationDialogue Location13", "line_index": 178, "text": "E come farai ad affrontare una pazza con la motosega?"}
{"category": "LocationDialogue Location13", "line_index": 179, "text": "Non usa solo coltelli per affettare le carote!"}
{"category": "LocationDialogue Location13", "line_index": 180, "text": "E per qualche motivo, è spaventosamente forte!"}
{"category": "LocationDialogue Location13", "line_index": 181, "text": "È un miracolo che siamo ancora vivi..."}
{"category": "LocationDialogue Location13", "line_index": 182, "text": "Forza, dobbiamo raggiungere il Nucleo."}
{"category": "LocationDialogue Location13", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 185, "text": "// core console entry"}
{"category": "LocationDialogue Location13", "line_index": 186, "text": "Devo inserire un codice..."}
{"category": "LocationDialogue Location13", "line_index": 187, "text": "Ma come faccio a conoscerlo?"}
{"category": "LocationDialogue Location13", "line_index": 188, "text": "Mita, lo sai?"}
{"category": "LocationDialogue Location13", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 190, "text": "Forse è scritto da qualche parte?"}
{"category": "LocationDialogue Location13", "line_index": 191, "text": "Potresti provare a cercarlo?"}
{"category": "LocationDialogue Location13", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 193, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location13", "line_index": 194, "text": "Probabilmente non è così."}
{"category": "LocationDialogue Location13", "line_index": 195, "text": "Non è nemmeno qui."}
{"category": "LocationDialogue Location13", "line_index": 196, "text": "No, sbagliato."}
{"category": "LocationDialogue Location13", "line_index": 197, "text": "Non è questo."}
{"category": "LocationDialogue Location13", "line_index": 198, "text": "Devo trovare l'opzione di riavvio del personaggio."}
{"category": "LocationDialogue Location13", "line_index": 199, "text": "// core console - nope version"}
{"category": "LocationDialogue Location13", "line_index": 200, "text": "È la versione sbagliata."}
{"category": "LocationDialogue Location13", "line_index": 201, "text": "Ops, errore mio."}
{"category": "LocationDialogue Location13", "line_index": 202, "text": "Non è questa."}
{"category": "LocationDialogue Location13", "line_index": 203, "text": "Non è quella giusta."}
{"category": "LocationDialogue Location13", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location13", "line_index": 205, "text": "C'è qualcosa di sbagliato"}
{"category": "LocationDialogue Location13", "line_index": 206, "text": "con l'indice."}
{"category": "LocationDialogue Location13", "line_index": 207, "text": "Devo cambiare l'indice,"}
{"category": "LocationDialogue Location13", "line_index": 208, "text": "non si adatta."}
{"category": "LocationDialogue Location13", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 210, "text": "// Answer 4 (Little people - Chibi)"}
{"category": "LocationDialogue Location13", "line_index": 211, "text": "Sai, mi sono imbattuto in un gruppo di"}
{"category": "LocationDialogue Location13", "line_index": 212, "text": "persone in miniatura sulla strada..."}
{"category": "LocationDialogue Location13", "line_index": 213, "text": "Cosa sono?"}
{"category": "LocationDialogue Location13", "line_index": 214, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 215, "text": "I Chibi?"}
{"category": "LocationDialogue Location13", "line_index": 216, "text": "Uhm, come spiegarlo...?"}
{"category": "LocationDialogue Location13", "line_index": 217, "text": "È un fenomeno qui..."}
{"category": "LocationDialogue Location13", "line_index": 218, "text": "Ogni Mita ha una proiezione Chibi,"}
{"category": "LocationDialogue Location13", "line_index": 219, "text": "e anche i giocatori possono averne..."}
{"category": "LocationDialogue Location13", "line_index": 220, "text": "Sapevi che noi Mita possiamo evocarli?"}
{"category": "LocationDialogue Location13", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 222, "text": "Come?"}
{"category": "LocationDialogue Location13", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 224, "text": "Guarda qui!"}
{"category": "LocationDialogue Location13", "line_index": 225, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 226, "text": "Proprio come per magia..."}
{"category": "LocationDialogue Location13", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 228, "text": "Ma c'è qualcosa che non va nelle mie Chibi,"}
{"category": "LocationDialogue Location13", "line_index": 229, "text": "la maggior parte nasce morta."}
{"category": "LocationDialogue Location13", "line_index": 230, "text": "C'è questa, però..."}
{"category": "LocationDialogue Location13", "line_index": 231, "text": "O beh..,"}
{"category": "LocationDialogue Location13", "line_index": 232, "text": "continua a girare in tondo."}
