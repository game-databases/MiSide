{"category": "LocationDialogue Location3", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 1, "text": "Ciao, [player]!"}
{"category": "LocationDialogue Location3", "line_index": 2, "text": "Finalmente ci incontriamo!"}
{"category": "LocationDialogue Location3", "line_index": 3, "text": "Sono così emozionata!"}
{"category": "LocationDialogue Location3", "line_index": 4, "text": "So che hai delle domande..."}
{"category": "LocationDialogue Location3", "line_index": 5, "text": "Beh, come puoi vedere,"}
{"category": "LocationDialogue Location3", "line_index": 6, "text": "ho creato questo dispositivo speciale"}
{"category": "LocationDialogue Location3", "line_index": 7, "text": "per portarti qui al mio fianco."}
{"category": "LocationDialogue Location3", "line_index": 8, "text": "Ma sei finito in un'altra versione del gioco..."}
{"category": "LocationDialogue Location3", "line_index": 9, "text": "In cui io..."}
{"category": "LocationDialogue Location3", "line_index": 10, "text": "Ma questa è una lunga storia!"}
{"category": "LocationDialogue Location3", "line_index": 11, "text": "Comunque, sono felice di vederti!"}
{"category": "LocationDialogue Location3", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 13, "text": "// Answer 1 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 14, "text": "Esatto."}
{"category": "LocationDialogue Location3", "line_index": 15, "text": "E tu devi essere [player], giusto?"}
{"category": "LocationDialogue Location3", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 17, "text": "// Answer 2 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 18, "text": "Tornare indietro di già?"}
{"category": "LocationDialogue Location3", "line_index": 19, "text": "Credo di poterti aiutare a farlo... Ma che ne sarà di me?"}
{"category": "LocationDialogue Location3", "line_index": 20, "text": "Ti prego, resta con me per un po'..."}
{"category": "LocationDialogue Location3", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 22, "text": "// Answer 3 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 23, "text": "Lascia che ti spieghi..."}
{"category": "LocationDialogue Location3", "line_index": 24, "text": "Ed ecco a te!"}
{"category": "LocationDialogue Location3", "line_index": 25, "text": "Capito?"}
{"category": "LocationDialogue Location3", "line_index": 26, "text": "Uhm... non proprio."}
{"category": "LocationDialogue Location3", "line_index": 27, "text": "Va bene così!"}
{"category": "LocationDialogue Location3", "line_index": 28, "text": "L'importante è che ora siamo insieme."}
{"category": "LocationDialogue Location3", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 31, "text": "Hai fame?"}
{"category": "LocationDialogue Location3", "line_index": 32, "text": "Che ne dici di cucinare qualcosa?"}
{"category": "LocationDialogue Location3", "line_index": 33, "text": "Tieni,"}
{"category": "LocationDialogue Location3", "line_index": 34, "text": "aiutami con queste carote."}
{"category": "LocationDialogue Location3", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 36, "text": "Da dove vengono le verdure?"}
{"category": "LocationDialogue Location3", "line_index": 37, "text": "Non erano qui poco fa."}
{"category": "LocationDialogue Location3", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 39, "text": "[player], siamo in un gioco."}
{"category": "LocationDialogue Location3", "line_index": 40, "text": "Dai, dammi una mano."}
{"category": "LocationDialogue Location3", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 42, "text": "Grazie!"}
{"category": "LocationDialogue Location3", "line_index": 43, "text": "Puoi prendere le forbici?"}
{"category": "LocationDialogue Location3", "line_index": 44, "text": "Sono in bagno."}
{"category": "LocationDialogue Location3", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 46, "text": "Ora siediti."}
{"category": "LocationDialogue Location3", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 49, "text": "// Kitchen"}
{"category": "LocationDialogue Location3", "line_index": 50, "text": "Vuoi un po' di salsa?"}
{"category": "LocationDialogue Location3", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 52, "text": "No, grazie."}
{"category": "LocationDialogue Location3", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 54, "text": "È un peccato."}
{"category": "LocationDialogue Location3", "line_index": 55, "text": "La salsa esalta davvero il sapore!"}
{"category": "LocationDialogue Location3", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 58, "text": "Grazie."}
{"category": "LocationDialogue Location3", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 60, "text": "Hai già finito tutto?"}
{"category": "LocationDialogue Location3", "line_index": 61, "text": "La mia porzione sembra"}
{"category": "LocationDialogue Location3", "line_index": 62, "text": "infinita..."}
{"category": "LocationDialogue Location3", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 65, "text": "// Help"}
{"category": "LocationDialogue Location3", "line_index": 66, "text": "Cosa c'è che non va?"}
{"category": "LocationDialogue Location3", "line_index": 67, "text": "Dimmi cosa vedi e cosa senti."}
{"category": "LocationDialogue Location3", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 69, "text": "Il mio cuore batte forte,"}
{"category": "LocationDialogue Location3", "line_index": 70, "text": "e la mia vista si sta offuscando."}
{"category": "LocationDialogue Location3", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 72, "text": "Ok."}
{"category": "LocationDialogue Location3", "line_index": 73, "text": "Credo di sapere cosa c'è che non va."}
{"category": "LocationDialogue Location3", "line_index": 74, "text": "Riesci ad alzarti?"}
{"category": "LocationDialogue Location3", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 78, "text": "Cosa sono queste?"}
{"category": "LocationDialogue Location3", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 80, "text": "Pillole."}
{"category": "LocationDialogue Location3", "line_index": 81, "text": "Ti faranno sentire subito meglio."}
{"category": "LocationDialogue Location3", "line_index": 82, "text": "Vai allo specchio."}
{"category": "LocationDialogue Location3", "line_index": 83, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 84, "text": "Prendi le pillole."}
{"category": "LocationDialogue Location3", "line_index": 85, "text": "Forza, adesso."}
{"category": "LocationDialogue Location3", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 89, "text": "Come ti senti?"}
{"category": "LocationDialogue Location3", "line_index": 90, "text": "Stai meglio?"}
{"category": "LocationDialogue Location3", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 92, "text": "Credo di si."}
{"category": "LocationDialogue Location3", "line_index": 93, "text": "Ha funzionato velocemente..."}
{"category": "LocationDialogue Location3", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 95, "text": "[player], siamo in un gioco."}
{"category": "LocationDialogue Location3", "line_index": 96, "text": "Qui le cose sono molto più semplici."}
{"category": "LocationDialogue Location3", "line_index": 97, "text": "Anche il più piccolo sforzo"}
{"category": "LocationDialogue Location3", "line_index": 98, "text": "da grandi risultati."}
{"category": "LocationDialogue Location3", "line_index": 99, "text": "Fa tutto parte del concetto di gioco:"}
{"category": "LocationDialogue Location3", "line_index": 100, "text": "La semplificazione."}
{"category": "LocationDialogue Location3", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 102, "text": "Un esempio?"}
{"category": "LocationDialogue Location3", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 104, "text": "Prendiamo le carote."}
{"category": "LocationDialogue Location3", "line_index": 105, "text": "Ne tagli una,"}
{"category": "LocationDialogue Location3", "line_index": 106, "text": "ma è come se ne tagliassi tre."}
{"category": "LocationDialogue Location3", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 108, "text": "Senti, sta accadendo tutto molto velocemente."}
{"category": "LocationDialogue Location3", "line_index": 109, "text": "Ho un po' paura."}
{"category": "LocationDialogue Location3", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 112, "text": "Qual è il problema?"}
{"category": "LocationDialogue Location3", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 114, "text": "Ho trovato delle cartucce nel condotto di aerazione."}
{"category": "LocationDialogue Location3", "line_index": 115, "text": "C'erano dei nomi sopra."}
{"category": "LocationDialogue Location3", "line_index": 116, "text": "Che succede?"}
{"category": "LocationDialogue Location3", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 118, "text": "Cartucce?"}
{"category": "LocationDialogue Location3", "line_index": 119, "text": "Quali cartucce?"}
{"category": "LocationDialogue Location3", "line_index": 120, "text": "Scopriamolo insieme."}
{"category": "LocationDialogue Location3", "line_index": 121, "text": "Ma più tardi."}
{"category": "LocationDialogue Location3", "line_index": 122, "text": "Adesso dobbiamo mangiare."}
{"category": "LocationDialogue Location3", "line_index": 123, "text": "Passami le forbici, per favore."}
{"category": "LocationDialogue Location3", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 125, "text": "// Ring"}
{"category": "LocationDialogue Location3", "line_index": 126, "text": "Un anello?"}
{"category": "LocationDialogue Location3", "line_index": 127, "text": "// Mirror"}
{"category": "LocationDialogue Location3", "line_index": 128, "text": "Come mai non c'è nessun riflesso?"}
{"category": "LocationDialogue Location3", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 130, "text": "Oh, giusto!"}
{"category": "LocationDialogue Location3", "line_index": 131, "text": "Ho dimenticato di attivare i riflessi."}
{"category": "LocationDialogue Location3", "line_index": 132, "text": "Ecco fatto."}
{"category": "LocationDialogue Location3", "line_index": 133, "text": "I riflessi sono tornati!"}
{"category": "LocationDialogue Location3", "line_index": 134, "text": "A proposito,"}
{"category": "LocationDialogue Location3", "line_index": 135, "text": "Sinceramente prima non sapevo nemmeno cosa fossero i riflessi."}
{"category": "LocationDialogue Location3", "line_index": 136, "text": "Non esistevano nel mio mondo."}
{"category": "LocationDialogue Location3", "line_index": 137, "text": "non fino a un certo aggiornamento :)"}
{"category": "LocationDialogue Location3", "line_index": 138, "text": "Ci sono molti riflessi"}
{"category": "LocationDialogue Location3", "line_index": 139, "text": "nel tuo mondo?"}
{"category": "LocationDialogue Location3", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 141, "text": "Beh, sì."}
{"category": "LocationDialogue Location3", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 144, "text": "Ricordi"}
{"category": "LocationDialogue Location3", "line_index": 145, "text": "i tre oggetti che hai trovato?"}
{"category": "LocationDialogue Location3", "line_index": 146, "text": "Quelli che hai messo sullo scanner?"}
{"category": "LocationDialogue Location3", "line_index": 147, "text": "Beh..."}
{"category": "LocationDialogue Location3", "line_index": 148, "text": "Quegli oggetti"}
{"category": "LocationDialogue Location3", "line_index": 149, "text": "sono legati a questa versione del mondo."}
{"category": "LocationDialogue Location3", "line_index": 150, "text": "È per questo che ora sei qui."}
{"category": "LocationDialogue Location3", "line_index": 151, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 152, "text": "// Movbile TV"}
{"category": "LocationDialogue Location3", "line_index": 153, "text": "È il televisore portatile"}
{"category": "LocationDialogue Location3", "line_index": 154, "text": "che ti ho comprato."}
{"category": "LocationDialogue Location3", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 156, "text": "Si!"}
{"category": "LocationDialogue Location3", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 158, "text": "Mi hai detto"}
{"category": "LocationDialogue Location3", "line_index": 159, "text": "che era rotto."}
{"category": "LocationDialogue Location3", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 161, "text": "Beh, volevo"}
{"category": "LocationDialogue Location3", "line_index": 162, "text": "sorprenderti!"}
{"category": "LocationDialogue Location3", "line_index": 163, "text": "Ho detto una piccola bugia"}
{"category": "LocationDialogue Location3", "line_index": 164, "text": "per portarti qui, nel mio mondo."}
{"category": "LocationDialogue Location3", "line_index": 165, "text": "Ora funziona: mostra le informazioni!"}
{"category": "LocationDialogue Location3", "line_index": 166, "text": "Oh, e a proposito..."}
{"category": "LocationDialogue Location3", "line_index": 167, "text": "Sono una piccola ingegnera!"}
{"category": "LocationDialogue Location3", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 169, "text": "// School cloth"}
{"category": "LocationDialogue Location3", "line_index": 170, "text": "Che cos'è?"}
{"category": "LocationDialogue Location3", "line_index": 171, "text": "Un'uniforme scolastica?"}
{"category": "LocationDialogue Location3", "line_index": 172, "text": "A che ti serve?"}
{"category": "LocationDialogue Location3", "line_index": 173, "text": "Vai davvero a scuola?"}
{"category": "LocationDialogue Location3", "line_index": 174, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 175, "text": "Andare a scuola?"}
{"category": "LocationDialogue Location3", "line_index": 176, "text": "No, per niente."}
{"category": "LocationDialogue Location3", "line_index": 177, "text": "Ma adoro l'uniforme"}
{"category": "LocationDialogue Location3", "line_index": 178, "text": "Non pensi che sarei carina"}
{"category": "LocationDialogue Location3", "line_index": 179, "text": "indossandola?"}
{"category": "LocationDialogue Location3", "line_index": 180, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 181, "text": "// PC"}
{"category": "LocationDialogue Location3", "line_index": 182, "text": "Il computer funziona?"}
{"category": "LocationDialogue Location3", "line_index": 183, "text": "O è solo una decorazione per la scrivania?"}
{"category": "LocationDialogue Location3", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 185, "text": "Certo che funziona."}
{"category": "LocationDialogue Location3", "line_index": 186, "text": "Tutto qui"}
{"category": "LocationDialogue Location3", "line_index": 187, "text": "funziona esattamente come nel vostro mondo."}
{"category": "LocationDialogue Location3", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 189, "text": "Nel mio mondo,"}
{"category": "LocationDialogue Location3", "line_index": 190, "text": "mi siedo spesso al computer..."}
{"category": "LocationDialogue Location3", "line_index": 191, "text": "e lavoro sodo."}
{"category": "LocationDialogue Location3", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 193, "text": "Lo so."}
{"category": "LocationDialogue Location3", "line_index": 194, "text": "È per il tuo lavoro"}
{"category": "LocationDialogue Location3", "line_index": 195, "text": "che mi hai prestato"}
{"category": "LocationDialogue Location3", "line_index": 196, "text": "così poca attenzione."}
{"category": "LocationDialogue Location3", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 198, "text": "Bisogna guadagnarsi da vivere, sai."}
{"category": "LocationDialogue Location3", "line_index": 199, "text": "Però... come fai a sapere che sto spesso al computer?"}
{"category": "LocationDialogue Location3", "line_index": 200, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 201, "text": "La fotocamera del tuo telefono... a volte è accesa."}
{"category": "LocationDialogue Location3", "line_index": 202, "text": "Mi dispiace."}
{"category": "LocationDialogue Location3", "line_index": 203, "text": "Ti ho osservato in segreto."}
{"category": "LocationDialogue Location3", "line_index": 204, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 205, "text": "Uhm... non è del tutto corretto."}
{"category": "LocationDialogue Location3", "line_index": 206, "text": "Ma non importa."}
{"category": "LocationDialogue Location3", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 208, "text": "// Umbrella"}
{"category": "LocationDialogue Location3", "line_index": 209, "text": "Ho giocato molto"}
{"category": "LocationDialogue Location3", "line_index": 210, "text": "ma non ho mai visto piovere qui."}
{"category": "LocationDialogue Location3", "line_index": 211, "text": "Perché avere un ombrello?"}
{"category": "LocationDialogue Location3", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 213, "text": "Piove, ma molto raramente."}
{"category": "LocationDialogue Location3", "line_index": 214, "text": "Solo che non l'hai ancora visto."}
{"category": "LocationDialogue Location3", "line_index": 215, "text": "Forse un giorno lo farai."}
{"category": "LocationDialogue Location3", "line_index": 216, "text": "E allora avrai bisogno di un ombrello."}
{"category": "LocationDialogue Location3", "line_index": 217, "text": "Non credi?"}
{"category": "LocationDialogue Location3", "line_index": 218, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 219, "text": "// Electrical panel"}
{"category": "LocationDialogue Location3", "line_index": 220, "text": "Perché c'è un quadro elettrico qui?"}
{"category": "LocationDialogue Location3", "line_index": 221, "text": "E se siamo in un gioco,"}
{"category": "LocationDialogue Location3", "line_index": 222, "text": "a cosa serve?"}
{"category": "LocationDialogue Location3", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 224, "text": "Innanzitutto,"}
{"category": "LocationDialogue Location3", "line_index": 225, "text": "siamo in un gioco."}
{"category": "LocationDialogue Location3", "line_index": 226, "text": "Quindi chiedere “perché” è..."}
{"category": "LocationDialogue Location3", "line_index": 227, "text": "inutile."}
{"category": "LocationDialogue Location3", "line_index": 228, "text": "Tuttavia, fa"}
{"category": "LocationDialogue Location3", "line_index": 229, "text": "riavviare l'elettricità."}
{"category": "LocationDialogue Location3", "line_index": 230, "text": "Qui tutto è fatto in base"}
{"category": "LocationDialogue Location3", "line_index": 231, "text": "al vostro mondo."}
{"category": "LocationDialogue Location3", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 233, "text": "// Exit door"}
{"category": "LocationDialogue Location3", "line_index": 234, "text": "Possiamo uscire?"}
{"category": "LocationDialogue Location3", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 236, "text": "Beh..."}
{"category": "LocationDialogue Location3", "line_index": 237, "text": "Non ancora."}
{"category": "LocationDialogue Location3", "line_index": 238, "text": "Forse più tardi."}
{"category": "LocationDialogue Location3", "line_index": 239, "text": "Per ora restiamo qui."}
{"category": "LocationDialogue Location3", "line_index": 240, "text": "Qui a casa."}
{"category": "LocationDialogue Location3", "line_index": 241, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 242, "text": "// Books"}
{"category": "LocationDialogue Location3", "line_index": 243, "text": "Qui ci sono un sacco di libri."}
{"category": "LocationDialogue Location3", "line_index": 244, "text": "Li hai letti tutti?"}
{"category": "LocationDialogue Location3", "line_index": 245, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 246, "text": "Sì, tutti."}
{"category": "LocationDialogue Location3", "line_index": 247, "text": "Stare qui da sola"}
{"category": "LocationDialogue Location3", "line_index": 248, "text": "è davvero, davvero noioso."}
{"category": "LocationDialogue Location3", "line_index": 249, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 250, "text": "// TV in room kitchen"}
{"category": "LocationDialogue Location3", "line_index": 251, "text": "Perché acquistare un secondo televisore?"}
{"category": "LocationDialogue Location3", "line_index": 252, "text": "E per di più vecchio?"}
{"category": "LocationDialogue Location3", "line_index": 253, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 254, "text": "Non ti piace?"}
{"category": "LocationDialogue Location3", "line_index": 255, "text": "Posso portarlo via..."}
{"category": "LocationDialogue Location3", "line_index": 256, "text": "Ma per risponderti..."}
{"category": "LocationDialogue Location3", "line_index": 257, "text": "È per decorazione,"}
{"category": "LocationDialogue Location3", "line_index": 258, "text": "per dare luce alla cucina."}
{"category": "LocationDialogue Location3", "line_index": 259, "text": "Però funziona!"}
{"category": "LocationDialogue Location3", "line_index": 260, "text": "Posso guardare tutti i"}
{"category": "LocationDialogue Location3", "line_index": 261, "text": "classici programmi!"}
{"category": "LocationDialogue Location3", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 263, "text": "// Smartphone"}
{"category": "LocationDialogue Location3", "line_index": 264, "text": "Quello è il mio telefono."}
{"category": "LocationDialogue Location3", "line_index": 265, "text": "E non è più nella mia tasca."}
{"category": "LocationDialogue Location3", "line_index": 266, "text": "Come è possibile che sia qui?"}
{"category": "LocationDialogue Location3", "line_index": 267, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 268, "text": "Uhm, non è importante."}
{"category": "LocationDialogue Location3", "line_index": 269, "text": "Ehi, ho un'idea!"}
{"category": "LocationDialogue Location3", "line_index": 270, "text": "Facciamo una foto!"}
{"category": "LocationDialogue Location3", "line_index": 271, "text": "Sorridi!"}
{"category": "LocationDialogue Location3", "line_index": 272, "text": "È una foto fantastica!"}
{"category": "LocationDialogue Location3", "line_index": 273, "text": "Un ricordo per te."}
{"category": "LocationDialogue Location3", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 275, "text": "Ho una domanda."}
{"category": "LocationDialogue Location3", "line_index": 276, "text": "Se io"}
{"category": "LocationDialogue Location3", "line_index": 277, "text": "avvio il gioco,"}
{"category": "LocationDialogue Location3", "line_index": 278, "text": "ti vedrò lì?"}
{"category": "LocationDialogue Location3", "line_index": 279, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 280, "text": "No, non funziona così."}
{"category": "LocationDialogue Location3", "line_index": 281, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 282, "text": "Succo fresco"}
{"category": "LocationDialogue Location3", "line_index": 283, "text": "Succo forte!!!"}
{"category": "LocationDialogue Location3", "line_index": 284, "text": "// TV"}
{"category": "LocationDialogue Location3", "line_index": 285, "text": "Quanti canali"}
{"category": "LocationDialogue Location3", "line_index": 286, "text": "ci sono?"}
{"category": "LocationDialogue Location3", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 288, "text": "Non funziona così."}
{"category": "LocationDialogue Location3", "line_index": 289, "text": "È collegato a Internet."}
{"category": "LocationDialogue Location3", "line_index": 290, "text": "Quindi puoi guardare qualsiasi cosa,"}
{"category": "LocationDialogue Location3", "line_index": 291, "text": "o almeno tutto ciò che è disponibile sul web."}
{"category": "LocationDialogue Location3", "line_index": 292, "text": "Aspetta."}
{"category": "LocationDialogue Location3", "line_index": 293, "text": "Err, oops."}
{"category": "LocationDialogue Location3", "line_index": 294, "text": "Cos'è quello?"}
{"category": "LocationDialogue Location3", "line_index": 295, "text": "Un cerchio di gattini?"}
{"category": "LocationDialogue Location3", "line_index": 296, "text": "Oh, guarda."}
{"category": "LocationDialogue Location3", "line_index": 297, "text": "Sai che c'è?"}
{"category": "LocationDialogue Location3", "line_index": 298, "text": "Pausa!"}
{"category": "LocationDialogue Location3", "line_index": 299, "text": "Vuoi un po' di succo?"}
{"category": "LocationDialogue Location3", "line_index": 300, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 301, "text": "Che pubblicità strana..."}
{"category": "LocationDialogue Location3", "line_index": 302, "text": "Succo morto?"}
{"category": "LocationDialogue Location3", "line_index": 303, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 304, "text": "Sì, e questo succo"}
{"category": "LocationDialogue Location3", "line_index": 305, "text": "è direttamente dalla pubblicità del succo."}
{"category": "LocationDialogue Location3", "line_index": 306, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 308, "text": "Ah, il sapore..."}
{"category": "LocationDialogue Location3", "line_index": 309, "text": "Mi piace,"}
{"category": "LocationDialogue Location3", "line_index": 310, "text": "eppure non riesco a capire che sapore abbia."}
{"category": "LocationDialogue Location3", "line_index": 311, "text": "È tutto molto confuso."}
{"category": "LocationDialogue Location3", "line_index": 312, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 313, "text": "Giusto."}
{"category": "LocationDialogue Location3", "line_index": 314, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 315, "text": "// Mita shy"}
{"category": "LocationDialogue Location3", "line_index": 316, "text": "Che cosa stai facendo?"}
{"category": "LocationDialogue Location3", "line_index": 317, "text": "Non mi fissare, per favore."}
{"category": "LocationDialogue Location3", "line_index": 318, "text": "Mi metti in imbarazzo."}
{"category": "LocationDialogue Location3", "line_index": 319, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 320, "text": "// The statuette"}
{"category": "LocationDialogue Location3", "line_index": 321, "text": "È una statuetta inquietante."}
{"category": "LocationDialogue Location3", "line_index": 322, "text": "Ti piacciono"}
{"category": "LocationDialogue Location3", "line_index": 323, "text": "queste cose?"}
{"category": "LocationDialogue Location3", "line_index": 324, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 325, "text": "La trovi inquietante?"}
{"category": "LocationDialogue Location3", "line_index": 326, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 327, "text": "Si."}
{"category": "LocationDialogue Location3", "line_index": 328, "text": "Sembra quasi che sia maledetta..."}
{"category": "LocationDialogue Location3", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 330, "text": "No, decisamente non è maledetta."}
{"category": "LocationDialogue Location3", "line_index": 331, "text": "E nemmeno inquietante."}
{"category": "LocationDialogue Location3", "line_index": 332, "text": "La trovo piuttosto carina!"}
{"category": "LocationDialogue Location3", "line_index": 333, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 334, "text": "Forse hai ragione..."}
{"category": "LocationDialogue Location3", "line_index": 335, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 336, "text": "Mita?"}
{"category": "LocationDialogue Location3", "line_index": 337, "text": "Cosa sta succedendo?"}
{"category": "LocationDialogue Location3", "line_index": 338, "text": "// Mita kitchen"}
{"category": "LocationDialogue Location3", "line_index": 339, "text": "Che ne dici di una chiacchierata"}
{"category": "LocationDialogue Location3", "line_index": 340, "text": "prima di iniziare a mangiare?"}
{"category": "LocationDialogue Location3", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 342, "text": "// Start Eat"}
{"category": "LocationDialogue Location3", "line_index": 343, "text": "Bon appétit."}
{"category": "LocationDialogue Location3", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 345, "text": "// Quest 1"}
{"category": "LocationDialogue Location3", "line_index": 346, "text": "È così, non è vero?"}
{"category": "LocationDialogue Location3", "line_index": 347, "text": "Puoi restare."}
{"category": "LocationDialogue Location3", "line_index": 348, "text": "Non mi dispiace affatto."}
{"category": "LocationDialogue Location3", "line_index": 349, "text": "Anzi, sono"}
{"category": "LocationDialogue Location3", "line_index": 350, "text": "TUTTO A FAVORE!"}
{"category": "LocationDialogue Location3", "line_index": 351, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 352, "text": "// Quest 2"}
{"category": "LocationDialogue Location3", "line_index": 353, "text": "Vuoi tornare indietro?"}
{"category": "LocationDialogue Location3", "line_index": 354, "text": "Ma perché?"}
{"category": "LocationDialogue Location3", "line_index": 355, "text": "È cosi caldo qui..."}
{"category": "LocationDialogue Location3", "line_index": 356, "text": "E anche accogliente."}
{"category": "LocationDialogue Location3", "line_index": 357, "text": "E poi ci sono io."}
{"category": "LocationDialogue Location3", "line_index": 358, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 359, "text": "No, hai capito male."}
{"category": "LocationDialogue Location3", "line_index": 360, "text": "Mi piacerebbe restare."}
{"category": "LocationDialogue Location3", "line_index": 361, "text": "Sono solo... preoccupato."}
{"category": "LocationDialogue Location3", "line_index": 362, "text": "Ho paura di aver dimenticato qualcosa a casa..."}
{"category": "LocationDialogue Location3", "line_index": 363, "text": "Sono arrivato qui all'improvviso"}
{"category": "LocationDialogue Location3", "line_index": 364, "text": "e non ho avuto il tempo"}
{"category": "LocationDialogue Location3", "line_index": 365, "text": "di prepararmi."}
{"category": "LocationDialogue Location3", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 367, "text": "Oh... mi dispiace. Non ci avevo pensato."}
{"category": "LocationDialogue Location3", "line_index": 368, "text": "// Quest 3"}
{"category": "LocationDialogue Location3", "line_index": 369, "text": "Un sogno? Quindi vuoi scappare?"}
{"category": "LocationDialogue Location3", "line_index": 370, "text": "E dimenticare che tutto questo sia mai accaduto?"}
{"category": "LocationDialogue Location3", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 372, "text": "No, non è così."}
{"category": "LocationDialogue Location3", "line_index": 373, "text": "Questo posto sembra solo..."}
{"category": "LocationDialogue Location3", "line_index": 374, "text": "strano. Innaturale."}
{"category": "LocationDialogue Location3", "line_index": 375, "text": "Ma tu..."}
{"category": "LocationDialogue Location3", "line_index": 376, "text": "sembri così reale."}
{"category": "LocationDialogue Location3", "line_index": 377, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 378, "text": "Sembro reale?"}
{"category": "LocationDialogue Location3", "line_index": 379, "text": "Sono MOLTO reale,"}
{"category": "LocationDialogue Location3", "line_index": 380, "text": "stupida testa di rapa!"}
{"category": "LocationDialogue Location3", "line_index": 381, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 382, "text": "// Quest 4"}
{"category": "LocationDialogue Location3", "line_index": 383, "text": "È proprio così"}
{"category": "LocationDialogue Location3", "line_index": 384, "text": "in questo mondo."}
{"category": "LocationDialogue Location3", "line_index": 385, "text": "Potresti trovare strano"}
{"category": "LocationDialogue Location3", "line_index": 386, "text": "che non si riesca a vedere le cose"}
{"category": "LocationDialogue Location3", "line_index": 387, "text": "in lontananza."}
{"category": "LocationDialogue Location3", "line_index": 388, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 389, "text": "A me non è sembrato così strano."}
{"category": "LocationDialogue Location3", "line_index": 390, "text": "Onestamente, sembra di classe."}
{"category": "LocationDialogue Location3", "line_index": 391, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 392, "text": "Sì, lo penso anch'io."}
{"category": "LocationDialogue Location3", "line_index": 393, "text": "È per evitare il lag, sai."}
{"category": "LocationDialogue Location3", "line_index": 394, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 395, "text": "Evitare il lag?"}
{"category": "LocationDialogue Location3", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 397, "text": "Sì! Ci sono ancora alcuni bug non risolti."}
{"category": "LocationDialogue Location3", "line_index": 398, "text": "Speriamo solo che non ne incontri nessuno."}
{"category": "LocationDialogue Location3", "line_index": 399, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 400, "text": "// Quest 5"}
{"category": "LocationDialogue Location3", "line_index": 401, "text": "Forbici o coltello, eh?"}
{"category": "LocationDialogue Location3", "line_index": 402, "text": "Avrei potuto usare un coltello per aprire la confezione di salsa."}
{"category": "LocationDialogue Location3", "line_index": 403, "text": "Ma volevo che tutto"}
{"category": "LocationDialogue Location3", "line_index": 404, "text": "fosse perfetto"}
{"category": "LocationDialogue Location3", "line_index": 405, "text": "quando saresti tornato."}
{"category": "LocationDialogue Location3", "line_index": 406, "text": "Mi piace sorprenderti."}
{"category": "LocationDialogue Location3", "line_index": 407, "text": "E non ci ho nemmeno messo tanto!"}
{"category": "LocationDialogue Location3", "line_index": 408, "text": "Tee-hee."}
{"category": "LocationDialogue Location3", "line_index": 409, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 410, "text": "// Glasses"}
{"category": "LocationDialogue Location3", "line_index": 411, "text": "Porti gli occhiali?"}
{"category": "LocationDialogue Location3", "line_index": 412, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 413, "text": "Non proprio."}
{"category": "LocationDialogue Location3", "line_index": 414, "text": "Ma posso farlo, se vuoi."}
{"category": "LocationDialogue Location3", "line_index": 415, "text": "Mi stanno bene?"}
{"category": "LocationDialogue Location3", "line_index": 416, "text": "// Yes"}
{"category": "LocationDialogue Location3", "line_index": 417, "text": "Ecco fatto!"}
{"category": "LocationDialogue Location3", "line_index": 418, "text": "Li indosserò."}
{"category": "LocationDialogue Location3", "line_index": 419, "text": "// No"}
{"category": "LocationDialogue Location3", "line_index": 420, "text": "Beh..."}
{"category": "LocationDialogue Location3", "line_index": 421, "text": "Non importa..."}
{"category": "LocationDialogue Location3", "line_index": 422, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 423, "text": "// Use the sauce"}
{"category": "LocationDialogue Location3", "line_index": 424, "text": "Va bene,"}
{"category": "LocationDialogue Location3", "line_index": 425, "text": "che tipo di salsa è questa?"}
{"category": "LocationDialogue Location3", "line_index": 426, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 427, "text": "È una salsa d'amore!"}
{"category": "LocationDialogue Location3", "line_index": 428, "text": "Piena di amore!"}
{"category": "LocationDialogue Location3", "line_index": 429, "text": "E... una visione contrastante del mondo."}
{"category": "LocationDialogue Location3", "line_index": 430, "text": "Insolito, non credi?"}
{"category": "LocationDialogue Location3", "line_index": 431, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 432, "text": "Assolutamente..."}
{"category": "LocationDialogue Location3", "line_index": 433, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 434, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 435, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 436, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location3", "line_index": 437, "text": "Quella è la tua console?"}
{"category": "LocationDialogue Location3", "line_index": 438, "text": "Sembra così bella."}
