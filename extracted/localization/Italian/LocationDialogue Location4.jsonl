{"category": "LocationDialogue Location4", "line_index": 0, "text": "Mita?"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "Ah, già sveglio?"}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "Come sei arrivata qui?"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": "Eri accanto a me un attimo fa."}
{"category": "LocationDialogue Location4", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 5, "text": "No, non ero li."}
{"category": "LocationDialogue Location4", "line_index": 6, "text": "Ti sei bloccato davanti allo specchio."}
{"category": "LocationDialogue Location4", "line_index": 7, "text": "Cosi me ne sono andata."}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "Perché la disposizione delle stanze sono cambiate?"}
{"category": "LocationDialogue Location4", "line_index": 9, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "Ho riorganizzato il posto"}
{"category": "LocationDialogue Location4", "line_index": 11, "text": "per farti sentire più a casa."}
{"category": "LocationDialogue Location4", "line_index": 12, "text": "Qui,"}
{"category": "LocationDialogue Location4", "line_index": 13, "text": "possiamo cambiare le stanze"}
{"category": "LocationDialogue Location4", "line_index": 14, "text": "Come vogliamo."}
{"category": "LocationDialogue Location4", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 16, "text": "Non dovevi."}
{"category": "LocationDialogue Location4", "line_index": 17, "text": "Mi stavo abituando alla disposizione."}
{"category": "LocationDialogue Location4", "line_index": 18, "text": "In ogni caso, credo che ti sentirai più a tuo agio con questa disposizione."}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Mita card game"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "Allora,"}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "vogliamo giocare?"}
{"category": "LocationDialogue Location4", "line_index": 22, "text": "Il gioco funziona in questo modo:"}
{"category": "LocationDialogue Location4", "line_index": 23, "text": "Questa moneta indica un tipo,"}
{"category": "LocationDialogue Location4", "line_index": 24, "text": "ad esempio la salute."}
{"category": "LocationDialogue Location4", "line_index": 25, "text": "Ognuno di noi gioca una carta,"}
{"category": "LocationDialogue Location4", "line_index": 26, "text": "e se la propria carta ha un valore di"}
{"category": "LocationDialogue Location4", "line_index": 27, "text": "Salute"}
{"category": "LocationDialogue Location4", "line_index": 28, "text": "più alta dell'altro,"}
{"category": "LocationDialogue Location4", "line_index": 29, "text": "vince."}
{"category": "LocationDialogue Location4", "line_index": 30, "text": "Pesca le tue carte."}
{"category": "LocationDialogue Location4", "line_index": 31, "text": "È il mio turno."}
{"category": "LocationDialogue Location4", "line_index": 32, "text": "Whoa!"}
{"category": "LocationDialogue Location4", "line_index": 33, "text": "Ho una bella mano!"}
{"category": "LocationDialogue Location4", "line_index": 34, "text": "Comincio io!"}
{"category": "LocationDialogue Location4", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 44, "text": "OK!"}
{"category": "LocationDialogue Location4", "line_index": 45, "text": "Tocca a te!"}
{"category": "LocationDialogue Location4", "line_index": 46, "text": "Uh-huh."}
{"category": "LocationDialogue Location4", "line_index": 47, "text": "E' il tuo turno!"}
{"category": "LocationDialogue Location4", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 49, "text": "Vince chi ha la salute più alta!"}
{"category": "LocationDialogue Location4", "line_index": 50, "text": "E' tutta una questione di attacco!"}
{"category": "LocationDialogue Location4", "line_index": 51, "text": "Concentrati sulla difesa!"}
{"category": "LocationDialogue Location4", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 54, "text": "Hai vinto!"}
{"category": "LocationDialogue Location4", "line_index": 55, "text": "hai vinto!"}
{"category": "LocationDialogue Location4", "line_index": 56, "text": "Me l'hai fatta."}
{"category": "LocationDialogue Location4", "line_index": 57, "text": "Oh tu..."}
{"category": "LocationDialogue Location4", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 59, "text": "Ho vinto!"}
{"category": "LocationDialogue Location4", "line_index": 60, "text": "Sono io la vincitrice!"}
{"category": "LocationDialogue Location4", "line_index": 61, "text": "Ho vinto!"}
{"category": "LocationDialogue Location4", "line_index": 62, "text": "Hah, ti ho fregato!"}
{"category": "LocationDialogue Location4", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 64, "text": "E' un pareggio."}
{"category": "LocationDialogue Location4", "line_index": 65, "text": "Stesso risultato!"}
{"category": "LocationDialogue Location4", "line_index": 66, "text": "Questo è un pareggio!"}
{"category": "LocationDialogue Location4", "line_index": 67, "text": "Lo stesso valore..."}
{"category": "LocationDialogue Location4", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 79, "text": "// The card game is interrupted"}
{"category": "LocationDialogue Location4", "line_index": 80, "text": "Cos'è questo rumore?"}
{"category": "LocationDialogue Location4", "line_index": 81, "text": "Viene dall'armadio."}
{"category": "LocationDialogue Location4", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 83, "text": "Rumore?"}
{"category": "LocationDialogue Location4", "line_index": 84, "text": "Quale rumore?"}
{"category": "LocationDialogue Location4", "line_index": 85, "text": "Non ho sentito nulla."}
{"category": "LocationDialogue Location4", "line_index": 86, "text": "Cosa ti è sembrato di sentire?"}
{"category": "LocationDialogue Location4", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 88, "text": "Ho sentito bussare, come se ci fosse qualcuno dentro."}
{"category": "LocationDialogue Location4", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 90, "text": "Ma..."}
{"category": "LocationDialogue Location4", "line_index": 91, "text": "Non c'è nessuno..."}
{"category": "LocationDialogue Location4", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 93, "text": "Vorrei aprire e controllare."}
{"category": "LocationDialogue Location4", "line_index": 94, "text": "Sono un po' spaventato."}
{"category": "LocationDialogue Location4", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 96, "text": "Ma perchè...?"}
{"category": "LocationDialogue Location4", "line_index": 97, "text": "Questo di nuovo..."}
{"category": "LocationDialogue Location4", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 105, "text": "Che ti prende!?"}
{"category": "LocationDialogue Location4", "line_index": 106, "text": "E' un armadio..."}
{"category": "LocationDialogue Location4", "line_index": 107, "text": "Ho la mia biancheria intima li...!"}
{"category": "LocationDialogue Location4", "line_index": 108, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 109, "text": "Mi stai nascondendo qualcosa?"}
{"category": "LocationDialogue Location4", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 111, "text": "Perchè non puoi semplicemente credermi?"}
{"category": "LocationDialogue Location4", "line_index": 112, "text": "Cosa sto facendo di male?"}
{"category": "LocationDialogue Location4", "line_index": 113, "text": "Quello che voglio..."}
{"category": "LocationDialogue Location4", "line_index": 114, "text": "Tutto quello che voglio è che tu stia con me."}
{"category": "LocationDialogue Location4", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 116, "text": "Mi piacerebbe, ma comunque...?"}
{"category": "LocationDialogue Location4", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 118, "text": "Perchè ti sei fissato con questo armadio?!"}
{"category": "LocationDialogue Location4", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 120, "text": "Voglio sapere cosa diavolo era quel rumore!"}
{"category": "LocationDialogue Location4", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 122, "text": "E' perchè"}
{"category": "LocationDialogue Location4", "line_index": 123, "text": "questo mondo"}
{"category": "LocationDialogue Location4", "line_index": 124, "text": "ha solo quattro stanze?"}
{"category": "LocationDialogue Location4", "line_index": 125, "text": "Non sono abbastanza per te?"}
{"category": "LocationDialogue Location4", "line_index": 126, "text": "Perchè non puoi stare con me?"}
{"category": "LocationDialogue Location4", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 129, "text": "// Don't stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 130, "text": "Ho capito."}
{"category": "LocationDialogue Location4", "line_index": 131, "text": "Questo di nuovo..."}
{"category": "LocationDialogue Location4", "line_index": 132, "text": "Se vuoi controllare nell'armadio,"}
{"category": "LocationDialogue Location4", "line_index": 133, "text": "allora fallo,"}
{"category": "LocationDialogue Location4", "line_index": 134, "text": "e scopri cosa c'è li dentro!"}
{"category": "LocationDialogue Location4", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 139, "text": "Ma che..."}
{"category": "LocationDialogue Location4", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 141, "text": "A volte succede."}
{"category": "LocationDialogue Location4", "line_index": 142, "text": "La stanza si è bloccata nel caricamento."}
{"category": "LocationDialogue Location4", "line_index": 143, "text": "Aspetta un attimo."}
{"category": "LocationDialogue Location4", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 145, "text": "E' cosi strano."}
{"category": "LocationDialogue Location4", "line_index": 146, "text": "Siamo all'interno del telefono di qualcuno?"}
{"category": "LocationDialogue Location4", "line_index": 147, "text": "Forse uno lento e con lunghi tempi di caricamento?"}
{"category": "LocationDialogue Location4", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 149, "text": "Non del tutto."}
{"category": "LocationDialogue Location4", "line_index": 150, "text": "Non tutto è perfetto"}
{"category": "LocationDialogue Location4", "line_index": 151, "text": "in questo mondo..."}
{"category": "LocationDialogue Location4", "line_index": 152, "text": "Siamo stati caricati"}
{"category": "LocationDialogue Location4", "line_index": 153, "text": "insieme al nucleo del mondo."}
{"category": "LocationDialogue Location4", "line_index": 154, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 155, "text": "Il nucleo del mondo?"}
{"category": "LocationDialogue Location4", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 157, "text": "Tipico, non credi?"}
{"category": "LocationDialogue Location4", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 159, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 161, "text": "Comunque, possiamo"}
{"category": "LocationDialogue Location4", "line_index": 162, "text": "giocare ad un videogioco alla console"}
{"category": "LocationDialogue Location4", "line_index": 163, "text": "oppure con le carte."}
{"category": "LocationDialogue Location4", "line_index": 164, "text": "Scegli tu."}
{"category": "LocationDialogue Location4", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 167, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 168, "text": "// Mita play fight"}
{"category": "LocationDialogue Location4", "line_index": 169, "text": "Vuoi combattere?"}
{"category": "LocationDialogue Location4", "line_index": 170, "text": "Devi vincere"}
{"category": "LocationDialogue Location4", "line_index": 171, "text": "quattro volte."}
{"category": "LocationDialogue Location4", "line_index": 172, "text": "Fatti sotto."}
{"category": "LocationDialogue Location4", "line_index": 173, "text": "Non preoccuparti, ci andrò"}
{"category": "LocationDialogue Location4", "line_index": 174, "text": "piano inizialmente."}
{"category": "LocationDialogue Location4", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 176, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 177, "text": "Bravo ragazzo."}
{"category": "LocationDialogue Location4", "line_index": 178, "text": "meglio se mi concentro!"}
{"category": "LocationDialogue Location4", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 180, "text": "Whoa!"}
{"category": "LocationDialogue Location4", "line_index": 181, "text": "Bene, okay."}
{"category": "LocationDialogue Location4", "line_index": 182, "text": "Ora faccio sul serio."}
{"category": "LocationDialogue Location4", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 184, "text": "Wow!"}
{"category": "LocationDialogue Location4", "line_index": 185, "text": "Vediamo se"}
{"category": "LocationDialogue Location4", "line_index": 186, "text": "riesci a battermi adesso"}
{"category": "LocationDialogue Location4", "line_index": 187, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 188, "text": "Tu sei"}
{"category": "LocationDialogue Location4", "line_index": 189, "text": "semplicemente"}
{"category": "LocationDialogue Location4", "line_index": 190, "text": "incredibile! Che abilità!"}
{"category": "LocationDialogue Location4", "line_index": 191, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 193, "text": "Qual è il problema?"}
{"category": "LocationDialogue Location4", "line_index": 194, "text": "Huh, che peccato."}
{"category": "LocationDialogue Location4", "line_index": 195, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 196, "text": "Beh,"}
{"category": "LocationDialogue Location4", "line_index": 197, "text": "è cosi. Tu credi nel destino?"}
{"category": "LocationDialogue Location4", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 199, "text": "Allora,"}
{"category": "LocationDialogue Location4", "line_index": 200, "text": "datti una regolata altrimenti sarai per sempre un perdente!"}
{"category": "LocationDialogue Location4", "line_index": 201, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 202, "text": "Qual è il tuo problema oggi?"}
{"category": "LocationDialogue Location4", "line_index": 203, "text": "Ti ho completamente distrutto."}
{"category": "LocationDialogue Location4", "line_index": 204, "text": "Non hai dato il massimo"}
{"category": "LocationDialogue Location4", "line_index": 205, "text": "per questo ho vinto!"}
{"category": "LocationDialogue Location4", "line_index": 206, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 208, "text": "Va bene, allora."}
{"category": "LocationDialogue Location4", "line_index": 209, "text": "Che ne dici di giocare a carte?"}
{"category": "LocationDialogue Location4", "line_index": 210, "text": "Sono in camera da letto."}
{"category": "LocationDialogue Location4", "line_index": 211, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 214, "text": "// Door > [ERROR]"}
{"category": "LocationDialogue Location4", "line_index": 215, "text": "Huh, che succede?"}
{"category": "LocationDialogue Location4", "line_index": 216, "text": "Dov'è..."}
{"category": "LocationDialogue Location4", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 218, "text": "Uh-oh."}
{"category": "LocationDialogue Location4", "line_index": 219, "text": "Scusa..."}
{"category": "LocationDialogue Location4", "line_index": 220, "text": "Ho scaricato qualcosa"}
{"category": "LocationDialogue Location4", "line_index": 221, "text": "da internet."}
{"category": "LocationDialogue Location4", "line_index": 222, "text": "Volevo abbellire "}
{"category": "LocationDialogue Location4", "line_index": 223, "text": "l'esterno."}
{"category": "LocationDialogue Location4", "line_index": 224, "text": "Ma ho scoperto che "}
{"category": "LocationDialogue Location4", "line_index": 225, "text": "c'era qualcosa di sbagliato nel file."}
{"category": "LocationDialogue Location4", "line_index": 226, "text": "lo sistemerò più tardi."}
{"category": "LocationDialogue Location4", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 228, "text": "E' per questo che non possiamo uscire di casa?"}
{"category": "LocationDialogue Location4", "line_index": 229, "text": "Si. è questo il motivo."}
{"category": "LocationDialogue Location4", "line_index": 230, "text": "// Mita shy"}
{"category": "LocationDialogue Location4", "line_index": 231, "text": "Hey..."}
{"category": "LocationDialogue Location4", "line_index": 232, "text": "Che problema hai?"}
{"category": "LocationDialogue Location4", "line_index": 233, "text": "Vuoi qualcosa?"}
{"category": "LocationDialogue Location4", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 236, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 237, "text": "// Wall Clock"}
{"category": "LocationDialogue Location4", "line_index": 238, "text": "Questo orologio,"}
{"category": "LocationDialogue Location4", "line_index": 239, "text": "che orario mostra?"}
{"category": "LocationDialogue Location4", "line_index": 240, "text": "L'ora attuale del gioco?"}
{"category": "LocationDialogue Location4", "line_index": 241, "text": "Oppure è sincronizzato con il mio telefono?"}
{"category": "LocationDialogue Location4", "line_index": 242, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 243, "text": "Beh, uhm..."}
{"category": "LocationDialogue Location4", "line_index": 244, "text": "onestamente non lo so."}
{"category": "LocationDialogue Location4", "line_index": 245, "text": "Ma qui l'ora non ha importanza..."}
{"category": "LocationDialogue Location4", "line_index": 246, "text": "Che sia tardi o presto,"}
{"category": "LocationDialogue Location4", "line_index": 247, "text": "una ragazza forte come me"}
{"category": "LocationDialogue Location4", "line_index": 248, "text": "è sempre piena di energia—"}
{"category": "LocationDialogue Location4", "line_index": 249, "text": "non sono mai stanca!"}
{"category": "LocationDialogue Location4", "line_index": 250, "text": "Possiamo avere un'eterna primavera,"}
{"category": "LocationDialogue Location4", "line_index": 251, "text": "o un pomeriggio infinto!"}
{"category": "LocationDialogue Location4", "line_index": 252, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 253, "text": "E' interessante..."}
{"category": "LocationDialogue Location4", "line_index": 254, "text": "ma anche un po' inquitante."}
{"category": "LocationDialogue Location4", "line_index": 255, "text": "Bloccati nello stesso momento, per sempre..."}
{"category": "LocationDialogue Location4", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 258, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 259, "text": "// Photos of Mita"}
{"category": "LocationDialogue Location4", "line_index": 260, "text": "Belle foto."}
{"category": "LocationDialogue Location4", "line_index": 261, "text": "Immagino siano tue?"}
{"category": "LocationDialogue Location4", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 263, "text": "Già."}
{"category": "LocationDialogue Location4", "line_index": 264, "text": "Anche a me piacciono."}
{"category": "LocationDialogue Location4", "line_index": 265, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 266, "text": "Chi le ha scattate?"}
{"category": "LocationDialogue Location4", "line_index": 267, "text": "Ci sono altre persone in questo mondo?"}
{"category": "LocationDialogue Location4", "line_index": 268, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 269, "text": "Si potrebbe dire cosi."}
{"category": "LocationDialogue Location4", "line_index": 270, "text": "Te li presenterò prima o poi."}
{"category": "LocationDialogue Location4", "line_index": 271, "text": "Ma non ancora."}
{"category": "LocationDialogue Location4", "line_index": 272, "text": "Per adesso, voglio stare da sola con te."}
{"category": "LocationDialogue Location4", "line_index": 273, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 275, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 276, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 277, "text": "// Portal"}
{"category": "LocationDialogue Location4", "line_index": 278, "text": "Dov'è andato il portale?"}
{"category": "LocationDialogue Location4", "line_index": 279, "text": "o come lo hai chiamato tu?"}
{"category": "LocationDialogue Location4", "line_index": 280, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 281, "text": "Ho usato"}
{"category": "LocationDialogue Location4", "line_index": 282, "text": "un po' di magia"}
{"category": "LocationDialogue Location4", "line_index": 283, "text": "e l'ho spostato"}
{"category": "LocationDialogue Location4", "line_index": 284, "text": "da un'altra parte."}
{"category": "LocationDialogue Location4", "line_index": 285, "text": "Non ne abbiamo più bisogno."}
{"category": "LocationDialogue Location4", "line_index": 286, "text": "Sarebbe solo d'intralcio."}
{"category": "LocationDialogue Location4", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 288, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 289, "text": "// Mirror in the bedroom"}
{"category": "LocationDialogue Location4", "line_index": 290, "text": "Guardare dentro allo specchio senza"}
{"category": "LocationDialogue Location4", "line_index": 291, "text": "vedere il riflesso è inquietante."}
{"category": "LocationDialogue Location4", "line_index": 292, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 293, "text": "Possiamo attivare i riflessi"}
{"category": "LocationDialogue Location4", "line_index": 294, "text": "se vuoi."}
{"category": "LocationDialogue Location4", "line_index": 295, "text": "Ma, ne abbiamo veramente bisogno?"}
{"category": "LocationDialogue Location4", "line_index": 296, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 297, "text": "Certo che si."}
{"category": "LocationDialogue Location4", "line_index": 298, "text": "O... attivarli avrà delle conseguenze?"}
{"category": "LocationDialogue Location4", "line_index": 299, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 300, "text": "Si."}
{"category": "LocationDialogue Location4", "line_index": 301, "text": "Balbetteremo e ci muoveremo più lentamente."}
{"category": "LocationDialogue Location4", "line_index": 302, "text": "Hai mai visto un cartone animato con un basso numero di fotogrammi al secondo?"}
{"category": "LocationDialogue Location4", "line_index": 303, "text": "Sarà cosi per noi, tutto il tempo."}
{"category": "LocationDialogue Location4", "line_index": 304, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 305, "text": "Capito."}
{"category": "LocationDialogue Location4", "line_index": 306, "text": "Allora sarà meglio tenerli disattivati..."}
{"category": "LocationDialogue Location4", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 308, "text": "Hey, [player],"}
{"category": "LocationDialogue Location4", "line_index": 309, "text": "ti piacciono proprio gli specchi, vero?"}
{"category": "LocationDialogue Location4", "line_index": 310, "text": "Non hai paura di vedere un sorriso sulla tua faccia?"}
{"category": "LocationDialogue Location4", "line_index": 311, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 312, "text": "Huh? Non proprio..."}
{"category": "LocationDialogue Location4", "line_index": 313, "text": "Sono solo stanco"}
{"category": "LocationDialogue Location4", "line_index": 314, "text": "dopo una giornata di lavoro."}
{"category": "LocationDialogue Location4", "line_index": 315, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 316, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 317, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 318, "text": "// Blue sneakers"}
{"category": "LocationDialogue Location4", "line_index": 319, "text": "Sono tue?"}
{"category": "LocationDialogue Location4", "line_index": 320, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 321, "text": "Nope, sono tue."}
{"category": "LocationDialogue Location4", "line_index": 322, "text": "Non ti ricordi?"}
{"category": "LocationDialogue Location4", "line_index": 323, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 324, "text": "Non ricordo di avere scarpe da ginnastica cosi."}
{"category": "LocationDialogue Location4", "line_index": 325, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 326, "text": "Adesso si."}
{"category": "LocationDialogue Location4", "line_index": 327, "text": "Puoi indossarle"}
{"category": "LocationDialogue Location4", "line_index": 328, "text": "quando usciamo."}
{"category": "LocationDialogue Location4", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 330, "text": "E i vestiti?"}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "Tutto quello che ho in questo mondo"}
{"category": "LocationDialogue Location4", "line_index": 332, "text": "sono i vestiti che indosso."}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "C'è un modo per averne di nuovi?"}
{"category": "LocationDialogue Location4", "line_index": 334, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 335, "text": "Certo che c'è."}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "Tuttavia, ho visto cosa indossi"}
{"category": "LocationDialogue Location4", "line_index": 337, "text": "e onestamente, i tuoi gusti non sono granchè."}
{"category": "LocationDialogue Location4", "line_index": 338, "text": "In ogni caso, ti aiuterò a prendere qualcosa."}
{"category": "LocationDialogue Location4", "line_index": 339, "text": "Solo non adesso."}
{"category": "LocationDialogue Location4", "line_index": 340, "text": "E' una promessa."}
{"category": "LocationDialogue Location4", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 342, "text": "Okay."}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Games on TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "A cosa vuoi giocare?"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Game milk"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "Questo un gioco da combattimento!"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "Vediamo chi si inacidisce per primo!"}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "Che gioco!"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": "Ne ho abbastanza di latte, facciamo qualcos'altro."}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Game penguins"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "In questo gioco, sei un pinguino"}
{"category": "LocationDialogue Location4", "line_index": 354, "text": "che scivola in giro."}
{"category": "LocationDialogue Location4", "line_index": 355, "text": "Ecco, questo è il gioco."}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "Huh, cosa?"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "Sei serio? Pensavo che fossi..."}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "Sono felicissima!"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "E un po'confusa..."}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "Ma..."}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "Per favore, resta con me"}
{"category": "LocationDialogue Location4", "line_index": 364, "text": "Sempre e per sempre."}
{"category": "LocationDialogue Location4", "line_index": 365, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 367, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 368, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 369, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 370, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 372, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 373, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 374, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 375, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 376, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 377, "text": "// A game about penguins"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "E' semplicissimo:"}
{"category": "LocationDialogue Location4", "line_index": 379, "text": "Devi solo raccogliere le palle di neve."}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "Chi ne raccoglie di più, vince!"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "Giochiamo due round, okay?!"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// The first map"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "Wow, come hai fatto a prenderne cosi tante?"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "Tee-hee! Ho il maggior numero di palle di neve!"}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "Meglio recuperare!"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "Ha, 1:1!"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// The second map"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "Sei un pinguino nato!"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "Dovremmo portati sul ghiaccio vero!"}
{"category": "LocationDialogue Location4", "line_index": 390, "text": "Pfft, sei cosi lento."}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "Stai ancora pensando all'ultimo round?"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "Woah, un pareggio! Questo si che è raro!"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// The game is over"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "Bene, vuoi giocare a qualcos'altro?"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "O smettiamo?"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "A cosa ti serve?"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "Sei un giocatore cosi accanito?"}
