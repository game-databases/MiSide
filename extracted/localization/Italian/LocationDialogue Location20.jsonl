{"category": "LocationDialogue Location20", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Mila! No! Tu sei pazza!"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Ha-ha! CHE COS'È QUESTA?"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "E' una nuova espressione quella che vedo?"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "Avanti, fammi vedere di più!"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "Guardare la stessa vecchia faccia diventa così noioso!"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\""}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "Come va, mio piccolo vagabondo irrequieto?"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "Ancora in giro a correre? Non ne hai ancora abbastanza?"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Cosa hai fatto a Mila?"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "Oh, allora non sei ancora stanco!"}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Perfetto! Facciamo un altro gioco!"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "Tu..."}
{"category": "LocationDialogue Location20", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "Cominciamo con un piccolo test!"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "Mettiamo alla prova la tua coordinazione!"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "E ora la tua capacità di agire!"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "E se ci fosse qualcosa di sbagliato in te?"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "E se non ti meritassi nemmeno quella pelle"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "che sei così orgoglioso di indossare!?"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "Dai un'occhiata..."}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "Quale di questi attira la tua attenzione?"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "Quello di destra?"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "O"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "quello di sinistra?"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "Oh, davvero?"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "Ha importanza?"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "Ti stavo solo prendendo in giro!"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "Gli accoltellamenti sono una cosa vecchia, comunque."}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "Non importa!"}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "Ho in programma giochi molto più divertenti,"}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "come..."}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "Guarda qui!"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Abbiamo bisogno di un po' di musica!"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "Cosa ne pensi di questa melodia?"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "Mi fa pompare il sangue!"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "Inizierò"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "con le regole!"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rules"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "Durante la riproduzione della melodia,"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "puoi muoverti."}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "Ma quando la musica si ferma,"}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "NON TI MUOVERE!"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "O sei morto. Capito?"}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "È semplice: arriva alla fine"}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "prima che la canzone finisca."}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "Cominciamo!"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "Ancora in piedi, eh?"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Corri, tesoro, corri!"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "Oh!"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Ma guardati! Così obbediente!"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Un piccolo esemplare perfetto."}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Ti voglio per me!"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "È stato troppo facile, però, vero?"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "Lasciami andare!"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "Non metterti troppo comodo!"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "Abbiamo molti altri giochi da fare!"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "Ecco il prossimo:"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Chiuderò gli occhi..."}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "E quando li riaprirò,"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "sarà meglio che tu te ne sia andato!"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "Capito?"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "Se ti vedo, ti punisco!"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Bene! Cominciamo!"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "È inutile..."}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "Ce l' hai fatta!"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Stai andando alla grande, sta diventando emozionante!"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "Ma ora diventerà più difficile."}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "Molto più difficile."}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Nasconditi, corri, gira..."}
{"category": "LocationDialogue Location20", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "Gah, che tu sia maledetta!"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Player falls"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "Credo di essere riuscito a scappare..."}
