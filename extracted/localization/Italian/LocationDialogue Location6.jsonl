{"category": "LocationDialogue Location6", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "Mita?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "Come sei finito qui?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Tu sei Mita, vero?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Ma c'è qualcosa di diverso in te..."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "Osservatore, vedo."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "E hai ragione."}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "Non sono la Mita che hai conosciuto prima."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Fai attenzione, sta tramando qualcosa"}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "di sinistro."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "Eh, qualcosa di sinistro?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "Non c'è tempo per spiegare:"}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "se funziona, ti dirò tutto."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Prendi la chiave. È vicino al divano."}
{"category": "LocationDialogue Location6", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Ma..."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "Risparmiati le domande per dopo!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Dammi la chiave."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Prendi questo anello."}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "Eh?"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Vuoi uscire di qui, vero?"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "Uhm, sì..."}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Allora indossalo."}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "È un manufatto utile,"}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "probabilmente ti servirà presto."}
{"category": "LocationDialogue Location6", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Ok..."}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "A proposito, io sono"}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Mmm,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "Io sono... Mita."}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// MitaKind quest 1"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "Vedi quella"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "console? Prendila."}
{"category": "LocationDialogue Location6", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "Stiamo guardando una registrazione?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "Chi c'è con lei?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "Sta accadendo proprio in questo momento."}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "È un altro giocatore."}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Lo sta usando."}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Potrebbe cercare di"}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "trasformare anche te in una cartuccia."}
{"category": "LocationDialogue Location6", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "Devo andarmene da qui il prima possibile."}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "E anche tu."}
{"category": "LocationDialogue Location6", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "Sì, è così."}
{"category": "LocationDialogue Location6", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "Quindi, stai dicendo"}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "che lei lo sta usando."}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "Se estraggo la cartuccia, cosa succede?"}
{"category": "LocationDialogue Location6", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "Potrebbe benissimo"}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "danneggiare irreversibilmente la cartuccia."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "Il che significa che..."}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "il giocatore morirebbe."}
{"category": "LocationDialogue Location6", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "..."}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "E se lo spegnessi e basta?"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "Potrebbe funzionare..."}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Vale la pena di provare. C'è un pulsante di accensione rosso!"}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Lo vedi?"}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "L'ho trovato."}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "Premilo."}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// MitaKind quest 2"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Devo restare."}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "Ci sono domande che devo farle"}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "per scoprire di più su di lei."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "Anche se è improbabile che stia al gioco..."}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// MitaKind quest 3"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "A dire la verità, questa è la mia versione."}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "Stavo facendo compagnia a un giocatore,"}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "quando improvvisamente qualcosa è cambiato."}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "Poi è arrivata lei..."}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "e ha trasformato il giocatore in una cartuccia"}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "e mi ha rinchiusa."}
{"category": "LocationDialogue Location6", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Aspetta, lo ha trasformato in una cartuccia?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "Può fare una cosa del genere?"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "Ma perché?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "A cosa le servono i giocatori?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "È ovviamente pazza..."}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Sta solo giocando con noi e ci usa per le sue macchinazioni!"}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "Trasformare i giocatori in cartucce..."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Alcuni non si sono nemmeno resi conto di ciò che gli stava per accadere..."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "E alcuni che lo sanno, non reagiscono nemmeno... Gah!"}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "Questa sì che è una svolta oscura..."}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "Devi aiutarci!"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "Io? Ma come?"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "Ho bisogno di te!"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "Se ci aiuterai, io ti aiuterò!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Questa potrebbe essere la nostra unica possibilità."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "L'anello ti condurrà alla versione giusta."}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "Ci vediamo lì."}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// MitaKind quest 4"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "Non riesco ancora a capire"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "cosa ho visto lassù..."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Quella Mita..."}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "Stava cercando di uccidermi?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "Ucciderti?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Ha in mente un destino peggiore per te..."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "Devi sbrigarti."}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Hide!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "Oh, merda! Nasconditi!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Aspetta, cosa...?"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Sbrigati, sta arrivando!"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "Segui l'anello, ti condurrà al sicuro!"}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "Bene, bene, vuoi dirmi dove si trova?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "Perché dovrei?"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "Non lo ucciderai, vero?"}
{"category": "LocationDialogue Location6", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Ah, quindi ti rifiuti di dirmelo."}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Mi piacciono le sfide."}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "So che è da qualche parte qui intorno."}
{"category": "LocationDialogue Location6", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "Perché sei così cattiva con noi?"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "Non mi dici nemmeno cosa sta succedendo!"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "E poi..."}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "a cosa ti servono i giocatori?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "Non sono giocattoli!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "Ma che ti prende?!"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "Basta! Tieni la bocca chiusa, bambola!"}
