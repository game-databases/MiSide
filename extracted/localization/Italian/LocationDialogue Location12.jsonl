{"category": "LocationDialogue Location12", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Rimani qui."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Credo che mi sia caduto qualcosa. Torno subito."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "Poi andremo in un altro mondo..."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Ok..."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Giochiamo!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Voglio il mio orsacchiotto!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "L'ho perso..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "Trovalo!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Ehi..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "cosa stai guardando?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Quest 1 (Who are you?)"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Sono Mita."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "La migliore Mita."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "La prima Mita."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "È quello che ha detto Mita, la mia Mita."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Quest 2 (Why do you look like that?)"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "Che aspetto ho?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "Che aspetto ho?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "Che aspetto ho?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "La mia Mita dice che sono bella e originale."}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "Questa sono io!"}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Quest 3 (What was Mita doing here?)"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Mi porterà via."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Vivremo in un nuovo mondo."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "La mia Mita mi ha invitato."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Mi porterà via. E giocheremo."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Quest 4 (Why do you need a teddy bear?)"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "Tu sei un orsacchiotto coccoloso,"}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "e ti sei perso,"}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "proprio come il mio orsacchiotto."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Quest 5 (Why is Mita angry?)"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "La mia..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "Mita."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Vuole giocare."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Vuole solo"}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "me."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Siamo uniche,"}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "le uniche."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Mita e la mia Mita,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0,8A e 8�54*."}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Quest 6 (Do you believe Mita?)"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "La mia Mita."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "La mia migliore amica."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "La mia Mita."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "La mia unica amica."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "Sei tu!"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Ehi!"}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Giochiamo!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Ti faccio vedere come si fa."}
