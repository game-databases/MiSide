{"category": "LocationDialogue Location8", "line_index": 0, "text": "// The first meeting"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "Chi sei?"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "Cosa c'è che non va?"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "Non riesci a parlare?"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "Aspetta..."}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "Vuoi andartene, vero?"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "Sì..."}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "Ho bisogno di tornare"}
{"category": "LocationDialogue Location8", "line_index": 11, "text": "alla versione precedente."}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "La versione precedente?"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "Perché partire e andare"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "da un'altra parte?"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "Perché non rimanere qui"}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "ed essere il mio"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "secondo amico?"}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Skipping all dialogs"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "Okay..."}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Standing by the window (Random)"}
{"category": "LocationDialogue Location8", "line_index": 24, "text": "Non troverai la via d'uscita attraverso le porte."}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "Sembra che tu abbia fretta..."}
{"category": "LocationDialogue Location8", "line_index": 26, "text": "Correre in cerchio non ti salverà."}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "Sei così ansioso di scappare?"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "Guarda fuori dalle finestre..."}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Aren't you Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "Giocatore... sei un giocatore, vero?"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": "Possiamo giocare insieme."}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "Se riesco a trovare la forza,"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": "tutto quello che dobbiamo fare è giocare."}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (What happened to you?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "Sono incerta, e in realtà non lo so..."}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "Non credo che sia successo niente di male..."}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "Ma tutto ciò che è bello sembra scivolare via..."}
{"category": "LocationDialogue Location8", "line_index": 41, "text": "Però almeno ho un amico."}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "Perché mi hanno lasciata?"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "Non ero abbastanza?"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "Ho paura..."}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Quest 3 (Become a second friend?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "Amici..."}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "Ormai me ne sono rimasti pochi."}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "Ne rimane solo uno..."}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "Sono triste, giocatore."}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "Vuoi essere mio amico?"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "Mi piacerebbe molto,"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "ma devo andare avanti..."}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "Il mio cuore soffre..."}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Is this your house?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "Casa?"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "Giocatore... sei cambiato..."}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "Le tue braccia sono più corte, e non sembri così arrabbiato..."}
{"category": "LocationDialogue Location8", "line_index": 62, "text": "Giocatore, sei diventato più morbido, più gentile."}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "Non sono sicuro..."}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "cosa significhi."}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "Va bene così..."}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "perché non farò più del male, vero?"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (How do I leave this place?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "Mi stai davvero lasciando?"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "Forse questo è solo il mio..."}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "destino?"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "Io..."}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": "Le porte non ti aiuteranno."}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Hold player (Random)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "Perché andarsene?"}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "Resta qui..."}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "Gioca con me..."}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "Giocatore..."}
