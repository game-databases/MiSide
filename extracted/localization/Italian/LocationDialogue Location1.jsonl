{"category": "LocationDialogue Location1", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 1, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 9, "text": "Ciao, io sono Mita!"}
{"category": "LocationDialogue Location1", "line_index": 10, "text": "Come ti chiami?"}
{"category": "LocationDialogue Location1", "line_index": 11, "text": "Piacere di conoscerti, [player]!"}
{"category": "LocationDialogue Location1", "line_index": 12, "text": "Um... [player],"}
{"category": "LocationDialogue Location1", "line_index": 13, "text": "Sono andata via di fretta prima, e ora questo posto è un disastro..."}
{"category": "LocationDialogue Location1", "line_index": 14, "text": "Potresti aiutarmi a riordinare un po'?"}
{"category": "LocationDialogue Location1", "line_index": 15, "text": "Woah..."}
{"category": "LocationDialogue Location1", "line_index": 16, "text": "Grazie mille!"}
{"category": "LocationDialogue Location1", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 18, "text": "[Player], Il mio stomaco brontola..."}
{"category": "LocationDialogue Location1", "line_index": 19, "text": "Ho tanta fame..."}
{"category": "LocationDialogue Location1", "line_index": 20, "text": "Pensi di potermi aiutare a trovare gli ingredienti per un po' di zuppa di pollo?"}
{"category": "LocationDialogue Location1", "line_index": 21, "text": "Evviva! Hai preso tutto!"}
{"category": "LocationDialogue Location1", "line_index": 22, "text": "Che ne dici di cucinarla insieme?"}
{"category": "LocationDialogue Location1", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 25, "text": "Oggi pensavo di comprare una TV portatile..."}
{"category": "LocationDialogue Location1", "line_index": 26, "text": "Una piccola con un'antenna. È perfetta per le passeggiate, non credi?"}
{"category": "LocationDialogue Location1", "line_index": 27, "text": "A proposito, puoi giocare per guadagnare soldi."}
{"category": "LocationDialogue Location1", "line_index": 28, "text": "Oh! Sapevi che puoi giocare per guadagnare soldi?"}
{"category": "LocationDialogue Location1", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 30, "text": "Evviva! Ce l'hai fatta! Hai abbastanza soldi per comprarmi quel televisore portatile!"}
{"category": "LocationDialogue Location1", "line_index": 31, "text": "È quello giusto! Piccolo, portatile ed economico: proprio quello che volevo."}
{"category": "LocationDialogue Location1", "line_index": 32, "text": "Grazie!"}
{"category": "LocationDialogue Location1", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 34, "text": "Ciao, [player]! Sei di grande aiuto, davvero."}
{"category": "LocationDialogue Location1", "line_index": 35, "text": "Ma... quella TV? Era bella e tutto, ma si è già rotta."}
{"category": "LocationDialogue Location1", "line_index": 36, "text": "Comunque, potresti aiutarmi a spostare questo armadio?"}
{"category": "LocationDialogue Location1", "line_index": 37, "text": "È molto pesante... >.<"}
{"category": "LocationDialogue Location1", "line_index": 38, "text": "Grazie mille, tesoro! <3"}
{"category": "LocationDialogue Location1", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 40, "text": "Oh, [player]! È passato solo un giorno, ma mi sei mancato così tanto!"}
{"category": "LocationDialogue Location1", "line_index": 41, "text": "Vorrei che tu potessi venire a trovarmi più spesso."}
{"category": "LocationDialogue Location1", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 43, "text": "Questo è per me?"}
{"category": "LocationDialogue Location1", "line_index": 44, "text": "Grazie mille, davvero!"}
{"category": "LocationDialogue Location1", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 46, "text": "Ciao, [player]! Stavo pensando..."}
{"category": "LocationDialogue Location1", "line_index": 47, "text": "Vorrei che potessimo incontrarci di persona."}
{"category": "LocationDialogue Location1", "line_index": 48, "text": "È così frustrante non poterlo fare."}
{"category": "LocationDialogue Location1", "line_index": 49, "text": "Mi aiuti sempre, sei così gentile ogni giorno..."}
{"category": "LocationDialogue Location1", "line_index": 50, "text": "Vorrei poter fare anch'io qualcosa per te."}
{"category": "LocationDialogue Location1", "line_index": 51, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 52, "text": "Oh, ho un'idea!"}
{"category": "LocationDialogue Location1", "line_index": 53, "text": "Ora siamo insieme."}
{"category": "LocationDialogue Location1", "line_index": 54, "text": "Metti giù il telefono."}
{"category": "LocationDialogue Location1", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 57, "text": "// T-shirt on the bed"}
{"category": "LocationDialogue Location1", "line_index": 58, "text": "Cosa ci fai qui sul letto?"}
{"category": "LocationDialogue Location1", "line_index": 59, "text": "// Rubik's Cube"}
{"category": "LocationDialogue Location1", "line_index": 60, "text": "Beh, non posso dire di averlo usato molto..."}
{"category": "LocationDialogue Location1", "line_index": 61, "text": "L'ho risolto una volta e non l'ho più toccato."}
{"category": "LocationDialogue Location1", "line_index": 62, "text": "Immagino di aver pensato che non sarei stato in grado di farlo una seconda volta?"}
{"category": "LocationDialogue Location1", "line_index": 63, "text": "// Computer"}
{"category": "LocationDialogue Location1", "line_index": 64, "text": "Vediamo..."}
{"category": "LocationDialogue Location1", "line_index": 65, "text": "Preparare una lista di cose da fare..."}
{"category": "LocationDialogue Location1", "line_index": 66, "text": "Scrivere le reazioni dei personaggi,"}
{"category": "LocationDialogue Location1", "line_index": 67, "text": "e forse anche un po' di coding."}
{"category": "LocationDialogue Location1", "line_index": 68, "text": "// The airplane"}
{"category": "LocationDialogue Location1", "line_index": 69, "text": "Costruito per volare!"}
{"category": "LocationDialogue Location1", "line_index": 70, "text": "// Trash in the corner"}
{"category": "LocationDialogue Location1", "line_index": 71, "text": "Ugh, sono sempre troppo occupato per portare fuori la spazzatura..."}
{"category": "LocationDialogue Location1", "line_index": 72, "text": "Ma questa volta lo farò di sicuro!"}
{"category": "LocationDialogue Location1", "line_index": 73, "text": "...Ora, quand'era il giorno delle pulizie?"}
{"category": "LocationDialogue Location1", "line_index": 74, "text": "// Photo of a cat on a watermelon"}
{"category": "LocationDialogue Location1", "line_index": 75, "text": "Era la migliore..."}
{"category": "LocationDialogue Location1", "line_index": 76, "text": "Un gatto che si sdraia su un'anguria."}
{"category": "LocationDialogue Location1", "line_index": 77, "text": "// Photo with a girl"}
{"category": "LocationDialogue Location1", "line_index": 78, "text": "Non ci assomigliamo affatto,"}
{"category": "LocationDialogue Location1", "line_index": 79, "text": "io e mia sorella."}
{"category": "LocationDialogue Location1", "line_index": 80, "text": "Lei è sempre in giro,"}
{"category": "LocationDialogue Location1", "line_index": 81, "text": "e io sono bloccato a casa."}
{"category": "LocationDialogue Location1", "line_index": 82, "text": "// Photo with people"}
{"category": "LocationDialogue Location1", "line_index": 83, "text": "Hmm..."}
{"category": "LocationDialogue Location1", "line_index": 84, "text": "La vita d'ufficio ci ha davvero"}
{"category": "LocationDialogue Location1", "line_index": 85, "text": "inculcato le sue usanze, "}
{"category": "LocationDialogue Location1", "line_index": 86, "text": "vero?"}
{"category": "LocationDialogue Location1", "line_index": 87, "text": "Mi sento ancora stranamente legato"}
{"category": "LocationDialogue Location1", "line_index": 88, "text": "Ma"}
{"category": "LocationDialogue Location1", "line_index": 89, "text": "li rivedrò mai?"}
{"category": "LocationDialogue Location1", "line_index": 90, "text": "Aspetta, perché ho messo questa foto?"}
{"category": "LocationDialogue Location1", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 93, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 99, "text": "// Nope name"}
{"category": "LocationDialogue Location1", "line_index": 100, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 101, "text": "Oh, no."}
{"category": "LocationDialogue Location1", "line_index": 102, "text": "Oh no, non funzionerà."}
{"category": "LocationDialogue Location1", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 104, "text": "// Name Developer"}
{"category": "LocationDialogue Location1", "line_index": 105, "text": "Sei sicuro di voler usare il nome dello sviluppatore?"}
{"category": "LocationDialogue Location1", "line_index": 106, "text": "Sono lusingata, ma..."}
{"category": "LocationDialogue Location1", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 108, "text": "// Bad name"}
{"category": "LocationDialogue Location1", "line_index": 109, "text": "Preferirei davvero che non ti chiamassi così."}
{"category": "LocationDialogue Location1", "line_index": 110, "text": "Non è affatto carino."}
{"category": "LocationDialogue Location1", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 112, "text": "// Go restart"}
{"category": "LocationDialogue Location1", "line_index": 113, "text": "No, non è questo il modo di farlo. Ricominciamo da capo."}
{"category": "LocationDialogue Location1", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 115, "text": "// Name with numbers"}
{"category": "LocationDialogue Location1", "line_index": 116, "text": "Oh, quindi ti stai affidando ai numeri? Dov'è la creatività in questo?"}
{"category": "LocationDialogue Location1", "line_index": 117, "text": "Oh beh, è una tua scelta!"}
{"category": "LocationDialogue Location1", "line_index": 118, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 119, "text": "// Name Mita"}
{"category": "LocationDialogue Location1", "line_index": 120, "text": "Mita?"}
{"category": "LocationDialogue Location1", "line_index": 121, "text": "Ti sei davvero chiamato come me?"}
{"category": "LocationDialogue Location1", "line_index": 122, "text": "O... è anche il tuo nome?"}
{"category": "LocationDialogue Location1", "line_index": 123, "text": "Senza offesa, ma credo che dovrei essere l'unica Mita qui intorno... ♪"}
{"category": "LocationDialogue Location1", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 125, "text": "// Day 10"}
{"category": "LocationDialogue Location1", "line_index": 126, "text": "Oh, sei tornato!"}
{"category": "LocationDialogue Location1", "line_index": 127, "text": "Ehi, ho perso la mia spazzola per capelli..."}
{"category": "LocationDialogue Location1", "line_index": 128, "text": "Potresti aiutarmi a trovarla?"}
{"category": "LocationDialogue Location1", "line_index": 129, "text": "Prova a controllare prima sul comodino: credo di averla lasciata lì."}
{"category": "LocationDialogue Location1", "line_index": 130, "text": "// Looked in the bedside table"}
{"category": "LocationDialogue Location1", "line_index": 131, "text": "Hmm, non ci sono spazzole lì..."}
{"category": "LocationDialogue Location1", "line_index": 132, "text": "Che ne dici di un altro posto?"}
{"category": "LocationDialogue Location1", "line_index": 133, "text": "Ma non guardare nel forno, ok?"}
{"category": "LocationDialogue Location1", "line_index": 134, "text": "Ho già controllato lì."}
{"category": "LocationDialogue Location1", "line_index": 135, "text": "// Looked into the stove"}
{"category": "LocationDialogue Location1", "line_index": 136, "text": "Ehi! Ti avevo detto di non guardare lì dentro!"}
{"category": "LocationDialogue Location1", "line_index": 137, "text": "Girati, pulisco io!"}
{"category": "LocationDialogue Location1", "line_index": 138, "text": "...Ecco, tutto fatto. Continuiamo a guardare altrove."}
{"category": "LocationDialogue Location1", "line_index": 139, "text": "Oh, e dimentica quello che hai appena visto, ok?"}
{"category": "LocationDialogue Location1", "line_index": 140, "text": "// Found a hairbrush"}
{"category": "LocationDialogue Location1", "line_index": 141, "text": "L' hai trovata! Bel lavoro!"}
{"category": "LocationDialogue Location1", "line_index": 142, "text": "Allora, cosa facciamo adesso?"}
