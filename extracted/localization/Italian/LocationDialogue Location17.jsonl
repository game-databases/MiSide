{"category": "LocationDialogue Location17", "line_index": 0, "text": "// Player thinks + Make coffee"}
{"category": "LocationDialogue Location17", "line_index": 1, "text": "Avrò bisogno dell'aiuto di qualcuno."}
{"category": "LocationDialogue Location17", "line_index": 2, "text": "Spero che la Mita qui non morda..."}
{"category": "LocationDialogue Location17", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 4, "text": "Per cosa sto perdendo tempo..."}
{"category": "LocationDialogue Location17", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 9, "text": "// Player tries to wake up MitaDreamer"}
{"category": "LocationDialogue Location17", "line_index": 10, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 11, "text": "Mita, svegliati!"}
{"category": "LocationDialogue Location17", "line_index": 12, "text": "Mita!"}
{"category": "LocationDialogue Location17", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 14, "text": "Mita, svegliati!"}
{"category": "LocationDialogue Location17", "line_index": 15, "text": "Ho bisogno del tuo aiuto."}
{"category": "LocationDialogue Location17", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 17, "text": "Chi sei tuuuuuuuuuuuu?"}
{"category": "LocationDialogue Location17", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 19, "text": "Aiutami con gli interruttori."}
{"category": "LocationDialogue Location17", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 21, "text": "Quali interruttori?"}
{"category": "LocationDialogue Location17", "line_index": 22, "text": "Lasciami dormire..."}
{"category": "LocationDialogue Location17", "line_index": 23, "text": "Oppure portami un caffè."}
{"category": "LocationDialogue Location17", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 25, "text": "La macchinetta del caffè è in cucina."}
{"category": "LocationDialogue Location17", "line_index": 26, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 27, "text": "Mi-ita!"}
{"category": "LocationDialogue Location17", "line_index": 28, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 31, "text": "// Player gives away the coffee"}
{"category": "LocationDialogue Location17", "line_index": 32, "text": "Mita,"}
{"category": "LocationDialogue Location17", "line_index": 33, "text": "ecco il tuo caffè."}
{"category": "LocationDialogue Location17", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 37, "text": "// MitaDreamer exercise"}
{"category": "LocationDialogue Location17", "line_index": 38, "text": "Interruttori,"}
{"category": "LocationDialogue Location17", "line_index": 39, "text": "Hai detto?"}
{"category": "LocationDialogue Location17", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 41, "text": "Sì. Come mai li conosci?"}
{"category": "LocationDialogue Location17", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 43, "text": "Come mai ne sei a conoscenza?"}
{"category": "LocationDialogue Location17", "line_index": 44, "text": "Anche se, perché lo chiedo..."}
{"category": "LocationDialogue Location17", "line_index": 45, "text": "Considerando che sei qui,"}
{"category": "LocationDialogue Location17", "line_index": 46, "text": "dovresti sapere già molto..."}
{"category": "LocationDialogue Location17", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 48, "text": "Solo un minuto,"}
{"category": "LocationDialogue Location17", "line_index": 49, "text": "Devo sedermi."}
{"category": "LocationDialogue Location17", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 51, "text": "E?"}
{"category": "LocationDialogue Location17", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 53, "text": "Non so cosa dire..."}
{"category": "LocationDialogue Location17", "line_index": 54, "text": "Ma devo continuare ad andare avanti,"}
{"category": "LocationDialogue Location17", "line_index": 55, "text": "devo continuare a seguire la guida dell'anello."}
{"category": "LocationDialogue Location17", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 57, "text": "Hai il suo anello?"}
{"category": "LocationDialogue Location17", "line_index": 58, "text": "Non c'è da stupirsi"}
{"category": "LocationDialogue Location17", "line_index": 59, "text": "che tu abbia trovato questo posto."}
{"category": "LocationDialogue Location17", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 61, "text": "È vero."}
{"category": "LocationDialogue Location17", "line_index": 62, "text": "Allora, puoi aiutarmi?"}
{"category": "LocationDialogue Location17", "line_index": 63, "text": "Con gli interruttori?"}
{"category": "LocationDialogue Location17", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 65, "text": "Certo."}
{"category": "LocationDialogue Location17", "line_index": 66, "text": "Lo farò."}
{"category": "LocationDialogue Location17", "line_index": 67, "text": "Con gli interruttori..."}
{"category": "LocationDialogue Location17", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 70, "text": "Mita, forza..."}
{"category": "LocationDialogue Location17", "line_index": 71, "text": "Andiamo."}
{"category": "LocationDialogue Location17", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 73, "text": "Eh?"}
{"category": "LocationDialogue Location17", "line_index": 74, "text": "Va bene..."}
{"category": "LocationDialogue Location17", "line_index": 75, "text": "Andiamo."}
{"category": "LocationDialogue Location17", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 78, "text": "// MitaDreamer fall"}
{"category": "LocationDialogue Location17", "line_index": 79, "text": "Alzati."}
{"category": "LocationDialogue Location17", "line_index": 80, "text": "Hai così tanto sonno?"}
{"category": "LocationDialogue Location17", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 82, "text": "// MitaDreamer again sleep"}
{"category": "LocationDialogue Location17", "line_index": 83, "text": "Sveglia."}
{"category": "LocationDialogue Location17", "line_index": 84, "text": "Siamo arrivati."}
{"category": "LocationDialogue Location17", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 87, "text": "// Switches"}
{"category": "LocationDialogue Location17", "line_index": 88, "text": "Ok..,"}
{"category": "LocationDialogue Location17", "line_index": 89, "text": "Sono pronta."}
{"category": "LocationDialogue Location17", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 91, "text": "Sono pronto anch'io."}
{"category": "LocationDialogue Location17", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 93, "text": "Bene, allora..."}
{"category": "LocationDialogue Location17", "line_index": 94, "text": "Inizio"}
{"category": "LocationDialogue Location17", "line_index": 95, "text": "il conto alla rovescia."}
{"category": "LocationDialogue Location17", "line_index": 96, "text": "E poi tiriamo insieme gli interruttori."}
{"category": "LocationDialogue Location17", "line_index": 97, "text": "Ok?"}
{"category": "LocationDialogue Location17", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 99, "text": "Resta sveglia, ok?"}
{"category": "LocationDialogue Location17", "line_index": 100, "text": "Vai."}
{"category": "LocationDialogue Location17", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 103, "text": "3"}
{"category": "LocationDialogue Location17", "line_index": 104, "text": "2"}
{"category": "LocationDialogue Location17", "line_index": 105, "text": "1"}
{"category": "LocationDialogue Location17", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 107, "text": "// Player lose 1"}
{"category": "LocationDialogue Location17", "line_index": 108, "text": "Ti stai distraendo?"}
{"category": "LocationDialogue Location17", "line_index": 109, "text": "Forza..,"}
{"category": "LocationDialogue Location17", "line_index": 110, "text": "ricominciamo..."}
{"category": "LocationDialogue Location17", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 112, "text": "// Player lose 2"}
{"category": "LocationDialogue Location17", "line_index": 113, "text": "Un altro tentativo?"}
{"category": "LocationDialogue Location17", "line_index": 114, "text": "Ma dai..,"}
{"category": "LocationDialogue Location17", "line_index": 115, "text": "Io..."}
{"category": "LocationDialogue Location17", "line_index": 116, "text": "Mi sto addormentando qui..."}
{"category": "LocationDialogue Location17", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 118, "text": "// Player lose 3"}
{"category": "LocationDialogue Location17", "line_index": 119, "text": "Mi sto quasi addormentando..."}
{"category": "LocationDialogue Location17", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 122, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 123, "text": "Meraviglioso,"}
{"category": "LocationDialogue Location17", "line_index": 124, "text": "grazie, Mita."}
{"category": "LocationDialogue Location17", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 126, "text": "Mh-hmm."}
{"category": "LocationDialogue Location17", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 129, "text": "Le porte..."}
{"category": "LocationDialogue Location17", "line_index": 130, "text": "così..."}
{"category": "LocationDialogue Location17", "line_index": 131, "text": "lente..."}
{"category": "LocationDialogue Location17", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 134, "text": "Vado a letto…"}
{"category": "LocationDialogue Location17", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 136, "text": "// Why kitchen?"}
{"category": "LocationDialogue Location17", "line_index": 137, "text": "Perché stai andando in cucina?"}
{"category": "LocationDialogue Location17", "line_index": 138, "text": "Se mi addormento sul pavimento freddo,"}
{"category": "LocationDialogue Location17", "line_index": 139, "text": "è colpa tua."}
{"category": "LocationDialogue Location17", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 141, "text": "// Why bathroom?"}
{"category": "LocationDialogue Location17", "line_index": 142, "text": "Non capisco..."}
{"category": "LocationDialogue Location17", "line_index": 143, "text": "per quali interruttori hai bisogno di aiuto?"}
{"category": "LocationDialogue Location17", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 145, "text": "// Put button"}
{"category": "LocationDialogue Location17", "line_index": 146, "text": "Non è successo nulla?"}
{"category": "LocationDialogue Location17", "line_index": 147, "text": "Allora cosa ci fa questo pulsante qui?"}
{"category": "LocationDialogue Location17", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 149, "text": "// Cofee"}
{"category": "LocationDialogue Location17", "line_index": 150, "text": "Ancora un po' di caffè?"}
{"category": "LocationDialogue Location17", "line_index": 151, "text": "O ti addormenterai di nuovo."}
{"category": "LocationDialogue Location17", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 153, "text": "Cosa?"}
{"category": "LocationDialogue Location17", "line_index": 154, "text": "Nooo..."}
{"category": "LocationDialogue Location17", "line_index": 155, "text": "Questo caffè ha un sapore terribile..."}
{"category": "LocationDialogue Location17", "line_index": 156, "text": "Sto benissimo..."}
{"category": "LocationDialogue Location17", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 158, "text": "// Button"}
{"category": "LocationDialogue Location17", "line_index": 159, "text": "Mita? Il pulsante non funziona... Mi senti?"}
{"category": "LocationDialogue Location17", "line_index": 160, "text": "Pronto?"}
