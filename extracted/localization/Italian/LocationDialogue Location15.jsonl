{"category": "LocationDialogue Location15", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Eccoti qui!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Perché hai lasciato il Nucleo?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Ti avevo detto di aspettarmi!"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Pensavo che saresti stata via più a lungo..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Beh, va bene..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Credo di aver trovato qualcosa..."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Credo sia un indice..."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Dobbiamo vedere se funziona!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Andiamocene da qui."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "La Mita Folle..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Credo sia impegnata con un nuovo giocatore."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Quindi speriamo che sia troppo occupata per badare a noi..."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Mita?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Aspettami."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Ti è caduto qualcosa?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Ops... che sbadata!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Mita..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Prendi!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Ma come..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Chi sei?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Sei... sei viva!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Non ti ricordi?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Ti conosco?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Cosa sta succedendo..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Cosa dovrei fare adesso?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Non posso uscire..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "Cosa vuol dire “uscire”?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Aspetta..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "Quello è l'anello..."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "E quello?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Non ho idea di cosa sia."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "È un indice!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "L'hai trovato!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Non so cosa dire."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Dobbiamo tornare al Nucleo."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "E tu..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Forse dovresti venire con me..."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Uhm, cosa?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Certo..."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Aspetta qui."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Mh-hmm."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Mi siederò qui."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Merda..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "C'è mancato poco."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "Allora... ce l'abbiamo fatta?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Bene."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Sono nella versione corretta."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Ciao!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Sei un giocatore, vero?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Come ti chiami?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Voglio lasciare questo posto..."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Vuoi andartene così presto?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "Come hai fatto ad arrivare qui?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Oh, beh..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Bene, puoi andartene..."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Prova con la porta."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Buona fortuna!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Un muro?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Hmm, è tutto sbagliato."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Forse..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "c'è qualcosa nel seminterrato che può aiutarti."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Di recente ho scoperto"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "una porta nel mio armadio..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Ho scoperto che porta a un seminterrato."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Ma è pieno di cianfrusaglie,"}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "di spazzatura, e di un sacco di attrezzature di lusso."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Bisogna inserire una specie di codice o qualcosa del genere."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Non lo capisco proprio."}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "E non mi interessa."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "È anche un po' scomodo, voglio dire, davvero scomodo."}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Vuoi dare un'occhiata?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Uhm, ok."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Non credo che"}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "si ricordi qualcosa..."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Ce l'abbiamo fatta?"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "L'abbiamo riavviata?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Allora tutto quello che devo fare è"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "uscire da questo dannato gioco..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Non così in fretta."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Vorrei abbracciarti."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Eh?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "È stato bello vederti."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Ahh..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "è un vero peccato"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "che io e te"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "abbiamo passato così poco tempo insieme."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Ehm..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "Di cosa stai parlando?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Voglio dire che..,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "avresti potuto restare con me..."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "È tutta colpa mia..."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Quel guardaroba e... i suoni."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Avrei dovuto UCCIDERLA prima!"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Aspetta un attimo,"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "Non hai...?"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Come fai a ricordare tutto questo?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "HA!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Pensavi davvero che sarebbe stato così facile?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Sei solo uno stupido..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Proprio come tutti gli altri giocatori..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Ce la siamo cavata bene, guarda!"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "Il VERO"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "te non è"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "più necessario."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Mi dispiace, tee-hee."}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Non posso crederci..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Abbiamo fallito...?"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "No... Ti ho riavviato, ne sono sicuro..."}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Ancora non capisci..."}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Ha-ha-ha!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Sono una grande attrice!"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Avresti dovuto vedere la tua faccia, tesoro!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "È così divertente!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Perché sei così?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Cosa c'è di sbagliato in te?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Già..."}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Cosa c'è che non va in me?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Non lo so..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Perché non mi dici tu perché sono così?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Perché non sarò mai una vera Mita?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "La mia versione, non è mai"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "esistita!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Sto solo scuoiando questi sciocchi ingenui,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "nascondendomi sotto la loro pelle..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Non c'è modo che tu possa"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "riavviarmi!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Incredibile..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Tu..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "Non sono loro il problema!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "Sei tu che non dovresti esistere!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "Ora anche tu..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Fa male sentirtelo dire."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "Eppure!"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "È ora che tu vada!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Ci rivedremo presto!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Sono tutti pronti!"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "E"}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "è ora di toglierti dalla console!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "Ci vediamo dopo!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Sarai la mia cartuccia preferita..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Un giocatore con un nome interessante."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Probabilmente non è così."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Non è nemmeno giusto."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "No, sbagliato."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Non è questo."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Devo trovare l'opzione di riavvio del personaggio."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "È la versione sbagliata."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Ops, errore mio."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Non è questa."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Non è quella giusta."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "C'è qualcosa di sbagliato"}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "con l'indice."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Devo cambiare l'indice,"}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "non si adatta."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Hai fame?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Sono bravissima a tagliare le carote. :)"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Ah, immagino che"}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "volevi entrare da solo?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Perché stiamo girando in tondo?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Perché tornare qui?"}
