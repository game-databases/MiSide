{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Ciao!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Ops!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Scusa,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "ti ho quasi ucciso."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Uhm..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "Il frigo, voglio dire... il frigo ti ha quasi ucciso."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Io non c'entro niente,"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "lo giuro!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Davvero!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Si si certo, ti credo!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Ma, seriamente,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "questo posto è pericoloso..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "soprattutto per te."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "Sei tutt'altro che un codardo, eh!"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Guardarti"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "mentre attraversi"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "questi luoghi è divertente..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Corri, zucchetta, corri!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "Ti raggiungerò!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Coraggio, vai!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Woah, è divertente!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Ti ho visto andare verso la funivia."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "È il percorso più lungo"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "tra le versioni..."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Mi chiedo come ti comporterai"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "con coloro che vivono lì"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "in quella nebbia."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Cosa pensi di fare?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Per favore..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Non guardare!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Stupido!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Stupido..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Uhm, ok..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "In bocca al lupo!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Chi c'è lì?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Ti sento..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Ascoltami,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "sei un giocatore,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "non è vero?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Aiutami a trovare..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "a trovare un..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "Fammi pensare..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "la mia mente è vuota..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Cosa diavolo sta succedendo qui?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Volevo dimenticare tutto una volta..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Ho rotto tutti gli specchi,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "ho rovinato le foto..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "ma ora..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "provo solo rimpianto."}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "Quanto sono stata stupida..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Tutti commettono errori, certo..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Ma cosa si fa"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "quando le conseguenze sono catastrofiche?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Vorrei poter tornare indietro nel tempo..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Si dice che il tempo guarisca tutte le ferite..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Ma cos'è il tempo?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Non credo più a nulla..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Ma se il tempo può guarire,"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "o almeno portarmi via,"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "lontano da questo mondo..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "Allora, ti supplico, per favore"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "di accelerare il tempo."}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "In modo che possa uccidermi"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "una volta per tutte."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Lei ha amato..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Ho amato anch'io, una volta?"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Ma il mio amore è diverso;"}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "il suo amore è vibrante,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "spregevole..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "bruciante..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "implacabile..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "invidioso..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "furioso..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "folle..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Mi hanno dato dell' emotiva..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "Ti preoccupi troppo, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "Supererai tutto questo, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "Non sei sola, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Dicevano. Ma cosa è rimasto?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "La tristezza,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "disperazione..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "e la paura."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Inutile..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Non riesco a ricordare..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "Niente di niente..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Solo gli echi infiniti..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Non riesco a sopportare il fatto"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "che sono intrappolata qui..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Sono sempre stata qui,"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "ma perché?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Non riesco a ricordare..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Finirà mai?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Non lo so..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Questo è..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "un disegno..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Ora mi ricordo,"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "grazie..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Ma il mio volto..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "Non ho un volto..."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "È tutto suo."}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Ha preso un pezzo di me..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "l'ha buttato via..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "È forte..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "e intelligente."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Non ho il diritto di fermarti, giocatore."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Guarda nell'armadio..."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Ehi!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Mi sei d'intralcio!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Hai intenzione di startene lì impalato?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Togliti di mezzo!"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Lasciami passare!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Solo perché sei grande non significa che sei onnipotente!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Perché mi segui?"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Levati dalle palle!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - radio voice"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Aspetta un attimo... Giocatore?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "Cosa ci fai qui?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Chi c'è?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Un altro giocatore."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Sono Mitaphone."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Sono seduta qui a controllare le funivie."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Ti rendi conto"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "che stai andando incontro al tuo destino in questo momento?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Forse,"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "ma è l'unica strada che ho."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Hai ragione."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Premi il pulsante e vai dietro il cannone."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "Il cannone?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Ah-ah."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Pensavi di poterlo attraversare?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Devi superare questo mini-gioco di Monster-Slap,"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "quindi preparati a farli esplodere."}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Bene, è ora di mettersi in viaggio."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Incredibile!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Ce l' hai fatta."}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Ehi, esci di qui."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Veloce!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Cosa ci fai ancora qui?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Ti ho detto di andartene."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Non capisco..."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "perché te ne stai lì impalato?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Cosa? Una console portatile?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Amico..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Ciao."}
