{"category": "LocationDialogue Location9", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Ehi, tu!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Ciao!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Vuoi uscire da qui?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Allora aiutami a trovare la chiave!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Mannaggia! Nessuna chiave qui!"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Non c'è niente qui..."}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "Zero, zero, nada!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "L'ho trovata!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// The usual conversation"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Pensavo fossi più basso!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "Sei alto..."}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "proprio come mia sorella!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "Tua sorella? Cosa c'entra lei?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Sì, mia sorella."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Non dire che non l'hai mai incontrata!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Uh... l'ho conosciuta... Credo..."}
{"category": "LocationDialogue Location9", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Sei uno sciocco percaso?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "Ehm..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "A quanto pare lo sei..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "Dai, aiutami a trovare la chiave!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// Next work"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Vieni."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Metti il ferro nel tubo!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Grazie!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "Ora portami la legna!"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Grazie!"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Un altro aiuto, per favore!"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Tutto fatto! Ora..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "Wow, è bellissimo."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Premi, forza!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Pronti..."}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "Ecco, prendila!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "La chiave è tua!"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// Quest 1 (Are you Mita?)"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Sono ChibiMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Tonnellate di linee,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "modelli più semplici e..."}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "la cosa migliore di tutte: capelli bellissimi!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// Quest 2 (Have we seen each other yet?)"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Sciocchino!"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "Sei piuttosto carino, sai?"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "fare domande stupide come questa."}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Anche se,"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "è la prima volta che ti incontro!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Ma ascolta..."}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Se rubi il mio meraviglioso stile,"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "te ne farò pentire!"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// Quest 3 (Why are you here?)"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Non lo capisci?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "Questo è un punto di controllo."}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "una prova di ingegno!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "E ora avanti!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Sono qui per guidare chi si è irrimediabilmente perso!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// Quest 4 (Why are you helping me?)"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "Cosa ti rende così speciale?"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "Perché non aiutarti comunque?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "Che cosa?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Che sciocco..."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Sei apparso dal nulla!"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Non dovresti essere qui,"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "quindi ti sto aiutando!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Ciao ciao, sciocco!"}
