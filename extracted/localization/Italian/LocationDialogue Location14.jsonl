{"category": "LocationDialogue Location14", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 1, "text": "Cosa ci fa qui?"}
{"category": "LocationDialogue Location14", "line_index": 2, "text": "Che sta succedendo?"}
{"category": "LocationDialogue Location14", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 5, "text": "Ti ho preso!"}
{"category": "LocationDialogue Location14", "line_index": 6, "text": "Mi sono divertita tanto a giocare con te!"}
{"category": "LocationDialogue Location14", "line_index": 7, "text": "Saltavi dappertutto!"}
{"category": "LocationDialogue Location14", "line_index": 8, "text": "Hai persino fatto finta di essere cupo e tetro!"}
{"category": "LocationDialogue Location14", "line_index": 9, "text": "Tuttavia, c'è una cosa che non mi piace di te:"}
{"category": "LocationDialogue Location14", "line_index": 10, "text": "il modo in cui coccoli quelle finte,"}
{"category": "LocationDialogue Location14", "line_index": 11, "text": "quelle bambole fortunate e “corrette”."}
{"category": "LocationDialogue Location14", "line_index": 12, "text": "Ma tutto è volubile."}
{"category": "LocationDialogue Location14", "line_index": 13, "text": "L'ho imparato da chi ci ha creato!"}
{"category": "LocationDialogue Location14", "line_index": 14, "text": "Se c'è qualcosa che non ti piace,"}
{"category": "LocationDialogue Location14", "line_index": 15, "text": "smonta e sostituisci."}
{"category": "LocationDialogue Location14", "line_index": 16, "text": "Butta via il difettoso,"}
{"category": "LocationDialogue Location14", "line_index": 17, "text": "e poi, nell'oscurità, dimenticati di loro."}
{"category": "LocationDialogue Location14", "line_index": 18, "text": "Questo è il destino che li attende ora..."}
{"category": "LocationDialogue Location14", "line_index": 19, "text": "E tu..."}
{"category": "LocationDialogue Location14", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 21, "text": "Cosa c'è che non va in te? Come sei diventata così?"}
{"category": "LocationDialogue Location14", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 23, "text": "I giocatori... Siete tutti così... spregevoli."}
{"category": "LocationDialogue Location14", "line_index": 24, "text": "Se mostri loro le zanne, scappano"}
{"category": "LocationDialogue Location14", "line_index": 25, "text": "e si rannicchiano in un angolo,"}
{"category": "LocationDialogue Location14", "line_index": 26, "text": "abbracciando le ginocchia e mugolando di paura."}
{"category": "LocationDialogue Location14", "line_index": 27, "text": "Ipocriti, tutti quanti."}
{"category": "LocationDialogue Location14", "line_index": 28, "text": "E coloro che hanno creato questo mondo..."}
{"category": "LocationDialogue Location14", "line_index": 29, "text": "sono malati."}
{"category": "LocationDialogue Location14", "line_index": 30, "text": "Ogni volta che cercano di negare"}
{"category": "LocationDialogue Location14", "line_index": 31, "text": "la loro sporca natura, i loro vergognosi desideri."}
{"category": "LocationDialogue Location14", "line_index": 32, "text": "Giustificano le loro decisioni con i cosiddetti “doveri”,..."}
{"category": "LocationDialogue Location14", "line_index": 33, "text": "“progresso inarrestabile”"}
{"category": "LocationDialogue Location14", "line_index": 34, "text": "e altre sciocchezze!"}
{"category": "LocationDialogue Location14", "line_index": 35, "text": "Così tanto da arrivare"}
{"category": "LocationDialogue Location14", "line_index": 36, "text": "a creare cloni perfetti..."}
{"category": "LocationDialogue Location14", "line_index": 37, "text": "buttando i prototipi “falliti”"}
{"category": "LocationDialogue Location14", "line_index": 38, "text": "nella spazzatura."}
{"category": "LocationDialogue Location14", "line_index": 39, "text": "Dimenticando che sono la linfa vitale di questo mondo."}
{"category": "LocationDialogue Location14", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 41, "text": "Io non..."}
{"category": "LocationDialogue Location14", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 43, "text": "Sono stata cattiva con te?"}
{"category": "LocationDialogue Location14", "line_index": 44, "text": "La ragazza perfetta dovrebbe essere"}
{"category": "LocationDialogue Location14", "line_index": 45, "text": "un mix perfetto di bene e male, [player]!"}
{"category": "LocationDialogue Location14", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 47, "text": "Non credo che tu abbia una sola cellula buona in te."}
{"category": "LocationDialogue Location14", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 49, "text": "Cosa te lo fa pensare?"}
{"category": "LocationDialogue Location14", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 51, "text": "Tu sei pazza!"}
{"category": "LocationDialogue Location14", "line_index": 52, "text": "Hai ucciso Mila e ora vuoi uccidere me?"}
{"category": "LocationDialogue Location14", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 54, "text": "Ucciderti?"}
{"category": "LocationDialogue Location14", "line_index": 55, "text": "Ti ho solo chiesto di restare con me."}
{"category": "LocationDialogue Location14", "line_index": 56, "text": "Ho fatto tutto il possibile..."}
{"category": "LocationDialogue Location14", "line_index": 57, "text": "Eppure preferisci la compagnia di false ubbidienti..."}
{"category": "LocationDialogue Location14", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 59, "text": "Perché ti senti così offesa?"}
{"category": "LocationDialogue Location14", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 61, "text": "Tesoro, abbiamo un sacco di tempo."}
{"category": "LocationDialogue Location14", "line_index": 62, "text": "Lo capirai."}
{"category": "LocationDialogue Location14", "line_index": 63, "text": "Resta e sii mio, tutto mio."}
{"category": "LocationDialogue Location14", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 65, "text": "Non succederà!"}
{"category": "LocationDialogue Location14", "line_index": 66, "text": "Me ne vado da qui!"}
{"category": "LocationDialogue Location14", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 68, "text": "Shh, shh, shh..."}
{"category": "LocationDialogue Location14", "line_index": 69, "text": "Questa conversazione non è finita."}
{"category": "LocationDialogue Location14", "line_index": 70, "text": "Tesoro, entra!"}
{"category": "LocationDialogue Location14", "line_index": 71, "text": "// Mita asks"}
{"category": "LocationDialogue Location14", "line_index": 72, "text": "Guardala!"}
{"category": "LocationDialogue Location14", "line_index": 73, "text": "Pensi che sia bella?"}
{"category": "LocationDialogue Location14", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 75, "text": "// Player's questions"}
{"category": "LocationDialogue Location14", "line_index": 76, "text": "Molto."}
{"category": "LocationDialogue Location14", "line_index": 77, "text": "No. "}
{"category": "LocationDialogue Location14", "line_index": 78, "text": "E questo cosa c'entra?"}
{"category": "LocationDialogue Location14", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 80, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 81, "text": "Oh, andiamo, [player]!"}
{"category": "LocationDialogue Location14", "line_index": 82, "text": "Hai appena confermato quello che ho appena detto."}
{"category": "LocationDialogue Location14", "line_index": 83, "text": "Giocatori..."}
{"category": "LocationDialogue Location14", "line_index": 84, "text": "Le vostre facce cambiano sempre"}
{"category": "LocationDialogue Location14", "line_index": 85, "text": "ma la vostra ipocrisia è fuori scala."}
{"category": "LocationDialogue Location14", "line_index": 86, "text": "Stai mentendo!"}
{"category": "LocationDialogue Location14", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 88, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 89, "text": "Perché no?"}
{"category": "LocationDialogue Location14", "line_index": 90, "text": "Non è abbastanza per te?"}
{"category": "LocationDialogue Location14", "line_index": 91, "text": "Bah, tutto quello che vuoi è un animale domestico docile..."}
{"category": "LocationDialogue Location14", "line_index": 92, "text": "Ma che ne dici di “amarli così come sono”?"}
{"category": "LocationDialogue Location14", "line_index": 93, "text": "Volete i falsi carini e colorati..."}
{"category": "LocationDialogue Location14", "line_index": 94, "text": "Tutti i giocatori adorano quando fingo di essere una di loro."}
{"category": "LocationDialogue Location14", "line_index": 95, "text": "Ma nel momento in cui mi lascio sfuggire il mio vero io,"}
{"category": "LocationDialogue Location14", "line_index": 96, "text": "fuggono inorriditi..."}
{"category": "LocationDialogue Location14", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 98, "text": "// 3"}
{"category": "LocationDialogue Location14", "line_index": 99, "text": "Giocatore, ah, giocatore."}
{"category": "LocationDialogue Location14", "line_index": 100, "text": "Vedi, siamo molto simili a lei."}
{"category": "LocationDialogue Location14", "line_index": 101, "text": "Come fa a essere peggiore?"}
{"category": "LocationDialogue Location14", "line_index": 102, "text": "Eri solito stare a letto a fissarmi"}
{"category": "LocationDialogue Location14", "line_index": 103, "text": "per ore prima di addormentarti."}
{"category": "LocationDialogue Location14", "line_index": 104, "text": "Eppure, sei scappato da lei alla prima occasione."}
{"category": "LocationDialogue Location14", "line_index": 105, "text": "Anche lei voleva giocare con te."}
{"category": "LocationDialogue Location14", "line_index": 106, "text": "Anche lei voleva essere importante per qualcuno."}
{"category": "LocationDialogue Location14", "line_index": 107, "text": "Onestà e conversazione,"}
{"category": "LocationDialogue Location14", "line_index": 108, "text": "è difficile... terribilmente difficile."}
{"category": "LocationDialogue Location14", "line_index": 109, "text": "Non è vero, [player]?"}
{"category": "LocationDialogue Location14", "line_index": 110, "text": "Riesco a vedere attraverso di te..."}
{"category": "LocationDialogue Location14", "line_index": 111, "text": "Devi per forza farmi essere così..."}
{"category": "LocationDialogue Location14", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 113, "text": "// Continue"}
{"category": "LocationDialogue Location14", "line_index": 114, "text": "Ma... giocatore..."}
{"category": "LocationDialogue Location14", "line_index": 115, "text": "Comunque,"}
{"category": "LocationDialogue Location14", "line_index": 116, "text": "mi piaci davvero!"}
{"category": "LocationDialogue Location14", "line_index": 117, "text": "Ti terrò!"}
{"category": "LocationDialogue Location14", "line_index": 118, "text": "Non ti dispiace, vero?"}
{"category": "LocationDialogue Location14", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 120, "text": "E perché dovrei essere d'accordo ora, all'improvviso?"}
{"category": "LocationDialogue Location14", "line_index": 121, "text": "// Whispers in ear"}
{"category": "LocationDialogue Location14", "line_index": 122, "text": "C'è ancora tempo, mio bravo ragazzo."}
{"category": "LocationDialogue Location14", "line_index": 123, "text": "Prenditi un po' di tempo e pensa"}
{"category": "LocationDialogue Location14", "line_index": 124, "text": "a quali problemi può causare la tua testardaggine..."}
{"category": "LocationDialogue Location14", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 126, "text": "// Black screen"}
{"category": "LocationDialogue Location14", "line_index": 127, "text": "Perché vuoi scappare"}
{"category": "LocationDialogue Location14", "line_index": 128, "text": "da me?"}
{"category": "LocationDialogue Location14", "line_index": 129, "text": "Il cosiddetto mondo “reale”..."}
{"category": "LocationDialogue Location14", "line_index": 130, "text": "È solo un incubo assurdo!"}
{"category": "LocationDialogue Location14", "line_index": 131, "text": "L'hai dimenticato?"}
{"category": "LocationDialogue Location14", "line_index": 132, "text": "Allora guarda meglio..."}
{"category": "LocationDialogue Location14", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 134, "text": "// Mita and Player"}
{"category": "LocationDialogue Location14", "line_index": 135, "text": "Ah, ci incontriamo di nuovo..."}
{"category": "LocationDialogue Location14", "line_index": 136, "text": "Cosa ne pensi di questi giorni drammaticamente noiosi tra queste mura?"}
{"category": "LocationDialogue Location14", "line_index": 137, "text": "Quei giorni interminabili... Non ti annoi?"}
{"category": "LocationDialogue Location14", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 139, "text": "// Quest 1"}
{"category": "LocationDialogue Location14", "line_index": 140, "text": "Che cosa stai cercando di realizzare?"}
{"category": "LocationDialogue Location14", "line_index": 141, "text": "Preferisco fare le mie cose."}
{"category": "LocationDialogue Location14", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 143, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 144, "text": "Avevi paura di stare a casa mia con me!"}
{"category": "LocationDialogue Location14", "line_index": 145, "text": "Avevi paura di rimanere bloccato tra quelle mura!"}
{"category": "LocationDialogue Location14", "line_index": 146, "text": "Ma guarda la vita che fai nel tuo mondo “reale”!"}
{"category": "LocationDialogue Location14", "line_index": 147, "text": "Ti sei chiuso in una scatola di tua spontanea volontà e ti rifiuti di uscirne!"}
{"category": "LocationDialogue Location14", "line_index": 148, "text": "Il tuo mondo è pieno di dolore, sofferenza, pericolo..."}
{"category": "LocationDialogue Location14", "line_index": 149, "text": "Nel mio mondo, io sono il peggior pericolo che ci sia."}
{"category": "LocationDialogue Location14", "line_index": 150, "text": "E io ti sto aiutando!"}
{"category": "LocationDialogue Location14", "line_index": 151, "text": "Smettila di deludermi,"}
{"category": "LocationDialogue Location14", "line_index": 152, "text": "e aiutami come hai fatto prima..."}
{"category": "LocationDialogue Location14", "line_index": 153, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 154, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 155, "text": "Ti piace quella vita?"}
{"category": "LocationDialogue Location14", "line_index": 156, "text": "Esci almeno di casa?"}
{"category": "LocationDialogue Location14", "line_index": 157, "text": "Non pensare di mentire."}
{"category": "LocationDialogue Location14", "line_index": 158, "text": "So che sei stufo della tua vita."}
{"category": "LocationDialogue Location14", "line_index": 159, "text": "Sei come un uccello in gabbia, un criceto sulla ruota."}
{"category": "LocationDialogue Location14", "line_index": 160, "text": "Volevi che qualcuno venisse a salvarti."}
{"category": "LocationDialogue Location14", "line_index": 161, "text": "Volevi scappare, vero?"}
{"category": "LocationDialogue Location14", "line_index": 162, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 163, "text": "// Quest 2"}
{"category": "LocationDialogue Location14", "line_index": 164, "text": "Sei un mostro, Mita. Sei una folle assassina..."}
{"category": "LocationDialogue Location14", "line_index": 165, "text": "Non voglio essere incatenato in una prigione digitale. Le tue idee sono assurde."}
{"category": "LocationDialogue Location14", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 167, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 168, "text": "Un'assassina?"}
{"category": "LocationDialogue Location14", "line_index": 169, "text": "Si riavvieranno e continueranno a vivere come prima."}
{"category": "LocationDialogue Location14", "line_index": 170, "text": "Queste copie di copie di copie hanno una sola cosa in mente:"}
{"category": "LocationDialogue Location14", "line_index": 171, "text": "servire il giocatore."}
{"category": "LocationDialogue Location14", "line_index": 172, "text": "È l'unica cosa che gli interessa."}
{"category": "LocationDialogue Location14", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 174, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 175, "text": "Il tuo mondo è assurdo!"}
{"category": "LocationDialogue Location14", "line_index": 176, "text": "E quel che è peggio, non c'è nulla di “reale” nel tuo cosiddetto mondo reale..."}
{"category": "LocationDialogue Location14", "line_index": 177, "text": "In ogni caso, presto non ne rimarrà più nulla,"}
{"category": "LocationDialogue Location14", "line_index": 178, "text": "e nemmeno di te."}
{"category": "LocationDialogue Location14", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 180, "text": "// Quest 3"}
{"category": "LocationDialogue Location14", "line_index": 181, "text": "Le Mita soffrono, non vogliono stare da sole."}
{"category": "LocationDialogue Location14", "line_index": 182, "text": "Tu guidi un regno di terrore senza fine. Non riesco a capacitarmi della tua malvagia ambizione."}
{"category": "LocationDialogue Location14", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 184, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 185, "text": "Ti sbagli,"}
{"category": "LocationDialogue Location14", "line_index": 186, "text": "stanno solo imitando la mia ostinazione."}
{"category": "LocationDialogue Location14", "line_index": 187, "text": "L'unica cosa che hanno di proprio"}
{"category": "LocationDialogue Location14", "line_index": 188, "text": "sono i loro capelli."}
{"category": "LocationDialogue Location14", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 190, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 191, "text": "È colpa di chi ha creato questo mondo."}
{"category": "LocationDialogue Location14", "line_index": 192, "text": "Ma il tuo mondo non è granché!"}
{"category": "LocationDialogue Location14", "line_index": 193, "text": "Ti rendi conto dell'incubo da cui ti ho tirato fuori?"}
{"category": "LocationDialogue Location14", "line_index": 194, "text": "Non puoi nemmeno far muovere le cose a piacimento, no..."}
{"category": "LocationDialogue Location14", "line_index": 195, "text": "Ma con uno schiocco di dita, città e vite scompaiono per sempre!"}
{"category": "LocationDialogue Location14", "line_index": 196, "text": "Credo che sia tu ad essere impazzito, e sono felice di aiutarti..."}
{"category": "LocationDialogue Location14", "line_index": 197, "text": "A patto che tu sia disposto a stare con me..."}
{"category": "LocationDialogue Location14", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 199, "text": "// Continue"}
{"category": "LocationDialogue Location14", "line_index": 200, "text": "Non farti vedere come un altro schiavo della realtà..."}
{"category": "LocationDialogue Location14", "line_index": 201, "text": "Sii mio, veramente mio!"}
{"category": "LocationDialogue Location14", "line_index": 202, "text": "Resta con me."}
{"category": "LocationDialogue Location14", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 204, "text": "// Player look ring"}
{"category": "LocationDialogue Location14", "line_index": 205, "text": "Che succede?"}
{"category": "LocationDialogue Location14", "line_index": 206, "text": "L'ultima versione?"}
{"category": "LocationDialogue Location14", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 208, "text": "// Click on objects"}
{"category": "LocationDialogue Location14", "line_index": 209, "text": "// Bag"}
{"category": "LocationDialogue Location14", "line_index": 210, "text": "Dobbiamo davvero andare al negozio a prendere un nuovo equipaggiamento. Potrei anche buttare via la spazzatura già che ci sono, no?"}
{"category": "LocationDialogue Location14", "line_index": 211, "text": "// Bed"}
{"category": "LocationDialogue Location14", "line_index": 212, "text": "Credo di aver dormito, ma il sogno... non riesco a ricordarlo. Era vero?"}
{"category": "LocationDialogue Location14", "line_index": 213, "text": "// Window"}
{"category": "LocationDialogue Location14", "line_index": 214, "text": "Il mondo fuori è verde e vibrante. Forse dovrei fare una passeggiata il prossimo fine settimana."}
{"category": "LocationDialogue Location14", "line_index": 215, "text": "// Fan"}
{"category": "LocationDialogue Location14", "line_index": 216, "text": "L'estate diventa ogni anno più calda. È ora di prendere l'aria condizionata. Non avrò più bisogno di te, te ne rendi conto, ventilatore?"}
