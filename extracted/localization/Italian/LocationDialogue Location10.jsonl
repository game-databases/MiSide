{"category": "LocationDialogue Location10", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "Aspetta, fermati!"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "Non così forte..."}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "Andare oltre è pericoloso."}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "TRA L'ALTRO..."}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "come sei arrivato qui?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "Ehm..."}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "L'anello apre le porte giuste."}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "Onestamente non so come funziona."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "L'anello?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "Che succede in questo posto?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "È molto buio."}
{"category": "LocationDialogue Location10", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "Te lo dirò più tardi."}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "Per ora, vai verso l'uscita."}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "Incontriamoci nel cabinato."}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Sbrigati, non fare tardi!"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// After mini-game"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "Allora, hai capito il senso del gioco?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "Che io sono fatto di carne e ossa e tu sei fatta di uno schema scheletrico?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "Wow!"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "Sembra inquietante detto così."}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "Ma il succo del discorso è questo."}
{"category": "LocationDialogue Location10", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "Giusto, ma perché devo capirlo?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "Ti ho detto che andare oltre"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "era pericoloso, e non sto scherzando."}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "Ti imbatterai in... modelli abbandonati..."}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "Quelli abbandonati, quelli “difettosi”."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "Sono aggressivi e possono anche tentare di ucciderti."}
{"category": "LocationDialogue Location10", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "Quindi, cosa dovrei fare?"}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Andrò..."}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "ovunque si apra una porta."}
{"category": "LocationDialogue Location10", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "Wow!"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "Allora non voltare loro le spalle."}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "E non perderli di vista!"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "Diventano timidi quando li fissi,"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "così timidi da bloccarsi."}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "Tienilo a mente!"}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// Quest 1 (Why are there other Mitas down there?)"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "Sono appena state create."}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "Hanno bisogno di tempo"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "per acquisire consapevolezza di sé."}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "Poi guido ognuna"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "nella propria casa."}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// Quest 2 (Why is it so dark downstairs?)"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "Noi Mita siamo “create” nell'oscurità,"}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "quindi dobbiamo rimanere lì per un po'."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Immagina"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "il dolore di passare dall'oscurità direttamente alla luce..."}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// Quest 3 (What are you doing here?)"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "Non l'hai ancora capito?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "Sto aiutando le nuove Mita ad ambientarsi!"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "Chi aiuterà loro se non lo faccio io?"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "Tu?"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// Quest 4 (Why do we need this conveyor?)"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "A cosa serve questo nastro trasportatore?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "Non c'è abbastanza spazio per tutti?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Aspetta, non dirmi che non capisci"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "come funziona il mondo..."}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "E che è infinito?"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "Infinito?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "Uhm..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "Cosa vuoi dire?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "Se la 1.9 è l'ultima versione,"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "allora ci sono solo 19 mondi."}
{"category": "LocationDialogue Location10", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "Mio Dio, non capisci proprio"}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "come funziona questo mondo."}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Guarda, userò questa lavagna"}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "per spiegare tutto."}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "Vuoi sapere come funziona?"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// Quest 5 (What is your version?)"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Aspetta,"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "non ti ho forse incontrata nell'ultima versione?"}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "O forse è solo la mia immaginazione."}
{"category": "LocationDialogue Location10", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "Beh, è abbastanza possibile."}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Vengo dalla versione 1.5."}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "Ci sei stato?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Sì, ci sono stato."}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "È lì che sono arrivato"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "quando sono stato gettato in questo mondo!"}
{"category": "LocationDialogue Location10", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "Wow!"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "Ma come...?"}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "Ma in quale indice di casa ti trovavi?"}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "C'è una “me” che non riesce a smettere di lamentarsi,"}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "una “me” che ama divertirsi,"}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "una \"me\" con una pessima memoria e che ama fare la prepotente con gli altri..."}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "La lista è lunga..."}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Dimmi cosa ricordi."}
{"category": "LocationDialogue Location10", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Era buio."}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "C'era una scritta"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "come..."}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "“Gioca con me”."}
{"category": "LocationDialogue Location10", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "Ah,"}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "che peccato..."}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "Quella era la “me\""}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "che fa la prepotente e dimentica le cose."}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// Mita wants to tell you [No]"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Grazie ma no grazie."}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Me la caverò anche senza saperne di più."}
{"category": "LocationDialogue Location10", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "Va bene, fai come vuoi."}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// Mita wants to tell you [Yes]."}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "Certo, vai pure."}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "Spero solo che non sia come al liceo..."}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "dove mi addormentavo sempre per noia."}
{"category": "LocationDialogue Location10", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "Puoi andartene quando vuoi,"}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "o rimanere ad ascoltare"}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "se ti interessa."}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "Un giocatore scarica MiSide"}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "e gioca quanto vuole."}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "Cosi, crea una nuova casa"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "e una nuova Mita."}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "Questa è una rappresentazione in 2D."}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "Queste sono le versioni,"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "mostrate come linee."}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "Le case sono posizionate su queste linee."}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "Supponiamo di scaricare la versione 1.14,"}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "che significa una nuova vita,"}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "una nuova Mita e una nuova casa."}
{"category": "LocationDialogue Location10", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "Cielo..."}
{"category": "LocationDialogue Location10", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Puoi chiedere informazioni sui dettagli"}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "in questo disegno,"}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "e farò del mio meglio per spiegarteli."}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// He asks about the only circle"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "Perché c'è un solo cerchio?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "Quella versione è stata rilasciata una sola volta,"}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "per poi non essere mai più ripetuta."}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "È l'unica versione veramente unica."}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "Inoltre, queste versioni sono speciali"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "e non hanno alcun percorso verso altre versioni."}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "Mita Dormigliona risiede in questa versione, la 1.1."}
{"category": "LocationDialogue Location10", "line_index": 171, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "Mita Dormigliona?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "Perché non riesce mai a dormire"}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "con tutti quelli che passano per la sua versione?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "No, non è così."}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "È possibile passarle accanto e fare rumore,"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "ma è impossibile svegliarla."}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// He asks about the shaded circle"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "Perché questa sfera è tutta scura?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "Uhm, questa è qui"}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "per via di Mita Carina."}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "L'ha disegnata lei."}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "Stavamo discutendo su"}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "chi riusciva a raggiungere la versione 1.11 più velocemente."}
{"category": "LocationDialogue Location10", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "Quindi, chi ha vinto?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "Io, ovviamente!"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "Guarda, siamo qui"}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "nella versione 1.15,"}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "indice 809."}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "Dobbiamo raggiungere la versione 1.11,"}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "indice 805."}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Quindi, il suo percorso è iniziato così."}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "Abbiamo cercato di trovare un percorso più breve,"}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "così Mita Carina ha suggerito questo percorso."}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "E poi ho disegnato quello più semplice, qui."}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "Facile, vero?"}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Basta guardare qui."}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "Da qui si arriva direttamente alla versione corretta."}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Anche se può sembrare che questa casa sia d'intralcio,"}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "che blocchi il tuo percorso..."}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "In ogni caso, il tuo anello funziona in base agli stessi principi."}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "Dove sei diretto?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "Al nucleo."}
{"category": "LocationDialogue Location10", "line_index": 210, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "Il nucleo?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "Hmm..."}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Se vuoi il percorso più breve,"}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "devi passare anche per la versione 1.11."}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "Lì incontrerai sicuramente Mita Dormigliona."}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Credo che la Mita che ti ha mandato,"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "abbia seguito lo stesso percorso."}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "O forse non si è resa conto che stai seguendo un percorso diverso."}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "O forse è un genio"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "e ha escogitato un percorso ancora più breve!"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Credo di aver capito."}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// He asks about the inscription"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "Di cosa si tratta?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "È per Mita Forzuta."}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "Sarà qui tra qualche ora."}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "Sposterà quelle scatole"}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "e metterà un divano qui."}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "Dato che mi fa male il sedere!"}
{"category": "LocationDialogue Location10", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Emm..."}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "Forse potrei aiutare?"}
{"category": "LocationDialogue Location10", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "No, quello è il lavoro di Mita Forzuta."}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Lei è una dura."}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// He asks about the drawings"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "È solo un disegno,"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "o"}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "significa qualcosa?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 244, "text": "Sì,"}
{"category": "LocationDialogue Location10", "line_index": 245, "text": "è solo uno scarabocchio."}
