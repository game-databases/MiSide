{"category": "LocationDialogue Location15", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Tu si!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Zašto si napustio Jezgro?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Rekla sam ti da me čekaš!"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Mislio sam da te neće biti duže..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Pa, dobro..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Mislim da sam nešto našla..."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Mislim da je to indeks..."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Morat ćemo vidjeti hoće li uspjeti!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Idemo odavde."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "Luda Mita..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Mislim da je zauzeta s novim igračem."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Pa se nadajmo da je prezauzeta da bi nam smetala..."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Mita?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Čekaj me."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Je li ti nešto ispalo?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Upoznaj je ponovno!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Mita..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Hvataj!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Kako..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Tko si ti?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Ti si... ti si živa!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Zar se ne sjećaš?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Poznajem li te?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Što se događa..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Što bih sada trebao učiniti?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Ne mogu izaći van..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "Kako to misliš, \"izaći van\"?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Čekaj..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "To je prsten..."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "A to?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Nemam pojma što je to."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "To je indeks!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Našla si ga!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Ne znam što da kažem."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Moramo se vratiti u Jezgro."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "A ti..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Možda bi trebala poći sa mnom..."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Umm, što?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "U redu..."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Čekaj ovdje."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Mm-hmm."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Ja ću sjediti ovdje."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Sranje..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "To je bilo blizu."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "Pa... jesmo li uspjeli?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Dobro je."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "U ispravnoj sam verziji."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Bok!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Ti si igrač, zar ne?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Kako se zoveš?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Želim napustiti ovo mjesto..."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Već želiš da odeš?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "Kako si uopće došao ovamo?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Oj, pa..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Dobro, možeš otići..."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Samo iskoristi vrata."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Sretno s tim!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Zid?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Hmm, to ne valja."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Možda..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "ima nešto u podrumu što će ti pomoći."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Nedavno sam otkrila"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "vrata u mom ormaru..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Ispostavilo se da vode u podrum."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Ali pun je smeća,"}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "smeća i tonu otmjene opreme."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Moraš unijeti nekakav kod ili tako nešto."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Ne razumijem baš."}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "I nije me briga."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "Također je nekako neugodno, mislim, stvarno neugodno."}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Hoćeš li pogledati?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Umm, okej."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Mislim da se"}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "ne sjeća ničega..."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Jesmo li uspjeli?"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "Jesmo li je restartovali?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Onda sve što trebam učiniti je"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "izaći iz ove proklete igre..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Ne tako brzo."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Htjela bih te zagrliti."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Huh?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Bilo je lijepo vidjeti te."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Ahh..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "prava je šteta"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "što smo ti i ja"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "proveli tako malo vremena zajedno."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Uhh..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "O čemu pričaš?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Mislim,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "mogao si ostati sa mnom..."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "Za sve sam ja kriva..."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Taj ormar i ti... zvukovi."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Trebala sam je UBITI prije!"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Čekaj malo,"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "Nisi li...?"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Kako se možeš sjetiti bilo čega?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "HA!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Jesi li stvarno mislio da će biti tako lako?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Ti si samo budala..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Kao i svi ostali igrači..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Dobro nam je prošlo, pogledaj!"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "PRAVI ti"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "nije"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "više potreban."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Izvini, hi-hi."}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Ne mogu vjerovati..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Nismo uspjeli...?"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Ne... Restartovao sam te, siguran sam u to..."}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Još uvijek ne shvaćaš..."}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Ha-ha-ha!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Ja sam tako sjajna glumica!"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Trebao si vidjeti svoje lice, dušo!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "Ovo je tako zabavno!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Zašto si ovakva?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Što nije u redu s tobom?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Da..."}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Što nije u redu sa mnom?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Nemam pojma..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Zašto mi ti ne kažeš zašto sam ovakva?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Zašto nikad neću biti prava Mita?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Moja verzija, nikad"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "nije ni postojala!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Samo gulim kožu ovim naivnim budalama,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "skrivajući se pod njihovom kožom..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Nema šanse da me možeš"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "restartovati!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Nevjerojatno..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Ti..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "One nisu problem!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "Ti si ta koja ne bi trebala postojati!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "I ti isto..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Boli me čuti to."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "Pa ipak!"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Vrijeme je da ideš!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Vidimo se opet uskoro!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Svi su spremni!"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "Vrijeme je"}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "da te izvučem iz konzole!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "Vidimo se kasnije!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Ti ćeš biti moj omiljeni kertridž..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Igrač sa zanimljivim imenom."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "To vjerojatno nije to."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Ni to nije u redu."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Ne, pogrešno."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Nije to to."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Moram pronaći opciju resetiranja likova."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "To je kriva verzija."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Ups, moja greška."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Nije to to."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Trebat će još jedan."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Nešto nije u redu"}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "s indeksom."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Moram promijeniti indeks,"}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "ne pristaje."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Jesi li gladan?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Odlično sjeckam mrkve. :)"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Ah, valjda"}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "si htjeo ući sam?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Zašto se samo vrtimo u krug?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Zašto se vraćaš ovdje?"}
