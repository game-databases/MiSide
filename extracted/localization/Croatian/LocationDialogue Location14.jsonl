{"category": "LocationDialogue Location14", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 1, "text": "Što ovo radi ovdje?"}
{"category": "LocationDialogue Location14", "line_index": 2, "text": "Što je to?"}
{"category": "LocationDialogue Location14", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 5, "text": "Imam te!"}
{"category": "LocationDialogue Location14", "line_index": 6, "text": "Bilo mi je jako zabavno igrati se s tobom!"}
{"category": "LocationDialogue Location14", "line_index": 7, "text": "Skačeš posvuda!"}
{"category": "LocationDialogue Location14", "line_index": 8, "text": "Još si se pravio da si tužan i ogorčen!"}
{"category": "LocationDialogue Location14", "line_index": 9, "text": "Ipak, postoji jedna stvar koja mi se ne sviđa kod tebe:"}
{"category": "LocationDialogue Location14", "line_index": 10, "text": "način na koji maziš te lažnjakinje,"}
{"category": "LocationDialogue Location14", "line_index": 11, "text": "one sretne i 'ispravne' lutkaste stvari."}
{"category": "LocationDialogue Location14", "line_index": 12, "text": "Ali sve je promjenljivo."}
{"category": "LocationDialogue Location14", "line_index": 13, "text": "To sam naučila od onih koji su nas stvorili!"}
{"category": "LocationDialogue Location14", "line_index": 14, "text": "Ako postoji nešto što ti se ne sviđa,"}
{"category": "LocationDialogue Location14", "line_index": 15, "text": "rastavi to i zamijeni."}
{"category": "LocationDialogue Location14", "line_index": 16, "text": "Baci neispravno,"}
{"category": "LocationDialogue Location14", "line_index": 17, "text": "daleko u tamu i zaboravi na to."}
{"category": "LocationDialogue Location14", "line_index": 18, "text": "To je sudbina koja ih sad čeka..."}
{"category": "LocationDialogue Location14", "line_index": 19, "text": "A ti..."}
{"category": "LocationDialogue Location14", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 21, "text": "Što nije u redu s tobom? Kako si postala ovakva?"}
{"category": "LocationDialogue Location14", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 23, "text": "Igrači... Svi ste tako... vrijedni prezira."}
{"category": "LocationDialogue Location14", "line_index": 24, "text": "Pokažeš im očnjake, oni pobjegnu"}
{"category": "LocationDialogue Location14", "line_index": 25, "text": "i sakriju se u kut,"}
{"category": "LocationDialogue Location14", "line_index": 26, "text": "grleći koljena i cvileći od straha."}
{"category": "LocationDialogue Location14", "line_index": 27, "text": "Licemjeri, svi do jednog."}
{"category": "LocationDialogue Location14", "line_index": 28, "text": "I oni koji su stvorili ovaj svijet..."}
{"category": "LocationDialogue Location14", "line_index": 29, "text": "oni su bolesni."}
{"category": "LocationDialogue Location14", "line_index": 30, "text": "Uvijek iznova pokušavaju odbiti"}
{"category": "LocationDialogue Location14", "line_index": 31, "text": "njihovu prljavu prirodu, njihove sramotne želje."}
{"category": "LocationDialogue Location14", "line_index": 32, "text": "Pravdajući svoje odluke takozvanom \"dužnosti\","}
{"category": "LocationDialogue Location14", "line_index": 33, "text": "\"nezaustavljivim napretkom\","}
{"category": "LocationDialogue Location14", "line_index": 34, "text": "i ostalim glupostima!"}
{"category": "LocationDialogue Location14", "line_index": 35, "text": "Tako daleko su napredovali"}
{"category": "LocationDialogue Location14", "line_index": 36, "text": "da su počeli praviti savršene klonove..."}
{"category": "LocationDialogue Location14", "line_index": 37, "text": "A cijelo vrijeme bacaju \"propale\" prototipe"}
{"category": "LocationDialogue Location14", "line_index": 38, "text": "u smeće."}
{"category": "LocationDialogue Location14", "line_index": 39, "text": "Zaboravljajući da su oni krvotok svijeta."}
{"category": "LocationDialogue Location14", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 41, "text": "Ja ne..."}
{"category": "LocationDialogue Location14", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 43, "text": "Jesam li bila loša prema tebi?"}
{"category": "LocationDialogue Location14", "line_index": 44, "text": "Savršena djevojka bi trebala biti"}
{"category": "LocationDialogue Location14", "line_index": 45, "text": "savršena mješavina dobra i zla, [player]!"}
{"category": "LocationDialogue Location14", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 47, "text": "Mislim da nemaš nijednu dobru ćeliju u sebi."}
{"category": "LocationDialogue Location14", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 49, "text": "Zašto to misliš?"}
{"category": "LocationDialogue Location14", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 51, "text": "Ti si luda!"}
{"category": "LocationDialogue Location14", "line_index": 52, "text": "Ubila si Milu, a sad hoćeš i mene?"}
{"category": "LocationDialogue Location14", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 54, "text": "Ubiti te?"}
{"category": "LocationDialogue Location14", "line_index": 55, "text": "Sve što sam tražila je da ostaneš sa mnom."}
{"category": "LocationDialogue Location14", "line_index": 56, "text": "Učinila sam sve što sam mogla..."}
{"category": "LocationDialogue Location14", "line_index": 57, "text": "Ipak više voliš društvo poniznih lažnjakinja..."}
{"category": "LocationDialogue Location14", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 59, "text": "Što si tako uvrijeđena?"}
{"category": "LocationDialogue Location14", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 61, "text": "Dušo, imamo dovoljno vremena."}
{"category": "LocationDialogue Location14", "line_index": 62, "text": "Shvatit ćeš ti to."}
{"category": "LocationDialogue Location14", "line_index": 63, "text": "Samo ostani i budi moj, skroz moj."}
{"category": "LocationDialogue Location14", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 65, "text": "Na-a, to se neće dogoditi!"}
{"category": "LocationDialogue Location14", "line_index": 66, "text": "Idem odavde!"}
{"category": "LocationDialogue Location14", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 68, "text": "Ššš, ššš, ššš..."}
{"category": "LocationDialogue Location14", "line_index": 69, "text": "Ovaj razgovor nije gotov."}
{"category": "LocationDialogue Location14", "line_index": 70, "text": "Dušo, uđi!"}
{"category": "LocationDialogue Location14", "line_index": 71, "text": "// Mita asks"}
{"category": "LocationDialogue Location14", "line_index": 72, "text": "Pogledaj je!"}
{"category": "LocationDialogue Location14", "line_index": 73, "text": "Misliš li da je lijepa?"}
{"category": "LocationDialogue Location14", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 75, "text": "// Player's questions"}
{"category": "LocationDialogue Location14", "line_index": 76, "text": "Vrlo."}
{"category": "LocationDialogue Location14", "line_index": 77, "text": "Ne."}
{"category": "LocationDialogue Location14", "line_index": 78, "text": "Kakve to veze ima s bilo čim?"}
{"category": "LocationDialogue Location14", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 80, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 81, "text": "Ma daj, [player]!"}
{"category": "LocationDialogue Location14", "line_index": 82, "text": "Upravo si potvrdio ono što sam rekla."}
{"category": "LocationDialogue Location14", "line_index": 83, "text": "Igrači..."}
{"category": "LocationDialogue Location14", "line_index": 84, "text": "Vaša se lica stalno mijenjaju"}
{"category": "LocationDialogue Location14", "line_index": 85, "text": "ali vaše licemjerje je van granica."}
{"category": "LocationDialogue Location14", "line_index": 86, "text": "Lažeš!"}
{"category": "LocationDialogue Location14", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 88, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 89, "text": "Zašto ne?"}
{"category": "LocationDialogue Location14", "line_index": 90, "text": "Zar nije dovoljno dobra za vas?"}
{"category": "LocationDialogue Location14", "line_index": 91, "text": "Ma, sve što želite je pitomi ljubimac..."}
{"category": "LocationDialogue Location14", "line_index": 92, "text": "Ali što je s \"volite ih takve kakve jesu\"?"}
{"category": "LocationDialogue Location14", "line_index": 93, "text": "Želite slatke i šarene krivotvorine..."}
{"category": "LocationDialogue Location14", "line_index": 94, "text": "Svaki igrač voli kad se pretvaram da sam takva."}
{"category": "LocationDialogue Location14", "line_index": 95, "text": "Ipak, onog trenutka kada pustim da moje pravo ja isklizne,"}
{"category": "LocationDialogue Location14", "line_index": 96, "text": "bježe užasnuti..."}
{"category": "LocationDialogue Location14", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 98, "text": "// 3"}
{"category": "LocationDialogue Location14", "line_index": 99, "text": "Igraču, ah, igraču."}
{"category": "LocationDialogue Location14", "line_index": 100, "text": "Vidiš, jako smo joj slične."}
{"category": "LocationDialogue Location14", "line_index": 101, "text": "Kako je ona gora?"}
{"category": "LocationDialogue Location14", "line_index": 102, "text": "Ležao si u krevetu i buljio u mene"}
{"category": "LocationDialogue Location14", "line_index": 103, "text": "satima prije nego što bi zaspao."}
{"category": "LocationDialogue Location14", "line_index": 104, "text": "Ipak, pobjegao si od nje prvom prilikom."}
{"category": "LocationDialogue Location14", "line_index": 105, "text": "I ona se htjela igrati s tobom."}
{"category": "LocationDialogue Location14", "line_index": 106, "text": "I ona je htjela nekome biti važna."}
{"category": "LocationDialogue Location14", "line_index": 107, "text": "Iskrenost i razgovor,"}
{"category": "LocationDialogue Location14", "line_index": 108, "text": "teški su... užasno teški."}
{"category": "LocationDialogue Location14", "line_index": 109, "text": "Zar ne, [player]?"}
{"category": "LocationDialogue Location14", "line_index": 110, "text": "Čitam te kao knjigu..."}
{"category": "LocationDialogue Location14", "line_index": 111, "text": "Moraš li me natjerati da budem tako..."}
{"category": "LocationDialogue Location14", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 113, "text": "// Continue"}
{"category": "LocationDialogue Location14", "line_index": 114, "text": "Ali... igraču..."}
{"category": "LocationDialogue Location14", "line_index": 115, "text": "Uglavnom,"}
{"category": "LocationDialogue Location14", "line_index": 116, "text": "stvarno mi se sviđaš!"}
{"category": "LocationDialogue Location14", "line_index": 117, "text": "Ja ću te čuvati!"}
{"category": "LocationDialogue Location14", "line_index": 118, "text": "Ne smeta ti, zar ne?"}
{"category": "LocationDialogue Location14", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 120, "text": "A zašto bih sad odjednom pristao?"}
{"category": "LocationDialogue Location14", "line_index": 121, "text": "// Whispers in ear"}
{"category": "LocationDialogue Location14", "line_index": 122, "text": "Još ima vremena, moj dobri dječače."}
{"category": "LocationDialogue Location14", "line_index": 123, "text": "Odvoji malo vremena i razmisli"}
{"category": "LocationDialogue Location14", "line_index": 124, "text": "kakve nevolje može izazvati tvoja tvrdoglavost..."}
{"category": "LocationDialogue Location14", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 126, "text": "// Black screen"}
{"category": "LocationDialogue Location14", "line_index": 127, "text": "Zašto želiš pobjeći"}
{"category": "LocationDialogue Location14", "line_index": 128, "text": "od mene?"}
{"category": "LocationDialogue Location14", "line_index": 129, "text": "Takozvani \"stvarni\" svijet..."}
{"category": "LocationDialogue Location14", "line_index": 130, "text": "Samo apsurdna noćna mora!"}
{"category": "LocationDialogue Location14", "line_index": 131, "text": "Jesi li zaboravio?"}
{"category": "LocationDialogue Location14", "line_index": 132, "text": "Onda pogledaj bolje..."}
{"category": "LocationDialogue Location14", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 134, "text": "// Mita and Player"}
{"category": "LocationDialogue Location14", "line_index": 135, "text": "Ah, opet se srećemo..."}
{"category": "LocationDialogue Location14", "line_index": 136, "text": "Kako se osjećaš u vezi ovih užasno dosadnih dana u ova četiri zida?"}
{"category": "LocationDialogue Location14", "line_index": 137, "text": "Ti beskrajni dani... Zar ti ne dosade?"}
{"category": "LocationDialogue Location14", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 139, "text": "// Potraga 1"}
{"category": "LocationDialogue Location14", "line_index": 140, "text": "Što pokušavaš postići?"}
{"category": "LocationDialogue Location14", "line_index": 141, "text": "Radim ono što želim."}
{"category": "LocationDialogue Location14", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 143, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 144, "text": "Bojao si se ostati sa mnom u mojoj kući!"}
{"category": "LocationDialogue Location14", "line_index": 145, "text": "Bojao si se ostati unutar tih zidova!"}
{"category": "LocationDialogue Location14", "line_index": 146, "text": "Ali pogledaj život koji živiš u svom \"stvarnom\" svijetu!"}
{"category": "LocationDialogue Location14", "line_index": 147, "text": "Dobrovoljno si se zatvorio u kutiju i odbijaš izaći!"}
{"category": "LocationDialogue Location14", "line_index": 148, "text": "Tvoj svijet je pun boli, patnje, opasnosti..."}
{"category": "LocationDialogue Location14", "line_index": 149, "text": "U mom svijetu ja sam najgora opasnost koja postoji."}
{"category": "LocationDialogue Location14", "line_index": 150, "text": "I ja ti se javljam!"}
{"category": "LocationDialogue Location14", "line_index": 151, "text": "Prestani me razočaravati,"}
{"category": "LocationDialogue Location14", "line_index": 152, "text": "i pomozi mi kao što si prije..."}
{"category": "LocationDialogue Location14", "line_index": 153, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 154, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 155, "text": "Sviđa li ti se taj život?"}
{"category": "LocationDialogue Location14", "line_index": 156, "text": "Izlaziš li uopće iz kuće?"}
{"category": "LocationDialogue Location14", "line_index": 157, "text": "Nemoj ni pomišljati da lažeš."}
{"category": "LocationDialogue Location14", "line_index": 158, "text": "Znam da ti je muka od života."}
{"category": "LocationDialogue Location14", "line_index": 159, "text": "Ti si kao ptica u kavezu, hrčak na kotaču."}
{"category": "LocationDialogue Location14", "line_index": 160, "text": "Željeo si da te netko spasi."}
{"category": "LocationDialogue Location14", "line_index": 161, "text": "Htjeo si pobjeći, zar ne?"}
{"category": "LocationDialogue Location14", "line_index": 162, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 163, "text": "// Quest 2"}
{"category": "LocationDialogue Location14", "line_index": 164, "text": "Ti si čudovište, Mita. Ti si luda ubojica..."}
{"category": "LocationDialogue Location14", "line_index": 165, "text": "Ne želim biti okovan u digitalnom zatvoru. Tvoje ideje su apsurdne."}
{"category": "LocationDialogue Location14", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 167, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 168, "text": "Ubojica?"}
{"category": "LocationDialogue Location14", "line_index": 169, "text": "Samo će se ponovno pokrenuti i živjeti kao prije."}
{"category": "LocationDialogue Location14", "line_index": 170, "text": "Ove kopije od kopija od kopija imaju samo jedno na umu:"}
{"category": "LocationDialogue Location14", "line_index": 171, "text": "služiti igrača."}
{"category": "LocationDialogue Location14", "line_index": 172, "text": "Samo to ih zanima."}
{"category": "LocationDialogue Location14", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 174, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 175, "text": "Vaš svijet je apsurdan!"}
{"category": "LocationDialogue Location14", "line_index": 176, "text": "I što je još gore, nema ničeg \"stvarnog\" u vašem takozvanom stvarnom svijetu..."}
{"category": "LocationDialogue Location14", "line_index": 177, "text": "U svakom slučaju, od njega uskoro neće ostati ništa,"}
{"category": "LocationDialogue Location14", "line_index": 178, "text": "a neće ni od tebe."}
{"category": "LocationDialogue Location14", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 180, "text": "// Quest 3"}
{"category": "LocationDialogue Location14", "line_index": 181, "text": "Mite pate; ne žele biti same."}
{"category": "LocationDialogue Location14", "line_index": 182, "text": "Ti vodiš beskrajnu vladavinu terorom. Ne mogu razumjeti tvoju opaku ambiciju."}
{"category": "LocationDialogue Location14", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 184, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 185, "text": "Svi ste u krivu,"}
{"category": "LocationDialogue Location14", "line_index": 186, "text": "one samo oponašaju moju samovolju."}
{"category": "LocationDialogue Location14", "line_index": 187, "text": "Jedino što imaju da je samo njihovo"}
{"category": "LocationDialogue Location14", "line_index": 188, "text": "je njihova kosa."}
{"category": "LocationDialogue Location14", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 190, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 191, "text": "Krivi su oni koji su stvorili ovaj svijet."}
{"category": "LocationDialogue Location14", "line_index": 192, "text": "Ali ni tvoj svijet nije nešto!"}
{"category": "LocationDialogue Location14", "line_index": 193, "text": "Shvaćaš li iz kakve sam te noćne more izvukla?"}
{"category": "LocationDialogue Location14", "line_index": 194, "text": "Ne možeš čak ni natjerati stvari da se kreću tvojom voljom, ne..."}
{"category": "LocationDialogue Location14", "line_index": 195, "text": "Ali pucketanjem prsta, gradovi i životi nestaju zauvijek!"}
{"category": "LocationDialogue Location14", "line_index": 196, "text": "Mislim da si ti taj koji je poludio, i rado ću ti pomoći..."}
{"category": "LocationDialogue Location14", "line_index": 197, "text": "Sve dok si voljan ostati sa mnom..."}
{"category": "LocationDialogue Location14", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 199, "text": "// Continue"}
{"category": "LocationDialogue Location14", "line_index": 200, "text": "Nemoj da te vidim kao još jednog roba stvarnosti..."}
{"category": "LocationDialogue Location14", "line_index": 201, "text": "Samo budi moj, istinski moj!"}
{"category": "LocationDialogue Location14", "line_index": 202, "text": "Ostani sa mnom."}
{"category": "LocationDialogue Location14", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 204, "text": "// Player look ring"}
{"category": "LocationDialogue Location14", "line_index": 205, "text": "Što je ovo?"}
{"category": "LocationDialogue Location14", "line_index": 206, "text": "Najnovija verzija?"}
{"category": "LocationDialogue Location14", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 208, "text": "// Click on objects"}
{"category": "LocationDialogue Location14", "line_index": 209, "text": "// Bag"}
{"category": "LocationDialogue Location14", "line_index": 210, "text": "Stvarno moram otići u trgovinu i nabaviti novu opremu. Mogao bi i baciti smeće kad sam već kod toga, zar ne?"}
{"category": "LocationDialogue Location14", "line_index": 211, "text": "// Bed"}
{"category": "LocationDialogue Location14", "line_index": 212, "text": "Mislim da sam spavao, ali san... Ne mogu se sjetiti. Je li stvarno bilo tamo?"}
{"category": "LocationDialogue Location14", "line_index": 213, "text": "// Window"}
{"category": "LocationDialogue Location14", "line_index": 214, "text": "Vanjski svijet je zelen i živahan. Možda bih trebao otići u šetnju sljedeći vikend."}
{"category": "LocationDialogue Location14", "line_index": 215, "text": "// Fan"}
{"category": "LocationDialogue Location14", "line_index": 216, "text": "Ljeto je svake godine sve toplije. Vrijeme je za klimatizaciju. Neću te više trebati, shvaćaš li to, ventilatore?"}
