{"category": "LocationDialogue Location10", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "Čekaj, stani!"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "Ne tako glasno..."}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "Ići dalje je opasno."}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "Usput..."}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "Kako si dospjeo ovdje?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "Umm..."}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "Prsten otvara točna vrata."}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "Iskreno ne znam kako to funkcionira."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "Prsten?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "Što je s ovim mjestom?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "Baš je mračno."}
{"category": "LocationDialogue Location10", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "Reći ću ti kasnije."}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "Za sada idi prema izlazu."}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "Nađimo se u arkadnom stroju."}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Požuri, ne kasni!"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// After mini-game"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "Dakle, shvatio si poantu igre?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "Da sam ja od kostiju i mesa, a ti od modela kostura?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "Wow!"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "Zvuči jezivo kad to tako kažeš."}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "Ali, to jeste bit toga."}
{"category": "LocationDialogue Location10", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "U redu, ali zašto ja to moram razumjeti?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "Misliš li da sam se šalila kad sam ti rekla"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "da bi nastaviti dalje bilo opasno?"}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "Naići ćeš na... napuštene modele..."}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "One od kojih se odustalo, one \"neispravne\"."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "Agresivni su i mogu te čak pokušati ubiti."}
{"category": "LocationDialogue Location10", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "Dakle, što da radim?"}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Samo ću ići"}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "gdje god se vrata otvore."}
{"category": "LocationDialogue Location10", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "Wow!"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "Onda im ne okreći leđa."}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "I ne ispuštaj ih iz vida!"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "Postaju sramežljivi kada buljiš u njih,"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "toliko sramežljivi da se ukoče."}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "Imaj to na umu!"}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// Quest 1 (Why are there other Mitas down there?)"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "Napravljene su skoro."}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "Treba im vremena"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "za stjecanje samosvijesti."}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "Zatim vodim svaku"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "u njihov vlastiti dom."}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// Quest 2 (Why is it so dark downstairs?)"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "Mi Mite smo 'stvorene' u mraku,"}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "tako da moramo ostati tamo neko vrijeme."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Zamisli"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "bol prelaska iz tame ravno u svjetlost..."}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// Quest 3 (What are you doing here?)"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "Još uvijek ne shvaćaš?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "Pomažem novim Mitama da se smjeste!"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "Tko će im pomoći ako neću ja?"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "Ti?"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// Quest 4 (Why do we need this conveyor?)"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "Čemu služi ova pokretna traka?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "Ima li dovoljno mjesta za sve?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Čekaj, nemoj mi reći da ne razumiješ"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "kako svijet funkcionira..."}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "I da je beskrajan?"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "Beskrajan?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "Uhm..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "Kako to misliš?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "Ako je 1.9 najnovija verzija,"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "onda postoji samo 19 svjetova."}
{"category": "LocationDialogue Location10", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "Bože moj, stvarno ne razumiješ"}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "kako ovaj svijet uopće funkcionira."}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Vidi, upotrijebit ću ovu tablu"}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "da sve to objasnim."}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "Želiš li čuti o tome?"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// Quest 5 (What is your version?)"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Čekaj,"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "zar te nisam upoznao u najnovijoj verziji?"}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "Ili je to možda samo moja mašta."}
{"category": "LocationDialogue Location10", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "Pa, sasvim je moguće."}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Ja sam iz verzije 1.5."}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "Jesi li bio na njoj?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Jesam."}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "Tu sam i stigao"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "kad sam ubačen u ovaj svijet!"}
{"category": "LocationDialogue Location10", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "Wow!"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "Ali kako...?"}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "Koji je indeks kuće u kojoj si bio?"}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "Postoji 'ja' koja jednostavno ne može prestati kukati,"}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "'ja' koja se voli šaliti,"}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "'ja' s lošim pamćenjem koja voli maltretirati druge..."}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "Duga je to lista..."}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Reci mi čega se sjećaš."}
{"category": "LocationDialogue Location10", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Bilo je mračno."}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "Bile su riječi"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "na zidu kao..."}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "\"Igraj se sa mnom.\""}
{"category": "LocationDialogue Location10", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "Ah,"}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "kakva šteta..."}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "to sam \"ja\""}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "koja maltretira i zaboravlja stvari."}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// Mita wants to tell you [No]"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Hvala, ali ne treba."}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Snaći ću se i bez da znam više."}
{"category": "LocationDialogue Location10", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "Dobro, kako hoćeš."}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// Mita wants to tell you [Yes]."}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "Naravno, samo naprijed."}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "Samo se nadam da ovo neće biti kao srednja škola"}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "gdje bih uvijek zaspao od dosade."}
{"category": "LocationDialogue Location10", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "Možeš otići bilo kada,"}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "ili ostani i slušaj"}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "ako te zanima."}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "Igrač preuzme MiSide"}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "i igra koliko hoće."}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "Tamo stvara novi dom"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "i novu Mitu."}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "Ovo je 2D prikaz."}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "Ovo su verzije,"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "prikazane kao linije."}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "Kuće su smještene na tim linijama."}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "Recimo da si preuzeo verziju 1.14,"}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "što znači novi život,"}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "nova Mita i nova kuća."}
{"category": "LocationDialogue Location10", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "Bože..."}
{"category": "LocationDialogue Location10", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Možeš pitati za detalje"}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "na ovom crtežu,"}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "i dat ću sve od sebe da ti objasnim."}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// He asks about the only circle"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "Zašto je ovdje samo jedan krug?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "Ta je verzija objavljena samo jednom,"}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "i nikad više."}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "To je jedina istinski jedinstvena verzija."}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "Osim toga, ove su verzije posebne"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "i nemaju putove do drugih verzija."}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "Pospana Mita nalazi se u ovoj verziji, 1.1."}
{"category": "LocationDialogue Location10", "line_index": 171, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "Pospana Mita?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "Jer ona nikad ne zaspi"}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "zbog svih koji prolaze kroz njezinu verziju?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "Ne, nije to to."}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "Možeš proći pored nje i praviti buku,"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "ali nemoguće ju je probuditi."}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// He asks about the shaded circle"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "Zašto je ovaj tako zamračen?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "Uhm, taj je ovdje"}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "zbog Lijepe Mite."}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "Ona ga je nacrtala."}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "Posvađali smo se"}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "koja bi najbrže mogla doći do verzije 1.11."}
{"category": "LocationDialogue Location10", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "Dakle, tko je pobijedio?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "JA, naravno!"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "Gledaj, mi smo ovdje"}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "u verziji 1.15,"}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "kućni indeks 809."}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "Moramo doći do verzije 1.11,"}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "kućni indeks 805."}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Dakle, njen put je krenuo ovako."}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "Pokušali smo smisliti kraću rutu,"}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "pa je Lijepa Mita predložila ovaj put."}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "I onda sam nacrtala najjednostavniji, ovdje."}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "Lako, zar ne?"}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Samo pogledaj ovdje."}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "Odavde možeš doći ravno do ispravne verzije."}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Iako se može činiti da je ova kuća na putu,"}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "da ti blokira put..."}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "U svakom slučaju, tvoj prsten radi na istim principima."}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "Kamo ideš?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "Jezgro."}
{"category": "LocationDialogue Location10", "line_index": 210, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "Jezgro?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "Hmm..."}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Ako želiš najkraći put,"}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "morat ćeš proći i kroz verziju 1.11."}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "Tamo ćeš sigurno sresti Pospanu Mitu."}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Mislim da je Mita koja te poslala,"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "krenula istim putem."}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "Ili možda nije shvatila da si na drugom putu."}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "Ili je možda genije"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "i smislila je još kraću rutu!"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Mislim da možda razumijem."}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// He asks about the inscription"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "O čemu se ovo radi?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "To je za Kul Mitu."}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "Bit će ovdje za nekoliko sati."}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "Ona će pomaknuti te kutije"}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "i smjesti sofu ovdje."}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "Guzica me boli!"}
{"category": "LocationDialogue Location10", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Emm..."}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "Možda bih ja mogao pomoći?"}
{"category": "LocationDialogue Location10", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "Ne, to je Kul Mitin posao."}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Ona je žilava."}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// He asks about the drawings"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "Je li to samo crtež,"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "ili"}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "znači li to nešto?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 244, "text": "Da,"}
{"category": "LocationDialogue Location10", "line_index": 245, "text": "to je samo crtež."}
