{"category": "LocationDialogue Location1", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 1, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 9, "text": "Bok, ja sam Mita!"}
{"category": "LocationDialogue Location1", "line_index": 10, "text": "Kako se zoveš?"}
{"category": "LocationDialogue Location1", "line_index": 11, "text": "Drago mi je što smo se upoznali, [player]!"}
{"category": "LocationDialogue Location1", "line_index": 12, "text": "Um... [player],"}
{"category": "LocationDialogue Location1", "line_index": 13, "text": "Malo sam žurila ranije, i sada je ovdje nered..."}
{"category": "LocationDialogue Location1", "line_index": 14, "text": "Možeš li mi pomoći da malo pospremim?"}
{"category": "LocationDialogue Location1", "line_index": 15, "text": "Wow.."}
{"category": "LocationDialogue Location1", "line_index": 16, "text": "Hvala ti puno!"}
{"category": "LocationDialogue Location1", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 18, "text": "[Player], želudac mi kruli..."}
{"category": "LocationDialogue Location1", "line_index": 19, "text": "Tako sam gladna..."}
{"category": "LocationDialogue Location1", "line_index": 20, "text": "Misliš li da bi mi mogao pomoći nabaviti sastojke za pileću juhu?"}
{"category": "LocationDialogue Location1", "line_index": 21, "text": "Jupi! Imaš sve!"}
{"category": "LocationDialogue Location1", "line_index": 22, "text": "Što misliš da to zajedno skuhamo?"}
{"category": "LocationDialogue Location1", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 25, "text": "Danas sam mislila kupiti prijenosni TV-"}
{"category": "LocationDialogue Location1", "line_index": 26, "text": "mali s antenom. Savršeno za šetnje, zar ne?"}
{"category": "LocationDialogue Location1", "line_index": 27, "text": "Usput, možeš igrati igre kako bi zaradio novac."}
{"category": "LocationDialogue Location1", "line_index": 28, "text": "Oh! Jesi li znao da možeš igrati igre da zaradiš novac?"}
{"category": "LocationDialogue Location1", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 30, "text": "Jej! Uspio si! Imaš dovoljno da mi kupiš taj prijenosni TV!"}
{"category": "LocationDialogue Location1", "line_index": 31, "text": "To je taj! Malen, prenosiv i jeftin - upravo ono što sam želila."}
{"category": "LocationDialogue Location1", "line_index": 32, "text": "Hvala!"}
{"category": "LocationDialogue Location1", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 34, "text": "Bok, [player]! Od velike si pomoći, iskreno."}
{"category": "LocationDialogue Location1", "line_index": 35, "text": "Ali, ovaj... onaj TV? Bio je cool i sve, ali već se pokvario."}
{"category": "LocationDialogue Location1", "line_index": 36, "text": "U svakom slučaju, možeš li mi pomoći premjestiti ovaj ormar?"}
{"category": "LocationDialogue Location1", "line_index": 37, "text": "Baš je težak... >.<"}
{"category": "LocationDialogue Location1", "line_index": 38, "text": "Hvala ti puno, dušo! <3"}
{"category": "LocationDialogue Location1", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 40, "text": "Oh, [player]! Prošao je samo jedan dan, ali jako si mi nedostajao!"}
{"category": "LocationDialogue Location1", "line_index": 41, "text": "Voljela bih da me možeš češće posjećivati."}
{"category": "LocationDialogue Location1", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 43, "text": "Je li ovo za mene?"}
{"category": "LocationDialogue Location1", "line_index": 44, "text": "Hvala ti puno, stvarno!"}
{"category": "LocationDialogue Location1", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 46, "text": "Bok, [player]! Razmišljala sam..."}
{"category": "LocationDialogue Location1", "line_index": 47, "text": "Voljela bih da se možemo uživo upoznati."}
{"category": "LocationDialogue Location1", "line_index": 48, "text": "Toliko je frustrirajuće što ne možemo."}
{"category": "LocationDialogue Location1", "line_index": 49, "text": "Uvijek mi pomažeš, tako si ljubazan svaki dan..."}
{"category": "LocationDialogue Location1", "line_index": 50, "text": "Voljela bih da i ja mogu učiniti nešto za tebe."}
{"category": "LocationDialogue Location1", "line_index": 51, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 52, "text": "Oh, imam ideju!"}
{"category": "LocationDialogue Location1", "line_index": 53, "text": "Sada smo zajedno."}
{"category": "LocationDialogue Location1", "line_index": 54, "text": "Spusti mobitel."}
{"category": "LocationDialogue Location1", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 57, "text": "// T-shirt on the bed"}
{"category": "LocationDialogue Location1", "line_index": 58, "text": "Što radiš ovdje na krevetu?"}
{"category": "LocationDialogue Location1", "line_index": 59, "text": "// Rubik's Cube"}
{"category": "LocationDialogue Location1", "line_index": 60, "text": "Pa, ne mogu reći da sam imao neke koristi od nje..."}
{"category": "LocationDialogue Location1", "line_index": 61, "text": "Riješio sam je jednom i više je nisam ni dotakao."}
{"category": "LocationDialogue Location1", "line_index": 62, "text": "Pretpostavljam da sam mislio da to neću moći učiniti drugi put?"}
{"category": "LocationDialogue Location1", "line_index": 63, "text": "// Computer"}
{"category": "LocationDialogue Location1", "line_index": 64, "text": "Da vidimo..."}
{"category": "LocationDialogue Location1", "line_index": 65, "text": "Postavi popis zadataka..."}
{"category": "LocationDialogue Location1", "line_index": 66, "text": "Reakcije likova u scenariju,"}
{"category": "LocationDialogue Location1", "line_index": 67, "text": "I možda uraditi malo kodiranja."}
{"category": "LocationDialogue Location1", "line_index": 68, "text": "// The airplane"}
{"category": "LocationDialogue Location1", "line_index": 69, "text": "Stvoren za letjenje!"}
{"category": "LocationDialogue Location1", "line_index": 70, "text": "// Trash in the corner"}
{"category": "LocationDialogue Location1", "line_index": 71, "text": "Uf, uvijek sam prezauzet da bih iznio smeće..."}
{"category": "LocationDialogue Location1", "line_index": 72, "text": "Ali ovaj put ću to uraditi, sigurno!"}
{"category": "LocationDialogue Location1", "line_index": 73, "text": "…A sad, kada je točno dan čišćenja?"}
{"category": "LocationDialogue Location1", "line_index": 74, "text": "// Photo of a cat on a watermelon"}
{"category": "LocationDialogue Location1", "line_index": 75, "text": "Bila je najbolja…"}
{"category": "LocationDialogue Location1", "line_index": 76, "text": "Mačka, izležava se na lubenici."}
{"category": "LocationDialogue Location1", "line_index": 77, "text": "// Photo with a girl"}
{"category": "LocationDialogue Location1", "line_index": 78, "text": "Uopće ne ličimo,"}
{"category": "LocationDialogue Location1", "line_index": 79, "text": "moja sestra i ja."}
{"category": "LocationDialogue Location1", "line_index": 80, "text": "Ona je uvijek vani,"}
{"category": "LocationDialogue Location1", "line_index": 81, "text": "A ja sam zaglavio kod kuće."}
{"category": "LocationDialogue Location1", "line_index": 82, "text": "// Photo with people"}
{"category": "LocationDialogue Location1", "line_index": 83, "text": "Hmm..."}
{"category": "LocationDialogue Location1", "line_index": 84, "text": "Uredski život doista nas je"}
{"category": "LocationDialogue Location1", "line_index": 85, "text": "naučio bonton, zar ne?"}
{"category": "LocationDialogue Location1", "line_index": 86, "text": "Još uvijek se osjećam čudno vezano"}
{"category": "LocationDialogue Location1", "line_index": 87, "text": "ali"}
{"category": "LocationDialogue Location1", "line_index": 88, "text": "hoću li ih ikada"}
{"category": "LocationDialogue Location1", "line_index": 89, "text": "vidjeti opet?"}
{"category": "LocationDialogue Location1", "line_index": 90, "text": "…Čekaj, zašto sam uopće stavio ovu sliku ovdje?"}
{"category": "LocationDialogue Location1", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 93, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 99, "text": "// Nope name"}
{"category": "LocationDialogue Location1", "line_index": 100, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 101, "text": "Oh, ne."}
{"category": "LocationDialogue Location1", "line_index": 102, "text": "O ne, to neće raditi."}
{"category": "LocationDialogue Location1", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 104, "text": "// Name developer"}
{"category": "LocationDialogue Location1", "line_index": 105, "text": "Jesi li siguran da želiš koristiti ime developera?"}
{"category": "LocationDialogue Location1", "line_index": 106, "text": "Polaskana sam, ali…"}
{"category": "LocationDialogue Location1", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 108, "text": "// Bad name"}
{"category": "LocationDialogue Location1", "line_index": 109, "text": "Stvarno bih voljela da se ne zoveš tako."}
{"category": "LocationDialogue Location1", "line_index": 110, "text": "Nije uopće kul."}
{"category": "LocationDialogue Location1", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 112, "text": "// Go restart"}
{"category": "LocationDialogue Location1", "line_index": 113, "text": "Ne, to nije način na koji se to radi. Počnimo ispočetka."}
{"category": "LocationDialogue Location1", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 115, "text": "// Name with numbers"}
{"category": "LocationDialogue Location1", "line_index": 116, "text": "Oh, znači ideš s brojevima? Gdje je tu kreativnost?"}
{"category": "LocationDialogue Location1", "line_index": 117, "text": "Pa dobro, to je tvoj izbor!"}
{"category": "LocationDialogue Location1", "line_index": 118, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 119, "text": "// Name Mita"}
{"category": "LocationDialogue Location1", "line_index": 120, "text": "Mita?"}
{"category": "LocationDialogue Location1", "line_index": 121, "text": "Jesi li se stvarno nazvao po meni?"}
{"category": "LocationDialogue Location1", "line_index": 122, "text": "Ili… je to i tvoje ime?"}
{"category": "LocationDialogue Location1", "line_index": 123, "text": "Bez uvrede, ali mislim da bih trebala biti jedina Mita ovdje ♪"}
{"category": "LocationDialogue Location1", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 125, "text": "// Day 10"}
{"category": "LocationDialogue Location1", "line_index": 126, "text": "Oh, vratio si se!"}
{"category": "LocationDialogue Location1", "line_index": 127, "text": "Hej, izgubila sam četku za kosu..."}
{"category": "LocationDialogue Location1", "line_index": 128, "text": "Možeš li mi pomoći pronaći je?"}
{"category": "LocationDialogue Location1", "line_index": 129, "text": "Probaj prvo pogledati noćni ormarić—Mislim da sam ga tamo ostavila."}
{"category": "LocationDialogue Location1", "line_index": 130, "text": "// Looked in the bedside table"}
{"category": "LocationDialogue Location1", "line_index": 131, "text": "Hmm, nema četke..."}
{"category": "LocationDialogue Location1", "line_index": 132, "text": "Možda negdje drugdje?"}
{"category": "LocationDialogue Location1", "line_index": 133, "text": "Samo nemoj gledati u pećnicu, u redu?"}
{"category": "LocationDialogue Location1", "line_index": 134, "text": "Već sam tamo provjerila."}
{"category": "LocationDialogue Location1", "line_index": 135, "text": "// Looked into the stove"}
{"category": "LocationDialogue Location1", "line_index": 136, "text": "Hej! Rekla sam ti da ne gledaš tamo!"}
{"category": "LocationDialogue Location1", "line_index": 137, "text": "Okreni se — Počistit ću ovo!"}
{"category": "LocationDialogue Location1", "line_index": 138, "text": "...Eto, gotovo. Nastavimo tražiti drugdje."}
{"category": "LocationDialogue Location1", "line_index": 139, "text": "Oh, i, uh, zaboravi što si upravo vidio, okej?"}
{"category": "LocationDialogue Location1", "line_index": 140, "text": "// Found a hairbrush"}
{"category": "LocationDialogue Location1", "line_index": 141, "text": "Našao si je! Dobar posao!"}
{"category": "LocationDialogue Location1", "line_index": 142, "text": "Dakle, što ćemo sljedeće raditi?"}
