{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Ćao!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Ups!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Oprosti,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "zamalo sam te ubila."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Uhm..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "Frižider, mislim... frižider te zamalo ubio."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Nemam veze sa ovim,"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "kunem se!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Zaista!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Naravno, baš ti vjerujem!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Ali ozbiljno,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "ovo mjesto je opasno..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "posebno za tebe."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "Ti si sve samo ne kukavica, ha!"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Gledajući te"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "dok prolaziš kroz"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "ova mjesta je zabavno..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Trči, dušo, trči!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "Stići ću te!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Bravo dečko!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Vau, ovo je zabavno!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Vidjela sam te kako ideš prema žičari."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "To je najduži put"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "između verzija..."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Pitam se kako ćeš se nosit"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "s onima koji tamo žive"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "u toj magli."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Što misliš da radiš?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Molim te..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Ne gledaj!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Budalo!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Glupko..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Umm, dobro..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Slomi nogu!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Tko je tamo"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Mogu te osjetiti..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Slušaj me,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "ti si igrač,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "zar ne?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Pomozi mi pronaći..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "pronaći..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "Pusti me da razmislim..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "moj um je prazan..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Što se ovdje događa?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Htjela sam jednom sve zaboraviti..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Razbila sam svako ogledalo,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "upropastila slike..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "ali sada..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "sve što osjećam je žaljenje."}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "Kako sam bila glupa..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Svi griješe, naravno..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Ali što da radiš"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "kada su posljedice katastrofalne?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Voljela bih da mogu samo vratiti vrijeme..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Kažu da vrijeme liječi sve rane..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Ali što je vrijeme?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "ne vjerujem više ni u što..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Ali ako vrijeme može izliječiti,"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "ili me barem odvesti,"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "daleko od ovoga svijeta..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "Onda, preklinjem, molim te"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "ubrzaj vrijeme."}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "Tako da me može ubiti"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "jednom zasvagda."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Ona je voljena..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Jesam li i ja jednom voljela?"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Ali moja ljubav je drugačija;"}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "njena ljubav je živa,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "prezirna..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "goreća..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "nemilosrdna..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "zavidna..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "bijesna..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "luda..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Zvali su me emotivnom..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "Previše brineš, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "Prebrodićeš ti ovo, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "Nisi sama, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Rekli su. Ali što je ostalo?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Tuga,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "očaj..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "i strah."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Beskorisna..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Ne mogu se sjetiti..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "Baš ničega..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Samo beskrajni odjeci..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Ne mogu se nositi s činjenicom"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "da sam zarobljena ovdje..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Uvijek sam bila ovdje,"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "ali zašto?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Ne mogu se sjetiti..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Hoće li se ikada završiti?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Ne znam..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Ovo je..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "crtež..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Sad se sjećam,"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "hvala..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Ali moje lice..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "nemam lice..."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "Sve je ONA."}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Uzela je dio mene..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "bacila ga..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Ona je jaka..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "i pametna."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Nemam te pravo zaustaviti, igraču."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Pogledaj u ormar..."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Hej"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Na putu si mi!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Hoćeš li samo stajati tu?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Samo se makni s puta!"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Pusti me da prođem!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Samo zato što si velik ne znači da si svemoćan!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Zašto me pratiš!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Odabij!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - radio voice"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Stani malo... Igrač?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "Što ti radiš ovdje?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Tko je to?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Još jedan igrač."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Ja sam Mita-fon."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Sjedim ovdje i kontroliram žičare."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Shvaćaš li da"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "ideš u svoju propast upravo sada?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Možda,"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "ali to je jedini put koji imam."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "U pravu si."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Pritisni gumb i stani iza topa."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "Top?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Aha."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Mislio si da ćeš jednostavno proletit kroz ovo?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Moraš završiti ovu mini-igru ​​Čudovišni Šamar,"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "pa se pripremi za pucanje."}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Dobro, vrijeme je da krenemo."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Nevjerojatno!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Uspio si."}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Hej, odlazi odavde."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Lijepo i brzo!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Zašto si još ovdje?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Rekla sam ti da odeš odavde."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Ne razumijem..."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "Zašto samo stojiš tu?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Što? Ručna konzola?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Brate..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Ćao."}
