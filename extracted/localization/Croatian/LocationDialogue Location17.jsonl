{"category": "LocationDialogue Location17", "line_index": 0, "text": "// Igrač razmišlja + Skuhaj kavu"}
{"category": "LocationDialogue Location17", "line_index": 1, "text": "Ovdje će mi trebati nečija pomoć."}
{"category": "LocationDialogue Location17", "line_index": 2, "text": "Nadam se da ova Mita ne grize..."}
{"category": "LocationDialogue Location17", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 4, "text": "Na što ja gubim vrijeme..."}
{"category": "LocationDialogue Location17", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 9, "text": "// Player tries to wake up MitaDreamer"}
{"category": "LocationDialogue Location17", "line_index": 10, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 11, "text": "Mita, probudi se!"}
{"category": "LocationDialogue Location17", "line_index": 12, "text": "Mita!"}
{"category": "LocationDialogue Location17", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 14, "text": "Mita, buđenje!"}
{"category": "LocationDialogue Location17", "line_index": 15, "text": "Trebam tvoju pomoć."}
{"category": "LocationDialogue Location17", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 17, "text": "Tko si tiiiiii?"}
{"category": "LocationDialogue Location17", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 19, "text": "Pomozi mi s prekidačima."}
{"category": "LocationDialogue Location17", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 21, "text": "Kakvim prekidačima?"}
{"category": "LocationDialogue Location17", "line_index": 22, "text": "Pusti me da spavam..."}
{"category": "LocationDialogue Location17", "line_index": 23, "text": "Ili mi donesi kavu."}
{"category": "LocationDialogue Location17", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 25, "text": "Aparat za kavu je tamo."}
{"category": "LocationDialogue Location17", "line_index": 26, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 27, "text": "Mi-ita!"}
{"category": "LocationDialogue Location17", "line_index": 28, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 31, "text": "// Player gives away the coffee"}
{"category": "LocationDialogue Location17", "line_index": 32, "text": "Mita,"}
{"category": "LocationDialogue Location17", "line_index": 33, "text": "evo tvoje kave."}
{"category": "LocationDialogue Location17", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 37, "text": "// MitaDreamer exercise"}
{"category": "LocationDialogue Location17", "line_index": 38, "text": "Prekidači,"}
{"category": "LocationDialogue Location17", "line_index": 39, "text": "kažeš?"}
{"category": "LocationDialogue Location17", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 41, "text": "Da."}
{"category": "LocationDialogue Location17", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 43, "text": "Kako to da znaš za njih?"}
{"category": "LocationDialogue Location17", "line_index": 44, "text": "Iako, zašto uopće pitam..."}
{"category": "LocationDialogue Location17", "line_index": 45, "text": "S obzirom da si ovdje,"}
{"category": "LocationDialogue Location17", "line_index": 46, "text": "trebao bi već dosta toga znati..."}
{"category": "LocationDialogue Location17", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 48, "text": "Samo trenutak,"}
{"category": "LocationDialogue Location17", "line_index": 49, "text": "moram sjesti."}
{"category": "LocationDialogue Location17", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 51, "text": "I?"}
{"category": "LocationDialogue Location17", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 53, "text": "Ne znam što da kažem..."}
{"category": "LocationDialogue Location17", "line_index": 54, "text": "Ali moram nastaviti,"}
{"category": "LocationDialogue Location17", "line_index": 55, "text": "nastaviti slijediti smjernice prstena."}
{"category": "LocationDialogue Location17", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 57, "text": "Imaš njezin prsten?"}
{"category": "LocationDialogue Location17", "line_index": 58, "text": "Nije ni čudo"}
{"category": "LocationDialogue Location17", "line_index": 59, "text": "što si pronašao ovo mjesto."}
{"category": "LocationDialogue Location17", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 61, "text": "Tako je."}
{"category": "LocationDialogue Location17", "line_index": 62, "text": "Dakle, možeš li mi pomoći?"}
{"category": "LocationDialogue Location17", "line_index": 63, "text": "Sa prekidačima?"}
{"category": "LocationDialogue Location17", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 65, "text": "Može."}
{"category": "LocationDialogue Location17", "line_index": 66, "text": "Hoću."}
{"category": "LocationDialogue Location17", "line_index": 67, "text": "Sa prekidačima..."}
{"category": "LocationDialogue Location17", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 70, "text": "Mita, hajde..."}
{"category": "LocationDialogue Location17", "line_index": 71, "text": "Hajdemo više."}
{"category": "LocationDialogue Location17", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 73, "text": "Uh?"}
{"category": "LocationDialogue Location17", "line_index": 74, "text": "U redu."}
{"category": "LocationDialogue Location17", "line_index": 75, "text": "Idemo."}
{"category": "LocationDialogue Location17", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 78, "text": "// MitaDreamer fall"}
{"category": "LocationDialogue Location17", "line_index": 79, "text": "Ustani."}
{"category": "LocationDialogue Location17", "line_index": 80, "text": "Jesi li toliko pospana?"}
{"category": "LocationDialogue Location17", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 82, "text": "// MitaDreamer again sleep"}
{"category": "LocationDialogue Location17", "line_index": 83, "text": "Probudi se."}
{"category": "LocationDialogue Location17", "line_index": 84, "text": "Stigli smo."}
{"category": "LocationDialogue Location17", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 87, "text": "// Switches"}
{"category": "LocationDialogue Location17", "line_index": 88, "text": "U redu,"}
{"category": "LocationDialogue Location17", "line_index": 89, "text": "Ja sam spremna."}
{"category": "LocationDialogue Location17", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 91, "text": "I ja sam spreman."}
{"category": "LocationDialogue Location17", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 93, "text": "Dobro."}
{"category": "LocationDialogue Location17", "line_index": 94, "text": "Ja ću početi"}
{"category": "LocationDialogue Location17", "line_index": 95, "text": "odbrojavanje."}
{"category": "LocationDialogue Location17", "line_index": 96, "text": "I zajedno ćemo povući prekidače."}
{"category": "LocationDialogue Location17", "line_index": 97, "text": "U redu?"}
{"category": "LocationDialogue Location17", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 99, "text": "Samo ostani budna, okej!"}
{"category": "LocationDialogue Location17", "line_index": 100, "text": "Kreni."}
{"category": "LocationDialogue Location17", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 103, "text": "3"}
{"category": "LocationDialogue Location17", "line_index": 104, "text": "2"}
{"category": "LocationDialogue Location17", "line_index": 105, "text": "1"}
{"category": "LocationDialogue Location17", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 107, "text": "// Player lose 1"}
{"category": "LocationDialogue Location17", "line_index": 108, "text": "Jesi li se zamislio?"}
{"category": "LocationDialogue Location17", "line_index": 109, "text": "Hajde"}
{"category": "LocationDialogue Location17", "line_index": 110, "text": "idemo ponovo..."}
{"category": "LocationDialogue Location17", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 112, "text": "// Player lose 2"}
{"category": "LocationDialogue Location17", "line_index": 113, "text": "Još jedan pokušaj?"}
{"category": "LocationDialogue Location17", "line_index": 114, "text": "Hajde,"}
{"category": "LocationDialogue Location17", "line_index": 115, "text": "ja ću..."}
{"category": "LocationDialogue Location17", "line_index": 116, "text": "zaspat ću ovdje..."}
{"category": "LocationDialogue Location17", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 118, "text": "// Player lose 3"}
{"category": "LocationDialogue Location17", "line_index": 119, "text": "Samo što ne zaspim..."}
{"category": "LocationDialogue Location17", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 122, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 123, "text": "Odlično,"}
{"category": "LocationDialogue Location17", "line_index": 124, "text": "hvala, Mita."}
{"category": "LocationDialogue Location17", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 126, "text": "Mm-hmm."}
{"category": "LocationDialogue Location17", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 129, "text": "Vrata..."}
{"category": "LocationDialogue Location17", "line_index": 130, "text": "tako..."}
{"category": "LocationDialogue Location17", "line_index": 131, "text": "spora..."}
{"category": "LocationDialogue Location17", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 134, "text": "Ja idem u krevet..."}
{"category": "LocationDialogue Location17", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 136, "text": "// Why kitchen?"}
{"category": "LocationDialogue Location17", "line_index": 137, "text": "Zašto idemo u kuhinju?"}
{"category": "LocationDialogue Location17", "line_index": 138, "text": "Ako zaspem na hladnom podu,"}
{"category": "LocationDialogue Location17", "line_index": 139, "text": "ti si kriv."}
{"category": "LocationDialogue Location17", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 141, "text": "// Why bathroom?"}
{"category": "LocationDialogue Location17", "line_index": 142, "text": "Ne razumijem..."}
{"category": "LocationDialogue Location17", "line_index": 143, "text": "s kojim prekidačima trebaš moju pomoć ovdje?"}
{"category": "LocationDialogue Location17", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 145, "text": "// Put button"}
{"category": "LocationDialogue Location17", "line_index": 146, "text": "Ništa se nije dogodilo?"}
{"category": "LocationDialogue Location17", "line_index": 147, "text": "Što onda ovaj gumb radi ovdje?"}
{"category": "LocationDialogue Location17", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 149, "text": "// Cofee"}
{"category": "LocationDialogue Location17", "line_index": 150, "text": "Još malo kave?"}
{"category": "LocationDialogue Location17", "line_index": 151, "text": "Ili ćeš opet zaspati."}
{"category": "LocationDialogue Location17", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 153, "text": "Što?"}
{"category": "LocationDialogue Location17", "line_index": 154, "text": "Neee..."}
{"category": "LocationDialogue Location17", "line_index": 155, "text": "Ova kava ima grozan okus..."}
{"category": "LocationDialogue Location17", "line_index": 156, "text": "Totalno sam dobro..."}
{"category": "LocationDialogue Location17", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 158, "text": "// Button"}
{"category": "LocationDialogue Location17", "line_index": 159, "text": "Mita? Gumb ne radi... Čuješ li me?"}
{"category": "LocationDialogue Location17", "line_index": 160, "text": "Halo?"}
