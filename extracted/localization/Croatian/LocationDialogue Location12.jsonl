{"category": "LocationDialogue Location12", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Ostani ovdje."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Mislim da mi je nesto ispalo. Odmah se vracam."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "Onda idemo u drugi svijet..."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Okej."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Igrajmo se!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Zelim svog medu!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "Izgubila sam ga..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "Pronadji ga SADA!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Hej..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "sto to gledas?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Quest 1 (Who are you?)"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Ja sam Mita."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "Najbolja Mita."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "Prva Mita."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "Tako je Mita rekla, moja Mita."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Quest 2 (Why do you look like that?)"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "Kako izgledam?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "Kako izgledam?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "Kako izgledam?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "Moja Mita kaze da sam lijepa i originalna."}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "To sam ja!"}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Quest 3 (What was Mita doing here?)"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Ona ce me odvesti."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Zivjet cemo u novom svijetu."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "Pozvala me moja Mita."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Ona ce me odvesti. I mi cemo se igrati."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Quest 4 (Why do you need a teddy bear?)"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "Ti si mekani medo,"}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "a ti si izgubljen,"}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "bas kao moj mekani medo."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Quest 5 (Why is Mita angry?)"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "Moja..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "Mita."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Ona se zeli igrati."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Ona samo zeli"}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "mene."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Mi smo jedinstvene,"}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "jedine."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Mita i moja Mita,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0,8A i 8�54*."}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Quest 6 (Do you believe Mita?)"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "Moja Mita."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "Moja najbolja prijateljica."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "Moja Mita."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "Moja jedina prijateljica."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "To si ti!"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Hej."}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Igrajmo se!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Pokazat cu ti kako."}
