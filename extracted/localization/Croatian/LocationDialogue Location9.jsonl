{"category": "LocationDialogue Location9", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Hej, ti!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Bok!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Želiš izaći?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Onda mi pomozi pronaći ključ!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Kvragu! Nema ključa ovdje!"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Ništa ovdje-"}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "Nula, ništa, nada!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Našla sam!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// The usual conversation"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Huh, mislila sam da ćeš biti niži!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "Ti si visok-"}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "baš kao moja sestra!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "Tvoja sestra? Što s njom?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Da, moja sestra."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Nemoj mi reći da je nikad nisi upoznao!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Uh... Upoznao sam je... Ja mislim?"}
{"category": "LocationDialogue Location9", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Jesi li ti budala?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "Ovaj..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "Izgleda da jesi..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "Hajde, pomozi mi više da pronađem ključ!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// Next work"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Dođi."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Stavi željezo u cijev!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Hvala!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "Sad mi donesi to drvo!"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Hvala!"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Još malo pomoći, molim!"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Gotovo! Sada..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "vau, to je prekrasno."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Stisni, hajde!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Pripremi se..."}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "eto, uzmi!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "Ključ je tvoj!"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// Quest 1 (Are you Mita?)"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Ja sam ChibiMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Tone linija,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "najjednostavniji modeli, i—"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "najbolje od svega-prekrasna kosa!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// Quest 2 (Have we seen each other yet?)"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Glupko!"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "Malo si sladak, znaš,"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "postavljajući takva smiješna pitanja."}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Ipak,"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "ovo je moj prvi put da te upoznajem!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Ali slušaj..."}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Ako ukradeš moj divni izgled,"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "natjerat ću te da to požališ!"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// Quest 3 (Why are you here?)"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Zar ne shvaćaš?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "Ovo je kontrolna točka—"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "test tvoje pameti!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "Hajde sada!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Ovdje sam da vodim beznadno izgubljene!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// Quest 4 (Why are you helping me?)"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "Što tebe čini tako posebnim?"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "Zašto ti ne bi pomogla?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "Što?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Tako glupo..."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Upravo si se pojavio niotkuda!"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Ne bi trebao biti ovdje,"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "dakle, pomažem ti!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Zbogom, glupko!"}
