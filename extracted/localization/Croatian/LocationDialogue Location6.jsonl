{"category": "LocationDialogue Location6", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "Mita?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "Kako si, zaboga, dospio ovamo?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Ti si Mita, zar ne?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Ali kod tebe je nešto drugačije..."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "Vidim da obraćaš pažnju."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "I imaš pravo."}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "Ja nisam ona Mita koju si prije upoznao."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Budi oprezan, ona planira nešto"}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "zlokobno."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "Huh, nešto zlokobno?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "Nema vremena za objašnjavanje:"}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "ako ovo uspije, sve ću ti reći."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Uzmi ključ. Pokraj sofe je."}
{"category": "LocationDialogue Location6", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Ali..."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "Sačuvaj svoja pitanja za kasnije!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Daj mi ključ."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Uzmi ovaj prsten."}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "Šta?"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Želiš otići odavde, zar ne?"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "Uhm, da..."}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Onda ga stavi."}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "To je koristan artefakt,"}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "vjerojatno će ti uskoro trebati."}
{"category": "LocationDialogue Location6", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Okej..."}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "Usput, ja sam"}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Mmm,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "Ja sam... Mita."}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// MitaKind quest 1"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "Vidiš tu"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "konzolu? Podigni je."}
{"category": "LocationDialogue Location6", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "Gledamo li snimku?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "Tko je to s njom?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "To se događa ovog trenutka."}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "To je drugi igrač."}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Ona ga iskorištava."}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Mogla bi pokušati"}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "pretvoriti i tebe u kertridž."}
{"category": "LocationDialogue Location6", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "Moram što prije otići odavde."}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "I ti također."}
{"category": "LocationDialogue Location6", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "Da, moramo."}
{"category": "LocationDialogue Location6", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "Dakle, kažeš"}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "da ga ona iskorištava."}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "Ako izvučem kertridž, što će se dogoditi?"}
{"category": "LocationDialogue Location6", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "To će vjerojatno"}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "nepovratno oštetiti kertridž."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "Što znači da..."}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "bi igrač umro."}
{"category": "LocationDialogue Location6", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "..."}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "Što ako je samo isključim?"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "To bi moglo upaliti..."}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Vrijedi pokušati. Postoji crveni gumb za isključivanje!"}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Vidiš li ga?"}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "Našao sam."}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "Pritisni ga."}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// MitaKind quest 2"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Moram ostati."}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "Imam pitanja koja joj moram postaviti"}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "da bi saznala više o njoj."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "No, malo je vjerojatno da će mi udovoljiti..."}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// MitaKind quest 3"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "Da ti budem iskrena, ovo je moja verzija."}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "Pravila sam društvo igraču,"}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "kad se nešto iznenada promijenilo."}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "Onda se ona pojavila..."}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "i pretvorila igrača u kertridž"}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "i zaključala me."}
{"category": "LocationDialogue Location6", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Čekaj, ona ga je pretvorila u kertridž?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "Može li ona to uopće učiniti?"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "Ali zašto?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "Što joj trebaju igrači?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "Očito je luda..."}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Ona se samo igra s nama i koristi nas za vlastito zadovoljstvo!"}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "Pretvaranje igrača u kertridže..."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Neki nisu ni shvatili što im se događa..."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "A neki koji jesu, čak se nisu ni borili protiv toga... Gah!"}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "E to je mračni obrat..."}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "Moraš nam pomoći!"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "Ja? Ali kako?"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "Trebam te!"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "Ako ti pomogneš nama, ja ću pomoći tebi!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Ovo bi nam mogla biti jedina prilika."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "Prsten će te dovesti do prave verzije."}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "Naći ćemo se tamo."}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// MitaKind quest 4"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "Još uvijek mi nije sasvim jasno"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "što sam vidio gore..."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Ta Mita..."}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "Je li me pokušavala ubiti?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "Ubiti?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Ima goru sudbinu od te na umu za tebe..."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "Moraš požuriti."}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Hide!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "Ah, sranje! Sakrij se!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Čekaj, što...?"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Požuri, ona dolazi!"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "Slijedi prsten—odvest će te na sigurno!"}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "Pa, hoćeš li mi reći gdje je?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "Zašto bih?"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "Nećeš ga valjda ubiti?"}
{"category": "LocationDialogue Location6", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Ah, znači odbijaš mi reći."}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Hah, volim izazove."}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "Znam da je tu negdje."}
{"category": "LocationDialogue Location6", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "Zašto si tako zlobna prema nama?"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "Nećeš ni da mi kažeš što se događa!"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "Osim toga..."}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "što će ti igrači?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "Oni nisu igračke!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "Što te spopalo?!"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "Dosta! Drži jezik za zubima, lutko!"}
