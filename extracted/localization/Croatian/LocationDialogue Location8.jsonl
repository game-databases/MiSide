{"category": "LocationDialogue Location8", "line_index": 0, "text": "// The first meeting"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "Tko si ti?"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "Što je bilo?"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "Zar ne možeš govoriti?"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "Čekaj..."}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "Želiš otići, zar ne?"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "Da..."}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "Moram se vratiti"}
{"category": "LocationDialogue Location8", "line_index": 11, "text": "na prethodnu verziju."}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "Prethodna verzija?"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "Zašto bi napustio i otišao"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "negdje drugdje?"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "Zašto ne bi ostao ovdje"}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "i bio moj"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "drugi prijatelj?"}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Skipping all dialogs"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "U redu..."}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Standing by the window "}
{"category": "LocationDialogue Location8", "line_index": 24, "text": "Nećeš naći izlaz kroz vrata."}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "Izgleda da ti se žuri..."}
{"category": "LocationDialogue Location8", "line_index": 26, "text": "Trčanje u krug te neće spasiti."}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "Tako puno želiš pobijeći?"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "Pogledaj kroz prozore..."}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Aren't you Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "Igrač... ti si igrač, zar ne?"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": "Možemo se igrati zajedno."}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "Ako nađem snage,"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": "sve što trebamo je da se igramo."}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (What happened to you?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "Nisam sigurna i zapravo ne znam..."}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "Mislim da se ništa loše nije dogodilo..."}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "Ali sve što je dobro kao da izmiče..."}
{"category": "LocationDialogue Location8", "line_index": 41, "text": "Ipak, barem imam prijatelja."}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "Zašto su me ostavili?"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "Zar im nisam bila dovoljna?"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "Bojim se..."}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Quest 3 (Become a second friend?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "Prijatelji..."}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "Sada mi ih je ostalo tako malo."}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "Ostao je samo jedan..."}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "Tužna sam, igraču."}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "Hoćeš li mi biti prijatelj?"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "Volio bih,"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "ali moram ići dalje..."}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "Srce me boli..."}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Is this your house?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "Dom?"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "Igraču... promijenio si se..."}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "Ruke su ti kraće i ne izgledaš tako ljuto..."}
{"category": "LocationDialogue Location8", "line_index": 62, "text": "Igraču, postao si mekši, ljubazniji."}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "Nisam siguran..."}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "što to znači."}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "U redu je..."}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "jer me neće više boljeti, zar ne?"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (How do I leave this place?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "Stvarno me ostavljaš?"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "Je li ovo možda samo moja..."}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "sudbina?"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "Ja..."}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": "Vrata ti neće pomoći."}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Hold player (Random)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "Zašto bi otišao?"}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "Ostani ovdje..."}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "Igraj se sa mnom..."}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "Igraču..."}
