{"category": "LocationDialogue Location20", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Mila! Ne! Ti si luda!"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Ha-ha! ŠTO JE OVO?"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "Vidim li to novi izraz?"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "Hajde, da vidim još!"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "Stalno gledanje istog izraza lica postane tako dosadno!"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\""}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "Kako ide, moja nemirna lutalice?"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "Još trčiš okolo? Još ti nije dosta?"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Što si učinila Mili?"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "Oh, znači još nisi umoran!"}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Savršeno! Igrajmo još jednu igru!"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "Ti..."}
{"category": "LocationDialogue Location20", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "Pokrenimo stvari malim testom!"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "Testirajmo tvoju koordinaciju!"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "Tvoju sposobnost djelovanja!"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "Što ako s tobom nešto nije u redu!?"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "Što ako ne zaslužuješ ni tu KOŽU"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "koju si ponosan što nosiš!?"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "Pogledaj..."}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "Koji ti je zapeo za oko?"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "Desni?"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "Ili"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "lijevi?"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "Oj, ozbiljno?"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "Je li uopće bitno?"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "Samo sam se šalila s tobom!"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "Ubadanja su ionako stare vijesti."}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "Što god!"}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "Imam puno bolje igre u planu,"}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "kao..."}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "Pogledaj ovo!"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Trebamo malo glazbe!"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "Što misliš o ovoj melodiji?"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "Baš mi pumpa krv!"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "Ja ću početi"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "s pravilima!"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rules"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "Dok melodija svira,"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "smiješ se kretati."}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "Ali kad glazba stane,"}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "NE POMJERAJ SE!"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "Ili si mrtav. Kužiš?"}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "Jednostavno je: dođi do kraja"}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "prije nego pjesma završi."}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "Počnimo!"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "Još uvijek stojiš, ha?"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Trči, dušo, trči!"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "Oh!"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Pogledaj se! Tako si poslušan!"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Savršen mali primjerak."}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Želim te za sebe!"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "To je ipak bilo prelako, zar ne?"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "Pusti me!"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "Nemoj se previše raskomotiti!"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "Imamo još puno igara za igrati!"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "Evo sljedeće:"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Zatvorit ću oči..."}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "I kad ih otvorim,"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "bolje da te ne vidim!"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "Kužiš?"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "Ako te vidim, kaznit ću te!"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Dobro! Počnimo!"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "Ovo je besmisleno..."}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "Uspio si!"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Sjajno ti ide - ovo postaje uzbudljivo!"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "Ali sada će biti teže."}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "PUNO teže."}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Sakrij se, trči, vrti se—"}
{"category": "LocationDialogue Location20", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "Gah, prokleta bila!"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Player falls"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "Mislim da sam pobjegao..."}
