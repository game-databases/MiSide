{"category": "LocationDialogue Location4", "line_index": 0, "text": "Mita?"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "Ah, već si budan?"}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "Kako si dospjela ovdje?"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": "Upravo si bila odmah pored mene."}
{"category": "LocationDialogue Location4", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 5, "text": "Ne, nisam."}
{"category": "LocationDialogue Location4", "line_index": 6, "text": "Smrznuo si se pred ogledalom."}
{"category": "LocationDialogue Location4", "line_index": 7, "text": "Pa sam otišla."}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "Zašto su se sobe promijenile?"}
{"category": "LocationDialogue Location4", "line_index": 9, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "Preuredila sam"}
{"category": "LocationDialogue Location4", "line_index": 11, "text": "da se osjećaš više kao kod doma."}
{"category": "LocationDialogue Location4", "line_index": 12, "text": "Ovdje,"}
{"category": "LocationDialogue Location4", "line_index": 13, "text": "možemo promijeniti sobe"}
{"category": "LocationDialogue Location4", "line_index": 14, "text": "kako god želimo."}
{"category": "LocationDialogue Location4", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 16, "text": "Nisi trebala."}
{"category": "LocationDialogue Location4", "line_index": 17, "text": "Navikavao sam se na raspored soba."}
{"category": "LocationDialogue Location4", "line_index": 18, "text": "U svakom slučaju, mislim da ćeš se osjećati opuštenije s ovim rasporedom."}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Mita card game"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "U redu,"}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "hoćemo li igrati?"}
{"category": "LocationDialogue Location4", "line_index": 22, "text": "Igra se ovako:"}
{"category": "LocationDialogue Location4", "line_index": 23, "text": "Ovaj čip označava vrstu,"}
{"category": "LocationDialogue Location4", "line_index": 24, "text": "kao što je zdravlje."}
{"category": "LocationDialogue Location4", "line_index": 25, "text": "Svatko igra kartu,"}
{"category": "LocationDialogue Location4", "line_index": 26, "text": "a ako tvoja karta ima veću"}
{"category": "LocationDialogue Location4", "line_index": 27, "text": "jedinicu zdravlja"}
{"category": "LocationDialogue Location4", "line_index": 28, "text": "nego moja,"}
{"category": "LocationDialogue Location4", "line_index": 29, "text": "pobijedio si."}
{"category": "LocationDialogue Location4", "line_index": 30, "text": "Uzmi svoje karte."}
{"category": "LocationDialogue Location4", "line_index": 31, "text": "Ja sam na redu."}
{"category": "LocationDialogue Location4", "line_index": 32, "text": "Wow!"}
{"category": "LocationDialogue Location4", "line_index": 33, "text": "Dobila sam baš dobre karte!"}
{"category": "LocationDialogue Location4", "line_index": 34, "text": "Ja ću prva!"}
{"category": "LocationDialogue Location4", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 44, "text": "Okej!"}
{"category": "LocationDialogue Location4", "line_index": 45, "text": "Tvoj red!"}
{"category": "LocationDialogue Location4", "line_index": 46, "text": "Aha."}
{"category": "LocationDialogue Location4", "line_index": 47, "text": "Tvoj red!"}
{"category": "LocationDialogue Location4", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 49, "text": "Najveća jedinica zdravlja pobjeđuje!"}
{"category": "LocationDialogue Location4", "line_index": 50, "text": "Sve je u napadu!"}
{"category": "LocationDialogue Location4", "line_index": 51, "text": "Samo se usredotoči na odbranu!"}
{"category": "LocationDialogue Location4", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 54, "text": "Pobjedio si!"}
{"category": "LocationDialogue Location4", "line_index": 55, "text": "Pobjedio si!"}
{"category": "LocationDialogue Location4", "line_index": 56, "text": "Dobio si me."}
{"category": "LocationDialogue Location4", "line_index": 57, "text": "Oh ti..."}
{"category": "LocationDialogue Location4", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 59, "text": "Pobjedila sam!"}
{"category": "LocationDialogue Location4", "line_index": 60, "text": "Ja sam pobjednik!"}
{"category": "LocationDialogue Location4", "line_index": 61, "text": "Pobjedila sam te!"}
{"category": "LocationDialogue Location4", "line_index": 62, "text": "Hah, dobila sam te!"}
{"category": "LocationDialogue Location4", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 64, "text": "Neriješeno je."}
{"category": "LocationDialogue Location4", "line_index": 65, "text": "Sve jednako!"}
{"category": "LocationDialogue Location4", "line_index": 66, "text": "Neriješeno je!"}
{"category": "LocationDialogue Location4", "line_index": 67, "text": "Ista vrijednost..."}
{"category": "LocationDialogue Location4", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 79, "text": "// The card game is interrupted"}
{"category": "LocationDialogue Location4", "line_index": 80, "text": "Kakav je to zvuk?"}
{"category": "LocationDialogue Location4", "line_index": 81, "text": "Dolazi iz ormara."}
{"category": "LocationDialogue Location4", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 83, "text": "Zvuk?"}
{"category": "LocationDialogue Location4", "line_index": 84, "text": "Kakav zvuk?"}
{"category": "LocationDialogue Location4", "line_index": 85, "text": "Nisam ništa čula."}
{"category": "LocationDialogue Location4", "line_index": 86, "text": "Što si mislio da si čuo?"}
{"category": "LocationDialogue Location4", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 88, "text": "Kucanje, kao da je netko unutra."}
{"category": "LocationDialogue Location4", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 90, "text": "Ali..."}
{"category": "LocationDialogue Location4", "line_index": 91, "text": "Tamo nema nikoga..."}
{"category": "LocationDialogue Location4", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 93, "text": "Htio bih ga otvoriti i provjeriti."}
{"category": "LocationDialogue Location4", "line_index": 94, "text": "Malo mi je jezivo."}
{"category": "LocationDialogue Location4", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 96, "text": "Ali zašto...?"}
{"category": "LocationDialogue Location4", "line_index": 97, "text": "Opet ovo..."}
{"category": "LocationDialogue Location4", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 105, "text": "Što je s tobom!?"}
{"category": "LocationDialogue Location4", "line_index": 106, "text": "To je ormar..."}
{"category": "LocationDialogue Location4", "line_index": 107, "text": "Tu mi je donje rublje...!"}
{"category": "LocationDialogue Location4", "line_index": 108, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 109, "text": "Kriješ li nešto od mene?"}
{"category": "LocationDialogue Location4", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 111, "text": "Zašto mi jednostavno ne vjeruješ?"}
{"category": "LocationDialogue Location4", "line_index": 112, "text": "Što radim krivo?"}
{"category": "LocationDialogue Location4", "line_index": 113, "text": "Ono što želim..."}
{"category": "LocationDialogue Location4", "line_index": 114, "text": "Sve što želim je da budeš sa mnom."}
{"category": "LocationDialogue Location4", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 116, "text": "I ja bih volio to, ali ipak...?"}
{"category": "LocationDialogue Location4", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 118, "text": "Zašto si toliko zapeo za taj ormar?!"}
{"category": "LocationDialogue Location4", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 120, "text": "Želim znati što je zaboga bilo to kucanje!"}
{"category": "LocationDialogue Location4", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 122, "text": "Je li to zato što"}
{"category": "LocationDialogue Location4", "line_index": 123, "text": "ovaj svijet"}
{"category": "LocationDialogue Location4", "line_index": 124, "text": "ima samo ove četiri sobe?"}
{"category": "LocationDialogue Location4", "line_index": 125, "text": "Zar ti to nije dovoljno?"}
{"category": "LocationDialogue Location4", "line_index": 126, "text": "Zašto jednostavno ne možeš biti sa mnom?"}
{"category": "LocationDialogue Location4", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 129, "text": "// Don't stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 130, "text": "Shvaćam."}
{"category": "LocationDialogue Location4", "line_index": 131, "text": "Opet ovo..."}
{"category": "LocationDialogue Location4", "line_index": 132, "text": "Ako želiš pogledati u ormar,"}
{"category": "LocationDialogue Location4", "line_index": 133, "text": "onda učini to,"}
{"category": "LocationDialogue Location4", "line_index": 134, "text": "i saznaj što je unutra!"}
{"category": "LocationDialogue Location4", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 139, "text": "Što je..."}
{"category": "LocationDialogue Location4", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 141, "text": "To se ponekad dogodi."}
{"category": "LocationDialogue Location4", "line_index": 142, "text": "Soba je zapela pri učitavanju."}
{"category": "LocationDialogue Location4", "line_index": 143, "text": "Samo pričekaj sekundu."}
{"category": "LocationDialogue Location4", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 145, "text": "Ovo je tako čudno."}
{"category": "LocationDialogue Location4", "line_index": 146, "text": "Jesmo li u nečijem mobitelu?"}
{"category": "LocationDialogue Location4", "line_index": 147, "text": "Možda neki spori s dugim vremenima učitavanja?"}
{"category": "LocationDialogue Location4", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 149, "text": "Ne."}
{"category": "LocationDialogue Location4", "line_index": 150, "text": "Ali nije sve savršeno"}
{"category": "LocationDialogue Location4", "line_index": 151, "text": "u ovom svijetu..."}
{"category": "LocationDialogue Location4", "line_index": 152, "text": "Učitavamo se"}
{"category": "LocationDialogue Location4", "line_index": 153, "text": "zajedno sa jezgrom svijeta."}
{"category": "LocationDialogue Location4", "line_index": 154, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 155, "text": "Jezgrom svijeta?"}
{"category": "LocationDialogue Location4", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 157, "text": "Tipično, zar ne?"}
{"category": "LocationDialogue Location4", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 159, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 161, "text": "Svejedno, možemo"}
{"category": "LocationDialogue Location4", "line_index": 162, "text": "igrati igrice na konzoli"}
{"category": "LocationDialogue Location4", "line_index": 163, "text": "ili samo karte."}
{"category": "LocationDialogue Location4", "line_index": 164, "text": "Ti biraj."}
{"category": "LocationDialogue Location4", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 167, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 168, "text": "// Mita play fight"}
{"category": "LocationDialogue Location4", "line_index": 169, "text": "Želiš se boriti?"}
{"category": "LocationDialogue Location4", "line_index": 170, "text": "Moraš pobijediti"}
{"category": "LocationDialogue Location4", "line_index": 171, "text": "četiri puta."}
{"category": "LocationDialogue Location4", "line_index": 172, "text": "Hajde!"}
{"category": "LocationDialogue Location4", "line_index": 173, "text": "Ne brini, ja ću"}
{"category": "LocationDialogue Location4", "line_index": 174, "text": "biti blaža u početku."}
{"category": "LocationDialogue Location4", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 176, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 177, "text": "To je dobar dečko."}
{"category": "LocationDialogue Location4", "line_index": 178, "text": "Bolje se usredotoči!"}
{"category": "LocationDialogue Location4", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 180, "text": "Wow!"}
{"category": "LocationDialogue Location4", "line_index": 181, "text": "Dobro, u redu."}
{"category": "LocationDialogue Location4", "line_index": 182, "text": "Uozbiljit ću se."}
{"category": "LocationDialogue Location4", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 184, "text": "Wow!"}
{"category": "LocationDialogue Location4", "line_index": 185, "text": "Da vidimo možeš li"}
{"category": "LocationDialogue Location4", "line_index": 186, "text": "me pobijediti sad!"}
{"category": "LocationDialogue Location4", "line_index": 187, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 188, "text": "Ti si"}
{"category": "LocationDialogue Location4", "line_index": 189, "text": "jednostavno"}
{"category": "LocationDialogue Location4", "line_index": 190, "text": "nevjerojatan! To je vještina!"}
{"category": "LocationDialogue Location4", "line_index": 191, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 193, "text": "Što je bilo?"}
{"category": "LocationDialogue Location4", "line_index": 194, "text": "Huh, to je dosadno."}
{"category": "LocationDialogue Location4", "line_index": 195, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 196, "text": "Pa,"}
{"category": "LocationDialogue Location4", "line_index": 197, "text": "to je to. Vjeruješ li u sudbinu?"}
{"category": "LocationDialogue Location4", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 199, "text": "Vidi,"}
{"category": "LocationDialogue Location4", "line_index": 200, "text": "saberi se ili ćeš zauvijek biti gubitnik!"}
{"category": "LocationDialogue Location4", "line_index": 201, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 202, "text": "Što je s tobom danas?"}
{"category": "LocationDialogue Location4", "line_index": 203, "text": "Obrisala sam pod tobom."}
{"category": "LocationDialogue Location4", "line_index": 204, "text": "Nisi dao sve od sebe-"}
{"category": "LocationDialogue Location4", "line_index": 205, "text": "zato sam pobijedila!"}
{"category": "LocationDialogue Location4", "line_index": 206, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 208, "text": "U redu, onda."}
{"category": "LocationDialogue Location4", "line_index": 209, "text": "Šta kažeš da se igramo malo s kartama?"}
{"category": "LocationDialogue Location4", "line_index": 210, "text": "One su u spavaćoj sobi."}
{"category": "LocationDialogue Location4", "line_index": 211, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 214, "text": "// Door > [ERROR]"}
{"category": "LocationDialogue Location4", "line_index": 215, "text": "Huh, što se događa?"}
{"category": "LocationDialogue Location4", "line_index": 216, "text": "Gdje je..."}
{"category": "LocationDialogue Location4", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 218, "text": "Uh-oh."}
{"category": "LocationDialogue Location4", "line_index": 219, "text": "Oprosti..."}
{"category": "LocationDialogue Location4", "line_index": 220, "text": "Preuzela sam nešto"}
{"category": "LocationDialogue Location4", "line_index": 221, "text": "s neta."}
{"category": "LocationDialogue Location4", "line_index": 222, "text": "Htjela sam malo dotjerati"}
{"category": "LocationDialogue Location4", "line_index": 223, "text": "izgled vani."}
{"category": "LocationDialogue Location4", "line_index": 224, "text": "Ali ispade da"}
{"category": "LocationDialogue Location4", "line_index": 225, "text": "nešto nije bilo u redu s datotekom."}
{"category": "LocationDialogue Location4", "line_index": 226, "text": "Popravit ću to kasnije."}
{"category": "LocationDialogue Location4", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 228, "text": "Zato ne možemo izaći iz kuće?"}
{"category": "LocationDialogue Location4", "line_index": 229, "text": "Da, zato."}
{"category": "LocationDialogue Location4", "line_index": 230, "text": "// Mita shy"}
{"category": "LocationDialogue Location4", "line_index": 231, "text": "Hej..."}
{"category": "LocationDialogue Location4", "line_index": 232, "text": "Što je s tobom?"}
{"category": "LocationDialogue Location4", "line_index": 233, "text": "Želiš li nešto?"}
{"category": "LocationDialogue Location4", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 236, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 237, "text": "// Wall Clock"}
{"category": "LocationDialogue Location4", "line_index": 238, "text": "Ovaj ovdje sat,"}
{"category": "LocationDialogue Location4", "line_index": 239, "text": "koje vrijeme pokazuje?"}
{"category": "LocationDialogue Location4", "line_index": 240, "text": "Trenutno vrijeme u igri?"}
{"category": "LocationDialogue Location4", "line_index": 241, "text": "Ili je sinkronizirano s mojim telefonom?"}
{"category": "LocationDialogue Location4", "line_index": 242, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 243, "text": "Pa, uhm..."}
{"category": "LocationDialogue Location4", "line_index": 244, "text": "Iskreno ne znam."}
{"category": "LocationDialogue Location4", "line_index": 245, "text": "Ali vrijeme ovdje nije bitno..."}
{"category": "LocationDialogue Location4", "line_index": 246, "text": "Bilo kasno ili rano,"}
{"category": "LocationDialogue Location4", "line_index": 247, "text": "snažna djevojka poput mene"}
{"category": "LocationDialogue Location4", "line_index": 248, "text": "uvijek je puna energije-"}
{"category": "LocationDialogue Location4", "line_index": 249, "text": "Nikad se ne umorim!"}
{"category": "LocationDialogue Location4", "line_index": 250, "text": "Možemo imati vječno proljeće,"}
{"category": "LocationDialogue Location4", "line_index": 251, "text": "ili beskrajno popodne!"}
{"category": "LocationDialogue Location4", "line_index": 252, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 253, "text": "To je zanimljivo..."}
{"category": "LocationDialogue Location4", "line_index": 254, "text": "ali i pomalo jezivo."}
{"category": "LocationDialogue Location4", "line_index": 255, "text": "Zaglavljen u istom trenutku, zauvijek..."}
{"category": "LocationDialogue Location4", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 258, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 259, "text": "// Photos of Mita"}
{"category": "LocationDialogue Location4", "line_index": 260, "text": "Lijepe fotke."}
{"category": "LocationDialogue Location4", "line_index": 261, "text": "Pretpostavljam da su ovo tvoje?"}
{"category": "LocationDialogue Location4", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 263, "text": "Da."}
{"category": "LocationDialogue Location4", "line_index": 264, "text": "I meni se sviđaju."}
{"category": "LocationDialogue Location4", "line_index": 265, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 266, "text": "Tko ih je slikao?"}
{"category": "LocationDialogue Location4", "line_index": 267, "text": "Postoje li drugi u ovom svijetu?"}
{"category": "LocationDialogue Location4", "line_index": 268, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 269, "text": "Moglo bi se reći."}
{"category": "LocationDialogue Location4", "line_index": 270, "text": "Upoznat ću te nekad."}
{"category": "LocationDialogue Location4", "line_index": 271, "text": "Samo ne još."}
{"category": "LocationDialogue Location4", "line_index": 272, "text": "Za sada samo želim biti sama s tobom."}
{"category": "LocationDialogue Location4", "line_index": 273, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 275, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 276, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 277, "text": "// Portal"}
{"category": "LocationDialogue Location4", "line_index": 278, "text": "Gdje je nestao portal?"}
{"category": "LocationDialogue Location4", "line_index": 279, "text": "Ili kako god si ga zvala?"}
{"category": "LocationDialogue Location4", "line_index": 280, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 281, "text": "Koristila sam"}
{"category": "LocationDialogue Location4", "line_index": 282, "text": "malo magije"}
{"category": "LocationDialogue Location4", "line_index": 283, "text": "i pomaknula sam ga"}
{"category": "LocationDialogue Location4", "line_index": 284, "text": "negdje drugdje."}
{"category": "LocationDialogue Location4", "line_index": 285, "text": "Ne treba nam više."}
{"category": "LocationDialogue Location4", "line_index": 286, "text": "Samo bi smetao."}
{"category": "LocationDialogue Location4", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 288, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 289, "text": "// Mirror in the bedroom"}
{"category": "LocationDialogue Location4", "line_index": 290, "text": "Gledanje u ogledalo bez"}
{"category": "LocationDialogue Location4", "line_index": 291, "text": "da vidim odraz — jezivo je."}
{"category": "LocationDialogue Location4", "line_index": 292, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 293, "text": "Možemo uključiti odraze"}
{"category": "LocationDialogue Location4", "line_index": 294, "text": "ako baš želiš."}
{"category": "LocationDialogue Location4", "line_index": 295, "text": "Ali, trebaju li nam oni doista?"}
{"category": "LocationDialogue Location4", "line_index": 296, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 297, "text": "Naravno da trebaju."}
{"category": "LocationDialogue Location4", "line_index": 298, "text": "Ili... hoće li njihovo uključivanje imati posljedice?"}
{"category": "LocationDialogue Location4", "line_index": 299, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 300, "text": "Da."}
{"category": "LocationDialogue Location4", "line_index": 301, "text": "Štekat ćemo i kretati se sporije."}
{"category": "LocationDialogue Location4", "line_index": 302, "text": "Jesi li ikada vidjeo crtani film s malo sličica po sekundi?"}
{"category": "LocationDialogue Location4", "line_index": 303, "text": "Tako će nam biti, stalno."}
{"category": "LocationDialogue Location4", "line_index": 304, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 305, "text": "Shvaćam."}
{"category": "LocationDialogue Location4", "line_index": 306, "text": "Onda je možda bolje da odrazi ostanu isključeni..."}
{"category": "LocationDialogue Location4", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 308, "text": "Hej, [player],"}
{"category": "LocationDialogue Location4", "line_index": 309, "text": "baš voliš ogledala, zar ne?"}
{"category": "LocationDialogue Location4", "line_index": 310, "text": "Bojiš si vidjeti osmijeh na tom svom licu?"}
{"category": "LocationDialogue Location4", "line_index": 311, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 312, "text": "Ha? Ne baš..."}
{"category": "LocationDialogue Location4", "line_index": 313, "text": "Samo sam umoran"}
{"category": "LocationDialogue Location4", "line_index": 314, "text": "nakon svog posla."}
{"category": "LocationDialogue Location4", "line_index": 315, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 316, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 317, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 318, "text": "// Blue Sneakers"}
{"category": "LocationDialogue Location4", "line_index": 319, "text": "Jesu li ove tvoje?"}
{"category": "LocationDialogue Location4", "line_index": 320, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 321, "text": "Ne, tvoje su."}
{"category": "LocationDialogue Location4", "line_index": 322, "text": "Zar se ne sjećaš?"}
{"category": "LocationDialogue Location4", "line_index": 323, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 324, "text": "Ne sjećam se da sam imao takve tenisice."}
{"category": "LocationDialogue Location4", "line_index": 325, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 326, "text": "Znaš sada."}
{"category": "LocationDialogue Location4", "line_index": 327, "text": "Možeš ih nositi"}
{"category": "LocationDialogue Location4", "line_index": 328, "text": "kad krenemo van."}
{"category": "LocationDialogue Location4", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 330, "text": "Što je s odjećom?"}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "Sve što imam u ovom svijetu"}
{"category": "LocationDialogue Location4", "line_index": 332, "text": "je odjeća koju nosim."}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "Ima li načina da nabavim novu?"}
{"category": "LocationDialogue Location4", "line_index": 334, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 335, "text": "Naravno da ih ima."}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "Ipak, vidjela sam što nosiš—"}
{"category": "LocationDialogue Location4", "line_index": 337, "text": "i iskreno, tvoj ukus nije sjajan."}
{"category": "LocationDialogue Location4", "line_index": 338, "text": "U svakom slučaju, pomoći ću ti da nabaviš nešto."}
{"category": "LocationDialogue Location4", "line_index": 339, "text": "Samo ne sada."}
{"category": "LocationDialogue Location4", "line_index": 340, "text": "To je obećanje."}
{"category": "LocationDialogue Location4", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 342, "text": "U redu."}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Games on TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "Što želiš igrati?"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Game milk"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "Ovo je borbena igra!"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "Da vidimo tko će se prvi skiseliti!"}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "Kakva igra!"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": "Dosta nam je mlijeka za sada, idemo raditi nešto drugo."}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Game penguins"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "U ovoj igrici si pingvin"}
{"category": "LocationDialogue Location4", "line_index": 354, "text": "klizeći uokolo."}
{"category": "LocationDialogue Location4", "line_index": 355, "text": "Točno, to je ta igra."}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Stay"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "Ha, molim?"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "Ozbiljan si? Mislila sam da..."}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "Presretna sam!"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "I pomalo zbunjena..."}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "Ali..."}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "Molim te, ostani sa mnom-"}
{"category": "LocationDialogue Location4", "line_index": 364, "text": "uvijek i zauvijek."}
{"category": "LocationDialogue Location4", "line_index": 365, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 367, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 368, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 369, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 370, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 372, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 373, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 374, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 375, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 376, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 377, "text": "// A game about penguins"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "Jako je jednostavno:"}
{"category": "LocationDialogue Location4", "line_index": 379, "text": "samo skupljaj grudve snijega."}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "Onaj tko skupi više, pobjeđuje!"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "Igrajmo dvije runde, može?!"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// The first map"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "Wow, kako si ih dobio toliko?"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "Tee-hee! Ja imam najviše snježnih gruda!"}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "Bolje sustigni!"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "Ha, 1:1!"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// The second map"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "Ti si pravi pingvin!"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "Trebali bismo te staviti na pravi led!"}
{"category": "LocationDialogue Location4", "line_index": 390, "text": "Pff, tako si spor."}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "Još uvijek razmišljš o prošloj rundi?"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "Wow, izjednačeno! To je rijetko!"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// The game is over"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "Dobro, želiš igrati nešto drugo?"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "Ili ti je dosta?"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "Što ti to treba?"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "Baš si toliki gamer?"}
