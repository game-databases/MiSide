{"category": "LocationDialogue Location13", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 1, "text": "Prsten."}
{"category": "LocationDialogue Location13", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 3, "text": "// Answer 1 (Where have you been all this time?)"}
{"category": "LocationDialogue Location13", "line_index": 4, "text": "Tražila sam način da te dovedem do Jezgra."}
{"category": "LocationDialogue Location13", "line_index": 5, "text": "U jednom komadu, to jest."}
{"category": "LocationDialogue Location13", "line_index": 6, "text": "To je cijelo vrijeme bio plan, zar ne?"}
{"category": "LocationDialogue Location13", "line_index": 7, "text": "Zato sam morala izbjegavati"}
{"category": "LocationDialogue Location13", "line_index": 8, "text": "Ludu Mitu, zar ne?"}
{"category": "LocationDialogue Location13", "line_index": 9, "text": "Također sam morala iskopati sve informacije koje sam mogla"}
{"category": "LocationDialogue Location13", "line_index": 10, "text": "o bekendu prokletog svemira, zar ne?"}
{"category": "LocationDialogue Location13", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 12, "text": "Hmm... valjda...?"}
{"category": "LocationDialogue Location13", "line_index": 13, "text": "Ali kako si odredila rutu prstena?"}
{"category": "LocationDialogue Location13", "line_index": 14, "text": "Zašto sam završio u baganoj verziji"}
{"category": "LocationDialogue Location13", "line_index": 15, "text": "prepunoj opasnosti?"}
{"category": "LocationDialogue Location13", "line_index": 16, "text": "Jedva sam pobjegao tako što sam"}
{"category": "LocationDialogue Location13", "line_index": 17, "text": "skočio u beskrajnu tamu."}
{"category": "LocationDialogue Location13", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 19, "text": "Izvini, zaboravila sam ti detaljno reći"}
{"category": "LocationDialogue Location13", "line_index": 20, "text": "što si trebao učiniti..."}
{"category": "LocationDialogue Location13", "line_index": 21, "text": "Ali da, to je bio plan od početka,"}
{"category": "LocationDialogue Location13", "line_index": 22, "text": "da skočiš..."}
{"category": "LocationDialogue Location13", "line_index": 23, "text": "I dobro je, uspjeo si!"}
{"category": "LocationDialogue Location13", "line_index": 24, "text": "Svaka čast!"}
{"category": "LocationDialogue Location13", "line_index": 25, "text": "U redu, nastavimo s planom."}
{"category": "LocationDialogue Location13", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 27, "text": "// Answer 2 (How did you get here?)"}
{"category": "LocationDialogue Location13", "line_index": 28, "text": "Mora da si prošao kroz mnogo toga,"}
{"category": "LocationDialogue Location13", "line_index": 29, "text": "jer izgleda da zaboravljaš o čemu smo razgovarali."}
{"category": "LocationDialogue Location13", "line_index": 30, "text": "Ja sam Mita, mogu se kretati među verzijama"}
{"category": "LocationDialogue Location13", "line_index": 31, "text": "kako god želim, sjećaš se?"}
{"category": "LocationDialogue Location13", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 33, "text": "Ne mogu sve Mite to učiniti,"}
{"category": "LocationDialogue Location13", "line_index": 34, "text": "Vidio sam neke koje ne mogu."}
{"category": "LocationDialogue Location13", "line_index": 35, "text": "I očito je da pate."}
{"category": "LocationDialogue Location13", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 37, "text": "Da, njihove verzije su pokvarene,"}
{"category": "LocationDialogue Location13", "line_index": 38, "text": "njihovi svjetovi bagani. Rekla sam ti prije."}
{"category": "LocationDialogue Location13", "line_index": 39, "text": "K vragu..."}
{"category": "LocationDialogue Location13", "line_index": 40, "text": "Znaš tko stoji iza svega ovoga, zar ne?"}
{"category": "LocationDialogue Location13", "line_index": 41, "text": "Luda Mita."}
{"category": "LocationDialogue Location13", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 43, "text": "Da, ona je sigurno..."}
{"category": "LocationDialogue Location13", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 45, "text": "// Answer 3 (Who was this Mita just now?)"}
{"category": "LocationDialogue Location13", "line_index": 46, "text": "To je Ružna Mita."}
{"category": "LocationDialogue Location13", "line_index": 47, "text": "Agresivna i glupa."}
{"category": "LocationDialogue Location13", "line_index": 48, "text": "Ne možeš s njom razgovarati normalno,"}
{"category": "LocationDialogue Location13", "line_index": 49, "text": "cijeli joj se svijet vrti oko Lude Mite."}
{"category": "LocationDialogue Location13", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 51, "text": "Da, primijetio sam."}
{"category": "LocationDialogue Location13", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 53, "text": "Hajde, moramo doći do Jezgra."}
{"category": "LocationDialogue Location13", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 55, "text": "// Answer 4 (How does the ring work?)"}
{"category": "LocationDialogue Location13", "line_index": 56, "text": "A prsten,"}
{"category": "LocationDialogue Location13", "line_index": 57, "text": "je li to jedini put do Jezgra?"}
{"category": "LocationDialogue Location13", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 59, "text": "Da."}
{"category": "LocationDialogue Location13", "line_index": 60, "text": "Naravno, kad bismo imali portal"}
{"category": "LocationDialogue Location13", "line_index": 61, "text": "mogli bismo te samo teleportirati"}
{"category": "LocationDialogue Location13", "line_index": 62, "text": "do tamo tamo."}
{"category": "LocationDialogue Location13", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 64, "text": "Ima li prsten prednosti?"}
{"category": "LocationDialogue Location13", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 66, "text": "Naravno!"}
{"category": "LocationDialogue Location13", "line_index": 67, "text": "Lako se nosi,"}
{"category": "LocationDialogue Location13", "line_index": 68, "text": "i pamti verzije"}
{"category": "LocationDialogue Location13", "line_index": 69, "text": "koje si već posjetio,"}
{"category": "LocationDialogue Location13", "line_index": 70, "text": "tako da se možeš lako vratiti natrag."}
{"category": "LocationDialogue Location13", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 72, "text": "// Answer 5 (Why does Mad Mita need me?)"}
{"category": "LocationDialogue Location13", "line_index": 73, "text": "Zašto me Luda Mita ne ostavi na miru?"}
{"category": "LocationDialogue Location13", "line_index": 74, "text": "Uvukla me je u svoju opasnu igru,"}
{"category": "LocationDialogue Location13", "line_index": 75, "text": "ali još sam živ..."}
{"category": "LocationDialogue Location13", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 77, "text": "Moja pretpostavka"}
{"category": "LocationDialogue Location13", "line_index": 78, "text": "je da traži odgovarajućeg igrača..."}
{"category": "LocationDialogue Location13", "line_index": 79, "text": "Onog koji će je prihvatiti onakvu kakva jest."}
{"category": "LocationDialogue Location13", "line_index": 80, "text": "Ipak je Mita Mita!"}
{"category": "LocationDialogue Location13", "line_index": 81, "text": "Kako se to očito nikad neće dogoditi,"}
{"category": "LocationDialogue Location13", "line_index": 82, "text": "ona pretvara igrače u kertridže,"}
{"category": "LocationDialogue Location13", "line_index": 83, "text": "tako da nitko nikada ne može pobjeći ..."}
{"category": "LocationDialogue Location13", "line_index": 84, "text": "Barem ja tako pretpostavljam."}
{"category": "LocationDialogue Location13", "line_index": 85, "text": "U svakom slučaju, usredotočimo se na ono što je važno."}
{"category": "LocationDialogue Location13", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 87, "text": "// Answer 6 (Is this the core?)"}
{"category": "LocationDialogue Location13", "line_index": 88, "text": "Je li to to?"}
{"category": "LocationDialogue Location13", "line_index": 89, "text": "Jezgro?"}
{"category": "LocationDialogue Location13", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 91, "text": "Tako je. Jezgro."}
{"category": "LocationDialogue Location13", "line_index": 92, "text": "Pokušala sam objasniti,"}
{"category": "LocationDialogue Location13", "line_index": 93, "text": "vi igrači niste dio ovog svijeta..."}
{"category": "LocationDialogue Location13", "line_index": 94, "text": "Što znači, ne treba vam posebna dozvola za ulazak."}
{"category": "LocationDialogue Location13", "line_index": 95, "text": "Ili, barem ja u to vjerujem."}
{"category": "LocationDialogue Location13", "line_index": 96, "text": "U svakom slučaju, više nego sigurna sam"}
{"category": "LocationDialogue Location13", "line_index": 97, "text": "da se rješenje za sve naše probleme"}
{"category": "LocationDialogue Location13", "line_index": 98, "text": "može naći unutra!"}
{"category": "LocationDialogue Location13", "line_index": 99, "text": "[player], uđi unutra."}
{"category": "LocationDialogue Location13", "line_index": 100, "text": "Stvarno si uspio..."}
{"category": "LocationDialogue Location13", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 102, "text": "// Look on CoreMita"}
{"category": "LocationDialogue Location13", "line_index": 103, "text": "Oprezno, [player]."}
{"category": "LocationDialogue Location13", "line_index": 104, "text": "Promatra te."}
{"category": "LocationDialogue Location13", "line_index": 105, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 106, "text": "Tko je to?"}
{"category": "LocationDialogue Location13", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 108, "text": "Ne znam ni ja..."}
{"category": "LocationDialogue Location13", "line_index": 109, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 110, "text": "Super..."}
{"category": "LocationDialogue Location13", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 113, "text": "Što je to?"}
{"category": "LocationDialogue Location13", "line_index": 114, "text": "Hej!"}
{"category": "LocationDialogue Location13", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 116, "text": "Mislim da sam našao!"}
{"category": "LocationDialogue Location13", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 118, "text": "Nevjerojatno! To je super!"}
{"category": "LocationDialogue Location13", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 120, "text": "Ali moram navesti verziju."}
{"category": "LocationDialogue Location13", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 122, "text": "Da, njena verzija je..."}
{"category": "LocationDialogue Location13", "line_index": 123, "text": "00.98"}
{"category": "LocationDialogue Location13", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 125, "text": "Pogodak!"}
{"category": "LocationDialogue Location13", "line_index": 126, "text": "Okej, a koji indeks?"}
{"category": "LocationDialogue Location13", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 128, "text": "Umm, indeks?"}
{"category": "LocationDialogue Location13", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 130, "text": "Treba mi indeks."}
{"category": "LocationDialogue Location13", "line_index": 131, "text": "Čekaj, nemoj mi reći da ne znaš...?"}
{"category": "LocationDialogue Location13", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 134, "text": "Hmm, to ipak ima smisla..."}
{"category": "LocationDialogue Location13", "line_index": 135, "text": "Svaka Mita ima indeks,"}
{"category": "LocationDialogue Location13", "line_index": 136, "text": "tako da ne možeš jednostavno restartovati cijelu verziju..."}
{"category": "LocationDialogue Location13", "line_index": 137, "text": "To bi izazvalo potpuni haos!"}
{"category": "LocationDialogue Location13", "line_index": 138, "text": "Ne mogu vjerovati da se toga nisam sjetila..."}
{"category": "LocationDialogue Location13", "line_index": 139, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 144, "text": "// Answer 1 (What's wrong with you?)"}
{"category": "LocationDialogue Location13", "line_index": 145, "text": "Pored svih naših nevolja,"}
{"category": "LocationDialogue Location13", "line_index": 146, "text": "Sasvim sam dobro."}
{"category": "LocationDialogue Location13", "line_index": 147, "text": "Sve je super, ali puno toga se promijenilo..."}
{"category": "LocationDialogue Location13", "line_index": 148, "text": "Moram razmisliti."}
{"category": "LocationDialogue Location13", "line_index": 149, "text": "I to je to."}
{"category": "LocationDialogue Location13", "line_index": 150, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 151, "text": "// Answer 2 (Maybe there's a way to get to know him?)"}
{"category": "LocationDialogue Location13", "line_index": 152, "text": "Ja..."}
{"category": "LocationDialogue Location13", "line_index": 153, "text": "Mislim... da je to ludo!"}
{"category": "LocationDialogue Location13", "line_index": 154, "text": "To je ludilo, haha!"}
{"category": "LocationDialogue Location13", "line_index": 155, "text": "To je kao da tražiš iglu u..."}
{"category": "LocationDialogue Location13", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 157, "text": "Što to radiš?"}
{"category": "LocationDialogue Location13", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 159, "text": "Neke prepreke budu nagrižene sa informacijama,"}
{"category": "LocationDialogue Location13", "line_index": 160, "text": "znaš, kao da se svijetu iščupa utroba!"}
{"category": "LocationDialogue Location13", "line_index": 161, "text": "Zapisi, zapisi, zapisi, podaci?"}
{"category": "LocationDialogue Location13", "line_index": 162, "text": "Što ako je to to?"}
{"category": "LocationDialogue Location13", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 164, "text": "Huh? Što je bilo?"}
{"category": "LocationDialogue Location13", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 166, "text": "Znam mjesto!"}
{"category": "LocationDialogue Location13", "line_index": 167, "text": "Čekaj ovdje."}
{"category": "LocationDialogue Location13", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 169, "text": "Kamo ideš?"}
{"category": "LocationDialogue Location13", "line_index": 170, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 171, "text": "// Answer 3 (What if we attack Mad Mita?)"}
{"category": "LocationDialogue Location13", "line_index": 172, "text": "Rekla si da se bilo koja Mita"}
{"category": "LocationDialogue Location13", "line_index": 173, "text": "vraća na tvorničke postavke nakon smrti..."}
{"category": "LocationDialogue Location13", "line_index": 174, "text": "Što ako bi mi..."}
{"category": "LocationDialogue Location13", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 176, "text": "samo ubili Ludu Mitu?"}
{"category": "LocationDialogue Location13", "line_index": 177, "text": "Ti si ozbiljan?"}
{"category": "LocationDialogue Location13", "line_index": 178, "text": "A kako ćeš s luđakinjom s motornom pilom?"}
{"category": "LocationDialogue Location13", "line_index": 179, "text": "Ona ne reže mrkve samo sa noževima!"}
{"category": "LocationDialogue Location13", "line_index": 180, "text": "I iz nekog razloga, ona je zastrašujuće jaka!"}
{"category": "LocationDialogue Location13", "line_index": 181, "text": "Pravo je čudo da smo još živi..."}
{"category": "LocationDialogue Location13", "line_index": 182, "text": "Hajde, moramo doći do Jezgra."}
{"category": "LocationDialogue Location13", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 185, "text": "// core console entry"}
{"category": "LocationDialogue Location13", "line_index": 186, "text": "Moramo unijeti šifru..."}
{"category": "LocationDialogue Location13", "line_index": 187, "text": "Ali kako ja da to znam?"}
{"category": "LocationDialogue Location13", "line_index": 188, "text": "Mita, znaš li ti?"}
{"category": "LocationDialogue Location13", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 190, "text": "Možda je negdje navedeno?"}
{"category": "LocationDialogue Location13", "line_index": 191, "text": "Možeš li je pokušati potražiti?"}
{"category": "LocationDialogue Location13", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 193, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location13", "line_index": 194, "text": "To vjerojatno nije to."}
{"category": "LocationDialogue Location13", "line_index": 195, "text": "Ni to nije u redu."}
{"category": "LocationDialogue Location13", "line_index": 196, "text": "Ne, pogrešno."}
{"category": "LocationDialogue Location13", "line_index": 197, "text": "Nije to to."}
{"category": "LocationDialogue Location13", "line_index": 198, "text": "Moram pronaći opciju resetiranja likova."}
{"category": "LocationDialogue Location13", "line_index": 199, "text": "// core console - nope version"}
{"category": "LocationDialogue Location13", "line_index": 200, "text": "To je kriva verzija."}
{"category": "LocationDialogue Location13", "line_index": 201, "text": "Ups, moja greška."}
{"category": "LocationDialogue Location13", "line_index": 202, "text": "Nije to to."}
{"category": "LocationDialogue Location13", "line_index": 203, "text": "Trebat će neki drugi."}
{"category": "LocationDialogue Location13", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location13", "line_index": 205, "text": "Nešto nije u redu"}
{"category": "LocationDialogue Location13", "line_index": 206, "text": "s indeksom."}
{"category": "LocationDialogue Location13", "line_index": 207, "text": "Moram promijeniti indeks,"}
{"category": "LocationDialogue Location13", "line_index": 208, "text": "ne pristaje."}
{"category": "LocationDialogue Location13", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 210, "text": "// Answer 4 (Little people - Chibi)"}
{"category": "LocationDialogue Location13", "line_index": 211, "text": "Znaš, naletio sam na hrpu"}
{"category": "LocationDialogue Location13", "line_index": 212, "text": "mini-ljudi na putu..."}
{"category": "LocationDialogue Location13", "line_index": 213, "text": "Što su oni?"}
{"category": "LocationDialogue Location13", "line_index": 214, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 215, "text": "Oni Chibi?"}
{"category": "LocationDialogue Location13", "line_index": 216, "text": "Hm, kako objasniti...?"}
{"category": "LocationDialogue Location13", "line_index": 217, "text": "Ovdje je to fenomen..."}
{"category": "LocationDialogue Location13", "line_index": 218, "text": "Svaka Mita ima Chibi projekciju,"}
{"category": "LocationDialogue Location13", "line_index": 219, "text": "a mogu ih imati i igrači..."}
{"category": "LocationDialogue Location13", "line_index": 220, "text": "Jesi li znao da ih mi Mite možemo prizvati?"}
{"category": "LocationDialogue Location13", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 222, "text": "Huh, kako?"}
{"category": "LocationDialogue Location13", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 224, "text": "Gledaj ovo!"}
{"category": "LocationDialogue Location13", "line_index": 225, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 226, "text": "Baš poput magije..."}
{"category": "LocationDialogue Location13", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 228, "text": "Ali nešto nije u redu s mojim Chibi-ma,"}
{"category": "LocationDialogue Location13", "line_index": 229, "text": "većina se jednostavno rode mrtvi."}
{"category": "LocationDialogue Location13", "line_index": 230, "text": "Ali ima ova..."}
{"category": "LocationDialogue Location13", "line_index": 231, "text": "odnosno,"}
{"category": "LocationDialogue Location13", "line_index": 232, "text": "ona samo trči u krug."}
