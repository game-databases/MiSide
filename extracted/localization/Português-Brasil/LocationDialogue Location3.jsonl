{"category": "LocationDialogue Location3", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 1, "text": "Oii, [player]!"}
{"category": "LocationDialogue Location3", "line_index": 2, "text": "A gente finalmente se encontrou!"}
{"category": "LocationDialogue Location3", "line_index": 3, "text": "Eu estou tão empolgada!"}
{"category": "LocationDialogue Location3", "line_index": 4, "text": "Eu imagino que você tenha muitas perguntas para fazer..."}
{"category": "LocationDialogue Location3", "line_index": 5, "text": "Bem, como pode ver..."}
{"category": "LocationDialogue Location3", "line_index": 6, "text": "Eu fiz um dispositivo especial"}
{"category": "LocationDialogue Location3", "line_index": 7, "text": "Para poder te ter aqui do meu lado."}
{"category": "LocationDialogue Location3", "line_index": 8, "text": "Mas meio que você acabou indo para uma outra versão do jogo..."}
{"category": "LocationDialogue Location3", "line_index": 9, "text": "Uma versão em que eu..."}
{"category": "LocationDialogue Location3", "line_index": 10, "text": "Eh...é uma longa historia!"}
{"category": "LocationDialogue Location3", "line_index": 11, "text": "De toda forma, eu estou muito feliz em te ver!"}
{"category": "LocationDialogue Location3", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 13, "text": "// Resposta 1 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 14, "text": "É claro que sou eu."}
{"category": "LocationDialogue Location3", "line_index": 15, "text": "E você deve ser...Você né?"}
{"category": "LocationDialogue Location3", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 17, "text": "// Resposta 2 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 18, "text": "Você já quer voltar?"}
{"category": "LocationDialogue Location3", "line_index": 19, "text": "Hm...Eu acho que posso te ajudar com isso...Mas como é que eu vou ficar?"}
{"category": "LocationDialogue Location3", "line_index": 20, "text": "Você não pode ficar só mais um pouquinho?"}
{"category": "LocationDialogue Location3", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 22, "text": "// Resposta 3 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 23, "text": "Deixa eu te explicar..."}
{"category": "LocationDialogue Location3", "line_index": 24, "text": "Aah te achei!"}
{"category": "LocationDialogue Location3", "line_index": 25, "text": "Conseguiu entender?"}
{"category": "LocationDialogue Location3", "line_index": 26, "text": "Uhm... Não mesmo."}
{"category": "LocationDialogue Location3", "line_index": 27, "text": "Tá tudo bem!"}
{"category": "LocationDialogue Location3", "line_index": 28, "text": "O importante é que a gente tá junto agora."}
{"category": "LocationDialogue Location3", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 31, "text": "Você tá com fome?"}
{"category": "LocationDialogue Location3", "line_index": 32, "text": "Que tal a gente cozinhar alguma coisa?"}
{"category": "LocationDialogue Location3", "line_index": 33, "text": "Aqui,"}
{"category": "LocationDialogue Location3", "line_index": 34, "text": "Pode me ajudar com as cenouras."}
{"category": "LocationDialogue Location3", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 36, "text": "De onde vieram os vegetais?"}
{"category": "LocationDialogue Location3", "line_index": 37, "text": "Eles não estavam aqui antes."}
{"category": "LocationDialogue Location3", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 39, "text": "[player], a gente tá num jogo bobinho."}
{"category": "LocationDialogue Location3", "line_index": 40, "text": "Vamos lá, me ajuda."}
{"category": "LocationDialogue Location3", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 42, "text": "Obrigada!"}
{"category": "LocationDialogue Location3", "line_index": 43, "text": "Você consegue pegar a tesoura para mim?"}
{"category": "LocationDialogue Location3", "line_index": 44, "text": "Tá lá no banheiro."}
{"category": "LocationDialogue Location3", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 46, "text": "Senta, fica a vontade."}
{"category": "LocationDialogue Location3", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 49, "text": "// Cozinha"}
{"category": "LocationDialogue Location3", "line_index": 50, "text": "Quer um pouquinho de molho?"}
{"category": "LocationDialogue Location3", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 52, "text": "Não obrigado."}
{"category": "LocationDialogue Location3", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 54, "text": "Ah...Tudo bem então."}
{"category": "LocationDialogue Location3", "line_index": 55, "text": "Esse molho deixa a comida ainda melhor!"}
{"category": "LocationDialogue Location3", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 58, "text": "Obrigado."}
{"category": "LocationDialogue Location3", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 60, "text": "Nossa! Já terminou?"}
{"category": "LocationDialogue Location3", "line_index": 61, "text": "Parece que o meu...."}
{"category": "LocationDialogue Location3", "line_index": 62, "text": "Nunca acaba..."}
{"category": "LocationDialogue Location3", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 65, "text": "// Ajuda"}
{"category": "LocationDialogue Location3", "line_index": 66, "text": "Ei?! Qual o problema?"}
{"category": "LocationDialogue Location3", "line_index": 67, "text": "Me fala tudo que você tá sentindo."}
{"category": "LocationDialogue Location3", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 69, "text": "Meu coração tá agitado,"}
{"category": "LocationDialogue Location3", "line_index": 70, "text": "E minha visão tá ficando turva."}
{"category": "LocationDialogue Location3", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 72, "text": "Entendi."}
{"category": "LocationDialogue Location3", "line_index": 73, "text": "Eu já sei o que aconteceu"}
{"category": "LocationDialogue Location3", "line_index": 74, "text": "Consegue ficar de pé?"}
{"category": "LocationDialogue Location3", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 78, "text": "O que é isso?"}
{"category": "LocationDialogue Location3", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 80, "text": "É só um remedinho."}
{"category": "LocationDialogue Location3", "line_index": 81, "text": "Vai ajudar você a ficar melhor"}
{"category": "LocationDialogue Location3", "line_index": 82, "text": "Vai até o espelho."}
{"category": "LocationDialogue Location3", "line_index": 83, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 84, "text": "Vai em frente, toma!"}
{"category": "LocationDialogue Location3", "line_index": 85, "text": "E agora?"}
{"category": "LocationDialogue Location3", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 89, "text": "Como tá se sentindo?"}
{"category": "LocationDialogue Location3", "line_index": 90, "text": "Tá um pouquinho melhor?"}
{"category": "LocationDialogue Location3", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 92, "text": "Sim."}
{"category": "LocationDialogue Location3", "line_index": 93, "text": "Isso funcionou rápido..."}
{"category": "LocationDialogue Location3", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 95, "text": "[player], é porque a gente tá num jogo."}
{"category": "LocationDialogue Location3", "line_index": 96, "text": "As coisas são muito mais simples assim."}
{"category": "LocationDialogue Location3", "line_index": 97, "text": "Até mesmo o mais pequeno esforço"}
{"category": "LocationDialogue Location3", "line_index": 98, "text": "dá bons resultados."}
{"category": "LocationDialogue Location3", "line_index": 99, "text": "É tudo parte do conceito de um jogo:"}
{"category": "LocationDialogue Location3", "line_index": 100, "text": "Simplificação."}
{"category": "LocationDialogue Location3", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 102, "text": "Um exemplo, por favor?"}
{"category": "LocationDialogue Location3", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 104, "text": "Pega as cenouras."}
{"category": "LocationDialogue Location3", "line_index": 105, "text": "Você corta uma,"}
{"category": "LocationDialogue Location3", "line_index": 106, "text": "Mas é como se tivesse cortado três."}
{"category": "LocationDialogue Location3", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 108, "text": "Olha, isso é tudo muito repentino."}
{"category": "LocationDialogue Location3", "line_index": 109, "text": "Estou assustado, mais do que um pouco."}
{"category": "LocationDialogue Location3", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 112, "text": "Qual o problema?"}
{"category": "LocationDialogue Location3", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 114, "text": "Encontrei cartuchos na saída de ar."}
{"category": "LocationDialogue Location3", "line_index": 115, "text": "Eles tinham nomes."}
{"category": "LocationDialogue Location3", "line_index": 116, "text": "O que isso significa?"}
{"category": "LocationDialogue Location3", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 118, "text": "Cartuchos?"}
{"category": "LocationDialogue Location3", "line_index": 119, "text": "Que cartuchos?"}
{"category": "LocationDialogue Location3", "line_index": 120, "text": "Vamos descobrir juntos."}
{"category": "LocationDialogue Location3", "line_index": 121, "text": "Mas depois."}
{"category": "LocationDialogue Location3", "line_index": 122, "text": "Agora é hora de comer."}
{"category": "LocationDialogue Location3", "line_index": 123, "text": "Me passa a tesoura, por favor?"}
{"category": "LocationDialogue Location3", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 125, "text": "// Anel"}
{"category": "LocationDialogue Location3", "line_index": 126, "text": "Um Anel?"}
{"category": "LocationDialogue Location3", "line_index": 127, "text": "// Espelho"}
{"category": "LocationDialogue Location3", "line_index": 128, "text": "Por que não tem reflexo?"}
{"category": "LocationDialogue Location3", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 130, "text": "Nossa, verdade!"}
{"category": "LocationDialogue Location3", "line_index": 131, "text": "Eu esqueci de ativar os reflexos."}
{"category": "LocationDialogue Location3", "line_index": 132, "text": "Prontinho."}
{"category": "LocationDialogue Location3", "line_index": 133, "text": "Tudo de volta ao normal!"}
{"category": "LocationDialogue Location3", "line_index": 134, "text": "Ah, aliais"}
{"category": "LocationDialogue Location3", "line_index": 135, "text": "Eu não entendia nada sobre esse tipo de coisa antes."}
{"category": "LocationDialogue Location3", "line_index": 136, "text": "Não é coisa do meu mundo, sabe—"}
{"category": "LocationDialogue Location3", "line_index": 137, "text": "quer dizer, não era, até a ultima atualização. :)"}
{"category": "LocationDialogue Location3", "line_index": 138, "text": "Tem muita função...Digo, reflexo"}
{"category": "LocationDialogue Location3", "line_index": 139, "text": "No seu mundo?"}
{"category": "LocationDialogue Location3", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 141, "text": "Bem, sim."}
{"category": "LocationDialogue Location3", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 144, "text": "Você lembra"}
{"category": "LocationDialogue Location3", "line_index": 145, "text": "dos três objetos que encontrou?"}
{"category": "LocationDialogue Location3", "line_index": 146, "text": "Aqueles que você colocou no scanner?"}
{"category": "LocationDialogue Location3", "line_index": 147, "text": "Bom, eles...."}
{"category": "LocationDialogue Location3", "line_index": 148, "text": "Eles são.."}
{"category": "LocationDialogue Location3", "line_index": 149, "text": "meio que laçados a esse mundo."}
{"category": "LocationDialogue Location3", "line_index": 150, "text": "é por isso que você tá aqui agora."}
{"category": "LocationDialogue Location3", "line_index": 151, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 152, "text": "// TV Móvel"}
{"category": "LocationDialogue Location3", "line_index": 153, "text": "Essa é a TV portátil"}
{"category": "LocationDialogue Location3", "line_index": 154, "text": "que comprei para você."}
{"category": "LocationDialogue Location3", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 156, "text": "Aham!"}
{"category": "LocationDialogue Location3", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 158, "text": "Você tinha me dito"}
{"category": "LocationDialogue Location3", "line_index": 159, "text": "que estava quebrada."}
{"category": "LocationDialogue Location3", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 161, "text": "Bem, é que eu queria"}
{"category": "LocationDialogue Location3", "line_index": 162, "text": "te fazer uma surpresa!"}
{"category": "LocationDialogue Location3", "line_index": 163, "text": "Eu te contei uma mentirinha"}
{"category": "LocationDialogue Location3", "line_index": 164, "text": "para te trazer para o meu mundo."}
{"category": "LocationDialogue Location3", "line_index": 165, "text": "Mas agora ela funciona e mostra informações!"}
{"category": "LocationDialogue Location3", "line_index": 166, "text": "Tudo isso graças a mim"}
{"category": "LocationDialogue Location3", "line_index": 167, "text": "Que sou uma ótima engenheira!"}
{"category": "LocationDialogue Location3", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 169, "text": "// Roupa Escolar"}
{"category": "LocationDialogue Location3", "line_index": 170, "text": "O que é isso?"}
{"category": "LocationDialogue Location3", "line_index": 171, "text": "Um uniforme escolar?"}
{"category": "LocationDialogue Location3", "line_index": 172, "text": "Por que você precisaria disso?"}
{"category": "LocationDialogue Location3", "line_index": 173, "text": "Você realmente vai à escola?"}
{"category": "LocationDialogue Location3", "line_index": 174, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 175, "text": "Escola?"}
{"category": "LocationDialogue Location3", "line_index": 176, "text": "Não, não."}
{"category": "LocationDialogue Location3", "line_index": 177, "text": "Mas eu amo o uniforme"}
{"category": "LocationDialogue Location3", "line_index": 178, "text": "você não acha que eu fico "}
{"category": "LocationDialogue Location3", "line_index": 179, "text": "bonita nele?"}
{"category": "LocationDialogue Location3", "line_index": 180, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 181, "text": "// PC"}
{"category": "LocationDialogue Location3", "line_index": 182, "text": "Esse computador funciona?"}
{"category": "LocationDialogue Location3", "line_index": 183, "text": "Ou é só uma decoração de mesa?"}
{"category": "LocationDialogue Location3", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 185, "text": "É claro que funciona."}
{"category": "LocationDialogue Location3", "line_index": 186, "text": "Tudo aqui funciona"}
{"category": "LocationDialogue Location3", "line_index": 187, "text": "Exatamente como no seu mundo."}
{"category": "LocationDialogue Location3", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 189, "text": "Voltando ao meu mundo,"}
{"category": "LocationDialogue Location3", "line_index": 190, "text": "Eu ficava bastante tempo no computador..."}
{"category": "LocationDialogue Location3", "line_index": 191, "text": "E trabalho bastante."}
{"category": "LocationDialogue Location3", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 193, "text": "Eu sei.."}
{"category": "LocationDialogue Location3", "line_index": 194, "text": "E é por causa do seu trabalho"}
{"category": "LocationDialogue Location3", "line_index": 195, "text": "que você me deu"}
{"category": "LocationDialogue Location3", "line_index": 196, "text": "tão pouca atenção."}
{"category": "LocationDialogue Location3", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 198, "text": "Tenho que ganhar a vida, sabia?"}
{"category": "LocationDialogue Location3", "line_index": 199, "text": "Mas... como você sabe que eu fico muito tempo sentado no computador?"}
{"category": "LocationDialogue Location3", "line_index": 200, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 201, "text": "A câmera do seu celular... Fica ligada as vezes."}
{"category": "LocationDialogue Location3", "line_index": 202, "text": "Me desculpa."}
{"category": "LocationDialogue Location3", "line_index": 203, "text": "Eu venho te assistindo em segredo >A<"}
{"category": "LocationDialogue Location3", "line_index": 204, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 205, "text": "Uhm… isso não é totalmente apropriado."}
{"category": "LocationDialogue Location3", "line_index": 206, "text": "Mas tanto faz."}
{"category": "LocationDialogue Location3", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 208, "text": "// Guarda-chuva"}
{"category": "LocationDialogue Location3", "line_index": 209, "text": "Eu já joguei muito"}
{"category": "LocationDialogue Location3", "line_index": 210, "text": "mas nunca vi chover aqui."}
{"category": "LocationDialogue Location3", "line_index": 211, "text": "Por que ter um guarda-chuva?"}
{"category": "LocationDialogue Location3", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 213, "text": "Chove, só é meio raro."}
{"category": "LocationDialogue Location3", "line_index": 214, "text": "Você só não viu ainda."}
{"category": "LocationDialogue Location3", "line_index": 215, "text": "Talvez algum dia você veja."}
{"category": "LocationDialogue Location3", "line_index": 216, "text": "E ai você vai precisar de um guarda-chuva."}
{"category": "LocationDialogue Location3", "line_index": 217, "text": "Não acha?"}
{"category": "LocationDialogue Location3", "line_index": 218, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 219, "text": "// Painel Eletrônico"}
{"category": "LocationDialogue Location3", "line_index": 220, "text": "Por que tem um painel eletrônico aqui?"}
{"category": "LocationDialogue Location3", "line_index": 221, "text": "E se estamos em um jogo,"}
{"category": "LocationDialogue Location3", "line_index": 222, "text": "para que isso serve?"}
{"category": "LocationDialogue Location3", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 224, "text": "Primeiro de tudo,"}
{"category": "LocationDialogue Location3", "line_index": 225, "text": "a gente tá num jogo."}
{"category": "LocationDialogue Location3", "line_index": 226, "text": "Então perguntar \"por que\"..."}
{"category": "LocationDialogue Location3", "line_index": 227, "text": "não faz sentido."}
{"category": "LocationDialogue Location3", "line_index": 228, "text": "Mas enfim, isso"}
{"category": "LocationDialogue Location3", "line_index": 229, "text": "reinicia a energia."}
{"category": "LocationDialogue Location3", "line_index": 230, "text": "Tudo aqui é feito baseado"}
{"category": "LocationDialogue Location3", "line_index": 231, "text": "no seu mundo."}
{"category": "LocationDialogue Location3", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 233, "text": "// Porta de saída"}
{"category": "LocationDialogue Location3", "line_index": 234, "text": "Podemos ir lá para fora?"}
{"category": "LocationDialogue Location3", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 236, "text": "Ahm..."}
{"category": "LocationDialogue Location3", "line_index": 237, "text": "Não ainda."}
{"category": "LocationDialogue Location3", "line_index": 238, "text": "Talvez depois."}
{"category": "LocationDialogue Location3", "line_index": 239, "text": "Vamos ficar aqui por enquanto."}
{"category": "LocationDialogue Location3", "line_index": 240, "text": "Aqui em casa."}
{"category": "LocationDialogue Location3", "line_index": 241, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 242, "text": "// Livros"}
{"category": "LocationDialogue Location3", "line_index": 243, "text": "Você tem um monte de livros aqui."}
{"category": "LocationDialogue Location3", "line_index": 244, "text": "Você já leu todos eles?"}
{"category": "LocationDialogue Location3", "line_index": 245, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 246, "text": "Eu li cada um deles."}
{"category": "LocationDialogue Location3", "line_index": 247, "text": "Ficar aqui sozinha"}
{"category": "LocationDialogue Location3", "line_index": 248, "text": "É muito, muito ruim."}
{"category": "LocationDialogue Location3", "line_index": 249, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 250, "text": "// TV na cozinha"}
{"category": "LocationDialogue Location3", "line_index": 251, "text": "Por que pegar uma segunda TV?"}
{"category": "LocationDialogue Location3", "line_index": 252, "text": "Uma velha, ainda por cima"}
{"category": "LocationDialogue Location3", "line_index": 253, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 254, "text": "Você não gosta?"}
{"category": "LocationDialogue Location3", "line_index": 255, "text": "Eu posso tirar se quiser..."}
{"category": "LocationDialogue Location3", "line_index": 256, "text": "Mas respondendo..."}
{"category": "LocationDialogue Location3", "line_index": 257, "text": "É só decoração,"}
{"category": "LocationDialogue Location3", "line_index": 258, "text": "para iluminar a cozinha."}
{"category": "LocationDialogue Location3", "line_index": 259, "text": "Mas funciona também!"}
{"category": "LocationDialogue Location3", "line_index": 260, "text": "Eu posso assistir"}
{"category": "LocationDialogue Location3", "line_index": 261, "text": "até novela!"}
{"category": "LocationDialogue Location3", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 263, "text": "// Celular"}
{"category": "LocationDialogue Location3", "line_index": 264, "text": "Esse é meu telefone."}
{"category": "LocationDialogue Location3", "line_index": 265, "text": "E não está mais no meu bolso."}
{"category": "LocationDialogue Location3", "line_index": 266, "text": "Como diabos ele foi parar aqui?"}
{"category": "LocationDialogue Location3", "line_index": 267, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 268, "text": "Ahm, isso não é importante."}
{"category": "LocationDialogue Location3", "line_index": 269, "text": "Ai, eu tive uma ideia!"}
{"category": "LocationDialogue Location3", "line_index": 270, "text": "Vamos tirar uma foto?"}
{"category": "LocationDialogue Location3", "line_index": 271, "text": "Xis!"}
{"category": "LocationDialogue Location3", "line_index": 272, "text": "Essa foto ficou incrível!"}
{"category": "LocationDialogue Location3", "line_index": 273, "text": "Guarda de recordação."}
{"category": "LocationDialogue Location3", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 275, "text": "Tenho uma pergunta."}
{"category": "LocationDialogue Location3", "line_index": 276, "text": "Se eu"}
{"category": "LocationDialogue Location3", "line_index": 277, "text": "rodar um jogo nele,"}
{"category": "LocationDialogue Location3", "line_index": 278, "text": "te vejo lá?"}
{"category": "LocationDialogue Location3", "line_index": 279, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 280, "text": "Não é assim que funciona."}
{"category": "LocationDialogue Location3", "line_index": 281, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 282, "text": "Suco Fresco"}
{"category": "LocationDialogue Location3", "line_index": 283, "text": "SUCO Forte!!!"}
{"category": "LocationDialogue Location3", "line_index": 284, "text": "// TV"}
{"category": "LocationDialogue Location3", "line_index": 285, "text": "Quantos canais"}
{"category": "LocationDialogue Location3", "line_index": 286, "text": "Você tem?"}
{"category": "LocationDialogue Location3", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 288, "text": "É que não funciona desse jeito."}
{"category": "LocationDialogue Location3", "line_index": 289, "text": "Tá conectado a internet."}
{"category": "LocationDialogue Location3", "line_index": 290, "text": "Então você pode assistir qualquer coisa,"}
{"category": "LocationDialogue Location3", "line_index": 291, "text": "pelo menos, qualquer coisa disponível na internet."}
{"category": "LocationDialogue Location3", "line_index": 292, "text": "Perai."}
{"category": "LocationDialogue Location3", "line_index": 293, "text": "Err, opa.."}
{"category": "LocationDialogue Location3", "line_index": 294, "text": "O que é isso?"}
{"category": "LocationDialogue Location3", "line_index": 295, "text": "Um circulo de gatos?"}
{"category": "LocationDialogue Location3", "line_index": 296, "text": "Oh, Olha."}
{"category": "LocationDialogue Location3", "line_index": 297, "text": "Quer saber?"}
{"category": "LocationDialogue Location3", "line_index": 298, "text": "Pausa!"}
{"category": "LocationDialogue Location3", "line_index": 299, "text": "Quer um pouco de suco?"}
{"category": "LocationDialogue Location3", "line_index": 300, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 301, "text": "Anúncios tão peculiares..."}
{"category": "LocationDialogue Location3", "line_index": 302, "text": "Isso é suco mesmo?"}
{"category": "LocationDialogue Location3", "line_index": 303, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 304, "text": "É claro que é suco"}
{"category": "LocationDialogue Location3", "line_index": 305, "text": "e diretamente do anuncio."}
{"category": "LocationDialogue Location3", "line_index": 306, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 308, "text": "Ah, o gosto..."}
{"category": "LocationDialogue Location3", "line_index": 309, "text": "Eu gostei,"}
{"category": "LocationDialogue Location3", "line_index": 310, "text": "e ainda assim, não consigo dizer qual é o gosto."}
{"category": "LocationDialogue Location3", "line_index": 311, "text": "É tudo muito confuso."}
{"category": "LocationDialogue Location3", "line_index": 312, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 313, "text": "Entendi."}
{"category": "LocationDialogue Location3", "line_index": 314, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 315, "text": "// Mita tímida"}
{"category": "LocationDialogue Location3", "line_index": 316, "text": "Ahm..O que tá fazendo?"}
{"category": "LocationDialogue Location3", "line_index": 317, "text": "N-Não encara, por favor..."}
{"category": "LocationDialogue Location3", "line_index": 318, "text": "Eu tô ficando com vergonha."}
{"category": "LocationDialogue Location3", "line_index": 319, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 320, "text": "// A Estatua"}
{"category": "LocationDialogue Location3", "line_index": 321, "text": "Essa é uma estatueta assustadora."}
{"category": "LocationDialogue Location3", "line_index": 322, "text": "Você"}
{"category": "LocationDialogue Location3", "line_index": 323, "text": "gosta dessas coisas?"}
{"category": "LocationDialogue Location3", "line_index": 324, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 325, "text": "Você acha bizarro?"}
{"category": "LocationDialogue Location3", "line_index": 326, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 327, "text": "Sim."}
{"category": "LocationDialogue Location3", "line_index": 328, "text": "Quase parece que está amaldiçoado..."}
{"category": "LocationDialogue Location3", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 330, "text": "Não, definitivamente não é amaldiçoado."}
{"category": "LocationDialogue Location3", "line_index": 331, "text": "E não é bizarro também."}
{"category": "LocationDialogue Location3", "line_index": 332, "text": "Eu acho é fofo!"}
{"category": "LocationDialogue Location3", "line_index": 333, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 334, "text": "Talvez você esteja certa..."}
{"category": "LocationDialogue Location3", "line_index": 335, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 336, "text": "Mita?"}
{"category": "LocationDialogue Location3", "line_index": 337, "text": "O que aconteceu?"}
{"category": "LocationDialogue Location3", "line_index": 338, "text": "// Mita na Cozinha"}
{"category": "LocationDialogue Location3", "line_index": 339, "text": "Que tal conversar um pouco"}
{"category": "LocationDialogue Location3", "line_index": 340, "text": "antes de comer?"}
{"category": "LocationDialogue Location3", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 342, "text": "// Começar a comer"}
{"category": "LocationDialogue Location3", "line_index": 343, "text": "Bom apetite."}
{"category": "LocationDialogue Location3", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 345, "text": "// Missão 1"}
{"category": "LocationDialogue Location3", "line_index": 346, "text": "É não é?"}
{"category": "LocationDialogue Location3", "line_index": 347, "text": "Você pode ficar."}
{"category": "LocationDialogue Location3", "line_index": 348, "text": "Eu não me importo é serio."}
{"category": "LocationDialogue Location3", "line_index": 349, "text": "Na verdade, eu"}
{"category": "LocationDialogue Location3", "line_index": 350, "text": "super apoio!"}
{"category": "LocationDialogue Location3", "line_index": 351, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 352, "text": "// Missão 2"}
{"category": "LocationDialogue Location3", "line_index": 353, "text": "Você quer mesmo voltar?"}
{"category": "LocationDialogue Location3", "line_index": 354, "text": "Mas por que?"}
{"category": "LocationDialogue Location3", "line_index": 355, "text": "Aqui é tão quente..."}
{"category": "LocationDialogue Location3", "line_index": 356, "text": "E confortável, também."}
{"category": "LocationDialogue Location3", "line_index": 357, "text": "E além de tudo, eu estou aqui."}
{"category": "LocationDialogue Location3", "line_index": 358, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 359, "text": "Não, você entendeu errado."}
{"category": "LocationDialogue Location3", "line_index": 360, "text": "Eu adoraria ficar."}
{"category": "LocationDialogue Location3", "line_index": 361, "text": "Estou apenas... preocupado."}
{"category": "LocationDialogue Location3", "line_index": 362, "text": "Preocupado por ter esquecido algo em casa..."}
{"category": "LocationDialogue Location3", "line_index": 363, "text": "Cheguei aqui do nada"}
{"category": "LocationDialogue Location3", "line_index": 364, "text": "e não tive tempo"}
{"category": "LocationDialogue Location3", "line_index": 365, "text": "para me preparar."}
{"category": "LocationDialogue Location3", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 367, "text": "Ah... Desculpa, eu não pensei nessa parte"}
{"category": "LocationDialogue Location3", "line_index": 368, "text": "// Missão 3"}
{"category": "LocationDialogue Location3", "line_index": 369, "text": "Um sonho? Então você quer escapar?"}
{"category": "LocationDialogue Location3", "line_index": 370, "text": "E esquecer que nunca aconteceu?"}
{"category": "LocationDialogue Location3", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 372, "text": "Não, não é isso."}
{"category": "LocationDialogue Location3", "line_index": 373, "text": "Este lugar parece..."}
{"category": "LocationDialogue Location3", "line_index": 374, "text": "Estranho. Não natural."}
{"category": "LocationDialogue Location3", "line_index": 375, "text": "Mas você..."}
{"category": "LocationDialogue Location3", "line_index": 376, "text": "Você parece tão real."}
{"category": "LocationDialogue Location3", "line_index": 377, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 378, "text": "Eu pareço real?"}
{"category": "LocationDialogue Location3", "line_index": 379, "text": "Eu sou MUITO real,"}
{"category": "LocationDialogue Location3", "line_index": 380, "text": "Cabeção!"}
{"category": "LocationDialogue Location3", "line_index": 381, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 382, "text": "// Missão 4"}
{"category": "LocationDialogue Location3", "line_index": 383, "text": "É assim que as coisas são"}
{"category": "LocationDialogue Location3", "line_index": 384, "text": "nesse mundo."}
{"category": "LocationDialogue Location3", "line_index": 385, "text": "Talvez você ache estranho"}
{"category": "LocationDialogue Location3", "line_index": 386, "text": "não conseguir ver"}
{"category": "LocationDialogue Location3", "line_index": 387, "text": "as coisas lá na frente."}
{"category": "LocationDialogue Location3", "line_index": 388, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 389, "text": "Não me parece tão estranho."}
{"category": "LocationDialogue Location3", "line_index": 390, "text": "Sinceramente, parece interessante."}
{"category": "LocationDialogue Location3", "line_index": 391, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 392, "text": "É, eu também acho."}
{"category": "LocationDialogue Location3", "line_index": 393, "text": "Ajuda a evitar o lag, sabe?."}
{"category": "LocationDialogue Location3", "line_index": 394, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 395, "text": "Evitar o lag?"}
{"category": "LocationDialogue Location3", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 397, "text": "Uhum! Ainda tem alguns bugs."}
{"category": "LocationDialogue Location3", "line_index": 398, "text": "Espero que a gente não esbarre em nenhum."}
{"category": "LocationDialogue Location3", "line_index": 399, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 400, "text": "// Missão 5"}
{"category": "LocationDialogue Location3", "line_index": 401, "text": "Tesoura ou a faca, né?"}
{"category": "LocationDialogue Location3", "line_index": 402, "text": "Eu podia sim ter usado uma faca para abrir..o pacote."}
{"category": "LocationDialogue Location3", "line_index": 403, "text": "Mas eu queria que tudo"}
{"category": "LocationDialogue Location3", "line_index": 404, "text": "tivesse perfeito"}
{"category": "LocationDialogue Location3", "line_index": 405, "text": "para quando você voltasse."}
{"category": "LocationDialogue Location3", "line_index": 406, "text": "Eu amo te surpreender."}
{"category": "LocationDialogue Location3", "line_index": 407, "text": "E nem demorou tanto assim!"}
{"category": "LocationDialogue Location3", "line_index": 408, "text": "Tee-hee."}
{"category": "LocationDialogue Location3", "line_index": 409, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 410, "text": "// Óculos"}
{"category": "LocationDialogue Location3", "line_index": 411, "text": "Você usa óculos?"}
{"category": "LocationDialogue Location3", "line_index": 412, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 413, "text": "Na verdade, não."}
{"category": "LocationDialogue Location3", "line_index": 414, "text": "Mas eu posso se quiser."}
{"category": "LocationDialogue Location3", "line_index": 415, "text": "Eu fiquei bonita?"}
{"category": "LocationDialogue Location3", "line_index": 416, "text": "// Sim"}
{"category": "LocationDialogue Location3", "line_index": 417, "text": "Então tá bom"}
{"category": "LocationDialogue Location3", "line_index": 418, "text": "Vou ficar usando eles."}
{"category": "LocationDialogue Location3", "line_index": 419, "text": "// Não"}
{"category": "LocationDialogue Location3", "line_index": 420, "text": "É...."}
{"category": "LocationDialogue Location3", "line_index": 421, "text": "Então deixa para lá..."}
{"category": "LocationDialogue Location3", "line_index": 422, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 423, "text": "// Usar o molho"}
{"category": "LocationDialogue Location3", "line_index": 424, "text": "Certo,"}
{"category": "LocationDialogue Location3", "line_index": 425, "text": "Que tipo de molho é esse?"}
{"category": "LocationDialogue Location3", "line_index": 426, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 427, "text": "Eu amo esse molho!"}
{"category": "LocationDialogue Location3", "line_index": 428, "text": "Um choque de amor puro!"}
{"category": "LocationDialogue Location3", "line_index": 429, "text": "E… Uma vista inusitada do mundo."}
{"category": "LocationDialogue Location3", "line_index": 430, "text": "É bem diferente, não é?"}
{"category": "LocationDialogue Location3", "line_index": 431, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 432, "text": "Realmente..."}
{"category": "LocationDialogue Location3", "line_index": 433, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 434, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location3", "line_index": 435, "text": "Esse é o seu console?"}
{"category": "LocationDialogue Location3", "line_index": 436, "text": "Que legal!"}
