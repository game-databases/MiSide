{"category": "LocationDialogue Location6", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "Mita?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "Como você chegou aqui?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Você é a Mita, não é?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Mas tem alguma coisa diferente em você..."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "Observador."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "E está certo."}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "Eu não sou a Mita que conheceu antes."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Toma cuidado, ela tá preparando algo"}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "sinistro."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "Huh, algo sinistro?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "Não tenho tempo para explicar:"}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "Se funcionar eu te conto tudo."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Pega a chave, tá perto do sofá."}
{"category": "LocationDialogue Location6", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Mas...."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "Faça perguntas depois!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Me dá a chave."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Pega o anel."}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "Huh?"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Você quer sair daqui, não quer?"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "Uhm, sim..."}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Então coloca ele."}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "É um artefato útil,"}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "Talvez precise dele logo."}
{"category": "LocationDialogue Location6", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Okay..."}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "A propósito, eu estou"}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Mmm,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "Eu sou...A Mita."}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// Mita Gentil missão 1"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "Tá vendo aquele console?"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "Pega ele."}
{"category": "LocationDialogue Location6", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "Estamos assistindo uma gravação?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "Quem é esse com ela?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "Tá acontecendo nesse exato momento."}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "É outro jogador."}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Ela tá usando ele."}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Talvez ela tente"}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "Te transformar num cartucho também."}
{"category": "LocationDialogue Location6", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "Preciso sair daqui o mais rápido possível."}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "E você também."}
{"category": "LocationDialogue Location6", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "Sim, nós precisamos."}
{"category": "LocationDialogue Location6", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "Então, você tá dizendo"}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "que ela está usando ele."}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "Se eu puxar o cartucho fora, o que acontece?"}
{"category": "LocationDialogue Location6", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "Talvez isso"}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "cause dano irreversível ao cartucho."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "Isso significa que...?"}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "A pessoa dentro morre."}
{"category": "LocationDialogue Location6", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "..."}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "E se eu só desligar?"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "É.. Talvez funcione..."}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Vale a pena tentar. Tem um botão vermelho ai!"}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Consegue ver?"}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "Encontrei."}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "Aperta ele."}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// Mita Gentil missão 2"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Eu preciso ficar."}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "Tem perguntas que eu preciso fazer"}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "para descobrir mais sobre ela."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "Por mais que ela não leve a sério..."}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// Mita Gentil missão 3"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "Para te falar a verdade, essa é minha versão."}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "Eu estava fazendo companhia para o jogador,"}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "Quando algo mudou de repente."}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "E ela apareceu..."}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "Transformou ele em um cartucho"}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "E então me trancou."}
{"category": "LocationDialogue Location6", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Espera, ela transformou ele num cartucho?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "Ela consegue fazer isso?"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "Mas por quê?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "Para que ela precisa dos jogadores?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "Ela é claramente maluca..."}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Ela tá só brincando com a gente, usando de marionete!"}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "Transformando pessoas em cartuchos..."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Alguns sequer perceberam o que estava acontecendo com eles..."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "E outros... Sequer tentaram lutar contra isso!"}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "Isso é uma reviravolta terrível..."}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "Você tem que ajudar a gente!"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "Eu? Mas como?"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "Eu preciso de você!"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "E se você nós ajudar, eu te ajudo!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Talvez seja nossa última chance."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "O Anel vai te levar para a versão certa."}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "Eu te encontro lá."}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// Mita Gentil missão 4"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "Eu ainda não entendi direito"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "o que eu vi lá em cima..."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Aquela Mita..."}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "Ela estava tentando me matar?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "Matar?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Ela tá com algo muito pior em mente para você..."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "Você tem que se apressar."}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Esconda-se!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "Oh, merda! se esconde!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Espera, o que...?"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Rápido, ela tá vindo!"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "Segue o anel, ele vai te levar para um lugar seguro!"}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "Então...Não vai falar onde ele tá?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "Por que eu diria?"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "Você não vai matar ele, vai?"}
{"category": "LocationDialogue Location6", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Own...Decidiu não abrir o bico?"}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Thihi, eu gosto de um desafio."}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "E eu sei que ele está por aqui~"}
{"category": "LocationDialogue Location6", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "Por que você é assim?"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "Você nunca me fala o que tá acontecendo!"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "E outra..."}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "Para que você precisa deles?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "Eles não são brinquedo!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "O que foi que aconteceu com você?!"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "Já chega! Cala sua boca, garota!!"}
