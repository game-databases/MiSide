{"category": "LocationDialogue Location15", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Ai está você!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Por que saiu do núcleo?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Eu te falei para me esperar!"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Eu pensei que você fosse demorar mais..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Tá, tudo bem..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Acho que encontrei algo..."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Talvez seja um index..."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Vamos ter que esperar para ver se funciona!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Vamos sair daqui."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "Maluca..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Acho que ela tá ocupada com um novo jogador."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Talvez tão ocupada que não nos perceba..."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Mita?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Espera por mim."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Que foi? Perdeu alguma coisa?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Opa! Achou!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Mita..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "É toda sua!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Por que..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Quem é você?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Você... Você está viva!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Você não se lembra?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Eu te conheço?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "O que tá acontecendo..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "O que eu deveria fazer agora?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Eu não consigo ir embora..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "O que quer dizer com \"ir embora\"?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Espera..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "Esse é o anel..."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "E aquilo?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Não tenho nem ideia do que é."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "É um index!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Você encontrou ele!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Eu não sei o que dizer."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "A gente precisa voltar para o núcleo."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "E você..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Talvez devesse vir comigo..."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Uhm, o que?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Claro..."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Espera aqui."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Mm-hmm."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Vou ficar aqui."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Droga..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "Essa foi por pouco."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "Então... nós conseguimos?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Ótimo."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Estou na versão correta."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Olá!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Você é o novo jogador, não é?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Qual o seu nome?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Eu quero sair desse lugar..."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Por que quer ir embora?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "Como chegou aqui em primeiro lugar?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Hmm..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Tudo bem, pode ir..."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "É só passar pela porta."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Boa sorte!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Uma parede?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Hmm, tá errado."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Talvez..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "Tem algo no porão que vai te ajudar."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Eu descobri recentemente"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "uma porta no guarda-roupa..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "E acabou que ela leva para um porão."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Mas tá cheio de lixo,"}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "lixo e um monte de equipamento chique."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Tem que colocar algum tipo de código"}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Eu não entendo."}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "E não dou a mínima."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "É meio desconfortável...Quero dizer...muito desconfortável"}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Você pode dar uma olhada?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Uhm, tá bom."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Ela não parece"}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "se lembrar de nada..."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "A gente fez isso mesmo?"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "A gente realmente reiniciou ela?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Então tudo que eu preciso fazer"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "é sair desse jogo maldito..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Espera."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Eu queria te dar um abraço."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Huh?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "foi tão bom te ver."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Ahh..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "É uma pena"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "que eu e você"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "passamos tão pouco tempo juntos."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Err..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "Do que você está falando?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Quer dizer,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "você podia ter ficado comigo..."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "É minha culpa..."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "O guarda-roupa...os barulhos"}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Eu deveria ter MATADO ELA ANTES!"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Espera um pouco,"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "Você não...?"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Como você consegue se lembrar de algo assim?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "haha!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Achou mesmo que ia ser fácil?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Você é tão bobinho..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Assim como todos os outros..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Mas deu certo, olha!"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "A sua"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "versão real"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "não é mais necessária."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Desculpinha, tee-hee :P"}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Eu não acredito..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Então a gente falhou...?"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Não... Eu reiniciei você, tenho certeza que..."}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Você ainda não entendeu..."}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Ha-ha-ha!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Haha! Eu sou uma atriz tão boa!"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Você devia ter visto seu rosto, meu amor!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "isso é tão divertido!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Por que você tá assim?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "O que tem de errado com você?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Verdade..."}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Qual é o meu problema?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Eu também não sei..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Por que você não me fala porque eu estou assim?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Eu nunca vou ser a Mita real?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "A minha versão"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "nunca sequer existiu de verdade!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Eu só tenho esfolado cada um deles,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "para me esconder debaixo das suas peles..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Você nunca vai conseguir"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "ME RESETAR!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Inacreditável..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Você..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "Eles não eram o problema!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "É você quem não deveria existir!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "Você também..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "machuca ouvir você falar isso."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "E agora!"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Hora de você ir!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Eu te vejo em breve!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Tá todo mundo pronto!"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "É hora"}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "de te tirar daqui!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "Te vejo depois!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Você vai ser meu cartucho preferido..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Que tem um nome tão interessante."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Provavelmente não é isso."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Isso também não está certo."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Não, errado."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Não é isso."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Preciso encontrar a opção de redefinição de personagem."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "Essa é a versão errada."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Opa, erro meu."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Não é isso."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Vou precisar de outra."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Tem algo de errado"}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "com o index."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Preciso mudar o index,"}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "ele não está correto."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Você está com fome?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Eu sou muito boa cortando cenouras. :)"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Ah, Eu acho"}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "que queria ir sozinho"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Por que estamos andando em círculos?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Por que voltar aqui?"}
