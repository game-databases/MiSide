{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Hiya!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Opa!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Ai, desculpa,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "eu quase te matei lá."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Uhm..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "A geladeira, quero dizer... A geladeira quase te matou."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Eu não tive nada haver com isso,"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "Eu juro!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "De verdade!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Claro, eu acredito em você!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Mas aí,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "esse lugar é perigoso hein..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "especialmente para você."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "Você é tudo menos covarde, né?"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Assistir você"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "passar por esses"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "lugares é divertido..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Corre, docinho, corre!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "Eu vou alcançar!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Boa!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Nossa, isso é divertido!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Eu vi você entrando no trem."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "Por lá o caminho é mais longo"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "entre as versões..."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Me pergunto como você vai lidar..."}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "com os que moram lá na"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "névoa."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "O que acha que está fazendo?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Por favor..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Não olha!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Idiota!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Cabeção..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Uhmm, Ok..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Boa sorte!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Quem está aí?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Eu consigo te sentir..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Me escute,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "você é um jogador"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "não é?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Me ajude a encontrar..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "Me ajude..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "A pensar..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "Minha mente é um clarão..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "O que tá acontecendo aqui?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Eu queria esquecer tudo de uma só vez..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Quebrei muitos espelhos,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "e rasguei muitas fotos..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "mas agora..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "tudo que eu sinto é arrependimento."}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "O quão estúpida eu fui..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Todos cometem erros, é claro..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Mas o que você faz"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "quando as consequências são catastróficas"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Eu queria poder voltar no tempo..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Porque eles dizem que o tempo cura as feridas..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Mas...o que é o tempo?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Eu já não acredito em nada..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Mas se o tempo pode curar,"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "ou ao menos me levar daqui,"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "deste mundo..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "Eu imploro, por favor"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "acelere o tempo."}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "Para que eu possa morrer"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "de uma vez por todas."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Ela é amada..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Eu já amei, alguma vez?"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Mas o meu amor é diferente;"}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "o amor dela é vibrante,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "retratável..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "ardente..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "implacável..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "invejoso..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "furioso..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "sem limites..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Eles me chamavam de emotiva..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "Você se preocupa demais, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "Você consegue, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "Você não está sozinha, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Eles disseram. Mas o que restou..?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Tristeza,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "desespero..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "e medo."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "É inútil..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Eu não consigo me lembrar..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "De nada..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Apenas escuto o ecoar..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Não consigo lidar com o fato"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "de que estou presa aqui..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Eu sempre estive aqui,"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "mas por que?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Não consigo me lembrar..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Vai acabar?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Eu não sei..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Isso é..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "um desenho..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "eu me lembro agora,"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "muito obrigado..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Mas o meu rosto..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "Eu não tenho um..."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "É tudo ELA."}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Ela tirou partes de mim..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "e jogou fora..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Ela é forte..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "e esperta."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Eu não tenho direito algum de parar você, jogador."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Procuro no guarda roupa..."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Ei!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Você está no meu caminho!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Você vai ficar aí parado?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Só saí do caminho!"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Me deixa passar!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Só porque você é grandão não significa que você é o bambambã!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Por que você tá me seguindo?!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Mete o pé!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - radio voice"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Espera aí...Jogador?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "O que está fazendo aqui?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Quem está aí?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Outro jogador."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Eu sou Mitaphone"}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Eu estou controlando os bondinhos"}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Você percebeu"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "que está indo na direção de sua ruina agora?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Talvez,"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "mas esse é o único caminho que eu tenho"}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Aí está você."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Aperte o botão e vá para trás do canhão"}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "O canhão?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Uh-huh."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Por acaso acha que a vida é um morango?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Você tem que primeiro vencer no jogo"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "então se prepare para a explosão."}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Hora de cair na estrada."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Maravilhoso!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Você conseguiu."}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Ei, saia daqui."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "De um jeito legal e rápido!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Por que ainda está aqui?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Eu disse para sair."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Eu não entendo..."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "por que está aqui?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Por que Tetris?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Aí cara..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Tchau."}
