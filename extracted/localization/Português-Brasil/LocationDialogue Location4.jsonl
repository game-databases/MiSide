{"category": "LocationDialogue Location4", "line_index": 0, "text": "Mita?"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "Ah, você já acordou?"}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "Como você chegou aqui?"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": "Você estava bem do meu lado agora mesmo."}
{"category": "LocationDialogue Location4", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 5, "text": "hmhm..."}
{"category": "LocationDialogue Location4", "line_index": 6, "text": "Você congelou na frente do espelho."}
{"category": "LocationDialogue Location4", "line_index": 7, "text": "Então eu saí."}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "Por que os cômodos estão diferentes?"}
{"category": "LocationDialogue Location4", "line_index": 9, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "Eu só fiz umas mudanças"}
{"category": "LocationDialogue Location4", "line_index": 11, "text": "Para você se sentir mais em casa."}
{"category": "LocationDialogue Location4", "line_index": 12, "text": "Aqui,"}
{"category": "LocationDialogue Location4", "line_index": 13, "text": "A gente pode mudar os cômodos"}
{"category": "LocationDialogue Location4", "line_index": 14, "text": "o quanto a gente quiser."}
{"category": "LocationDialogue Location4", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 16, "text": "Não precisava."}
{"category": "LocationDialogue Location4", "line_index": 17, "text": "Eu estava me acostumando com o layout."}
{"category": "LocationDialogue Location4", "line_index": 18, "text": "De toda forma, eu acho que você vai ficar mais acostumado com esse layout."}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Mita Jogo de Carta"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "Okey,"}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "Vamos jogar?"}
{"category": "LocationDialogue Location4", "line_index": 22, "text": "Vou te explicar como o jogo funciona:"}
{"category": "LocationDialogue Location4", "line_index": 23, "text": "Essa parte aqui indica um tipo,"}
{"category": "LocationDialogue Location4", "line_index": 24, "text": "como a vida:"}
{"category": "LocationDialogue Location4", "line_index": 25, "text": "Cada um de nós joga uma carta,"}
{"category": "LocationDialogue Location4", "line_index": 26, "text": "E se sua carta for maior"}
{"category": "LocationDialogue Location4", "line_index": 27, "text": "com status de vida"}
{"category": "LocationDialogue Location4", "line_index": 28, "text": "do que a minha,"}
{"category": "LocationDialogue Location4", "line_index": 29, "text": "você ganha."}
{"category": "LocationDialogue Location4", "line_index": 30, "text": "Pega suas cartas."}
{"category": "LocationDialogue Location4", "line_index": 31, "text": "Minha vez!"}
{"category": "LocationDialogue Location4", "line_index": 32, "text": "Whoa!"}
{"category": "LocationDialogue Location4", "line_index": 33, "text": "Minha mão tá boa"}
{"category": "LocationDialogue Location4", "line_index": 34, "text": "Eu vou primeiro!"}
{"category": "LocationDialogue Location4", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 44, "text": "OK!"}
{"category": "LocationDialogue Location4", "line_index": 45, "text": "Sua vez!"}
{"category": "LocationDialogue Location4", "line_index": 46, "text": "Uh-huh."}
{"category": "LocationDialogue Location4", "line_index": 47, "text": "Sua vez!"}
{"category": "LocationDialogue Location4", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 49, "text": "A carta com status de vida maior ganha!"}
{"category": "LocationDialogue Location4", "line_index": 50, "text": "É tudo no ataque!"}
{"category": "LocationDialogue Location4", "line_index": 51, "text": "Foca na defesa!"}
{"category": "LocationDialogue Location4", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 54, "text": "Você ganhou!"}
{"category": "LocationDialogue Location4", "line_index": 55, "text": "Você ganhou!"}
{"category": "LocationDialogue Location4", "line_index": 56, "text": "Ah você me pegou."}
{"category": "LocationDialogue Location4", "line_index": 57, "text": "Oh, você..."}
{"category": "LocationDialogue Location4", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 59, "text": "Ganhei!"}
{"category": "LocationDialogue Location4", "line_index": 60, "text": "Eu venci!"}
{"category": "LocationDialogue Location4", "line_index": 61, "text": "Uhuul!"}
{"category": "LocationDialogue Location4", "line_index": 62, "text": "Hah, te peguei!"}
{"category": "LocationDialogue Location4", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 64, "text": "Empate."}
{"category": "LocationDialogue Location4", "line_index": 65, "text": "Empatou de novo!"}
{"category": "LocationDialogue Location4", "line_index": 66, "text": "Olha o empate!"}
{"category": "LocationDialogue Location4", "line_index": 67, "text": "É o mesmo valor..."}
{"category": "LocationDialogue Location4", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 79, "text": "// O jogo de cartas é interrompido"}
{"category": "LocationDialogue Location4", "line_index": 80, "text": "O que é esse barulho?"}
{"category": "LocationDialogue Location4", "line_index": 81, "text": "Está vindo do guarda-roupas."}
{"category": "LocationDialogue Location4", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 83, "text": "Barulho?"}
{"category": "LocationDialogue Location4", "line_index": 84, "text": "Que barulho?"}
{"category": "LocationDialogue Location4", "line_index": 85, "text": "Eu.. Não sei do que você tá falando, eu não ouvi nada."}
{"category": "LocationDialogue Location4", "line_index": 86, "text": "O que você acha que ouviu?"}
{"category": "LocationDialogue Location4", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 88, "text": "Batendo, como se tivesse alguém lá."}
{"category": "LocationDialogue Location4", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 90, "text": "Mas..."}
{"category": "LocationDialogue Location4", "line_index": 91, "text": "Não tem ninguém ali..."}
{"category": "LocationDialogue Location4", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 93, "text": "Eu queria abrir e dar uma olhada."}
{"category": "LocationDialogue Location4", "line_index": 94, "text": "Fiquei um pouco assustado."}
{"category": "LocationDialogue Location4", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 96, "text": "Por que...?"}
{"category": "LocationDialogue Location4", "line_index": 97, "text": "Isso de novo..."}
{"category": "LocationDialogue Location4", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 105, "text": "Qual que é o seu problema!?"}
{"category": "LocationDialogue Location4", "line_index": 106, "text": "É um guarda-roupa..."}
{"category": "LocationDialogue Location4", "line_index": 107, "text": "Eu tenho minhas roupas ali dentro...!"}
{"category": "LocationDialogue Location4", "line_index": 108, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 109, "text": "Você está escondendo algo de mim?"}
{"category": "LocationDialogue Location4", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 111, "text": "Por que você não acredita em mim?"}
{"category": "LocationDialogue Location4", "line_index": 112, "text": "O que eu tô fazendo errado?"}
{"category": "LocationDialogue Location4", "line_index": 113, "text": "Tudo que eu quero..."}
{"category": "LocationDialogue Location4", "line_index": 114, "text": "Tudo que eu quero é que você fique comigo."}
{"category": "LocationDialogue Location4", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 116, "text": "Eu gostaria, mas ainda assim..."}
{"category": "LocationDialogue Location4", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 118, "text": "Então...Por que você tá tão preso a isso?!"}
{"category": "LocationDialogue Location4", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 120, "text": "Eu quero saber o que diabos está batendo assim!"}
{"category": "LocationDialogue Location4", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 122, "text": "É porque"}
{"category": "LocationDialogue Location4", "line_index": 123, "text": "esse mundo"}
{"category": "LocationDialogue Location4", "line_index": 124, "text": "só tem quatro cômodos?"}
{"category": "LocationDialogue Location4", "line_index": 125, "text": "Isso não é suficiente para você?"}
{"category": "LocationDialogue Location4", "line_index": 126, "text": "Por que você não pode só ficar comigo?"}
{"category": "LocationDialogue Location4", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 129, "text": "// Não ficar com a Mita"}
{"category": "LocationDialogue Location4", "line_index": 130, "text": "Eu entendo."}
{"category": "LocationDialogue Location4", "line_index": 131, "text": "Isso de novo..."}
{"category": "LocationDialogue Location4", "line_index": 132, "text": "Se você quer ver o guarda-roupa,"}
{"category": "LocationDialogue Location4", "line_index": 133, "text": "então faça isso,"}
{"category": "LocationDialogue Location4", "line_index": 134, "text": "e descubra o que tem lá dentro!"}
{"category": "LocationDialogue Location4", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 139, "text": "Mas o que..."}
{"category": "LocationDialogue Location4", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 141, "text": "Ah é, isso acontece ás vezes."}
{"category": "LocationDialogue Location4", "line_index": 142, "text": "O cômodo tá carregando."}
{"category": "LocationDialogue Location4", "line_index": 143, "text": "É só esperar um pouco."}
{"category": "LocationDialogue Location4", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 145, "text": "Isso é tão estranho."}
{"category": "LocationDialogue Location4", "line_index": 146, "text": "Estamos dentro do telefone de alguém?"}
{"category": "LocationDialogue Location4", "line_index": 147, "text": "Talvez um meio ruinzinho? Com pouca memória?"}
{"category": "LocationDialogue Location4", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 149, "text": "hmhm."}
{"category": "LocationDialogue Location4", "line_index": 150, "text": "Mas nem tudo é perfeito aqui"}
{"category": "LocationDialogue Location4", "line_index": 151, "text": "Nesse mundo..."}
{"category": "LocationDialogue Location4", "line_index": 152, "text": "A gente meio que tá sendo carregado"}
{"category": "LocationDialogue Location4", "line_index": 153, "text": "junto com o núcleo dele."}
{"category": "LocationDialogue Location4", "line_index": 154, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 155, "text": "Núcleo do mundo?"}
{"category": "LocationDialogue Location4", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 157, "text": "É diferente, né?"}
{"category": "LocationDialogue Location4", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 159, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 161, "text": "Mas enfim, a gente pode"}
{"category": "LocationDialogue Location4", "line_index": 162, "text": "Jogar um jogo"}
{"category": "LocationDialogue Location4", "line_index": 163, "text": "ou só cartas."}
{"category": "LocationDialogue Location4", "line_index": 164, "text": "Você escolhe."}
{"category": "LocationDialogue Location4", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 167, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 168, "text": "// Mita brinca de luta"}
{"category": "LocationDialogue Location4", "line_index": 169, "text": "Aah, quer brigar?"}
{"category": "LocationDialogue Location4", "line_index": 170, "text": "Você tem que ganhar"}
{"category": "LocationDialogue Location4", "line_index": 171, "text": "quatro vezes."}
{"category": "LocationDialogue Location4", "line_index": 172, "text": "Vem com tudo."}
{"category": "LocationDialogue Location4", "line_index": 173, "text": "Não se preocupe, eu vou"}
{"category": "LocationDialogue Location4", "line_index": 174, "text": "pegar leve de primeira."}
{"category": "LocationDialogue Location4", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 176, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 177, "text": "Bom garoto."}
{"category": "LocationDialogue Location4", "line_index": 178, "text": "É melhor você focar!"}
{"category": "LocationDialogue Location4", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 180, "text": "Whoa!"}
{"category": "LocationDialogue Location4", "line_index": 181, "text": "Tá bom, okay."}
{"category": "LocationDialogue Location4", "line_index": 182, "text": "Vou jogar sério."}
{"category": "LocationDialogue Location4", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 184, "text": "Wow!"}
{"category": "LocationDialogue Location4", "line_index": 185, "text": "Vamos ver se você consegue"}
{"category": "LocationDialogue Location4", "line_index": 186, "text": "me vencer agora!"}
{"category": "LocationDialogue Location4", "line_index": 187, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 188, "text": "Você é "}
{"category": "LocationDialogue Location4", "line_index": 189, "text": "simplesmente"}
{"category": "LocationDialogue Location4", "line_index": 190, "text": "Incrível! Quanta habilidade!"}
{"category": "LocationDialogue Location4", "line_index": 191, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 193, "text": "Qual o problema?"}
{"category": "LocationDialogue Location4", "line_index": 194, "text": "Huh, Que droga."}
{"category": "LocationDialogue Location4", "line_index": 195, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 196, "text": "Bom,"}
{"category": "LocationDialogue Location4", "line_index": 197, "text": "É isso. Você acredita no destino?"}
{"category": "LocationDialogue Location4", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 199, "text": "Então,"}
{"category": "LocationDialogue Location4", "line_index": 200, "text": "dá um jeito de se animar ou você não vai sair do fundo do poço!"}
{"category": "LocationDialogue Location4", "line_index": 201, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 202, "text": "O que tá rolando com você?"}
{"category": "LocationDialogue Location4", "line_index": 203, "text": "Hih, esfreguei o chão com a sua cara!"}
{"category": "LocationDialogue Location4", "line_index": 204, "text": "Você não deu o seu melhor—"}
{"category": "LocationDialogue Location4", "line_index": 205, "text": "É por isso que eu ganhei!"}
{"category": "LocationDialogue Location4", "line_index": 206, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 208, "text": "Então é isso."}
{"category": "LocationDialogue Location4", "line_index": 209, "text": "Que tal a gente jogar um jogo de cartas?"}
{"category": "LocationDialogue Location4", "line_index": 210, "text": "Tá lá no quarto."}
{"category": "LocationDialogue Location4", "line_index": 211, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 214, "text": "// Porta > [ERROR]"}
{"category": "LocationDialogue Location4", "line_index": 215, "text": "Ahm, o que tá acontecendo?"}
{"category": "LocationDialogue Location4", "line_index": 216, "text": "Aonde..."}
{"category": "LocationDialogue Location4", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 218, "text": "Uh-oh."}
{"category": "LocationDialogue Location4", "line_index": 219, "text": "Desculpa..."}
{"category": "LocationDialogue Location4", "line_index": 220, "text": "Eu baixei algo"}
{"category": "LocationDialogue Location4", "line_index": 221, "text": "da internet."}
{"category": "LocationDialogue Location4", "line_index": 222, "text": "Eu queria enfeitar um pouco"}
{"category": "LocationDialogue Location4", "line_index": 223, "text": "o lado de fora."}
{"category": "LocationDialogue Location4", "line_index": 224, "text": "Mas acho que"}
{"category": "LocationDialogue Location4", "line_index": 225, "text": "tinha alguma coisa de errado com o arquivo."}
{"category": "LocationDialogue Location4", "line_index": 226, "text": "Eu vou arrumar depois."}
{"category": "LocationDialogue Location4", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 228, "text": "É por isso que a gente não pode sair da casa?"}
{"category": "LocationDialogue Location4", "line_index": 229, "text": "É por isso mesmo."}
{"category": "LocationDialogue Location4", "line_index": 230, "text": "// Mita tímida"}
{"category": "LocationDialogue Location4", "line_index": 231, "text": "Ei...."}
{"category": "LocationDialogue Location4", "line_index": 232, "text": "Aconteceu alguma coisa?"}
{"category": "LocationDialogue Location4", "line_index": 233, "text": "Eu posso te ajudar?"}
{"category": "LocationDialogue Location4", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 236, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 237, "text": "// Relógio de parede"}
{"category": "LocationDialogue Location4", "line_index": 238, "text": "Este relógio aqui,"}
{"category": "LocationDialogue Location4", "line_index": 239, "text": "que horas ele tá marcando?"}
{"category": "LocationDialogue Location4", "line_index": 240, "text": "A hora atual do jogo?"}
{"category": "LocationDialogue Location4", "line_index": 241, "text": "Ou ele está sincronizado com meu telefone?"}
{"category": "LocationDialogue Location4", "line_index": 242, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 243, "text": "Uhm, hmm..."}
{"category": "LocationDialogue Location4", "line_index": 244, "text": "Honestamente, eu não sei."}
{"category": "LocationDialogue Location4", "line_index": 245, "text": "Mas tempo não importa aqui..."}
{"category": "LocationDialogue Location4", "line_index": 246, "text": "Se tá cedo ou se está tarde,"}
{"category": "LocationDialogue Location4", "line_index": 247, "text": "uma garota forte como eu"}
{"category": "LocationDialogue Location4", "line_index": 248, "text": "tá sempre cheia de energia—"}
{"category": "LocationDialogue Location4", "line_index": 249, "text": "Eu nunca me canso!"}
{"category": "LocationDialogue Location4", "line_index": 250, "text": "A gente pode ter primavera eterna,"}
{"category": "LocationDialogue Location4", "line_index": 251, "text": "ou uma tarde sem fim!"}
{"category": "LocationDialogue Location4", "line_index": 252, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 253, "text": "Isso é interessante..."}
{"category": "LocationDialogue Location4", "line_index": 254, "text": "mas também um pouco assustador."}
{"category": "LocationDialogue Location4", "line_index": 255, "text": "Preso no mesmo momento, para sempre..."}
{"category": "LocationDialogue Location4", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 258, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 259, "text": "// Fotos de Mita"}
{"category": "LocationDialogue Location4", "line_index": 260, "text": "Belas fotos."}
{"category": "LocationDialogue Location4", "line_index": 261, "text": "Acho que são suas?"}
{"category": "LocationDialogue Location4", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 263, "text": "Aham."}
{"category": "LocationDialogue Location4", "line_index": 264, "text": "Eu também gosto."}
{"category": "LocationDialogue Location4", "line_index": 265, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 266, "text": "Quem tirou elas?"}
{"category": "LocationDialogue Location4", "line_index": 267, "text": "Tem outros neste mundo também?"}
{"category": "LocationDialogue Location4", "line_index": 268, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 269, "text": "É...Pode se dizer que sim."}
{"category": "LocationDialogue Location4", "line_index": 270, "text": "Eu vou introduzir vocês eventualmente."}
{"category": "LocationDialogue Location4", "line_index": 271, "text": "Só não por enquanto."}
{"category": "LocationDialogue Location4", "line_index": 272, "text": "Por agora, eu quero ficar sozinha com você."}
{"category": "LocationDialogue Location4", "line_index": 273, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 275, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 276, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 277, "text": "// Portal"}
{"category": "LocationDialogue Location4", "line_index": 278, "text": "Para onde foi o portal?"}
{"category": "LocationDialogue Location4", "line_index": 279, "text": "Ou seja lá como você o chamou?"}
{"category": "LocationDialogue Location4", "line_index": 280, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 281, "text": "Eu usei uma"}
{"category": "LocationDialogue Location4", "line_index": 282, "text": "Pequena magica"}
{"category": "LocationDialogue Location4", "line_index": 283, "text": "E movi ele"}
{"category": "LocationDialogue Location4", "line_index": 284, "text": "Para outro lugar."}
{"category": "LocationDialogue Location4", "line_index": 285, "text": "A gente não precisa mais dele."}
{"category": "LocationDialogue Location4", "line_index": 286, "text": "Ele só atrapalharia."}
{"category": "LocationDialogue Location4", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 288, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 289, "text": "// Espelho no quarto"}
{"category": "LocationDialogue Location4", "line_index": 290, "text": "Olhar para o espelho sem "}
{"category": "LocationDialogue Location4", "line_index": 291, "text": "ver o próprio reflexo é assustador."}
{"category": "LocationDialogue Location4", "line_index": 292, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 293, "text": "Eu posso ativar os reflexos"}
{"category": "LocationDialogue Location4", "line_index": 294, "text": "Se você quiser tanto."}
{"category": "LocationDialogue Location4", "line_index": 295, "text": "Mas... A gente precisa dele?"}
{"category": "LocationDialogue Location4", "line_index": 296, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 297, "text": "É claro que precisamos."}
{"category": "LocationDialogue Location4", "line_index": 298, "text": "Ou....Ligá-los vai gerar consequências?"}
{"category": "LocationDialogue Location4", "line_index": 299, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 300, "text": "Uhum."}
{"category": "LocationDialogue Location4", "line_index": 301, "text": "A gente vai falar estranho e se mover bem devagar."}
{"category": "LocationDialogue Location4", "line_index": 302, "text": "Já viu um desenho animado com poucos frames por segundo?"}
{"category": "LocationDialogue Location4", "line_index": 303, "text": "Seria tipo isso pra gente, o tempo todo."}
{"category": "LocationDialogue Location4", "line_index": 304, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 305, "text": "Entendi."}
{"category": "LocationDialogue Location4", "line_index": 306, "text": "Então acho que é melhor manter os reflexos desligados..."}
{"category": "LocationDialogue Location4", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 308, "text": "Huhum, [player],"}
{"category": "LocationDialogue Location4", "line_index": 309, "text": "Você parece gostar muito de espelhos."}
{"category": "LocationDialogue Location4", "line_index": 310, "text": "Por acaso tem medo de ver um sorriso no seu rosto?"}
{"category": "LocationDialogue Location4", "line_index": 311, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 312, "text": "Hm? Nem tanto..."}
{"category": "LocationDialogue Location4", "line_index": 313, "text": "Eu só estou cansado"}
{"category": "LocationDialogue Location4", "line_index": 314, "text": "depois de todo o trabalho."}
{"category": "LocationDialogue Location4", "line_index": 315, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 316, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 317, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 318, "text": "// Tênis Azul"}
{"category": "LocationDialogue Location4", "line_index": 319, "text": "Eles são seus?"}
{"category": "LocationDialogue Location4", "line_index": 320, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 321, "text": "Não, eles são seus"}
{"category": "LocationDialogue Location4", "line_index": 322, "text": "Você não se lembra?"}
{"category": "LocationDialogue Location4", "line_index": 323, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 324, "text": "Eu não me lembro de ter um tênis assim."}
{"category": "LocationDialogue Location4", "line_index": 325, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 326, "text": "É claro que lembra."}
{"category": "LocationDialogue Location4", "line_index": 327, "text": "Você pode vestir ele"}
{"category": "LocationDialogue Location4", "line_index": 328, "text": "Quando a gente for sair."}
{"category": "LocationDialogue Location4", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 330, "text": "E sobre a roupa?"}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "Tudo que eu tenho nesse mundo"}
{"category": "LocationDialogue Location4", "line_index": 332, "text": "São as roupas que estou usando."}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "Há algum jeito que eu possa arrumar?"}
{"category": "LocationDialogue Location4", "line_index": 334, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 335, "text": "Claro que tem como."}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "Se bem que eu já vi você vestindo—"}
{"category": "LocationDialogue Location4", "line_index": 337, "text": "E sinceramente, seu gosto é péssimo."}
{"category": "LocationDialogue Location4", "line_index": 338, "text": "De toda forma, eu vou te ajudar a pegar umas novas."}
{"category": "LocationDialogue Location4", "line_index": 339, "text": "Só não sendo agora."}
{"category": "LocationDialogue Location4", "line_index": 340, "text": "É uma promessa."}
{"category": "LocationDialogue Location4", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 342, "text": "Okay."}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Jogos na TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "E ai, o que você quer jogar?"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Jogo do Leite"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "Esse aqui é jogo de luta!"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "Vamos ver quem azeda primeiro!"}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "Mas que jogo!"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": "Chega de leite, vamos fazer outra coisa."}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Jogo do pinguin"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "Nesse jogo, você é um pinguim"}
{"category": "LocationDialogue Location4", "line_index": 354, "text": "escorregando por ai."}
{"category": "LocationDialogue Location4", "line_index": 355, "text": "Uhum, isso ai!"}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Fique com Mita"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "Ahm, o que?"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "Tá falando serio? Eu achei que você..."}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "Ai eu tô tão feliz!"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "E um pouco confusa..."}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "Mas..."}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "Por favor, fica comigo—"}
{"category": "LocationDialogue Location4", "line_index": 364, "text": "Para sempre."}
{"category": "LocationDialogue Location4", "line_index": 365, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 367, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 368, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 369, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 370, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 372, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 373, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 374, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 375, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 376, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 377, "text": "// Um jogo sobre pinguins"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "É super simples:"}
{"category": "LocationDialogue Location4", "line_index": 379, "text": "É só coletar as bolinhas de neve."}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "Quem coletar mais, ganha!"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "Vamos só jogar dois rounds, tá bom?!"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// Primeiro mapa"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "Wow, como você pegou tantas?"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "Tee-hee! Eu peguei mais bolas!"}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "Espero que me alcance!"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "Sheesh, 1:1!"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// Segundo mapa"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "Você nasceu para ser um pinguim!"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "A gente devia ir esquiar de verdade!"}
{"category": "LocationDialogue Location4", "line_index": 390, "text": "Pfft, você é muito lento."}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "Ainda tá pensando no round passado?"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "Nossa, empatou! Isso é raro!"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// O jogo acabou"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "Tá bom, quer jogar outra coisa?"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "Ou já tá bom?"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "Para que precisa disso?"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "É tão gamer assim?"}
