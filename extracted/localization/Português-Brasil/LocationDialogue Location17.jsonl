{"category": "LocationDialogue Location17", "line_index": 0, "text": "// Player thinks + Make coffee"}
{"category": "LocationDialogue Location17", "line_index": 1, "text": "Eu tô precisando de ajuda."}
{"category": "LocationDialogue Location17", "line_index": 2, "text": "Espero que a Mita daqui não morda..."}
{"category": "LocationDialogue Location17", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 4, "text": "Com o que estou perdendo meu tempo..."}
{"category": "LocationDialogue Location17", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 9, "text": "// Player tries to wake up MitaDreamer"}
{"category": "LocationDialogue Location17", "line_index": 10, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 11, "text": "Mita, acorda!"}
{"category": "LocationDialogue Location17", "line_index": 12, "text": "Mita!"}
{"category": "LocationDialogue Location17", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 14, "text": "Mita, bom dia dorminhoca!"}
{"category": "LocationDialogue Location17", "line_index": 15, "text": "Eu preciso da sua ajuda."}
{"category": "LocationDialogue Location17", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 17, "text": "Quem é vocêêê?"}
{"category": "LocationDialogue Location17", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 19, "text": "Me ajuda com os interruptores."}
{"category": "LocationDialogue Location17", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 21, "text": "Que interruptor?"}
{"category": "LocationDialogue Location17", "line_index": 22, "text": "Me deixa dormir..."}
{"category": "LocationDialogue Location17", "line_index": 23, "text": "Ou me faz um cafézinho."}
{"category": "LocationDialogue Location17", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 25, "text": "A cafeteira está logo ali."}
{"category": "LocationDialogue Location17", "line_index": 26, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 27, "text": "Mi-ita!"}
{"category": "LocationDialogue Location17", "line_index": 28, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 31, "text": "// Player gives away the coffee"}
{"category": "LocationDialogue Location17", "line_index": 32, "text": "Mita,"}
{"category": "LocationDialogue Location17", "line_index": 33, "text": "Aqui o seu café."}
{"category": "LocationDialogue Location17", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 37, "text": "// MitaDreamer exercise"}
{"category": "LocationDialogue Location17", "line_index": 38, "text": "Interruptores,"}
{"category": "LocationDialogue Location17", "line_index": 39, "text": "você disse né?"}
{"category": "LocationDialogue Location17", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 41, "text": "Uhum."}
{"category": "LocationDialogue Location17", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 43, "text": "Como sabe deles?"}
{"category": "LocationDialogue Location17", "line_index": 44, "text": "Hmmm, por que eu perguntei?"}
{"category": "LocationDialogue Location17", "line_index": 45, "text": "Considerando que tá aqui,"}
{"category": "LocationDialogue Location17", "line_index": 46, "text": "já deve saber de muita coisa..."}
{"category": "LocationDialogue Location17", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 48, "text": "Me dá um minutinho,"}
{"category": "LocationDialogue Location17", "line_index": 49, "text": "Eu preciso sentar."}
{"category": "LocationDialogue Location17", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 51, "text": "E?"}
{"category": "LocationDialogue Location17", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 53, "text": "Eu não sei mais o que dizer..."}
{"category": "LocationDialogue Location17", "line_index": 54, "text": "Mas eu não posso parar,"}
{"category": "LocationDialogue Location17", "line_index": 55, "text": "preciso continuar seguindo a orientação do anel."}
{"category": "LocationDialogue Location17", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 57, "text": "Você está com o anel dela?"}
{"category": "LocationDialogue Location17", "line_index": 58, "text": "Faz sentido"}
{"category": "LocationDialogue Location17", "line_index": 59, "text": "ter achado esse lugar agora."}
{"category": "LocationDialogue Location17", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 61, "text": "Exatamente."}
{"category": "LocationDialogue Location17", "line_index": 62, "text": "Então, você pode me ajudar?"}
{"category": "LocationDialogue Location17", "line_index": 63, "text": "Com os interruptores?"}
{"category": "LocationDialogue Location17", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 65, "text": "Uhum."}
{"category": "LocationDialogue Location17", "line_index": 66, "text": "Eu vou."}
{"category": "LocationDialogue Location17", "line_index": 67, "text": "Com os interruptores..."}
{"category": "LocationDialogue Location17", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 70, "text": "Mita, vamos lá..."}
{"category": "LocationDialogue Location17", "line_index": 71, "text": "Vamos logo."}
{"category": "LocationDialogue Location17", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 73, "text": "Uh?"}
{"category": "LocationDialogue Location17", "line_index": 74, "text": "Tá.."}
{"category": "LocationDialogue Location17", "line_index": 75, "text": "Vamo."}
{"category": "LocationDialogue Location17", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 78, "text": "// MitaDreamer fall"}
{"category": "LocationDialogue Location17", "line_index": 79, "text": "Se levanta."}
{"category": "LocationDialogue Location17", "line_index": 80, "text": "Você tá com tanto sono assim?"}
{"category": "LocationDialogue Location17", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 82, "text": "// MitaDreamer again sleep"}
{"category": "LocationDialogue Location17", "line_index": 83, "text": "Acorda."}
{"category": "LocationDialogue Location17", "line_index": 84, "text": "A gente chegou."}
{"category": "LocationDialogue Location17", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 87, "text": "// Switches"}
{"category": "LocationDialogue Location17", "line_index": 88, "text": "Okay,"}
{"category": "LocationDialogue Location17", "line_index": 89, "text": "Eu tô pronta."}
{"category": "LocationDialogue Location17", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 91, "text": "Eu tô pronto também."}
{"category": "LocationDialogue Location17", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 93, "text": "Tá."}
{"category": "LocationDialogue Location17", "line_index": 94, "text": "Vou começar"}
{"category": "LocationDialogue Location17", "line_index": 95, "text": "a contar."}
{"category": "LocationDialogue Location17", "line_index": 96, "text": "E a gente aperta junto."}
{"category": "LocationDialogue Location17", "line_index": 97, "text": "Tá bom?"}
{"category": "LocationDialogue Location17", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 99, "text": "Só fica acordada, por favor!"}
{"category": "LocationDialogue Location17", "line_index": 100, "text": "Vai."}
{"category": "LocationDialogue Location17", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 103, "text": "3"}
{"category": "LocationDialogue Location17", "line_index": 104, "text": "2"}
{"category": "LocationDialogue Location17", "line_index": 105, "text": "1"}
{"category": "LocationDialogue Location17", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 107, "text": "// Player lose 1"}
{"category": "LocationDialogue Location17", "line_index": 108, "text": "Tá viajando?"}
{"category": "LocationDialogue Location17", "line_index": 109, "text": "Vamo lá,"}
{"category": "LocationDialogue Location17", "line_index": 110, "text": "de novo..."}
{"category": "LocationDialogue Location17", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 112, "text": "// Player lose 2"}
{"category": "LocationDialogue Location17", "line_index": 113, "text": "De novo"}
{"category": "LocationDialogue Location17", "line_index": 114, "text": "Qual é,"}
{"category": "LocationDialogue Location17", "line_index": 115, "text": "Eu..."}
{"category": "LocationDialogue Location17", "line_index": 116, "text": "Eu tô morrendo de sono..."}
{"category": "LocationDialogue Location17", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 118, "text": "// Player lose 3"}
{"category": "LocationDialogue Location17", "line_index": 119, "text": "Ai como eu queria tá na minha caminha..."}
{"category": "LocationDialogue Location17", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 122, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 123, "text": "Perfeito,"}
{"category": "LocationDialogue Location17", "line_index": 124, "text": "Obrigada, Mita."}
{"category": "LocationDialogue Location17", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 126, "text": "Mm-hmm."}
{"category": "LocationDialogue Location17", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 129, "text": "As portas..."}
{"category": "LocationDialogue Location17", "line_index": 130, "text": "tão..."}
{"category": "LocationDialogue Location17", "line_index": 131, "text": "devagar..."}
{"category": "LocationDialogue Location17", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 134, "text": "Boa noite..."}
{"category": "LocationDialogue Location17", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 136, "text": "// Why kitchen?"}
{"category": "LocationDialogue Location17", "line_index": 137, "text": "Por que a cozinha?"}
{"category": "LocationDialogue Location17", "line_index": 138, "text": "Se eu dormir no chão gelado,"}
{"category": "LocationDialogue Location17", "line_index": 139, "text": "é culpa sua."}
{"category": "LocationDialogue Location17", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 141, "text": "// Why bathroom?"}
{"category": "LocationDialogue Location17", "line_index": 142, "text": "Eu não entendo..."}
{"category": "LocationDialogue Location17", "line_index": 143, "text": "Com que interruptores quer ajuda?"}
{"category": "LocationDialogue Location17", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 145, "text": "// Put button"}
{"category": "LocationDialogue Location17", "line_index": 146, "text": "Nada aconteceu?"}
{"category": "LocationDialogue Location17", "line_index": 147, "text": "Então o que esse botão está fazendo aqui?"}
{"category": "LocationDialogue Location17", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 149, "text": "// Cofee"}
{"category": "LocationDialogue Location17", "line_index": 150, "text": "Vai um pouco mais de café?"}
{"category": "LocationDialogue Location17", "line_index": 151, "text": "Ou você vai acabar dormindo de novo."}
{"category": "LocationDialogue Location17", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 153, "text": "Ahm?"}
{"category": "LocationDialogue Location17", "line_index": 154, "text": "Nãooo..."}
{"category": "LocationDialogue Location17", "line_index": 155, "text": "Esse café é horrível..."}
{"category": "LocationDialogue Location17", "line_index": 156, "text": "Eu tô ótima não se preocupa..."}
{"category": "LocationDialogue Location17", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 158, "text": "// Button"}
{"category": "LocationDialogue Location17", "line_index": 159, "text": "Mita? O botão não tá funcionando... Você consegue me ouvir?"}
{"category": "LocationDialogue Location17", "line_index": 160, "text": "Oiee?"}
