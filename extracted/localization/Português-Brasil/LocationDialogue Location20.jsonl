{"category": "LocationDialogue Location20", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Mila! Não! Você é insana!"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Ha-ha! O que é isso?"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "Uma carinha nova?"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "Volta aqui para eu ver!"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "Ver essa sua carinha de sempre é tão entediante!"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\""}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "Como você tá, meu viajante incansável?"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "Continua correndo por ai? Ainda não teve o suficiente?"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Por que você fez isso com a Mila?"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "Ah, então você não cansou!"}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Perfeito! Vamos jogar outro jogo!"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "Você..."}
{"category": "LocationDialogue Location20", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "Começando por um pequeno teste!"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "Vamos testar sua coordenação!"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "Agora sua habilidade de interpretação!"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "E se tivesse alguma coisa errada com você?"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "E se você sequer merecesse"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "estar vivo!"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "Dá uma olhada..."}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "Qual chama mais sua atenção?"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "Da direita?"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "Ou será que"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "Da esquerda?"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "Ahm, serio?"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "E isso importa?"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "Eu tava só brincando!"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "Facadas são coisas do passado, afinal"}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "De toda forma!"}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "Eu tenho jogos muito melhores em mente,"}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "tipo..."}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "Dá uma olhada!"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Precisamos de música!"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "O que acha dessa melodia?"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "Faz meu sangue borbulhar!"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "Vou começar"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "com as regras!"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rules"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "Enquanto a música toca,"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "você pode se mover."}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "Mas quando a música parar,"}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "Não se mexa!"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "Ou você morre. Tá bom?"}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "É simples: É só chegar no final"}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "antes da música acabar."}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "Vamos começar!"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "Ainda tá parado?"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Corre, meu amor, corre!"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "Own!"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Olha para você! Tão obediente!"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Meu cachorrinho perfeito"}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Eu quero você todinho para mim!"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "Mas eu achei meio fácil na verdade"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "Me deixa ir!"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "Não vai se acomodar hein!"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "A gente tem muito mais jogos para jogar!"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "Aqui o próximo:"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Eu vou fechar meus olhos..."}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "E quando eu abrir,"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "você tem que desaparecer!"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "Tá bom?"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "Se eu te ver, eu vou te punir!"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Muito bem! Começando!"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "Isso não tem sentido..."}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "Você conseguiu!"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Você tá indo tão bem—Eu tô ficando animada!"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "Mas vai ficar mais difícil."}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "BEM mais dificil."}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Se esconda, corra, gire—"}
{"category": "LocationDialogue Location20", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "Aah, vai se ferrar!"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Player falls"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "Acho que consegui escapar..."}
