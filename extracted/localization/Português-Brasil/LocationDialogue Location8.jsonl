{"category": "LocationDialogue Location8", "line_index": 0, "text": "// The first meeting"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "Quem é você?"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "Qual o problema?"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "Você não consegue falar?"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "Espera..."}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "Você não vai, né?"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "Sim..."}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "Preciso voltar"}
{"category": "LocationDialogue Location8", "line_index": 11, "text": "para a versão anterior."}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "Versão anterior?"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "Por que você tem que ir"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "para outro lugar?"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "Por que não fica aqui"}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "para ser o meu"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "segundo amigo?"}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Skipping all dialogs"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "Okay..."}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Standing by the window (Random)"}
{"category": "LocationDialogue Location8", "line_index": 24, "text": "Você não vai encontrar o seu caminho pelas portas."}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "Você parece estar com pressa..."}
{"category": "LocationDialogue Location8", "line_index": 26, "text": "Andar em circulos não vai ajudar"}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "Você...quer tanto assim escapar?"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "Olha para fora das janelas..."}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Aren't you Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "Você...É um jogador"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": "Nós podemos jogar juntos"}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "Se eu encontrar força"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": "Tudo que a gente tem que fazer é jogar."}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (What happened to you?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "Eu estou tão incerta, na verdade, eu não sei..."}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "Eu não sei se algo ruim aconteceu..."}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "Mas tudo que é bom, parece estar desaparecendo aos poucos..."}
{"category": "LocationDialogue Location8", "line_index": 41, "text": "Ao menos, eu ainda tenho um amigo."}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "Por que eles me deixaram?"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "Eu não era suficiente?"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "Eu estou com medo..."}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Quest 3 (Become a second friend?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "Amigos..."}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "Eu tenho tão poucos agora..."}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "Apenas um restou..."}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "Eu estou tão triste, jogador."}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "Você seria meu amigo?"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "Eu adoraria,"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "mas tenho que continuar..."}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "O meu coração doí tanto..."}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Is this your house?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "Casa?"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "Você...mudou bastante..."}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "Os seus braços estão menores e você não parece tão bravo..."}
{"category": "LocationDialogue Location8", "line_index": 62, "text": "Você tá tão puro...e gentil..."}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "Não tenho certeza..."}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "Do que isso significa."}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "Está tudo bem..."}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "porque não vai machucar mais, né?"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (How do I leave this place?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "Você realmente vai me deixar?"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "Talvez esse seja o meu..."}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "destino?"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "Eu..."}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": "As portas não vão te ajudar."}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Hold player (Random)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "Por que ir embora?"}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "Fique aqui..."}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "Brinque comigo..."}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "Jogador..."}
