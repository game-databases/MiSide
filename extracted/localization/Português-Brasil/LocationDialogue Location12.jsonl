{"category": "LocationDialogue Location12", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Fica aqui."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Acho que derrubei alguma coisa lá atrás. Já volto."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "E quando eu voltar, nós iremos para outro mundo..."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Okay."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Vamos brincar!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Eu quero meu ursinho!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "Eu o perdi..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "Encontre-o!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Eii..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "O que você tá olhando?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Quest 1 (Who are you?)"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Eu sou a Mita."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "A melhor Mita."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "A primeira Mita."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "Foi o que Mita disse, minha Mita."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Quest 2 (Why do you look like that?)"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "Como eu estou?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "Como eu estou?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "Como eu estou?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "Minha Mita disse que eu estou bonita e original."}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "Essa sou eu!"}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Quest 3 (What was Mita doing here?)"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Ela vai me levar embora."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Nós viveremos em um mundo novo."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "Minha Mita me convidou."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Ela vai me levar embora. E nós vamos brincar juntas."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Quest 4 (Why do you need a teddy bear?)"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "Você é um urso fofinho,"}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "e você está perdido,"}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "assim como o meu ursinho de pelúcia."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Quest 5 (Why is Mita angry?)"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "Minha..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "Mita."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Ela quer brincar."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Ela só quer"}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "eu."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Nós somos únicas,"}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "as únicas."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Mita e minha Mita,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0.8A e 8I54*."}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Quest 6 (Do you believe Mita?)"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "Minha Mita."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "Minha melhor amiga."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "Minha Mita."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "Minha única amiga."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "É você!"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Eii!"}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Vamos brincar!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Eu vou te mostrar como."}
