{"category": "LocationDialogue Location10", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "!ﺎﺴﯾﺍﻭ ،ﻦﮐ ﺮﺒﺻ"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "...ﻥﺰﻧ ﻑﺮﺣ ﺪﻨﻠﺑ ﺭﺪﻘﻧﺍ"}
{"category": "LocationDialogue Location10", "line_index": 3, "text": ".ﻪﮐﺎﻧﺮﻄﺧ ﻦﺘﻓﺭ ﺮﺗﻮﻠﺟ"}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "...ﯽﺘﺳﺍﺭ"}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "؟ﺎﺠﻨﯾﺍ ﯼﺪﯿﺳﺭ ﺭﻮﻄﭼ"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "...ﻡﺍ"}
{"category": "LocationDialogue Location10", "line_index": 8, "text": ".ﻪﻨﮐ ﯽﻣ ﺯﺎﺑ ﻭﺭ ﺖﺳﺭﺩ ﯼﺎﻫﺭﺩ ﻪﻘﻠﺣ"}
{"category": "LocationDialogue Location10", "line_index": 9, "text": ".ﻪﻨﮐ ﯽﻣ ﺭﺎﮐ ﯼﺭﻮﻄﭼ ﻢﻧﻭﺩ ﯽﻤﻧ ،ﯼﺍﻮﺨﺑ ﻭﺭ ﺶﺘﺳﺍﺭ"}
{"category": "LocationDialogue Location10", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "؟ﻪﻘﻠﺣ"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "؟ﻩﺪﺷ ﯽﭼ ﺎﺟ ﻦﯾﺍ"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": ".ﻪﮑﯾﺭﺎﺗ ﯽﻠﯿﺧ"}
{"category": "LocationDialogue Location10", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 16, "text": ".ﻢﮕﯿﻣ ﺖﻬﺑ ًﺍﺪﻌﺑ"}
{"category": "LocationDialogue Location10", "line_index": 17, "text": ".ﯽﺟﻭﺮﺧ ﺭﺩ ﺖﻤﺳ ﻭﺮﺑ ًﻼﻌﻓ"}
{"category": "LocationDialogue Location10", "line_index": 18, "text": ".ﻦﯿﺒﺑ ﻮﻨﻣ ﺪﯿﮐﺭﺁ ﻩﺎﮕﺘﺳﺩ ﻮﺗ"}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "!ﻦﮑﻧ ﺮﯾﺩ ،ﻦﮐ ﻪﻠﺠﻋ"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "ﻢﯿﮔ ﯽﻨﯿﻣ ﺯﺍ ﺪﻌﺑ //"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "؟ﻪﯿﭼ ﯼﺯﺎﺑ ﻑﺪﻫ ﯼﺪﯿﻤﻬﻓ ،ﺐﺧ"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "؟ﯽﺘﺴﻫ ﯽﺘﻠﮑﺳﺍ ﻝﺪﻣ ﻪﯾ ﻮﺗ ﻭ ﻢﻧﺍﻮﺨﺘﺳﺍ ﻭ ﺖﺷﻮﮔ ﺯﺍ ﻦﻣ ﻪﮑﻨﯾﺍ"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "!ﯼﺍﻭ"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": ".ﻪﮐﺎﻨﺳﺮﺗ ﯽﯾﺍﺭﻮﺟ ﻪﯾ ﯽﮕﯿﻣ ﯼﺭﻮﺠﻨﯾﺍ ﯽﺘﻗﻭ"}
{"category": "LocationDialogue Location10", "line_index": 32, "text": ".ﻪﻨﯿﻤﻫ ًﺎﻘﯿﻗﺩ ﺭﻮﻈﻨﻣ ،ﺐﺧ ﯽﻟﻭ"}
{"category": "LocationDialogue Location10", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "؟ﻢﻤﻬﻔﺑ ﻮﻨﯾﺍ ﺪﯾﺎﺑ ﺍﺮﭼ ﯽﻟﻭ ،ﻪﺘﺳﺭﺩ"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "،ﻪﮐﺎﻧﺮﻄﺧ ﻦﺘﻓﺭ ﺮﺗﻮﻠﺟ ﻢﺘﻔﮔ ﯽﺘﻗﻭ ﯼﺩﺮﮐ ﺮﮑﻓ"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "؟ﻡﺩﺮﮐ ﯽﻣ ﯽﺧﻮﺷ ﻂﻘﻓ"}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "...ﯽﺷ ﯽﻣ ﻭﺮﺑﻭﺭ ﻩﺪﺷﺎﻫﺭ ﯼﺎﻫ ﻝﺪﻣ ﺎﺑ ﻮﺗ"}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "\".ﺏﻮﯿﻌﻣ\" ﯼﺎﻫ ﻝﺪﻣ ،ﻥﺪﺷ ﻪﺘﺷﺍﺬﮔ ﺭﺎﻨﮐ ﻪﮐ ﯽﯾﺎﻧﻭﺍ"}
{"category": "LocationDialogue Location10", "line_index": 40, "text": ".ﻦﺸﮑﺑ ﻭﺭ ﻮﺗ ﻥﺍﻮﺨﺑ ﻪﻨﮑﻤﻣ ﯽﺘﺣ ﻭ ﻦﺘﺴﻫ ﯽﻤﺟﺎﻬﺗ ﺎﻧﻭﺍ"}
{"category": "LocationDialogue Location10", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "؟ﻢﻨﮐ ﺭﺎﮐ ﯽﭼ ﺪﯾﺎﺑ ﺲﭘ ،ﺐﺧ"}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "ﻡﺮﯿﻣ ﻂﻘﻓ ﻦﻣ"}
{"category": "LocationDialogue Location10", "line_index": 44, "text": ".ﻪﺸﺑ ﺯﺎﺑ ﯼﺭﺩ ﻪﮐ ﺎﺟ ﺮﻫ"}
{"category": "LocationDialogue Location10", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "!ﯼﺍﻭ"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": ".ﻦﮑﻧ ﺖﺸﭘ ﻥﻮﺸﻬﺑ ﺖﻗﻭ ﭻﯿﻫ ﺲﭘ"}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "!ﻦﮑﻧ ﻥﻮﺷﺭﻭﺩ ﺖﻤﺸﭼ ﯼﻮﻠﺟ ﺯﺍ ﻭ"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "،ﻦﺸﮐ ﯽﻣ ﺖﻟﺎﺠﺧ ﯽﻧﺰﺑ ﻝﺯ ﻥﻮﺸﻬﺑ ﯽﺘﻗﻭ"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": ".ﻪﻧﺯ ﯽﻣ ﻥﻮﺷ ﮏﺸﺧ ﻪﮐ ﺖﻟﺎﺠﺧ ﺭﺪﻘﻧﻭﺍ"}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "!ﻪﺷﺎﺑ ﺕﺩﺎﯾ"}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// Quest 1 (Why are there other Mitas down there?)"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": ".ﻥﺪﺷ ﻪﺘﺧﺎﺳ ﻩﺯﺎﺗ ﺎﻧﻭﺍ"}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "ﻥﺭﺍﺩ ﻥﺎﻣﺯ ﻪﺑ ﺯﺎﯿﻧ"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": ".ﻦﺳﺮﺑ ﯽﻫﺎﮔﺁﺩﻮﺧ ﻪﺑ ﺎﺗ"}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "ﻭﺭ ﻡﻭﺪﮐ ﺮﻫ ﻦﻣ ﺵﺪﻌﺑ"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": ".ﻢﻨﮐ ﯽﻣ ﯽﯾﺎﻤﻨﻫﺍﺭ ﺵﺩﻮﺧ ﻪﻧﻮﺧ ﻪﺑ"}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// Quest 2 (Why is it so dark downstairs?)"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "،ﻢﯿﺷ ﯽﻣ \"ﻖﻠﺧ\" ﯽﮑﯾﺭﺎﺗ ﯼﻮﺗ ﺎﻫﺎﺘﯿﻣ ﺎﻣ"}
{"category": "LocationDialogue Location10", "line_index": 68, "text": ".ﻢﯿﻧﻮﻤﺑ ﺎﺠﻧﻭﺍ ﺕﺪﻣ ﻪﯾ ﺪﯾﺎﺑ ﺲﭘ"}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "ﻦﮐ ﺭﻮﺼﺗ"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "...ﻭﺭ ﯽﯾﺎﻨﺷﻭﺭ ﻪﺑ ﯽﮑﯾﺭﺎﺗ ﺯﺍ ﯽﯾﺎﺟ ﻪﺑﺎﺟ ﺩﺭﺩ"}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// Quest 3 (What are you doing here?)"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "؟ﯼﺪﯿﻤﻬﻔﻧ ﺯﻮﻨﻫ"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "!ﻦﺘﻔﯿﺑ ﺎﺟ ﺎﺗ ﻢﻨﮐ ﯽﻣ ﮏﻤﮐ ﺪﯾﺪﺟ ﯼﺎﻫﺎﺘﯿﻣ ﻪﺑ ﻡﺭﺍﺩ ﻦﻣ"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "؟ﻪﻨﮐ ﯽﻣ ﮏﻤﮐ ﻥﻮﺸﻬﺑ ﯽﮐ ،ﻢﻨﮑﻧ ﮏﻤﮐ ﻦﻣ ﻪﮔﺍ"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "؟ﻮﺗ"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// Quest 4 (Why do we need this conveyor?)"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "؟ﻪﯿﭼ ﯼﺍﺮﺑ ﻪﻟﺎﻘﻧ ﺭﺍﻮﻧ ﻦﯾﺍ"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "؟ﺖﺴﻫ ﯽﻓﺎﮐ ﻪﻤﻫ ﯼﺍﺮﺑ ﺎﺟ ﺎﯾﺁ"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "ﻮﺗ ﻪﮐ ﻮﮕﻧ ،ﻦﮐ ﺮﺒﺻ"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "...ﻪﻨﮐ ﯽﻣ ﺭﺎﮐ ﺭﻮﻄﭼ ﯼﺎﯿﻧﺩ ﯽﻤﻬﻓ ﯽﻤﻧ"}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "؟ﻪﻧﺎﯾﺎﭘ ﯽﺑ ﻦﯾﺍ ﻪﮑﻨﯾﺍ ﻭ"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "؟ﻥﺎﯾﺎﭘ ﯽﺑ"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "...ﻢﻣﺍ"}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "؟ﻪﯿﭼ ﺕﺭﻮﻈﻨﻣ"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "،ﻪﺷﺎﺑ ﻪﺨﺴﻧ ﻦﯾﺮﺧﺁ ۱.۹ ﻪﺨﺴﻧ ﻪﮔﺍ"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": ".ﺖﺴﻫ ﻒﻠﺘﺨﻣ ﯼﺎﯿﻧﺩ ۱۹ ﻂﻘﻓ ﺲﭘ"}
{"category": "LocationDialogue Location10", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "ًﺎﻌﻗﺍﻭ ﻮﺗ ،ﺍﺪﺧ ﯼﺍﻭ"}
{"category": "LocationDialogue Location10", "line_index": 93, "text": ".ﯽﻤﻬﻓ ﯽﻤﻧ ﺎﯿﻧﺩ ﻦﯾﺍ ﻥﺩﺮﮐ ﺭﺎﮐ ﺭﻮﻄﭼ ﺯﺍ ﯼﺰﯿﭼ ﭻﯿﻫ"}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "ﻢﻨﮐ ﯽﻣ ﻩﺩﺎﻔﺘﺳﺍ ﻩﺎﯿﺳ ﻪﺘﺨﺗ ﻦﯾﺍ ﺯﺍ ﻦﻣ ،ﻦﯿﺒﺑ"}
{"category": "LocationDialogue Location10", "line_index": 95, "text": ".ﻡﺪﺑ ﺢﯿﺿﻮﺗ ﺕﺍﺮﺑ ﻭﺭ ﺰﯿﭼ ﻪﻤﻫ ﺎﺗ"}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "؟ﯼﻮﻨﺸﺑ ﺵﺭﺎﺑﺭﺩ ﯼﺍﻮﺧ ﯽﻣ"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// Quest 5 (What is your version?)"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "،ﻦﮐ ﺮﺒﺻ"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "؟ﻡﺩﺮﮑﻧ ﺕﺎﻗﻼﻣ ﻮﺗ ﺎﺑ ﻪﺨﺴﻧ ﻦﯾﺮﺧﺁ ﯼﻮﺗ ﻦﻣ ﺎﯾﺁ"}
{"category": "LocationDialogue Location10", "line_index": 101, "text": ".ﻪﻨﻣ ﺕﺍﺭﻮﺼﺗ ﻂﻘﻓ ﺪﯾﺎﺷ ﺎﯾ"}
{"category": "LocationDialogue Location10", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 103, "text": ".ﻩﺭﺍﺩ ﯼﺩﺎﯾﺯ ﻝﺎﻤﺘﺣﺍ ،ﺐﺧ"}
{"category": "LocationDialogue Location10", "line_index": 104, "text": ".ﻢﺘﺴﻫ ۱.۵ ﻪﺨﺴﻧ ﺯﺍ ﻦﻣ"}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "؟ﯽﺘﻓﺭ ﺎﺠﻧﻭﺍ ﻪﺑ ﻮﺗ"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 107, "text": ".ﻢﺘﻓﺭ"}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "ﻡﺪﯿﺳﺭ ﻦﻣ ﻪﮐ ﺖﺳﺎﺟ ﻥﻮﻤﻫ"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "!ﻡﺪﺷ ﺏﺎﺗﺮﭘ ﺎﯿﻧﺩ ﻦﯾﺍ ﻪﺑ ﻪﮐ ﯽﺘﻗﻭ"}
{"category": "LocationDialogue Location10", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "!ﯼﺍﻭ"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "؟...ﺭﻮﻄﭼ ﯽﻟﻭ"}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "؟ﯼﺩﻮﺑ ﻪﻧﻮﺧ ﺲﮐﺪﻨﯾﺍ ﻡﻭﺪﮐ ﯼﻮﺗ ﻮﺗ ﺎﻣﺍ"}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "،ﻩﺭﺍﺩ ﯽﻤﻧﺮﺑ ﻪﻟﺎﻧ ﺯﺍ ﺖﺳﺩ ﺖﻗﻭ ﭻﯿﻫ ﻭ ﻪﻧﺰﺑ ﺮﻏ ﻩﺪﻠﺑ ﻂﻘﻓ ﻪﮐ «ﻦﻣ» ﺯﺍ ﻪﻧﻭﺪﯾ"}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "،ﻪﯿﺷﻮﮕﯾﺯﺎﺑ ﻭ ﺖﻨﻄﯿﺷ ﻖﺷﺎﻋ ﻪﮐ «ﻦﻣ» ﺯﺍ ﻪﻧﻭﺪﯾ"}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "...ﻪﻨﮐ ﺖﯾﺫﺍ ﻭﺭ ﻥﺍﺮﮕﯾﺩ ﻩﺭﺍﺩ ﺖﺳﻭﺩ ﻭ ﻪﻔﯿﻌﺿ ﺵﺍ ﻪﻈﻓﺎﺣ ﻪﮐ «ﻦﻣ» ﺯﺍ ﻪﻧﻭﺪﯾ"}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "...ﻪﯿﻧﻻﻮﻃ ﺶﺘﺳﺮﻬﻓ"}
{"category": "LocationDialogue Location10", "line_index": 118, "text": ".ﺩﺎﯿﻣ ﺕﺩﺎﯾ ﯽﭼ ﻮﮕﺑ ﻢﻬﺑ"}
{"category": "LocationDialogue Location10", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 120, "text": ".ﺩﻮﺑ ﮏﯾﺭﺎﺗ"}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "ﺩﻮﺑ ﻩﺪﺷ ﻪﺘﺷﻮﻧ ﯼﺰﯿﭼ ﻪﯾ"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "...ﻞﺜﻣ"}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "\".ﻦﻣ ﺎﺑ ﻦﮐ ﯼﺯﺎﺑ\""}
{"category": "LocationDialogue Location10", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "،ﻩﺁ"}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "...ﻩﺪﻨﻨﮐﺪﯿﻣﺍﺎﻧ ﻪﭼ"}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "ﻪﻨﮐ ﯽﻣ ﺖﯾﺫﺍ ﻪﮐ ﻪﯿﻧﻮﻤﻫ \"ﻦﻣ\" ﻥﻭﺍ"}
{"category": "LocationDialogue Location10", "line_index": 128, "text": ".ﻪﻨﮐ ﯽﻣ ﺵﻮﻣﺍﺮﻓ ﻭﺭ ﺍﺰﯿﭼ ﻪﻤﻫ ﻭ"}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// Mita wants to tell you [No]"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "ﯼﺯﺎﯿﻧ ﯽﻟﻭ ﻥﻮﻨﻤﻣ"}
