{"category": "LocationDialogue Location3", "line_index": 175, "text": "؟ﻡﺮﺑ ﻪﺳﺭﺪﻣ ﻪﺑ "}
{"category": "LocationDialogue Location3", "line_index": 176, "text": ".ًﺎﻠﺻﺍ "}
{"category": "LocationDialogue Location3", "line_index": 177, "text": ".ﻡﺭﺍﺩ ﺖﺳﻭﺩ ﻭﺭ ﺶﺳﺎﺒﻟ ﺎﻣﺍ "}
{"category": "LocationDialogue Location3", "line_index": 178, "text": "؟ﻢﺸﯿﻣ ﮓﻨﺸﻗ ﺵﻮﺗ ﻪﻛ  ﯽﻨﻜﯿﻤﻧ ﺮﻜﻓ "}
{"category": "LocationDialogue Location3", "line_index": 179, "text": "؟ ﺖﺴﯿﻧ ىﺭﻮﻄﻨﯾﺍ "}
{"category": "LocationDialogue Location3", "line_index": 180, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 181, "text": "// PC"}
{"category": "LocationDialogue Location3", "line_index": 182, "text": "؟ﻪﻨﻜﯿﻣ ﺭﺎﻛ  ﺮﺗﻮﯿﭙﻣﺎﻛ  "}
{"category": "LocationDialogue Location3", "line_index": 183, "text": "؟ﻩﺰﯿﻣ ىﻭﺭ ِﺭﻮﻛ ﺩ ﻂﻘﻓ ﺎﯾ "}
{"category": "LocationDialogue Location3", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 185, "text": "!ﻪﻨﻜﯿﻣ ﺭﺎﻛ  ﻪﻜﺘﺒﻟﺍ "}
{"category": "LocationDialogue Location3", "line_index": 186, "text": "ﺎﺠﻨﯾﺍ ﺰﯿﭼ ﻪﻤﻫ "}
{"category": "LocationDialogue Location3", "line_index": 187, "text": ".ﻪﻨﻜﯿﻣ ﺭﺎﻛ  ﺎﻤﺷ ىﺎﯿﻧﺩ ﻞﺜﻣ ًﺎﻘﯿﻗﺩ "}
{"category": "LocationDialogue Location3", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 189, "text": "،ﻦﻣ ىﺎﯿﻧﺩ ﻮﺗ "}
{"category": "LocationDialogue Location3", "line_index": 190, "text": "...ﻢﻨﯿﺸﯿﻣ ﺮﺗﻮﯿﭙﻣﺎﻛ  ىﺎﭘ ﺩﺎﯾﺯ ﻦﻣ "}
{"category": "LocationDialogue Location3", "line_index": 191, "text": ".ﻢﻨﻜﯿﻣ ﺭﺎﻛ  ﺖﺨﺳ ﻭ "}
{"category": "LocationDialogue Location3", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 193, "text": ".ﻢﻧﻭﺪﯿﻣ "}
{"category": "LocationDialogue Location3", "line_index": 194, "text": "ﺕﺭﺎﻛ  ﺮﻃﺎﺨﺑ "}
{"category": "LocationDialogue Location3", "line_index": 195, "text": "ﻦﻣ ﻪﺑ ﺭﺪﻘﻧﻭﺍ"}
{"category": "LocationDialogue Location3", "line_index": 196, "text": ".ﯼﺩﺮﮑﻧ ﻪﺟﻮﺗ"}
{"category": "LocationDialogue Location3", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 198, "text": "ﯽﻧﻭﺭﺬﮕﺑ ﻭﺭ ﯽﮔﺪﻧﺯ ﺪﯾﺎﺑ "}
{"category": "LocationDialogue Location3", "line_index": 199, "text": "؟ﻡﺮﺗﻮﯿﭙﻣﺎﻛ  ىﺎﭘ ﺩﺎﯾﺯ ﻦﻣ ﻪﻛ  ﯽﻧﻭﺪﯿﻣ ﺭﻮﻄﭼ …ﺎﻣﺍ "}
{"category": "LocationDialogue Location3", "line_index": 200, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 201, "text": ".ﻪﺸﯿﻣ ﻦﺷﻭﺭ ﺎﻬﺘﻗﻭ ﯽﻀﻌﺑ ...ﺖﯿﺷﻮﮔ ﻦﯿﺑﺭﻭﺩ "}
