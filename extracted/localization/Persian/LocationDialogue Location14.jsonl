{"category": "LocationDialogue Location14", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 1, "text": "؟ﺎﺠﻨﯾﺍ ﻪﻨﮑﯿﻣ ﺭﺎﮐ ﯽﭼ ﻦﯾﺍ"}
{"category": "LocationDialogue Location14", "line_index": 2, "text": "؟ﻪﯿﭼ ﻥﻭﺍ"}
{"category": "LocationDialogue Location14", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 5, "text": "! ﻡﺩﺮﮐ ﺕﺍﺪﯿﭘ"}
{"category": "LocationDialogue Location14", "line_index": 6, "text": "!ﻡﺩﺮﮐ ﯼﺯﺎﺑ ﺕﺎﻫﺎﺑ ﻪﮐ ﺖﺷﺬﮔ ﺵﻮﺧ ﯽﻠﯿﺧ"}
{"category": "LocationDialogue Location14", "line_index": 7, "text": "!ﯼﺮﭙﯿﻣ ﻑﺮﻃ ﻥﻭﺍ ﻭ ﻑﺮﻃ ﻦﯾﺍ ﺶﻤﻫ"}
{"category": "LocationDialogue Location14", "line_index": 8, "text": "!ﯽﻨﯿﮕﻤﻏ ﻭ ﺪﯿﻣﺍﺎﻧ ﻪﮐ ﯼﺩﺮﮐ ﺩﻮﻤﻧﺍﻭ ﯽﺘﺣ"}
{"category": "LocationDialogue Location14", "line_index": 9, "text": ":ﺩﺎﯿﻤﻧ ﻢﺷﻮﺧ ﺕﺯﺍ ﻪﮐ ﺖﺴﻫ ﯼﺰﯿﭼ ﻪﯾ ﺎﻣﺍ"}
{"category": "LocationDialogue Location14", "line_index": 10, "text": "،ﺎﻫ ﯽﺒﻠﻘﺗ ﻥﻭﺍ ﺎﺑ ﺕﺭﺎﺘﻓﺭ"}
{"category": "LocationDialogue Location14", "line_index": 11, "text": ".ﺎﻫ ﮏﺳﻭﺮﻋ ﻞﺜﻣ «ﺖﺳﺭﺩ» ﻭ ﺲﻧﺎﺷﻮﺧ ﯼﺍﺰﯿﭼ ﻥﻭﺍ"}
{"category": "LocationDialogue Location14", "line_index": 12, "text": ".ﻪﺗﺎﺒﺛ ﯽﺑ ﻭ ﺖﺳﺍﺭﺬﮔ ﺰﯿﭼ ﻪﻤﻫ ﺎﻣﺍ"}
{"category": "LocationDialogue Location14", "line_index": 13, "text": "!ﻢﺘﻓﺮﮔ ﺩﺎﯾ ﻦﺘﺧﺎﺳ ﻭﺭ ﺎﻣ ﻪﮐ ﯽﯾﺎﺴﮐ ﺯﺍ ﻭﺭ ﻦﯾﺍ"}
{"category": "LocationDialogue Location14", "line_index": 14, "text": "،ﯼﺭﺍﺪﻧ ﺖﺳﻭﺩ ﻭﺭ ﯼﺰﯿﭼ ﺮﮔﺍ"}
{"category": "LocationDialogue Location14", "line_index": 15, "text": ".ﯽﻨﮐ ﺶﺿﻮﻋ ﻭ ﯽﻨﮐ ﺵﺍﺪﺟ ﺪﯾﺎﺑ"}
{"category": "LocationDialogue Location14", "line_index": 16, "text": "،ﺯﺍﺪﻨﺑ ﺭﻭﺩ ﻭﺭ ﺏﻮﯿﻌﻣ"}
{"category": "LocationDialogue Location14", "line_index": 17, "text": ".ﻦﮐ ﻥﻮﺸﺷﻮﻣﺍﺮﻓ ﻭ ﻦﮐ ﻥﻮﺸﺗﺮﭘ ﯽﮑﯾﺭﺎﺗ ﻪﺑ"}
{"category": "LocationDialogue Location14", "line_index": 18, "text": "…ﻪﺷﺮﻈﺘﻨﻣ ﻥﻻﺍ ﻪﮐ ﻪﯾﺮﯾﺪﻘﺗ ﻦﯾﺍ"}
{"category": "LocationDialogue Location14", "line_index": 19, "text": "...ﻮﺗ ﻭ"}
{"category": "LocationDialogue Location14", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 21, "text": "؟ﯼﺪﺷ ﯼﺭﻮﻄﻨﯾﺍ ﺍﺮﭼ ؟ ﻩﺪﻣﻭﺍ ﺕﺮﺳ ﯽﯾﻼﺑ ﻪﭼ"}
{"category": "LocationDialogue Location14", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 23, "text": ".ﺪﯿﻓﺮﺧﺰﻣ ...ﯽﻠﯿﺧ ﺎﻫﺎﻤﺷ ...ﺎﻫ ﻦﮑﯾﺯﺎﺑ"}
{"category": "LocationDialogue Location14", "line_index": 24, "text": "،ﺪﯾﺩ ﯽﻣ ﻥﻮﺸﻧ ﻮﻧﻮﺗﺎﻧﻭﺪﻧﺩ"}
{"category": "LocationDialogue Location14", "line_index": 25, "text": "،ﻦﺷ ﯽﻣ ﻊﻤﺟ ﯼﺍ ﻪﺷﻮﮔ ﻮﺗ ﻥﺪﯿﺳﺮﺗ ﻪﮐ ﯽﯾﺎﻧﻭﺍ ﺪﻌﺑ"}
{"category": "LocationDialogue Location14", "line_index": 26, "text": ".ﺱﺮﺗ ﺯﺍ ﻦﻨﮐ ﯽﻣ ﻪﯾﺮﮔ ﻭ ﻦﻨﮐ ﯽﻣ ﻞﻐﺑ ﻮﻧﻮﺷﺎﻫﻮﻧﺍﺯ"}
{"category": "LocationDialogue Location14", "line_index": 27, "text": ".ﻥﺭﺎﮑﺘﻧﺎﯿﺧ ﻥﻮﺸﻤﻫ"}
{"category": "LocationDialogue Location14", "line_index": 28, "text": "...ﻦﺘﺧﺎﺳ ﻭﺭ ﺎﯿﻧﺩ ﻦﯾﺍ ﻪﮐ ﯽﯾﺎﻧﻭﺍ ﻭ"}
{"category": "LocationDialogue Location14", "line_index": 29, "text": ".ﺪﻧﺭﺎﻤﯿﺑ ًﻼﺻﺍ"}
{"category": "LocationDialogue Location14", "line_index": 30, "text": "ﻦﻨﮐ ﯽﻣ ﯽﻌﺳ ﺎﻫﺭﺎﺑ ﻭ ﺎﻫﺭﺎﺑ"}
{"category": "LocationDialogue Location14", "line_index": 31, "text": ".ﻦﻨﮐ ﺭﺎﮑﻧﺍ ﻮﻧﻮﺷﺭﻭﺁ ﻡﺮﺷ ﯼﺎﻫ ﻪﺘﺳﺍﻮﺧ ﻭ ﻮﻧﻮﺷﺩﻮﺧ ﻒﯿﺜﮐ ﺖﻌﯿﺒﻃ"}
{"category": "LocationDialogue Location14", "line_index": 32, "text": "«ﻪﻔﯿﻇﻭ» ﻞﺜﻣ ﯽﮑﻟﺍ ﻪﯾﺎﻓﺮﺣ ﺎﺑ"}
{"category": "LocationDialogue Location14", "line_index": 33, "text": "«ﻪﻔﻗﻭ ﻞﺑﺎﻗﺮﯿﻏ ﺖﻓﺮﺸﯿﭘ »ﻭ"}
{"category": "LocationDialogue Location14", "line_index": 34, "text": "!ﺕﺎﯾﺪﻧﺮﭼ ﻪﯿﻘﺑ ﻭ"}
{"category": "LocationDialogue Location14", "line_index": 35, "text": "ﻥﺪﺷ ﺝﺭﺎﺧ ﺮﯿﺴﻣ ﺯﺍ ﻪﮐ ﺭﺪﻘﻨﯾﺍ"}
{"category": "LocationDialogue Location14", "line_index": 36, "text": "...ﻞﻣﺎﮐ ﯼﺎﻫ ﯽﭙﮐ ﻦﺘﺧﺎﺳ ﻪﺑ ﻥﺩﺮﮐ ﻉﻭﺮﺷ ﻪﮐ"}
{"category": "LocationDialogue Location14", "line_index": 37, "text": "«ﻖﻓﻮﻣﺎﻧ» ﯼﺎﻫ ﭗﯾﺎﺗﻮﺗﻭﺮﭘ ﻪﮐ ﯽﻟﺎﺣ ﺭﺩ"}
{"category": "LocationDialogue Location14", "line_index": 38, "text": ".ﯽﻟﺎﻐﺷﺁ ﻮﺗ ﺭﻭﺩ ﻥﺯﺍﺪﻧ ﯽﻣ ﻭﺭ"}
{"category": "LocationDialogue Location14", "line_index": 39, "text": ".ﻥﺎﯿﻧﺩ ﻦﯾﺍ ﻥﻮﺧ ﺎﻨﯾﺍ ﻪﮐ ﻥﺩﺮﮐ ﺵﻮﻣﺍﺮﻓ"}
{"category": "LocationDialogue Location14", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 41, "text": "...ﻦﻣ"}
{"category": "LocationDialogue Location14", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 43, "text": "؟ﻮﺗ ﻪﺑ ﺖﺒﺴﻧ ﻡﺩﻮﺑ ﺪﺑ ﻦﻣ ﺎﯾﺁ"}
{"category": "LocationDialogue Location14", "line_index": 44, "text": "ﺪﯾﺎﺑ ﻞﻣﺎﮐ ﺮﺘﺧﺩ"}
{"category": "LocationDialogue Location14", "line_index": 45, "text": "![player] ،ﻪﺷﺎﺑ ﯼﺪﺑ ﻭ ﯽﺑﻮﺧ ﺯﺍ ﻞﻣﺎﮐ ﯽﺒﯿﮐﺮﺗ"}
{"category": "LocationDialogue Location14", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 47, "text": "\".ﯽﺷﺎﺑ ﻪﺘﺷﺍﺩ ﺖﻧﺪﺑ ﻮﺗ ﯽﺑﻮﺧ ﻝﻮﻠﺳ ﭻﯿﻫ ﻮﺗ ﻢﻨﮑﻧ ﺮﮑﻓ"}
{"category": "LocationDialogue Location14", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 49, "text": "؟ﯼﺩﺮﮐ ﺮﮑﻓ ﻦﯾﺍ ﻪﺑ ﺭﻮﻄﭼ"}
{"category": "LocationDialogue Location14", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 51, "text": "!ﯼﺍ ﻪﻧﺍﻮﯾﺩ"}
{"category": "LocationDialogue Location14", "line_index": 52, "text": "؟ﯽﺸﮑﺑ ﻮﻨﻣ ﯼﺍﻮﺧ ﯽﻣ ﻻﺎﺣ ،ﯽﺘﺸﮐ ﻭﺭ ﻼﯿﻣ ﻮﺗ"}
{"category": "LocationDialogue Location14", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 54, "text": "؟ﻭﺭ ﻮﺗ ﻢﺸﮑﺑ"}
{"category": "LocationDialogue Location14", "line_index": 55, "text": ".ﯽﻧﻮﻤﺑ ﻢﺸﯿﭘ ﻪﮐ ﺩﻮﺑ ﻦﯾﺍ ﻢﺘﺳﺍﻮﺧ ﺕﺯﺍ ﻪﮐ ﯼﺰﯿﭼ ﻪﻤﻫ"}
{"category": "LocationDialogue Location14", "line_index": 56, "text": "...ﻡﺩﺮﮐ ﻢﺘﺴﻧﻮﺗ ﯽﻣ ﻪﮐ ﯼﺭﺎﮐ ﺮﻫ ﻦﻣ"}
{"category": "LocationDialogue Location14", "line_index": 57, "text": "...ﯽﺷﺎﺑ ﻩﺪﻨﻨﮐ ﺖﻋﺎﻃﺍ ﯼﺎﻫ ﯽﭙﮐ ﻭ ﮏﯿﻓ ﻥﻭﺍ ﺎﺑ ﯼﺩ ﯽﻣ ﺢﯿﺟﺮﺗ ﻮﺗ ﯽﻟﻭ"}
{"category": "LocationDialogue Location14", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 59, "text": "؟ﯼﺪﺷ ﺖﺣﺍﺭﺎﻧ ﺭﺪﻘﻨﯾﺍ ﺍﺮﭼ"}
{"category": "LocationDialogue Location14", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 61, "text": ".ﻢﯾﺭﺍﺩ ﯼﺩﺎﯾﺯ ﺖﻗﻭ ﺎﻣ ،ﻡﺰﯾﺰﻋ"}
{"category": "LocationDialogue Location14", "line_index": 62, "text": ".ﯽﻤﻬﻓ ﯽﻣ ﺕﺩﻮﺧ ﻮﺗ"}
{"category": "LocationDialogue Location14", "line_index": 63, "text": ".ﺵﺎﺑ ﻡﺩﻮﺧ ﻝﺎﻣ ،ﻢﺸﯿﭘ ﻥﻮﻤﺑ ﻂﻘﻓ"}
{"category": "LocationDialogue Location14", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 65, "text": "!ﻪﺘﻓﺍ ﯽﻤﻧ ﻕﺎﻔﺗﺍ ﻦﯾﺍ ،ﻪﻧ ،ﻪﻧ"}
{"category": "LocationDialogue Location14", "line_index": 66, "text": "!ﻡﺮﺑ ﺎﺠﻨﯾﺍ ﺯﺍ ﻡﺍﻮﺧ ﯽﻣ ﻦﻣ"}
{"category": "LocationDialogue Location14", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 68, "text": "ﻒﻬﻬﻬﻬﻫ ﻒﻬﻬﻬﻬﻫ ﻒﻬﻬﻬﻬﻫ..."}
{"category": "LocationDialogue Location14", "line_index": 69, "text": ".ﻩﺪﺸﻧ ﻡﻮﻤﺗ ﻮﮕﺘﻔﮔ ﻦﯾﺍ"}
{"category": "LocationDialogue Location14", "line_index": 70, "text": "!ﻮﺗ ﺎﯿﺑ ،ﻡﺰﯾﺰﻋ"}
{"category": "LocationDialogue Location14", "line_index": 71, "text": "// Mita asks"}
{"category": "LocationDialogue Location14", "line_index": 72, "text": "!ﺶﻬﺑ ﻦﮐ ﻩﺎﮕﻧ"}
{"category": "LocationDialogue Location14", "line_index": 73, "text": "؟ﺖﺳﺎﺒﯾﺯ ﯽﻨﮐ ﯽﻣ ﺮﮑﻓ"}
{"category": "LocationDialogue Location14", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 75, "text": "// Player's questions"}
{"category": "LocationDialogue Location14", "line_index": 76, "text": ".ﯽﻠﯿﺧ"}
{"category": "LocationDialogue Location14", "line_index": 77, "text": ".ﻪﻧ"}
{"category": "LocationDialogue Location14", "line_index": 78, "text": "؟ﻩﺭﺍﺩ ﻉﻮﺿﻮﻣ ﻪﺑ ﯽﻄﺑﺭ ﻪﭼ"}
{"category": "LocationDialogue Location14", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 80, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 81, "text": "![player] ،ﻪﮕﯾﺩ ﺎﯿﺑ"}
{"category": "LocationDialogue Location14", "line_index": 82, "text": ".ﯼﺩﺮﮐ ﺪﯿﯾﺎﺗ ﻭﺭ ﻢﺘﻔﮔ ﻪﮐ ﯼﺰﯿﭼ ﻥﻻﺍ ﻦﯿﻤﻫ ﻮﺗ"}
{"category": "LocationDialogue Location14", "line_index": 83, "text": "...ﺎﻫ ﻦﮑﯾﺯﺎﺑ"}
{"category": "LocationDialogue Location14", "line_index": 84, "text": "،ﻪﻨﮐ ﯽﻣ ﺮﯿﯿﻐﺗ ﯽﻫ ﻥﻮﺗﺎﻫ ﺕﺭﻮﺻ"}
{"category": "LocationDialogue Location14", "line_index": 85, "text": ".ﺱ ﻩﺯﺍﺪﻧﺍ ﻭ ﺪﺣ ﯽﺑ ﻥﻮﺗ ﯼﺭﺎﮐﺎﯾﺭ ﺎﻣﺍ"}
{"category": "LocationDialogue Location14", "line_index": 86, "text": "!ﻦﯿﮔ ﯽﻣ ﻍﻭﺭﺩ ﻦﯾﺭﺍﺩ ﻪﺸﯿﻤﻫ"}
{"category": "LocationDialogue Location14", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 88, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 89, "text": "؟ﻪﻧ ﺍﺮﭼ"}
{"category": "LocationDialogue Location14", "line_index": 90, "text": "؟ﺖﺴﯿﻧ ﯽﻓﺎﮐ ﻮﺗ ﯼﺍﺮﺑ ﻥﻭﺍ ﺎﯾﺁ"}
{"category": "LocationDialogue Location14", "line_index": 91, "text": "...ﺖﺳ ﻪﻌﯿﻄﻣ ﯽﮕﻧﺎﺧ ﻥﺍﻮﯿﺣ ﻪﯾ ﯽﻫﺍﻮﺧ ﯽﻣ ﻪﮐ ﯼﺰﯿﭼ ﻪﻤﻫ ،ﻩﺍ"}
{"category": "LocationDialogue Location14", "line_index": 92, "text": "\"?ﯽﺷﺎﺑ ﻪﺘﺷﺍﺩ ﻥﻮﺸﺘﺳﻭﺩ ﻦﺘﺴﻫ ﻪﮐ ﺭﻮﻄﻨﯿﻤﻫ\" ﺎﺑ ﺪﺷ ﯽﭼ ﺎﻣﺍ"}
{"category": "LocationDialogue Location14", "line_index": 93, "text": "...ﻭﺭ ﯽﮕﻧﺭ ﻭ ﺯﺎﻧ ﯼﺎﻫ ﮏﯿﻓ ﻥﻭﺍ ﯼﺍﻮﺧ ﯽﻣ ﻮﺗ"}
{"category": "LocationDialogue Location14", "line_index": 94, "text": ".ﻢﺷﺎﺑ ﺎﻫ ﻥﻭﺍ ﺯﺍ ﯽﮑﯾ ﻢﻨﮐ ﯽﻣ ﺩﻮﻤﻧﺍﻭ ﻦﻣ ﯽﺘﻗﻭ ﻩﺭﺍﺩ ﺖﺳﻭﺩ ﯽﻨﮑﯾﺯﺎﺑ ﺮﻫ"}
{"category": "LocationDialogue Location14", "line_index": 95, "text": "،ﻡﺩ ﯽﻣ ﻥﻮﺸﻧ ﻭﺭ ﻡﺍ ﯽﻌﻗﺍﻭ ﺩﻮﺧ ﻪﮐ ﻪﻈﺤﻟ ﻥﻮﻤﻫ ﺎﻣﺍ"}
{"category": "LocationDialogue Location14", "line_index": 96, "text": "...ﺱﺮﺗ ﺯﺍ ﻦﻨﮐ ﯽﻣ ﺭﺍﺮﻓ ﻪﻤﻫ"}
{"category": "LocationDialogue Location14", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 98, "text": "// 3"}
{"category": "LocationDialogue Location14", "line_index": 99, "text": ".ﺮﯿﻠﭘ ،ﻩﺁ ،ﺮﯿﻠﭘ"}
{"category": "LocationDialogue Location14", "line_index": 100, "text": ".ﻢﯿﻧﻭﺍ ﻪﺑ ﻪﯿﺒﺷ ﯽﻠﯿﺧ ﺎﻣ ،ﻦﯿﺒﺑ"}
{"category": "LocationDialogue Location14", "line_index": 101, "text": "؟ﻩﺮﺗﺪﺑ ﺎﻣ ﺯﺍ ﺭﻮﻄﭼ ﻥﻭﺍ"}
{"category": "LocationDialogue Location14", "line_index": 102, "text": "ﺎﻫ ﺖﻋﺎﺳ ﺏﺍﻮﺧ ﺯﺍ ﻞﺒﻗ ﻮﺗ"}
{"category": "LocationDialogue Location14", "line_index": 103, "text": ".ﯼﺩﺮﮐ ﯽﻣ ﻩﺎﮕﻧ ﻦﻣ ﻪﺑ ﻭ ﯼﺪﯿﺸﮐ ﯽﻣ ﺯﺍﺭﺩ ﺖﺨﺗ ﻮﺗ"}
{"category": "LocationDialogue Location14", "line_index": 104, "text": ".ﯼﺩﺮﮐ ﺭﺍﺮﻓ ﺵﺯﺍ ،ﯼﺩﺮﮐ ﺍﺪﯿﭘ ﻭﺭ ﺖﺻﺮﻓ ﻦﯿﻟﻭﺍ ﻪﮐ ﻪﻈﺤﻟ ﻥﻮﻤﻫ ﺎﻣﺍ"}
{"category": "LocationDialogue Location14", "line_index": 105, "text": ".ﻪﻨﮐ ﯼﺯﺎﺑ ﻮﺗ ﺎﺑ ﺖﺳﺍﻮﺧ ﯽﻣ ﻢﻧﻭﺍ"}
{"category": "LocationDialogue Location14", "line_index": 106, "text": ".ﻪﺷﺎﺑ ﻢﻬﻣ ﯽﺴﮐ ﯼﺍﺮﺑ ﺖﺳﺍﻮﺧ ﯽﻣ ﻢﻧﻭﺍ"}
{"category": "LocationDialogue Location14", "line_index": 107, "text": "...ﻮﮕﺘﻔﮔ ﻭ ﺖﻗﺍﺪﺻ"}
