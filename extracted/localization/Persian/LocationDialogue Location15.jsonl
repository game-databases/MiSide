{"category": "LocationDialogue Location15", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "!ﯽﺘﺴﻫ ﺎﺠﻨﯾﺍ"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "؟ﯽﺘﻓﺭ ﻪﺘﺴﻫ ﺯﺍ ﺍﺮﭼ"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "!ﯽﻧﻮﻤﺑ ﺮﻈﺘﻨﻣ ﻢﺘﻔﮔ"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "...ﻪﺸﮐ ﯽﻣ ﻝﻮﻃ ﺮﺘﺸﯿﺑ ﻡﺩﺮﮐ ﺮﮑﻓ"}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "...ﺐﺧ ﯽﻠﯿﺧ ،ﺏﻮﺧ"}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "...ﻡﺩﺮﮐ ﺍﺪﯿﭘ ﯼﺰﯿﭼ ﻢﻨﮐ ﯽﻣ ﺮﮑﻓ"}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "...ﺖﺴﻫ ﺲﮐﺪﻧﺍ ﻪﯾ ًﻻﺎﻤﺘﺣﺍ"}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "!ﻪﻧ ﺎﯾ ﻪﻨﮐ ﯽﻣ ﺭﺎﮐ ﻢﯿﻨﯿﺒﺑ ﺪﯾﺎﺑ"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": ".ﻥﻭﺮﯿﺑ ﻢﯾﺮﺑ"}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "...ﻪﻧﺍﻮﯾﺩ ﯼﺎﺘﯿﻣ"}
{"category": "LocationDialogue Location15", "line_index": 13, "text": ".ﻩﺪﯾﺪﺟ ﻦﮑﯾﺯﺎﺑ ﻪﯾ ﻝﻮﻐﺸﻣ ﻢﻨﮐ ﺮﮑﻓ"}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "...ﻪﻨﯿﺒﻧ ﻭﺭ ﺎﻣ ﻪﮐ ﻪﺷﺎﺑ ﻝﻮﻐﺸﻣ ﯽﻠﯿﺧ ﻡﺭﺍﻭﺪﯿﻣﺍ ﺲﭘ"}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "؟ﺎﺘﯿﻣ"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": ".ﻥﻮﻤﺑ ﻡﺮﻈﺘﻨﻣ"}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "؟ﯽﺘﺧﺍﺪﻧﺍ ﯼﺰﯿﭼ"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "!ﺶﯾﺪﯾﺩ ﻩﺭﺎﺑﻭﺩ"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "...ﺎﺘﯿﻣ"}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "!ﯽﺘﻓﺮﮔ"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "...ﺭﻮﻄﭼ"}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "؟ﯽﺘﺴﻫ ﯽﮐ ﻮﺗ"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "!ﯼﺍ ﻩﺪﻧﺯ ﻮﺗ ...ﻮﺗ"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "؟ﻪﺗﺩﺎﯾ"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "؟ﻢﺳﺎﻨﺷ ﯽﻣ ﻭﺭ ﻮﺗ ﻦﻣ"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "...ﻩﺮﺒﺧ ﻪﭼ"}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "؟ﻢﻨﮐ ﺭﺎﮑﯿﭼ ﺪﯾﺎﺑ ﻥﻻﺍ"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "...ﻡﺮﺑ ﻥﻭﺮﯿﺑ ﻢﻧﻮﺘﯿﻤﻧ"}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "؟ﻪﯿﭼ \"ﻦﺘﻓﺭ ﻥﻭﺮﯿﺑ\" ﺯﺍ ﺕﺭﻮﻈﻨﻣ"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "...ﻦﮐ ﺮﺒﺻ"}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "...ﺖﺳ ﻪﻘﻠﺣ ﻥﻭﺍ"}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "؟ﻥﻭﺍ ﻭ"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": ".ﻪﯿﭼ ﻪﮐ ﻡﺭﺍﺪﻧ ﯼﺍ ﻩﺪﯾﺍ ﭻﯿﻫ"}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "!ﻪﺴﮐﺪﻨﯾﺍ ﻪﯾ ﻦﯾﺍ"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "!ﯼﺩﺮﮐ ﺵﺍﺪﯿﭘ ﻮﺗ"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": "\"ﻢﻨﮐ ﻪﯾﺮﮔ ﺩﻮﺑ ﮏﯾﺩﺰﻧ ﺎﻌﻗﺍﻭ ﺖﻤﺴﻗ ﻦﯾﺍ ﻪﻤﺟﺮﺗ ﻊﻗﻮﻣ\""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": ".ﻢﮕﺑ ﯽﭼ ﻢﻧﻭﺪﯿﻤﻧ"}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": ".ﻢﯾﺩﺮﮔﺮﺑ ﻪﺘﺴﻫ ﻪﺑ ﺪﯾﺎﺑ ﺎﻣ"}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "...ﻮﺗ ﻭ"}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "...ﯼﺎﯿﺑ ﻦﻣ ﺎﺑ ﻪﮐ ﻩﺮﺘﻬﺑ ﺪﯾﺎﺷ"}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "؟ﻩﺍ"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "...ﻪﺷﺎﺑ"}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": ".ﻥﻮﻤﺑ ﺮﻈﺘﻨﻣ ﺎﺠﻨﯾﺍ"}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": ".ﻥﺎﻫﺁ"}
{"category": "LocationDialogue Location15", "line_index": 64, "text": ".ﻢﻨﯿﺸﻧ ﯽﻣ ﺎﺠﻨﯿﻤﻫ ﻦﻣ"}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "...ﯽﺘﻨﻌﻟ"}
{"category": "LocationDialogue Location15", "line_index": 68, "text": ".ﺩﻮﺑ ﮏﯾﺩﺰﻧ ﺎﻌﻗﺍﻭ"}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "؟ﻢﯾﺩﺍﺩ ﻡﺎﺠﻧﺍ ﻭﺭﺎﮐ ...ﺐﺧ"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": ".ﺏﻮﺧ"}
{"category": "LocationDialogue Location15", "line_index": 71, "text": ".ﻢﺘﺴﻫ ﯽﺘﺳﺭﺩ ﻪﺨﺴﻧ ﻮﺗ ﻦﻣ"}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "!ﻡﻼﺳ"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "؟ﻪﻧ ،ﯽﻨﮑﯾﺯﺎﺑ ﻪﯾ ﻮﺗ"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "؟ﻪﯿﭼ ﺖﻤﺳﺍ"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "...ﻡﺮﺑ ﺎﺠﻨﯾﺍ ﺯﺍ ﻡﺍﻮﺧ ﯽﻣ ﻦﻣ"}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "؟ﯼﺮﺑ ﯼﺍﻮﺧ ﯽﻣ ﺩﻭﺯ"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "؟ﯼﺪﯿﺳﺭ ﺎﺠﻨﯾﺍ ﻪﺑ ًﻼﺻﺍ ﺭﻮﻄﭼ"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "...ﺏﻮﺧ ﻩﺁ"}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "...ﯼﺮﺑ ﯽﻧﻮﺗ ﯽﻣ ،ﻪﺷﺎﺑ"}
{"category": "LocationDialogue Location15", "line_index": 84, "text": ".ﻦﮐ ﻥﺎﺤﺘﻣﺍ ﻭﺭﺩ ﻂﻘﻓ"}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "!ﯽﺷﺎﺑ ﻖﻓﻮﻣ"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "؟ﺭﺍﻮﯾﺩ"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": ".ﺖﺴﯿﻧ ﺖﺳﺭﺩ ﻦﯾﺍ ،ﻢﻤﻤﻫ"}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "...ﺪﯾﺎﺷ"}
{"category": "LocationDialogue Location15", "line_index": 91, "text": ".ﻪﻨﮐ ﮏﻤﮐ ﺖﻬﺑ ﻪﮐ ﻪﺷﺎﺑ ﻦﯿﻣﺯﺮﯾﺯ ﯼﻮﺗ ﯼﺰﯿﭼ"}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "ﻡﺩﺮﮐ ﻒﺸﮐ ًﺍﺮﯿﺧﺍ"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "...ﺖﺴﻫ ﻡﺪﻤﮐ ﯼﻮﺗ ﺭﺩ ﻪﯾ"}
{"category": "LocationDialogue Location15", "line_index": 94, "text": ".ﻩﺮﯿﻣ ﻦﯿﻣﺯﺮﯾﺯ ﻪﯾ ﻪﺑ ﻪﮐ ﺪﺷ ﻡﻮﻠﻌﻣ ﻭ"}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "،ﺖﺳ ﻪﻟﺎﺑﺯ ﺯﺍ ﺮﭘ ﯽﻟﻭ"}
{"category": "LocationDialogue Location15", "line_index": 96, "text": ".ﺐﯾﺮﻏ ﻭ ﺐﯿﺠﻋ ﺕﺍﺰﯿﻬﺠﺗ ﻪﻤﻟﺎﻋ ﻪﯾ ﻭ ﻪﻟﺎﺑﺯ"}
{"category": "LocationDialogue Location15", "line_index": 97, "text": ".ﯽﻨﮐ ﺩﺭﺍﻭ ﯼﺰﯿﭼ ﺎﯾ ﺪﮐ ﻪﯾ ﺪﯾﺎﺑ"}
{"category": "LocationDialogue Location15", "line_index": 98, "text": ".ﺵﺯﺍ ﻡﺭﺎﯿﻤﻧ ﺭﺩ ﺮﺳ ﺩﺎﯾﺯ ﻦﻣ"}
{"category": "LocationDialogue Location15", "line_index": 99, "text": ".ﻡﺩ ﯽﻤﻧ ﻢﻫ ﯽﺘﯿﻤﻫﺍ ًﻼﺻﺍ ﻭ"}
{"category": "LocationDialogue Location15", "line_index": 100, "text": ".ﻩﺪﻨﻨﮐ ﺖﺣﺍﺭﺎﻧ ًﺎﻌﻗﺍﻭ ﯽﻨﻌﯾ ،ﺖﺴﻫﺪﻨﻨﮐ ﺖﺣﺍﺭﺎﻧ ﻩﺩﺭﻮﺧ ﻪﯾ ﻦﯿﻨﭽﻤﻫ"}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "؟ﯼﺯﺍﺪﻨﺑ ﯽﻫﺎﮕﻧ ﻪﯾ ﯼﺍﻮﺧ ﯽﻣ"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": ".ﻪﺷﺎﺑ ،ﻩﻭﺍ"}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "ﻢﻨﮑﻧ ﺮﮑﻓ"}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "...ﺩﺎﯿﺑ ﺵﺩﺎﯾ ﯼﺰﯿﭼ ﭻﯿﻫ ﻥﻭﺍ"}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "؟ﻢﯾﺩﺍﺩ ﻡﺎﺠﻧﺍ ﺖﺳﺭﺩ ﻭﺭﺎﮐ ﺎﻣ"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "؟ﻢﯾﺩﺮﮐ ﺶﺗﻮﺒﯾﺭ"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "ﺪﯾﺎﺑ ﻂﻘﻓ ﻦﻣ ﺵﺪﻌﺑ"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "...ﻡﺮﺑ ﻥﻭﺮﯿﺑ ﯽﺘﻨﻌﻟ ﯼﺯﺎﺑ ﻦﯾﺍ ﺯﺍ"}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": ".ﺩﻭﺯ ﺭﺪﻘﻨﯾﺍ ﻪﻧ"}
{"category": "LocationDialogue Location15", "line_index": 115, "text": ".ﻢﻨﮐ ﺖﻠﻐﺑ ﻡﺭﺍﺩ ﺖﺳﻭﺩ"}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "؟ﺎﻫ"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": ".ﺖﻣﺪﯾﺩ ﻢﻟﺎﺤﺷﻮﺧ"}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "...ﺥﺁ"}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "ﺪﺷ ﻒﯿﺣ ﯽﻠﯿﺧ"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "ﻮﺗ ﻭ ﻦﻣ ﻪﮐ"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": ".ﻢﯾﺩﻮﺑ ﻢﻫ ﺎﺑ ﻢﮐ ﺭﺪﻘﻨﯾﺍ"}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "...ﻩﺍ"}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "؟ﯽﮕﯿﻣ ﯽﭼ ﯼﺭﺍﺩ"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "،ﯽﻨﻌﯾ"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "...ﯽﻧﻮﻤﺑ ﻦﻣ ﺶﯿﭘ ﯽﺘﺴﻧﻮﺗ ﯽﻣ"}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "...ﺩﻮﺑ ﻦﻣ ﺮﯿﺼﻘﺗ"}
{"category": "LocationDialogue Location15", "line_index": 132, "text": ".ﺎﻫﺍﺪﺻ ...ﻭ ﺪﻤﮐ ﻥﻭﺍ"}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "!ﻢﺘﺸﮐ ﯽﻣ ﻮﻧﻭﺍ ﺮﺗﺩﻭﺯ ﺪﯾﺎﺑ"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "،ﻦﮐ ﺮﺒﺻ"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "؟...ﻮﺗ ﯽﻨﻌﯾ"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "؟ﯼﺭﺎﯿﺑ ﺕﺩﺎﯾ ﻭﺭﺎﻨﯾﺍ ﯽﻧﻮﺗ ﯽﻣ ﺭﻮﻄﭼ"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "!ﺎﻫ"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "؟ﻪﺸﯿﻣ ﺖﺣﺍﺭ ﺭﺪﻘﻨﯾﺍ ﯼﺩﺮﮐ ﺮﮑﻓ ًﺎﻌﻗﺍﻭ"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "...ﯽﻘﻤﺣﺍ ﻪﯾ ﻂﻘﻓ ﻮﺗ"}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "...ﺎﻫ ﻦﮑﯾﺯﺎﺑ ﯽﻗﺎﺑ ﻞﺜﻣ ًﺎﻘﯿﻗﺩ"}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "،ﻢﯿﺘﻓﺭ ﺶﯿﭘ ﺏﻮﺧ ﺎﻣ"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "!ﻦﮐ ﻩﺎﮕﻧ"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "ﻪﮕﯾﺩ ﻮﺗ \"ﯽﻌﻗﺍﻭ\" ﻥﻭﺍ"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": ".ﺖﺴﯿﻧ ﻪﻣﺯﻻ"}
{"category": "LocationDialogue Location15", "line_index": 147, "text": ".ﯽﻫ ﯽﻫ ،ﺪﯿﺸﺨﺒﺑ"}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "...ﻢﻨﮐ ﺭﻭﺎﺑ ﻢﻧﻮﺗ ﯽﻤﻧ"}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "؟...ﻢﯾﺩﺭﻮﺧ ﺖﺴﮑﺷ ﺎﯾﺁ"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "...ﻢﻨﺌﻤﻄﻣ ،ﻡﺩﺮﮐ ﺕﻮﺒﯾﺭ ﻭﺭ ﻮﺗ ﻦﻣ ...ﻪﻧ"}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "...ﯼﺪﯿﻤﻬﻔﻧ ﺯﻮﻨﻫ"}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "!ﺎﻫ-ﺎﻫ-ﺎﻫ"}
