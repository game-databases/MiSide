{"category": "LocationDialogue Location11", "line_index": 152, "text": ".ﻢﻨﮐ ﯽﻣ ﻝﺮﺘﻨﮐ ﻭﺭ ﺎﻫ ﺶِﮐ ﻞﺑﺎﮐ ﺎﺠﻨﯾﺍ ﻡﺭﺍﺩ"}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "ﯽﻧﻭﺩ ﯽﻣ"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "؟ﯼﺭ ﯽﻣ ﺖﯾﺩﻮﺑﺎﻧ ﺖﻤﺳ ﻪﺑ ﯼﺭﺍﺩ"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "،ﺪﯾﺎﺷ"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": ".ﻡﺭﺍﺩ ﻪﮐ ﻪﯾﺮﯿﺴﻣ ﺎﻬﻨﺗ ﻦﯾﺍ ﺎﻣﺍ"}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "،ًﺎﻘﯿﻗﺩ"}
{"category": "LocationDialogue Location11", "line_index": 160, "text": ".پﻮﺗ ﺖﺸﭘ ﻭﺮﺑ ﻭ ﻩﺪﺑ ﺭﺎﺸﻓ ﻭﺭ ﻪﻤﮐﺩ"}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "؟پﻮﺗ"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "،ﻩﺭﺁ"}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "؟ ﯽﺸﺑ ﺩﺭ ﺎﺠﻨﯾﺍ ﺯﺍ ﺖﺣﺍﺭ ﯽﻧﻮﺘﯿﻣ ﻪﮐ ﯼﺩﺮﮑﯿﻣ ﺮﮑﻓ"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "،ﯽﻨﮐ ﻡﻮﻤﺗ ﻭﺭ Monster-slap ﮏﭼﻮﮐ ﯼﺯﺎﺑ ﻦﯾﺍ ﺪﯾﺎﺑ"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": ".ﮏﯿﻠﺷ ﯼﺍﺮﺑ ﺵﺎﺑ ﻩﺩﺎﻣﺁ ﺲﭘ"}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": ".ﻢﯿﺘﻔﯿﺑ ﻩﺍﺭ ﻪﮐ ﻪﺸﺘﻗﻭ ،ﻪﺘﺳﺭﺩ"}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "!ﺩﻮﺑ ﯽﻟﺎﻋ"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": ".ﯼﺩﺍﺩ ﻡﺎﺠﻧﺍ ﻭﺭ ﺭﺎﮐ ﻦﯾﺍ ﻮﺗ"}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": ".ﻥﻭﺮﯿﺑ ﻭﺮﺑ ،ﯽﻫ"}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "!ﺖﺣﺍﺭ ﻭ ﻊﯾﺮﺳ"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "؟ﯽﯾﺎﺠﻨﯾﺍ ﺯﻮﻨﻫ ﺍﺮﭼ"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": ".ﻥﻭﺮﯿﺑ ﻭﺮﺑ ﻢﺘﻔﮔ"}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "...ﻢﺸﯿﻤﻧ ﻪﺟﻮﺘﻣ ﻦﻣ"}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "؟ ﯼﺩﺎﺘﺴﯾﺍ ﺎﺠﻨﯾﺍ ﻂﻘﻓ ﺍﺮﭼ"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "؟ﻩﺎﮕﺘﺳﺩ ﻪﯾ ؟ﯽﭼ"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "...ﻖﯿﻓﺭ"}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": ".ﻆﻓﺎﺣﺍﺪﺧ"}
