{"category": "LocationDialogue Location1", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 99, "text": "// بدون اسم"}
{"category": "LocationDialogue Location1", "line_index": 100, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 101, "text": ".ﻪﻧ ،ﻩﺁ"}
{"category": "LocationDialogue Location1", "line_index": 102, "text": ".ﻩﺪﯿﻤﻧ ﺏﺍﻮﺟ ﻦﯾﺍ ،ﻪﻧ ﻩﺁ "}
{"category": "LocationDialogue Location1", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 104, "text": "// اسم سازنده بازی"}
{"category": "LocationDialogue Location1", "line_index": 105, "text": "؟ﯽﻨﻛ  ﻩﺩﺎﻔﺘﺳﺍ ﻭﺭ ﻩﺪﻨﻫﺩ ‌ﻪﻌﺳﻮﺗ ﻡﺎﻧ ىﺍﻮﺧ ‌ﯽﻣ ﯽﻨﺌﻤﻄﻣ"}
{"category": "LocationDialogue Location1", "line_index": 106, "text": "…ﯽﻟﻭ ،ﻢﻟﺎﺤﺷﻮﺧ ﯽﻠﯿﺧ "}
{"category": "LocationDialogue Location1", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 108, "text": "//اسم بد "}
{"category": "LocationDialogue Location1", "line_index": 109, "text": ".ﯽﻨﻜﻧ ﺍﺪﺻ ﺭﻮﻄﻨﯾﺍ ﻭﺭ ﺕﺩﻮﺧ ﻡﺪﯿﻣ ﺢﯿﺟﺮﺗ ﺎﻌﻗﺍﻭ "}
{"category": "LocationDialogue Location1", "line_index": 110, "text": ".ﺖﺴﯿﻧ ﻝﺎﺣﺎﺑ ًﺎﻠﺻﺍ "}
{"category": "LocationDialogue Location1", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 112, "text": "// برو از اول اسمتو بنویس"}
{"category": "LocationDialogue Location1", "line_index": 113, "text": ".ﻢﯿﻨﻛ  ﻉﻭﺮﺷ ﻝﻭﺍ ﺯﺍ ﺎﯿﺑ .ﺖﺴﯿﻧ ﺶﻫﺍﺭ ﻦﯾﺍ ،ﻪﻧ"}
{"category": "LocationDialogue Location1", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 115, "text": "//اسم با شماره"}
{"category": "LocationDialogue Location1", "line_index": 116, "text": "؟ﺖﺳﺎﺠﻛ  ﺶﺘﯿﻗﺎﻠﺧ ؟ىﺭ‌ﯽﻣ ﺩﺍﺪﻋﺍ ﺎﺑ ىﺭﺍﺩ ﺲﭘ ،ﺎﻫﺁ "}
{"category": "LocationDialogue Location1", "line_index": 117, "text": "!ﺩﻮﺑ ﺕﺩﻮﺧ ﺏﺎﺨﺘﻧﺍ ،ﺐﺧ "}
