{"category": "LocationDialogue Location1", "line_index": 9, "text": "!ﻡﺎﺘﯿﻣ ﻦﻣ ،ﻡﺎﻠﺳ"}
{"category": "LocationDialogue Location1", "line_index": 10, "text": "؟ ﻪﯿﭼ ﺖﻤﺳﺍ"}
{"category": "LocationDialogue Location1", "line_index": 11, "text": "[player]! ﻢﺘﻗﻭ ﺵﻮﺧ "}
{"category": "LocationDialogue Location1", "line_index": 12, "text": "[player]، ...ﻡﻭﺍ "}
{"category": "LocationDialogue Location1", "line_index": 13, "text": "...ﻩﺪﺷ ﻪﺘﺨﯾﺭ ﻢﻫ ﻪﺑ ﺎﺠﻨﯾﺍ ﺎﻟﺎﺣ ﻭ ،ًﺎﻠﺒﻗ ﻡﺩﺮﻛ  ﻪﻠﺠﻋ ﻢﻛ  ﻪﯾ ﺶﺘﺳﺍﺭ "}
{"category": "LocationDialogue Location1", "line_index": 14, "text": "؟ﻢﯿﻨﻛ  ﺭﻮﺟ ﻭ ﻊﻤﺟ ﻭﺭ ﺎﺠﻨﯾﺍ ﯽﻨﻛ  ﻢﻜﻤﻛ  ﻢﻛ  ﻪﯾ ﻪﺸﯿﻣ "}
{"category": "LocationDialogue Location1", "line_index": 15, "text": "..ﻑﻭﻮﻫ "}
{"category": "LocationDialogue Location1", "line_index": 16, "text": "!ﺕﺯﺍ ﻢﻧﻮﻨﻤﻣ ﯽﻠﯿﺧ "}
{"category": "LocationDialogue Location1", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 18, "text": "... ، [Player] ﻩﺩﺮﮐ ﻒﻌﺿ ﻢﻟﺩ"}
{"category": "LocationDialogue Location1", "line_index": 19, "text": "...ﻪﻤﻨﺸﮔ ﯽﻠﯿﺧ "}
{"category": "LocationDialogue Location1", "line_index": 20, "text": "؟ﻢﻨﮐ ﺍﺪﯿﭘ ﻭ ﻍﺮﻣ ﭖﻮﺳ ﯼﺭﺎﺑ ﻡﺯﻻ ﺩﺍﻮﻣ ﯽﻨﮐ ﮏﻤﮐ ﯽﻧﻮﺘﯿﻣ"}
{"category": "LocationDialogue Location1", "line_index": 21, "text": "!ىﺩﺮﻛ  ﺖﺳﺭﺩ ﻭﺰﯿﭼ ﻪﻤﻫ ! ﻝﻮﯾﺍ "}
{"category": "LocationDialogue Location1", "line_index": 22, "text": "؟ﻢﯿﻨﻛ  ىﺰﭙﺷﺁ ﻢﻫﺎﺑ ﻩﺭﻮﻄﭼ"}
{"category": "LocationDialogue Location1", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 25, "text": "، ﻡﺮﺨﺑ ﻞﻤﺣ ﺏﺎﻗ ﻥﻮﯾﺰﯾﻮﻠﺗ ﻪﻧﻭﺪﯾ ﺯﻭﺮﻣﺍ ﻡﺩﺮﮐ ﯽﻣ ﺮﮑﻓ ﻢﺘﺷﺍﺩ"}
{"category": "LocationDialogue Location1", "line_index": 26, "text": "؟ﻪﯿﭼ ﺕﺮﻈﻧ ،ﻥﻭﺮﯿﺑ ىﺮﺑ ىﺍﻮﺧ ﯽﻣ ﻪﻛ  ﯽﯾﺎﺘﻗﻭ ىﺍﺮﺑ ﻪﯿﻟﺎﻋ .ﻦﺘﻧﺁ ﺎﺑ کﯿﭼﻮﻛ  ﻥﻮﯾﺰﯾﻮﻠﺗ ﻪﯾ "}
{"category": "LocationDialogue Location1", "line_index": 27, "text": ".ىﺭﺎﯿﺑﺭﺩ ﻝﻮﭘ ﻥﺩﺮﻛ  ىﺯﺎﺑ ﺎﺑ ﯽﻧﻮﺗ ﯽﻣ ، ﯽﺘﺳﺍﺭ "}
{"category": "LocationDialogue Location1", "line_index": 28, "text": "؟ﯼﺭﺎﯿﺑﺭﺩ ﻝﻮﭘ ﻥﺩﺮﮐ ﯼﺯﺎﺑ ﺎﺑ ﯽﻧﻮﺘﯿﻣ ﯽﺘﺴﻧﻭﺪﯿﻣ ﻼﺻﺍ !ﻪﻋ"}
{"category": "LocationDialogue Location1", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 30, "text": "!ىﺮﺨﺑ ﻡﺍﺮﺑ ﻭﺭ ﻞﻤﺣ ﻞﺑﺎﻗ ﻥﻮﯾﺰﯾﻮﻠﺗ ﻥﻭﺍ ﻪﻛ  ىﺭﺍﺩ ﯽﻓﺎﻛ  ﻝﻮﭘ ﺎﻟﺎﺣ !ىﺩﺍﺩ ﺶﻣﺎﺠﻧﺍ !ﻩﺭﺭﺁ"}
{"category": "LocationDialogue Location1", "line_index": 31, "text": ".ﻢﺘﺳﺍﻮﺧ ﯽﻣ ﻪﻛ  ىﺰﯿﭼ ﻥﻮﻤﻫ ًﺎﻘﯿﻗﺩ—ﻥﻭﺯﺭﺍ ﻭ ﻞﻤﺣ ﻞﺑﺎﻗ ،ﻚﯿﭼﻮﻛ  !ﻪﻨﯿﻤﻫ"}
{"category": "LocationDialogue Location1", "line_index": 32, "text": "!ﺕﺯﺍ ﻢﻧﻮﻨﻤﻣ ﯽﻠﯿﺧ "}
{"category": "LocationDialogue Location1", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 34, "text": ".ﯽﻨﻜﯿﻣ ﮏﻤﮐ ﻢﻬﺑ ﯽﻠﯿﺧ ،ﺶﺘﺳﺍﺭ [player]! ،ﻡﺎﻠﺳ"}
{"category": "LocationDialogue Location1", "line_index": 35, "text": ".ﻩﺪﺷ ﺏﺍﺮﺧ ﻪﮕﯾﺩ ﯽﻟﻭ ، ﺩﻮﺑ ﺏﻮﺧ ؟ﻥﻮﯾﺰﯾﻮﻠﺗ ﻥﻭﺍ ...ﻩﺍ ،ﯽﻟﻭ "}
{"category": "LocationDialogue Location1", "line_index": 36, "text": "؟ﻢﯿﻨﻛ  ﺎﺠﺑﺎﺟ ﻭﺭ ﺪﻤﻛ  ﻦﯾﺍ ﯽﻨﻛ  ﮏﻤﮐ  ﯽﻧﻮﺗ ﯽﻣ ،ﻝﺎﺣ ﺮﻫ ﻪﺑ"}
{"category": "LocationDialogue Location1", "line_index": 37, "text": ">.< ...ﻪﻨﯿﮕﻨﺳ ﯽﻠﯿﺧ "}
{"category": "LocationDialogue Location1", "line_index": 38, "text": "♡ !ﻡﺰﯾﺰﻋ ﻢﻧﻮﻨﻤﻣ ﯽﻠﯿﺧ "}
{"category": "LocationDialogue Location1", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 40, "text": "!ﻩﺪﺷ ﮓﻨﺗ ﯽﻠﯿﺧ ﺕﺍﺮﺑ ﻢﻟﺩ ﯽﻟﻭ ،ﻪﺘﺷﺬﮔ ﺯﻭﺭ ﻪﯾ ﻂﻘﻓ [player]! ،ﻩﻭﺍ "}
{"category": "LocationDialogue Location1", "line_index": 41, "text": ".ىﺎﯿﺑ ﻢﺸﯿﭘ ﺮﺘﺸﯿﺑ ﯽﺘﺴﻧﻮﺘﯿﻣ ﺵﺎﻛ  "}
{"category": "LocationDialogue Location1", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 43, "text": "؟ﻪﻨﻣ ىﺍﺮﺑ ﻦﯾﺍ "}
{"category": "LocationDialogue Location1", "line_index": 44, "text": "!ًﺎﻌﻗﺍﻭ ،ﻢﻧﻮﻨﻤﻣ ﯽﻠﯿﺧ "}
{"category": "LocationDialogue Location1", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 46, "text": "...ﻡﺩﺮﻜﯿﻣ ﺮﻜﻓ ﻢﺘﺷﺍﺩ [player]! ،ﻡﺎﻠﺳ "}
{"category": "LocationDialogue Location1", "line_index": 47, "text": "...ﻢﯿﻨﻛ  ﺕﺎﻗﺎﻠﻣ ىﺭﻮﻀﺣ ﻭﺭ ﻪﮕﯾﺪﻤﻫ ﻢﯿﺘﺴﻧﻮﺘﯿﻣ ﺵﺎﻛ  "}
{"category": "LocationDialogue Location1", "line_index": 48, "text": "ﻢﻧﻮﺘﯿﻤﻧ ﻪﻛ  ﻢﯿﻧﺎﺒﺼﻋ ﯽﻠﯿﺧ "}
{"category": "LocationDialogue Location1", "line_index": 49, "text": "...ﯽﻧﻮﺑﺮﻬﻣ ﺭﺪﻘﻧﺍ ﺯﻭﺭ ﺮﻫ ،ﯽﻨﻜﯿﻣ ﮏﻤﮐ  ﻢﻬﺑ ىﺭﺍﺩ ﻪﺸﯿﻤﻫ "}
{"category": "LocationDialogue Location1", "line_index": 50, "text": ".ﻡﺪﺑ ﻡﺎﺠﻧﺍ ﺕﺍﺮﺑ ىﺭﺎﻛ  ﻪﯾ ﻢﺘﺴﻧﻮﺘﯿﻣ ﻢﻨﻣ ﺵﺎﻛ  "}
{"category": "LocationDialogue Location1", "line_index": 51, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 52, "text": "!ﻢﻨﻫﺫ ﻮﺗ ﺪﻣﻭﺍ ﻩﺪﯾﺍ ﻪﯾ ، ﻩﻭﺍ "}
{"category": "LocationDialogue Location1", "line_index": 53, "text": ".ﻢﯿﺘﺴﻫ ﻢﻫ ﺎﺑ ﻥﺎﻟﺍ"}
{"category": "LocationDialogue Location1", "line_index": 54, "text": ".ﻦﯿﯾﺎﭘ ﺭﺍﺬﺑ ﻭﺭ ﯽﺷﻮﮔ "}
{"category": "LocationDialogue Location1", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 57, "text": "// تیشرت روی تخت "}
{"category": "LocationDialogue Location1", "line_index": 58, "text": "؟ ﻪﺘﺨﺗ ىﻭﺭ ﺍﺮﭼ "}
{"category": "LocationDialogue Location1", "line_index": 59, "text": "// Keybord -کیبورد"}
{"category": "LocationDialogue Location1", "line_index": 60, "text": "...ﻡﺩﺮﻛ  ﻩﺩﺎﻔﺘﺳﺍ ﺵﺯﺍ ﯽﻠﯿﺧ ﻢﮕﺑ ﻢﻧﻮﺘﯿﻤﻧ ،ﺐﺧ"}
{"category": "LocationDialogue Location1", "line_index": 61, "text": ".ﻡﺩﺰﻧ ﺖﺳﺩ ﺶﻬﺑ ﺖﻗﻭ ﭻﯿﻫ ﻪﮕﯾﺩ ﻭ ﻡﺩﺮﻛ  ﺶﻠﺣ ﺭﺎﺑ ﻚﯾ "}
{"category": "LocationDialogue Location1", "line_index": 62, "text": "؟ﻢﻨﻛ  ﺶﻠﺣ ﻢﻧﻮﺘﻧ ﻡﻭﺩ ﻪﻌﻓﺩ ﺪﯾﺎﺷ ﻡﺩﺮﻛ  ﺮﻜﻓ "}
{"category": "LocationDialogue Location1", "line_index": 63, "text": "// Computer-کامپیوتر"}
{"category": "LocationDialogue Location1", "line_index": 64, "text": "...ﻢﯿﻨﯿﺒﺑ "}
{"category": "LocationDialogue Location1", "line_index": 65, "text": "...ﻢﻨﻛ  ﻢﯿﻈﻨﺗ ﺎﻫﺭﺎﻛ  ﺯﺍ ﺖﺴﯿﻟ ﻪﯾ "}
{"category": "LocationDialogue Location1", "line_index": 66, "text": "،ﻢﺴﯾﻮﻨﺑ ﻭﺭ ﺎﺘﯿﺼﺨﺷ ىﺎﻬﺸﻨﻛ ﺍﻭ "}
{"category": "LocationDialogue Location1", "line_index": 67, "text": ".ﻢﻨﻛ  ﯽﺴﯾﻮﻧ ﺪﻛ  ﻢﻫ ﻢﻛ  ﻪﯾ ﺪﯾﺎﺷ ﻭ"}
{"category": "LocationDialogue Location1", "line_index": 68, "text": "// The airplane - هواپیما"}
{"category": "LocationDialogue Location1", "line_index": 69, "text": "!ﻩﺪﺷ ﻪﺘﺧﺎﺳ ﻦﺘﻓﺮﮔ ﺝﻭﺍ ىﺍﺮﺑ "}
{"category": "LocationDialogue Location1", "line_index": 70, "text": "// ﻪﻧﻮﺧ ﻪﺷﻮﮔ ىﻮﺗ ىﺎﻫ ﻪﻟﺎﺑﺯ"}
{"category": "LocationDialogue Location1", "line_index": 71, "text": "...ﻡﺭﺍﺬﺑ ﻥﻭﺮﯿﺑ ﻭﺭ ﺎﻬﻟﺎﺑﺯ ﻪﻛ  ﻪﻏﻮﻠﺷ ﻡﺮﺳ ﯽﻠﯿﺧ ﻪﺸﯿﻤﻫ ، ﻩﺍ"}
{"category": "LocationDialogue Location1", "line_index": 72, "text": "!ﻡﺪﯿﻣ ﺶﻣﺎﺠﻧﺍ ًﺎﻤﺘﺣ ﺭﺎﺑ ﻦﯾﺍ ﯽﻟﻭ "}
{"category": "LocationDialogue Location1", "line_index": 73, "text": "...؟ ﺩﺎﯿﻣ ﯽﮐ ﺖﻓﺎﻈﻧ ﺯﻭﺭ ﺎﻘﯿﻗﺩ ﻻﺎﺣ"}
{"category": "LocationDialogue Location1", "line_index": 74, "text": "// ﻪﻧﻭﺪﻨﻫ ىﻭﺭ ﻪﺑﺮﮔ کﯾ ﺲﻜﻋ "}
{"category": "LocationDialogue Location1", "line_index": 75, "text": "…ﺩﻮﺑ ﻦﯾﺮﺘﻬﺑ ﻥﻭﺍ "}
{"category": "LocationDialogue Location1", "line_index": 76, "text": ".ﻪﻧﻭﺪﻨﻫ ىﻭﺭ ﻩﺪﯿﺸﻛ  ﺯﺍﺭﺩ ، ﻪﺑﺮﮔ ﻪﯾ "}
{"category": "LocationDialogue Location1", "line_index": 77, "text": "// عکس با دختر"}
{"category": "LocationDialogue Location1", "line_index": 78, "text": "،ﻢﯿﺘﺴﯿﻧ ﻢﻫ ﻪﯿﺒﺷ ًﺎﻠﺻﺍ "}
{"category": "LocationDialogue Location1", "line_index": 79, "text": ".ﻦﻣ ﻭ ﻡﺮﻫﺍﻮﺧ "}
{"category": "LocationDialogue Location1", "line_index": 80, "text": "،ﻩﺪﻣﺁ ﻭ ﺖﻓﺭ ﻝﺎﺣ ﺭﺩ ﻭ ﻪﻧﻭﺮﯿﺑ ﻪﺸﯿﻤﻫ "}
{"category": "LocationDialogue Location1", "line_index": 81, "text": ". ﻢﻧﻮﺧ ﻮﺗ ﻂﻘﻓ ﻦﻣ ﻭ "}
{"category": "LocationDialogue Location1", "line_index": 82, "text": "// عکس با مردم و همکاران"}
{"category": "LocationDialogue Location1", "line_index": 83, "text": ".......ﻢﻤﻤﻤﻤﻤﻫ "}
{"category": "LocationDialogue Location1", "line_index": 84, "text": "ﺖﺷﺍﺬﮔ ﻭﺭ ﺵﺩﻮﺧ ﺮﯿﺛﺎﺗ ًﺎﻌﻗﺍﻭ ىﺭﺍﺩﺍ ﯽﮔﺪﻧﺯ "}
{"category": "LocationDialogue Location1", "line_index": 85, "text": "؟ﻪﻧ ﻪﮕﻣ ، ﺖﺧﺍﺪﻧﺍ ﺎﺟ ﺎﻣ ىﻮﺗ ﻭﺭ ﺏﺍﺩﺁ "}
{"category": "LocationDialogue Location1", "line_index": 86, "text": "ﻢﺘﺴﺑﺍﻭ ﯽﺒﯿﺠﻋ ﺯﺮﻃ ﻪﺑ ﻢﻨﻜﯿﻣ ﺲﺣ ﺯﻮﻨﻫ "}
{"category": "LocationDialogue Location1", "line_index": 87, "text": "ﯽﻟﻭ "}
{"category": "LocationDialogue Location1", "line_index": 88, "text": "ﺯﻭﺭ ﻪﯾ ﻦﻣ ﺎﯾﺁ "}
{"category": "LocationDialogue Location1", "line_index": 89, "text": "؟ ﻥﻮﺷ ﻢﻨﯿﺑ ﯽﻣ ﻢﻫ ﺯﺎﺑ"}
{"category": "LocationDialogue Location1", "line_index": 90, "text": "؟… ﻢﺘﺷﺍﺬﮔ ﻭﺭ ﺲﻜﻋ ﻦﯾﺍ ﺍﺮﭼ ًﺎﻠﺻﺍ ،ﻦﻛ  ﺮﺒﺻ "}
{"category": "LocationDialogue Location1", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 93, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 94, "text": ""}
