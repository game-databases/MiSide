{"category": "LocationDialogue Location1", "line_index": 119, "text": "// اسم میتا"}
{"category": "LocationDialogue Location1", "line_index": 120, "text": "ﺎﺘﯿﻣ "}
{"category": "LocationDialogue Location1", "line_index": 121, "text": "؟ىﺩﺮﻛ  ﺍﺪﺻ ﻦﻣ ﻡﺎﻧ ﻪﺑ ﻭﺭ ﺕﺩﻮﺧ ﺎﻌﻗﺍﻭ "}
{"category": "LocationDialogue Location1", "line_index": 122, "text": "؟ﺖﺴﻫ ﺕﺩﻮﺧ ﻢﺳﺍ ﻢﻧﻭﺍ ...ﺎﯾ "}
{"category": "LocationDialogue Location1", "line_index": 123, "text": "♪ ﻢﺷﺎﺑ ﺎﺠﻨﯾﺍ ﺎﺘﯿﻣ ﺎﻬﻨﺗ ﺪﯾﺎﺑ ﻢﻨﻛ ‌ﯽﻣ ﺮﻜﻓ ﯽﻟﻭ ،ﻪﺷﺎﺒﻧ ﯽﻣﺍﺮﺘﺣﺍ‌ﯽﺑ"}
{"category": "LocationDialogue Location1", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 125, "text": "// روز ١٠"}
{"category": "LocationDialogue Location1", "line_index": 126, "text": "!ﯽﺘﺸﮔﺮﺑ ،ﺎﻫﺁ "}
{"category": "LocationDialogue Location1", "line_index": 127, "text": "...ﻡﺩﺮﻛ  ﻢﮔ ﻭﺭ ﻮﻣ ﻪﻧﻮﺷ ،ﯽﻫ "}
{"category": "LocationDialogue Location1", "line_index": 128, "text": "؟ﻢﯿﻨﻛ  ﺵﺍﺪﯿﭘ ﯽﻨﻛ  ﻢﻜﻤﻛ  ﯽﻧﻮﺗ ﯽﻣ "}
{"category": "LocationDialogue Location1", "line_index": 129, "text": ". ﺶﻤﺘﺷﺍﺬﮔ ﺎﺠﻧﻭﺍ ﻢﻨﮐ ﺮﮑﻓ ، ﺏﺍﻮﺧ ﺖﺨﺗ ﻑﺍﺮﻃﺍ ﻍﺍﺮﺳ ﻭﺮﺑ ﻝﻭﺍ"}
{"category": "LocationDialogue Location1", "line_index": 130, "text": "//ﻡﺩﺮﻛ  ﻩﺎﮕﻧ ﻭﺭ ﺖﺨﺗ ﺭﺎﻨﻛ  ﺰﯿﻣ ىﻮﺗ "}
{"category": "LocationDialogue Location1", "line_index": 131, "text": "...ﺖﺴﯿﻧ ﺎﺠﻧﻭﺍ ىﺍ ﻪﻧﻮﺷ ﭻﯿﻫ ،ﻢﻤﻫ "}
{"category": "LocationDialogue Location1", "line_index": 132, "text": "؟ ﺖﺴﮕﯾﺩ ﺎﺠﯾ ﺪﯾﺎﺷ "}
{"category": "LocationDialogue Location1", "line_index": 133, "text": "؟ﻪﺷﺎﺑ ،ﻦﻜﻧ ﻩﺎﮕﻧ ﻭﺭ ﺮﻓ ىﻮﺗ ﻂﻘﻓ"}
{"category": "LocationDialogue Location1", "line_index": 134, "text": ".ﻡﺩﺮﻛ  ﻩﺎﮕﻧ ﻭﺭ ﺎﺠﻧﻭﺍ ًﺎﻠﺒﻗ ﻦﻣ "}
{"category": "LocationDialogue Location1", "line_index": 135, "text": "//ﻡﺩﺮﻛ  ﻩﺎﮕﻧ ﻭﺭ ﻕﺎﺟﺍ ىﻮﺗ "}
{"category": "LocationDialogue Location1", "line_index": 136, "text": "!ﯽﻨﻜﻧ ﻩﺎﮕﻧ ﺎﺠﻧﻭﺍ ﻪﺑ ﻢﺘﻔﮔ ! ﯽﻫ "}
{"category": "LocationDialogue Location1", "line_index": 137, "text": "ﺩﺮﮕﺑ ﻭﺭ ﻪﮕﯾﺩ ﻪﯾﺎﻫﺎﺟ ، !ﻢﻨﮑﯿﻣ ﺭﻮﺟ ﻮﻌﻤﺟ ﻭﺭ ﺎﺠﻧﻭﺍ ﻦﻣ"}
{"category": "LocationDialogue Location1", "line_index": 138, "text": ".... ﻢﯿﻨﻛ  ﺍﺪﯿﭘ ﻭﺭ ﻪﮕﯾﺩ ىﺎﺟ ﻢﯾﺮﺑ ﺎﯿﺑ .ﺪﺷ ﻡﻮﻤﺗ ،ﺎﺠﻧﻭﺍ"}
{"category": "LocationDialogue Location1", "line_index": 139, "text": "؟ﻪﺷﺎﺑ ، ﯼﺪﯾﺩ ﯽﭼ ﻦﮐ ﺵﻮﻣﺍﺮﻓ ﻢﻤﻋ ، ﻩﺍ"}
{"category": "LocationDialogue Location1", "line_index": 140, "text": "//پیدا کردن شونه"}
{"category": "LocationDialogue Location1", "line_index": 141, "text": "!ﻝﻮﯾﺍ !ىﺩﺮﻛ  ﺵﺍﺪﯿﭘ "}
