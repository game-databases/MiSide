{"category": "LocationDialogue Location6", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "¿Mita?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "¿Cómo diablos llegaste aquí?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Eres Mita, ¿no?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Pero hay algo que no me cuadra..."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "Veo que eres muy observador."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "Y tienes razón."}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "No soy la Mita que conociste antes."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Ten cuidado, la otra Mita está tramando algo"}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "siniestro."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "¿Eh, algo siniestro?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "No hay tiempo para explicaciones"}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "si salimos de esta te lo contaré todo."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Consigue la llave, está al lado del sofá."}
{"category": "LocationDialogue Location6", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Pero..."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "¡Guarda tus preguntas para más tarde!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Dame la llave."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Toma este anillo."}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "¿Cómo?"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "¿Quieres salir de aquí, no?"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "A ver, claro que sí..."}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Entonces póntelo."}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "Es un artefacto útil."}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "Probablemente lo necesitarás pronto."}
{"category": "LocationDialogue Location6", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Si tu lo dices..."}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "Por cierto, yo "}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Mmm,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "Soy Mita."}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// MitaKind quest 1"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "¡Mira eso!"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "Recógelo."}
{"category": "LocationDialogue Location6", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "¿Estamos viendo una grabación?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "¿Quién es el que está con ella?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "Eso está pasando en este mismo momento."}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "Es otro jugador."}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Lo está usando."}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Ella no dudará en..."}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "convertirte en un cartucho también."}
{"category": "LocationDialogue Location6", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "¡Necesito salir de aquí lo antes posible!"}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "Y tú también."}
{"category": "LocationDialogue Location6", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "Sí, tenemos que escapar de aquí."}
{"category": "LocationDialogue Location6", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "Entonces, ¿estás diciendo"}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "que ella lo está usando a él?"}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "Si saco el cartucho, ¿qué pasa?"}
{"category": "LocationDialogue Location6", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "Si lo sacas, podrías..."}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "dañar irreversiblemente el cartucho."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "Lo que significa que..."}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "El jugador moriría."}
{"category": "LocationDialogue Location6", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "..."}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "¿Qué pasa si simplemente lo apago?"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "¡Oh! eso podría funcionar..."}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Vale la pena intentarlo. ¡Hay un botón de encendido rojo!"}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "¿Lo ves?"}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "¡Lo encontré!"}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "¡Púlsalo!"}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// MitaKind quest 2"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Tengo que quedarme."}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "Hay preguntas que necesito hacerle,"}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "para saber más sobre ella."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "Aunque es poco probable que ella acepte."}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// MitaKind quest 3"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "Si te digo la verdad, esta es mi versión."}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "Yo estaba haciendo compañía a un jugador,"}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "cuando algo cambió de repente."}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "Entonces la otra apareció..."}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "y convirtió al jugador en un cartucho"}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "y me encerró aquí."}
{"category": "LocationDialogue Location6", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Espera, ¿ella lo convirtió en un cartucho?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "¿Puede si quiera hacer eso?"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "¿Pero por qué?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "¿Para qué necesita a los jugadores?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "Es obvio, ¡está loca!"}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "¡Solo está juegando con todos nosotros y usandonos para sus propias maquinaciones!"}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "convirtiendo a los jugadores en cartuchos..."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Algunos ni siquiera se dieron cuenta de lo que les estaba pasando..."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "y si se dan cuenta, no se arman de valor para luchar."}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "Eso sí que es un giro de guión oscuro..."}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "¡Tienes que ayudarnos!"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "¿Yo? ¿Pero cómo?"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "¡Te necesito!"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "¡Si nos ayudas, te compensaré!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Esta podría ser nuestra única oportunidad."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "El anillo te llevará a la versión correcta del juego."}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "Te veré allí."}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// MitaKind quest 4"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "Sigo sin entenderlo del todo,"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "lo que vi allá arriba..."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "esa Mita..."}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "¿Estaba tratando de matarme?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "¿Matarte?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Ella tiene un destino peor que ese planeado para ti."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "¡Tienes que darte prisa!"}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Hide!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "¡Oh, mierda! ¡Escóndete!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Espera, ¿qué...?"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "¡Date prisa, ya viene!"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "¡Si sigues el anillo, te llevará a un lugar seguro!"}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "Bueno, bueno, ¿me dirás dónde está?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "¿Por qué debería?"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "No lo matarás, ¿verdad?"}
{"category": "LocationDialogue Location6", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Ah, entonces te niegas a decírmelo."}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Ja, me gustan los desafíos."}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "Sé que se esconde por aquí, en algún rincón."}
{"category": "LocationDialogue Location6", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "¿Por qué eres tan mala con nosotras?"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "¿Ni siquiera me dirás qué está pasando?"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "Además..."}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "¿para qué necesitas a los jugadores?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "¡No son tus juguetes!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "¿Qué coño te pasa?"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "¡Ya es suficiente, calladita estás más guapa muñeca!"}
