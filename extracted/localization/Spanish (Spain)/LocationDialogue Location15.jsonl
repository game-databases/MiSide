{"category": "LocationDialogue Location15", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "¡Ahí estás!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "¿Por qué te fuiste del Núcleo?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "¡Te dije que me esperaras!"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Pensé que te pasó algo..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Bueno, vale..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Creo que he encontrado algo..."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Creo que es un índice..."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "¡Tendremos que ver si funciona!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Vámonos de aquí."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "La Mita pirada..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Creo que está ocupada con un nuevo jugador."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Así que espero que esté demasiado ocupada para preocuparse por nosotros..."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "¿Mita?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Espérame."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "¿Se te ha caído algo?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "¡VUELVE A VERLA!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Mita..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "¡Píllala!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "¿Cómo es posible...?"}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "¿Quién eres?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "¿¡Estás... estás viva!?"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "¿No te acuerdas?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "¿Te conozco?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "¿Qué está pasando...?"}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "¿Qué se supone que debo hacer ahora?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "No puedo salir..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "¿Qué quieres decir con \"salir\"?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Espera..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "Ese es el anillo..."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "¿Y eso?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Ni idea de qué es."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "¡Es un índice!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "¡Lo encontraste!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "No sé qué decir."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Debemos volver al Núcleo."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "Y tú..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Quizás deberías venir conmigo..."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Eh, ¿qué?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Claro..."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Espera un momento."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Mm-hmm."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Me sentaré justo aquí."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Mierda..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "Por poco."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "Asi que... ¿lo hemos hecho?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Bien."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Estoy en la versión correcta."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "¡Hola!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Eres un jugador, ¿verdad?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "¿Cuál es tu nombre?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Quiero irme de este lugar..."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "¿Quieres irte tan pronto?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "¿Cómo llegaste aquí?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Bueno..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Vale, puedes irte..."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Intenta abrir la puerta."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "¡Buena suerte con eso!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "¿Una pared?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Hmm, eso está mal."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Quizás..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "haya algo en el sótano que te ayude."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Hace poco descubrí"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "una puerta en mi armario..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Resulta que lleva a un sótano."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Pero está lleno de chatarra,"}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "chatarra y un montón de equipo sofisticado."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Tienes que meter una especie de código o algo así."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "No lo entiendo muy bien."}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "Y me da igual."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "También es un poco incómodo, quiero decir, muy incómodo."}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "¿Le echas un vistazo?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Eh, vale."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "No creo"}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "que recuerde nada..."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "¿Lo hicimos?"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "¿La reiniciamos?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Entonces lo único que tengo que hacer es"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "salir de este maldito juego..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "No tan rápido."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Me gustaría darte un abrazo."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "¿Eh?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Me alegro de verte."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Ahh..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "es una verdadera lástima"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "que tú y yo"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "hayamos pasado tan poco tiempo juntos."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Eh..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "¿De qué estás hablando?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Quiero decir,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "podrías haberte quedado conmigo..."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "Es todo culpa mía..."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Ese armario y los... los sonidos."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "¡Debería haberla MATADO antes!"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Espera un minuto,"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "¿No lo hice...?"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "¿Cómo puedes recordar algo de eso?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "¡JA!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "¿De verdad pensabas que sería tan fácil?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Eres un simple tonto..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Como todos los demás jugadores..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Lo hemos muy bien, ¡mira!"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "El VERDADERO"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "\"tú\" ya no"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "eres necesario."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Lo siento, je-je."}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "No me lo puedo creer..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "¿Hemos fallado...?"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "No... Te reinicié, estoy seguro..."}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "¿Aún no lo entiendes...?"}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "¡JA-JA-JA!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "¡Soy una gran actriz!"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "¡Deberías haber visto tu cara, cielo!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "¡Esto es muy divertido!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "¡¿Por qué eres así?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "¡¿Qué te pasa?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Sí..."}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "¿Qué me pasa?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Ni idea..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "¿Por qué no me dices tú por qué soy así?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "¿Por qué nunca seré una Mita de verdad?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Mi versión, nunca"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "existió en primer lugar."}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Solo estoy desollando a estas ingenuas,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "escondiéndome bajo su piel..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "¡No hay forma de que puedas"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "reiniciarme!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Increíble..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Tú..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "¡Ellas no son el problema!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "¡Tú eres la que nunca debería existir!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "¿Tú también?"}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Me duele oírte decir eso."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "¡Y sin embargo!"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "¡Es hora de que te vayas!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "¡Te volveré a ver pronto!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "¡Todos están listos!"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "Es"}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "hora de sacarte de la consola."}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "¡Hasta luego!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "¡Serás mi cartucho favorito...!"}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Un jugador con un nombre interesante."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Probablemente no sea eso."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Tampoco es correcto."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "No, mal."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "No, todo mal."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Necesito encontrar la opción de reinicio de personaje."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "Esa es la versión incorrecta."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Ups, error mío."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Esa no es."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Voy a necesitar otra."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Algo va mal"}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "con el índice."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Necesito cambiar el índice,"}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "no encaja."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "¿Tienes hambre?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Se me da genial cortar zanahorias. :)"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Ah, supongo"}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "¿Que querías entrar solo?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "¿Por qué estamos dando vueltas?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "¿Por qué volver aquí?"}
