{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "¡Hola!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "¡Ui!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Perdona,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "casi te mato ahí."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Ah...,"}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "el frigo... digo, el frigo casi te mata."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Yo no he tenido nada que ver,"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "¡lo juro!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "¡De verdad!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Claro, te creo."}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Pero en serio,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "este sitio es peligroso..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "sobretodo para ti."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "¡No eres nada cobarde, eh!"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Mirarte, mientras pasas,"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "por estos sitios,"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "es divertido..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "¡Corre, chavalín, corre!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "¡Yo te alcanzaré!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "¡Eso es!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "¡AHHHH, esto es divertido!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Te vi dirigirte hacia el tren."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "Es el camino más largo"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "entre versiones..."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Me pregunto cómo te las apañarás,"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "con los que viven ahí"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "en esa niebla."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "¿Qué crees que estás haciendo?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Por favor..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "¡No mires!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "¡Idiota!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "¡Cabeza hueca...!"}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Ehh, bueno..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "¡Mucha mierda!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "¿Quién anda ahí?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Puedo sentirte..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Escúchame,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "eres un jugador,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "¿verdad?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Ayúdame a encontrar..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "encontrar un..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "Déjame pensar..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "mi mente está en blanco..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "¿Qué narices está pasando aquí?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Quise olvidarlo todo alguna vez..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Rompí todos los espejos,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "destrocé las fotos..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "Pero ahora..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "lo único que siento es arrepentimiento."}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "Qué estúpida fui..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Todos cometemos errores, claro..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Pero, ¿qué haces"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "cuando las consecuencias son catastróficas?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Ojalá pudiera dar marcha atrás en el tiempo..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Dicen que el tiempo lo cura todo..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Pero, ¿qué es el tiempo?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Ya no creo en nada..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Pero si el tiempo puede curar,"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "o al menos llevarme lejos,"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "lejos de este mundo..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "Entonces, te lo ruego,"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "por favor."}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "Haz que el tiempo corra,"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "que me mate de una vez por todas."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Ella es querida..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "¿He querido yo también alguna vez?"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Pero mi amor es diferente;"}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "su amor es vibrante,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "despreciable..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "ardiente..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "implacable..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "envidioso..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "furioso..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "loco..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Me llamaban sensible..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "Te preocupas demasiado, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "Saldrás de esta, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "No estás sola, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Eso decían. Pero, ¿qué me queda?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Tristeza,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "desesperación..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "y miedo."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Inútil..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "No puedo recordar..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "Nada en absoluto..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Solo los ecos interminables..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "No puedo soportar el hecho"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "de estar atrapada aquí..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Siempre he estado aquí,"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "pero ¿por qué?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "No puedo recordar..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "¿Se acabará alguna vez?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "No lo sé..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Esto es..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "un dibujo..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Ya lo recuerdo,"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "gracias..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Pero mi cara..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "No tengo cara..."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "Es todo de ELLA."}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Ella tomó un pedazo de mí..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "lo tiró..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Es fuerte..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "y astuta."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "No tengo derecho a detenerte, jugador."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Mira en el armario..."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "¡Oye!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "¡Estás en mi camino!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "¿Vas a quedarte ahí parado?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "¡Solo quítate del medio!"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "¡Que seas grande no significa"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "que seas todopoderoso!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// ¡OYE! ¡DETENTE!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "¡¿Por qué me estás siguiendo?!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "¡Déjame en paz!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - voz por radio"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Espera un momento... ¿Jugador?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "¿Qué haces aquí?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "¿Quién anda ahí?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Otro jugador."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Soy Mitaphone."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Estoy aquí controlando los teleféricos."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "¿Te das cuenta"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "de que estás yendo directo a tu perdición?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Quizás,"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "pero es el único camino que tengo."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Exacto."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Pulsa el botón y ponte detrás del cañón."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "¿El cañón?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Ajá."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "¿Pensabas que solo ibas a pasar tranquilamente?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Tienes que superar este mini-juego de \"monstruos a golpes\","}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "así que prepárate para disparar."}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Vale, hora de ponerse en marcha."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "¡Increíble!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Lo has logrado."}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Oye, sal de aquí."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "¡Rápido y sin miramientos!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "¿Qué haces todavía aquí?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Te dije que te largaras."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "No entiendo..."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "¿Por qué sigues ahí parado?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "¿Tetris?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Tío..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Adiós."}
