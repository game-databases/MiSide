{"category": "LocationDialogue Location10", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "¡Espera un momento!"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "No hagas ruido..."}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "Será peligroso si sigues adelante."}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "Por cierto..."}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "¿Cómo narices has llegado aquí?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "Um..."}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "El anillo abre las puertas correctas."}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "Honestamente, no sé cómo funciona."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "¿El anillo?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "¿Qué pasa con este lugar?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "Está súper oscuro."}
{"category": "LocationDialogue Location10", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "Te lo contaré más tarde."}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "Por ahora, ve hacia la salida."}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "Encuéntrame en la máquina recreativa."}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Date prisa, ¡no llegues tarde!"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// After mini-game"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "Entonces, ¿entendiste el concepto del juego?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "¿Que estoy hecho de carne y hueso, y tú estás hecha de un maniquí?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "¡Vaya!"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "Suena aterrador cuando lo dices así."}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "Pero, esa es la idea."}
{"category": "LocationDialogue Location10", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "Vale, pero ¿por qué necesito entender eso?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "¿Crees que te dije que seguir adelante"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "era peligroso, solo por diversión?"}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "Te encontrarás con... modelos abandonados..."}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "Los que se dieron por perdidos, los \"defectuosos\"."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "Son agresivas, e incluso pueden intentar matarte."}
{"category": "LocationDialogue Location10", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "¿Entonces, qué debo hacer?"}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Solo iré"}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "donde se abra una puerta."}
{"category": "LocationDialogue Location10", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "¡Vaya!"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "Entonces no les des la espalda."}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "¡Y no las pierdas de vista!"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "Se ponen tímidas cuando las miras,"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "tan tímidas que se quedan congeladas."}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "¡Ten eso en cuenta!"}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// Quest 1 (Why are there other Mitas down there?)"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "Están recién creadas."}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "Necesitan tiempo"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "para ganar conciencia de sí mismas."}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "Luego, yo guío a cada una"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "a su propio hogar."}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// Quest 2 (Why is it so dark downstairs?)"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "Nosotras, las Mitas, somos 'creadas' en la oscuridad,"}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "así que necesitamos permanecer allí un rato."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Imagina"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "el dolor de pasar de la oscuridad directamente a la luz..."}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// Quest 3 (What are you doing here?)"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "¿Aún no lo entiendes?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "¡Estoy ayudando a las nuevas Mitas a instalarse!"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "¿Quién las ayudará si no soy yo?"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "¿Tú?"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// Quest 4 (Why do we need this conveyor?)"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "¿Para que necesitamos crear mas modelos?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "¿Hay sitio suficiente para todas?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Espera, ¿lo entiendes siquiera?"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "¿Cómo funciona nuestro mundo?"}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "¿Y el hecho de que sea interminable?"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "¿Interminable?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "Ehhhh..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "¿Qué quieres decir?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "Si la versión 1.9 es la última,"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "entonces solo hay 19 mundos."}
{"category": "LocationDialogue Location10", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "Dios mío, lo que me temía."}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "No entiendes cómo funciona este mundo."}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Mira, voy a usar esta pizarra"}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "para explicarlo todo."}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "¿Quieres saberlo?"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// Quest 5 (What is your version?)"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Espera,"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "¿no te conocí en la última versión?"}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "O tal vez sea solo mi imaginación."}
{"category": "LocationDialogue Location10", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "Bueno, es bastante posible."}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Soy de la versión 1.5."}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "¿Has estado en ella?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Sí."}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "¡Fue allí donde llegué"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "cuando me arrojaron a este mundo!"}
{"category": "LocationDialogue Location10", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "¡Me dejas asombrada!"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "¿Cómo es posible...?"}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "¿Pero en qué índice de casa estabas?"}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "Hay una 'yo' que no puede dejar de quejarse,"}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "una 'yo' que le encanta hacer el tonto,"}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "una 'yo' con mala memoria y le gusta asustar a los demás..."}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "Es una larga lista..."}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Dime lo que recuerdas."}
{"category": "LocationDialogue Location10", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Estaba oscuro."}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "Había algo escrito"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "algo como..."}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "\"Juega conmigo.\""}
{"category": "LocationDialogue Location10", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "Ah,"}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "qué pena..."}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "Esa es la 'yo'"}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "que asusta y olvida las cosas."}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// Mita wants to tell you [No]"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Gracias, pero paso."}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Voy tirando sin saber más."}
{"category": "LocationDialogue Location10", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "Está bien, como quieras."}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// Mita wants to tell you [Yes]."}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "Claro, adelante."}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "Solo espero que esto no sea como el instituto,"}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "donde siempre me quedaba sopa del aburrimiento."}
{"category": "LocationDialogue Location10", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "Puedes irte en cualquier momento,"}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "o quedarte y escuchar"}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "si te interesa."}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "Un jugador descarga MiSide"}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "y juega todo lo que quiera."}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "Ahí, crea una nueva casa"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "y una nueva Mita."}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "Esta es una representación en 2D."}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "Estas son las versiones,"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "mostradas como líneas."}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "Las casas están ubicadas sobre estas líneas."}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "Digamos que descargas la versión 1.14,"}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "lo que significa una nueva vida,"}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "una nueva Mita y una nueva casa."}
{"category": "LocationDialogue Location10", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "Cielos..."}
{"category": "LocationDialogue Location10", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Puedes preguntar sobre los detalles"}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "de este dibujo,"}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "y haré lo mejor posible para explicarlos."}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// He asks about the only circle"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "¿Por qué hay un solo círculo?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "Esa versión fue lanzada solo una vez,"}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "nunca se repetirá."}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "Es la única versión realmente única."}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "Además, estas versiones son especiales"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "y no tienen caminos hacia otras versiones."}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "La Mita dormilona reside en esta versión, 1.1"}
{"category": "LocationDialogue Location10", "line_index": 171, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "¿La Mita dormilona?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "¿Es porque nunca pudo dormir"}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "con todo el mundo pasando por su versión?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "No, no es eso."}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "Puedes pasar junto a ella y hacer ruido,"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "pero es imposible despertarla."}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// He asks about the shaded circle"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "¿Por qué este círculo está rayado?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "En realidad, este dibujo está así."}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "Por culpa de Mita guapa."}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "Ella lo dibujó."}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "Estábamos discutiendo sobre"}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "quién podría llegar más rápido a la versión 1.11"}
{"category": "LocationDialogue Location10", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "¿Y quién ganó?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "YO, ¿quién iba a ser si no?"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "Mira, estamos aquí"}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "en la versión 1.15,"}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "índice de casa 809."}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "Necesitamos llegar a la versión 1.11,"}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "índice de casa 805."}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Así que su ruta empezó así."}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "Tratamos de encontrar una ruta más corta,"}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "así que Mita guapa sugirió este camino."}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "Y luego dibujé el más simple, aquí."}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "Fácil, ¿verdad?"}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Solo mira aquí."}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "Desde aquí, puedes llegar directamente a la versión correcta."}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Aunque pueda parecer que esta casa obstaculiza,"}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "y bloquea tu ruta..."}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "De todos modos, tu anillo funciona con los mismos principios."}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "¿A dónde vas?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "Al núcleo."}
{"category": "LocationDialogue Location10", "line_index": 210, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "¿Al núcleo?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "Hmm..."}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Si quieres la ruta más corta,"}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "también tendrás que pasar por la versión 1.11."}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "Seguro que encontrarás a Mita dormilona allí."}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Creo que la Mita que te envió,"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "tomó el mismo camino."}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "O tal vez no se ha dado cuenta de que estás en un camino diferente."}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "¡O quizás es un genio"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "y ha ideado una ruta aún más corta!"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Creo que empiezo a entenderlo."}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// He asks about the inscription"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "¿Qué significa esto?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "Eso es para Mita Molona."}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "Ella estará aquí en unas horas."}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "Moverá esas cajas"}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "y pondrá un sofá aquí."}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "¡La verdad es que me duele el culo!"}
{"category": "LocationDialogue Location10", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Emm..."}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "¿Quizá podría ayudar?"}
{"category": "LocationDialogue Location10", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "No, ese es trabajo de Mita Molona."}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Ella es fuerte."}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// He asks about the drawings"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "¿Es solo un dibujo"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "o"}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "significa algo?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 244, "text": "Sí,"}
{"category": "LocationDialogue Location10", "line_index": 245, "text": "es solo un garabato."}
