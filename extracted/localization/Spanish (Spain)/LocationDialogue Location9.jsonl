{"category": "LocationDialogue Location9", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Oye, ¡tú!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "¡Hola!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "¿Quieres salir?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "¡Entonces ayúdame a encontrar la llave!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "¡Mierda! ¡La llave no está!"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "No está aquí."}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "Cero, nada, ¡nada!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "¡La encontré!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// The usual conversation"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "¡Vaya, pensé que serías más bajito!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "¡Eres alto"}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "justo como mi hermana!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "¿Tu hermana? ¿Qué pasa con ella?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Sí, mi hermana."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "¡No me digas que nunca la has conocido!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Eh... ¿la conozco?... creo que sí."}
{"category": "LocationDialogue Location9", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "¿Eres tonto?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "A ver..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "Pues parece que sí..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "¡Vamos, ayúdame a encontrar la llave ya!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// Next work"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Ven."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "¡Pon el hierro en la tubería!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "¡Gracias!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "¡Ahora tráeme esa madera!"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "¡Gracias!"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "¡Un poco más de ayuda, por favor!"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "¡Todo listo! Ahora..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "guau, qué bonito."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "¡Púlsalo, venga!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Prepárate..."}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "¡ahí, cógela!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "¡La llave es toda tuya!"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// Quest 1 (Are you Mita?)"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "¡Soy ChibiMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Con un montón de diálogos,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "un modelo súper simple,"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "y lo mejor de todo, ¡un pelazo hermoso!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// Quest 2 (Have we seen each other yet?)"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "¡Cabeza hueca!"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "Eres mono, ¿sabes?"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "Haces preguntas tontas como esa."}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Aunque,"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "¡esta es la primera vez que te conozco!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Dime una cosa..."}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "¡Si robas mi estilo maravilloso,"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "te arrepentirás!"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// Quest 3 (Why are you here?)"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "¿No lo entiendes?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "¡Esto es un punto de control"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "una prueba de tu astucia!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "¡Ahora ve!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "¡Estoy aquí para guiar a los perdidos sin esperanza!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// Quest 4 (Why are you helping me?)"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "¿Qué te hace tan especial?"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "¿Por qué no ayudarte de todos modos?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "¿Qué dices?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Qué tonto eres..."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "¡Apareciste de la nada!"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Se supone que no deberías estar aquí,"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "¡así que te estoy ayudando!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "¡Adiós, tonto!"}
