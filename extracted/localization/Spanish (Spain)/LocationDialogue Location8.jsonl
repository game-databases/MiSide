{"category": "LocationDialogue Location8", "line_index": 0, "text": "// The first meeting"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "¿Quién eres?"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "¿Qué te pasa?"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "¿N-no puedes hablar?"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "Espera..."}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "Quieres irte, ¿verdad?"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "Sí..."}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "Necesito volver"}
{"category": "LocationDialogue Location8", "line_index": 11, "text": "a la versión anterior."}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "¿La versión anterior?"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "¿Por qué irte a otro sitio?"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "¿Por qué no..."}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "quedarte aquí"}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "y ser mi"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "segundo amigo?"}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Skipping all dialogs"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "Vale..."}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Standing by the window (Random)"}
{"category": "LocationDialogue Location8", "line_index": 24, "text": "No encontrarás la salida por las puertas."}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "Parece que tienes prisa..."}
{"category": "LocationDialogue Location8", "line_index": 26, "text": "Correr en círculos no te salvará."}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "¿Tantas ansias tienes de escapar?"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "Mira por las ventanas..."}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Aren't you Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "Jugador... eres un jugador, ¿no?"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": "Podemos jugar juntos."}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "Si encuentro fuerzas,"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": "todo lo que necesitamos es jugar."}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (What happened to you?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "No estoy segura, y en realidad no lo sé..."}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "No creo que me haya pasado nada malo..."}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "Pero todo lo bueno parece escaparse..."}
{"category": "LocationDialogue Location8", "line_index": 41, "text": "Aunque, al menos tengo un amigo."}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "¿Por qué me abandonaron?"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "¿No fui suficiente?"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "Tengo miedo..."}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Quest 3 (Become a second friend?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "Amigos..."}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "Ahora me quedan muy pocos."}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "Solo queda uno..."}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "Estoy triste, jugador."}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "¿Serás mi amigo?"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "Me encantaría,"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "pero tengo que seguir adelante..."}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "Me duele el corazón..."}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Is this your house?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "¿Casa?"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "Jugador... has cambiado..."}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "Tus brazos son más cortos y ya no pareces tan enfadado..."}
{"category": "LocationDialogue Location8", "line_index": 62, "text": "Jugador, te has vuelto más suave, más amable."}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "No sé..."}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "lo que significa."}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "Está bien..."}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "Porque ya no dolerá ¿verdad?"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (How do I leave this place?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "¿De verdad me dejas?"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "¿Es esto quizás solo mi..."}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "destino?"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "Yo..."}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": "Las puertas no te ayudarán."}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Hold player (Random)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "¿Por qué irte?"}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "Quédate aquí..."}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "Juega conmigo..."}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "Jugador..."}
