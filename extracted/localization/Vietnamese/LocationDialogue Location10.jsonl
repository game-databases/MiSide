{"category": "LocationDialogue Location10", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "Chờ đã, chờ đã!"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "A, nhỏ tiếng thôi..."}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "Đi tiếp nữa là nguy đấy."}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "Dù sao thì..."}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "Làm sao anh đến được đây?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "Um..."}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "Chiếc nhẫn dẫn anh đến đúng cửa."}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "Tuy không hiểu cơ chế hoạt động của nó lắm."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "Nhẫn?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "Đây là nơi nào vậy?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "Tối như hũ nút."}
{"category": "LocationDialogue Location10", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "Em sẽ giải thích sau."}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "Giờ thì kiếm lối ra đã."}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "Hẹn gặp anh ở máy game thùng."}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Nào, nhanh lên!"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// After mini-game"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "Sao rồi, hiểu ý nghĩa của trò chơi này chưa?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "Anh đây bằng xương bằng thịt, còn em thì sao? Hình nộm à?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "Thôi nào!"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "Đừng nói chuyện đáng sợ thế chứ."}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "Nghe mà sởn hết gai ốc rồi."}
{"category": "LocationDialogue Location10", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "Anh biết, nhưng hiểu trò chơi kia để làm gì?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "Nãy em đã nói rồi mà."}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "Tiến vào sâu hơn nữa là rất nguy hiểm."}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "Phía trước là... nơi tụ tập những hình nộm đó..."}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "Những \"thất bại\" bị đào thải."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "Họ hung hăng hơn Mita bình thường đấy. Anh muốn gặp không?"}
{"category": "LocationDialogue Location10", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "Thế phải làm sao bây giờ? "}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Cứ cánh cửa nào mở ra"}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "thì anh sẽ đi theo hướng đó."}
{"category": "LocationDialogue Location10", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "Wow!"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "Vậy thì... đừng quay lưng về phía họ."}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "Và đừng rời mắt khỏi họ!"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "Các cô gái ấy rất e thẹn,"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "hễ bị nhìn là họ sẽ đứng hình ngay."}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "Em nghĩ thông tin này sẽ hữu ích đấy!"}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// Quest 1 (Why are there other Mitas down there?)"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "Các cô gái ấy chỉ mới được sinh ra thôi."}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "Phải cần thêm chút thời gian "}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "để hình thành ý thức về bản thân."}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "Rồi em sẽ đưa từng người"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "về nhà của họ."}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// Quest 2 (Why is it so dark downstairs?)"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "Mita chúng em được \"sinh ra\" trong bóng tối"}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "và tồn tại trong bóng tối một thời gian."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Anh tưởng tượng được không?"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "Việc đột ngột phải nhìn thấy ánh sáng sẽ đau đớn đến nhường nào..."}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// Quest 3 (What are you doing here?)"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "Vẫn chưa hiểu sao?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "Em ở đây để giúp những Mita tội nghiệp ấy ổn định lại tinh thần!"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "Ngoài em ra, họ còn có thể dựa vào ai chứ?"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "Anh hả?"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// Quest 4 (Why do we need this conveyor?)"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "Tại sao lại cần băng chuyền?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "Phía cuối băng chuyền có phòng cho mọi người à?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Khoan đã, anh chẳng hiểu gì về"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "cách thế giới này vận hành nhỉ..."}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "Băng chuyền này là vô tận đó."}
{"category": "LocationDialogue Location10", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "Vô tận?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "Hm..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "Ý em là sao?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "Nếu 1.9 là phiên bản mới nhất"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "thì lẽ ra chỉ có 19 thế giới thôi chứ."}
{"category": "LocationDialogue Location10", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "Trời, bó tay luôn rồi."}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "Anh đúng là chẳng hiểu gì về thế giới này cả."}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Thôi để em dùng bảng để giảng cho anh."}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "Về mọi thứ của thế giới này luôn."}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "Anh muốn nghe không?"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// Quest 5 (What is your version?)"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Hình như"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "anh gặp em ở phiên bản mới nhất rồi thì phải?"}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "Hay là anh nhớ nhầm nhỉ."}
{"category": "LocationDialogue Location10", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "Điều đó, cũng có thể lắm."}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Phiên bản của em là 1.5."}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "Anh đã từng đến đó chưa?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Anh rồi."}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "Lần đầu tiên anh đến thế giới này"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "là phiên bản 1.5!"}
{"category": "LocationDialogue Location10", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "Whoa!"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "Ra là thế..."}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "Em tò mò không biết anh vào nhà số mấy."}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "Có một \"em\" lúc nào cũng than vãn,"}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "một \"em\" cực kỳ thích chơi đùa,"}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "một \"em\" đãng trí lại còn xấu tính..."}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "Ừm, kể mãi không hết..."}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Anh có nhớ được gì không?"}
{"category": "LocationDialogue Location10", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Trong nhà lúc đó tối om."}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "Nhưng có dòng chữ viết"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "đại loại là..."}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "\"Chơi không anh?\""}
{"category": "LocationDialogue Location10", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "À."}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "Tệ thật..."}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "Là nhỏ đó."}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "Nhỏ đó vừa đãng trí vừa xấu tính."}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// Mita wants to tell you [No]"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Cảm ơn, nhưng không cần đâu."}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Anh nghĩ anh sẽ ổn cả thôi."}
{"category": "LocationDialogue Location10", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "Vậy à, theo ý anh vậy."}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// Mita wants to tell you [Yes]."}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "Hiểu rồi, vậy em nói đi."}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "Mong là anh không ngủ gật"}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "như hồi học trung học."}
{"category": "LocationDialogue Location10", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "Anh có thể rời đi lúc nào cũng được."}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "Hoặc ở lại nghe em nói"}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "nếu anh hứng thú."}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "Có một người chơi đã tải MiSide về điện thoại."}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "Anh ta tỏ vẻ mãn nguyện và bắt đầu chơi."}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "Tại nơi đó, anh ta đã tạo ra một ngôi nhà mới"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "và một Mita mới."}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "Đây là sơ đồ biểu diễn theo dạng 2D."}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "Mỗi đường thẳng"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "tượng trưng cho một phiên bản."}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "Trên mỗi đường thẳng là một ngôi nhà."}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "Khi anh tải phiên bản 1.14 về"}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "giống như việc tạo ra một sinh mệnh mới..."}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "một Mita mới, và một ngôi nhà mới trên phiên bản đó."}
{"category": "LocationDialogue Location10", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "Hm..."}
{"category": "LocationDialogue Location10", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Có câu hỏi chi tiết nào cứ hỏi nhé. "}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "Về những gì được vẽ ở đây."}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "Em sẽ giải thích cho anh."}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// He asks about the only circle"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "Tại sao ở đây chỉ có một vòng tròn?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "Phiên bản này chỉ được phát hành duy nhất một lần"}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "vì nó không được phân phối ở đâu khác nên..."}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "nó là độc nhất vô nhị."}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "Ngoài ra, điểm khác biệt của phiên bản này"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "là không thể bỏ qua nó."}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "Mita Buồn Ngủ đang ở phiên bản 1.1 này."}
{"category": "LocationDialogue Location10", "line_index": 171, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "Mita Buồn Ngủ?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "Có phải là do mọi người cứ qua lại nơi đó"}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "nên cô ấy không thể ngủ ngon được?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "Hm."}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "Chỉ là đi ngang qua cửa thôi"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "nên lẽ ra có gây phiền phức gì đâu."}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// He asks about the shaded circle"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "Tại sao hình tròn này lại có bóng?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "Tất nhiên cái bóng đó"}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "có lý do của nó."}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "Mita Xinh Xắn đã tô đen nó."}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "Em và cô ấy đã cãi nhau"}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "về việc ai sẽ đến phiên bản 1.11 trước."}
{"category": "LocationDialogue Location10", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "Rồi ai thắng?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "Tất nhiên là em rồi!"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "Nhìn này, chúng ta đang ở đây"}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "phiên bản 1.15,"}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "nhà số 809."}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "Bọn em đang cố gắng đi đến phiên bản 1.11,"}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "nhà số 805."}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Ban đầu, cô ấy định đi theo tuyến đường này,"}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "nhưng bọn em cần một tuyến đường ngắn hơn."}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "Và Mita Xinh Xắn ấy đề xuất như thế này."}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "Nhưng em lại nghĩ ra cách đơn giản hơn nhiều. "}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "Rõ quá còn gì?"}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Nhìn này."}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "Từ đây, ta có thể đến thẳng phiên bản mong muốn."}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Căn nhà này chắn ngang"}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "tưởng chừng như không thể đi qua được..."}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "À mà nhẫn của anh cũng hoạt động theo cách tương tự đấy."}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "Nó đang dẫn anh tới nơi nào vậy?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "Anh đang đi tới Lõi."}
{"category": "LocationDialogue Location10", "line_index": 210, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "Lõi ấy hả?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "Hmm..."}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Nếu anh muốn đi đường tắt"}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "thì buộc phải đi qua phiên bản 1.11 nữa."}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "Chắc chắn anh sẽ gặp Mita Buồn Ngủ ở đó."}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Hẳn Mita, người đã dẫn lối cho anh"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "cũng chọn con đường này."}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "Hoặc có thể anh đang ở một phiên bản khác mà không hề hay biết."}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "Hoặc cũng có thể cô ấy là một thiên tài thực sự,"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "và đã tìm ra con đường ngắn nhất!"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Anh bắt đầu hiểu ra rồi."}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// He asks about the inscription"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "Này là gì thế?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "Tin nhắn gửi cho Mita Phong Cách."}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "Vài tiếng nữa cô ấy sẽ đến đây."}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "Dọn dẹp mấy cái thùng này"}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "và mang ghế sofa qua đây."}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "Chứ em ngồi đau hết mông rồi!"}
{"category": "LocationDialogue Location10", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Vậy..."}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "Anh có thể giúp gì không?"}
{"category": "LocationDialogue Location10", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "Không cần đâu, Mita Phong Cách ấy lo liệu được."}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Cô ấy mạnh mẽ lắm mà."}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// He asks about the drawings"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "Này chỉ là hình vẽ thôi à?"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "Hay là"}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "nó có ý nghĩa gì đặc biệt?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 244, "text": "À không."}
{"category": "LocationDialogue Location10", "line_index": 245, "text": "Chỉ là hình vẽ nguệch ngoạc thôi."}
