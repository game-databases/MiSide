{"category": "LocationDialogue Location4", "line_index": 0, "text": "Mita?"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "A, anh tỉnh lại rồi."}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "Ơ, em dịch chuyển tức thời à?"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": "Mới nãy em còn đứng ở cạnh anh mà."}
{"category": "LocationDialogue Location4", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 5, "text": "Không phải đâu."}
{"category": "LocationDialogue Location4", "line_index": 6, "text": "Anh đứng bất động ở trước gương"}
{"category": "LocationDialogue Location4", "line_index": 7, "text": "nên em mới rời đi."}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "Thế còn mấy căn phòng này?"}
{"category": "LocationDialogue Location4", "line_index": 9, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "Em đã sắp xếp lại nơi này"}
{"category": "LocationDialogue Location4", "line_index": 11, "text": "để khiến anh cảm thấy thoải mái hơn."}
{"category": "LocationDialogue Location4", "line_index": 12, "text": "Ý em là..."}
{"category": "LocationDialogue Location4", "line_index": 13, "text": "Các phòng không xếp thẳng hàng nữa,"}
{"category": "LocationDialogue Location4", "line_index": 14, "text": "mọi thứ chỉ theo đúng trật tự thôi."}
{"category": "LocationDialogue Location4", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 16, "text": "Em không cần phải làm vậy đâu,"}
{"category": "LocationDialogue Location4", "line_index": 17, "text": "anh cũng dần quen cách bố trí trước rồi."}
{"category": "LocationDialogue Location4", "line_index": 18, "text": "Nhưng rồi anh sẽ thấy cách bố trí này thoải mái hơn thôi."}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Mita card game"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "Vậy thì"}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "chúng ta chơi thôi."}
{"category": "LocationDialogue Location4", "line_index": 22, "text": "Để em giải thích ngắn gọn cho anh."}
{"category": "LocationDialogue Location4", "line_index": 23, "text": "Chip ở trên bàn đại diện cho loại chỉ số được so tài trong ván đấu đó."}
{"category": "LocationDialogue Location4", "line_index": 24, "text": "Ví dụ, chip hình sinh mệnh ♥ chẳng hạn."}
{"category": "LocationDialogue Location4", "line_index": 25, "text": "Chúng ta sẽ chọn lấy một lá trên tay mình,"}
{"category": "LocationDialogue Location4", "line_index": 26, "text": "nếu lá bài của anh có chỉ số sinh mệnh ♥"}
{"category": "LocationDialogue Location4", "line_index": 27, "text": "cao"}
{"category": "LocationDialogue Location4", "line_index": 28, "text": "hơn em"}
{"category": "LocationDialogue Location4", "line_index": 29, "text": "là anh thắng."}
{"category": "LocationDialogue Location4", "line_index": 30, "text": "Rút bài đi anh."}
{"category": "LocationDialogue Location4", "line_index": 31, "text": "Tiếp theo là em."}
{"category": "LocationDialogue Location4", "line_index": 32, "text": "Oa!"}
{"category": "LocationDialogue Location4", "line_index": 33, "text": "Rút được bài đẹp quá nè."}
{"category": "LocationDialogue Location4", "line_index": 34, "text": "Em đánh trước nhé!"}
{"category": "LocationDialogue Location4", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 44, "text": "Đến lượt anh đó!"}
{"category": "LocationDialogue Location4", "line_index": 45, "text": "Tới lượt anh ha!"}
{"category": "LocationDialogue Location4", "line_index": 46, "text": "Ưm ưm."}
{"category": "LocationDialogue Location4", "line_index": 47, "text": "Đến lượt anh!"}
{"category": "LocationDialogue Location4", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 49, "text": "So điểm sinh mệnh nào!"}
{"category": "LocationDialogue Location4", "line_index": 50, "text": "Chọi chỉ số tấn công nào!"}
{"category": "LocationDialogue Location4", "line_index": 51, "text": "Giờ là so khả năng phòng thủ!"}
{"category": "LocationDialogue Location4", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 54, "text": "Chiến thắng thuộc về anh!"}
{"category": "LocationDialogue Location4", "line_index": 55, "text": "Anh thắng rồi!"}
{"category": "LocationDialogue Location4", "line_index": 56, "text": "Vậy là anh thắng."}
{"category": "LocationDialogue Location4", "line_index": 57, "text": "Ah, anh thắng ha..."}
{"category": "LocationDialogue Location4", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 59, "text": "Em thắng!"}
{"category": "LocationDialogue Location4", "line_index": 60, "text": "Em thắng rồi nè! ♪"}
{"category": "LocationDialogue Location4", "line_index": 61, "text": "Chiến thắng thuộc về em!"}
{"category": "LocationDialogue Location4", "line_index": 62, "text": "Tuyệt quá, vậy là em thắng."}
{"category": "LocationDialogue Location4", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 64, "text": "Hòa rồi."}
{"category": "LocationDialogue Location4", "line_index": 65, "text": "Đồng quy vu tận!"}
{"category": "LocationDialogue Location4", "line_index": 66, "text": "Năm mươi năm mươi!"}
{"category": "LocationDialogue Location4", "line_index": 67, "text": "Y chang nhau..."}
{"category": "LocationDialogue Location4", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 79, "text": "// The card game is interrupted"}
{"category": "LocationDialogue Location4", "line_index": 80, "text": "Tiếng động gì đằng đó vậy?"}
{"category": "LocationDialogue Location4", "line_index": 81, "text": "Có tiếng gì đó trong tủ quần áo."}
{"category": "LocationDialogue Location4", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 83, "text": "Tiếng động?"}
{"category": "LocationDialogue Location4", "line_index": 84, "text": "Tiếng động nào cơ?"}
{"category": "LocationDialogue Location4", "line_index": 85, "text": "Em không nghe thấy gì cả."}
{"category": "LocationDialogue Location4", "line_index": 86, "text": "Tiếng động như nào vậy anh?"}
{"category": "LocationDialogue Location4", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 88, "text": "Có tiếng gõ, như thể có người ở bên trong."}
{"category": "LocationDialogue Location4", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 90, "text": "Nhưng ở trong đó..."}
{"category": "LocationDialogue Location4", "line_index": 91, "text": "Không có ai cả."}
{"category": "LocationDialogue Location4", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 93, "text": "Anh phải ra kiểm tra thử mới được."}
{"category": "LocationDialogue Location4", "line_index": 94, "text": "Có gì đó không đúng."}
{"category": "LocationDialogue Location4", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 96, "text": "Tại sao..."}
{"category": "LocationDialogue Location4", "line_index": 97, "text": "Lại nữa..."}
{"category": "LocationDialogue Location4", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 105, "text": "Anh làm gì vậy!?"}
{"category": "LocationDialogue Location4", "line_index": 106, "text": "Trong đó..."}
{"category": "LocationDialogue Location4", "line_index": 107, "text": "có đồ lót của em."}
{"category": "LocationDialogue Location4", "line_index": 108, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 109, "text": "Em giấu anh chuyện gì phải không?"}
{"category": "LocationDialogue Location4", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 111, "text": "Tại sao anh không tin em?"}
{"category": "LocationDialogue Location4", "line_index": 112, "text": "Em làm sai chuyện gì sao?"}
{"category": "LocationDialogue Location4", "line_index": 113, "text": "Em chỉ muốn..."}
{"category": "LocationDialogue Location4", "line_index": 114, "text": "Em chỉ muốn anh ở bên em thôi mà."}
{"category": "LocationDialogue Location4", "line_index": 115, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 116, "text": "Anh cũng muốn hứa như vậy, nhưng còn bên trong tủ thì sao?"}
{"category": "LocationDialogue Location4", "line_index": 117, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 118, "text": "Sao anh phải bận tâm tới tủ quần áo làm gì?"}
{"category": "LocationDialogue Location4", "line_index": 119, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 120, "text": "Anh chỉ muốn biết âm thanh đó là gì thôi!"}
{"category": "LocationDialogue Location4", "line_index": 121, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 122, "text": "Kỳ thực..."}
{"category": "LocationDialogue Location4", "line_index": 123, "text": "Thế giới này"}
{"category": "LocationDialogue Location4", "line_index": 124, "text": "chỉ có vỏn vẹn bốn căn phòng."}
{"category": "LocationDialogue Location4", "line_index": 125, "text": "Như thế vẫn chưa đủ với anh sao?"}
{"category": "LocationDialogue Location4", "line_index": 126, "text": "Làm ơn... ở lại với em đi anh?"}
{"category": "LocationDialogue Location4", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 129, "text": "// Don't stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 130, "text": "Em hiểu rồi."}
{"category": "LocationDialogue Location4", "line_index": 131, "text": "Lại nữa à..."}
{"category": "LocationDialogue Location4", "line_index": 132, "text": "Anh muốn biết trong tủ có gì phải không?"}
{"category": "LocationDialogue Location4", "line_index": 133, "text": "Vậy thì anh sẽ biết..."}
{"category": "LocationDialogue Location4", "line_index": 134, "text": "ngay bây giờ thôi!"}
{"category": "LocationDialogue Location4", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 139, "text": "Cái quái..."}
{"category": "LocationDialogue Location4", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 141, "text": "Chuyện thường xảy ra lắm anh."}
{"category": "LocationDialogue Location4", "line_index": 142, "text": "Căn phòng này vẫn chưa tải xong."}
{"category": "LocationDialogue Location4", "line_index": 143, "text": "Chờ thêm chút nữa nhé."}
{"category": "LocationDialogue Location4", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 145, "text": "Kỳ lạ thật."}
{"category": "LocationDialogue Location4", "line_index": 146, "text": "Hay là chúng ta đang ở trong điện thoại của ai đó?"}
{"category": "LocationDialogue Location4", "line_index": 147, "text": "Kiểu như cái điện thoại đời cũ tải chậm?"}
{"category": "LocationDialogue Location4", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 149, "text": "Không đâu."}
{"category": "LocationDialogue Location4", "line_index": 150, "text": "Chỉ là thế giới này"}
{"category": "LocationDialogue Location4", "line_index": 151, "text": "vẫn chưa được hoàn hảo..."}
{"category": "LocationDialogue Location4", "line_index": 152, "text": "Chúng ta đang được nạp bởi"}
{"category": "LocationDialogue Location4", "line_index": 153, "text": "lõi của thế giới này."}
{"category": "LocationDialogue Location4", "line_index": 154, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 155, "text": "Lõi của thế giới?"}
{"category": "LocationDialogue Location4", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 157, "text": "Chuyện thường thôi mà anh?"}
{"category": "LocationDialogue Location4", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 159, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 161, "text": "Đúng rồi! Hay là chúng ta"}
{"category": "LocationDialogue Location4", "line_index": 162, "text": "chơi game console đi?"}
{"category": "LocationDialogue Location4", "line_index": 163, "text": "Hoặc là chơi bài cũng được."}
{"category": "LocationDialogue Location4", "line_index": 164, "text": "Anh thích chơi gì hơn?"}
{"category": "LocationDialogue Location4", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 167, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 168, "text": "// Mita play fight"}
{"category": "LocationDialogue Location4", "line_index": 169, "text": "Anh muốn đấu với em sao?"}
{"category": "LocationDialogue Location4", "line_index": 170, "text": "Anh phải thắng em"}
{"category": "LocationDialogue Location4", "line_index": 171, "text": "4 lần đấy nhé."}
{"category": "LocationDialogue Location4", "line_index": 172, "text": "Chiến thôi nào."}
{"category": "LocationDialogue Location4", "line_index": 173, "text": "Vì là lần đầu"}
{"category": "LocationDialogue Location4", "line_index": 174, "text": "em sẽ nhẹ tay với anh."}
{"category": "LocationDialogue Location4", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 176, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 177, "text": "Hay lắm."}
{"category": "LocationDialogue Location4", "line_index": 178, "text": "Nào, giờ em chơi tới bến luôn!"}
{"category": "LocationDialogue Location4", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 180, "text": "Woa!"}
{"category": "LocationDialogue Location4", "line_index": 181, "text": "Được rồi, từ giờ em mới"}
{"category": "LocationDialogue Location4", "line_index": 182, "text": "thực sự nghiêm túc đây này."}
{"category": "LocationDialogue Location4", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 184, "text": "Hay quá đi!"}
{"category": "LocationDialogue Location4", "line_index": 185, "text": "Nhưng để xem lần này"}
{"category": "LocationDialogue Location4", "line_index": 186, "text": "anh có thắng được em không đây?"}
{"category": "LocationDialogue Location4", "line_index": 187, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 188, "text": "Anh"}
{"category": "LocationDialogue Location4", "line_index": 189, "text": "thật sự"}
{"category": "LocationDialogue Location4", "line_index": 190, "text": "đỉnh quá mức! Kỹ thuật ngón tay của anh thật điêu luyện!"}
{"category": "LocationDialogue Location4", "line_index": 191, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 193, "text": "Sao vậy anh?"}
{"category": "LocationDialogue Location4", "line_index": 194, "text": "Thế này chẳng vui chút nào."}
{"category": "LocationDialogue Location4", "line_index": 195, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 196, "text": "Được rồi..."}
{"category": "LocationDialogue Location4", "line_index": 197, "text": "Vậy là xong. Anh thử dựa vào vận may xem sao."}
{"category": "LocationDialogue Location4", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 199, "text": "Tuyệt!"}
{"category": "LocationDialogue Location4", "line_index": 200, "text": "Anh không nghiêm túc hơn thì sẽ mãi là kẻ thua cuộc đó!"}
{"category": "LocationDialogue Location4", "line_index": 201, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 202, "text": "Ổn không vậy anh?"}
{"category": "LocationDialogue Location4", "line_index": 203, "text": "Cứ thế này thì anh không thắng được em đâu."}
{"category": "LocationDialogue Location4", "line_index": 204, "text": "Anh cần phải cố gắng hơn nữa."}
{"category": "LocationDialogue Location4", "line_index": 205, "text": "Bí quyết để trở nên mạnh mẽ như em đó!"}
{"category": "LocationDialogue Location4", "line_index": 206, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 208, "text": "Được rồi, giờ thì..."}
{"category": "LocationDialogue Location4", "line_index": 209, "text": "Tiếp theo chúng ta chơi bài ha?"}
{"category": "LocationDialogue Location4", "line_index": 210, "text": "Trong phòng của em."}
{"category": "LocationDialogue Location4", "line_index": 211, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 214, "text": "// Door > [ERROR]"}
{"category": "LocationDialogue Location4", "line_index": 215, "text": "Ủa? Chuyện gì thế này?"}
{"category": "LocationDialogue Location4", "line_index": 216, "text": "Đâu đây..."}
{"category": "LocationDialogue Location4", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 218, "text": "Ah."}
{"category": "LocationDialogue Location4", "line_index": 219, "text": "Em xin lỗi."}
{"category": "LocationDialogue Location4", "line_index": 220, "text": "Em đã tải một file"}
{"category": "LocationDialogue Location4", "line_index": 221, "text": "trên mạng về."}
{"category": "LocationDialogue Location4", "line_index": 222, "text": "Em muốn làm cho"}
{"category": "LocationDialogue Location4", "line_index": 223, "text": "quan cảnh bên ngoài đẹp hơn."}
{"category": "LocationDialogue Location4", "line_index": 224, "text": "Nhưng cuối cùng"}
{"category": "LocationDialogue Location4", "line_index": 225, "text": "em lại tải nhầm định dạng file..."}
{"category": "LocationDialogue Location4", "line_index": 226, "text": "Để tí em sửa sau nhé."}
{"category": "LocationDialogue Location4", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 228, "text": "Vậy là chúng ta không ra ngoài được hả?"}
{"category": "LocationDialogue Location4", "line_index": 229, "text": "Vâng, có vẻ là vậy."}
{"category": "LocationDialogue Location4", "line_index": 230, "text": "// Mita shy"}
{"category": "LocationDialogue Location4", "line_index": 231, "text": "Nè..."}
{"category": "LocationDialogue Location4", "line_index": 232, "text": "Có chuyện gì vậy anh?"}
{"category": "LocationDialogue Location4", "line_index": 233, "text": "Anh muốn gì đó à?"}
{"category": "LocationDialogue Location4", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 236, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 237, "text": "// Wall Clock"}
{"category": "LocationDialogue Location4", "line_index": 238, "text": "Cái đồng hồ này"}
{"category": "LocationDialogue Location4", "line_index": 239, "text": "nó hiển thị thời gian nào vậy?"}
{"category": "LocationDialogue Location4", "line_index": 240, "text": "Thời gian hiện tại trong game?"}
{"category": "LocationDialogue Location4", "line_index": 241, "text": "Hay là nó được đồng bộ từ điện thoại của anh?"}
{"category": "LocationDialogue Location4", "line_index": 242, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 243, "text": "Ừm, thì..."}
{"category": "LocationDialogue Location4", "line_index": 244, "text": "Em cũng không biết nữa."}
{"category": "LocationDialogue Location4", "line_index": 245, "text": "Ở nơi này thì thời gian không thành vấn đề."}
{"category": "LocationDialogue Location4", "line_index": 246, "text": "Dù có đến muộn cũng chẳng sao cả."}
{"category": "LocationDialogue Location4", "line_index": 247, "text": "Miễn là trong ngôi nhà này..."}
{"category": "LocationDialogue Location4", "line_index": 248, "text": "Một cô gái mạnh mẽ như em"}
{"category": "LocationDialogue Location4", "line_index": 249, "text": "không bao giờ biết mệt mỏi là gì!"}
{"category": "LocationDialogue Location4", "line_index": 250, "text": "Nếu em muốn, thế giới này sẽ mãi mãi tràn ngập sắc xuân,"}
{"category": "LocationDialogue Location4", "line_index": 251, "text": "mặt trời sẽ chẳng bao giờ lặn!"}
{"category": "LocationDialogue Location4", "line_index": 252, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 253, "text": "Nghe hấp dẫn thật..."}
{"category": "LocationDialogue Location4", "line_index": 254, "text": "Nhưng cũng có gì đó thật đáng sợ."}
{"category": "LocationDialogue Location4", "line_index": 255, "text": "Bị giam cầm mãi mãi trong không-thời gian này sao..."}
{"category": "LocationDialogue Location4", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 258, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 259, "text": "// Photos of Mita"}
{"category": "LocationDialogue Location4", "line_index": 260, "text": "Bức ảnh đẹp thật."}
{"category": "LocationDialogue Location4", "line_index": 261, "text": "Người trong ảnh là em phải không?"}
{"category": "LocationDialogue Location4", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 263, "text": "Vâng."}
{"category": "LocationDialogue Location4", "line_index": 264, "text": "Em cũng thích bức ảnh đó lắm."}
{"category": "LocationDialogue Location4", "line_index": 265, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 266, "text": "Ai đã chụp bức này vậy?"}
{"category": "LocationDialogue Location4", "line_index": 267, "text": "Ngoài chúng ta ra, còn ai khác trong thế giới này à?"}
{"category": "LocationDialogue Location4", "line_index": 268, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 269, "text": "Cũng có thể nói như vậy."}
{"category": "LocationDialogue Location4", "line_index": 270, "text": "Để hôm nào đó em giới thiệu cho anh."}
{"category": "LocationDialogue Location4", "line_index": 271, "text": "Nhưng bây giờ chưa phải là lúc để nói về"}
{"category": "LocationDialogue Location4", "line_index": 272, "text": "những người bạn thú vị này."}
{"category": "LocationDialogue Location4", "line_index": 273, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 275, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 276, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 277, "text": "// Portal"}
{"category": "LocationDialogue Location4", "line_index": 278, "text": "Cái cổng đó biến đâu mất rồi?"}
{"category": "LocationDialogue Location4", "line_index": 279, "text": "Hay gọi nó là gì ấy nhỉ?"}
{"category": "LocationDialogue Location4", "line_index": 280, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 281, "text": "Em đã"}
{"category": "LocationDialogue Location4", "line_index": 282, "text": "dùng phép \"búng tay\""}
{"category": "LocationDialogue Location4", "line_index": 283, "text": "để dịch chuyển nó"}
{"category": "LocationDialogue Location4", "line_index": 284, "text": "đến một nơi khác rồi."}
{"category": "LocationDialogue Location4", "line_index": 285, "text": "Chúng ta không cần cái cổng đó nữa."}
{"category": "LocationDialogue Location4", "line_index": 286, "text": "Vì nó chỉ gây cản trở hai ta thôi."}
{"category": "LocationDialogue Location4", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 288, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 289, "text": "// Mirror in the bedroom"}
{"category": "LocationDialogue Location4", "line_index": 290, "text": "Nhìn vào gương cứ thấy rờn rợn."}
{"category": "LocationDialogue Location4", "line_index": 291, "text": "Chẳng phản chiếu gì cả..."}
{"category": "LocationDialogue Location4", "line_index": 292, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 293, "text": "Em có thể kích hoạt phản chiếu"}
{"category": "LocationDialogue Location4", "line_index": 294, "text": "nếu anh muốn."}
{"category": "LocationDialogue Location4", "line_index": 295, "text": "Anh có cần không?"}
{"category": "LocationDialogue Location4", "line_index": 296, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 297, "text": "Tất nhiên là anh cần."}
{"category": "LocationDialogue Location4", "line_index": 298, "text": "Hay là... Nó có hậu quả gì à?"}
{"category": "LocationDialogue Location4", "line_index": 299, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 300, "text": "Vâng."}
{"category": "LocationDialogue Location4", "line_index": 301, "text": "Chúng ta di chuyển chậm kinh khủng, cử động thì bị cứng đờ."}
{"category": "LocationDialogue Location4", "line_index": 302, "text": "Anh đã xem anime với tốc độ khung hình thấp bao giờ chưa?"}
{"category": "LocationDialogue Location4", "line_index": 303, "text": "Nó sẽ kiểu như vậy hoài..."}
{"category": "LocationDialogue Location4", "line_index": 304, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 305, "text": "Anh hiểu rồi."}
{"category": "LocationDialogue Location4", "line_index": 306, "text": "Có lẽ không kích hoạt phản chiếu nữa vậy..."}
{"category": "LocationDialogue Location4", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 308, "text": "[player] nè,"}
{"category": "LocationDialogue Location4", "line_index": 309, "text": "anh thích ngắm mình trong gương lắm sao?"}
{"category": "LocationDialogue Location4", "line_index": 310, "text": "Hay là anh sợ khi nhìn thấy một chút gì đó tích cực trên gương mặt mình?"}
{"category": "LocationDialogue Location4", "line_index": 311, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 312, "text": "Hể? Anh không nhìn gì cả..."}
{"category": "LocationDialogue Location4", "line_index": 313, "text": "Chỉ là anh mệt"}
{"category": "LocationDialogue Location4", "line_index": 314, "text": "vì công việc thôi."}
{"category": "LocationDialogue Location4", "line_index": 315, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 316, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 317, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 318, "text": "// Blue sneakers"}
{"category": "LocationDialogue Location4", "line_index": 319, "text": "Giày này là của em à?"}
{"category": "LocationDialogue Location4", "line_index": 320, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 321, "text": "Không, giày của anh mà."}
{"category": "LocationDialogue Location4", "line_index": 322, "text": "Anh không nhớ sao?"}
{"category": "LocationDialogue Location4", "line_index": 323, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 324, "text": "Anh làm gì có giày thể thao như thế này?"}
{"category": "LocationDialogue Location4", "line_index": 325, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 326, "text": "Giờ nó là của anh rồi đấy."}
{"category": "LocationDialogue Location4", "line_index": 327, "text": "Khi nào anh ra ngoài"}
{"category": "LocationDialogue Location4", "line_index": 328, "text": "nhớ mang theo nhé."}
{"category": "LocationDialogue Location4", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 330, "text": "Còn quần áo thì sao nhỉ?"}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "Lúc anh đến thế giới này"}
{"category": "LocationDialogue Location4", "line_index": 332, "text": "chỉ có mỗi bộ đồ đang mặc."}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "Làm sao để kiếm bộ đồ khác bây giờ?"}
{"category": "LocationDialogue Location4", "line_index": 334, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 335, "text": "Cũng không có gì to tát đâu."}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "Em từng thấy bộ đồ thường ngày anh mặc rồi."}
{"category": "LocationDialogue Location4", "line_index": 337, "text": "Nói thiệt thì gu thẩm mỹ của anh không được tốt lắm."}
{"category": "LocationDialogue Location4", "line_index": 338, "text": "Nhưng đừng lo, cứ để đó cho em."}
{"category": "LocationDialogue Location4", "line_index": 339, "text": "Mà chuyện đó để sau nhé anh."}
{"category": "LocationDialogue Location4", "line_index": 340, "text": "Em hứa."}
{"category": "LocationDialogue Location4", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 342, "text": "Anh hiểu rồi."}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Games on TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "Chúng ta chơi game gì đây?"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Game milk"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "Này là game đối kháng!"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "Chúng ta sẽ xem ai chịu chua giỏi hơn..."}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "Game này thú vị lắm đó!"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": "Em cũng ngán sữa rồi, ta đổi vị chút đi?"}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Game penguins"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "Trong game này, anh sẽ trở thành chim cánh cụt"}
{"category": "LocationDialogue Location4", "line_index": 354, "text": "và trượt trên băng thôi."}
{"category": "LocationDialogue Location4", "line_index": 355, "text": "Game này chơi thế chắc đủ rồi anh."}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "Hể, sao cơ?"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "Anh nghiêm túc sao? Em cứ tưởng..."}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "Tim em đập nhanh quá đi!"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "Em hơi bối rối một chút..."}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "Vậy thì..."}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "Xin anh, hãy ở bên em"}
{"category": "LocationDialogue Location4", "line_index": 364, "text": "mãi mãi..."}
{"category": "LocationDialogue Location4", "line_index": 365, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 367, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 368, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 369, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 370, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 372, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 373, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 374, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 375, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 376, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 377, "text": "// A game about penguins"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "Đơn giản lắm anh."}
{"category": "LocationDialogue Location4", "line_index": 379, "text": "Thu thập những quả bóng tuyết."}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "Hiển nhiên là ai nhiều bóng tuyết hơn sẽ thắng!"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "Nào, chúng ta chơi hai ván nhé."}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// The first map"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "Hay quá! Sao anh gom được nhiều bóng tuyết thế kia?"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "Hihi! Em nhiều bóng tuyết hơn nè."}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "Cố gắng bắt kịp em đi nào."}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "Ha, 1:1!"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// The second map"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "Anh trượt y như chim cánh cụt thật ấy!"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "Giá mà chúng ta cũng được trượt trên băng thật thì tuyệt biết mấy."}
{"category": "LocationDialogue Location4", "line_index": 390, "text": "Trời ạ, anh chậm quá đó!"}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "Anh vẫn còn tiếc trận trước sao?"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "Woa, không ngờ lại hòa được hai ván, thật là hiếm thấy!"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// The game is over"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "Anh có muốn thử trò khác không?"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "Hay là thôi mình không chơi nữa?"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "Cái đó để làm gì vậy anh?"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "Anh là game thủ hả?"}
