{"category": "LocationDialogue Location1", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 1, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 9, "text": "Chào anh, em là Mita!"}
{"category": "LocationDialogue Location1", "line_index": 10, "text": "Anh tên là gì thế?"}
{"category": "LocationDialogue Location1", "line_index": 11, "text": "Hihi♪ Rất vui được gặp anh, [Player]!"}
{"category": "LocationDialogue Location1", "line_index": 12, "text": "[Player] nè..."}
{"category": "LocationDialogue Location1", "line_index": 13, "text": "Em vội quá nên phòng có hơi bừa bộn một chút..."}
{"category": "LocationDialogue Location1", "line_index": 14, "text": "Anh có thể giúp em dọn dẹp được không? "}
{"category": "LocationDialogue Location1", "line_index": 15, "text": "Phù..."}
{"category": "LocationDialogue Location1", "line_index": 16, "text": "Cảm ơn anh nhiều nhé!"}
{"category": "LocationDialogue Location1", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 18, "text": "[Player] ơi, bụng em đói meo rồi..."}
{"category": "LocationDialogue Location1", "line_index": 19, "text": "Em thèm ăn gì đó quá..."}
{"category": "LocationDialogue Location1", "line_index": 20, "text": "Anh có thể mua giúp em nguyên liệu nấu súp gà với được không?"}
{"category": "LocationDialogue Location1", "line_index": 21, "text": "Oa! Đúng thứ em cần luôn rồi!"}
{"category": "LocationDialogue Location1", "line_index": 22, "text": "Vậy giờ mình cùng nhau nấu ăn anh nhé?"}
{"category": "LocationDialogue Location1", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 25, "text": "A, [Player]! Nay em định đi mua một chiếc TV giá rẻ."}
{"category": "LocationDialogue Location1", "line_index": 26, "text": "Loại nhỏ gọn và có ăng ten... Em muốn mang nó đi dạo nữa cơ."}
{"category": "LocationDialogue Location1", "line_index": 27, "text": "Phải rồi, anh có thể chơi minigame để kiếm tiền đó!"}
{"category": "LocationDialogue Location1", "line_index": 28, "text": "Anh có thể chơi, kiếm chút tiền, và mua chiếc TV nhỏ cho em được không?"}
{"category": "LocationDialogue Location1", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 30, "text": "Tuyệt quá! Chừng này là đủ mua cho em chiếc TV rồi!"}
{"category": "LocationDialogue Location1", "line_index": 31, "text": "Oa, vừa rẻ và lại dễ mang theo, đúng thứ em cần luôn."}
{"category": "LocationDialogue Location1", "line_index": 32, "text": "Cảm ơn anh!"}
{"category": "LocationDialogue Location1", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 34, "text": "[Player]! Anh đã giúp em biết bao nhiêu thứ, em thực sự rất vui!"}
{"category": "LocationDialogue Location1", "line_index": 35, "text": "Nhưng anh nè. Chiếc TV hôm trước mình mua ấy, nó hỏng mất rồi... Nó tuyệt đến vậy mà..."}
{"category": "LocationDialogue Location1", "line_index": 36, "text": "A, em phải di chuyển cái tủ này. Giúp em một tay với được không?"}
{"category": "LocationDialogue Location1", "line_index": 37, "text": "Nó nặng... Nó nặng lắm luôn á... >.<"}
{"category": "LocationDialogue Location1", "line_index": 38, "text": "Thực sự cảm ơn anh rất nhiều! Yêu anh quá đi ♥"}
{"category": "LocationDialogue Location1", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 40, "text": "A, [Player]! Mới có một ngày trôi qua mà em nhớ anh quá chừng!"}
{"category": "LocationDialogue Location1", "line_index": 41, "text": "Được gặp anh thường xuyên hơn thì tuyệt biết mấy."}
{"category": "LocationDialogue Location1", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 43, "text": "Hể? Món quà dành cho em sao...?"}
{"category": "LocationDialogue Location1", "line_index": 44, "text": "Cảm ơn, cảm ơn anh, cảm ơn anh rất nhiều! ♥"}
{"category": "LocationDialogue Location1", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 46, "text": "[Player] ơi! Em chợt nhận ra một điều..."}
{"category": "LocationDialogue Location1", "line_index": 47, "text": "Quả nhiên là, em muốn trực tiếp gặp anh..."}
{"category": "LocationDialogue Location1", "line_index": 48, "text": "Không thể gặp anh thực sự khiến em đau lòng lắm."}
{"category": "LocationDialogue Location1", "line_index": 49, "text": "Em rất thích anh, thật lòng thích anh, ngày nào anh cũng làm mọi thứ vì em."}
{"category": "LocationDialogue Location1", "line_index": 50, "text": "Em cũng muốn làm gì đó để trả ơn cho anh."}
{"category": "LocationDialogue Location1", "line_index": 51, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 52, "text": "Thực ra, em mới nảy ra một ý tưởng..."}
{"category": "LocationDialogue Location1", "line_index": 53, "text": "Từ giờ [player] có thể ở bên em rồi!"}
{"category": "LocationDialogue Location1", "line_index": 54, "text": "Anh đặt điện thoại xuống đi."}
{"category": "LocationDialogue Location1", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 57, "text": "// T-shirt on the bed"}
{"category": "LocationDialogue Location1", "line_index": 58, "text": "Sao nó lại ở trên giường thế này?"}
{"category": "LocationDialogue Location1", "line_index": 59, "text": "// Rubik's Cube"}
{"category": "LocationDialogue Location1", "line_index": 60, "text": "Chà, mình cũng không đụng vào nó mấy nhỉ..."}
{"category": "LocationDialogue Location1", "line_index": 61, "text": "Giải được một lần rồi bỏ xó luôn."}
{"category": "LocationDialogue Location1", "line_index": 62, "text": "Chắc tại mình sợ không thể lắp lại được nữa."}
{"category": "LocationDialogue Location1", "line_index": 63, "text": "// Computer"}
{"category": "LocationDialogue Location1", "line_index": 64, "text": "Xem nào, hôm nay mình cần phải..."}
{"category": "LocationDialogue Location1", "line_index": 65, "text": "Lên danh sách công việc cần làm,"}
{"category": "LocationDialogue Location1", "line_index": 66, "text": "tạo phản ứng cho nhân vật"}
{"category": "LocationDialogue Location1", "line_index": 67, "text": "và viết thêm tí code nữa."}
{"category": "LocationDialogue Location1", "line_index": 68, "text": "// The airplane"}
{"category": "LocationDialogue Location1", "line_index": 69, "text": "Sinh ra để bay cao!"}
{"category": "LocationDialogue Location1", "line_index": 70, "text": "// Trash in the corner"}
{"category": "LocationDialogue Location1", "line_index": 71, "text": "Hm, lúc nào cũng bận chẳng có thời gian đổ rác..."}
{"category": "LocationDialogue Location1", "line_index": 72, "text": "Nhưng mình nhất định phải đi đổ cho bằng được!"}
{"category": "LocationDialogue Location1", "line_index": 73, "text": "...Mà khoan, hôm nào là ngày đổ rác nhỉ?"}
{"category": "LocationDialogue Location1", "line_index": 74, "text": "// Photo of a cat on a watermelon"}
{"category": "LocationDialogue Location1", "line_index": 75, "text": "Trông cưng ghê…"}
{"category": "LocationDialogue Location1", "line_index": 76, "text": "Một em mèo nằm trên quả dưa hấu."}
{"category": "LocationDialogue Location1", "line_index": 77, "text": "// Photo with a girl"}
{"category": "LocationDialogue Location1", "line_index": 78, "text": "Hai chị em"}
{"category": "LocationDialogue Location1", "line_index": 79, "text": "chẳng giống nhau chút nào."}
{"category": "LocationDialogue Location1", "line_index": 80, "text": "Chị thì luôn năng nổ tham gia các hoạt động"}
{"category": "LocationDialogue Location1", "line_index": 81, "text": "còn mình chỉ ru rú trong nhà."}
{"category": "LocationDialogue Location1", "line_index": 82, "text": "// Photo with people"}
{"category": "LocationDialogue Location1", "line_index": 83, "text": "Hmm..."}
{"category": "LocationDialogue Location1", "line_index": 84, "text": "Ông sếp kia cứ nhồi nhét văn hóa công sở"}
{"category": "LocationDialogue Location1", "line_index": 85, "text": "vào đầu bọn mình,"}
{"category": "LocationDialogue Location1", "line_index": 86, "text": "đến nỗi mà giờ mình chẳng thể cắt đứt quan hệ"}
{"category": "LocationDialogue Location1", "line_index": 87, "text": "với đồng nghiệp được..."}
{"category": "LocationDialogue Location1", "line_index": 88, "text": "Thậm chí mình còn không biết"}
{"category": "LocationDialogue Location1", "line_index": 89, "text": "có gặp lại họ nữa không cơ..."}
{"category": "LocationDialogue Location1", "line_index": 90, "text": "...Mà ủa, mình tự treo bức ảnh này lên à?"}
{"category": "LocationDialogue Location1", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 93, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 99, "text": "// Nope name"}
{"category": "LocationDialogue Location1", "line_index": 100, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 101, "text": "Ah."}
{"category": "LocationDialogue Location1", "line_index": 102, "text": "Như thế không được..."}
{"category": "LocationDialogue Location1", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 104, "text": "// Name Developer"}
{"category": "LocationDialogue Location1", "line_index": 105, "text": "Anh thực sự dùng tên của nhà phát triển luôn hả?"}
{"category": "LocationDialogue Location1", "line_index": 106, "text": "Em rất cảm kích ý tốt của anh, nhưng mà..."}
{"category": "LocationDialogue Location1", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 108, "text": "// Bad name"}
{"category": "LocationDialogue Location1", "line_index": 109, "text": "Thật lòng thì em không muốn anh dùng cái tên đó đâu."}
{"category": "LocationDialogue Location1", "line_index": 110, "text": "Nghe nó chẳng hay ho gì cả."}
{"category": "LocationDialogue Location1", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 112, "text": "// Go restart"}
{"category": "LocationDialogue Location1", "line_index": 113, "text": "Tóm lại là, cứ thế này thì không ổn. Phải bắt đầu lại thôi!"}
{"category": "LocationDialogue Location1", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 115, "text": "// Name with numbers"}
{"category": "LocationDialogue Location1", "line_index": 116, "text": "Anh định dùng số đặt tên luôn à? Thế thì còn gì là sáng tạo nữa...?"}
{"category": "LocationDialogue Location1", "line_index": 117, "text": "Mà thôi, anh cứ tự nhiên!"}
{"category": "LocationDialogue Location1", "line_index": 118, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 119, "text": "// Name Mita"}
{"category": "LocationDialogue Location1", "line_index": 120, "text": "Mita?"}
{"category": "LocationDialogue Location1", "line_index": 121, "text": "Anh lấy tên em đặt cho mình luôn hả?"}
{"category": "LocationDialogue Location1", "line_index": 122, "text": "Hay là tên anh trùng với tên em?"}
{"category": "LocationDialogue Location1", "line_index": 123, "text": "Em không có ý gì đâu, nhưng cái tên đó chỉ để dành riêng cho em thôi nhé ♪"}
{"category": "LocationDialogue Location1", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 125, "text": "// Day 10"}
{"category": "LocationDialogue Location1", "line_index": 126, "text": "A! Anh quay lại rồi à!"}
{"category": "LocationDialogue Location1", "line_index": 127, "text": "Anh nè, em mất lược chải tóc rồi…"}
{"category": "LocationDialogue Location1", "line_index": 128, "text": "Anh tìm nó giúp em được không?"}
{"category": "LocationDialogue Location1", "line_index": 129, "text": "Thử tìm ở tủ đầu giường xem! Biết đâu nó ở đấy."}
{"category": "LocationDialogue Location1", "line_index": 130, "text": "// Looked in the bedside table"}
{"category": "LocationDialogue Location1", "line_index": 131, "text": "Hmm, hình như không có ở đây..."}
{"category": "LocationDialogue Location1", "line_index": 132, "text": "Thử tìm ở chỗ khác xem sao."}
{"category": "LocationDialogue Location1", "line_index": 133, "text": "Anh đừng nhìn vào lò nướng nhé!"}
{"category": "LocationDialogue Location1", "line_index": 134, "text": "Em tìm kỹ ở trong đó rồi."}
{"category": "LocationDialogue Location1", "line_index": 135, "text": "// Looked into the stove"}
{"category": "LocationDialogue Location1", "line_index": 136, "text": "Ơ kìa! Em bảo anh đừng nhìn vào đó rồi mà!"}
{"category": "LocationDialogue Location1", "line_index": 137, "text": "Trời ạ, để đó em dọn cho!"}
{"category": "LocationDialogue Location1", "line_index": 138, "text": "Giờ thì... Anh tìm ở chỗ khác đi."}
{"category": "LocationDialogue Location1", "line_index": 139, "text": "Với cả... quên chuyện khi nãy đi nhé!"}
{"category": "LocationDialogue Location1", "line_index": 140, "text": "// Found a hairbrush"}
{"category": "LocationDialogue Location1", "line_index": 141, "text": "Oa! Anh tìm thấy nó rồi kìa!"}
{"category": "LocationDialogue Location1", "line_index": 142, "text": "Tuyệt quá! Tiếp theo chúng ta làm gì đây?"}
