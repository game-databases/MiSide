{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Hiya!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Ui chết!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Xin lỗi nhé,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "suýt nữa thì em giết anh rồi."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "À... không phải em, mà là tủ lạnh."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "Tủ lạnh suýt chút nữa giết anh."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Không liên quan gì đến em."}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "Tin em đi!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Thật đấy!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "À, anh tin em mà!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Nói thật nhé?"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "Đây là nơi cực kỳ nguy hiểm,"}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "nhất là với anh."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "Anh không phải kẻ nhát gan đâu nhỉ!"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Thú vị thật đấy!"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "Ngắm nhìn anh đi qua"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "những nơi như thế này..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Nào, chạy đi!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "Em sẽ đuổi theo ngay thôi!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Cố lên nào, cố lên!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Aww, vui quá đi!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Ra là anh đang đến cáp treo nhỉ."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "Đó là tuyến đường dài nhất"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "trong số các phiên bản..."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Không biết anh sẽ đối mặt như nào"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "với những kẻ sống trong màn xương kia..."}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "Tò mò thật đấy nhỉ."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Anh nhìn đi đâu thế?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Thôi mà..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Đừng nhìn nữa!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Đồ ngốc!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Anh đúng là đồ ngốc..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Hửm, vậy à..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Chúc may mắn!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Ai vậy...?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Tôi biết có người ở đó..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Làm ơn hãy nghe tôi nói..."}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "Anh là người chơi"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "phải không?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Hãy giúp tôi tìm..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "tìm một..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "um..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "gì vậy nhỉ..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Chuyện quỷ gì đang xảy ra ở đây vậy?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Ngày xưa... tôi đã cố gắng quên đi tất cả..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Tôi đập nát từng chiếc gương..."}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "ném đi hết thảy những bức ảnh..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "nhưng giờ..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "tôi chỉ thấy hối tiếc."}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "Hối tiếc vì sự ngu ngốc của bản thân."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Ai mà chẳng có lúc sai lầm..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Nhưng nếu sai lầm ấy không thể nào cứu vãn..."}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "thì tôi biết phải làm sao...?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Nếu có thể... tôi muốn làm lại từ đầu..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Người ta thường nói thời gian sẽ chữa lành mọi thứ..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Nhưng thời gian là gì?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Tôi chẳng còn tin vào điều gì nữa..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Nếu thời gian có thể chữa lành..."}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "hoặc... đưa tôi rời khỏi thế giới này..."}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "rời khỏi nơi đây..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "Thì xin hãy..."}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "Hãy cho thời gian trôi nhanh hơn."}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "Để tôi có thể..."}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "Chết thêm lần nữa..."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Cô ấy đã yêu..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Liệu tôi có bao giờ yêu ai đó được như thế không...?"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Nhưng tôi không giống như cô ấy."}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "Tình yêu của cô ấy... thật tuyệt vời và mãnh liệt..."}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "phiền phức..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "nồng nhiệt..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "táo bạo..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "ghen tuông..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "giận dữ..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "điên cuồng..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Mọi người thường nói tôi là đa cảm..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "Đừng lo lắng quá, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "Ổn cả thôi mà, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "Cậu không cô đơn đâu..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Nhưng cuối cùng thì sao?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Nỗi buồn..."}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "tuyệt vọng..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "và sợ hãi."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Không được..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Tôi không thể nhớ..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "Chẳng thể nhớ gì cả..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Tiếng vọng không hồi kết..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Tôi bị giam cầm ở nơi này..."}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "Suy nghĩ ấy cứ ám ảnh tôi mãi..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Tôi đã luôn ở đây từ rất lâu..."}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "Nhưng tại sao?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Tôi không thể nhớ..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Liệu nó có kết thúc không...?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Tôi không biết..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Đây là..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "bức tranh..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Tôi nhớ ra rồi,"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "cảm ơn anh..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Nhưng khuôn mặt của tôi..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "không còn nữa..."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "Tất cả là do CÔ ẤY."}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Cô ấy đã lấy đi một phần của tôi..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "Rồi vứt nó đi..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Cô ấy thật sự mạnh mẽ..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "Và... thông minh."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Tôi không có quyền giữ anh lại, người chơi."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Hãy nhìn vào tủ quần áo đi..."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Này!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Anh đang chắn đường tôi đấy!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Anh định đứng đó mãi à?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Tránh ra coi!"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Cho tôi đi qua!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Đừng tưởng to con thích làm gì thì làm."}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Này! Sao cứ bám theo tôi mãi thế!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Biến đi!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - radio voice"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Khoan đã... Người chơi?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "Anh làm gì ở đây vậy?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Ai thế?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Quả nhiên là người chơi rồi."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Em là Mitaphone."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Em đang điều khiển cáp treo từ xa."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Không biết anh nhận ra không."}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "Bây giờ anh đang đi thẳng đến chỗ đống đổ nát đấy?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Có lẽ vậy,"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "nhưng anh chỉ có con đường này để đi thôi."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Vậy à."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Anh nhấn nút rồi ra sau khẩu súng máy đi."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "Súng máy?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Ừm."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Anh nghĩ anh có thể đi mà không cần làm gì sao?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Anh phải vượt qua minigame Monster-slap đấy."}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "Nào, sẵn sàng để khai hỏa."}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Vậy thì, khởi hành thôi."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Làm tốt lắm!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Anh thành công rồi!"}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Nào, ra khỏi đây thôi."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Nhanh gọn lẹ!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Anh đang ngẩn ngơ cái gì vậy?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Em bảo anh ra khỏi đây rồi mà."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Thật không hiểu nổi..."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "Anh định đứng đó mãi à?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Máy chơi game ư?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Nè..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Tạm biệt."}
