{"category": "LocationDialogue Location17", "line_index": 0, "text": "// Player thinks + Make coffee"}
{"category": "LocationDialogue Location17", "line_index": 1, "text": "Mình cần ai đó giúp ở đây. "}
{"category": "LocationDialogue Location17", "line_index": 2, "text": "Hy vọng Mita ở đây không cắn mình..."}
{"category": "LocationDialogue Location17", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 4, "text": "Mình đang lãng phí thời gian vào cái gì thế này..."}
{"category": "LocationDialogue Location17", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 9, "text": "// Player tries to wake up MitaDreamer"}
{"category": "LocationDialogue Location17", "line_index": 10, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 11, "text": "Mita, dậy đi!"}
{"category": "LocationDialogue Location17", "line_index": 12, "text": "Mita!"}
{"category": "LocationDialogue Location17", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 14, "text": "Mita, dậy đi em!"}
{"category": "LocationDialogue Location17", "line_index": 15, "text": "Anh cần em giúp."}
{"category": "LocationDialogue Location17", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 17, "text": "Fuwa... Ai zợ...?"}
{"category": "LocationDialogue Location17", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 19, "text": "Giúp anh kéo cần gạt với."}
{"category": "LocationDialogue Location17", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 21, "text": "Cần gạt gì cơ?"}
{"category": "LocationDialogue Location17", "line_index": 22, "text": "Buồn ngủ lắm rồi, đừng có làm phiền chứ..."}
{"category": "LocationDialogue Location17", "line_index": 23, "text": "Hay là cho ly cà phê đi..."}
{"category": "LocationDialogue Location17", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 25, "text": "Có hai cái cần gạt lận ấy..."}
{"category": "LocationDialogue Location17", "line_index": 26, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 27, "text": "Mi-ita!"}
{"category": "LocationDialogue Location17", "line_index": 28, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 31, "text": "// Player gives away the coffee"}
{"category": "LocationDialogue Location17", "line_index": 32, "text": "Mita"}
{"category": "LocationDialogue Location17", "line_index": 33, "text": "cà phê của em đây."}
{"category": "LocationDialogue Location17", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 37, "text": "// MitaDreamer exercise"}
{"category": "LocationDialogue Location17", "line_index": 38, "text": "Anh khi nãy"}
{"category": "LocationDialogue Location17", "line_index": 39, "text": "nói cần gạt phải không?"}
{"category": "LocationDialogue Location17", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 41, "text": "Ừm."}
{"category": "LocationDialogue Location17", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 43, "text": "Sao anh lại biết được nhỉ?"}
{"category": "LocationDialogue Location17", "line_index": 44, "text": "À, chắc khỏi cần phải hỏi..."}
{"category": "LocationDialogue Location17", "line_index": 45, "text": "Anh đang ở đây cơ mà."}
{"category": "LocationDialogue Location17", "line_index": 46, "text": "Anh chắc biết rất nhiều thứ rồi..."}
{"category": "LocationDialogue Location17", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 48, "text": "A, chờ chút."}
{"category": "LocationDialogue Location17", "line_index": 49, "text": "Em ngồi xuống cái đã."}
{"category": "LocationDialogue Location17", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 51, "text": "Rồi sao?"}
{"category": "LocationDialogue Location17", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 53, "text": "Anh không biết phải nói sao nữa..."}
{"category": "LocationDialogue Location17", "line_index": 54, "text": "Nhưng anh phải đi tiếp,"}
{"category": "LocationDialogue Location17", "line_index": 55, "text": "men theo con đường mà chiếc nhẫn chỉ dẫn."}
{"category": "LocationDialogue Location17", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 57, "text": "Anh có nhẫn của cô ấy à?"}
{"category": "LocationDialogue Location17", "line_index": 58, "text": "Thì ra là vậy."}
{"category": "LocationDialogue Location17", "line_index": 59, "text": "Bảo sao anh đến được nơi này."}
{"category": "LocationDialogue Location17", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 61, "text": "Phải."}
{"category": "LocationDialogue Location17", "line_index": 62, "text": "Vậy, em giúp anh được không?"}
{"category": "LocationDialogue Location17", "line_index": 63, "text": "Giúp anh kéo cái cần gạt kia."}
{"category": "LocationDialogue Location17", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 65, "text": "Được thôi."}
{"category": "LocationDialogue Location17", "line_index": 66, "text": "Em sẽ giúp."}
{"category": "LocationDialogue Location17", "line_index": 67, "text": "Kéo cần gạt phải hông..."}
{"category": "LocationDialogue Location17", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 70, "text": "Mita, lại ngủ rồi à..."}
{"category": "LocationDialogue Location17", "line_index": 71, "text": "Mau đi thôi nào."}
{"category": "LocationDialogue Location17", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 73, "text": "Hế...?"}
{"category": "LocationDialogue Location17", "line_index": 74, "text": "Ừm."}
{"category": "LocationDialogue Location17", "line_index": 75, "text": "Đi thôi."}
{"category": "LocationDialogue Location17", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 78, "text": "// MitaDreamer fall"}
{"category": "LocationDialogue Location17", "line_index": 79, "text": "Dậy đi em."}
{"category": "LocationDialogue Location17", "line_index": 80, "text": "Buồn ngủ đến thế cơ à?"}
{"category": "LocationDialogue Location17", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 82, "text": "// MitaDreamer again sleep"}
{"category": "LocationDialogue Location17", "line_index": 83, "text": "Dậy đi."}
{"category": "LocationDialogue Location17", "line_index": 84, "text": "Chúng ta tới rồi này."}
{"category": "LocationDialogue Location17", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 87, "text": "// Switches"}
{"category": "LocationDialogue Location17", "line_index": 88, "text": "Okay."}
{"category": "LocationDialogue Location17", "line_index": 89, "text": "Sẵn sàng rồi."}
{"category": "LocationDialogue Location17", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 91, "text": "Bên này cũng vậy."}
{"category": "LocationDialogue Location17", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 93, "text": "Giờ thì."}
{"category": "LocationDialogue Location17", "line_index": 94, "text": "Em bắt đầu"}
{"category": "LocationDialogue Location17", "line_index": 95, "text": "đếm nhé."}
{"category": "LocationDialogue Location17", "line_index": 96, "text": "Hai đứa sẽ cùng lúc gạt cần."}
{"category": "LocationDialogue Location17", "line_index": 97, "text": "Hiểu chưa?"}
{"category": "LocationDialogue Location17", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 99, "text": "Còn em đừng có ngủ quên đấy!"}
{"category": "LocationDialogue Location17", "line_index": 100, "text": "Nào."}
{"category": "LocationDialogue Location17", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 103, "text": "3"}
{"category": "LocationDialogue Location17", "line_index": 104, "text": "2"}
{"category": "LocationDialogue Location17", "line_index": 105, "text": "1"}
{"category": "LocationDialogue Location17", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 107, "text": "// Player lose 1"}
{"category": "LocationDialogue Location17", "line_index": 108, "text": "Anh làm gì vậy?"}
{"category": "LocationDialogue Location17", "line_index": 109, "text": "Thôi được rồi,"}
{"category": "LocationDialogue Location17", "line_index": 110, "text": "lại một lần nữa..."}
{"category": "LocationDialogue Location17", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 112, "text": "// Player lose 2"}
{"category": "LocationDialogue Location17", "line_index": 113, "text": "Lại nữa à?"}
{"category": "LocationDialogue Location17", "line_index": 114, "text": "Mmm..."}
{"category": "LocationDialogue Location17", "line_index": 115, "text": "Buồn ngủ quá..."}
{"category": "LocationDialogue Location17", "line_index": 116, "text": "không chịu nổi..."}
{"category": "LocationDialogue Location17", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 118, "text": "// Player lose 3"}
{"category": "LocationDialogue Location17", "line_index": 119, "text": "Em sắp ngủ tới nơi rồi..."}
{"category": "LocationDialogue Location17", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 122, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 123, "text": "Tuyệt vời!"}
{"category": "LocationDialogue Location17", "line_index": 124, "text": "Cảm ơn em nhiều, Mita."}
{"category": "LocationDialogue Location17", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 126, "text": "Hổng có chi."}
{"category": "LocationDialogue Location17", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 129, "text": "Cửa mở..."}
{"category": "LocationDialogue Location17", "line_index": 130, "text": "chậm..."}
{"category": "LocationDialogue Location17", "line_index": 131, "text": "quá..."}
{"category": "LocationDialogue Location17", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 134, "text": "Em ngủ ây..."}
{"category": "LocationDialogue Location17", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 136, "text": "// Why kitchen?"}
{"category": "LocationDialogue Location17", "line_index": 137, "text": "Vào phòng bếp làm gì vậy?"}
{"category": "LocationDialogue Location17", "line_index": 138, "text": "Em mà ngủ quên trên sàn bếp lạnh lẽo này"}
{"category": "LocationDialogue Location17", "line_index": 139, "text": "thì là lỗi của anh đấy nhé."}
{"category": "LocationDialogue Location17", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 141, "text": "// Why bathroom?"}
{"category": "LocationDialogue Location17", "line_index": 142, "text": "Rốt cuộc..."}
{"category": "LocationDialogue Location17", "line_index": 143, "text": "Anh cần kéo cần gạt nào trong này vậy?"}
{"category": "LocationDialogue Location17", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 145, "text": "// Put button"}
{"category": "LocationDialogue Location17", "line_index": 146, "text": "Không có gì xảy ra?"}
{"category": "LocationDialogue Location17", "line_index": 147, "text": "Thế cái nút này để làm cái gì vậy?"}
{"category": "LocationDialogue Location17", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 149, "text": "// Cofee"}
{"category": "LocationDialogue Location17", "line_index": 150, "text": "Thêm cà phê nữa nhé?"}
{"category": "LocationDialogue Location17", "line_index": 151, "text": "Em lại sắp ngủ rồi kìa."}
{"category": "LocationDialogue Location17", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 153, "text": "Hế?"}
{"category": "LocationDialogue Location17", "line_index": 154, "text": "Không cần âu..."}
{"category": "LocationDialogue Location17", "line_index": 155, "text": "Cà phê này vị nó dở quá à..."}
{"category": "LocationDialogue Location17", "line_index": 156, "text": "Em hoàn toàn... tỉnh táo mà..."}
{"category": "LocationDialogue Location17", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 158, "text": "// Button"}
{"category": "LocationDialogue Location17", "line_index": 159, "text": "Mita? Cái nút không hoạt động... Nghe thấy anh nói không?"}
{"category": "LocationDialogue Location17", "line_index": 160, "text": "Em ơi?"}
