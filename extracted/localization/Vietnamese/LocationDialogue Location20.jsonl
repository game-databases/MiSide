{"category": "LocationDialogue Location20", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Mila! Không...! Khốn nạn!"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Ahaha! TÌM THẤY ANH RỒI!"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "Khuôn mặt đó trông thú vị chưa kìa."}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "Nào! Chơi với em thêm nữa đi!"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "Cứ nhìn mãi một khuôn mặt chán chết đi được!"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\""}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "Chào, khỏe không anh?"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "Chạy nhiều quá chắc cũng chán rồi nhỉ?"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Này! Cô đã làm gì Mila?"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "Vẫn còn mạnh miệng quá ha."}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Được thôi, em sẽ chơi tiếp với anh!"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "Đồ khốn..."}
{"category": "LocationDialogue Location20", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "Ta làm một bài kiểm tra nhỏ nhé!"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "Kiểm tra khả năng hợp tác của anh!"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "Cũng như cách anh hành xử nữa!"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "Nếu như anh có vấn đề thì sao?!"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "Cái VỎ BỌC mà anh đang khoác lên người"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "có lẽ không hợp với anh đâu..."}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "Nào, nhìn này."}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "Anh thấy cái nào hấp dẫn hơn?"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "Bên phải?"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "Hay là"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "bên trái?"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "Anh nghiêm túc đấy à?"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "Nhìn anh không thật lòng lắm nhỉ."}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "Chỉ đùa chút thôi mà!"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "Anh đừng bận tâm. Giết nhau bằng dao lỗi thời rồi..."}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "Mà thôi, bỏ đi."}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "Em nảy ra một ý tưởng còn thú vị hơn."}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "Trước tiên là..."}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "Xem đi này!"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Em máu nghe nhạc rồi!"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "Giai điệu này thế nào?"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "Cực kỳ phấn khích luôn ha!"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "Rồi,"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "bắt đầu đọc luật chơi nào!"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rules"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "Trong khi nhạc đang phát"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "anh có thể di chuyển."}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "Nhưng mà khi nhạc dừng á..."}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "ĐỪNG DI CHUYỂN!"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "Không là chết luôn đấy."}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "Nào, hãy cố gắng tiến tới mục tiêu."}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "Anh có thể làm được mà."}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "Bắt đầu trò chơi thôi!"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "Anh còn đứng đó làm gì nữa?"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Mau chạy đi! Anh yêu, nhanh lên nào!"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "Woa!"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Anh đúng là ngoan quá cơ!"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Phải để mọi người noi gương mới được."}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Muốn lồng anh vào khung kính trưng bày ghê!"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "Cơ mà, chắc mấy cái này đối với anh dễ như ăn kẹo nhỉ?"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "Mau dừng lại ngay!"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "Đừng lơ là!"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "Vẫn còn khối trò hay ho đang chờ anh đó."}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "Được rồi, tiếp tục thôi!"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Giờ em sẽ nhắm mắt lại nhé..."}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "Lần tới khi em mở mắt ra"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "anh phải trốn cho kỹ vào!"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "Nhớ chưa?"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "Em mà thấy được là phải chịu phạt đấy!"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Tốt lắm, chơi thôi nào!"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "Thế này thật vô nghĩa..."}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "Vượt ải thành công!"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Anh làm tốt lắm! Giỏi quá, giỏi quá!"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "Màn tiếp theo sẽ còn khó hơn nữa!"}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "Gấp mấy lần, gấp mấy chục lần luôn..."}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Mau chạy đi! Lẩn trốn đi! Chạy thục mạng đi!"}
{"category": "LocationDialogue Location20", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "Khốn kiếp!!"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Player falls"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "Có lẽ mình thoát được rồi..."}
