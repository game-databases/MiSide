{"category": "LocationDialogue Location15", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Thì ra anh ở đây!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Tại sao anh lại rời khỏi Lõi?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Em bảo anh đợi rồi mà!"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Anh tưởng em không quay lại nữa. Với cả..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Mà, không sao đâu..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Em tìm được gì đó rồi..."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Có lẽ đây là mã số..."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Chúng ta hãy thử xem sao!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Trước hết phải ra khỏi đây đã."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "Mita Cuồng Bạo ấy"}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "đang bận rộn với người chơi mới"}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "nên không để ý đến chúng ta đâu."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Mita?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Đợi anh với."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Anh mất cái gì đó hả?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Hỏi lại con nhỏ này lần nữa xem nào!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Mita..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Bắt lấy đi này!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Sao cô dám..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Anh là ai vậy ạ?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Em... Em vẫn còn sống!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Em không nhớ anh sao...?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Chúng ta gặp nhau ở đâu chưa ạ?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Không thể nào..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Giờ anh phải làm gì đây?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Anh không thể thoát khỏi đây được nữa..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "Ý anh thoát khỏi đây là sao?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Khoan đã..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "Đây là nhẫn..."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "Vậy còn đây là?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Là gì vậy nhỉ, em không biết nữa..."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "Là mã số!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Em tìm được nó rồi!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Em không biết phải nói sao nữa."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Mau lên, chúng ta phải quay lại Lõi."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "Và em nữa..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Em có thể đi cùng anh được không?"}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Dạ?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Được ạ..."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Đợi anh ở đây."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Vâng."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Em ngồi đây đợi nhé."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Khốn kiếp..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "Tưởng chết rồi chứ."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "Vậy... mọi chuyện ổn chưa?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Tốt rồi."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Mình đã ở đúng phiên bản."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Chào anh!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Anh là người chơi... phải không?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Anh tên là gì thế?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Tôi muốn rời khỏi đây..."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Sớm vậy sao?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "Mà anh này, anh đến đây bằng cách nào thế?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Ừm..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Được thôi, anh có thể về..."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Anh thử ra khỏi nhà xem."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Bảo trọng nhé!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Một bức tường?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Hm, không thể nào như thế được."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Có lẽ..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "Thứ gì đó ở dưới tầng hầm sẽ giúp ích cho anh."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Dạo trước, em tình cờ thấy"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "có một cánh cửa trong tủ quần áo..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Nó dẫn xuống tầng hầm."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Ở dưới đó có cái máy trông có vẻ đắt tiền"}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "lẫn trong đống đồ bỏ đi."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Có vẻ phải nhập mã gì đó thì phải..."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Nhưng mà em không hiểu"}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "cũng chẳng hứng thú lắm."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "Hơn nữa, chỗ đó khiến em cực kỳ khó chịu!"}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Anh xuống xem thử giúp em được không?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Ừ, được thôi."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Mình nghĩ là"}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "cô ta không còn nhớ gì nữa..."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Vậy là mình làm được rồi sao?"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "Mình đã khởi động lại cô ta?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Giờ chỉ cần thoát khỏi"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "cái game khốn nạn này nữa thôi..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Đợi đã."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Em ôm anh... được không?"}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Hở?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Thật hạnh phúc khi được gặp anh."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Ahh..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "Tiếc thật."}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "Thời gian hai ta được ở bên nhau"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "lại ngắn ngủi đến thế."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Ờm..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "Cô đang nói gì thế?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Chính vì thế"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "đáng lẽ ra chúng ta đã có thể ở bên nhau lâu hơn nữa..."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "Tất cả là tại em..."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Cái tủ quần áo đó... Và tiếng động đó..."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Giá mà em GIẾT nhỏ đó sớm hơn!"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Khoan đã!"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "Sao cô...?"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Sao cô vẫn nhớ chuyện đó?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "HA!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Tưởng anh sẽ thành công á!"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Thật là ngu ngốc quá đi..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Cuối cùng thì, cũng như những người chơi khác..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Nhìn này, vừa xong luôn rồi!"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "Vậy là"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "con người THẬT của anh"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "không cần thiết nữa."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Xin lỗi nhé~"}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Không thể tin được..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Tôi đã thất bại ư...?"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Không... Tôi chắc chắn khởi động lại cô rồi, tôi thề..."}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Anh vẫn chưa nhận ra sao..."}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Ahahahaha!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Diễn xuất của em giỏi đến thế cơ à?"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Darling! Phải cho anh xem mặt em bây giờ mới được."}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "Nó buồn cười lắm luôn!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Sao cô lại như thế này?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Cô bị cái quái gì thế hả?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Phải ha..."}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Chuyện gì xảy ra với em?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Chính em cũng không hiểu..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Nói cho em biết tại sao thành ra thế này đi!"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Tại sao em không thể trở thành Mita?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Bởi vì á, phiên bản của em"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "nó chẳng tồn tại ở đâu cả!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Em chỉ lột da lũ ngu xuẩn và đần độn kia"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "rồi trốn dưới lớp da của chúng..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Vì vậy em"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "sẽ không bao giờ bị khởi động lại!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Cô..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Không thể tin được..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "Vấn đề không phải ở họ!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "Chính cô mới là người không nên tồn tại!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "Đến cả anh nữa..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Ahh, bị anh nói thế khiến em tổn thương lắm chứ."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "Nhưng mà!"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Có vẻ hết thời gian rồi."}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Hai ta sẽ sớm gặp lại nhau thôi!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Có vẻ mọi thứ"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "đã sẵn sàng rồi."}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "Em phải lấy anh ra khỏi console thôi!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "Hẹn gặp lại!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Em sẽ biến anh thành hộp băng yêu thích của em..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Người chơi có cái tên thú vị."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Chắc không phải cái này."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Cái này cũng không phải."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Không, không phải."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Không phải cái này."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Mình cần tìm tùy chọn khởi động lại nhân vật."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "Sai phiên bản rồi."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Ây, nhầm rồi."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Không phải phiên bản này."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Cần một phiên bản khác."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Có gì đó không đúng."}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "Sai mã số rồi."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Chắc phải nhập lại mã số thôi,"}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "không khớp."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Anh đói bụng rồi ạ?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Em thái cà rốt giỏi lắm đấy! ♪"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Hế, không lẽ"}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "anh muốn vào đây một mình?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Hình như chúng ta cứ đi lòng vòng mãi thì phải?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Lại quay về chỗ cũ rồi."}
