{"category": "LocationDialogue Location13", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 1, "text": "Chiếc nhẫn."}
{"category": "LocationDialogue Location13", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 3, "text": "// Answer 1 (Where have you been all this time?)"}
{"category": "LocationDialogue Location13", "line_index": 4, "text": "Em đã tìm cách để đưa anh tới Lõi."}
{"category": "LocationDialogue Location13", "line_index": 5, "text": "Một cách an toàn và chắc chắn."}
{"category": "LocationDialogue Location13", "line_index": 6, "text": "Đó chính là kế hoạch ban đầu mà anh?"}
{"category": "LocationDialogue Location13", "line_index": 7, "text": "Cũng như việc gặp phải Mita Cuồng bạo"}
{"category": "LocationDialogue Location13", "line_index": 8, "text": "em cố gắng hết sức để tránh né."}
{"category": "LocationDialogue Location13", "line_index": 9, "text": "Đồng thời cũng cần phải thu thập thêm thông tin"}
{"category": "LocationDialogue Location13", "line_index": 10, "text": "về mặt trái của thế giới dị thường này... phải không anh?"}
{"category": "LocationDialogue Location13", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 12, "text": "Hm, phải vậy không ta...?"}
{"category": "LocationDialogue Location13", "line_index": 13, "text": "Anh không biết em thiết lập tuyến đường như nào,"}
{"category": "LocationDialogue Location13", "line_index": 14, "text": "nhưng anh bị đưa đến các phiên bản"}
{"category": "LocationDialogue Location13", "line_index": 15, "text": "toàn lỗi và nguy hiểm."}
{"category": "LocationDialogue Location13", "line_index": 16, "text": "Anh chỉ có thể thoát ra"}
{"category": "LocationDialogue Location13", "line_index": 17, "text": "bằng cách nhảy vào bóng tối vô tận."}
{"category": "LocationDialogue Location13", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 19, "text": "Em xin lỗi, em quên chưa nói cho anh"}
{"category": "LocationDialogue Location13", "line_index": 20, "text": "cụ thể anh phải làm gì..."}
{"category": "LocationDialogue Location13", "line_index": 21, "text": "Nhưng mà, việc anh vượt qua khỏi tất cả... "}
{"category": "LocationDialogue Location13", "line_index": 22, "text": "Đó chính là kế hoạch."}
{"category": "LocationDialogue Location13", "line_index": 23, "text": "Có vẻ mọi chuyện đã diễn ra suôn sẻ."}
{"category": "LocationDialogue Location13", "line_index": 24, "text": "Anh làm tốt lắm!"}
{"category": "LocationDialogue Location13", "line_index": 25, "text": "Nào, chúng ta tiếp tục kế hoạch thôi. Anh sẵn sàng chưa?"}
{"category": "LocationDialogue Location13", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 27, "text": "// Answer 2 (How did you get here?)"}
{"category": "LocationDialogue Location13", "line_index": 28, "text": "Anh hẳn đã trải qua rất nhiều chuyện nhỉ."}
{"category": "LocationDialogue Location13", "line_index": 29, "text": "Vì vậy mà anh quên mất những gì mình đã nói với nhau sao?"}
{"category": "LocationDialogue Location13", "line_index": 30, "text": "Em là Mita, em có thể di chuyển qua lại giữa các phiên bản."}
{"category": "LocationDialogue Location13", "line_index": 31, "text": "Anh nhớ ra rồi chứ?"}
{"category": "LocationDialogue Location13", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 33, "text": "Không phải Mita nào cũng làm được điều đó đâu."}
{"category": "LocationDialogue Location13", "line_index": 34, "text": "Anh đã tận mắt chứng kiến."}
{"category": "LocationDialogue Location13", "line_index": 35, "text": "Mọi người, ai cũng đang chìm trong đau khổ─"}
{"category": "LocationDialogue Location13", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 37, "text": "Dừng lại đi. Phiên bản của họ đã bị hỏng rồi."}
{"category": "LocationDialogue Location13", "line_index": 38, "text": "Thế giới này toàn lỗi... Anh đã từng nói rồi mà?"}
{"category": "LocationDialogue Location13", "line_index": 39, "text": "Thật kinh khủng..."}
{"category": "LocationDialogue Location13", "line_index": 40, "text": "Anh hẳn phải biết ai là kẻ đứng sau tất cả chuyện này rồi chứ."}
{"category": "LocationDialogue Location13", "line_index": 41, "text": "Mita Cuồng Bạo."}
{"category": "LocationDialogue Location13", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 43, "text": "Ừ, ả ta là chắc rồi..."}
{"category": "LocationDialogue Location13", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 45, "text": "// Answer 3 (Who was this Mita just now?)"}
{"category": "LocationDialogue Location13", "line_index": 46, "text": "Là Mita Xấu Xí đó anh."}
{"category": "LocationDialogue Location13", "line_index": 47, "text": "Hung hăng và ngốc nghếch."}
{"category": "LocationDialogue Location13", "line_index": 48, "text": "Chẳng thể nào nói chuyện được với cô ấy đâu."}
{"category": "LocationDialogue Location13", "line_index": 49, "text": "Trong đầu cô ấy chỉ nghĩ về \"Mita Cuồng Bạo\" thôi."}
{"category": "LocationDialogue Location13", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 51, "text": "À, hiểu rồi."}
{"category": "LocationDialogue Location13", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 53, "text": "Nào, chúng ta phải vào Lõi thôi."}
{"category": "LocationDialogue Location13", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 55, "text": "// Answer 4 (How does the ring work?)"}
{"category": "LocationDialogue Location13", "line_index": 56, "text": "Về chiếc nhẫn này"}
{"category": "LocationDialogue Location13", "line_index": 57, "text": "không còn đường nào khác để đến Lõi sao?"}
{"category": "LocationDialogue Location13", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 59, "text": "Vâng."}
{"category": "LocationDialogue Location13", "line_index": 60, "text": "Nếu có thể tạo ra cổng dịch chuyển"}
{"category": "LocationDialogue Location13", "line_index": 61, "text": "thì ta đã có thể"}
{"category": "LocationDialogue Location13", "line_index": 62, "text": "dịch chuyển đến đây ngay lập tức rồi."}
{"category": "LocationDialogue Location13", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 64, "text": "Ngoài ra chiếc nhẫn này còn công dụng nào nữa không?"}
{"category": "LocationDialogue Location13", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 66, "text": "Còn đó anh!"}
{"category": "LocationDialogue Location13", "line_index": 67, "text": "Nó rất dễ đeo"}
{"category": "LocationDialogue Location13", "line_index": 68, "text": "và sẽ ghi nhớ lại những phiên bản"}
{"category": "LocationDialogue Location13", "line_index": 69, "text": "mà anh đã từng đến"}
{"category": "LocationDialogue Location13", "line_index": 70, "text": "để anh có thể quay lại bất cứ lúc nào."}
{"category": "LocationDialogue Location13", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 72, "text": "// Answer 5 (Why does Mad Mita need me?)"}
{"category": "LocationDialogue Location13", "line_index": 73, "text": "Tại sao Mita Cuồng Bạo kia nhắm vào anh?"}
{"category": "LocationDialogue Location13", "line_index": 74, "text": "Anh đã bị lôi vào trò chơi nguy hiểm của cô ta"}
{"category": "LocationDialogue Location13", "line_index": 75, "text": "vậy mà anh vẫn còn sống..."}
{"category": "LocationDialogue Location13", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 77, "text": "Có lẽ"}
{"category": "LocationDialogue Location13", "line_index": 78, "text": "cô ấy đang tìm một người chơi lý tưởng..."}
{"category": "LocationDialogue Location13", "line_index": 79, "text": "Một người có thể chấp nhận con người thật của cô ấy."}
{"category": "LocationDialogue Location13", "line_index": 80, "text": "Rốt cuộc, Mita vẫn là Mita!"}
{"category": "LocationDialogue Location13", "line_index": 81, "text": "Nghe có vẻ khó tin"}
{"category": "LocationDialogue Location13", "line_index": 82, "text": "nhưng vì thế mà cô ấy đã biến người chơi thành hộp băng."}
{"category": "LocationDialogue Location13", "line_index": 83, "text": "Để không ai có thể chạy thoát khỏi cô ấy..."}
{"category": "LocationDialogue Location13", "line_index": 84, "text": "Em chỉ có thể nói vậy thôi."}
{"category": "LocationDialogue Location13", "line_index": 85, "text": "Quay lại chủ đề chính nào."}
{"category": "LocationDialogue Location13", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 87, "text": "// Answer 6 (Is this the core?)"}
{"category": "LocationDialogue Location13", "line_index": 88, "text": "Chỗ đó là gì thế?"}
{"category": "LocationDialogue Location13", "line_index": 89, "text": "Lõi phải không?"}
{"category": "LocationDialogue Location13", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 91, "text": "Vâng, là lõi."}
{"category": "LocationDialogue Location13", "line_index": 92, "text": "Như em đã giải thích trước đó"}
{"category": "LocationDialogue Location13", "line_index": 93, "text": "người chơi không phải là một phần của thế giới này..."}
{"category": "LocationDialogue Location13", "line_index": 94, "text": "Nói cách khác, người chơi có thể vào đây mà không cần sự cho phép."}
{"category": "LocationDialogue Location13", "line_index": 95, "text": "Đây chỉ là suy đoán của em thôi..."}
{"category": "LocationDialogue Location13", "line_index": 96, "text": "Nhưng chắc chắn một điều"}
{"category": "LocationDialogue Location13", "line_index": 97, "text": "trong căn phòng này"}
{"category": "LocationDialogue Location13", "line_index": 98, "text": "chứa đựng lời giải đáp cho mọi vấn đề!"}
{"category": "LocationDialogue Location13", "line_index": 99, "text": "[player], mời anh vào trong."}
{"category": "LocationDialogue Location13", "line_index": 100, "text": "Anh bước vào rồi nhỉ."}
{"category": "LocationDialogue Location13", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 102, "text": "// Look on CoreMita"}
{"category": "LocationDialogue Location13", "line_index": 103, "text": "Hãy cẩn thận, [player]."}
{"category": "LocationDialogue Location13", "line_index": 104, "text": "Thứ đó đang quan sát anh."}
{"category": "LocationDialogue Location13", "line_index": 105, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 106, "text": "Ai cơ?"}
{"category": "LocationDialogue Location13", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 108, "text": "Em cũng không chắc lắm..."}
{"category": "LocationDialogue Location13", "line_index": 109, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 110, "text": "Tuyệt..."}
{"category": "LocationDialogue Location13", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 113, "text": "Đó là gì vậy anh?"}
{"category": "LocationDialogue Location13", "line_index": 114, "text": "A!"}
{"category": "LocationDialogue Location13", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 116, "text": "Anh nghĩ anh tìm thấy rồi!"}
{"category": "LocationDialogue Location13", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 118, "text": "Tuyệt quá! Không hổ danh!"}
{"category": "LocationDialogue Location13", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 120, "text": "Nhưng anh phải chỉ định phiên bản nữa."}
{"category": "LocationDialogue Location13", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 122, "text": "Ừm... Phiên bản của cô ấy là..."}
{"category": "LocationDialogue Location13", "line_index": 123, "text": "00.98."}
{"category": "LocationDialogue Location13", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 125, "text": "Bingo!"}
{"category": "LocationDialogue Location13", "line_index": 126, "text": "Vậy, mã số là gì?"}
{"category": "LocationDialogue Location13", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 128, "text": "Mã số?"}
{"category": "LocationDialogue Location13", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 130, "text": "Anh cần nhập mã số."}
{"category": "LocationDialogue Location13", "line_index": 131, "text": "Không lẽ em không biết...?"}
{"category": "LocationDialogue Location13", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 134, "text": "Ra là vậy, xin chờ một chút..."}
{"category": "LocationDialogue Location13", "line_index": 135, "text": "Quả thực mỗi Mita đều có một mã số riêng."}
{"category": "LocationDialogue Location13", "line_index": 136, "text": "Và không thể khởi động lại tất cả các phiên bản cùng một lúc..."}
{"category": "LocationDialogue Location13", "line_index": 137, "text": "Làm vậy sẽ gây ra hỗn loạn mất!"}
{"category": "LocationDialogue Location13", "line_index": 138, "text": "Em hoàn toàn không lường trước được điều này..."}
{"category": "LocationDialogue Location13", "line_index": 139, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 144, "text": "// Answer 1 (What's wrong with you?)"}
{"category": "LocationDialogue Location13", "line_index": 145, "text": "Em vẫn ổn."}
{"category": "LocationDialogue Location13", "line_index": 146, "text": "Phải giải quyết vấn đề trước mắt thôi..."}
{"category": "LocationDialogue Location13", "line_index": 147, "text": "Mọi chuyện hết sức tồi tệ."}
{"category": "LocationDialogue Location13", "line_index": 148, "text": "Phải nghĩ cách gì đó mới được..."}
{"category": "LocationDialogue Location13", "line_index": 149, "text": "Em đang bí rồi."}
{"category": "LocationDialogue Location13", "line_index": 150, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 151, "text": "// Answer 2 (Maybe there's a way to get to know him?)"}
{"category": "LocationDialogue Location13", "line_index": 152, "text": "Như..."}
{"category": "LocationDialogue Location13", "line_index": 153, "text": "Như thế quá vô lý...!"}
{"category": "LocationDialogue Location13", "line_index": 154, "text": "Quá sức điên rồ!"}
{"category": "LocationDialogue Location13", "line_index": 155, "text": "Giống như mò kim đáy bể vậy..."}
{"category": "LocationDialogue Location13", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 157, "text": "Vậy thì phải làm sao?"}
{"category": "LocationDialogue Location13", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 159, "text": "Nơi phát sinh lỗi đôi khi sẽ để lộ ra thông tin."}
{"category": "LocationDialogue Location13", "line_index": 160, "text": "Giống như nó nôn ra nội tạng của thế giới này!"}
{"category": "LocationDialogue Location13", "line_index": 161, "text": "Log, log, log, dữ liệu...?"}
{"category": "LocationDialogue Location13", "line_index": 162, "text": "Nếu đúng là như vậy thì...?"}
{"category": "LocationDialogue Location13", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 164, "text": "Hửm? Sao thế?"}
{"category": "LocationDialogue Location13", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 166, "text": "Em biết một nơi!"}
{"category": "LocationDialogue Location13", "line_index": 167, "text": "Hãy đợi em ở đây."}
{"category": "LocationDialogue Location13", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 169, "text": "Em định đi đâu?"}
{"category": "LocationDialogue Location13", "line_index": 170, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 171, "text": "// Answer 3 (What if we attack Mad Mita?)"}
{"category": "LocationDialogue Location13", "line_index": 172, "text": "Em nói là sau khi Mita chết"}
{"category": "LocationDialogue Location13", "line_index": 173, "text": "họ sẽ bị khởi động lại..."}
{"category": "LocationDialogue Location13", "line_index": 174, "text": "Vậy nếu như chúng ta..."}
{"category": "LocationDialogue Location13", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 176, "text": "Chỉ cần giết Mita Cuồng Bạo thì sao ư?"}
{"category": "LocationDialogue Location13", "line_index": 177, "text": "Anh nghiêm túc chứ...?"}
{"category": "LocationDialogue Location13", "line_index": 178, "text": "Anh định đối mặt với một mụ điên cầm cưa máy kiểu gì?"}
{"category": "LocationDialogue Location13", "line_index": 179, "text": "Cái này không đơn giản như thái cà rốt đâu!"}
{"category": "LocationDialogue Location13", "line_index": 180, "text": "Em không hiểu sao cô ấy lại khỏe kinh khủng."}
{"category": "LocationDialogue Location13", "line_index": 181, "text": "Thật kỳ diệu khi chúng ta vẫn còn sống..."}
{"category": "LocationDialogue Location13", "line_index": 182, "text": "Đi thôi anh. Chỉ còn cách xử lý Lõi thôi."}
{"category": "LocationDialogue Location13", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 185, "text": "// core console entry"}
{"category": "LocationDialogue Location13", "line_index": 186, "text": "Mình cần mật mã..."}
{"category": "LocationDialogue Location13", "line_index": 187, "text": "Nhưng mật mã là gì nhỉ?"}
{"category": "LocationDialogue Location13", "line_index": 188, "text": "Em có biết không, Mita?"}
{"category": "LocationDialogue Location13", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 190, "text": "Có thể nó được ghi ở đâu đó."}
{"category": "LocationDialogue Location13", "line_index": 191, "text": "Anh tìm giúp em được không?"}
{"category": "LocationDialogue Location13", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 193, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location13", "line_index": 194, "text": "Chắc không phải cái này."}
{"category": "LocationDialogue Location13", "line_index": 195, "text": "Cái này cũng không phải."}
{"category": "LocationDialogue Location13", "line_index": 196, "text": "Không, không phải."}
{"category": "LocationDialogue Location13", "line_index": 197, "text": "Không phải cái này."}
{"category": "LocationDialogue Location13", "line_index": 198, "text": "Mình cần tìm tùy chọn \"khởi động lại nhân vật\"."}
{"category": "LocationDialogue Location13", "line_index": 199, "text": "// core console - nope version"}
{"category": "LocationDialogue Location13", "line_index": 200, "text": "Sai phiên bản rồi."}
{"category": "LocationDialogue Location13", "line_index": 201, "text": "Ây, nhầm rồi."}
{"category": "LocationDialogue Location13", "line_index": 202, "text": "Không phải phiên bản này."}
{"category": "LocationDialogue Location13", "line_index": 203, "text": "Cần một phiên bản khác."}
{"category": "LocationDialogue Location13", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location13", "line_index": 205, "text": "Có gì đó không đúng."}
{"category": "LocationDialogue Location13", "line_index": 206, "text": "Sai mã số rồi."}
{"category": "LocationDialogue Location13", "line_index": 207, "text": "Chắc phải nhập lại mã số thôi,"}
{"category": "LocationDialogue Location13", "line_index": 208, "text": "không khớp."}
{"category": "LocationDialogue Location13", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 210, "text": "// Answer 4 (Little people - Chibi)"}
{"category": "LocationDialogue Location13", "line_index": 211, "text": "Dọc đường đi anh có gặp"}
{"category": "LocationDialogue Location13", "line_index": 212, "text": "nhóm người tí hon..."}
{"category": "LocationDialogue Location13", "line_index": 213, "text": "Em biết họ là gì không?"}
{"category": "LocationDialogue Location13", "line_index": 214, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 215, "text": "Ý anh là Chibi phải không?"}
{"category": "LocationDialogue Location13", "line_index": 216, "text": "Khó mà diễn tả được... "}
{"category": "LocationDialogue Location13", "line_index": 217, "text": "Nó là một hiện tượng đặc biệt trong thế giới bọn em."}
{"category": "LocationDialogue Location13", "line_index": 218, "text": "Bất kỳ Mita nào cũng mang trong mình hình bóng của một Chibi."}
{"category": "LocationDialogue Location13", "line_index": 219, "text": "Người chơi cũng có thể có, nhưng..."}
{"category": "LocationDialogue Location13", "line_index": 220, "text": "Mita có thể triệu hồi chúng. Anh biết điều đó không?"}
{"category": "LocationDialogue Location13", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 222, "text": "Bằng cách nào?"}
{"category": "LocationDialogue Location13", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 224, "text": "Hãy nhìn em này!"}
{"category": "LocationDialogue Location13", "line_index": 225, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 226, "text": "Như ma thuật vậy..."}
{"category": "LocationDialogue Location13", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 228, "text": "Nhưng mà, Chibi của em có vẻ không bình thường cho lắm."}
{"category": "LocationDialogue Location13", "line_index": 229, "text": "Hầu như chúng đều chết khi sinh ra."}
{"category": "LocationDialogue Location13", "line_index": 230, "text": "À, có một con hơi khác một chút."}
{"category": "LocationDialogue Location13", "line_index": 231, "text": "Nhưng mà..."}
{"category": "LocationDialogue Location13", "line_index": 232, "text": "Em nó chỉ loanh quanh một chỗ thôi."}
