{"category": "LocationDialogue Location6", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "Mita?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "Làm sao anh tới được đây?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Em là Mita phải không?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Nhưng hình như có gì đó không đúng..."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "À, thì ra là vậy..."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "Em đúng là Mita,"}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "nhưng em không phải Mita mà anh biết."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Cẩn thận đấy anh. Cô ấy đang ấp ủ"}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "mưu đồ rất xấu xa."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "Hả, xấu xa gì cơ?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "Không còn thời gian đâu"}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "nếu mọi thứ suôn sẻ, em sẽ kể cho anh mọi chuyện."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Anh hãy tìm chìa khóa ở gần ghế sofa."}
{"category": "LocationDialogue Location6", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Nhưng..."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "Hỏi han để sau đi!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Đưa cho em chìa khóa."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Với cả chiếc nhẫn này nữa."}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "Nhẫn?"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Anh muốn rời khỏi đây phải không?"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "À, anh muốn..."}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Vậy thì đeo vào ngón tay đi."}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "Nó sẽ giúp ích cho anh."}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "Anh sẽ sớm cần đến nó thôi."}
{"category": "LocationDialogue Location6", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Được rồi..."}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "Nhân tiện, anh là"}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Tên của anh thật đẹp."}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "Em là... Mita."}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// MitaKind quest 1"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "Anh thấy"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "console đó chứ? Cầm lấy nó đi."}
{"category": "LocationDialogue Location6", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "Đây là đoạn ghi hình à?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "Ai đang ở cùng với cô ấy vậy?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "Không phải đoạn ghi hình đâu."}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "Đó là một người chơi khác."}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Cô ấy đang lợi dụng người đó."}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Anh cũng vậy,"}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "coi chừng anh cũng bị biến thành hộp băng đấy."}
{"category": "LocationDialogue Location6", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "Chúng ta phải rời khỏi đây ngay."}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "Cả em nữa."}
{"category": "LocationDialogue Location6", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "Vâng, tất nhiên rồi."}
{"category": "LocationDialogue Location6", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "Vậy... em nói là cô ấy"}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "đang lợi dụng người chơi nhỉ?"}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "Nếu anh rút hộp băng ra thì sẽ thế nào?"}
{"category": "LocationDialogue Location6", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "Hộp băng có khả năng sẽ bị hỏng"}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "không thể sửa chữa được."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "Như vậy có nghĩa là..."}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "người chơi sẽ chết."}
{"category": "LocationDialogue Location6", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "..."}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "Thế nếu anh tắt console đi thì sao?"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "A, nghe có vẻ được đấy..."}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Anh hãy thử xem. Có một nút màu đỏ ở đó!"}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Anh thấy không?"}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "Thấy rồi."}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "Anh nhấn đi."}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// MitaKind quest 2"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Em cần phải ở lại đây."}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "Có điều em muốn hỏi cô ấy."}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "Em cần hiểu rõ hơn về cô ấy."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "Mặc dù bọn em khó để nói chuyện tử tế với nhau được..."}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// MitaKind quest 3"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "Thực ra, đây là phiên bản của em."}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "Em đang ở cùng một người chơi,"}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "bỗng nhiên mọi thứ bị đảo lộn."}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "Rồi cô ấy xuất hiện..."}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "cô ấy biến người chơi thành hộp băng"}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "và em thì bị nhốt ở đây."}
{"category": "LocationDialogue Location6", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Gì cơ? Biến thành hộp băng?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "Sao lại có thể như vậy?"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "Nhưng mà tại sao?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "Cô ấy cần người chơi để làm gì?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "Cô ấy hoàn toàn bị điên rồi..."}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Một con quỷ độc ác chỉ biết thỏa mãn thú vui của bản thân!"}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "Những người chơi bị biến thành hộp băng..."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Họ hoàn toàn không nghi ngờ gì cô ấy cả..."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "Kể cả những người nhận ra, họ cũng không hề kháng cự..."}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "Thật kinh khủng..."}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "Xin anh hãy giúp bọn em!"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "Anh ư? Làm thế nào?"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "Người chơi, bọn em cần anh!"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "Chúng ta phải giúp đỡ lẫn nhau!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Không còn cơ hội nào nữa đâu."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "Chiếc nhẫn sẽ chỉ dẫn cho anh đến đúng phiên bản."}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "Ta sẽ gặp lại nhau tại đó!"}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// MitaKind quest 4"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "Anh vẫn chưa hiểu"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "chuyện gì diễn ra khi nãy..."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Mita đó..."}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "Không lẽ cô ấy muốn giết anh?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "Giết thôi ư?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Có thể cô ấy còn định làm điều gì đó kinh khủng hơn..."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "Anh hãy mau lên."}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Hide!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "Chết rồi! Trốn đi anh!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Hả, gì cơ...?"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Mau lên, cô ấy đang tới!"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "Hãy đi theo chiếc nhẫn! Nó sẽ chỉ cho anh đến chỗ an toàn!"}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "Nào, nói cho tôi biết anh ấy đang ở đâu?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "Không đời nào!"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "Cô sẽ không giết anh ấy đâu phải không?"}
{"category": "LocationDialogue Location6", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Hửm, không chịu nói cơ à."}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Được thôi, tôi thích chơi trốn tìm lắm đấy."}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "Chắc chỉ đâu đó quanh đây thôi phải không."}
{"category": "LocationDialogue Location6", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "Sao cô lại tàn nhẫn với chúng tôi đến vậy?"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "Hãy cho tôi biết chuyện gì đang diễn ra đi!"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "Hơn nữa..."}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "Những người chơi kia, cô định làm gì với họ?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "Họ không phải là đồ chơi!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "Rốt cuộc chuyện gì khiến cô nóng giận như vậy?!"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "Hư! Ngậm cái miệng lại, con rối gỗ này nữa!"}
