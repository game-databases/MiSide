{"category": "MiniGame MakeManeken", "line_index": 19, "text": ""}
{"category": "MiniGame MakeManeken", "line_index": 20, "text": "// Tutorial"}
{"category": "MiniGame MakeManeken", "line_index": 21, "text": "Hm? Sao tôi lại ở đây nhỉ?"}
{"category": "MiniGame MakeManeken", "line_index": 22, "text": "Tôi cần phải vào màn hình của cậu..."}
{"category": "MiniGame MakeManeken", "line_index": 23, "text": "Ngay bây giờ!"}
{"category": "MiniGame MakeManeken", "line_index": 24, "text": "Được rồi, giờ thì..."}
{"category": "MiniGame MakeManeken", "line_index": 25, "text": "Cậu cần phải đảm bảo nguyên mẫu này là đúng."}
{"category": "MiniGame MakeManeken", "line_index": 26, "text": "Trước tiên, hãy quét nó đi."}
{"category": "MiniGame MakeManeken", "line_index": 27, "text": "Tiếp theo, kiểm tra phiên bản và số xương."}
{"category": "MiniGame MakeManeken", "line_index": 28, "text": "Lấy dữ liệu của nguyên mẫu này và so sánh với phiên bản tiêu chuẩn."}
{"category": "MiniGame MakeManeken", "line_index": 29, "text": "Khớp rồi! Bây giờ hãy kiểm tra cảm xúc."}
{"category": "MiniGame MakeManeken", "line_index": 30, "text": "Mẫu vật đã thể hiện cảm xúc thành công! Đến lúc kiểm tra hành vi."}
{"category": "MiniGame MakeManeken", "line_index": 31, "text": "Được rồi, tất cả đều khớp! Bây giờ kéo cần gạt lên."}
{"category": "MiniGame MakeManeken", "line_index": 32, "text": "Tuyệt vời! Mặc xong lớp da rồi! Giờ đưa cho cô ấy hộp quần áo đi."}
{"category": "MiniGame MakeManeken", "line_index": 33, "text": "Chuẩn rồi đó! Thấy mấy cái đèn ở trên kia không? Có một cái chuyển sang màu xanh, nghĩa là chúng ta làm đúng rồi đấy!"}
{"category": "MiniGame MakeManeken", "line_index": 34, "text": "Còn giờ đến lượt cậu! Tôi sẽ quay lại ngay khi tất cả đèn chuyển sang màu xanh. Chúc may mắn!"}
