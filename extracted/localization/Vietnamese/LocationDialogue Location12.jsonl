{"category": "LocationDialogue Location12", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Ở đây đợi nhé."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Tôi đánh rơi gì đó rồi. Tôi sẽ quay lại ngay thôi."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "Xong rồi... ta sẽ đến một thế giới mới."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Tôi hiểu rồi."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Hãy chơi nào!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Tôi muốn gấu bông!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "Tôi làm mất em ấy rồi..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "Tìm EM ẤY cho tôi!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Này..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "Anh đang nhìn cái gì?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Quest 1 (Who are you?)"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Tôi là Mita."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "Mita vĩ đại nhất."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "Mita đầu đời."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "Mita đã nói vậy, Mita của tôi."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Quest 2 (Why do you look like that?)"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "Trông tôi thế nào?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "Trông tôi thế nào?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "Trông tôi thế nào?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "Mita của tôi nói tôi xinh đẹp và độc đáo."}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "Chính tôi chứ ai!"}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Quest 3 (What was Mita doing here?)"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Cô ấy sẽ đưa tôi đi."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Chúng tôi sẽ sống trong một thế giới mới."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "Mita của tôi đã mời tôi."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Cô ấy sẽ đưa tôi đi. Và chúng tôi sẽ cùng nhau vui đùa."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Quest 4 (Why do you need a teddy bear?)"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "Anh là một chú gấu nhỏ,"}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "anh bị lạc"}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "giống như gấu bông của tôi."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Quest 5 (Why is Mita angry?)"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "Mita..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "của tôi."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Cô ấy muốn chơi."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Cô ấy chỉ muốn"}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "tôi."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Chúng tôi là bản gốc."}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "Chúng tôi là độc nhất,"}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Mita và Mita của tôi,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0.8A và 8�54*."}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Quest 6 (Do you believe Mita?)"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "Mita của tôi."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "Người bạn thân nhất của tôi."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "Mita của tôi."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "Người bạn duy nhất của tôi."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "Chính là anh!"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Nào."}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Chơi thôi!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Để tôi chỉ anh cách chơi."}
