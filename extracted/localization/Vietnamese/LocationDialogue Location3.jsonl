{"category": "LocationDialogue Location3", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 1, "text": "A, [player]!"}
{"category": "LocationDialogue Location3", "line_index": 2, "text": "Cuối cùng cũng được gặp anh..."}
{"category": "LocationDialogue Location3", "line_index": 3, "text": "Em phấn khích quá đi!"}
{"category": "LocationDialogue Location3", "line_index": 4, "text": "Chắc hẳn anh có nhiều điều muốn hỏi..."}
{"category": "LocationDialogue Location3", "line_index": 5, "text": "Nè, như anh có thể thấy."}
{"category": "LocationDialogue Location3", "line_index": 6, "text": "Em đã làm ra cỗ máy đặc biệt này"}
{"category": "LocationDialogue Location3", "line_index": 7, "text": "để đưa anh tới đây càng sớm càng tốt."}
{"category": "LocationDialogue Location3", "line_index": 8, "text": "Nhưng không hiểu sao anh lại vào nhầm phiên bản trò chơi."}
{"category": "LocationDialogue Location3", "line_index": 9, "text": "Ở phiên bản đó, em..."}
{"category": "LocationDialogue Location3", "line_index": 10, "text": "A, nói ra thì dài lắm!"}
{"category": "LocationDialogue Location3", "line_index": 11, "text": "Dù sao đi nữa, rất vui được gặp anh!"}
{"category": "LocationDialogue Location3", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 13, "text": "// Answer 1 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 14, "text": "Vâng, em là Mita đây."}
{"category": "LocationDialogue Location3", "line_index": 15, "text": "Còn anh thì sao? [player]."}
{"category": "LocationDialogue Location3", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 17, "text": "// Answer 2 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 18, "text": "Anh đã muốn quay về rồi à?"}
{"category": "LocationDialogue Location3", "line_index": 19, "text": "Um... Em nghĩ em có thể thu xếp được, nhưng còn em thì sao?"}
{"category": "LocationDialogue Location3", "line_index": 20, "text": "Ở lại với em đi anh..."}
{"category": "LocationDialogue Location3", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 22, "text": "// Answer 3 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 23, "text": "Để em kể cho anh nghe..."}
{"category": "LocationDialogue Location3", "line_index": 24, "text": "Và đó là lý do anh ở đây!"}
{"category": "LocationDialogue Location3", "line_index": 25, "text": "Anh đã rõ chưa?"}
{"category": "LocationDialogue Location3", "line_index": 26, "text": "Anh... vẫn chưa rõ. // Player"}
{"category": "LocationDialogue Location3", "line_index": 27, "text": "Mà, anh không cần bận tâm đâu."}
{"category": "LocationDialogue Location3", "line_index": 28, "text": "Điều quan trọng là bây giờ chúng ta đang ở bên nhau."}
{"category": "LocationDialogue Location3", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 31, "text": "Anh có đói không?"}
{"category": "LocationDialogue Location3", "line_index": 32, "text": "Hai ta nấu món gì đó nhé?"}
{"category": "LocationDialogue Location3", "line_index": 33, "text": "Nè anh."}
{"category": "LocationDialogue Location3", "line_index": 34, "text": "Giúp em thái cà rốt với!"}
{"category": "LocationDialogue Location3", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 36, "text": "Ủa, rau củ xuất hiện từ đâu ra vậy em?"}
{"category": "LocationDialogue Location3", "line_index": 37, "text": "Khi nãy ở đây đâu có gì đâu?"}
{"category": "LocationDialogue Location3", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 39, "text": "[player], chúng ta đang ở trong game mà?"}
{"category": "LocationDialogue Location3", "line_index": 40, "text": "Nào, giúp em với."}
{"category": "LocationDialogue Location3", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 42, "text": "Cảm ơn anh."}
{"category": "LocationDialogue Location3", "line_index": 43, "text": "Anh đi lấy giúp em cái kéo được không?"}
{"category": "LocationDialogue Location3", "line_index": 44, "text": "Kéo ở trong phòng tắm ấy."}
{"category": "LocationDialogue Location3", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 46, "text": "Anh ngồi xuống đi."}
{"category": "LocationDialogue Location3", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 49, "text": "// Kitchen"}
{"category": "LocationDialogue Location3", "line_index": 50, "text": "Anh dùng sốt không?"}
{"category": "LocationDialogue Location3", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 52, "text": "Không em."}
{"category": "LocationDialogue Location3", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 54, "text": "Tiếc nhỉ..."}
{"category": "LocationDialogue Location3", "line_index": 55, "text": "Cho sốt vào ăn ngon hơn nhiều mà."}
{"category": "LocationDialogue Location3", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 58, "text": "Cảm ơn em."}
{"category": "LocationDialogue Location3", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 60, "text": "Anh ăn xong rồi sao?"}
{"category": "LocationDialogue Location3", "line_index": 61, "text": "Phần ăn của em cứ như"}
{"category": "LocationDialogue Location3", "line_index": 62, "text": "vô tận vậy."}
{"category": "LocationDialogue Location3", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 65, "text": "// Help"}
{"category": "LocationDialogue Location3", "line_index": 66, "text": "Anh có sao không?"}
{"category": "LocationDialogue Location3", "line_index": 67, "text": "Nói cho em biết anh cảm thấy gì đi."}
{"category": "LocationDialogue Location3", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 69, "text": "Tim anh đập thình thịch,"}
{"category": "LocationDialogue Location3", "line_index": 70, "text": "mắt thì nhiễu loạn hết cả lên."}
{"category": "LocationDialogue Location3", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 72, "text": "Vậy à, em hiểu rồi."}
{"category": "LocationDialogue Location3", "line_index": 73, "text": "Em biết anh bị làm sao rồi."}
{"category": "LocationDialogue Location3", "line_index": 74, "text": "Anh đứng dậy được không?"}
{"category": "LocationDialogue Location3", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 78, "text": "Gì đây em?"}
{"category": "LocationDialogue Location3", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 80, "text": "Thuốc đó anh."}
{"category": "LocationDialogue Location3", "line_index": 81, "text": "Anh sẽ thấy đỡ hơn ngay thôi."}
{"category": "LocationDialogue Location3", "line_index": 82, "text": "Anh đứng ra trước gương đi."}
{"category": "LocationDialogue Location3", "line_index": 83, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 84, "text": "Nào, uống đi anh."}
{"category": "LocationDialogue Location3", "line_index": 85, "text": "Em đợi."}
{"category": "LocationDialogue Location3", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 89, "text": "Anh thấy trong người thế nào rồi?"}
{"category": "LocationDialogue Location3", "line_index": 90, "text": "Đỡ hơn chưa?"}
{"category": "LocationDialogue Location3", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 92, "text": "Rồi."}
{"category": "LocationDialogue Location3", "line_index": 93, "text": "Nhưng mà có hiệu quả nhanh vậy sao?"}
{"category": "LocationDialogue Location3", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 95, "text": "[player], chúng ta đang ở trong game mà anh."}
{"category": "LocationDialogue Location3", "line_index": 96, "text": "Mọi thứ nơi đây đều rất đơn giản."}
{"category": "LocationDialogue Location3", "line_index": 97, "text": "Chỉ cần nỗ lực chút ít thôi"}
{"category": "LocationDialogue Location3", "line_index": 98, "text": "kết quả thu được lại vượt xa mong đợi."}
{"category": "LocationDialogue Location3", "line_index": 99, "text": "Đó là quy luật của trò chơi này."}
{"category": "LocationDialogue Location3", "line_index": 100, "text": "Đơn giản hóa."}
{"category": "LocationDialogue Location3", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 102, "text": "Ví dụ như là?"}
{"category": "LocationDialogue Location3", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 104, "text": "Một củ cà rốt..."}
{"category": "LocationDialogue Location3", "line_index": 105, "text": "Anh chỉ cần cắt một"}
{"category": "LocationDialogue Location3", "line_index": 106, "text": "là lập tức có ngay ba khúc."}
{"category": "LocationDialogue Location3", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 108, "text": "Này, mọi thứ diễn ra đột ngột quá đó. "}
{"category": "LocationDialogue Location3", "line_index": 109, "text": "Anh thấy hơi rợn người rồi đấy..."}
{"category": "LocationDialogue Location3", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 112, "text": "Có chuyện gì à anh?"}
{"category": "LocationDialogue Location3", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 114, "text": "Anh tìm thấy vài hộp băng trong ống thông gió."}
{"category": "LocationDialogue Location3", "line_index": 115, "text": "Có nhãn tên trên đó."}
{"category": "LocationDialogue Location3", "line_index": 116, "text": "Cái hộp băng đó là gì vậy?"}
{"category": "LocationDialogue Location3", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 118, "text": "Hộp băng?"}
{"category": "LocationDialogue Location3", "line_index": 119, "text": "Như nào cơ?"}
{"category": "LocationDialogue Location3", "line_index": 120, "text": "Chúng ta cùng đi kiểm tra nhé."}
{"category": "LocationDialogue Location3", "line_index": 121, "text": "Nhưng trước hết"}
{"category": "LocationDialogue Location3", "line_index": 122, "text": "hai ta hãy ăn đã."}
{"category": "LocationDialogue Location3", "line_index": 123, "text": "Cho em xin cái kéo."}
{"category": "LocationDialogue Location3", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 125, "text": "// Ring"}
{"category": "LocationDialogue Location3", "line_index": 126, "text": "Một chiếc nhẫn?"}
{"category": "LocationDialogue Location3", "line_index": 127, "text": "// Mirror"}
{"category": "LocationDialogue Location3", "line_index": 128, "text": "Sao gương không phản chiếu gì hết vậy?"}
{"category": "LocationDialogue Location3", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 130, "text": "À, phải rồi."}
{"category": "LocationDialogue Location3", "line_index": 131, "text": "Em quên chưa kích hoạt phản chiếu..."}
{"category": "LocationDialogue Location3", "line_index": 132, "text": "Nhìn nè!"}
{"category": "LocationDialogue Location3", "line_index": 133, "text": "Giờ thì có phản chiếu rồi đó."}
{"category": "LocationDialogue Location3", "line_index": 134, "text": "À mà anh này."}
{"category": "LocationDialogue Location3", "line_index": 135, "text": "Trước giờ em còn không biết phản chiếu là gì cơ."}
{"category": "LocationDialogue Location3", "line_index": 136, "text": "Nó vốn không tồn tại trong thế giới này,"}
{"category": "LocationDialogue Location3", "line_index": 137, "text": "mãi cho tới khi có bản cập nhật."}
{"category": "LocationDialogue Location3", "line_index": 138, "text": "Ở thế giới ngoài kia có nhiều thứ "}
{"category": "LocationDialogue Location3", "line_index": 139, "text": "phản chiếu lắm phải không anh?"}
{"category": "LocationDialogue Location3", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 141, "text": "À, ừ."}
{"category": "LocationDialogue Location3", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 144, "text": "Anh còn nhớ không?"}
{"category": "LocationDialogue Location3", "line_index": 145, "text": "Anh đã mang theo ba món đồ"}
{"category": "LocationDialogue Location3", "line_index": 146, "text": "và đặt chúng lên máy quét này."}
{"category": "LocationDialogue Location3", "line_index": 147, "text": "Phải, nên là..."}
{"category": "LocationDialogue Location3", "line_index": 148, "text": "Những món đồ đó"}
{"category": "LocationDialogue Location3", "line_index": 149, "text": "lại kết nối với phiên bản thế giới này."}
{"category": "LocationDialogue Location3", "line_index": 150, "text": "Và đó là lý do anh ở đây."}
{"category": "LocationDialogue Location3", "line_index": 151, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 152, "text": "// Movbile TV"}
{"category": "LocationDialogue Location3", "line_index": 153, "text": "Chiếc TV này"}
{"category": "LocationDialogue Location3", "line_index": 154, "text": "là do anh mua."}
{"category": "LocationDialogue Location3", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 156, "text": "Đúng rồi anh."}
{"category": "LocationDialogue Location3", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 158, "text": "Nhưng lần trước em nói"}
{"category": "LocationDialogue Location3", "line_index": 159, "text": "nó hỏng rồi mà nhỉ."}
{"category": "LocationDialogue Location3", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 161, "text": "Thực ra là em muốn"}
{"category": "LocationDialogue Location3", "line_index": 162, "text": "tạo bất ngờ cho anh!"}
{"category": "LocationDialogue Location3", "line_index": 163, "text": "Để đưa anh tới thế giới của em."}
{"category": "LocationDialogue Location3", "line_index": 164, "text": "Vậy nên em mới phải nói dối anh một chút."}
{"category": "LocationDialogue Location3", "line_index": 165, "text": "Giờ thì màn hình hiển thị thông tin rồi nè."}
{"category": "LocationDialogue Location3", "line_index": 166, "text": "À mà, nhân tiện em nói luôn..."}
{"category": "LocationDialogue Location3", "line_index": 167, "text": "Em cũng thuộc kiểu dân kỹ thuật đó!"}
{"category": "LocationDialogue Location3", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 169, "text": "// School cloth"}
{"category": "LocationDialogue Location3", "line_index": 170, "text": "Gì đây em?"}
{"category": "LocationDialogue Location3", "line_index": 171, "text": "Đồng phục học sinh?"}
{"category": "LocationDialogue Location3", "line_index": 172, "text": "Em cần nó để làm gì vậy?"}
{"category": "LocationDialogue Location3", "line_index": 173, "text": "Bộ em phải tới trường hay gì đó à?"}
{"category": "LocationDialogue Location3", "line_index": 174, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 175, "text": "Trường hả anh?"}
{"category": "LocationDialogue Location3", "line_index": 176, "text": "Không, em không cần tới trường."}
{"category": "LocationDialogue Location3", "line_index": 177, "text": "Nhưng đồng phục dễ thương mà."}
{"category": "LocationDialogue Location3", "line_index": 178, "text": "Mặc vào thì em"}
{"category": "LocationDialogue Location3", "line_index": 179, "text": "sẽ trở nên dễ thương hơn."}
{"category": "LocationDialogue Location3", "line_index": 180, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 181, "text": "// PC"}
{"category": "LocationDialogue Location3", "line_index": 182, "text": "Cái máy tính này hoạt động không em nhỉ?"}
{"category": "LocationDialogue Location3", "line_index": 183, "text": "Hay nó chỉ để trang trí thôi?"}
{"category": "LocationDialogue Location3", "line_index": 184, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 185, "text": "Tất nhiên là hoạt động chứ anh."}
{"category": "LocationDialogue Location3", "line_index": 186, "text": "Mọi thứ ở nơi đây"}
{"category": "LocationDialogue Location3", "line_index": 187, "text": "đều hoạt động giống như thế giới của anh."}
{"category": "LocationDialogue Location3", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 189, "text": "Trong thế giới của anh."}
{"category": "LocationDialogue Location3", "line_index": 190, "text": "Anh luôn ngồi trước máy tính..."}
{"category": "LocationDialogue Location3", "line_index": 191, "text": "Và vùi đầu vào làm việc."}
{"category": "LocationDialogue Location3", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 193, "text": "Em biết mà."}
{"category": "LocationDialogue Location3", "line_index": 194, "text": "Cũng vì công việc của anh"}
{"category": "LocationDialogue Location3", "line_index": 195, "text": "nên anh chẳng mấy khi"}
{"category": "LocationDialogue Location3", "line_index": 196, "text": "dành thời gian cho em nữa..."}
{"category": "LocationDialogue Location3", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 198, "text": "Ừ thì, anh cũng phải lo kiếm sống mà."}
{"category": "LocationDialogue Location3", "line_index": 199, "text": "Nhưng... Sao em lại biết?"}
{"category": "LocationDialogue Location3", "line_index": 200, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 201, "text": "Camera điện thoại của anh đôi khi bật lên đúng không?"}
{"category": "LocationDialogue Location3", "line_index": 202, "text": "Xin lỗi anh nhé."}
{"category": "LocationDialogue Location3", "line_index": 203, "text": "Lúc đó em có nhìn trộm anh >A<"}
{"category": "LocationDialogue Location3", "line_index": 204, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 205, "text": "Hm... Làm vậy là không tốt đâu."}
{"category": "LocationDialogue Location3", "line_index": 206, "text": "Mà kệ đi."}
{"category": "LocationDialogue Location3", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 208, "text": "// Umbrella"}
{"category": "LocationDialogue Location3", "line_index": 209, "text": "Trước giờ anh chơi"}
{"category": "LocationDialogue Location3", "line_index": 210, "text": "có thấy mưa bao giờ đâu nhỉ?"}
{"category": "LocationDialogue Location3", "line_index": 211, "text": "Cái ô này để làm gì vậy?"}
{"category": "LocationDialogue Location3", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 213, "text": "Trời hiếm khi mưa lắm anh ạ."}
{"category": "LocationDialogue Location3", "line_index": 214, "text": "Chắc anh chưa từng thấy mưa bao giờ."}
{"category": "LocationDialogue Location3", "line_index": 215, "text": "Có thể một ngày nào đó anh sẽ thấy."}
{"category": "LocationDialogue Location3", "line_index": 216, "text": "Và anh sẽ cần một chiếc ô thôi."}
{"category": "LocationDialogue Location3", "line_index": 217, "text": "Rồi sau này anh sẽ rõ."}
{"category": "LocationDialogue Location3", "line_index": 218, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 219, "text": "// Electrical panel"}
{"category": "LocationDialogue Location3", "line_index": 220, "text": "Sao lại có cầu dao điện ở đây?"}
{"category": "LocationDialogue Location3", "line_index": 221, "text": "Nếu đây là trong game"}
{"category": "LocationDialogue Location3", "line_index": 222, "text": "thì nó để làm gì vậy?"}
{"category": "LocationDialogue Location3", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 224, "text": "Trước hết là"}
{"category": "LocationDialogue Location3", "line_index": 225, "text": "chúng ta \"đang ở trong game\"."}
{"category": "LocationDialogue Location3", "line_index": 226, "text": "Thế nên anh hỏi \"tại sao\" thì"}
{"category": "LocationDialogue Location3", "line_index": 227, "text": "hoàn toàn vô nghĩa."}
{"category": "LocationDialogue Location3", "line_index": 228, "text": "Nhưng cái cầu dao này thực sự"}
{"category": "LocationDialogue Location3", "line_index": 229, "text": "có thể khởi động lại nguồn điện đấy anh."}
{"category": "LocationDialogue Location3", "line_index": 230, "text": "Vì mọi thứ nơi đây đều được làm"}
{"category": "LocationDialogue Location3", "line_index": 231, "text": "giống y hệt thế giới của anh mà."}
{"category": "LocationDialogue Location3", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 233, "text": "// Exit door"}
{"category": "LocationDialogue Location3", "line_index": 234, "text": "Chúng ta ra ngoài được không?"}
{"category": "LocationDialogue Location3", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 236, "text": "A..."}
{"category": "LocationDialogue Location3", "line_index": 237, "text": "Chưa được đâu."}
{"category": "LocationDialogue Location3", "line_index": 238, "text": "Để lúc khác đi anh."}
{"category": "LocationDialogue Location3", "line_index": 239, "text": "Giờ chúng ta"}
{"category": "LocationDialogue Location3", "line_index": 240, "text": "cứ ở trong nhà đã nhé."}
{"category": "LocationDialogue Location3", "line_index": 241, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 242, "text": "// Books"}
{"category": "LocationDialogue Location3", "line_index": 243, "text": "Ở đây nhiều sách quá nhỉ."}
{"category": "LocationDialogue Location3", "line_index": 244, "text": "Em thường hay đọc sách à?"}
{"category": "LocationDialogue Location3", "line_index": 245, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 246, "text": "Sách thì em đọc hết rồi."}
{"category": "LocationDialogue Location3", "line_index": 247, "text": "Em ở đây một mình"}
{"category": "LocationDialogue Location3", "line_index": 248, "text": "cực kỳ, cực kỳ... Chán lắm ấy."}
{"category": "LocationDialogue Location3", "line_index": 249, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 250, "text": "// TV in room kitchen"}
{"category": "LocationDialogue Location3", "line_index": 251, "text": "Sao em lại cần tới hai chiếc TV"}
{"category": "LocationDialogue Location3", "line_index": 252, "text": "và để một cái cũ ở đây?"}
{"category": "LocationDialogue Location3", "line_index": 253, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 254, "text": "Anh không thích sao?"}
{"category": "LocationDialogue Location3", "line_index": 255, "text": "Em có thể xóa nó đi cũng được."}
{"category": "LocationDialogue Location3", "line_index": 256, "text": "Nhưng mà..."}
{"category": "LocationDialogue Location3", "line_index": 257, "text": "Nó cũng chỉ là để trang trí thôi."}
{"category": "LocationDialogue Location3", "line_index": 258, "text": "Trang trí cho nhà bếp thêm sinh động."}
{"category": "LocationDialogue Location3", "line_index": 259, "text": "Nó vẫn hoạt động được đó!"}
{"category": "LocationDialogue Location3", "line_index": 260, "text": "Em có thể xem được cả"}
{"category": "LocationDialogue Location3", "line_index": 261, "text": "anime cũ cơ mà!"}
{"category": "LocationDialogue Location3", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 263, "text": "// Smartphone"}
{"category": "LocationDialogue Location3", "line_index": 264, "text": "Điện thoại của anh."}
{"category": "LocationDialogue Location3", "line_index": 265, "text": "Nó tự nhiên biến mất khỏi túi của anh."}
{"category": "LocationDialogue Location3", "line_index": 266, "text": "Sao nó lại ở đây?"}
{"category": "LocationDialogue Location3", "line_index": 267, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 268, "text": "Ừm... Anh không cần bận tâm đâu."}
{"category": "LocationDialogue Location3", "line_index": 269, "text": "A, em có ý này."}
{"category": "LocationDialogue Location3", "line_index": 270, "text": "Hai ta làm một bức đi anh?"}
{"category": "LocationDialogue Location3", "line_index": 271, "text": "Nhìn nè."}
{"category": "LocationDialogue Location3", "line_index": 272, "text": "Bức ảnh xinh quá đi!"}
{"category": "LocationDialogue Location3", "line_index": 273, "text": "Giữ làm kỷ niệm nhé anh."}
{"category": "LocationDialogue Location3", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 275, "text": "Anh hỏi một câu được không?"}
{"category": "LocationDialogue Location3", "line_index": 276, "text": "Nếu như"}
{"category": "LocationDialogue Location3", "line_index": 277, "text": "anh chạy game trên đó"}
{"category": "LocationDialogue Location3", "line_index": 278, "text": "liệu anh có thấy được em không nhỉ?"}
{"category": "LocationDialogue Location3", "line_index": 279, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 280, "text": "Không có ai ở đó đâu anh."}
{"category": "LocationDialogue Location3", "line_index": 281, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 282, "text": "Nước Ép Mát Lạnh"}
{"category": "LocationDialogue Location3", "line_index": 283, "text": "NƯỚC ÉP Mạnh Bá Cháy!!!"}
{"category": "LocationDialogue Location3", "line_index": 284, "text": "// TV"}
{"category": "LocationDialogue Location3", "line_index": 285, "text": "Có bao nhiêu kênh thế em?"}
{"category": "LocationDialogue Location3", "line_index": 286, "text": "Cái TV này ấy."}
{"category": "LocationDialogue Location3", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 288, "text": "À, nó không dùng ăng ten đâu anh."}
{"category": "LocationDialogue Location3", "line_index": 289, "text": "Vì nó kết nối với internet"}
{"category": "LocationDialogue Location3", "line_index": 290, "text": "nên anh có thể xem tất tần tật mọi thứ."}
{"category": "LocationDialogue Location3", "line_index": 291, "text": "Bất cứ thứ gì có sẵn trên mạng..."}
{"category": "LocationDialogue Location3", "line_index": 292, "text": "Khoan đã."}
{"category": "LocationDialogue Location3", "line_index": 293, "text": "Ha..."}
{"category": "LocationDialogue Location3", "line_index": 294, "text": "Cái gì vậy nè?"}
{"category": "LocationDialogue Location3", "line_index": 295, "text": "Mấy bé mèo?"}
{"category": "LocationDialogue Location3", "line_index": 296, "text": "Oa, anh nhìn nè."}
{"category": "LocationDialogue Location3", "line_index": 297, "text": "Nhìn đây nè..."}
{"category": "LocationDialogue Location3", "line_index": 298, "text": "Ngay lúc này!"}
{"category": "LocationDialogue Location3", "line_index": 299, "text": "Làm cốc nước ép không anh?"}
{"category": "LocationDialogue Location3", "line_index": 300, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 301, "text": "Quảng cáo gì lạ đời thế..."}
{"category": "LocationDialogue Location3", "line_index": 302, "text": "Nước ép chết rồi đó hả?"}
{"category": "LocationDialogue Location3", "line_index": 303, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 304, "text": "Vâng, và từ đó nước ép"}
{"category": "LocationDialogue Location3", "line_index": 305, "text": "tạo ra nước ép đó anh."}
{"category": "LocationDialogue Location3", "line_index": 306, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 308, "text": "Mm, hương vị này..."}
{"category": "LocationDialogue Location3", "line_index": 309, "text": "Có vẻ ngon"}
{"category": "LocationDialogue Location3", "line_index": 310, "text": "nhưng anh không biết diễn tả nó ra sao."}
{"category": "LocationDialogue Location3", "line_index": 311, "text": "Khó hiểu thật."}
{"category": "LocationDialogue Location3", "line_index": 312, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 313, "text": "Em hiểu rồi."}
{"category": "LocationDialogue Location3", "line_index": 314, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 315, "text": "// Mita shy"}
{"category": "LocationDialogue Location3", "line_index": 316, "text": "Anh làm gì vậy?"}
{"category": "LocationDialogue Location3", "line_index": 317, "text": "Dừng lại đi."}
{"category": "LocationDialogue Location3", "line_index": 318, "text": "Anh làm em ngại quá đó."}
{"category": "LocationDialogue Location3", "line_index": 319, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 320, "text": "// The statuette"}
{"category": "LocationDialogue Location3", "line_index": 321, "text": "Tượng gì nhìn trông rợn người ghê."}
{"category": "LocationDialogue Location3", "line_index": 322, "text": "Em thích mấy thứ"}
{"category": "LocationDialogue Location3", "line_index": 323, "text": "như thế này à?"}
{"category": "LocationDialogue Location3", "line_index": 324, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 325, "text": "Rợn người?"}
{"category": "LocationDialogue Location3", "line_index": 326, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 327, "text": "Ừ."}
{"category": "LocationDialogue Location3", "line_index": 328, "text": "Trông như đồ bị nguyền rủa ấy..."}
{"category": "LocationDialogue Location3", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 330, "text": "Không bị nguyền rủa gì đâu,"}
{"category": "LocationDialogue Location3", "line_index": 331, "text": "cũng không đáng sợ chút nào."}
{"category": "LocationDialogue Location3", "line_index": 332, "text": "Phải nói là rất dễ thương ấy chứ."}
{"category": "LocationDialogue Location3", "line_index": 333, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 334, "text": "Ừ thì, có lẽ em nói phải..."}
{"category": "LocationDialogue Location3", "line_index": 335, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 336, "text": "Mita?"}
{"category": "LocationDialogue Location3", "line_index": 337, "text": "Chuyện gì thế này?"}
{"category": "LocationDialogue Location3", "line_index": 338, "text": "// Mita kitchen"}
{"category": "LocationDialogue Location3", "line_index": 339, "text": "Trò chuyện một chút nhé?"}
{"category": "LocationDialogue Location3", "line_index": 340, "text": "Xong rồi ta ăn."}
{"category": "LocationDialogue Location3", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 342, "text": "// Start Eat"}
{"category": "LocationDialogue Location3", "line_index": 343, "text": "Chúc ngon miệng."}
{"category": "LocationDialogue Location3", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 345, "text": "// Quest 1"}
{"category": "LocationDialogue Location3", "line_index": 346, "text": "Tất nhiên rồi anh."}
{"category": "LocationDialogue Location3", "line_index": 347, "text": "Anh cứ tự nhiên ở đây."}
{"category": "LocationDialogue Location3", "line_index": 348, "text": "Em không phiền đâu."}
{"category": "LocationDialogue Location3", "line_index": 349, "text": "Thậm chí còn"}
{"category": "LocationDialogue Location3", "line_index": 350, "text": "RẤT HOAN NGHÊNH!"}
{"category": "LocationDialogue Location3", "line_index": 351, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 352, "text": "// Quest 2"}
{"category": "LocationDialogue Location3", "line_index": 353, "text": "Anh muốn quay về sao?"}
{"category": "LocationDialogue Location3", "line_index": 354, "text": "Nhưng tại sao?"}
{"category": "LocationDialogue Location3", "line_index": 355, "text": "Nơi này cực kỳ ấm cúng..."}
{"category": "LocationDialogue Location3", "line_index": 356, "text": "Ấm cúng chẳng phải tuyệt lắm sao?"}
{"category": "LocationDialogue Location3", "line_index": 357, "text": "Với lại có em ở đây nữa mà."}
{"category": "LocationDialogue Location3", "line_index": 358, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 359, "text": "Không, ý anh không phải vậy."}
{"category": "LocationDialogue Location3", "line_index": 360, "text": "Anh rất muốn ở lại đây."}
{"category": "LocationDialogue Location3", "line_index": 361, "text": "Chỉ là anh hơi lo."}
{"category": "LocationDialogue Location3", "line_index": 362, "text": "Lo rằng anh để quên đồ ở nhà..."}
{"category": "LocationDialogue Location3", "line_index": 363, "text": "Thì là, tại anh tới đây đột ngột quá"}
{"category": "LocationDialogue Location3", "line_index": 364, "text": "nên anh chẳng "}
{"category": "LocationDialogue Location3", "line_index": 365, "text": "chuẩn bị được gì cả."}
{"category": "LocationDialogue Location3", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 367, "text": "Em xin lỗi, em chưa nghĩ tới chuyện đó."}
{"category": "LocationDialogue Location3", "line_index": 368, "text": "// Quest 3"}
{"category": "LocationDialogue Location3", "line_index": 369, "text": "Anh muốn bỏ trốn sao?"}
{"category": "LocationDialogue Location3", "line_index": 370, "text": "Và quên hết mọi thứ nơi đây?"}
{"category": "LocationDialogue Location3", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 372, "text": "Không, không phải."}
{"category": "LocationDialogue Location3", "line_index": 373, "text": "Anh chỉ cảm thấy nơi này có gì đó..."}
{"category": "LocationDialogue Location3", "line_index": 374, "text": "Kỳ lạ, không được tự nhiên."}
{"category": "LocationDialogue Location3", "line_index": 375, "text": "Nhưng em..."}
{"category": "LocationDialogue Location3", "line_index": 376, "text": "Em lại có vẻ trông giống thật."}
{"category": "LocationDialogue Location3", "line_index": 377, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 378, "text": "Trông giống ư?"}
{"category": "LocationDialogue Location3", "line_index": 379, "text": "Nhưng em là THẬT mà!"}
{"category": "LocationDialogue Location3", "line_index": 380, "text": "Đồ ngốc"}
{"category": "LocationDialogue Location3", "line_index": 381, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 382, "text": "// Quest 4"}
{"category": "LocationDialogue Location3", "line_index": 383, "text": "Đó là đặc tính"}
{"category": "LocationDialogue Location3", "line_index": 384, "text": "của thế giới này."}
{"category": "LocationDialogue Location3", "line_index": 385, "text": "Có thể anh thấy kỳ lạ,"}
{"category": "LocationDialogue Location3", "line_index": 386, "text": "nhưng những thứ ở khoảng cách xa"}
{"category": "LocationDialogue Location3", "line_index": 387, "text": "thì anh không thể nhìn thấy được."}
{"category": "LocationDialogue Location3", "line_index": 388, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 389, "text": "Cũng không đến nỗi khó chịu nhỉ."}
{"category": "LocationDialogue Location3", "line_index": 390, "text": "Nhìn còn sang nữa."}
{"category": "LocationDialogue Location3", "line_index": 391, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 392, "text": "May quá."}
{"category": "LocationDialogue Location3", "line_index": 393, "text": "Tất cả là để tránh bị giật lag đấy."}
{"category": "LocationDialogue Location3", "line_index": 394, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 395, "text": "Tránh giật lag?"}
{"category": "LocationDialogue Location3", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 397, "text": "Vâng, hiện vẫn còn tồn tại một vài lỗi."}
{"category": "LocationDialogue Location3", "line_index": 398, "text": "Hy vọng anh không bị dính phải."}
{"category": "LocationDialogue Location3", "line_index": 399, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 400, "text": "// Quest 5"}
{"category": "LocationDialogue Location3", "line_index": 401, "text": "Kéo và dao?"}
{"category": "LocationDialogue Location3", "line_index": 402, "text": "Đúng là em có thể dùng dao để mở gói sốt."}
{"category": "LocationDialogue Location3", "line_index": 403, "text": "Nhưng mà em muốn"}
{"category": "LocationDialogue Location3", "line_index": 404, "text": "chuẩn bị xong bữa ăn"}
{"category": "LocationDialogue Location3", "line_index": 405, "text": "trước khi anh quay lại cơ."}
{"category": "LocationDialogue Location3", "line_index": 406, "text": "Em thích tạo bất ngờ lắm luôn ý!"}
{"category": "LocationDialogue Location3", "line_index": 407, "text": "Chuẩn bị xíu là xong ngay."}
{"category": "LocationDialogue Location3", "line_index": 408, "text": "Hihi."}
{"category": "LocationDialogue Location3", "line_index": 409, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 410, "text": "// Glasses"}
{"category": "LocationDialogue Location3", "line_index": 411, "text": "Em có hay đeo kính không?"}
{"category": "LocationDialogue Location3", "line_index": 412, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 413, "text": "Không hẳn."}
{"category": "LocationDialogue Location3", "line_index": 414, "text": "Nhưng em có thể đeo."}
{"category": "LocationDialogue Location3", "line_index": 415, "text": "Trông hợp với em không nhỉ?"}
{"category": "LocationDialogue Location3", "line_index": 416, "text": "// Mita Y"}
{"category": "LocationDialogue Location3", "line_index": 417, "text": "Nào, đi thôi."}
{"category": "LocationDialogue Location3", "line_index": 418, "text": "Từ giờ em đeo suốt luôn nhé!"}
{"category": "LocationDialogue Location3", "line_index": 419, "text": "// Mita N"}
{"category": "LocationDialogue Location3", "line_index": 420, "text": "Hửm..."}
{"category": "LocationDialogue Location3", "line_index": 421, "text": "Thế thôi vậy."}
{"category": "LocationDialogue Location3", "line_index": 422, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 423, "text": "// Use the sauce"}
{"category": "LocationDialogue Location3", "line_index": 424, "text": "Thử xem sao."}
{"category": "LocationDialogue Location3", "line_index": 425, "text": "Đây là loại sốt gì vậy?"}
{"category": "LocationDialogue Location3", "line_index": 426, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 427, "text": "Là sốt tình yêu đó!"}
{"category": "LocationDialogue Location3", "line_index": 428, "text": "Hương vị ngập tràn tình yêu!"}
{"category": "LocationDialogue Location3", "line_index": 429, "text": "Và... một cái nhìn tương phản về thế giới quan..."}
{"category": "LocationDialogue Location3", "line_index": 430, "text": "Anh thấy kỳ lạ lắm phải không?"}
{"category": "LocationDialogue Location3", "line_index": 431, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 432, "text": "Ừ..."}
{"category": "LocationDialogue Location3", "line_index": 433, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 434, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location3", "line_index": 435, "text": "Máy chơi game của anh à?"}
{"category": "LocationDialogue Location3", "line_index": 436, "text": "Trông nó tuyệt thật."}
