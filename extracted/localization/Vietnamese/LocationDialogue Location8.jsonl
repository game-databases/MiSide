{"category": "LocationDialogue Location8", "line_index": 0, "text": "// The first meeting"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "Em là ai?"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "Chuyện gì xảy ra vậy?"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "Em không thể nói chuyện à?"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "Đợi đã..."}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "Anh định rời đi sao?"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "Ừm..."}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "Anh cần phải đi đến"}
{"category": "LocationDialogue Location8", "line_index": 11, "text": "phiên bản cũ."}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "Phiên bản cũ?"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "Sao anh lại phải đi"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "tới nơi khác?"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "Ở lại đây với em đi..."}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "Hãy làm người bạn"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "thứ hai của em..."}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Skipping all dialogs"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "Vậy à..."}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Standing by the window (Random)"}
{"category": "LocationDialogue Location8", "line_index": 24, "text": "Cửa không phải là lối ra đâu."}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "Anh vội quá nhỉ..."}
{"category": "LocationDialogue Location8", "line_index": 26, "text": "Đi tới đi lui như vậy chẳng có ích gì mà."}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "Anh muốn thoát khỏi đây đến thế sao?"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "Anh nhìn ra ngoài cửa sổ đi..."}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Aren't you Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "Người chơi... Anh là người chơi phải không?"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": "Chơi với em đi anh?"}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "Giá mà em còn sức lực"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": "thì đã có thể chơi cùng nhau rồi..."}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (What happened to you?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "Không biết... Em không chắc nữa..."}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "Em nghĩ không có chuyện gì xấu xảy ra..."}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "Nhưng mà, những điều tốt đẹp đang dần biến mất..."}
{"category": "LocationDialogue Location8", "line_index": 41, "text": "Dù vậy, ít nhất thì em vẫn còn người bạn ở bên."}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "Người chơi đã bỏ đi hết rồi…"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "Không lẽ em bị bỏ rơi thật sao?"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "Không muốn đâu... sợ quá..."}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Quest 3 (Become a second friend?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "Bạn của em..."}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "Họ cứ dần biến mất."}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "Giờ chỉ còn lại mỗi một người bạn thôi."}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "Em buồn lắm, người chơi."}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "Anh làm người bạn mới của em được không?"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "Anh rất muốn."}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "Nhưng anh phải đi tiếp..."}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "Tim em đau quá... đau lắm..."}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Is this your house?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "Nhà ư?"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "Người chơi... Anh thay đổi rồi..."}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "Cánh tay ngắn hơn, nét mặt cũng không còn đáng sợ nữa..."}
{"category": "LocationDialogue Location8", "line_index": 62, "text": "Người chơi, anh trở nên dịu dàng và ấm áp hơn rồi."}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "Là sao vậy em..."}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "Anh không hiểu."}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "May quá..."}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "Em sẽ không phải chịu đau nữa phải không?"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (How do I leave this place?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "Người chơi, anh định bỏ em một mình và đi đâu đó sao?"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "Đây là..."}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "số phận của em?"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "Anh..."}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": "Cánh cửa sẽ không giúp gì cho anh đâu."}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Hold player (Random)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "Tại sao anh lại rời đi?"}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "Ở lại đây đi..."}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "Chơi với em đi mà..."}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "Nè, người chơi..."}
