{"category": "LocationDialogue Location9", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Này, anh kia!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Chào nhé!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Anh muốn thoát khỏi đây không?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Thế thì mau giúp tôi tìm chìa khóa đi!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Khỉ thật! Chìa khóa đâu rồi!"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Trống trơn!"}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "Chẳng có gì sất!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Tìm thấy rồi!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// The usual conversation"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Tôi cứ tưởng anh nhỏ con hơn cơ!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "Nhưng mà anh"}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "cao to giống chị gái tôi vậy!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "Chị gái? Chị gái em như nào?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Đúng vậy, chị gái."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Đừng nói là anh chưa gặp chị ấy bao giờ nhé!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Hình như anh gặp rồi... thì phải?"}
{"category": "LocationDialogue Location9", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Anh bị ngớ à?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "Ừ thì..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "Đúng là ngốc thật..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "Thôi, chỉ cho tôi chỗ nào có chìa khóa đi!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// Next work"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Nào."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Cho sắt vào trong ống đi!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Cảm ơn!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "Giờ thì bỏ đống củi xuống đi!"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Cảm ơn!"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Giúp tôi một tay nào!"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Được rồi, tiếp theo là..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "Chà, đẹp thật."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Ấn nút đi, nhanh lên!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Xong rồi!"}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "Này, cầm lấy đi!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "Chìa khóa của anh đó!"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// Quest 1 (Are you Mita?)"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Tôi là ChibiMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Tôi có cả hàng tấn lời thoại,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "mô hình đơn giản hết sức,"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "và mái tóc thì đẹp miễn chê!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// Quest 2 (Have we seen each other yet?)"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Trời ạ, đầu đất thật đó."}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "Anh cũng dễ thương đấy chứ"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "khi hỏi mấy câu ngớ ngẩn như vậy."}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Dù sao thì"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "đây là lần đầu tôi gặp anh!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Nhưng mà..."}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Anh mà dám ăn cắp vẻ ngoài cực phẩm của tôi á..."}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "Phải trả giá rất đắt đấy!"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// Quest 3 (Why are you here?)"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Vẫn chưa hiểu hả?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "Đây là trạm kiểm soát!"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "Tôi muốn kiểm tra đầu óc của anh như nào!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "Tóm lại!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Tôi ở đây để dẫn đường cho cừu non lạc lối!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// Quest 4 (Why are you helping me?)"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "Này... Anh nghĩ anh là ai vậy?"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "Sao lại không giúp anh cơ chứ?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "Hả?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Làm như không biết gì..."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Tự nhiên xuất hiện từ đâu ra!"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Đây không phải chỗ của anh đâu."}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "Nên tôi mới giúp anh đấy!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Tạm biệt, anh trai nhạt nhẽo!"}
