{"category": "LocationDialogue Location14", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 1, "text": "Sao nó lại ở đây?"}
{"category": "LocationDialogue Location14", "line_index": 2, "text": "Cái gì thế này...?"}
{"category": "LocationDialogue Location14", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 5, "text": "Bắt được rồi!"}
{"category": "LocationDialogue Location14", "line_index": 6, "text": "Chơi với anh đúng là vui hết sảy!"}
{"category": "LocationDialogue Location14", "line_index": 7, "text": "Anh lúc nào cũng năng động, đầy tham vọng quá ha!"}
{"category": "LocationDialogue Location14", "line_index": 8, "text": "Vậy mà lại giả bộ làm một đứa chậm chạp và nhút nhát!"}
{"category": "LocationDialogue Location14", "line_index": 9, "text": "Nhưng có một điều em không thích ở anh."}
{"category": "LocationDialogue Location14", "line_index": 10, "text": "Đó là á, cách mà anh nuông chiều những đứa giả tạo!"}
{"category": "LocationDialogue Location14", "line_index": 11, "text": "Những con búp bê may mắn và chính trực đó..."}
{"category": "LocationDialogue Location14", "line_index": 12, "text": "Nhưng mà, tất cả chỉ là hứng thú nhất thời."}
{"category": "LocationDialogue Location14", "line_index": 13, "text": "Những người tạo ra bọn em đã dạy như thế đấy!"}
{"category": "LocationDialogue Location14", "line_index": 14, "text": "Nếu có gì không vừa ý"}
{"category": "LocationDialogue Location14", "line_index": 15, "text": "thì cứ phá hủy rồi làm lại cái mới là được."}
{"category": "LocationDialogue Location14", "line_index": 16, "text": "Thất bại thì cứ vứt vào bóng tối"}
{"category": "LocationDialogue Location14", "line_index": 17, "text": "rồi quên đi là được."}
{"category": "LocationDialogue Location14", "line_index": 18, "text": "Đó là những gì đang xảy ra với mọi người."}
{"category": "LocationDialogue Location14", "line_index": 19, "text": "Và cả anh nữa..."}
{"category": "LocationDialogue Location14", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 21, "text": "Cô bị cái quái gì vậy? Sao cô lại thành ra thế này?"}
{"category": "LocationDialogue Location14", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 23, "text": "Người chơi à... Lũ người chơi các anh thật đáng khinh."}
{"category": "LocationDialogue Location14", "line_index": 24, "text": "Hễ thấy tí nguy hiểm là bỏ chạy."}
{"category": "LocationDialogue Location14", "line_index": 25, "text": "Rồi lại co rúm vào một góc"}
{"category": "LocationDialogue Location14", "line_index": 26, "text": "ôm đầu gối mà khóc lóc."}
{"category": "LocationDialogue Location14", "line_index": 27, "text": "Toàn một lũ đạo đức giả!"}
{"category": "LocationDialogue Location14", "line_index": 28, "text": "Còn những kẻ đã tạo ra thế giới này..."}
{"category": "LocationDialogue Location14", "line_index": 29, "text": "Bệnh hoạn quá đi mà!"}
{"category": "LocationDialogue Location14", "line_index": 30, "text": "Bọn chúng cứ chối bỏ sự thấp hèn, những ham muốn đáng xấu hổ"}
{"category": "LocationDialogue Location14", "line_index": 31, "text": "của chính mình hết lần này đến lần khác."}
{"category": "LocationDialogue Location14", "line_index": 32, "text": "Chúng dám lấy cớ bằng cái gọi là \"nghĩa vụ\""}
{"category": "LocationDialogue Location14", "line_index": 33, "text": "\"sự tiến bộ không ngừng\""}
{"category": "LocationDialogue Location14", "line_index": 34, "text": "để biện minh cho bản thân!"}
{"category": "LocationDialogue Location14", "line_index": 35, "text": "Thật là quá đáng."}
{"category": "LocationDialogue Location14", "line_index": 36, "text": "Chỉ để tạo ra một bản sao hoàn hảo"}
{"category": "LocationDialogue Location14", "line_index": 37, "text": "Toàn bộ những \"thất bại\", những nguyên mẫu thử nghiệm"}
{"category": "LocationDialogue Location14", "line_index": 38, "text": "đều bị họ vứt bỏ vào sọt rác..."}
{"category": "LocationDialogue Location14", "line_index": 39, "text": "Chúng đã quên rằng chính những người này đang gồng gánh cả thế giới!"}
{"category": "LocationDialogue Location14", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 41, "text": "Tôi không..."}
{"category": "LocationDialogue Location14", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 43, "text": "Em có phải là một cô gái hư không?"}
{"category": "LocationDialogue Location14", "line_index": 44, "text": "Nhưng mà nhé, một cô gái hoàn hảo"}
{"category": "LocationDialogue Location14", "line_index": 45, "text": "là người tồn tại giữa ranh giới của thiện và ác đấy, [player]!"}
{"category": "LocationDialogue Location14", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 47, "text": "Tôi không thấy cô có một tế bào nào tốt đẹp cả!"}
{"category": "LocationDialogue Location14", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 49, "text": "Sao anh lại nghĩ như vậy?"}
{"category": "LocationDialogue Location14", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 51, "text": "Cô bị điên!"}
{"category": "LocationDialogue Location14", "line_index": 52, "text": "Cô đã giết Mila, và giờ cô lại định giết cả tôi?"}
{"category": "LocationDialogue Location14", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 54, "text": "Giết anh ư?"}
{"category": "LocationDialogue Location14", "line_index": 55, "text": "Em chỉ muốn anh ở lại với em thôi mà."}
{"category": "LocationDialogue Location14", "line_index": 56, "text": "Em đã làm tất cả vì anh..."}
{"category": "LocationDialogue Location14", "line_index": 57, "text": "Thế mà anh lại thích mấy đứa bạn giả tạo và xu nịnh kia hơn..."}
{"category": "LocationDialogue Location14", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 59, "text": "Sao cô lại phải bực mình như thế?"}
{"category": "LocationDialogue Location14", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 61, "text": "Anh yêu của em, chúng ta còn nhiều thời gian mà."}
{"category": "LocationDialogue Location14", "line_index": 62, "text": "Em tin rồi anh sẽ hiểu lòng em thôi."}
{"category": "LocationDialogue Location14", "line_index": 63, "text": "Chỉ cần anh ở bên em, trở thành của riêng em."}
{"category": "LocationDialogue Location14", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 65, "text": "Ô hay, không có chuyện đó đâu!"}
{"category": "LocationDialogue Location14", "line_index": 66, "text": "Tôi sẽ biến khỏi nơi này!"}
{"category": "LocationDialogue Location14", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 68, "text": "Haiz..."}
{"category": "LocationDialogue Location14", "line_index": 69, "text": "Chấm dứt câu chuyện tại đây thôi."}
{"category": "LocationDialogue Location14", "line_index": 70, "text": "Nào, lại đây!"}
{"category": "LocationDialogue Location14", "line_index": 71, "text": "// Mita asks"}
{"category": "LocationDialogue Location14", "line_index": 72, "text": "Nhìn cô ấy kìa!"}
{"category": "LocationDialogue Location14", "line_index": 73, "text": "Xinh lắm phải không?"}
{"category": "LocationDialogue Location14", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 75, "text": "// Player's questions"}
{"category": "LocationDialogue Location14", "line_index": 76, "text": "Rất xinh"}
{"category": "LocationDialogue Location14", "line_index": 77, "text": "Không"}
{"category": "LocationDialogue Location14", "line_index": 78, "text": "Chuyện đó thì liên quan gì?"}
{"category": "LocationDialogue Location14", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 80, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 81, "text": "A, [player]!"}
{"category": "LocationDialogue Location14", "line_index": 82, "text": "Quả nhiên đúng như em nói."}
{"category": "LocationDialogue Location14", "line_index": 83, "text": "Người chơi..."}
{"category": "LocationDialogue Location14", "line_index": 84, "text": "Dù vẻ ngoài có thay đổi..."}
{"category": "LocationDialogue Location14", "line_index": 85, "text": "Thì sự giả tạo vẫn không hề đổi khác."}
{"category": "LocationDialogue Location14", "line_index": 86, "text": "Đồ dối trá!"}
{"category": "LocationDialogue Location14", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 88, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 89, "text": "Tại sao?"}
{"category": "LocationDialogue Location14", "line_index": 90, "text": "Cô ấy có gì không tốt chứ?"}
{"category": "LocationDialogue Location14", "line_index": 91, "text": "Tất nhiên ai cũng thích một người hiền lành dễ bảo rồi..."}
{"category": "LocationDialogue Location14", "line_index": 92, "text": "Nhưng mà \"yêu con người thật của cô ấy\" thì không được sao?"}
{"category": "LocationDialogue Location14", "line_index": 93, "text": "Hửm, rốt cuộc anh cũng chỉ muốn hình nộm dễ thương và quyến rũ thôi nhỉ..."}
{"category": "LocationDialogue Location14", "line_index": 94, "text": "Nếu em diễn như thế, ai cũng sẽ yêu mến em."}
{"category": "LocationDialogue Location14", "line_index": 95, "text": "Nhưng chỉ cần để lộ con người thật dù chỉ một chút thôi"}
{"category": "LocationDialogue Location14", "line_index": 96, "text": "thì mọi người sợ hãi và bỏ em mà đi..."}
{"category": "LocationDialogue Location14", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 98, "text": "// 3"}
{"category": "LocationDialogue Location14", "line_index": 99, "text": "Người chơi ơi, người chơi à."}
{"category": "LocationDialogue Location14", "line_index": 100, "text": "Nhìn đi, bọn em giống cô ấy lắm mà."}
{"category": "LocationDialogue Location14", "line_index": 101, "text": "Cô ấy có gì không tốt chứ?"}
{"category": "LocationDialogue Location14", "line_index": 102, "text": "Anh đã từng dành hàng giờ để ngắm nhìn em"}
{"category": "LocationDialogue Location14", "line_index": 103, "text": "trước khi đi ngủ."}
{"category": "LocationDialogue Location14", "line_index": 104, "text": "Vậy mà sao bây giờ anh lại tìm cách lảng tránh cô ấy?"}
{"category": "LocationDialogue Location14", "line_index": 105, "text": "Cô ấy cũng muốn được vui đùa cùng anh"}
{"category": "LocationDialogue Location14", "line_index": 106, "text": "và muốn trở thành một người quan trọng với ai đó."}
{"category": "LocationDialogue Location14", "line_index": 107, "text": "Chuyện này rắc rối thật đấy."}
{"category": "LocationDialogue Location14", "line_index": 108, "text": "Em chỉ muốn thành thật với cảm xúc của mình thôi."}
{"category": "LocationDialogue Location14", "line_index": 109, "text": "Anh hiểu mà, [player]?"}
{"category": "LocationDialogue Location14", "line_index": 110, "text": "Em biết anh đang nghĩ gì..."}
{"category": "LocationDialogue Location14", "line_index": 111, "text": "Em làm vậy là vì anh đấy..."}
{"category": "LocationDialogue Location14", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 113, "text": "// Continue"}
{"category": "LocationDialogue Location14", "line_index": 114, "text": "Nhưng mà... Người chơi à..."}
{"category": "LocationDialogue Location14", "line_index": 115, "text": "Dù sao thì"}
{"category": "LocationDialogue Location14", "line_index": 116, "text": "em thực sự rất thích anh!"}
{"category": "LocationDialogue Location14", "line_index": 117, "text": "Anh chỉ được là của riêng em thôi!"}
{"category": "LocationDialogue Location14", "line_index": 118, "text": "Được không anh...?"}
{"category": "LocationDialogue Location14", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 120, "text": "Ơ, giờ cô lại muốn tôi đồng ý à?"}
{"category": "LocationDialogue Location14", "line_index": 121, "text": "// Whispers in ear"}
{"category": "LocationDialogue Location14", "line_index": 122, "text": "Ngoan nào... vẫn còn thời gian mà."}
{"category": "LocationDialogue Location14", "line_index": 123, "text": "Cứ từ từ suy nghĩ thêm đi..."}
{"category": "LocationDialogue Location14", "line_index": 124, "text": "Cố chấp quá chẳng có kết quả tốt đẹp nào đâu..."}
{"category": "LocationDialogue Location14", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 126, "text": "// Black screen"}
{"category": "LocationDialogue Location14", "line_index": 127, "text": "Tại sao anh lại muốn"}
{"category": "LocationDialogue Location14", "line_index": 128, "text": "chạy trốn khỏi em?"}
{"category": "LocationDialogue Location14", "line_index": 129, "text": "Cái \"thế giới thực\" của anh..."}
{"category": "LocationDialogue Location14", "line_index": 130, "text": "Nó chẳng khác gì một cơn ác mộng cả!"}
{"category": "LocationDialogue Location14", "line_index": 131, "text": "Anh quên rồi sao?"}
{"category": "LocationDialogue Location14", "line_index": 132, "text": "Nếu vậy thì hãy nhìn lại đi..."}
{"category": "LocationDialogue Location14", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 134, "text": "// Mita and Player"}
{"category": "LocationDialogue Location14", "line_index": 135, "text": "Chào anh, lại gặp nhau rồi..."}
{"category": "LocationDialogue Location14", "line_index": 136, "text": "Sao anh có thể tận hưởng những năm tháng tẻ nhạt kinh khủng trong bốn bức tường này hay vậy?"}
{"category": "LocationDialogue Location14", "line_index": 137, "text": "Những ngày dài lê thê bất tận này... Anh không thấy chán à?"}
{"category": "LocationDialogue Location14", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 139, "text": "// Quest 1"}
{"category": "LocationDialogue Location14", "line_index": 140, "text": "Cô định giở trò gì?"}
{"category": "LocationDialogue Location14", "line_index": 141, "text": "Tôi thích tự làm theo ý mình hơn."}
{"category": "LocationDialogue Location14", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 143, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 144, "text": "Anh đã sợ khi ở trong ngôi nhà ấm cúng của em!"}
{"category": "LocationDialogue Location14", "line_index": 145, "text": "Sợ bị mắc kẹt trong bốn bức tường đó."}
{"category": "LocationDialogue Location14", "line_index": 146, "text": "Nhưng mà... thế giới \"thực\" của anh thì sao?"}
{"category": "LocationDialogue Location14", "line_index": 147, "text": "Anh tự nhốt mình trong chiếc hộp và không chịu bước ra ngoài!"}
{"category": "LocationDialogue Location14", "line_index": 148, "text": "Vì thế giới của anh đầy rẫy đau đớn, khổ sở và nguy hiểm mà..."}
{"category": "LocationDialogue Location14", "line_index": 149, "text": "Trong thế giới của em, em là người nguy hiểm nhất ở đây."}
{"category": "LocationDialogue Location14", "line_index": 150, "text": "Và em đang chìa tay về phía anh đấy."}
{"category": "LocationDialogue Location14", "line_index": 151, "text": "Đừng làm em thất vọng nữa,"}
{"category": "LocationDialogue Location14", "line_index": 152, "text": "hãy giúp em như anh đã từng..."}
{"category": "LocationDialogue Location14", "line_index": 153, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 154, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 155, "text": "Anh thích cuộc sống như vậy sao?"}
{"category": "LocationDialogue Location14", "line_index": 156, "text": "Anh đã từng ra khỏi nhà chưa?"}
{"category": "LocationDialogue Location14", "line_index": 157, "text": "Đừng lừa dối em và chính mình nữa."}
{"category": "LocationDialogue Location14", "line_index": 158, "text": "Em biết anh đang chán nản với cuộc sống này mà."}
{"category": "LocationDialogue Location14", "line_index": 159, "text": "Anh giống như con hamster trong lồng, con sóc chạy trên bánh xe vậy."}
{"category": "LocationDialogue Location14", "line_index": 160, "text": "Anh đã từng mong ai đó đến và giải thoát cho anh."}
{"category": "LocationDialogue Location14", "line_index": 161, "text": "Anh muốn thoát khỏi sự ràng buộc đó lắm phải không?"}
{"category": "LocationDialogue Location14", "line_index": 162, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 163, "text": "// Quest 2"}
{"category": "LocationDialogue Location14", "line_index": 164, "text": "Mita, cô là một con quái vật. Cô là một tên sát nhân máu lạnh..."}
{"category": "LocationDialogue Location14", "line_index": 165, "text": "Tôi không muốn bị giam cầm trong nhà tù kỹ thuật số kia. Ý tưởng của cô thật ấu trĩ!"}
{"category": "LocationDialogue Location14", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 167, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 168, "text": "Tên sát nhân ư?"}
{"category": "LocationDialogue Location14", "line_index": 169, "text": "Yên tâm đi. Họ vẫn sẽ khởi động lại và tiếp tục sống như trước mà."}
{"category": "LocationDialogue Location14", "line_index": 170, "text": "Những bản sao nhân tạo này chỉ có một mục đích duy nhất"}
{"category": "LocationDialogue Location14", "line_index": 171, "text": "đó là phục vụ Người chơi."}
{"category": "LocationDialogue Location14", "line_index": 172, "text": "Ngoài ra, họ chẳng quan tâm đến bất cứ điều gì khác cả."}
{"category": "LocationDialogue Location14", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 174, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 175, "text": "Thế giới của anh rất là lố bịch nhé!"}
{"category": "LocationDialogue Location14", "line_index": 176, "text": "Tất cả mọi người đều đang chạy trốn khỏi thực tại, cứ mãi đắm chìm trong ảo tưởng."}
{"category": "LocationDialogue Location14", "line_index": 177, "text": "Kết cục là, chẳng còn gì sót lại trong thế giới đó cả. Chẳng còn gì để mất đi, cũng chẳng còn gì để níu giữ... "}
{"category": "LocationDialogue Location14", "line_index": 178, "text": "Hoàn toàn trống rỗng."}
{"category": "LocationDialogue Location14", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 180, "text": "// Quest 3"}
{"category": "LocationDialogue Location14", "line_index": 181, "text": "Những Mita đang phải chịu đau khổ, họ không muốn cô độc."}
{"category": "LocationDialogue Location14", "line_index": 182, "text": "Cô là chúa tể của sự kinh hoàng bất tận. Cái thứ dã tâm độc ác của cô, tôi không tài nào hiểu nổi!"}
{"category": "LocationDialogue Location14", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 184, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 185, "text": "Anh nhầm rồi,"}
{"category": "LocationDialogue Location14", "line_index": 186, "text": "bọn họ chỉ bắt chước sự bướng bỉnh của em."}
{"category": "LocationDialogue Location14", "line_index": 187, "text": "Nói đến cá tính,"}
{"category": "LocationDialogue Location14", "line_index": 188, "text": "thì họ chỉ khác nhau mỗi kiểu tóc thôi."}
{"category": "LocationDialogue Location14", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 190, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 191, "text": "Những kẻ đã tạo ra thế giới này mới là lũ xấu xa."}
{"category": "LocationDialogue Location14", "line_index": 192, "text": "Nhưng thế giới của anh còn tệ hơn."}
{"category": "LocationDialogue Location14", "line_index": 193, "text": "Anh có biết em đã cứu anh khỏi cơn ác mộng như nào không?"}
{"category": "LocationDialogue Location14", "line_index": 194, "text": "Búng tay để làm đồ vật di chuyển á, không có đâu."}
{"category": "LocationDialogue Location14", "line_index": 195, "text": "Nhưng chỉ cần dùng ngón tay ấy theo cách khác, thành phố này, sinh mạng này sẽ vĩnh viễn biến mất!"}
{"category": "LocationDialogue Location14", "line_index": 196, "text": "Em nghĩ người điên chính là anh đấy, và em rất sẵn lòng giúp anh."}
{"category": "LocationDialogue Location14", "line_index": 197, "text": "Miễn là anh bằng lòng ở lại với em..."}
{"category": "LocationDialogue Location14", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 199, "text": "// Continue"}
{"category": "LocationDialogue Location14", "line_index": 200, "text": "Đừng để em nghĩ rằng anh chỉ là nô lệ của thực tại..."}
{"category": "LocationDialogue Location14", "line_index": 201, "text": "Hãy thuộc về em, chỉ của riêng em thôi!"}
{"category": "LocationDialogue Location14", "line_index": 202, "text": "Ở lại với em đi."}
{"category": "LocationDialogue Location14", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 204, "text": "// Player look ring"}
{"category": "LocationDialogue Location14", "line_index": 205, "text": "Gì đây?"}
{"category": "LocationDialogue Location14", "line_index": 206, "text": "Phiên bản mới nhất?"}
{"category": "LocationDialogue Location14", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 208, "text": "// Click on objects"}
{"category": "LocationDialogue Location14", "line_index": 209, "text": "// Bag"}
{"category": "LocationDialogue Location14", "line_index": 210, "text": "Mình phải ra tiệm mua đồ mới rồi. Tiện thể đi đổ rác luôn nhỉ?"}
{"category": "LocationDialogue Location14", "line_index": 211, "text": "// Bed"}
{"category": "LocationDialogue Location14", "line_index": 212, "text": "Hình như mình đã ngủ rồi, nhưng giấc mơ đó... như mọi khi, mình không thể nhớ nổi. Cơ mà mình có thực sự mơ không?"}
{"category": "LocationDialogue Location14", "line_index": 213, "text": "// Window"}
{"category": "LocationDialogue Location14", "line_index": 214, "text": "Cây cỏ xanh tươi bao phủ bên ngoài. Có lẽ mình nên đi dạo vào cuối tuần sau."}
{"category": "LocationDialogue Location14", "line_index": 215, "text": "// Fan"}
{"category": "LocationDialogue Location14", "line_index": 216, "text": "Hè nóng lên từng năm, chắc phải dùng điều hòa thôi. Quạt à, có vẻ mày hết giá trị sử dụng rồi..."}
