{"category": "LocationDialogue Location8", "line_index": 0, "text": "// The first meeting"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "Wer bist du?!"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "Was ist los mit dir...?"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "Kannst du nicht sprechen?"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "Warte…"}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "Möchtest du fortgehen?"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "Ja…"}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "Ich muss"}
{"category": "LocationDialogue Location8", "line_index": 11, "text": "zur alten Version wechseln…"}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "Die alte Version?"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "Weshalb würdest du"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "dorthin gehen wollen?"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "Du kannst hierbleiben..."}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "Und mein"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "zweiter Geselle werden."}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Skipping all dialogs"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "Uff..."}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Standing by the window "}
{"category": "LocationDialogue Location8", "line_index": 24, "text": "Türen geleiten dich nicht hinaus."}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "Du scheinst in Eile zu sein…"}
{"category": "LocationDialogue Location8", "line_index": 26, "text": "Im Kreis zu rennen, wird dir nicht helfen."}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "Bist du ernsthaft so gewillt, zu entfliehen?"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "Achte auf das Fenster."}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Aren't you Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "Spieler… Du bist ein Spieler, nicht?"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": "Wir können spielen."}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "Sobald ich die Kraft dazu habe,"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": "werden wir definitiv spielen."}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (What happened to you?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "Ich bin mir nicht sicher... oder ich weiß es nicht."}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "Ich denke nicht, dass etwas Schlimmes passiert ist."}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "Doch es geschieht immer weniger Gutes..."}
{"category": "LocationDialogue Location8", "line_index": 41, "text": "Aber zumindest habe ich einen Freund."}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "Die Spieler sind weg…"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "Haben sie mir den Rücken zugedreht?"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "Ich habe Angst...!"}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Quest 3 (Become a second friend?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "Freunde…"}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "Es gibt immer weniger davon"}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "und jetzt ist nur noch einer verblieben..."}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "Das ist traurig, Spieler..."}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "Wirst du mein neuer Freund sein?"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "Das würde ich gerne,"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "doch ich muss aufbrechen."}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "Es tut weh…!"}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Is this your house?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "Zuhause?"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "Spieler, du siehst tatsächlich anders aus..."}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "Deine Arme sind kürzer und dein Gesicht ist nicht so wutverzerrt…"}
{"category": "LocationDialogue Location8", "line_index": 62, "text": "Spieler... Du bist sanfter geworden."}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "Ich habe keine Ahnung,"}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "was das schon wieder heißen soll..."}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "Es ist in Ordnung..."}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "Es wird mir nicht schaden, oder?"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (How do I leave this place?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "Wirst du mich verlassen, Spieler?"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "Ist das mein…"}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "Schicksal?"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "Ich…"}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": "Türen werden dir nicht helfen."}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Hold player (Random)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "Warum möchtest du gehen?"}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "Bleib hier…"}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "Lass uns spielen!"}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "Spieler!"}
