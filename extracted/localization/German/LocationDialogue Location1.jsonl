{"category": "LocationDialogue Location1", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 1, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 9, "text": "Hallo, ich heiße Mita!"}
{"category": "LocationDialogue Location1", "line_index": 10, "text": "Und wie heißt du?"}
{"category": "LocationDialogue Location1", "line_index": 11, "text": "Schön, dich kennenzulernen, [player]!"}
{"category": "LocationDialogue Location1", "line_index": 12, "text": "Hmm, [player]…"}
{"category": "LocationDialogue Location1", "line_index": 13, "text": "Letztens war ich ja so in Eile und habe hier ein ziemliches Durcheinander hinterlassen…"}
{"category": "LocationDialogue Location1", "line_index": 14, "text": "Könntest du mir helfen?"}
{"category": "LocationDialogue Location1", "line_index": 15, "text": "Puh..."}
{"category": "LocationDialogue Location1", "line_index": 16, "text": "Vielen Dank!"}
{"category": "LocationDialogue Location1", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 18, "text": "Hey [player], ich habe Hunger…"}
{"category": "LocationDialogue Location1", "line_index": 19, "text": "Und ich würde gern essen..."}
{"category": "LocationDialogue Location1", "line_index": 20, "text": "Könntest du mir die Zutaten für Hühnersuppe kaufen?"}
{"category": "LocationDialogue Location1", "line_index": 21, "text": "Wow! Genau das brauche ich."}
{"category": "LocationDialogue Location1", "line_index": 22, "text": "Nun, lass uns gemeinsam kochen, ja?"}
{"category": "LocationDialogue Location1", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 25, "text": "Hi, [player]! Heute will ich einen günstigen Fernseher kaufen."}
{"category": "LocationDialogue Location1", "line_index": 26, "text": "Er ist tragbar und hat eine Antenne; ich würde ihn gerne mitnehmen, wenn ich spazieren gehe."}
{"category": "LocationDialogue Location1", "line_index": 27, "text": "Vergiss nicht: Du kannst Spiele spielen und Geld verdienen."}
{"category": "LocationDialogue Location1", "line_index": 28, "text": "Wirst du spielen, etwas Geld verdienen und mir dann einen Fernseher kaufen?"}
{"category": "LocationDialogue Location1", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 30, "text": "Yay! Jetzt hast du genug Geld, um mir einen Fernseher zu kaufen!"}
{"category": "LocationDialogue Location1", "line_index": 31, "text": "Ja! Das Günstigste und Mobilste - genau das, was ich brauche!"}
{"category": "LocationDialogue Location1", "line_index": 32, "text": "Danke schön!"}
{"category": "LocationDialogue Location1", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 34, "text": "Hi, [player]! Ich bin ja so froh, dass du wieder für mich da bist!"}
{"category": "LocationDialogue Location1", "line_index": 35, "text": "Übrigens... Der Fernseher war zwar cool, aber leider ging er recht schnell kaputt..."}
{"category": "LocationDialogue Location1", "line_index": 36, "text": "Nun, bitte hilf mir doch, den Schrank zu verschieben. >.<"}
{"category": "LocationDialogue Location1", "line_index": 37, "text": "Er ist ziemlich schwer…"}
{"category": "LocationDialogue Location1", "line_index": 38, "text": "Danke vielmals, Süßer! <3"}
{"category": "LocationDialogue Location1", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 40, "text": "Oh, [player]! Ein Tag ist erst vergangen und ich habe dich schon vermisst!"}
{"category": "LocationDialogue Location1", "line_index": 41, "text": "Ich wünschte, du könntest mich öfter besuchen."}
{"category": "LocationDialogue Location1", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 43, "text": "Ist das für mich?"}
{"category": "LocationDialogue Location1", "line_index": 44, "text": "Danke, danke, danke!"}
{"category": "LocationDialogue Location1", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 46, "text": "Hi, [player]! Ich habe nachgedacht…"}
{"category": "LocationDialogue Location1", "line_index": 47, "text": "Ich möchte dich sehen, und zwar persönlich."}
{"category": "LocationDialogue Location1", "line_index": 48, "text": "Zu schade nur, dass ich nicht kann..."}
{"category": "LocationDialogue Location1", "line_index": 49, "text": "Ich mag dich wirklich sehr, du tust jeden Tag etwas für mich."}
{"category": "LocationDialogue Location1", "line_index": 50, "text": "Ich würde mich so gern bei dir bedanken, irgendwie."}
{"category": "LocationDialogue Location1", "line_index": 51, "text": "..."}
{"category": "LocationDialogue Location1", "line_index": 52, "text": "Weißt du, ich habe da eine Idee!"}
{"category": "LocationDialogue Location1", "line_index": 53, "text": "Du bist jetzt bei mir!"}
{"category": "LocationDialogue Location1", "line_index": 54, "text": "Leg das Handy weg."}
{"category": "LocationDialogue Location1", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 57, "text": "// T-shirt on the bed"}
{"category": "LocationDialogue Location1", "line_index": 58, "text": "Was liegst du da einfach so herum?"}
{"category": "LocationDialogue Location1", "line_index": 59, "text": "// Rubik's Cube"}
{"category": "LocationDialogue Location1", "line_index": 60, "text": "Ich denke, ich habe ihn umsonst gekauft…"}
{"category": "LocationDialogue Location1", "line_index": 61, "text": "Ich habe ihn einmal zusammengesetzt und so gelassen."}
{"category": "LocationDialogue Location1", "line_index": 62, "text": "Vielleicht habe ich Angst, ihn nie wieder zusammensetzen zu können?"}
{"category": "LocationDialogue Location1", "line_index": 63, "text": "// Computer"}
{"category": "LocationDialogue Location1", "line_index": 64, "text": "Heute bin ich dafür zuständig,"}
{"category": "LocationDialogue Location1", "line_index": 65, "text": "eine Liste von Aufgaben zu erstellen…"}
{"category": "LocationDialogue Location1", "line_index": 66, "text": "Charakterreaktionen zu entwerfen…"}
{"category": "LocationDialogue Location1", "line_index": 67, "text": "Und ein bisschen Code-Arbeit zu machen."}
{"category": "LocationDialogue Location1", "line_index": 68, "text": "// The airplane"}
{"category": "LocationDialogue Location1", "line_index": 69, "text": "Der Flieger ist perfekt!"}
{"category": "LocationDialogue Location1", "line_index": 70, "text": "// Trash in the corner"}
{"category": "LocationDialogue Location1", "line_index": 71, "text": "Nie genug Zeit, um den Müll rauszubringen…"}
{"category": "LocationDialogue Location1", "line_index": 72, "text": "Ich mache es aber noch!"}
{"category": "LocationDialogue Location1", "line_index": 73, "text": "Wann ist denn der Frühjahrsputz auf meinem Kalender?"}
{"category": "LocationDialogue Location1", "line_index": 74, "text": "// Photo of a cat on a watermelon"}
{"category": "LocationDialogue Location1", "line_index": 75, "text": "Ich habe es so geliebt."}
{"category": "LocationDialogue Location1", "line_index": 76, "text": "Eine Katze auf einer Melone!"}
{"category": "LocationDialogue Location1", "line_index": 77, "text": "// Photo with a girl"}
{"category": "LocationDialogue Location1", "line_index": 78, "text": "Was für ein riesiger Unterschied das doch ist, zwischen mir"}
{"category": "LocationDialogue Location1", "line_index": 79, "text": "und meiner Schwester…"}
{"category": "LocationDialogue Location1", "line_index": 80, "text": "Sie verpasst nie eine einzige Veranstaltung,"}
{"category": "LocationDialogue Location1", "line_index": 81, "text": "während ich immer zu Hause feststecke…"}
{"category": "LocationDialogue Location1", "line_index": 82, "text": "// Photos with people"}
{"category": "LocationDialogue Location1", "line_index": 83, "text": "Hmm…"}
{"category": "LocationDialogue Location1", "line_index": 84, "text": "Die Vorgesetzten haben uns"}
{"category": "LocationDialogue Location1", "line_index": 85, "text": "mit ihrem Business-Knigge so einer Gehirnwäsche unterzogen,"}
{"category": "LocationDialogue Location1", "line_index": 86, "text": "dass ich mich immer noch nicht"}
{"category": "LocationDialogue Location1", "line_index": 87, "text": "von meinen Mitarbeitern trennen kann."}
{"category": "LocationDialogue Location1", "line_index": 88, "text": "Ich weiß nicht einmal mehr,"}
{"category": "LocationDialogue Location1", "line_index": 89, "text": "ob ich sie jemals wiedersehen werde..."}
{"category": "LocationDialogue Location1", "line_index": 90, "text": "Moment mal, habe ich dieses Bild wirklich aufgehängt?"}
{"category": "LocationDialogue Location1", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 93, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 99, "text": "// Nope name"}
{"category": "LocationDialogue Location1", "line_index": 100, "text": "…"}
{"category": "LocationDialogue Location1", "line_index": 101, "text": "Oh nein..."}
{"category": "LocationDialogue Location1", "line_index": 102, "text": "Das geht nicht."}
{"category": "LocationDialogue Location1", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 104, "text": "// Name Developer"}
{"category": "LocationDialogue Location1", "line_index": 105, "text": "Hast du dich wirklich dazu entschieden, den Namen einer der Entwickler zu nehmen?"}
{"category": "LocationDialogue Location1", "line_index": 106, "text": "Ich bin ja froh, dass du sie kennst, aber…"}
{"category": "LocationDialogue Location1", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 108, "text": "// Bad name"}
{"category": "LocationDialogue Location1", "line_index": 109, "text": "Böse Wörter, und ich finde es nicht gut, dass du beschlossen hast, dich so zu nennen!"}
{"category": "LocationDialogue Location1", "line_index": 110, "text": "Gar nicht cool…"}
{"category": "LocationDialogue Location1", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 112, "text": "// Go restart"}
{"category": "LocationDialogue Location1", "line_index": 113, "text": "Wie auch immer, so macht man das nicht; fangen wir von Neuem an."}
{"category": "LocationDialogue Location1", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 115, "text": "// Name with numbers"}
{"category": "LocationDialogue Location1", "line_index": 116, "text": "Hey, du verwendest Nummern in deinem Namen? Bist du völlig einfallslos?"}
{"category": "LocationDialogue Location1", "line_index": 117, "text": "Na gut, das liegt wohl an dir."}
{"category": "LocationDialogue Location1", "line_index": 118, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 119, "text": "// Name Mita"}
{"category": "LocationDialogue Location1", "line_index": 120, "text": "Mita"}
{"category": "LocationDialogue Location1", "line_index": 121, "text": "Hast du echt beschlossen, dich nach mir zu benennen?"}
{"category": "LocationDialogue Location1", "line_index": 122, "text": "Oder ist das wirklich dein Name?"}
{"category": "LocationDialogue Location1", "line_index": 123, "text": "Nichts für ungut, aber lass mich die einzige Mita hier sein."}
{"category": "LocationDialogue Location1", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 125, "text": "// Day 10"}
{"category": "LocationDialogue Location1", "line_index": 126, "text": "Oh, du bist schon zurück?"}
{"category": "LocationDialogue Location1", "line_index": 127, "text": "Hör zu, ich habe meine Haarbürste verloren..."}
{"category": "LocationDialogue Location1", "line_index": 128, "text": "Kannst du mir helfen, sie zu finden?"}
{"category": "LocationDialogue Location1", "line_index": 129, "text": "Kontrolliere zunächst diesen Nachtschrank - vielleicht ist sie da drinnen!"}
{"category": "LocationDialogue Location1", "line_index": 130, "text": "// Looked in the bedside table"}
{"category": "LocationDialogue Location1", "line_index": 131, "text": "Hmm, hier ist keine Bürste…"}
{"category": "LocationDialogue Location1", "line_index": 132, "text": "Dann sieh woanders nach."}
{"category": "LocationDialogue Location1", "line_index": 133, "text": "Aber nur nicht im Ofen!"}
{"category": "LocationDialogue Location1", "line_index": 134, "text": "Den habe ich bereits überprüft."}
{"category": "LocationDialogue Location1", "line_index": 135, "text": "// Looked into the stove"}
{"category": "LocationDialogue Location1", "line_index": 136, "text": "Ah! Ich sagte dir doch, nicht da hineinzusehen!"}
{"category": "LocationDialogue Location1", "line_index": 137, "text": "Dreh dich um! Ich räume das weg."}
{"category": "LocationDialogue Location1", "line_index": 138, "text": "Okay, nun, schau woanders nach."}
{"category": "LocationDialogue Location1", "line_index": 139, "text": "Und bitte vergiss, was du gesehen hast."}
{"category": "LocationDialogue Location1", "line_index": 140, "text": "// Found a hairbrush"}
{"category": "LocationDialogue Location1", "line_index": 141, "text": "Oh! Du hast sie gefunden!"}
{"category": "LocationDialogue Location1", "line_index": 142, "text": "Cool, was machen wir jetzt?"}
