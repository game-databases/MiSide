{"category": "LocationDialogue Location9", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Hey, du!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Hallo!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Du willst hier raus?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Dann hilf mir, den Schlüssel zu finden!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Mist! Da ist kein Schlüssel..."}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Leer!"}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "Rein gar nichts!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Gefunden!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// The usual conversation"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Ich dachte, du wärst kleiner!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "Aber du bist so groß..."}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "Wie eine Schwester!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "Ähm… Schwester?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Ja, Schwester."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Tu nicht so, als hättest du sie nie getroffen!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Hast du denn? Das ist nicht die korrekte Bezeichnung..."}
{"category": "LocationDialogue Location9", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Bist du ein Trottel?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "Ähm…"}
{"category": "LocationDialogue Location9", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "Offenbar schon…"}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "Na los, zeig mir, wo ich den Schlüssel finde!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// Next work"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Hier."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Kipp das Eisen in die Röhre!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Danke!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "Hol jetzt das Holz für mich herunter!"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Danke dir."}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Hilf jetzt hierbei!"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Fertig! Und nun…"}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "Sieh nur, wie hübsch!"}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Drück drauf, na los!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Hey!"}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "Das war's. Nimm ihn!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "Der Schlüssel gehört dir!"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// Quest 1 (Are you Mita?)"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Ich bin ChibiMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "Mit einer Menge Zeilen,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "der simpelsten Ausstattung"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "und dem reizendsten Haar!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// Quest 2 (Have we seen each other yet?)"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Herr Dummkopf..."}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "Du bist wirklich süß,"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "wenn du so blöde Fragen stellst."}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Allerdings"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "sehe ich dich zum ersten Mal!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Aber…"}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Falls jemand doch mein zauberhaftes Antlitz stehlen würde,"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "hätte er ein schlechtes Gewissen!"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// Quest 3 (Why are you here?)"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Kapierst du es nicht?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "Das hier ist ein Checkpoint -"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "ein Test, bei dem du Köpfchen beweisen musst!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "Und jetzt komm!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Ich eskortiere die töricht Verlorenen!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// Quest 4 (Why are you helping me?)"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "Und wer bist du,"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "dass ich dir NICHT helfen sollte?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "Was?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Dummkopf."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Du bist einfach so erschienen!"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Du solltest nicht hier sein..."}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "Also helfe ich dir!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Tschüssi, Dummerchen!"}
