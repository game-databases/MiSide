{"category": "LocationDialogue Location12", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Bleib hier."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Ich glaube, mir ist etwas abhandengekommen. Ich bin gleich zurück..."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "Dann nehmen wir uns eine andere, neue Welt vor."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Okay."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Lass uns spielen!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Ich will meinen Teddybaeren!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "Ich habe ihn verloren…"}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "Finde IHN!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Du…"}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "Was starrst du so?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Quest 1 (Who are you?)"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Ich bin Mita."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "Die beste Mita."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "Die erste Mita."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "Das hat Mita so gesagt, meine Mita."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Quest 2 (Why do you look like that?)"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "Wie sehe ich denn aus?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "Wie sehe ich denn aus?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "Wie sehe ich denn aus?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "Meine Mita sagt, ich bin huebsch und originell..."}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "So sehe ich aus!"}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Quest 3 (What was Mita doing here?)"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Sie wird mich mitnehmen."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Wir werden in einer neuen Welt leben."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "Meine Mita hat mich eingeladen."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Sie wird mich mitnehmen... Wir werden spielen!"}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Quest 4 (Why do you need a teddy bear?)"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "Du bist ein kleiner Baer."}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "Und du hast dich verirrt..."}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "So wie mein Teddybaer."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Quest 5 (Why is Mita angry?)"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "Meine…"}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "Mita."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Sie moechte spielen..."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Sie moechte"}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "nur mich mitnehmen."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Wir sind das Original."}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "Wir sind die Einzigen."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Mita und meine Mita;"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0.8A und 8М54*..."}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Quest 6 (Do you believe Mita?)"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "Meine Mita..."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "Meine beste Freundin."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "Meine Mita..."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "Meine einzige Freundin."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "Du bist es!"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Schau."}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Lass uns spielen!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Ich zeige dir, wie..."}
