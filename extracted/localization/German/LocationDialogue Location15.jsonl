{"category": "LocationDialogue Location15", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Da bist du!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Warum hast du das Kernstück verlassen?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Ich sagte doch, du sollst auf mich warten, oder etwa nicht?!"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Ich dachte halt, du wärst für eine Zeit lang weg gewesen und..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Na gut, alles klar…"}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Ich denke, ich habe etwas gefunden..."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Ich glaube, es ist ein Index."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Wir werden sehen, ob es funktioniert!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Verschwinden wir!"}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "Psycho-Mita…"}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Vermutlich ist sie gerade mit den neuen Spielern beschäftigt."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Also, schätze ich, haben wir freie Bahn!"}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Mita?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Warte auf mich!"}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Du hast da etwas verloren!?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Begegne ihr noch einmal!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Mita…"}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Fang!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Wie nur…?"}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Wer bist du?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Du… du lebst!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Erinnerst du dich an gar nichts mehr?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Kenne ich dich?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Was ist mit dir…?"}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Was soll ich jetzt tun?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Ich kann nicht hinaus…"}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "Was meinst du mit „hinauskönnen“?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Moment..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "Das ist der Ring..."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "Und das da?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Ich weiß nicht, was das ist."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "Ein Index!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Du hast ihn also doch gefunden!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Ich weiß nicht, was ich sagen soll..."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Wir müssen zurück zum Kernstück."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "Und du…"}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Vielleicht solltest du mitkommen."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Was?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Na gut..."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Warte hier."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Mhm."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Ich bleibe hier sitzen."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Scheiße…"}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "Ich bin fast gestorben…"}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "Also… Haben wir es geschafft?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Okay..."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "In dieser Version bin ich."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Hallo!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Du bist ein Spieler, richtig?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Wie heißt du?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Ich möchte diesen Ort verlassen…"}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Du möchtest schon gehen?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "Wie bist du überhaupt hierhergekommen?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Hmm…"}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Naja, du kannst gehen."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Versuche einfach, das Haus zu verlassen."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Viel Erfolg dabei!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Eine Wand?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Äh, so sollte es nicht sein."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Vielleicht…"}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "Hilft dir ja das, was sich im Keller befindet."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Letztens habe ich"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "eine Tür in meinem Schrank entdeckt…"}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Es stellt sich heraus, dass sie zu einem Keller führt."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Dieser ist augenscheinlich für allerlei Krempel..."}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "All die schicke Ausrüstung wird ebenfalls dort aufbewahrt."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Man muss da eine Art Code eingeben oder so…"}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Ich verstehe es nicht ganz"}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "und ich will es auch nicht."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "Außerdem ist es da irgendwie ungemütlich, und ich meine, so richtig ungemütlich…"}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Wirst du einmal nachsehen?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Ähm… okay?"}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Ich glaube…"}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "Sie erinnert sich an nichts mehr."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Also ist er uns wohl gelungen,"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "der Neustart."}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Alles, was noch übrig bleibt, ist,"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "aus diesem verdammten Spiel hinauszukommen…"}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Warte!"}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Ich würde dich gerne umarmen."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Was?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Es war schön, dich zu sehen."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Hach…"}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "Wie schade,"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "dass du und ich"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "so wenig Zeit miteinander verbracht haben…"}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Ich begreife es nicht…"}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "Wovon redest du?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Was ich sagen will, ist..."}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "Du hättest bei mir bleiben können;"}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "es ist all meine Schuld…"}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Der Kleiderschrank und die… die Geräusche…"}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Wenn ich sie nur früher GETÖTET hätte!"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Warte mal,"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "du…"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Wie kannst du dich daran erinnern?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "HAHA!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Hast du ernsthaft geglaubt, es wäre so einfach?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Du bist nicht mehr als ein Narr,"}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "wie jeder andere auch…"}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Wir haben es perfekt hinbekommen, sieh her!"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "Nun"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "wird dein reales Ich"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "nicht länger benötigt."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Entschuldige!"}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Ich fasse es nicht…"}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Es hat nicht funktioniert?"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Nein, ich konnte dich doch definitiv neu starten!"}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Du verstehst es noch immer nicht?"}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Hahaha!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Welch ein hervorragender Schauspieler ich doch bin!"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Du solltest dein Gesicht sehen, Schätzchen!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "Es macht so viel Spaß!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Warum verhältst du dich so?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Was ist falsch mit dir?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Ja, genau…"}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Was ist falsch mit mir?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Ich weiß es nicht!"}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Warum sagst du mir denn nicht, weshalb ich so bin?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Weshalb ich niemals eine Mita sein werde?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Schließlich hat meine Version"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "nie existiert!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Ich reiße jenen einfältigen Narren lediglich ihre Haut vom Leibe!"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "Und verstecke mich darunter…"}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Man kann mich einfach nicht"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "neu starten!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Ich kann es nicht glauben…"}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Du…"}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "Nicht sie sind das Problem!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "Du bist diejenige, die nicht existieren sollte!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "Und jetzt auch noch du..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Es schmerzt, dich das sagen zu hören."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "Und doch!"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Es ist an der Zeit für dich, zu gehen!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Ich sehe dich bald wieder!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Es ist fertig,"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "wie ich denke."}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "Zeit, dich aus der Konsole herauszuholen!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "Bis später!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Du wirst meine Lieblingsspeicherkarte sein!"}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "...Ein Spieler mit einem solch interessanten Namen!"}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Wahrscheinlich ist es das nicht..."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Passt auch nicht..."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Nö."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Das ist nicht das, was ich brauche..."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Ich muss eine Möglichkeit zum Neustarten eines Charakters finden."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "Das ist die falsche Version..."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Ups, mein Fehler."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Das ist es nicht..."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Ich muss das ausbessern."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Es stimmt etwas nicht..."}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "Der Index ist falsch."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Ich muss den Index erneut eingeben."}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "Passt nicht..."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Hast du Hunger?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Ich kann gut Karotten schneiden."}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Oh, ich schätze…"}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "Du wolltest alleine hierhin?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Wieso gehen wir im Kreis?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Warum sind wir zurückgegangen?"}
