{"category": "LocationDialogue Location17", "line_index": 0, "text": "// Player thinks + Make coffee"}
{"category": "LocationDialogue Location17", "line_index": 1, "text": "Scheint, als könnte ich das nicht alleine bewerkstelligen."}
{"category": "LocationDialogue Location17", "line_index": 2, "text": "Ich hoffe ja mal, diese Mita hier beißt nicht…"}
{"category": "LocationDialogue Location17", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 4, "text": "Womit verschwende ich bloß meine Zeit…?"}
{"category": "LocationDialogue Location17", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 9, "text": "// Player tries to wake up MitaDreamer"}
{"category": "LocationDialogue Location17", "line_index": 10, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 11, "text": "Mita, wach auf!"}
{"category": "LocationDialogue Location17", "line_index": 12, "text": "Mi-ta!"}
{"category": "LocationDialogue Location17", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 14, "text": "Mita, wach auf!"}
{"category": "LocationDialogue Location17", "line_index": 15, "text": "Ich brauche deine Hilfe!"}
{"category": "LocationDialogue Location17", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 17, "text": "...Wer bist duuu?"}
{"category": "LocationDialogue Location17", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 19, "text": "Hilf mir mit den Schaltern."}
{"category": "LocationDialogue Location17", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 21, "text": "Was für Schalter?"}
{"category": "LocationDialogue Location17", "line_index": 22, "text": "Uff... Lass mich schlafen…"}
{"category": "LocationDialogue Location17", "line_index": 23, "text": "Oder... koch Kaffee."}
{"category": "LocationDialogue Location17", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 25, "text": "Sie sind gerade mal zwei Schritte entfernt…"}
{"category": "LocationDialogue Location17", "line_index": 26, "text": "Mita?"}
{"category": "LocationDialogue Location17", "line_index": 27, "text": "Mi-ta!"}
{"category": "LocationDialogue Location17", "line_index": 28, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 31, "text": "// Player gives away the coffee"}
{"category": "LocationDialogue Location17", "line_index": 32, "text": "Mita..."}
{"category": "LocationDialogue Location17", "line_index": 33, "text": "Hier ist der Kaffee."}
{"category": "LocationDialogue Location17", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 37, "text": "// MitaDreamer exercise"}
{"category": "LocationDialogue Location17", "line_index": 38, "text": "Also, wie war das?"}
{"category": "LocationDialogue Location17", "line_index": 39, "text": "Schalter?"}
{"category": "LocationDialogue Location17", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 41, "text": "Jap."}
{"category": "LocationDialogue Location17", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 43, "text": "Wie weißt du davon?"}
{"category": "LocationDialogue Location17", "line_index": 44, "text": "Na, wobei... Weshalb frage ich überhaupt?"}
{"category": "LocationDialogue Location17", "line_index": 45, "text": "Wenn du hier bist,"}
{"category": "LocationDialogue Location17", "line_index": 46, "text": "weißt du schon über einen Haufen Dinge Bescheid."}
{"category": "LocationDialogue Location17", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 48, "text": "...Warte,"}
{"category": "LocationDialogue Location17", "line_index": 49, "text": "ich muss mich hinsetzen."}
{"category": "LocationDialogue Location17", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 51, "text": "Und?"}
{"category": "LocationDialogue Location17", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 53, "text": "Ich weiß nicht, was ich dir noch sagen soll,"}
{"category": "LocationDialogue Location17", "line_index": 54, "text": "aber ich muss weitergehen."}
{"category": "LocationDialogue Location17", "line_index": 55, "text": "Entlang der Route, die der Ring vorgibt…"}
{"category": "LocationDialogue Location17", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 57, "text": "Du hast ihren Ring?"}
{"category": "LocationDialogue Location17", "line_index": 58, "text": "Das erklärt wohl,"}
{"category": "LocationDialogue Location17", "line_index": 59, "text": "wie du hierhergelangt bist."}
{"category": "LocationDialogue Location17", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 61, "text": "Das stimmt."}
{"category": "LocationDialogue Location17", "line_index": 62, "text": "Also, kannst du mir helfen?"}
{"category": "LocationDialogue Location17", "line_index": 63, "text": "Mit den Schaltern?"}
{"category": "LocationDialogue Location17", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 65, "text": "Klar."}
{"category": "LocationDialogue Location17", "line_index": 66, "text": "Werde ich machen…"}
{"category": "LocationDialogue Location17", "line_index": 67, "text": "Mit den Schaltern…"}
{"category": "LocationDialogue Location17", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 70, "text": "Mita, schon wieder?"}
{"category": "LocationDialogue Location17", "line_index": 71, "text": "Gehen wir."}
{"category": "LocationDialogue Location17", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 73, "text": "Huh?"}
{"category": "LocationDialogue Location17", "line_index": 74, "text": "Alles klar,"}
{"category": "LocationDialogue Location17", "line_index": 75, "text": "lass uns gehen."}
{"category": "LocationDialogue Location17", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 78, "text": "// MitaDreamer fall"}
{"category": "LocationDialogue Location17", "line_index": 79, "text": "Steh auf."}
{"category": "LocationDialogue Location17", "line_index": 80, "text": "Bist du ernsthaft so müde?"}
{"category": "LocationDialogue Location17", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 82, "text": "// MitaDreamer again sleep"}
{"category": "LocationDialogue Location17", "line_index": 83, "text": "Wach auf..."}
{"category": "LocationDialogue Location17", "line_index": 84, "text": "Wir sind da."}
{"category": "LocationDialogue Location17", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 87, "text": "// Switches"}
{"category": "LocationDialogue Location17", "line_index": 88, "text": "Okay,"}
{"category": "LocationDialogue Location17", "line_index": 89, "text": "ich bin bereit."}
{"category": "LocationDialogue Location17", "line_index": 90, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 91, "text": "Ich auch."}
{"category": "LocationDialogue Location17", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 93, "text": "Nun…"}
{"category": "LocationDialogue Location17", "line_index": 94, "text": "Ich werde"}
{"category": "LocationDialogue Location17", "line_index": 95, "text": "bis drei zählen."}
{"category": "LocationDialogue Location17", "line_index": 96, "text": "Und dann ziehen wir gemeinsam an den Schaltern."}
{"category": "LocationDialogue Location17", "line_index": 97, "text": "Okay?"}
{"category": "LocationDialogue Location17", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 99, "text": "Schlaf bloß nicht ein;"}
{"category": "LocationDialogue Location17", "line_index": 100, "text": "fang an, zu zählen."}
{"category": "LocationDialogue Location17", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 103, "text": "3"}
{"category": "LocationDialogue Location17", "line_index": 104, "text": "2"}
{"category": "LocationDialogue Location17", "line_index": 105, "text": "1"}
{"category": "LocationDialogue Location17", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 107, "text": "// Player lose 1"}
{"category": "LocationDialogue Location17", "line_index": 108, "text": "Was machst du?"}
{"category": "LocationDialogue Location17", "line_index": 109, "text": "Nun,"}
{"category": "LocationDialogue Location17", "line_index": 110, "text": "lass es uns erneut probieren…"}
{"category": "LocationDialogue Location17", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 112, "text": "// Player lose 2"}
{"category": "LocationDialogue Location17", "line_index": 113, "text": "Schon wieder?"}
{"category": "LocationDialogue Location17", "line_index": 114, "text": "Noch ein kleines bisschen"}
{"category": "LocationDialogue Location17", "line_index": 115, "text": "und ich"}
{"category": "LocationDialogue Location17", "line_index": 116, "text": "werde einschlafen…"}
{"category": "LocationDialogue Location17", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 118, "text": "// Player lose 3"}
{"category": "LocationDialogue Location17", "line_index": 119, "text": "Uff... Ich schlafe bald ein..."}
{"category": "LocationDialogue Location17", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 122, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 123, "text": "Großartig."}
{"category": "LocationDialogue Location17", "line_index": 124, "text": "Danke dir, Mita."}
{"category": "LocationDialogue Location17", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 126, "text": "Mhm."}
{"category": "LocationDialogue Location17", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 129, "text": "So ein"}
{"category": "LocationDialogue Location17", "line_index": 130, "text": "langsames"}
{"category": "LocationDialogue Location17", "line_index": 131, "text": "Toor…"}
{"category": "LocationDialogue Location17", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 134, "text": "Ich gehe schlafen..."}
{"category": "LocationDialogue Location17", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 136, "text": "// Why kitchen?"}
{"category": "LocationDialogue Location17", "line_index": 137, "text": "Warum sind wir hierhergekommen?"}
{"category": "LocationDialogue Location17", "line_index": 138, "text": "Wenn ich auf einem eisigen Küchenboden einschlafe,"}
{"category": "LocationDialogue Location17", "line_index": 139, "text": "ist das deine Schuld..."}
{"category": "LocationDialogue Location17", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 141, "text": "// Why bathroom?"}
{"category": "LocationDialogue Location17", "line_index": 142, "text": "Ich verstehe es nicht…"}
{"category": "LocationDialogue Location17", "line_index": 143, "text": "An welchen Schaltern wolltest du nochmal ziehen?"}
{"category": "LocationDialogue Location17", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 145, "text": "// Put button"}
{"category": "LocationDialogue Location17", "line_index": 146, "text": "Es passiert nichts?"}
{"category": "LocationDialogue Location17", "line_index": 147, "text": "Warum ist dann der Knopf hier?"}
{"category": "LocationDialogue Location17", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 149, "text": "// Cofee"}
{"category": "LocationDialogue Location17", "line_index": 150, "text": "Warum trinkst du nicht etwas mehr Kaffee?"}
{"category": "LocationDialogue Location17", "line_index": 151, "text": "Du wirst sonst wieder einschlafen."}
{"category": "LocationDialogue Location17", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 153, "text": "Was?"}
{"category": "LocationDialogue Location17", "line_index": 154, "text": "Neeein."}
{"category": "LocationDialogue Location17", "line_index": 155, "text": "Dieser Kaffee schmeckt grauenvoll…"}
{"category": "LocationDialogue Location17", "line_index": 156, "text": "Ich komme schon klar."}
{"category": "LocationDialogue Location17", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location17", "line_index": 158, "text": "// Button"}
{"category": "LocationDialogue Location17", "line_index": 159, "text": "Mita? Der Knopf funktioniert nicht; kannst du mich hören?"}
{"category": "LocationDialogue Location17", "line_index": 160, "text": "Hallo?"}
