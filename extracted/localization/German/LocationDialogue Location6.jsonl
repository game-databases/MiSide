{"category": "LocationDialogue Location6", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "Mita?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "Wie bist du hierhergelangt?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Du bist Mita, oder?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Aber irgendetwas stimmt nicht…"}
{"category": "LocationDialogue Location6", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "Verstehe."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "Schau, es ist wahr."}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "Ich bin nicht die Mita, die du gesehen hast."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Sieh dich vor, sie hat einige..."}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "Schlimme Pläne."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "Was für Pläne?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "Scheiße...!"}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "Wenn das funktioniert, erkläre ich dir alles."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Finde den Schlüssel an der Couch!"}
{"category": "LocationDialogue Location6", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Aber…"}
{"category": "LocationDialogue Location6", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "Du kannst später Fragen stellen!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Gib mir den Schlüssel."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Hier ist der Ring."}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "Hä?"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Du willst von hier entfliehen, stimmt's?"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "Äh, ja…"}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Dann setze ihn auf."}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "Er ist ein nützliches Artefakt;"}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "ich schätze, du wirst ihn demnächst brauchen."}
{"category": "LocationDialogue Location6", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Okay…"}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "Übrigens, ich bin…"}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Weiter so,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "Und ich bin… Mita."}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// MitaKind quest 1"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "Schau!"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "Die Konsole, nimm sie!"}
{"category": "LocationDialogue Location6", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "Ist das eine Aufnahme?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "Wer ist das da, bei ihr?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "Das ist keine Aufnahme."}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "Das ist ein anderer Spieler."}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Sie nutzt ihn gerade aus..."}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Wisse, dass auch du"}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "es riskierst, zu einer Speicherkarte zu werden."}
{"category": "LocationDialogue Location6", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "Ich muss von hier entkommen..."}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "Und du auch!"}
{"category": "LocationDialogue Location6", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "Ja, sicher muss ich das."}
{"category": "LocationDialogue Location6", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "Du meintest,"}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "sie nutzt den Spieler aus..."}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "Was, wenn man die Speicherkarte aus der Konsole herauszieht?"}
{"category": "LocationDialogue Location6", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "Ich glaube, das würde zu"}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "unwiderruflichem Schaden an der Speicherkarte führen."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "Was bedeutet…"}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "Der Spieler würde sterben..."}
{"category": "LocationDialogue Location6", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "…"}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "Was, wenn man die Konsole einfach ausschaltet?"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "Hmm... Das könnte helfen!"}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Es ist einen Versuch wert; da ist ein roter Knopf!"}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Siehst du ihn?"}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "Gefunden!"}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "Drück drauf."}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// MitaKind quest 2"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Ich muss hierbleiben;"}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "ich möchte ihr ein paar Fragen stellen"}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "und mehr über sie herausfinden."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "Obwohl es unwahrscheinlich ist, dass sie sich auf angemessene Konversationen einlassen wird…"}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// MitaKind quest 3"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "Tatsächlich ist das meine Version;"}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "ich war diejenige mit dem Spieler."}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "Plötzlich hatte sich etwas verändert"}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "und dann tauchte sie auf,"}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "machte den Spieler zu einer Speicherkarte"}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "und sperrte mich hier ein."}
{"category": "LocationDialogue Location6", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Zu einer Speicherkarte...?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "Das kann sie tun?"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "Weshalb würde sie?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "Wozu braucht sie die Spieler?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "Sie ist wahnsinnig, das ist wohl klar…"}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Sie hat so viel Spaß, sie hat Spaß, Mann!"}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "Spieler werden zu Speicherkarten..."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Einige mögen nichts erahnen…"}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "Und andere realisieren es, doch wehren sich nicht, verdammt…!"}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "Das gefällt mir alles gar nicht!"}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "Schau, du musst uns helfen."}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "Ich? Wie das?"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "Ich brauche dich, Spieler!"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "Du hilfst uns und ich werde versuchen, dir zu helfen!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Möglicherweise wird es nicht noch eine Chance geben."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "Der Ring wird dich zu der richtigen Version geleiten;"}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "wir sehen uns dort."}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// MitaKind quest 4"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "Ich realisiere nicht ganz,"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "was ich da oben gesehen habe."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Diese Mita…"}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "Versucht sie, mich zu töten?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "Töten?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Ich fürchte, sie plant weitaus Schlimmeres…"}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "Du musst dich beeilen!"}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Hide!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "Oh, Scheiße! Versteck dich!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Was...?"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Beeile dich! Sie kommt hierher!"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "Vertraue dem Ring; mit ihm wirst du nach draußen finden!"}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "Na? Wirst du mir sagen, wo er sich aufhält?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "Warum sollte ich?"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "Du wirst ihn nicht töten, oder?"}
{"category": "LocationDialogue Location6", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Also verrätst du es mir wohl nicht…"}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Ist schon in Ordnung. Ich mag, dass er sich versteckt!"}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "Ich weiß, er ist hier."}
{"category": "LocationDialogue Location6", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "Warum bist du so aggressiv?"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "Du erzählst mir nicht einmal, was überhaupt los ist!"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "Und sowieso…"}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "Wozu brauchst du die Spieler?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "Sie sind keine Spielzeuge!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "Wieso fühlst du dich so angegriffen?"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "Ha! Schweig, Püppchen!"}
