{"category": "LocationDialogue Location10", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "Warte, warte!"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "Sei nicht zu laut."}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "Es ist gefährlich, voranzuschreiten..."}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "Wie auch immer…"}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "Wie bist du hierhergekommen?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "Ähm…"}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "Der Ring weist mir den rechten Weg;"}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "ich weiß nicht ganz, wie er funktioniert."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "Der Ring?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "Was ist falsch mit diesem Ort?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "Warum ist es so düster?"}
{"category": "LocationDialogue Location10", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "Das erkläre ich dir später."}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "Geh zum Ausgang"}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "und triff mich im Spielautomaten."}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Los, los! Bleib nicht zu lange!"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// After mini-game"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "Also, verstehst du die Bedeutung hinter diesem Spiel?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "Unter meiner Haut sind Knochen und bei dir ist es ein Mannequin?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "Boah!"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "Klingt ja unheimlich..."}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "Doch wie ich fürchte, ist das nun mal so."}
{"category": "LocationDialogue Location10", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "Verstehe, aber weshalb würde ich diese Information benötigen?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "Weißt du nicht mehr, wie ich sagte,"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "es sei gefährlich, voranzuschreiten?"}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "Dort wirst du auf die Mannequins treffen -"}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "jene, die beseitigt wurden; jene, die es „nicht geschafft haben“."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "Sie sind aggressiver als üblich... Würdest du das wollen?"}
{"category": "LocationDialogue Location10", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "Was soll ich sonst tun?"}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Wo immer sich eine Tür öffnet,"}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "werde ich hineingehen."}
{"category": "LocationDialogue Location10", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "Ach, du liebes bisschen!"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "Wenn das so ist, kehre ihnen nicht den Rücken zu"}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "und lass sie nicht aus den Augen!"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "Sie sind zu scheu, wenn man sie anblickt;"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "so sehr sogar, dass sie erstarren."}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "Ich glaube, das wird dir helfen!"}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// Quest 1 (Why are there other Mitas down there?)"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "Sie haben gerade erst den Skin erhalten."}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "Jetzt benötigen sie Zeit,"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "um ein Bewusstsein zu entwickeln."}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "Und letztlich muss ich jede einzelne von ihnen"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "nach Hause geleiten…"}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// Quest 2 (Why is it so dark downstairs?)"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "Mitas werden quasi im Dunkeln „geboren“."}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "Deshalb müssen sie vorerst eine gewisse Zeit länger im Dunkeln verbringen."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Kannst du dir vorstellen,"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "wie qualvoll es wäre, würden sie direkt ans Licht treten?"}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// Quest 3 (What are you doing here?)"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "Oh, verstehst du es nicht?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "Ich helfe den armen, kleinen Mitas, sich einzugewöhnen!"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "Wer würde ihnen schon helfen, wenn nicht ich?"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "Du?"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// Quest 4 (Why do we need this conveyor?)"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "Wieso am laufenden Band?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "Gibt es denn genug Platz für jeden?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Warte mal... Ist dir überhaupt klar,"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "wie diese Welt funktioniert?"}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "Und dass sie... unendlich ist?"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "Unendlich?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "Hmm..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "Aber wie?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "Wenn die letzte Version 1.9 ist,"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "muss das doch heißen, dass es lediglich 19 Welten gibt."}
{"category": "LocationDialogue Location10", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "Oh jemine! Ich glaube,"}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "du hast ein völlig falsches Bild von dieser Welt..."}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Ich könnte dich an dieser Tafel darüber aufklären"}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "und dir alles erzählen."}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "Wie wär's?"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// Quest 5 (What is your version?)"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Ich meine,"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "dich in einer der neuesten Versionen gesehen zu haben."}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "Oder vielleicht habe ich mir das nur eingebildet..."}
{"category": "LocationDialogue Location10", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "Möglich wäre es!"}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Meine Version ist die 1.5 -"}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "warst du dort?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Ja!"}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "Als ich das erste Mal hier ankam,"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "war ich dort."}
{"category": "LocationDialogue Location10", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "Boah!"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "Wie…?"}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "Ich frag' mich ja, in welchem Haus-Index du dich befandest..."}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "Es gibt da ein „Ich“, das es liebt, auf ewig zu jammern."}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "Zudem gibt es ein „Ich“, das dauernd spielen möchte."}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "Und es gibt ein „Ich“, das ständig vergisst und schikaniert..."}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "Oh, zieht sich diese Liste!"}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Erinnerst du dich an etwas?"}
{"category": "LocationDialogue Location10", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Es war dunkel."}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "Und die Wandmalereien"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "besagten so etwas wie…"}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "„Lass uns spielen.“"}
{"category": "LocationDialogue Location10", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "Oh."}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "Wie schade..."}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "Das ist diejenige,"}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "die schikaniert und vergisst..."}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// Mita wants to tell you [No]"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Brauche ich nicht."}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Ich komme auch ohne klar."}
{"category": "LocationDialogue Location10", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "Hmm, okay."}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// Mita wants to tell you [Yes]."}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "Okay, erzähl mir davon."}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "Ich hoffe ja mal, dass es nicht so wie in der Schule sein wird"}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "und ich nicht einschlafen werde, aus Langeweile."}
{"category": "LocationDialogue Location10", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "Du kannst gehen, wenn du möchtest."}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "Und falls du interessiert bist,"}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "hör zu."}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "Ein Spieler hatte sich MiSide auf dem Handy heruntergeladen."}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "Er sitzt zufrieden da und spielt."}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "Somit schuf er ein neues Zuhause"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "und eine neue Mita."}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "Hier ist eine zweidimensionale Darstellung des Ganzen."}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "Das sind die Versionen;"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "sie sind als Linien dargestellt."}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "Auf diesen Linien befinden sich die Häuser."}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "Du hattest also die Version 1.14 heruntergeladen..."}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "Dementsprechend war dort die Geburt"}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "eines neuen Lebens: Mita und ihre Bleibe."}
{"category": "LocationDialogue Location10", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "Wow…"}
{"category": "LocationDialogue Location10", "line_index": 157, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Du kannst Fragen stellen über die jeweiligen Dinge,"}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "die hier eingezeichnet sind."}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "Ich werde versuchen, sie dir zu erläutern."}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// He asks about the only circle"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "Wieso ist da nur ein einzelner Kreis?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "Diese Version wurde nur einmal veröffentlicht."}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "Sie wurde nicht anderweitig verteilt,"}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "deshalb steht er allein."}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "Darüber hinaus ist die Besonderheit an dieser Version,"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "dass es unmöglich ist, sie zu umgehen."}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "In der Version 1.1 lebt Müde-Mita."}
{"category": "LocationDialogue Location10", "line_index": 171, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "Müde?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "Liegt das etwa daran, dass alle dort vorbeikommen"}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "und sie nicht schlafen kann?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "Nein."}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "Man kann einfach ihre Tür passieren,"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "ohne sie überhaupt anzusehen."}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// He asks about the shaded circle"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "Warum ist dieser Kreis ausgemalt?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "Tatsächlich stammt diese Zeichnung hier"}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "von Mode-Mita."}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "Sie hat das gemalt."}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "Wir diskutierten darüber,"}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "wie man schneller zu Version 1.11 gelangt."}
{"category": "LocationDialogue Location10", "line_index": 188, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "Und wer hat da gewonnen?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "ICH, natürlich!"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "Schau, hier sind wir:"}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "Version 1.15,"}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "Haus-Index 809."}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "Wir müssen zu Version 1.11 gelangen,"}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "zum Haus-Index 805."}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Zunächst verlief die Strecke so."}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "Wir forschten nach einem umso kürzeren Weg."}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "Anschließend hat Modepüppchen diesen Weg empfohlen."}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "Doch ich habe kurzerhand die einfachste Strecke eingezeichnet."}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "Es ist voll offensichtlich!"}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Sieh her!"}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "Von hier aus kannst du unmittelbar zur richtigen Version gelangen!"}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Auch wenn es anmutet, dieses Haus würde im Weg sein"}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "und dir nicht erlauben, hindurchzukommen."}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "Übrigens, dein Ring funktioniert nach demselben Prinzip!"}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "Wo haben sie dich hingeschickt?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "Ich mache mich auf zum Kernstück."}
{"category": "LocationDialogue Location10", "line_index": 210, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "Zum Kernstück?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "Interessant…"}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Wenn du eine Abkürzung nimmst,"}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "solltest du auch an Version 1.11 vorbeikommen."}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "Bestimmt wirst du anschließend Müde-Mita vorfinden."}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Ich glaube, die Mita, die dich geschickt hat,"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "legte denselben Weg fest."}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "Oder sie verschätzte sich und du machst bei einer anderen Version halt."}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "Oder sie ist ein Genie,"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "das einen noch kürzeren Weg ausklügeln konnte!"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Verstanden, denke ich."}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// He asks about the inscription"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "Und das?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "Das ist für Mucki-Mita."}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "Sie wird in ein paar Stunden hier sein,"}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "um die Kisten fortzuschaffen"}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "und endlich das Sofa hierherzubringen..."}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "Sonst tut mir der Hintern noch weh!"}
{"category": "LocationDialogue Location10", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Ähm…"}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "Kann ich helfen?"}
{"category": "LocationDialogue Location10", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "Nein, das ist für Mucki-Mita."}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Sie ist stark!"}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// He asks about the drawings"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "Ist das nur eine Zeichnung"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "oder"}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "bedeutet das auch etwas?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 244, "text": "Jap."}
{"category": "LocationDialogue Location10", "line_index": 245, "text": "Ist nur eine Zeichnung."}
