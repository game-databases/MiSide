{"category": "LocationDialogue Location4", "line_index": 0, "text": "Mita?"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "Oh, du bist schon wach?"}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "Wie bist du hierhergekommen?"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": "Du warst doch bei mir."}
{"category": "LocationDialogue Location4", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 5, "text": "Nein."}
{"category": "LocationDialogue Location4", "line_index": 6, "text": "Du standest wie erstarrt vor dem Spiegel,"}
{"category": "LocationDialogue Location4", "line_index": 7, "text": "also bin ich gegangen."}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "Was ist mit den Zimmern?"}
{"category": "LocationDialogue Location4", "line_index": 9, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "Ich habe sie neu angeordnet,"}
{"category": "LocationDialogue Location4", "line_index": 11, "text": "um es für dich angenehmer zu machen."}
{"category": "LocationDialogue Location4", "line_index": 12, "text": "Das heißt..."}
{"category": "LocationDialogue Location4", "line_index": 13, "text": "Die Zimmer liegen nun nicht mehr in einer Reihe,"}
{"category": "LocationDialogue Location4", "line_index": 14, "text": "sondern so, wie sie sein sollten."}
{"category": "LocationDialogue Location4", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 16, "text": "Das hättest du nicht tun müssen."}
{"category": "LocationDialogue Location4", "line_index": 17, "text": "Ich war irgendwie dabei, mich daran zu gewöhnen..."}
{"category": "LocationDialogue Location4", "line_index": 18, "text": "Jedenfalls denke ich, dass du dich so wohler fühlen wirst."}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Mita card game"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "Okay."}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "Sollen wir dann anfangen, zu spielen?"}
{"category": "LocationDialogue Location4", "line_index": 22, "text": "Ich erkläre es dir kurz."}
{"category": "LocationDialogue Location4", "line_index": 23, "text": "Der Chip zeigt das entsprechende Symbol an,"}
{"category": "LocationDialogue Location4", "line_index": 24, "text": "zum Beispiel die Herzen:"}
{"category": "LocationDialogue Location4", "line_index": 25, "text": "Wir legen die Karten ab"}
{"category": "LocationDialogue Location4", "line_index": 26, "text": "und wenn du eine höhere Anzahl an Herzen"}
{"category": "LocationDialogue Location4", "line_index": 27, "text": "auf deiner Karte hast,"}
{"category": "LocationDialogue Location4", "line_index": 28, "text": "als ich,"}
{"category": "LocationDialogue Location4", "line_index": 29, "text": "dann gewinnst du."}
{"category": "LocationDialogue Location4", "line_index": 30, "text": "Nimm ein paar Karten."}
{"category": "LocationDialogue Location4", "line_index": 31, "text": "Jetzt ich."}
{"category": "LocationDialogue Location4", "line_index": 32, "text": "Wow!"}
{"category": "LocationDialogue Location4", "line_index": 33, "text": "Einige davon sind wirklich krass!"}
{"category": "LocationDialogue Location4", "line_index": 34, "text": "Ich fange an."}
{"category": "LocationDialogue Location4", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 44, "text": "Jetzt du."}
{"category": "LocationDialogue Location4", "line_index": 45, "text": "Dein Zug."}
{"category": "LocationDialogue Location4", "line_index": 46, "text": "Uh-huh!"}
{"category": "LocationDialogue Location4", "line_index": 47, "text": "Du bist dran."}
{"category": "LocationDialogue Location4", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 49, "text": "Erobere die Herzen!"}
{"category": "LocationDialogue Location4", "line_index": 50, "text": "Es geht nur um Stärke!"}
{"category": "LocationDialogue Location4", "line_index": 51, "text": "Achte auf die Verteidigung!"}
{"category": "LocationDialogue Location4", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 54, "text": "Der Sieg ist dein!"}
{"category": "LocationDialogue Location4", "line_index": 55, "text": "Du hast gewonnen!"}
{"category": "LocationDialogue Location4", "line_index": 56, "text": "Du gewinnst."}
{"category": "LocationDialogue Location4", "line_index": 57, "text": "Aw, du…!"}
{"category": "LocationDialogue Location4", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 59, "text": "Ich habe gewonnen!"}
{"category": "LocationDialogue Location4", "line_index": 60, "text": "Ich bin siegreich!"}
{"category": "LocationDialogue Location4", "line_index": 61, "text": "Der Sieg ist mein!"}
{"category": "LocationDialogue Location4", "line_index": 62, "text": "Schmeckt!"}
{"category": "LocationDialogue Location4", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 64, "text": "Unentschieden."}
{"category": "LocationDialogue Location4", "line_index": 65, "text": "Weder hinein noch hinaus..."}
{"category": "LocationDialogue Location4", "line_index": 66, "text": "Nicht vor und nicht zurück..."}
{"category": "LocationDialogue Location4", "line_index": 67, "text": "Alles gleich."}
{"category": "LocationDialogue Location4", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 79, "text": "// The card game is interrupted"}
{"category": "LocationDialogue Location4", "line_index": 80, "text": "Was ist das für ein Geräusch?"}
{"category": "LocationDialogue Location4", "line_index": 81, "text": "Es kommt aus dem Schrank."}
{"category": "LocationDialogue Location4", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 83, "text": "Ein Geräusch...?"}
{"category": "LocationDialogue Location4", "line_index": 84, "text": "Welches Geräusch?"}
{"category": "LocationDialogue Location4", "line_index": 85, "text": "Da war kein Geräusch."}
{"category": "LocationDialogue Location4", "line_index": 86, "text": "Sag, wie hörte es sich an?"}
{"category": "LocationDialogue Location4", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 88, "text": "Klopfen, als ob da jemand drin wäre."}
{"category": "LocationDialogue Location4", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 90, "text": "Aber da ist doch..."}
{"category": "LocationDialogue Location4", "line_index": 91, "text": "Da ist doch niemand...!"}
{"category": "LocationDialogue Location4", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 93, "text": "Ich möchte einmal nachsehen."}
{"category": "LocationDialogue Location4", "line_index": 94, "text": "Es ist schon komisch..."}
{"category": "LocationDialogue Location4", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 96, "text": "Warum...?"}
{"category": "LocationDialogue Location4", "line_index": 97, "text": "Schon wieder...!"}
{"category": "LocationDialogue Location4", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 105, "text": "Was tust du?!"}
{"category": "LocationDialogue Location4", "line_index": 106, "text": "Da drinnen ist…"}
{"category": "LocationDialogue Location4", "line_index": 107, "text": "Meine Unterwäsche!"}
{"category": "LocationDialogue Location4", "line_index": 108, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 109, "text": "Verheimlichst du mir etwas?"}
{"category": "LocationDialogue Location4", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 111, "text": "Warum glaubst du mir nur nicht?"}
{"category": "LocationDialogue Location4", "line_index": 112, "text": "Was mache ich denn falsch?"}
{"category": "LocationDialogue Location4", "line_index": 113, "text": "Ich möchte doch nur…"}
{"category": "LocationDialogue Location4", "line_index": 114, "text": "Ich möchte doch nur, dass du bei mir bleibst!"}
{"category": "LocationDialogue Location4", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 116, "text": "Das würde ich dir ja gerne versprechen, aber was wird danach geschehen?"}
{"category": "LocationDialogue Location4", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 118, "text": "Weshalb zieht dieser Schrank dich so in den Bann?"}
{"category": "LocationDialogue Location4", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 120, "text": "Ich möchte doch nur wissen, was das für Geräusche sind!"}
{"category": "LocationDialogue Location4", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 122, "text": "Lediglich"}
{"category": "LocationDialogue Location4", "line_index": 123, "text": "diese Welt…"}
{"category": "LocationDialogue Location4", "line_index": 124, "text": "Es sind nur diese vier Räume."}
{"category": "LocationDialogue Location4", "line_index": 125, "text": "Ist dir das denn nicht genug?"}
{"category": "LocationDialogue Location4", "line_index": 126, "text": "Warum versuchst du nicht einfach, bei mir zu bleiben?!"}
{"category": "LocationDialogue Location4", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 129, "text": "// Don't stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 130, "text": "Verstehe."}
{"category": "LocationDialogue Location4", "line_index": 131, "text": "Noch einmal…"}
{"category": "LocationDialogue Location4", "line_index": 132, "text": "Wenn du unbedingt wissen möchtest, was da drinnen ist,"}
{"category": "LocationDialogue Location4", "line_index": 133, "text": "so schaue nach"}
{"category": "LocationDialogue Location4", "line_index": 134, "text": "und finde es heraus!"}
{"category": "LocationDialogue Location4", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 139, "text": "Was zur...?"}
{"category": "LocationDialogue Location4", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 141, "text": "Das passiert manchmal."}
{"category": "LocationDialogue Location4", "line_index": 142, "text": "Der Raum hat nicht rechtzeitig geladen."}
{"category": "LocationDialogue Location4", "line_index": 143, "text": "Warte ein bisschen länger."}
{"category": "LocationDialogue Location4", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 145, "text": "Das ist ja seltsam..."}
{"category": "LocationDialogue Location4", "line_index": 146, "text": "Sind wir in jemandes Handy?"}
{"category": "LocationDialogue Location4", "line_index": 147, "text": "Und dieses Handy braucht so lange zum Laden?"}
{"category": "LocationDialogue Location4", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 149, "text": "Nein."}
{"category": "LocationDialogue Location4", "line_index": 150, "text": "Es ist nur so, dass nicht alles in dieser Welt"}
{"category": "LocationDialogue Location4", "line_index": 151, "text": "perfekt ist…"}
{"category": "LocationDialogue Location4", "line_index": 152, "text": "Außerdem werden wir"}
{"category": "LocationDialogue Location4", "line_index": 153, "text": "mithilfe des Kernstücks dieser Welt geladen."}
{"category": "LocationDialogue Location4", "line_index": 154, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 155, "text": "Kernstück?"}
{"category": "LocationDialogue Location4", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 157, "text": "Typisch, nicht?"}
{"category": "LocationDialogue Location4", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 159, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 161, "text": "...Wir können"}
{"category": "LocationDialogue Location4", "line_index": 162, "text": "auf der Konsole spielen."}
{"category": "LocationDialogue Location4", "line_index": 163, "text": "Oder wir spielen Karten -"}
{"category": "LocationDialogue Location4", "line_index": 164, "text": "deine Entscheidung!"}
{"category": "LocationDialogue Location4", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 167, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 168, "text": "// Mita play fight"}
{"category": "LocationDialogue Location4", "line_index": 169, "text": "Sollen wir kämpfen?"}
{"category": "LocationDialogue Location4", "line_index": 170, "text": "Du musst"}
{"category": "LocationDialogue Location4", "line_index": 171, "text": "vier Mal gewinnen."}
{"category": "LocationDialogue Location4", "line_index": 172, "text": "Lass uns anfangen."}
{"category": "LocationDialogue Location4", "line_index": 173, "text": "Ich schätze, ich werde dir erst einmal"}
{"category": "LocationDialogue Location4", "line_index": 174, "text": "nachgeben..."}
{"category": "LocationDialogue Location4", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 176, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 177, "text": "Guter Junge."}
{"category": "LocationDialogue Location4", "line_index": 178, "text": "Nun halt dich fest!"}
{"category": "LocationDialogue Location4", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 180, "text": "Wow!"}
{"category": "LocationDialogue Location4", "line_index": 181, "text": "Okay…"}
{"category": "LocationDialogue Location4", "line_index": 182, "text": "Jetzt mache ich Ernst!"}
{"category": "LocationDialogue Location4", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 184, "text": "Hah...!"}
{"category": "LocationDialogue Location4", "line_index": 185, "text": "Ob du es wohl schaffen wirst,"}
{"category": "LocationDialogue Location4", "line_index": 186, "text": "mich jetzt zu besiegen?"}
{"category": "LocationDialogue Location4", "line_index": 187, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 188, "text": "Du bist"}
{"category": "LocationDialogue Location4", "line_index": 189, "text": "einfach"}
{"category": "LocationDialogue Location4", "line_index": 190, "text": "unglaublich! Deine Finger sind echt was!"}
{"category": "LocationDialogue Location4", "line_index": 191, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 193, "text": "Was ist los?"}
{"category": "LocationDialogue Location4", "line_index": 194, "text": "So ist es nicht interessant..."}
{"category": "LocationDialogue Location4", "line_index": 195, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 196, "text": "Also..."}
{"category": "LocationDialogue Location4", "line_index": 197, "text": "Die Tat ist vollbracht! Fatality, wenn man so will!"}
{"category": "LocationDialogue Location4", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 199, "text": "Okay."}
{"category": "LocationDialogue Location4", "line_index": 200, "text": "Reiß dich zusammen, sonst bist du dein Leben lang ein Verlierer!"}
{"category": "LocationDialogue Location4", "line_index": 201, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 202, "text": "Was ist nur los mit dir?"}
{"category": "LocationDialogue Location4", "line_index": 203, "text": "Ich habe all die weiße Flüssigkeit aus dir herausgeschlagen!"}
{"category": "LocationDialogue Location4", "line_index": 204, "text": "Du hättest dich einfach mehr anstrengen sollen."}
{"category": "LocationDialogue Location4", "line_index": 205, "text": "Deswegen bin ich ja so gut!"}
{"category": "LocationDialogue Location4", "line_index": 206, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 208, "text": "Na dann!"}
{"category": "LocationDialogue Location4", "line_index": 209, "text": "Warum spielen wir nicht Karten?"}
{"category": "LocationDialogue Location4", "line_index": 210, "text": "In meinem Schlafzimmer."}
{"category": "LocationDialogue Location4", "line_index": 211, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 214, "text": "// Door > [ERROR]"}
{"category": "LocationDialogue Location4", "line_index": 215, "text": "Was ist das?"}
{"category": "LocationDialogue Location4", "line_index": 216, "text": "Wo ist..."}
{"category": "LocationDialogue Location4", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 218, "text": "Oh-oh."}
{"category": "LocationDialogue Location4", "line_index": 219, "text": "Tut mir leid!"}
{"category": "LocationDialogue Location4", "line_index": 220, "text": "Ich habe eine Datei"}
{"category": "LocationDialogue Location4", "line_index": 221, "text": "aus dem Internet heruntergeladen."}
{"category": "LocationDialogue Location4", "line_index": 222, "text": "Ich wollte, dass es hübsch ist,"}
{"category": "LocationDialogue Location4", "line_index": 223, "text": "draußen."}
{"category": "LocationDialogue Location4", "line_index": 224, "text": "Anscheinend"}
{"category": "LocationDialogue Location4", "line_index": 225, "text": "ist das Dateiformat jedoch falsch gewesen…"}
{"category": "LocationDialogue Location4", "line_index": 226, "text": "Ich bringe das später in Ordnung."}
{"category": "LocationDialogue Location4", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 228, "text": "Können wir das Haus etwa deswegen nicht verlassen?"}
{"category": "LocationDialogue Location4", "line_index": 229, "text": "Ja, genau deswegen."}
{"category": "LocationDialogue Location4", "line_index": 230, "text": "// Mita shy"}
{"category": "LocationDialogue Location4", "line_index": 231, "text": "Hey...?"}
{"category": "LocationDialogue Location4", "line_index": 232, "text": "Was ist los mit dir?"}
{"category": "LocationDialogue Location4", "line_index": 233, "text": "Brauchst du etwas?"}
{"category": "LocationDialogue Location4", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 236, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 237, "text": "// Wall Clock"}
{"category": "LocationDialogue Location4", "line_index": 238, "text": "Diese Uhr…"}
{"category": "LocationDialogue Location4", "line_index": 239, "text": "Welche Zeit gibt sie an?"}
{"category": "LocationDialogue Location4", "line_index": 240, "text": "In-game Zeit?"}
{"category": "LocationDialogue Location4", "line_index": 241, "text": "Oder wird sie mit der von meinem Handy synchronisiert?"}
{"category": "LocationDialogue Location4", "line_index": 242, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 243, "text": "Naja, äh…"}
{"category": "LocationDialogue Location4", "line_index": 244, "text": "Ich weiß es nicht."}
{"category": "LocationDialogue Location4", "line_index": 245, "text": "Egal wie viel Uhr es ist"}
{"category": "LocationDialogue Location4", "line_index": 246, "text": "oder ob es spät ist,"}
{"category": "LocationDialogue Location4", "line_index": 247, "text": "bei mir zu Hause…"}
{"category": "LocationDialogue Location4", "line_index": 248, "text": "Starke Mädchen wie ich"}
{"category": "LocationDialogue Location4", "line_index": 249, "text": "werden nie müde!"}
{"category": "LocationDialogue Location4", "line_index": 250, "text": "Wenn ich wollte, kann es auf ewig Frühling sein."}
{"category": "LocationDialogue Location4", "line_index": 251, "text": "Und auf ewig Mittag."}
{"category": "LocationDialogue Location4", "line_index": 252, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 253, "text": "Kurios…"}
{"category": "LocationDialogue Location4", "line_index": 254, "text": "Und schaurig zugleich -"}
{"category": "LocationDialogue Location4", "line_index": 255, "text": "für immer in einem bestimmten Moment festzustecken…"}
{"category": "LocationDialogue Location4", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 258, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 259, "text": "// Photos of Mita"}
{"category": "LocationDialogue Location4", "line_index": 260, "text": "Schöne Bilder."}
{"category": "LocationDialogue Location4", "line_index": 261, "text": "Ich vermute mal, das bist du auf den Fotos?"}
{"category": "LocationDialogue Location4", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 263, "text": "Jap."}
{"category": "LocationDialogue Location4", "line_index": 264, "text": "Ich mag sie auch sehr."}
{"category": "LocationDialogue Location4", "line_index": 265, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 266, "text": "Wer hat sie denn geschossen?"}
{"category": "LocationDialogue Location4", "line_index": 267, "text": "Gibt es sonst noch jemanden in dieser Welt?"}
{"category": "LocationDialogue Location4", "line_index": 268, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 269, "text": "Das könnte man durchaus so sagen..."}
{"category": "LocationDialogue Location4", "line_index": 270, "text": "Und ich werde dich ihnen vorstellen."}
{"category": "LocationDialogue Location4", "line_index": 271, "text": "Allerdings ist es noch nicht an der Zeit,"}
{"category": "LocationDialogue Location4", "line_index": 272, "text": "solch eine wohlige Gesellschaft zu teilen."}
{"category": "LocationDialogue Location4", "line_index": 273, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 275, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 276, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 277, "text": "// Portal"}
{"category": "LocationDialogue Location4", "line_index": 278, "text": "Was ist mit dem Portal geschehen?"}
{"category": "LocationDialogue Location4", "line_index": 279, "text": "...Oder wie auch immer man es nennt?"}
{"category": "LocationDialogue Location4", "line_index": 280, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 281, "text": "Mithilfe meines"}
{"category": "LocationDialogue Location4", "line_index": 282, "text": "magischen Fingerschnipsens"}
{"category": "LocationDialogue Location4", "line_index": 283, "text": "habe ich es"}
{"category": "LocationDialogue Location4", "line_index": 284, "text": "an einen anderen Ort versetzt."}
{"category": "LocationDialogue Location4", "line_index": 285, "text": "Jedoch brauchen wir dieses Portal nicht mehr."}
{"category": "LocationDialogue Location4", "line_index": 286, "text": "Es würde nur im Weg sein."}
{"category": "LocationDialogue Location4", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 288, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 289, "text": "// Mirror in the bedroom"}
{"category": "LocationDialogue Location4", "line_index": 290, "text": "Es ist so seltsam, in einen Spiegel zu schauen,"}
{"category": "LocationDialogue Location4", "line_index": 291, "text": "der nichts reflektiert..."}
{"category": "LocationDialogue Location4", "line_index": 292, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 293, "text": "Reflexionen können eingeschaltet werden,"}
{"category": "LocationDialogue Location4", "line_index": 294, "text": "wenn du das möchtest,"}
{"category": "LocationDialogue Location4", "line_index": 295, "text": "aber brauchst du sie denn?"}
{"category": "LocationDialogue Location4", "line_index": 296, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 297, "text": "Na klar."}
{"category": "LocationDialogue Location4", "line_index": 298, "text": "Oder… gibt es Konsequenzen?"}
{"category": "LocationDialogue Location4", "line_index": 299, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 300, "text": "Ja."}
{"category": "LocationDialogue Location4", "line_index": 301, "text": "Wir werden uns furchtbar langsam und ruckartig bewegen..."}
{"category": "LocationDialogue Location4", "line_index": 302, "text": "Hast du jemals einen Zeichentrickfilm mit einer niedrigen Bildrate gesehen?"}
{"category": "LocationDialogue Location4", "line_index": 303, "text": "So wäre es also die ganze Zeit."}
{"category": "LocationDialogue Location4", "line_index": 304, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 305, "text": "Achso..."}
{"category": "LocationDialogue Location4", "line_index": 306, "text": "Dann werden wir fürs Erste wohl auch ohne Reflexionen auskommen."}
{"category": "LocationDialogue Location4", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 308, "text": "[player], ich schätze,"}
{"category": "LocationDialogue Location4", "line_index": 309, "text": "du magst es, in den Spiegel zu blicken?"}
{"category": "LocationDialogue Location4", "line_index": 310, "text": "Hast du etwa Angst davor, ein Fünkchen Optimismus in deinem Gesicht zu sehen?"}
{"category": "LocationDialogue Location4", "line_index": 311, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 312, "text": "Was? Nein, ich habe keine Angst davor."}
{"category": "LocationDialogue Location4", "line_index": 313, "text": "Ich bin halt nur müde"}
{"category": "LocationDialogue Location4", "line_index": 314, "text": "wegen der Arbeit."}
{"category": "LocationDialogue Location4", "line_index": 315, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 316, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 317, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 318, "text": "// Blue sneakers"}
{"category": "LocationDialogue Location4", "line_index": 319, "text": "Sind das deine?"}
{"category": "LocationDialogue Location4", "line_index": 320, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 321, "text": "Nein, das sind deine."}
{"category": "LocationDialogue Location4", "line_index": 322, "text": "Erinnerst du dich nicht?"}
{"category": "LocationDialogue Location4", "line_index": 323, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 324, "text": "Ich habe keine solchen Turnschuhe..."}
{"category": "LocationDialogue Location4", "line_index": 325, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 326, "text": "Jetzt hast du welche."}
{"category": "LocationDialogue Location4", "line_index": 327, "text": "Wenn wir hinausgehen,"}
{"category": "LocationDialogue Location4", "line_index": 328, "text": "kannst du sie tragen."}
{"category": "LocationDialogue Location4", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 330, "text": "Was ist mit Kleidung?"}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "Ich fand mich hier wieder"}
{"category": "LocationDialogue Location4", "line_index": 332, "text": "mit nur dem, was ich im Moment trage."}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "Wie komme ich an weitere Klamotten?"}
{"category": "LocationDialogue Location4", "line_index": 334, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 335, "text": "Das ist keine große Sache."}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "Ich habe gesehen, was du so trägst;"}
{"category": "LocationDialogue Location4", "line_index": 337, "text": "was für einen trostlosen Geschmack du in Sachen Kleidung hast..."}
{"category": "LocationDialogue Location4", "line_index": 338, "text": "Aber gut, ich werde dir etwas besorgen."}
{"category": "LocationDialogue Location4", "line_index": 339, "text": "Allerdings erst später..."}
{"category": "LocationDialogue Location4", "line_index": 340, "text": "Versprochen."}
{"category": "LocationDialogue Location4", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 342, "text": "Okay."}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Games on TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "Was sollen wir spielen?"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "In diesem Spiel wird gekämpft,"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "um zu gucken, wer saurer ist…"}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "Welch ein Konzept!"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": "Genug Milch für heute; lass uns etwas anderes machen."}
{"category": "LocationDialogue Location4", "line_index": 352, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "In diesem Spiel musst du einfach nur ein Pinguin sein"}
{"category": "LocationDialogue Location4", "line_index": 354, "text": "und schlittern."}
{"category": "LocationDialogue Location4", "line_index": 355, "text": "Okay, mit diesem Spiel sind wir durch."}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "Oh, was?"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "Meinst du das ernst? Ich dachte, du würdest..."}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "Ich bin ja so aufgeregt!"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "Und doch bin ich etwas verwirrt…"}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "Wenn das so ist…"}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "Bitte bleibe an meiner Seite,"}
{"category": "LocationDialogue Location4", "line_index": 364, "text": "für immer."}
{"category": "LocationDialogue Location4", "line_index": 365, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 367, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 368, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 369, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 370, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 372, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 373, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 374, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 375, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 376, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 377, "text": "// A game about penguins"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "Es ist so einfach, wie es aussieht."}
{"category": "LocationDialogue Location4", "line_index": 379, "text": "Sammle Schneebälle!"}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "Natürlich gewinnt derjenige, der am meisten von ihnen gesammelt hat."}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "Na los, spielen wir zwei Runden!"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// The first map"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "Wow, was wirst du mit so vielen bloß anstellen?"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "Ups! Ich habe mehr Schneebälle."}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "Hol auf!"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "Ha, 1 zu 1!"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// The second map"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "Du bist ein geborener Pinguin!"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "Wie wäre es, ließen wir dich echt einmal aufs Eis?"}
{"category": "LocationDialogue Location4", "line_index": 390, "text": "Pff, du bist zu langsam."}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "Hast du das Gewicht von der letzten Runde nicht abgeladen?"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "Ugh, es ist recht selten, dass so etwas geschieht..."}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// The game is over"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "Also, spielen wir noch ein weiteres Spiel?"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "Oder belassen wir es dabei?"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "Wozu brauchst du dieses Ding?"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "Bist du etwa süchtig?"}
