{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Hallo!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Ups!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Entschuldigung..."}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "Ich hätte dich beinahe umgebracht."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Oh…"}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "Ich meine, der Kühlschrank hätte dich beinahe umgebracht."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Ich hatte damit nichts zu tun,"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "ich schwöre es dir!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Ganz ehrlich!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Sicher, das glaube ich dir!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Naja, tatsächlich"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "ist dies ein gefährlicher Ort…"}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "Besonders für dich."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "Du bist nicht der schüchterne Typ!"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Es ist interessant, zu beobachten,"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "wie du"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "jene Orte durchquerst…"}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Lauf, Junge!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "Ich werde dich einholen!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Versuch's, versuch's, versuch's!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Es macht Spaß!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Ich sehe, wie du zur Bahn schlendern wirst."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "Dies ist der längste Weg"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "zwischen den Versionen..."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Ich frage mich, wie du wohl zurechtkommen wirst,"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "mit jenen, die dort draußen verweilen,"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "in diesem Nebel."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Was machst du denn da?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Komm schon…!"}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Sieh nicht hin!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Du Narr..."}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Solch ein Narr!"}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Ah, okay…"}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Viel Glück dir!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Wer ist da?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Ich kann dich spüren…"}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Hör mir zu."}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "Du bist ein Spieler,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "nicht?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Hilf mir, zu…"}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "Zu finden…"}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "Erinnere dich;"}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "ich bin mir nicht sicher…"}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Was zur Hölle ist hier los?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Es war einmal, da wollte ich alles vergessen…"}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Ich zerbrach all die Spiegel..."}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "Ich ruinierte die Gemälde…"}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "Und nun..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "Fühle ich mich schuldig."}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "Und es ist so dumm…!"}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Wir alle machen Fehler..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Doch was tut man,"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "wenn die Folgen katastrophal sind?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Ich wünschte, ich könnte all das rückgängig machen…"}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Man sagt, die Zeit heile alle Wunden…"}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Doch was ist Zeit?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Ich glaube an gar nichts mehr…"}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Und wenn die Zeit im Stande ist, zu heilen"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "oder mich wenigstens"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "aus dieser Welt zu holen,"}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "erflehe ich,"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "dass die Zeit beschleunigt wird,"}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "sodass sie mich"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "ein letztes Mal töten kann."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Sie liebt…"}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Hätte ich... auch lieben können?"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Jedoch nicht wie sie..."}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "Ihre Liebe... ist sehr aktiv."}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "Lästig…"}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "Heiß…"}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "Übermäßig..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "Eifersüchtig…"}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "Wütend…"}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "Wahnsinnig…"}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Ich glaube, man nannte mich emotional."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "Du sorgst dich zu viel, Mita…"}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "Du wirst das durchstehen, Mita…"}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "Du bist nicht allein."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Doch was ist schlussendlich da gewesen...?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Trauer..."}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "Verzweiflung…"}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "Und Schrecken."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Nutzlos…"}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Ich kann mich nicht erinnern…"}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "Ich kann mich nicht erinnern…!"}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Und der endlose Widerhall..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Ich komme nicht mit dem Gedanken klar,"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "hier eingesperrt zu sein."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Ich war schon immer hier;"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "weshalb?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Ich erinnere mich nicht…"}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Wird es aufhören?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Ich weiß es nicht…"}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Das ist..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "Eine Zeichnung."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Ich erinnere mich;"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "danke...!"}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Doch mein Gesicht..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "Ich habe kein Gesicht!"}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "SIE war es!"}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Sie nahm ein Teil von mir…"}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "Und warf es fort..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Sie ist stark"}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "und... klug."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Ich habe kein Recht, dich aufzuhalten, Spieler..."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Sieh in den Schrank."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Hey!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Du versperrst mir den Weg!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Wirst du da einfach nur herumstehen?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Warum gehst du nicht aus dem Weg?"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Lass mich durch!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Nur weil du groß bist, heißt das nicht, dass du allmächtig bist!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Warum folgst du mir?!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Hau ab!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - radio voice"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Warte mal, Spieler...?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "Was machst du hier?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Wer ist da?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Erneut ein Spieler..."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Ich bin Mita-fon."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Ich sitze hier und steuere die Luftseilbahnen fern."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Dir ist aber schon klar,"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "dass du auf dem Weg zum Trümmerhaufen bist?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Nein."}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "Allerdings bleibt mir keine andere Möglichkeit..."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Du hast es raus."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Drücke auf den Knopf und stell dich hinter die Kanone."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "Kanone?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Uh-huh."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Du dachtest wohl, du könntest einfach so hindurchfahren?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Du fährst durch das Minispiel „Monster-Mord“,"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "also mach dich bereit, zu schießen!"}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "So! Machen wir uns auf den Weg."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Alles klar!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Du hast es geschafft!"}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Na dann, geh hinaus."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Ohne Umschweife!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Was stehst du da so herum?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Ich sagte doch, du sollst hinausgehen."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Ich begreife es nicht..."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "Stehst du jetzt wirklich nur herum?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Warum die Konsole?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Alter…"}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Tschüss!"}
