{"category": "LocationDialogue Location20", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Mila, nein! ...Du bist krank!"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Hahaha! WAS SEHE ICH DENN DA?"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "Etwa einen neuen Gesichtsausdruck?"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "Na los, mehr, mehr! AHAHAHA!"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "Es langweilt mich, nur zuzusehen!"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\""}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "Wie geht's denn so, mein Rastloser?"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "Lässt dich all das Umhergewandere nicht ermüden?"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Was hast du Mila angetan?!"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "Du bist wohl doch nicht müde..."}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Lass uns erneut zusammen spielen!"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "Du…!"}
{"category": "LocationDialogue Location20", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "Beginnen wir mit einem kurzen Test!"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "Testen wir deine Koordination!"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "Testen wir dein Verhalten!"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "Was ist, wenn mit dir etwas nicht stimmt?"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "Was ist, wenn du jene HAUT, mit der du so prahlst..."}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "Überhaupt nicht verdienst?"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "Hier ein Vorgeschmack:"}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "Welches davon nimmst du?"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "Das rechte"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "oder"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "das linke?"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "Dein Ernst?"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "Was ist nur der Unterschied?"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "Das war doch lediglich ein Witz!"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "Macht nichts! Stechereien gehören der Vergangenheit an."}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "Wie auch immer..."}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "Mir kommt da eine bessere Idee!"}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "Und für den Anfang..."}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "Sieh mal, was ich habe!"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Wir benötigen etwas Musik!"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "Was hältst du von der Melodie?"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "Sie macht mich ganz nervös!"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "Ich fange an..."}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "Mit den Regeln."}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rules"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "Während diese Melodie erklingt,"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "darfst du dich bewegen."}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "Ertönt keine Melodie,"}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "so bewege dich nicht!"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "Oder du wirst sterben..."}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "Schau, du musst bis zum Ende gelangen."}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "Du schaffst das schon;"}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "lass uns weiterspielen!"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "Was stehst du da so herum?"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Lauf, Kind, lauf!"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "Oh!"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Wie gehorsam du doch bist!"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Ein perfektes Musterexemplar!"}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Ich will dich ganz für mich allein!"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "Aber findest du nicht auch, dass dies zu einfach war?"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "Lass mich gehen!"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "Ruhe dich nicht auf deinen Lorbeeren aus!"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "Uns stehen einige Spiele bevor!"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "Nun denn!"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Ich werde jetzt meine Augen schließen"}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "und sobald ich sie öffne,"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "verschwindest du aus meinem Sichtfeld."}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "Verstanden?"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "Erspähe ich dich, wirst du bestraft!"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Alles klar? Nun lass uns beginnen!"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "Es bringt nichts…!"}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "Geschafft!"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Du machst das klasse! Wie aufregend!"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "Nun wird es schwieriger."}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "Viel schwieriger..."}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Versteck dich! Lauf! Und dann eine Umdrehung!"}
{"category": "LocationDialogue Location20", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "Du kannst mich mal!"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Player falls"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "Sieht aus, als wäre ich entkommen…"}
