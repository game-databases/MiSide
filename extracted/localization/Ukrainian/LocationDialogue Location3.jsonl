{"category": "LocationDialogue Location3", "line_index": 0, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 1, "text": "Привіт, [player]!"}
{"category": "LocationDialogue Location3", "line_index": 2, "text": "Ось ми й зустрілися!"}
{"category": "LocationDialogue Location3", "line_index": 3, "text": "Я така рада!"}
{"category": "LocationDialogue Location3", "line_index": 4, "text": "Знаю, у тебе є питання."}
{"category": "LocationDialogue Location3", "line_index": 5, "text": "Ну, як бачиш..."}
{"category": "LocationDialogue Location3", "line_index": 6, "text": "Я зробила цей особливий пристрій,"}
{"category": "LocationDialogue Location3", "line_index": 7, "text": "Щоб ти скоріше потрапив сюди, до мене."}
{"category": "LocationDialogue Location3", "line_index": 8, "text": "Але чомусь ти опинився в іншій версії гри,"}
{"category": "LocationDialogue Location3", "line_index": 9, "text": "У якій я..."}
{"category": "LocationDialogue Location3", "line_index": 10, "text": "Ой, довго розповідати!"}
{"category": "LocationDialogue Location3", "line_index": 11, "text": "Загалом, приємно тебе бачити!"}
{"category": "LocationDialogue Location3", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 13, "text": "// Answer 1 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 14, "text": "Ну я!"}
{"category": "LocationDialogue Location3", "line_index": 15, "text": "А ти [player]?"}
{"category": "LocationDialogue Location3", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 17, "text": "// Answer 2 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 18, "text": "Ти вже хочеш назад?"}
{"category": "LocationDialogue Location3", "line_index": 19, "text": "Ну... Думаю, це можна влаштувати. Але як же я?"}
{"category": "LocationDialogue Location3", "line_index": 20, "text": "Давай побудемо разом..."}
{"category": "LocationDialogue Location3", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 22, "text": "// Answer 3 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 23, "text": "Зараз я тобі розповім..."}
{"category": "LocationDialogue Location3", "line_index": 24, "text": "І ось ти тут!"}
{"category": "LocationDialogue Location3", "line_index": 25, "text": "Зрозумів?"}
{"category": "LocationDialogue Location3", "line_index": 26, "text": "Я не зрозумів. // Player"}
{"category": "LocationDialogue Location3", "line_index": 27, "text": "Ну-у, нічого страшного. // Mita"}
{"category": "LocationDialogue Location3", "line_index": 28, "text": "Головне, ми тепер разом."}
{"category": "LocationDialogue Location3", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 30, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 31, "text": "Ти голодний?"}
{"category": "LocationDialogue Location3", "line_index": 32, "text": "Давай разом займемося готуванням?"}
{"category": "LocationDialogue Location3", "line_index": 33, "text": "Ось."}
{"category": "LocationDialogue Location3", "line_index": 34, "text": "Допоможи мені з морквою."}
{"category": "LocationDialogue Location3", "line_index": 35, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 36, "text": "А звідки тут овочі?"}
{"category": "LocationDialogue Location3", "line_index": 37, "text": "Щойно тут нічого не було!"}
{"category": "LocationDialogue Location3", "line_index": 38, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 39, "text": "[player], ну ми ж у грі."}
{"category": "LocationDialogue Location3", "line_index": 40, "text": "Давай, до-по-ма-гай!"}
{"category": "LocationDialogue Location3", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 42, "text": "Дякую!"}
{"category": "LocationDialogue Location3", "line_index": 43, "text": "А ти можеш принести ножиці?"}
{"category": "LocationDialogue Location3", "line_index": 44, "text": "Вони у ванній кімнаті."}
{"category": "LocationDialogue Location3", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 46, "text": "Спочатку присядь."}
{"category": "LocationDialogue Location3", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 48, "text": "// Kitchen"}
{"category": "LocationDialogue Location3", "line_index": 49, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 50, "text": "Будеш соус?"}
{"category": "LocationDialogue Location3", "line_index": 51, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 52, "text": "Ем-м... Ні."}
{"category": "LocationDialogue Location3", "line_index": 53, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 54, "text": "А шкода."}
{"category": "LocationDialogue Location3", "line_index": 55, "text": "З ним їжа ще смачніша!"}
{"category": "LocationDialogue Location3", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 57, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 58, "text": "Дякую."}
{"category": "LocationDialogue Location3", "line_index": 59, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 60, "text": "Ти вже все з'їв?"}
{"category": "LocationDialogue Location3", "line_index": 61, "text": "А моя порція здається"}
{"category": "LocationDialogue Location3", "line_index": 62, "text": "Нескінченною."}
{"category": "LocationDialogue Location3", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 64, "text": "// Help"}
{"category": "LocationDialogue Location3", "line_index": 65, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 66, "text": "Що сталося?"}
{"category": "LocationDialogue Location3", "line_index": 67, "text": "Скажи що бачиш і відчуваєш."}
{"category": "LocationDialogue Location3", "line_index": 68, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 69, "text": "Серце колить,"}
{"category": "LocationDialogue Location3", "line_index": 70, "text": "В очах шумить."}
{"category": "LocationDialogue Location3", "line_index": 71, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 72, "text": "Так!"}
{"category": "LocationDialogue Location3", "line_index": 73, "text": "Я знаю, що з тобою."}
{"category": "LocationDialogue Location3", "line_index": 74, "text": "Можеш встати?"}
{"category": "LocationDialogue Location3", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 76, "text": "// Bathroom"}
{"category": "LocationDialogue Location3", "line_index": 77, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 78, "text": "Що це?"}
{"category": "LocationDialogue Location3", "line_index": 79, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 80, "text": "Таблетки."}
{"category": "LocationDialogue Location3", "line_index": 81, "text": "Тобі стане краще майже відразу."}
{"category": "LocationDialogue Location3", "line_index": 82, "text": "Вставай перед дзеркалом..."}
{"category": "LocationDialogue Location3", "line_index": 83, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 84, "text": "Приймай."}
{"category": "LocationDialogue Location3", "line_index": 85, "text": "Я чекаю."}
{"category": "LocationDialogue Location3", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 87, "text": "// Black room"}
{"category": "LocationDialogue Location3", "line_index": 88, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 89, "text": "Ну як?"}
{"category": "LocationDialogue Location3", "line_index": 90, "text": "Стає краще?"}
{"category": "LocationDialogue Location3", "line_index": 91, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 92, "text": "Так."}
{"category": "LocationDialogue Location3", "line_index": 93, "text": "Але як так швидко?"}
{"category": "LocationDialogue Location3", "line_index": 94, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 95, "text": "[player], ми в грі."}
{"category": "LocationDialogue Location3", "line_index": 96, "text": "І тут все набагато простіше."}
{"category": "LocationDialogue Location3", "line_index": 97, "text": "Ти докладаєш найменших зусиль,"}
{"category": "LocationDialogue Location3", "line_index": 98, "text": "Однак результат зазвичай набагато об'ємніший."}
{"category": "LocationDialogue Location3", "line_index": 99, "text": "Це ігрова умова:"}
{"category": "LocationDialogue Location3", "line_index": 100, "text": "Спрощеність."}
{"category": "LocationDialogue Location3", "line_index": 101, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 102, "text": "Наприклад?"}
{"category": "LocationDialogue Location3", "line_index": 103, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 104, "text": "Морква:"}
{"category": "LocationDialogue Location3", "line_index": 105, "text": "Ти різав одну,"}
{"category": "LocationDialogue Location3", "line_index": 106, "text": "А будуть готові відразу три."}
{"category": "LocationDialogue Location3", "line_index": 107, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 108, "text": "Слухай, це все так раптово,"}
{"category": "LocationDialogue Location3", "line_index": 109, "text": "І мене дуже лякає ця ситуація..."}
{"category": "LocationDialogue Location3", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 111, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 112, "text": "Щось не так?"}
{"category": "LocationDialogue Location3", "line_index": 113, "text": "// player"}
{"category": "LocationDialogue Location3", "line_index": 114, "text": "Я знайшов якісь картриджі у вентиляції."}
{"category": "LocationDialogue Location3", "line_index": 115, "text": "На них були наклейки з іменами."}
{"category": "LocationDialogue Location3", "line_index": 116, "text": "Що це?"}
{"category": "LocationDialogue Location3", "line_index": 117, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 118, "text": "Картриджі?"}
{"category": "LocationDialogue Location3", "line_index": 119, "text": "Які?"}
{"category": "LocationDialogue Location3", "line_index": 120, "text": "Давай дізнаємося це разом,"}
{"category": "LocationDialogue Location3", "line_index": 121, "text": "Але трохи пізніше."}
{"category": "LocationDialogue Location3", "line_index": 122, "text": "Спочатку поїмо."}
{"category": "LocationDialogue Location3", "line_index": 123, "text": "Передай ножиці, будь ласка."}
{"category": "LocationDialogue Location3", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 125, "text": "// Addon ==========================="}
{"category": "LocationDialogue Location3", "line_index": 126, "text": "Кільце?"}
{"category": "LocationDialogue Location3", "line_index": 127, "text": "// Player - зеркало"}
{"category": "LocationDialogue Location3", "line_index": 128, "text": "А чому дзеркало без віддзеркалення?"}
{"category": "LocationDialogue Location3", "line_index": 129, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 130, "text": "Ах, точно,"}
{"category": "LocationDialogue Location3", "line_index": 131, "text": "Я забула ввімкнути..."}
{"category": "LocationDialogue Location3", "line_index": 132, "text": "Ну ось,"}
{"category": "LocationDialogue Location3", "line_index": 133, "text": "Тепер віддзеркалення є!"}
{"category": "LocationDialogue Location3", "line_index": 134, "text": "До речі,"}
{"category": "LocationDialogue Location3", "line_index": 135, "text": "Раніше я взагалі не знала що таке віддзеркалення."}
{"category": "LocationDialogue Location3", "line_index": 136, "text": "У нашому світі його не було"}
{"category": "LocationDialogue Location3", "line_index": 137, "text": "До якогось оновлення."}
{"category": "LocationDialogue Location3", "line_index": 138, "text": "Невже у вашому світі так багато"}
{"category": "LocationDialogue Location3", "line_index": 139, "text": "Віддзеркалень?"}
{"category": "LocationDialogue Location3", "line_index": 140, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 141, "text": "Ну-у, так."}
{"category": "LocationDialogue Location3", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 143, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 144, "text": "Пам'ятаєш,"}
{"category": "LocationDialogue Location3", "line_index": 145, "text": "Ти приніс три речі"}
{"category": "LocationDialogue Location3", "line_index": 146, "text": "На цей сканер?"}
{"category": "LocationDialogue Location3", "line_index": 147, "text": "Так от..."}
{"category": "LocationDialogue Location3", "line_index": 148, "text": "Ці речі"}
{"category": "LocationDialogue Location3", "line_index": 149, "text": "Пов'язані з цією версією світу."}
{"category": "LocationDialogue Location3", "line_index": 150, "text": "Ось тому ти тепер тут."}
{"category": "LocationDialogue Location3", "line_index": 151, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 152, "text": "// Player - мобильный телевизор"}
{"category": "LocationDialogue Location3", "line_index": 153, "text": "Це ж той телевізор,"}
{"category": "LocationDialogue Location3", "line_index": 154, "text": "Який я купив."}
{"category": "LocationDialogue Location3", "line_index": 155, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 156, "text": "Ага."}
{"category": "LocationDialogue Location3", "line_index": 157, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 158, "text": "Ти сказала,"}
{"category": "LocationDialogue Location3", "line_index": 159, "text": "Що він зламався."}
{"category": "LocationDialogue Location3", "line_index": 160, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 161, "text": "Ну, я хотіла зробити тобі"}
{"category": "LocationDialogue Location3", "line_index": 162, "text": "Сюрприз!"}
{"category": "LocationDialogue Location3", "line_index": 163, "text": "Щоб ти потрапив сюди."}
{"category": "LocationDialogue Location3", "line_index": 164, "text": "Тому я трошки приховала правду."}
{"category": "LocationDialogue Location3", "line_index": 165, "text": "Тепер екранчик показує інформацію."}
{"category": "LocationDialogue Location3", "line_index": 166, "text": "І, до речі, так,"}
{"category": "LocationDialogue Location3", "line_index": 167, "text": "Я трохи інженер!"}
{"category": "LocationDialogue Location3", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 169, "text": "// Player - школьная одежда"}
{"category": "LocationDialogue Location3", "line_index": 170, "text": "Це що,"}
{"category": "LocationDialogue Location3", "line_index": 171, "text": "Шкільна форма?"}
{"category": "LocationDialogue Location3", "line_index": 172, "text": "Навіщо вона тобі?"}
{"category": "LocationDialogue Location3", "line_index": 173, "text": "Хіба ти можеш ходити до школи?"}
{"category": "LocationDialogue Location3", "line_index": 174, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 175, "text": "До школи?"}
{"category": "LocationDialogue Location3", "line_index": 176, "text": "Ні, мені це не потрібно."}
{"category": "LocationDialogue Location3", "line_index": 177, "text": "Але форма миленька,"}
{"category": "LocationDialogue Location3", "line_index": 178, "text": "І вона дозволить мені"}
{"category": "LocationDialogue Location3", "line_index": 179, "text": "Виглядати миленько!"}
{"category": "LocationDialogue Location3", "line_index": 180, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 181, "text": "// Player - компьютер"}
{"category": "LocationDialogue Location3", "line_index": 182, "text": "А цей комп'ютер працює?"}
{"category": "LocationDialogue Location3", "line_index": 183, "text": "Чи він декоративний?"}
{"category": "LocationDialogue Location3", "line_index": 184, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 185, "text": "Звичайно працює."}
{"category": "LocationDialogue Location3", "line_index": 186, "text": "Усе, що тут є"}
{"category": "LocationDialogue Location3", "line_index": 187, "text": "Працює як у твоєму світі."}
{"category": "LocationDialogue Location3", "line_index": 188, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 189, "text": "У своєму світі"}
{"category": "LocationDialogue Location3", "line_index": 190, "text": "Я часто сиджу за комп'ютером..."}
{"category": "LocationDialogue Location3", "line_index": 191, "text": "Працюю."}
{"category": "LocationDialogue Location3", "line_index": 192, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 193, "text": "Я знаю."}
{"category": "LocationDialogue Location3", "line_index": 194, "text": "І через цю роботу"}
{"category": "LocationDialogue Location3", "line_index": 195, "text": "Ти так мало звертав"}
{"category": "LocationDialogue Location3", "line_index": 196, "text": "На мене уваги."}
{"category": "LocationDialogue Location3", "line_index": 197, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 198, "text": "Ну, на щось жити потрібно."}
{"category": "LocationDialogue Location3", "line_index": 199, "text": "А звідки ти знаєш?"}
{"category": "LocationDialogue Location3", "line_index": 200, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 201, "text": "Камера телефону іноді вмикалася..."}
{"category": "LocationDialogue Location3", "line_index": 202, "text": "Пробач,"}
{"category": "LocationDialogue Location3", "line_index": 203, "text": "Але я спостерігала..."}
{"category": "LocationDialogue Location3", "line_index": 204, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 205, "text": "Знаєш, це трохи неправильно..."}
{"category": "LocationDialogue Location3", "line_index": 206, "text": "Ну, гаразд."}
{"category": "LocationDialogue Location3", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 208, "text": "// Player - зонтик"}
{"category": "LocationDialogue Location3", "line_index": 209, "text": "Скільки б я не грав,"}
{"category": "LocationDialogue Location3", "line_index": 210, "text": "Дощу не було жодного разу."}
{"category": "LocationDialogue Location3", "line_index": 211, "text": "Навіщо тоді парасолька?"}
{"category": "LocationDialogue Location3", "line_index": 212, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 213, "text": "Дощ дуже рідкісний —"}
{"category": "LocationDialogue Location3", "line_index": 214, "text": "Ти його ще не застав."}
{"category": "LocationDialogue Location3", "line_index": 215, "text": "Можливо, одного разу застанеш,"}
{"category": "LocationDialogue Location3", "line_index": 216, "text": "І парасолька тобі знадобиться."}
{"category": "LocationDialogue Location3", "line_index": 217, "text": "Потім дізнаємося."}
{"category": "LocationDialogue Location3", "line_index": 218, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 219, "text": "// Player - Электрощиток"}
{"category": "LocationDialogue Location3", "line_index": 220, "text": "А чому електрощиток тут?"}
{"category": "LocationDialogue Location3", "line_index": 221, "text": "І якщо ми в грі,"}
{"category": "LocationDialogue Location3", "line_index": 222, "text": "То навіщо він?"}
{"category": "LocationDialogue Location3", "line_index": 223, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 224, "text": "По-перше,"}
{"category": "LocationDialogue Location3", "line_index": 225, "text": "Ми в грі,"}
{"category": "LocationDialogue Location3", "line_index": 226, "text": "Тому безглуздо запитувати"}
{"category": "LocationDialogue Location3", "line_index": 227, "text": "\"Навіщо\"."}
{"category": "LocationDialogue Location3", "line_index": 228, "text": "Але він і справді"}
{"category": "LocationDialogue Location3", "line_index": 229, "text": "Перезапускає електрику."}
{"category": "LocationDialogue Location3", "line_index": 230, "text": "Все зроблено за подобою"}
{"category": "LocationDialogue Location3", "line_index": 231, "text": "Твого світу."}
{"category": "LocationDialogue Location3", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 233, "text": "// Player - дверь на выход"}
{"category": "LocationDialogue Location3", "line_index": 234, "text": "Ми можемо вийти?"}
{"category": "LocationDialogue Location3", "line_index": 235, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 236, "text": "Ой..."}
{"category": "LocationDialogue Location3", "line_index": 237, "text": "Поки що ні."}
{"category": "LocationDialogue Location3", "line_index": 238, "text": "Давай пізніше."}
{"category": "LocationDialogue Location3", "line_index": 239, "text": "Спочатку побудемо тут,"}
{"category": "LocationDialogue Location3", "line_index": 240, "text": "Вдома."}
{"category": "LocationDialogue Location3", "line_index": 241, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 242, "text": "// Player - книги"}
{"category": "LocationDialogue Location3", "line_index": 243, "text": "Тут стільки книг."}
{"category": "LocationDialogue Location3", "line_index": 244, "text": "Ти їх читаєш?"}
{"category": "LocationDialogue Location3", "line_index": 245, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 246, "text": "Я вже все прочитала."}
{"category": "LocationDialogue Location3", "line_index": 247, "text": "Коли я тут одна,"}
{"category": "LocationDialogue Location3", "line_index": 248, "text": "Мені ду-уже нудно."}
{"category": "LocationDialogue Location3", "line_index": 249, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 250, "text": "// Player - телевизор на кухне"}
{"category": "LocationDialogue Location3", "line_index": 251, "text": "Навіщо тобі другий телевізор,"}
{"category": "LocationDialogue Location3", "line_index": 252, "text": "Та ще й старий?"}
{"category": "LocationDialogue Location3", "line_index": 253, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 254, "text": "Тобі він не подобається?"}
{"category": "LocationDialogue Location3", "line_index": 255, "text": "Можу прибрати."}
{"category": "LocationDialogue Location3", "line_index": 256, "text": "А так..."}
{"category": "LocationDialogue Location3", "line_index": 257, "text": "Він для краси:"}
{"category": "LocationDialogue Location3", "line_index": 258, "text": "Прикрашає кухню."}
{"category": "LocationDialogue Location3", "line_index": 259, "text": "А ще він робочий!"}
{"category": "LocationDialogue Location3", "line_index": 260, "text": "Можна подивитися"}
{"category": "LocationDialogue Location3", "line_index": 261, "text": "Старі мультики!"}
{"category": "LocationDialogue Location3", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 263, "text": "// Player - телефон"}
{"category": "LocationDialogue Location3", "line_index": 264, "text": "Мій телефон."}
{"category": "LocationDialogue Location3", "line_index": 265, "text": "Він зник у мене з кишені!"}
{"category": "LocationDialogue Location3", "line_index": 266, "text": "Як він тут опинився?"}
{"category": "LocationDialogue Location3", "line_index": 267, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 268, "text": "Ну-у-у... Це не важливо."}
{"category": "LocationDialogue Location3", "line_index": 269, "text": "У мене є ідея."}
{"category": "LocationDialogue Location3", "line_index": 270, "text": "Готовий зробити селфі?"}
{"category": "LocationDialogue Location3", "line_index": 271, "text": "Дивись."}
{"category": "LocationDialogue Location3", "line_index": 272, "text": "Відмінна фотка!"}
{"category": "LocationDialogue Location3", "line_index": 273, "text": "На пам'ять."}
{"category": "LocationDialogue Location3", "line_index": 274, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 275, "text": "У мене питання:"}
{"category": "LocationDialogue Location3", "line_index": 276, "text": "А якщо"}
{"category": "LocationDialogue Location3", "line_index": 277, "text": "Я запущу на ньому гру,"}
{"category": "LocationDialogue Location3", "line_index": 278, "text": "Я побачу тебе?"}
{"category": "LocationDialogue Location3", "line_index": 279, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 280, "text": "Там нікого не буде."}
{"category": "LocationDialogue Location3", "line_index": 281, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 282, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 283, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 284, "text": "// Player - телевизор"}
{"category": "LocationDialogue Location3", "line_index": 285, "text": "А скільки каналів"}
{"category": "LocationDialogue Location3", "line_index": 286, "text": "Тут існує?"}
{"category": "LocationDialogue Location3", "line_index": 287, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 288, "text": "Ну це ж не антена,"}
{"category": "LocationDialogue Location3", "line_index": 289, "text": "А інтернет."}
{"category": "LocationDialogue Location3", "line_index": 290, "text": "Так що тут доступно все,"}
{"category": "LocationDialogue Location3", "line_index": 291, "text": "Що ти можеш дивитися в інтернеті."}
{"category": "LocationDialogue Location3", "line_index": 292, "text": "Почекай!"}
{"category": "LocationDialogue Location3", "line_index": 293, "text": "Ой!"}
{"category": "LocationDialogue Location3", "line_index": 294, "text": "Що це?"}
{"category": "LocationDialogue Location3", "line_index": 295, "text": "Якісь кошенята?"}
{"category": "LocationDialogue Location3", "line_index": 296, "text": "О, дивись!"}
{"category": "LocationDialogue Location3", "line_index": 297, "text": "А знаєш що..."}
{"category": "LocationDialogue Location3", "line_index": 298, "text": "Секунду!"}
{"category": "LocationDialogue Location3", "line_index": 299, "text": "Хочеш соку?"}
{"category": "LocationDialogue Location3", "line_index": 300, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 301, "text": "Дивна реклама..."}
{"category": "LocationDialogue Location3", "line_index": 302, "text": "Сік помер?"}
{"category": "LocationDialogue Location3", "line_index": 303, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 304, "text": "Так це ж соки..."}
{"category": "LocationDialogue Location3", "line_index": 305, "text": "Із соку!"}
{"category": "LocationDialogue Location3", "line_index": 306, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 307, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 308, "text": "М-м, на смак..."}
{"category": "LocationDialogue Location3", "line_index": 309, "text": "Мені подобається,"}
{"category": "LocationDialogue Location3", "line_index": 310, "text": "Але не можу розкуштувати його."}
{"category": "LocationDialogue Location3", "line_index": 311, "text": "Не зрозуміло."}
{"category": "LocationDialogue Location3", "line_index": 312, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 313, "text": "Ну добре."}
{"category": "LocationDialogue Location3", "line_index": 314, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 315, "text": "// Mita shy"}
{"category": "LocationDialogue Location3", "line_index": 316, "text": "Ти ч-чого?"}
{"category": "LocationDialogue Location3", "line_index": 317, "text": "Перестань!"}
{"category": "LocationDialogue Location3", "line_index": 318, "text": "Ти бентежиш."}
{"category": "LocationDialogue Location3", "line_index": 319, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 320, "text": "// Player - статуэтка Аниты"}
{"category": "LocationDialogue Location3", "line_index": 321, "text": "Моторошна статуетка."}
{"category": "LocationDialogue Location3", "line_index": 322, "text": "Тобі"}
{"category": "LocationDialogue Location3", "line_index": 323, "text": "Подобаються такі речі?"}
{"category": "LocationDialogue Location3", "line_index": 324, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 325, "text": "Моторошна?"}
{"category": "LocationDialogue Location3", "line_index": 326, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 327, "text": "Ага."}
{"category": "LocationDialogue Location3", "line_index": 328, "text": "Схоже на щось вельми прокляте..."}
{"category": "LocationDialogue Location3", "line_index": 329, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 330, "text": "Ну... Вона точно не проклята."}
{"category": "LocationDialogue Location3", "line_index": 331, "text": "І не моторошна."}
{"category": "LocationDialogue Location3", "line_index": 332, "text": "А дуже навіть миленька!"}
{"category": "LocationDialogue Location3", "line_index": 333, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 334, "text": "Можливо, ти маєш рацію..."}
{"category": "LocationDialogue Location3", "line_index": 335, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 336, "text": "Міта! // Player"}
{"category": "LocationDialogue Location3", "line_index": 337, "text": "Що відбувається? // Player"}
{"category": "LocationDialogue Location3", "line_index": 338, "text": "// Mita kitchen"}
{"category": "LocationDialogue Location3", "line_index": 339, "text": "Можемо поговорити,"}
{"category": "LocationDialogue Location3", "line_index": 340, "text": "Перед тим як їсти."}
{"category": "LocationDialogue Location3", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 342, "text": "// Start Eat - Mita"}
{"category": "LocationDialogue Location3", "line_index": 343, "text": "І тобі смачного."}
{"category": "LocationDialogue Location3", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 345, "text": "// Quest 1 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 346, "text": "Ще б пак."}
{"category": "LocationDialogue Location3", "line_index": 347, "text": "Ти можеш залишитися тут."}
{"category": "LocationDialogue Location3", "line_index": 348, "text": "Я не проти."}
{"category": "LocationDialogue Location3", "line_index": 349, "text": "І дуже навіть"}
{"category": "LocationDialogue Location3", "line_index": 350, "text": "ЗА!"}
{"category": "LocationDialogue Location3", "line_index": 351, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 352, "text": "// Quest 2 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 353, "text": "Тебе тягне назад?"}
{"category": "LocationDialogue Location3", "line_index": 354, "text": "Але чому?"}
{"category": "LocationDialogue Location3", "line_index": 355, "text": "Адже тут так"}
{"category": "LocationDialogue Location3", "line_index": 356, "text": "Тепло, добре."}
{"category": "LocationDialogue Location3", "line_index": 357, "text": "І тут є я."}
{"category": "LocationDialogue Location3", "line_index": 358, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 359, "text": "Ні-ні,"}
{"category": "LocationDialogue Location3", "line_index": 360, "text": "Можна й залишитися."}
{"category": "LocationDialogue Location3", "line_index": 361, "text": "Але я хвилююся:"}
{"category": "LocationDialogue Location3", "line_index": 362, "text": "Раптом удома щось забув... зробити."}
{"category": "LocationDialogue Location3", "line_index": 363, "text": "Я опинився тут несподівано"}
{"category": "LocationDialogue Location3", "line_index": 364, "text": "І зовсім не готовий"}
{"category": "LocationDialogue Location3", "line_index": 365, "text": "До цього."}
{"category": "LocationDialogue Location3", "line_index": 366, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 367, "text": "Пробач, не подумала."}
{"category": "LocationDialogue Location3", "line_index": 368, "text": "// Quest 3 - Mita "}
{"category": "LocationDialogue Location3", "line_index": 369, "text": "Маєш намір утекти"}
{"category": "LocationDialogue Location3", "line_index": 370, "text": "І забути все?"}
{"category": "LocationDialogue Location3", "line_index": 371, "text": "// player"}
{"category": "LocationDialogue Location3", "line_index": 372, "text": "Ні!"}
{"category": "LocationDialogue Location3", "line_index": 373, "text": "Я просто подумав,"}
{"category": "LocationDialogue Location3", "line_index": 374, "text": "Що все дуже насичене і ненатуральне."}
{"category": "LocationDialogue Location3", "line_index": 375, "text": "Хоча..."}
{"category": "LocationDialogue Location3", "line_index": 376, "text": "Ти цілком здаєшся справжньою."}
{"category": "LocationDialogue Location3", "line_index": 377, "text": "// Mita "}
{"category": "LocationDialogue Location3", "line_index": 378, "text": "Здаюсь?"}
{"category": "LocationDialogue Location3", "line_index": 379, "text": "Але я і є справжня!"}
{"category": "LocationDialogue Location3", "line_index": 380, "text": "Дурень!"}
{"category": "LocationDialogue Location3", "line_index": 381, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 382, "text": "// Quest 4 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 383, "text": "Це особливість"}
{"category": "LocationDialogue Location3", "line_index": 384, "text": "Цього світу."}
{"category": "LocationDialogue Location3", "line_index": 385, "text": "Тобі здасться незвичним,"}
{"category": "LocationDialogue Location3", "line_index": 386, "text": "Але ти не будеш бачити речі,"}
{"category": "LocationDialogue Location3", "line_index": 387, "text": "Що вдалині."}
{"category": "LocationDialogue Location3", "line_index": 388, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 389, "text": "Та начебто це навіть і не помітно."}
{"category": "LocationDialogue Location3", "line_index": 390, "text": "Виглядає стильно."}
{"category": "LocationDialogue Location3", "line_index": 391, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 392, "text": "Ага!"}
{"category": "LocationDialogue Location3", "line_index": 393, "text": "Все, щоб не лагало."}
{"category": "LocationDialogue Location3", "line_index": 394, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 395, "text": "\"Не лагало\"?"}
{"category": "LocationDialogue Location3", "line_index": 396, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 397, "text": "Угум, є баги."}
{"category": "LocationDialogue Location3", "line_index": 398, "text": "Сподіваюся, ти їх не зустрінеш."}
{"category": "LocationDialogue Location3", "line_index": 399, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 400, "text": "// Quest 5 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 401, "text": "Ножиці чи ножик?"}
{"category": "LocationDialogue Location3", "line_index": 402, "text": "Можу і ножем відкрити соус."}
{"category": "LocationDialogue Location3", "line_index": 403, "text": "Але я хотіла,"}
{"category": "LocationDialogue Location3", "line_index": 404, "text": "Щоб тут усе було готово,"}
{"category": "LocationDialogue Location3", "line_index": 405, "text": "Коли ти повернешся."}
{"category": "LocationDialogue Location3", "line_index": 406, "text": "Люблю робити сюрпризи."}
{"category": "LocationDialogue Location3", "line_index": 407, "text": "Щоб не було видно довгих приготувань."}
{"category": "LocationDialogue Location3", "line_index": 408, "text": "Ооооось."}
{"category": "LocationDialogue Location3", "line_index": 409, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 410, "text": "// Glasses - Player"}
{"category": "LocationDialogue Location3", "line_index": 411, "text": "Ти окуляри носиш?"}
{"category": "LocationDialogue Location3", "line_index": 412, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 413, "text": "Ні."}
{"category": "LocationDialogue Location3", "line_index": 414, "text": "Але можу їх одягнути."}
{"category": "LocationDialogue Location3", "line_index": 415, "text": "Ну як, мені личить?"}
{"category": "LocationDialogue Location3", "line_index": 416, "text": "// Mita Yes"}
{"category": "LocationDialogue Location3", "line_index": 417, "text": "Ну ось."}
{"category": "LocationDialogue Location3", "line_index": 418, "text": "Тепер буду в них ходити."}
{"category": "LocationDialogue Location3", "line_index": 419, "text": "// Mita N"}
{"category": "LocationDialogue Location3", "line_index": 420, "text": "Ну-у-у,"}
{"category": "LocationDialogue Location3", "line_index": 421, "text": "Добре..."}
{"category": "LocationDialogue Location3", "line_index": 422, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 423, "text": "// Use the sauce - Player"}
{"category": "LocationDialogue Location3", "line_index": 424, "text": "Гаразд."}
{"category": "LocationDialogue Location3", "line_index": 425, "text": "А що це за соус такий?"}
{"category": "LocationDialogue Location3", "line_index": 426, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 427, "text": "Це соус кохання!"}
{"category": "LocationDialogue Location3", "line_index": 428, "text": "Містить аромат любові"}
{"category": "LocationDialogue Location3", "line_index": 429, "text": "І контрастний погляд на світ."}
{"category": "LocationDialogue Location3", "line_index": 430, "text": "Звучить незвично, чи не так?"}
{"category": "LocationDialogue Location3", "line_index": 431, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 432, "text": "Є таке..."}
{"category": "LocationDialogue Location3", "line_index": 433, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 434, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location3", "line_index": 435, "text": "Це твоя приставка?"}
{"category": "LocationDialogue Location3", "line_index": 436, "text": "Круто."}
