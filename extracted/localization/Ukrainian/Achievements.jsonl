{"category": "Achievements", "line_index": 0, "text": "Кисле молоко."}
{"category": "Achievements", "line_index": 1, "text": "Клацання пітьми."}
{"category": "Achievements", "line_index": 2, "text": "Мертвий сік."}
{"category": "Achievements", "line_index": 3, "text": "Пінгвіномога!"}
{"category": "Achievements", "line_index": 4, "text": "Сейф життя."}
{"category": "Achievements", "line_index": 5, "text": "Тріумф маленького героя."}
{"category": "Achievements", "line_index": 6, "text": "О, велика Міто!"}
{"category": "Achievements", "line_index": 7, "text": "Я знайшов тебе!"}
{"category": "Achievements", "line_index": 8, "text": "Смачна любов."}
{"category": "Achievements", "line_index": 9, "text": "Умови виконано."}
{"category": "Achievements", "line_index": 10, "text": "Розганяйся!"}
{"category": "Achievements", "line_index": 11, "text": "Шльоп по голові!"}
{"category": "Achievements", "line_index": 12, "text": "Зловив їх усіх!"}
{"category": "Achievements", "line_index": 13, "text": "Привіт, Міто."}
{"category": "Achievements", "line_index": 14, "text": "На цьому все?"}
{"category": "Achievements", "line_index": 15, "text": "Розігнався до межі!"}
{"category": "Achievements", "line_index": 16, "text": "Якесь досягнення?"}
{"category": "Achievements", "line_index": 17, "text": "Чудовий танець."}
{"category": "Achievements", "line_index": 18, "text": "Довгий-довгий хвіст."}
{"category": "Achievements", "line_index": 19, "text": "Ти не пройдеш!"}
{"category": "Achievements", "line_index": 20, "text": "Логи першої фази."}
{"category": "Achievements", "line_index": 21, "text": "Логи другої фази."}
{"category": "Achievements", "line_index": 22, "text": "Пекельна перемога!"}
{"category": "Achievements", "line_index": 23, "text": "Неушкоджений!?"}
{"category": "Achievements", "line_index": 24, "text": "Морквина."}
{"category": "Achievements", "line_index": 25, "text": "Задротище."}
