{"category": "LocationDialogue Location9", "line_index": 0, "text": "// Mita Chibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Гей, ти!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Привіт!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Хочеш пройти?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Тоді допоможи мені знайти ключ!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search - MitaChibi  - [not]"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Та щоб його! Тут немає ключа!"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Тут порожньо!"}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "Абсолютно нічого!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Знайшла!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Я думала, ти нижчий будеш!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "А ти он який великий!"}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "Як сестричка!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "Ем... Сестричка?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Так, сестричка."}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Наче не зустрічав її!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Зустрічав? Не те слово."}
{"category": "LocationDialogue Location9", "line_index": 22, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Ти дурний?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "Ем-м..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "Виходить, що дурний..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "Давай, показуй, де шукати ключ!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Ось."}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Закинь залізо в трубу!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Дякую!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "А тепер опусти дрова для мене!"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Спасибі!"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Тепер допоможи тут!"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Готово! А зараз..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "Дивись, як красиво..."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Натискай давай!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Хопа!"}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "Ну все, забирай!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "Ключик твій!"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// quest 1 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Я ChibiMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "З купкою рядків,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "Простенькою моделькою,"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "І найпрекраснішим волоссям!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// quest 2 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Містере великий дурнику,"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "Ти дуже мило виглядаєш,"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "Задаючи дурні запитання."}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Однак,"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "Я бачу тебе вперше!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Але... // Player"}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Якщо хтось і вкрав мій чудовий образ, // MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "То це буде на його совісті!"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// quest 3 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Ти не зрозумів?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "Це пропускний пункт!"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "Пред'явіть свої звивини!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "Проходьте!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Я проводжаю дурненьких загубленців!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// quest 4 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "А хто ти такий,"}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "Щоб НЕ допомагати тобі?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "Що?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Дурнуватий."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Вивалився звідкись!"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Тобі тут бути не слід,"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "От і допомагаю!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Па-па, дурбелику! // Mita [not]"}
