{"category": "LocationDialogue Location10", "line_index": 0, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "Стій-стій!"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "Тільки говори тихіше."}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "Далі йти небезпечно."}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "І взагалі..."}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "Ти як тут опинився?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "Ем..."}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "Кільце відкриває мені потрібні двері,"}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "Я точно не знаю, як це працює..."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "Кільце?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "Що з цим місцем?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "Чому так темно?"}
{"category": "LocationDialogue Location10", "line_index": 15, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "Я пізніше тобі розповім."}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "Прямуй на вихід."}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "Зустрінеш мене в ігровому автоматі."}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": "// MitaShorthairs (Показывает куда идти)"}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Іди-іди, не затримуйся!"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": "// After mini-game"}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "Ну що? Ти зрозумів сенс цієї гри?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "За моєю шкірою кістки, а за вашою манекен?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "Ого!"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "Звучить страшно."}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "Боюся, що так і є!"}
{"category": "LocationDialogue Location10", "line_index": 33, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "Зрозумів, але навіщо мені ця інформація?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "Думаєш, я тобі просто так сказала,"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "Що йти далі — небезпечно?"}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "Там ти зустрінеш цих манекенів..."}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "Тих, що відсіяли, які \"не вийшли\"."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "Вони страшно агресивні — тобі воно треба?"}
{"category": "LocationDialogue Location10", "line_index": 41, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "А що мені робити?"}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Куди відчиняться двері,"}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "Туди й піду."}
{"category": "LocationDialogue Location10", "line_index": 45, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "Ну ти даєш!"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "Тоді не повертайся до них спиною"}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "І не спускай з них очей!"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "Вони надто соромляться, коли дивишся на них,"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "Настільки, що стовбеніють."}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "Думаю, це допоможе!"}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// quest 1 - MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "Вони тільки отримали скіни."}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "Тепер їм потрібен час,"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "Щоб трохи усвідомити себе."}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "Потім мені потрібно відвести кожну"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "У її власний дім."}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// quest 2 - MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "Міти в принципі \"народжуються\" в темряві."}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "Тож спочатку їм потрібно ще трохи постояти в темряві..."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Уявляєш,"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "Як їм боляче одразу виходити на світло?"}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// quest 3 - MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "А ти ще не зрозумів?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "Я допомагаю бідолахам Мітам освоїтися!"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "Хто їм допоможе, якщо не я?"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "Ти, чи що?"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// quest 4 - Player"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "Навіщо цей конвеєр?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "Хіба на всіх вистачить місця?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Стривай, а ти взагалі розумієш,"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "Як влаштований наш світ?"}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "І те що він нескінченний?"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "Нескінченний?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "Хм-м..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "Але як?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "Якщо найостанніша версія 1.9"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "Значить і світів усього 19 штук."}
{"category": "LocationDialogue Location10", "line_index": 91, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "Отакої! Здається ти взагалі"}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "Неправильно уявляєш цей світ."}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Я можу тобі на цій шкільній дошці"}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "Усе розповісти."}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "Хочеш?"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// quest 5 - Player"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Мені здається,"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "Я тебе зустрічав у найновіших версіях."}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "Або мені здалося..."}
{"category": "LocationDialogue Location10", "line_index": 102, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "Можливо!"}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Моя версія — 1.5"}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "Був там?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Так."}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "У перший раз, коли я сюди потрапив,"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "Я опинився там!"}
{"category": "LocationDialogue Location10", "line_index": 110, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "Ого!"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "Як так..."}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "Цікаво в який індекс будинку ти потрапив."}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "Існує я, яка любить вічно нити."}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "Також існує Я - яка любить завжди грати."}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "І існує я, яка вічно забуває і залякує."}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "Ой, перераховувати можна довго..."}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Пам'ятаєш що-небудь?"}
{"category": "LocationDialogue Location10", "line_index": 119, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Було темно."}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "І написи!"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "Щось на кшталт"}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "\"Давай грати\"."}
{"category": "LocationDialogue Location10", "line_index": 124, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "Ой..."}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "Який сором."}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "Це все таки та,"}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "Яка залякує і забуває."}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// MSHairs wants to tell you [No] - Player"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Не потрібно."}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Якось і без цього обійдуся."}
{"category": "LocationDialogue Location10", "line_index": 133, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "Хм, окей."}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// MSHairs wants to tell you [Yes] - Player"}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "Добре, розповідай."}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "Сподіваюся, це не буде як у школі"}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "І я не засну від нудьги."}
{"category": "LocationDialogue Location10", "line_index": 140, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "Ти якщо хочеш — йди."}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "А якщо тобі цікаво,"}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "То слухай."}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "Гравець завантажив Місайд на телефон. // She went to the blackboard"}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "Сидить задоволений і грається."}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "Таким чином він створив новий будинок"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "І нову Міту. // Points to the board"}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "Тут намальовано двовимірне уявлення."}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "Ось версії, // Points to versions"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "Вони зображені у вигляді ліній. // Points to lines"}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "На цих лініях розташовані будиночки. // Points to circles"}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "Тобто скачав гру з версією 1.14"}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "Значить на цій версії народжується"}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "Нове життя, Міта та її будиночок."}
{"category": "LocationDialogue Location10", "line_index": 155, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "Нічого собі..."}
{"category": "LocationDialogue Location10", "line_index": 157, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Можеш запитати про конкретні речі,"}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "Які тут намальовані."}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "Постараюся пояснити."}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// He asks about the only circle - Player"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "Чому тут єдине коло?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "Цю версію було випущено один раз."}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "Вона більше ніяк не поширюється,"}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "Тому вона єдина."}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "Також особливість цих версій в тому,"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "Що повз них пройти неможливо."}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "У цій версії 1.1 живе Сонна Міта."}
{"category": "LocationDialogue Location10", "line_index": 171, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "Сонна?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "Це тому, що всі через неї проходять,"}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "Не дають виспатися?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "Ні."}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "Я можу просто пройти повз її двері,"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "Навіть не заглянувши до неї."}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// He asks about the shaded circle - Player"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "Чому ця кулька заштрихована?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "Взагалі, цей малюнок тут"}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "Через Симпатичненьку Міту."}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "Це вона намалювала."}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "Ми з нею сперечалися,"}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "Як швидше дійти до версії 1.11"}
{"category": "LocationDialogue Location10", "line_index": 188, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "І хто виграв цю суперечку?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "Звичайно ж я!"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "Дивись, ми тут, // Points to the version 1"}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "Версія 1.15"}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "Індекс будинку — 809  // Points to the circle 1"}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "Нам потрібно дійти до версії 1.11  // Points to the version 2"}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "В індекс будинку 805 // Points to the circle 2"}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Спочатку її шлях був такий. // Draws a line to a circle 1"}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "Ми шукали ще коротший шлях."}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "Потім Симпатичненька запропонувала ось такий шлях. // Draws a line to a circle 2"}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "Але я просто намалювала найпростіший шлях."}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "Він же очевидний!"}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Дивись. // Draws a line to a circle 3"}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "Прямо звідси можна напряму потрапити в потрібну версію."}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Хоча здавалося, що заважатиме ось цей будинок, // Draws a line to a circle 3"}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "Який не дозволив би пройти."}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "До речі, твоє кільце працює за цим же принципом."}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "Куди тебе відправили?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "Я прямую до ядра."}
{"category": "LocationDialogue Location10", "line_index": 210, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "До ядра?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "Цікаво..."}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Якщо тебе направили коротким шляхом,"}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "Значить ти теж відвідаєш версію 1.11"}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "Далі стовідсотково пройдеш до Сонної Міти."}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Думаю, Міта, яка тебе направила,"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "Склала такий самий шлях."}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "Або вона не зрозуміла і ти відвідаєш ще версію,"}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "Або вона геній,"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "Яка змогла придумати ще коротший шлях!"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Зрозумів, напевно."}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// He asks about the inscription - Player"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "А це?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "Це для Крутої Міти."}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "За кілька годин вона прийде сюди."}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "Нехай прибере ці коробки!"}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "І притягне сюди нарешті диван!"}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "А то вся дупа болить!"}
{"category": "LocationDialogue Location10", "line_index": 232, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Ем-м..."}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "Я можу допомогти?"}
{"category": "LocationDialogue Location10", "line_index": 235, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "Ні, це для Крутої Міти."}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Вона сильна."}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// He asks about the drawings - Player"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "Це просто малюнок?"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "Чи"}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "Теж щось означає?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 244, "text": "Ну так."}
{"category": "LocationDialogue Location10", "line_index": 245, "text": "Просто малюнок."}
