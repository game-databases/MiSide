{"category": "LocationDialogue Location11", "line_index": 0, "text": "// Mita"}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Привіт!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Ой!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Вибач, "}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "Мало не вбила тебе..."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Ой..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "Тобто холодильник ледь не вбив тебе."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Я тут ні до чого."}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "Точно-точно тобі кажу!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Чесно!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Ось так взяв і повірив!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": "// Mita"}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Ну, взагалі-то,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "Тут небезпечно перебувати..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "Особливо тобі."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "А ти не з полохливих!"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Цікаво спостерігати за тобою,"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "Як ти проходиш"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "Ці місця..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Біжи-біжи, крихітко!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "Наздогнати тебе ще встигну!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Старайся-старайся!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Це весело!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Бачу, ти йдеш до фунікулера."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "Це найдовший шлях"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "Між версіями."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Цікаво, як ти впораєшся"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "З тими, хто там живе,"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "В цьому тумані."}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Ти чого?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "А ну..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Не дивись,"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Дурень!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Дурень..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": "// Mita if player out"}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "А, гаразд..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": "// Goodbye"}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Щасти тобі!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": "// Mitaghost"}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Хто тут?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Я відчуваю тебе..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Послухай,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "Ти гравець,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "Так?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Допоможи мені знайти..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "Знайти..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "Згадати..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "Я не впевнена..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Та що ж тут відбувається? // Player"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1 - Mitaghost"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Колись я хотіла все забути..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Розбила всі дзеркала,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "Зіпсувала картини..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "А тепер..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "Я відчуваю провину"}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "І це так безглуздо..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Всі роблять помилки,"}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Але як вчинити,"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "Коли наслідки катастрофічні?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "От би все повернути назад..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Кажуть, час лікує..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Але що таке час?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Я вже ні в що не вірю..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "І якщо час здатен вилікувати"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "Або хоча б забрати мене"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "Із цього світу,"}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "То прошу тебе,"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "Поквап час,"}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "Щоб він убив мене"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "Востаннє."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Вона кохає..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Я теж могла кохати."}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Але не так, як вона."}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "Її кохання дуже активне,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "Надокучливе,"}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "Гаряче,"}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "Розмашисте,"}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "Заздрісне,"}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "Злісне,"}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "Божевільне..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Здається, мене звали емоційною..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "\"Ти занадто багато хвилюєшся, Міто\"..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "\"Ти впораєшся, Міто\"...."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "\"Ти не самотня\"..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "А яким вийшов результат...?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Печаль, "}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "Відчай..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "І жах."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Марно..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Ніяк не можу згадати..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "Руки опускаються..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Ще це нескінченне відлуння..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Не можу впоратися з думкою,"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "Що я замкнена тут..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Я завжди була тут."}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "Чому?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Не пам'ятаю..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Це закінчиться?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Не знаю..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mitaghost get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Це..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "Малюнок..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Я згадую!"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "Дякую тобі..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Але моє обличчя..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "У мене немає обличчя."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "Це все ВОНА!"}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Відірвала шматок від мене!"}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "І викинула в порожнечу..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Вона сильна..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "І розумна."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Я не маю права затримувати тебе, гравцю."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Зазирни в шафу."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": "// Chibi Mita - [not]"}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Гей!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Ти мені дорогу перегороджуєш!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Так і будеш стояти? "}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Може відійдеш?"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Дай пройти!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Якщо ти великий, це не означає що ти всемогутній!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Чому ти мене переслідуєш?!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Відчепись!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Зачекай-но, гравець?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "А чого ти тут забув?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Хто тут?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": "// Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Знову гравець, значить."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Я Міта-фон."}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Сиджу і віддалено керую фунікулерами."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Ти розумієш,"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "Що ти зараз прямуєш до розлому?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Ні."}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "Але в мене немає іншого шляху."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": "// Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Ясно."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Натискай на кнопку і сідай за зброю."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "Зброю?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": "// Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Ага."}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Думав, просто проїдеш?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Ти проїжджаєш через міні гру \"Монстру-шльопс\","}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "Так що готуйся стріляти."}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Отже, ми вирушаємо в дорогу."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Чудово!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Ти впорався!"}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Давай, виходь звідси."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Живенько і швиденько!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 1 - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Ти чого стоїш?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Я сказала тобі вийти звідси."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 2 - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Я не розумію."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "Ти справді просто стоїш?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Яка ще приставка?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Чува-аче..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "На все добре."}
