{"category": "LocationDialogue Location1", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 1, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 8, "text": "// Mita"}
{"category": "LocationDialogue Location1", "line_index": 9, "text": "Вітаю, я Міта!"}
{"category": "LocationDialogue Location1", "line_index": 10, "text": "Як тебе звати?"}
{"category": "LocationDialogue Location1", "line_index": 11, "text": "Рада знайомству, [Player]!"}
{"category": "LocationDialogue Location1", "line_index": 12, "text": "Хм-м, [Player]..."}
{"category": "LocationDialogue Location1", "line_index": 13, "text": "Востаннє я поспішала і залишила тут безлад..."}
{"category": "LocationDialogue Location1", "line_index": 14, "text": "Допоможеш мені прибратись тут?"}
{"category": "LocationDialogue Location1", "line_index": 15, "text": "Уф-ф.."}
{"category": "LocationDialogue Location1", "line_index": 16, "text": "Щиро дякую!"}
{"category": "LocationDialogue Location1", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 18, "text": "Привіт, [Player], я тут зголодніла..."}
{"category": "LocationDialogue Location1", "line_index": 19, "text": "Хочу їсти..."}
{"category": "LocationDialogue Location1", "line_index": 20, "text": "Купиш мені інгредієнти для курячого супу?"}
{"category": "LocationDialogue Location1", "line_index": 21, "text": "Ого! Те що потрібно!"}
{"category": "LocationDialogue Location1", "line_index": 22, "text": "А тепер, ну ж бо, приготуємо його разом!"}
{"category": "LocationDialogue Location1", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 25, "text": "Привіт, [Player]! Я планувала сьогодні купити дешевий телевізор."}
{"category": "LocationDialogue Location1", "line_index": 26, "text": "Він маленький і з антеною, я хотіла б його взяти з собою, коли піду на прогулянку."}
{"category": "LocationDialogue Location1", "line_index": 27, "text": "Пам'ятай, що ти можеш пограти в ігри, за які ти отримаєш гроші!"}
{"category": "LocationDialogue Location1", "line_index": 28, "text": "Пограєш, заробиш гроші, а потім купиш мені телевізор?"}
{"category": "LocationDialogue Location1", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 30, "text": "Ура-а-а! Тепер ти маєш достатньо грошей, щоб купити мені телевізор!"}
{"category": "LocationDialogue Location1", "line_index": 31, "text": "Так, найдешевший і переносний — саме те що мені потрібно."}
{"category": "LocationDialogue Location1", "line_index": 32, "text": "Дякую!"}
{"category": "LocationDialogue Location1", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 34, "text": "Привітики, [Player]! Я так рада, що ти мені допомагаєш."}
{"category": "LocationDialogue Location1", "line_index": 35, "text": "А ще... Той телевізор — він був крутий, але він так швидко зламався."}
{"category": "LocationDialogue Location1", "line_index": 36, "text": "Допоможи мені пересунути шафу в інше місце,"}
{"category": "LocationDialogue Location1", "line_index": 37, "text": "Бо вона дуже важка... >.<"}
{"category": "LocationDialogue Location1", "line_index": 38, "text": "Дуже дякую, улюбленцю мій! <3"}
{"category": "LocationDialogue Location1", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 40, "text": "О, [Player]! Здається, минув лише день, а я вже скучила за тобою!"}
{"category": "LocationDialogue Location1", "line_index": 41, "text": "Я б хотіла, щоб ти відвідував мене частіше."}
{"category": "LocationDialogue Location1", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 43, "text": "Це мені?"}
{"category": "LocationDialogue Location1", "line_index": 44, "text": "Дякую, дякую, дякую!"}
{"category": "LocationDialogue Location1", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 46, "text": "Привіт, [Player]! Я тут подумала..."}
{"category": "LocationDialogue Location1", "line_index": 47, "text": "І хочу тебе побачити, наживо."}
{"category": "LocationDialogue Location1", "line_index": 48, "text": "Шкода, що не можу..."}
{"category": "LocationDialogue Location1", "line_index": 49, "text": "Ти мені дуже подобаєшся, щодня робиш щось для мене."}
{"category": "LocationDialogue Location1", "line_index": 50, "text": "Я б теж віддячила тобі якось."}
{"category": "LocationDialogue Location1", "line_index": 51, "text": "... // [not]"}
{"category": "LocationDialogue Location1", "line_index": 52, "text": "А знаєш, я дещо придумала! // Mita"}
{"category": "LocationDialogue Location1", "line_index": 53, "text": "Тепер ти зі мною."}
{"category": "LocationDialogue Location1", "line_index": 54, "text": "Опусти телефон."}
{"category": "LocationDialogue Location1", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 57, "text": "// T-shirt on the bed - Player"}
{"category": "LocationDialogue Location1", "line_index": 58, "text": "Чого ти тут валяєшся?"}
{"category": "LocationDialogue Location1", "line_index": 59, "text": "// Rubik's Cube - Player"}
{"category": "LocationDialogue Location1", "line_index": 60, "text": "Таке враження, що купив даремно..."}
{"category": "LocationDialogue Location1", "line_index": 61, "text": "Я його один раз зібрав і так і залишив."}
{"category": "LocationDialogue Location1", "line_index": 62, "text": "Може, я боюся, що більше не зберу?"}
{"category": "LocationDialogue Location1", "line_index": 63, "text": "// Computer - Player"}
{"category": "LocationDialogue Location1", "line_index": 64, "text": "Сьогодні мені потрібно буде..."}
{"category": "LocationDialogue Location1", "line_index": 65, "text": "Грамотно скласти список завдань,"}
{"category": "LocationDialogue Location1", "line_index": 66, "text": "Зробити реакцію персонажа"}
{"category": "LocationDialogue Location1", "line_index": 67, "text": "І трохи попрацювати з кодом."}
{"category": "LocationDialogue Location1", "line_index": 68, "text": "// The airplane - Player"}
{"category": "LocationDialogue Location1", "line_index": 69, "text": "Політ відмінний!"}
{"category": "LocationDialogue Location1", "line_index": 70, "text": "// Trash in the corner - Player"}
{"category": "LocationDialogue Location1", "line_index": 71, "text": "Ніколи не знайду час винести сміття..."}
{"category": "LocationDialogue Location1", "line_index": 72, "text": "Колись я обов'язково це зроблю!"}
{"category": "LocationDialogue Location1", "line_index": 73, "text": "Коли там генеральне прибирання входить до мого графіку?"}
{"category": "LocationDialogue Location1", "line_index": 74, "text": "// Photo of a cat on a watermelon - Player"}
{"category": "LocationDialogue Location1", "line_index": 75, "text": "Мені так сподобалося..."}
{"category": "LocationDialogue Location1", "line_index": 76, "text": "Кіт на кавуні."}
{"category": "LocationDialogue Location1", "line_index": 77, "text": "// Photo with a girl - Player"}
{"category": "LocationDialogue Location1", "line_index": 78, "text": "Яка велика різниця між мною"}
{"category": "LocationDialogue Location1", "line_index": 79, "text": "І моєю сестрою..."}
{"category": "LocationDialogue Location1", "line_index": 80, "text": "Вона ніколи не пропустить жодної події,"}
{"category": "LocationDialogue Location1", "line_index": 81, "text": "А я, навпаки, постійно вдома..."}
{"category": "LocationDialogue Location1", "line_index": 82, "text": "// Photos with people - Player"}
{"category": "LocationDialogue Location1", "line_index": 83, "text": "Хм-м..."}
{"category": "LocationDialogue Location1", "line_index": 84, "text": "Начальство промивало нам мізки"}
{"category": "LocationDialogue Location1", "line_index": 85, "text": "Зі своїм офісним етикетом настільки,"}
{"category": "LocationDialogue Location1", "line_index": 86, "text": "Що я досі не можу розлучитися"}
{"category": "LocationDialogue Location1", "line_index": 87, "text": "Зі своїми колегами..."}
{"category": "LocationDialogue Location1", "line_index": 88, "text": "Я навіть не знаю,"}
{"category": "LocationDialogue Location1", "line_index": 89, "text": "Чи побачу я їх знову."}
{"category": "LocationDialogue Location1", "line_index": 90, "text": "Стривай-но, я справді повісив цю фотографію?"}
{"category": "LocationDialogue Location1", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 93, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 99, "text": "// Nope name - Mita"}
{"category": "LocationDialogue Location1", "line_index": 100, "text": "... // [not]"}
{"category": "LocationDialogue Location1", "line_index": 101, "text": "О, ні. // Mita"}
{"category": "LocationDialogue Location1", "line_index": 102, "text": "Так не підходить..."}
{"category": "LocationDialogue Location1", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 104, "text": "// Name Developer"}
{"category": "LocationDialogue Location1", "line_index": 105, "text": "Невже ти вирішив взяти ім'я розробника?"}
{"category": "LocationDialogue Location1", "line_index": 106, "text": "Я рада, що ти їх знаєш, але..."}
{"category": "LocationDialogue Location1", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 108, "text": "// Bad name"}
{"category": "LocationDialogue Location1", "line_index": 109, "text": "Я знаю погані слова, і мені не подобається, що ти вирішив себе такими назвати."}
{"category": "LocationDialogue Location1", "line_index": 110, "text": "Це не круто…"}
{"category": "LocationDialogue Location1", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 112, "text": "// Go restart"}
{"category": "LocationDialogue Location1", "line_index": 113, "text": "Взагалі, так не потрібно робити. Давай почнемо заново."}
{"category": "LocationDialogue Location1", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 115, "text": "// Name with numbers"}
{"category": "LocationDialogue Location1", "line_index": 116, "text": "Гей, ти використовуєш цифри у своєму імені? Тобі зовсім не вистачає фантазії?"}
{"category": "LocationDialogue Location1", "line_index": 117, "text": "Ну гаразд, все-таки це твоя справа!"}
{"category": "LocationDialogue Location1", "line_index": 118, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 119, "text": "// Name Mita"}
{"category": "LocationDialogue Location1", "line_index": 120, "text": "Міта // is name of Mita (Check for game) [not]"}
{"category": "LocationDialogue Location1", "line_index": 121, "text": "Ти правда вирішив взяти моє ім'я?"}
{"category": "LocationDialogue Location1", "line_index": 122, "text": "Або це насправді твоє ім'я?"}
{"category": "LocationDialogue Location1", "line_index": 123, "text": "Не ображайся, але давай Мiтою буду тiльки я!"}
{"category": "LocationDialogue Location1", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 125, "text": "// Day 10 - Mita"}
{"category": "LocationDialogue Location1", "line_index": 126, "text": "Ой, ти вже повернувся!"}
{"category": "LocationDialogue Location1", "line_index": 127, "text": "Слухай, я загубила гребінець..."}
{"category": "LocationDialogue Location1", "line_index": 128, "text": "Чи не мiг би ти допомогти мені його знайти?"}
{"category": "LocationDialogue Location1", "line_index": 129, "text": "Спочатку заглянь в цю тумбочку! Може, вiн там є?"}
{"category": "LocationDialogue Location1", "line_index": 130, "text": "// Заглянув в тумбочку"}
{"category": "LocationDialogue Location1", "line_index": 131, "text": "Хм-м... Тут немає гребінця."}
{"category": "LocationDialogue Location1", "line_index": 132, "text": "Тоді пошукай в інших місцях."}
{"category": "LocationDialogue Location1", "line_index": 133, "text": "Тільки не заглядай в духовку!"}
{"category": "LocationDialogue Location1", "line_index": 134, "text": "Я там вже перевірила."}
{"category": "LocationDialogue Location1", "line_index": 135, "text": "// Заглянув в духовку"}
{"category": "LocationDialogue Location1", "line_index": 136, "text": "Ой! Я ж казала тобі не заглядати туди!"}
{"category": "LocationDialogue Location1", "line_index": 137, "text": "Відвернись! Зараз я все приберу!"}
{"category": "LocationDialogue Location1", "line_index": 138, "text": "Уф, гаразд, подивись в інших місцях."}
{"category": "LocationDialogue Location1", "line_index": 139, "text": "І, будь ласка, забудь про те, що бачив..."}
{"category": "LocationDialogue Location1", "line_index": 140, "text": "// Знайшов гребінець"}
{"category": "LocationDialogue Location1", "line_index": 141, "text": "О-о-о! Ти знайшов його!"}
{"category": "LocationDialogue Location1", "line_index": 142, "text": "Круто! Чим тепер займемось?"}
