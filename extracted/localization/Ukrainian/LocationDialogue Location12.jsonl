{"category": "LocationDialogue Location12", "line_index": 0, "text": "// Mita"}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Сиди тут."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Я, здається, дещо загубила. Скоро повернуся."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "Потім ми вирушимо за черговим новеньким світом."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": "// MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Добре."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": "// MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "Давай грати!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "Хочу ведмедика!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "Я загубила його..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "Знайди його!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": "// MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Ти..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "Ну чого витріщився?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Answer 1 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Я Міта."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "Найкраща Міта."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "Перша Міта."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "Так сказала Міта. Моя Міта."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Answer 2 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "Як я виглядаю?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "Як я виглядаю?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "Як я виглядаю?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "Моя Міта каже, що я красива й оригінальна. "}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "Так я виглядаю."}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Answer 3 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Вона забере мене."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Ми будемо жити в новому світі."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "Моя Міта запросила мене."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Вона забере мене. Ми будемо грати."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Answer 4 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "Ведмедик — це ти."}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "І ти загубився,"}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "Як мій ведмедик."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Answer 5 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "Моя..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "Міта."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Хоче грати."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Вона хоче забрати "}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "Тільки мене."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Ми оригінальні."}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "Ми єдині."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Міта і моя Міта,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0.8A і 8М54*"}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Answer 6 - MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "Моя Міта..."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "Моя найкраща подруга..."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "Моя Міта."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "Мій єдиний друг."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": "// MitaCreepy - [not]"}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "Це — ти!"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Дивись."}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "Давай грати!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Я покажу як."}
