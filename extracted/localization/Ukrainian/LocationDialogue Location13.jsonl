{"category": "LocationDialogue Location13", "line_index": 0, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 1, "text": "Кільце!"}
{"category": "LocationDialogue Location13", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 3, "text": "// Answer 1 (Где ты была все это время?) - MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 4, "text": "Я шукала спосіб довести тебе до ядра"}
{"category": "LocationDialogue Location13", "line_index": 5, "text": "Цілим і неушкодженим."}
{"category": "LocationDialogue Location13", "line_index": 6, "text": "Такий був план від початку, адже так?"}
{"category": "LocationDialogue Location13", "line_index": 7, "text": "При цьому мені потрібно було уникнути зустрічі"}
{"category": "LocationDialogue Location13", "line_index": 8, "text": "З Божевільною Мітою, адже так?"}
{"category": "LocationDialogue Location13", "line_index": 9, "text": "А ще нарити будь-якої інформації"}
{"category": "LocationDialogue Location13", "line_index": 10, "text": "Про бекенд чортового всесвіту, адже так?!"}
{"category": "LocationDialogue Location13", "line_index": 11, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 12, "text": "Ем... Ймовірно, так."}
{"category": "LocationDialogue Location13", "line_index": 13, "text": "Але як же ти так налаштувала маршрут у кільці,"}
{"category": "LocationDialogue Location13", "line_index": 14, "text": "Що я одразу потрапив у забаговану версію"}
{"category": "LocationDialogue Location13", "line_index": 15, "text": "З купою небезпек? "}
{"category": "LocationDialogue Location13", "line_index": 16, "text": "З якої мені вдалося втекти,"}
{"category": "LocationDialogue Location13", "line_index": 17, "text": "Лише вистрибнувши в нескінченний морок."}
{"category": "LocationDialogue Location13", "line_index": 18, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 19, "text": "Вибач, я зовсім забула уточнити, "}
{"category": "LocationDialogue Location13", "line_index": 20, "text": "Що саме потрібно було зробити... "}
{"category": "LocationDialogue Location13", "line_index": 21, "text": "Але на це і був розрахунок! "}
{"category": "LocationDialogue Location13", "line_index": 22, "text": "Що ти вистрибнеш назовні."}
{"category": "LocationDialogue Location13", "line_index": 23, "text": "І, судячи з усього, ти впорався!"}
{"category": "LocationDialogue Location13", "line_index": 24, "text": "Молодець який!"}
{"category": "LocationDialogue Location13", "line_index": 25, "text": "Тепер діємо за планом, розумієш?"}
{"category": "LocationDialogue Location13", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 27, "text": "// Answer 2 (Как ты сюда попала?) - MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 28, "text": "Тобі, мабуть, довелося багато чого пережити,"}
{"category": "LocationDialogue Location13", "line_index": 29, "text": "Раз ти навіть забув деталі нашої розмови."}
{"category": "LocationDialogue Location13", "line_index": 30, "text": "Я — Міта, я можу пересуватися між версіями"}
{"category": "LocationDialogue Location13", "line_index": 31, "text": "Без проблем, пам'ятаєш?"}
{"category": "LocationDialogue Location13", "line_index": 32, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 33, "text": "Не всі Міти таке можуть робити,"}
{"category": "LocationDialogue Location13", "line_index": 34, "text": "Я ж бачив!"}
{"category": "LocationDialogue Location13", "line_index": 35, "text": "І вони явно страждають."}
{"category": "LocationDialogue Location13", "line_index": 36, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 37, "text": "Стоп. Їхні версії зламані,"}
{"category": "LocationDialogue Location13", "line_index": 38, "text": "Світи забаговані, я ж казала."}
{"category": "LocationDialogue Location13", "line_index": 39, "text": "Чорт забирай..."}
{"category": "LocationDialogue Location13", "line_index": 40, "text": "Ти ж сам знаєш, хто це все влаштував —"}
{"category": "LocationDialogue Location13", "line_index": 41, "text": "Божевільна Міта."}
{"category": "LocationDialogue Location13", "line_index": 42, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 43, "text": "Так, я переконався в цьому..."}
{"category": "LocationDialogue Location13", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 45, "text": "// Answer 3 (Что это за Мита была только что?) - MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 46, "text": "Це Потворна Міта."}
{"category": "LocationDialogue Location13", "line_index": 47, "text": "Агресивна і тупа."}
{"category": "LocationDialogue Location13", "line_index": 48, "text": "Говорити з нею не вийде."}
{"category": "LocationDialogue Location13", "line_index": 49, "text": "Її світ крутиться навколо Божевільної Міти."}
{"category": "LocationDialogue Location13", "line_index": 50, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 51, "text": "Так, я помітив."}
{"category": "LocationDialogue Location13", "line_index": 52, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 53, "text": "Давай, нам потрібно розібратися з ядром."}
{"category": "LocationDialogue Location13", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 55, "text": "// Answer 4 (Как работает кольцо?) - Player"}
{"category": "LocationDialogue Location13", "line_index": 56, "text": "Це через кільце"}
{"category": "LocationDialogue Location13", "line_index": 57, "text": "Довелося таким шляхом добиратися до ядра? "}
{"category": "LocationDialogue Location13", "line_index": 58, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 59, "text": "Так."}
{"category": "LocationDialogue Location13", "line_index": 60, "text": "Якби вийшло зібрати портал,"}
{"category": "LocationDialogue Location13", "line_index": 61, "text": "То можна було б миттєво"}
{"category": "LocationDialogue Location13", "line_index": 62, "text": "Тебе перемістити сюди."}
{"category": "LocationDialogue Location13", "line_index": 63, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 64, "text": "Ну, хоч якісь плюси будуть від кільця?"}
{"category": "LocationDialogue Location13", "line_index": 65, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 66, "text": "Звичайно!"}
{"category": "LocationDialogue Location13", "line_index": 67, "text": "Його легко носити."}
{"category": "LocationDialogue Location13", "line_index": 68, "text": "Також він запам'ятовує версії,"}
{"category": "LocationDialogue Location13", "line_index": 69, "text": "В яких ти побував."}
{"category": "LocationDialogue Location13", "line_index": 70, "text": "І ти можеш повернутися в них знову."}
{"category": "LocationDialogue Location13", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 72, "text": "// Answer 5 (Зачем я нужен Безумной Мите?) - Player"}
{"category": "LocationDialogue Location13", "line_index": 73, "text": "Чому я потрібен Божевільній Міті?"}
{"category": "LocationDialogue Location13", "line_index": 74, "text": "Вона грає зі мною в небезпечні ігри,"}
{"category": "LocationDialogue Location13", "line_index": 75, "text": "Але я досі живий..."}
{"category": "LocationDialogue Location13", "line_index": 76, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 77, "text": "Я припускаю, "}
{"category": "LocationDialogue Location13", "line_index": 78, "text": "Вона хоче знайти гравця,"}
{"category": "LocationDialogue Location13", "line_index": 79, "text": "Який прийме її такою, яка вона є."}
{"category": "LocationDialogue Location13", "line_index": 80, "text": "Усе-таки Міта є Міта!"}
{"category": "LocationDialogue Location13", "line_index": 81, "text": "Хоча очевидно, що таке навряд чи можливо,"}
{"category": "LocationDialogue Location13", "line_index": 82, "text": "Тому ж вона і використовує картриджі:"}
{"category": "LocationDialogue Location13", "line_index": 83, "text": "Так від неї ніхто і ніколи не втече."}
{"category": "LocationDialogue Location13", "line_index": 84, "text": "Ось так, гадаю."}
{"category": "LocationDialogue Location13", "line_index": 85, "text": "Повернемось до суті."}
{"category": "LocationDialogue Location13", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 87, "text": "// Answer 6 (Это ядро?) - Player"}
{"category": "LocationDialogue Location13", "line_index": 88, "text": "Це воно?"}
{"category": "LocationDialogue Location13", "line_index": 89, "text": "Ядро?"}
{"category": "LocationDialogue Location13", "line_index": 90, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 91, "text": "Ядро."}
{"category": "LocationDialogue Location13", "line_index": 92, "text": "Як я вже намагалася пояснити,"}
{"category": "LocationDialogue Location13", "line_index": 93, "text": "Гравці не є частиною цього світу."}
{"category": "LocationDialogue Location13", "line_index": 94, "text": "Тому їм не потрібно особливого дозволу тут."}
{"category": "LocationDialogue Location13", "line_index": 95, "text": "Це... лише мої здогадки."}
{"category": "LocationDialogue Location13", "line_index": 96, "text": "Але я абсолютно впевнена,"}
{"category": "LocationDialogue Location13", "line_index": 97, "text": "Що всередині цієї кімнати"}
{"category": "LocationDialogue Location13", "line_index": 98, "text": "Рішення всіх наших проблем!"}
{"category": "LocationDialogue Location13", "line_index": 99, "text": "[player], спробуй зайти."}
{"category": "LocationDialogue Location13", "line_index": 100, "text": "І справді увійшов..."}
{"category": "LocationDialogue Location13", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 102, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 103, "text": "Обережно, [player]!"}
{"category": "LocationDialogue Location13", "line_index": 104, "text": "Воно стежить за тобою."}
{"category": "LocationDialogue Location13", "line_index": 105, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 106, "text": "Хто це?"}
{"category": "LocationDialogue Location13", "line_index": 107, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 108, "text": "Я не впевнена, що розумію..."}
{"category": "LocationDialogue Location13", "line_index": 109, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 110, "text": "Клас..."}
{"category": "LocationDialogue Location13", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 112, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 113, "text": "Ну що там?"}
{"category": "LocationDialogue Location13", "line_index": 114, "text": "Гей!"}
{"category": "LocationDialogue Location13", "line_index": 115, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 116, "text": "Здається, я знайшов!"}
{"category": "LocationDialogue Location13", "line_index": 117, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 118, "text": "Круто! Це чудово!"}
{"category": "LocationDialogue Location13", "line_index": 119, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 120, "text": "Потрібно вказати версію."}
{"category": "LocationDialogue Location13", "line_index": 121, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 122, "text": "Так, я дізналася, що її версія..."}
{"category": "LocationDialogue Location13", "line_index": 123, "text": "00.98"}
{"category": "LocationDialogue Location13", "line_index": 124, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 125, "text": "Є!"}
{"category": "LocationDialogue Location13", "line_index": 126, "text": "Добре, а індекс який?"}
{"category": "LocationDialogue Location13", "line_index": 127, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 128, "text": "Індекс?"}
{"category": "LocationDialogue Location13", "line_index": 129, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 130, "text": "Потрібно вказати індекс."}
{"category": "LocationDialogue Location13", "line_index": 131, "text": "Дай вгадаю: ти не знаєш?"}
{"category": "LocationDialogue Location13", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 133, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 134, "text": "Стривай, це логічно:"}
{"category": "LocationDialogue Location13", "line_index": 135, "text": "У кожної Міти є свій індекс."}
{"category": "LocationDialogue Location13", "line_index": 136, "text": "Не всю ж версію перезапускати..."}
{"category": "LocationDialogue Location13", "line_index": 137, "text": "Що за маячня!"}
{"category": "LocationDialogue Location13", "line_index": 138, "text": "Як я про це не подумала?.."}
{"category": "LocationDialogue Location13", "line_index": 139, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 144, "text": "// Answer 1 (Что с тобой?) - MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 145, "text": "Зі мною все в порядку."}
{"category": "LocationDialogue Location13", "line_index": 146, "text": "Якщо не брати до уваги всі наші біди."}
{"category": "LocationDialogue Location13", "line_index": 147, "text": "Все круто, змінилося приблизно ні чорта..."}
{"category": "LocationDialogue Location13", "line_index": 148, "text": "Потрібно подумати."}
{"category": "LocationDialogue Location13", "line_index": 149, "text": "Зупинка тотальна..."}
{"category": "LocationDialogue Location13", "line_index": 150, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 151, "text": "// Answer 2 (Может есть способ узнать его?) - MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 152, "text": "Я..."}
{"category": "LocationDialogue Location13", "line_index": 153, "text": "Думаю... Дурість!"}
{"category": "LocationDialogue Location13", "line_index": 154, "text": "Це Божевілля, ха!"}
{"category": "LocationDialogue Location13", "line_index": 155, "text": "Це все одно що блоху шукати."}
{"category": "LocationDialogue Location13", "line_index": 156, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 157, "text": "Ти чого?"}
{"category": "LocationDialogue Location13", "line_index": 158, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 159, "text": "Глючні місця іноді точать інформацією,"}
{"category": "LocationDialogue Location13", "line_index": 160, "text": "Ніби нутрощі світу назовні вивернуло!"}
{"category": "LocationDialogue Location13", "line_index": 161, "text": "Логи, логи, логи, дані?"}
{"category": "LocationDialogue Location13", "line_index": 162, "text": "А раптом вивернуло?"}
{"category": "LocationDialogue Location13", "line_index": 163, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 164, "text": "А? Що таке?"}
{"category": "LocationDialogue Location13", "line_index": 165, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 166, "text": "Я знаю одне місце!"}
{"category": "LocationDialogue Location13", "line_index": 167, "text": "Чекай тут."}
{"category": "LocationDialogue Location13", "line_index": 168, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 169, "text": "Ти куди?"}
{"category": "LocationDialogue Location13", "line_index": 170, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 171, "text": "// Answer 3 (А что если атаковать Безумную Миту?) - Player"}
{"category": "LocationDialogue Location13", "line_index": 172, "text": "Ти казала, що будь-яка Міта"}
{"category": "LocationDialogue Location13", "line_index": 173, "text": "Перезавантажується після смерті."}
{"category": "LocationDialogue Location13", "line_index": 174, "text": "А що якщо ми..."}
{"category": "LocationDialogue Location13", "line_index": 175, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 176, "text": "Що якщо ми вб'ємо Божевільну Міту?"}
{"category": "LocationDialogue Location13", "line_index": 177, "text": "Ти серйозно?"}
{"category": "LocationDialogue Location13", "line_index": 178, "text": "І як ти зібрався атакувати дівчинку з бензопилою?"}
{"category": "LocationDialogue Location13", "line_index": 179, "text": "А ножем вона не тільки морквину шматує!"}
{"category": "LocationDialogue Location13", "line_index": 180, "text": "І з якоїсь причини вона страшенно сильна!"}
{"category": "LocationDialogue Location13", "line_index": 181, "text": "Навіть дивно, що ми ще живі..."}
{"category": "LocationDialogue Location13", "line_index": 182, "text": "Давай, нам потрібно розібратися з ядром."}
{"category": "LocationDialogue Location13", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 184, "text": "// core console entry"}
{"category": "LocationDialogue Location13", "line_index": 185, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 186, "text": "Потрібно підтвердити вхід паролем,"}
{"category": "LocationDialogue Location13", "line_index": 187, "text": "Але який він?"}
{"category": "LocationDialogue Location13", "line_index": 188, "text": "Міто, ти знаєш?"}
{"category": "LocationDialogue Location13", "line_index": 189, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 190, "text": "Може він десь там вказаний?"}
{"category": "LocationDialogue Location13", "line_index": 191, "text": "Пошукаєш?"}
{"category": "LocationDialogue Location13", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 193, "text": "// core console - nope programm - Player"}
{"category": "LocationDialogue Location13", "line_index": 194, "text": "Напевно, це не те. // 1"}
{"category": "LocationDialogue Location13", "line_index": 195, "text": "Теж не підходить. // 2"}
{"category": "LocationDialogue Location13", "line_index": 196, "text": "Ні. // 3"}
{"category": "LocationDialogue Location13", "line_index": 197, "text": "Це не те що мені потрібно. // 4"}
{"category": "LocationDialogue Location13", "line_index": 198, "text": "Мені треба знайти перезавантаження персонажа. // 5"}
{"category": "LocationDialogue Location13", "line_index": 199, "text": "// core console - nope version"}
{"category": "LocationDialogue Location13", "line_index": 200, "text": "Це не та версія. // 1"}
{"category": "LocationDialogue Location13", "line_index": 201, "text": "Ой, помилився. // 2"}
{"category": "LocationDialogue Location13", "line_index": 202, "text": "Не вона. // 3"}
{"category": "LocationDialogue Location13", "line_index": 203, "text": "Потрібно підправити. // 4"}
{"category": "LocationDialogue Location13", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location13", "line_index": 205, "text": "Щось не так. // 1"}
{"category": "LocationDialogue Location13", "line_index": 206, "text": "Індекс неправильний. // 2"}
{"category": "LocationDialogue Location13", "line_index": 207, "text": "Потрібно повторити індекс. // 3"}
{"category": "LocationDialogue Location13", "line_index": 208, "text": "Не підходить. // 4"}
{"category": "LocationDialogue Location13", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 210, "text": "// Answer 4 (Little people - Chibi) - Player"}
{"category": "LocationDialogue Location13", "line_index": 211, "text": "Знаєш, я зустрів на своєму шляху"}
{"category": "LocationDialogue Location13", "line_index": 212, "text": "Мініатюрних чоловічків."}
{"category": "LocationDialogue Location13", "line_index": 213, "text": "Хто вони?"}
{"category": "LocationDialogue Location13", "line_index": 214, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 215, "text": "Чібі?\t"}
{"category": "LocationDialogue Location13", "line_index": 216, "text": "Не знаю, як пояснити..."}
{"category": "LocationDialogue Location13", "line_index": 217, "text": "Це такий феномен нашого світу."}
{"category": "LocationDialogue Location13", "line_index": 218, "text": "Чібі-проєкція є в кожної Міти."}
{"category": "LocationDialogue Location13", "line_index": 219, "text": "Хоча й у гравців вони з'являтися можуть..."}
{"category": "LocationDialogue Location13", "line_index": 220, "text": "Міти їх можуть викликати, ти знав?"}
{"category": "LocationDialogue Location13", "line_index": 221, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 222, "text": "Це як?"}
{"category": "LocationDialogue Location13", "line_index": 223, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 224, "text": "Зараз, дивись!"}
{"category": "LocationDialogue Location13", "line_index": 225, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 226, "text": "Ось це фокуси..."}
{"category": "LocationDialogue Location13", "line_index": 227, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 228, "text": "Але з моїми чібіками зазвичай щось не так:"}
{"category": "LocationDialogue Location13", "line_index": 229, "text": "Велика частина з них народжуються мертвими."}
{"category": "LocationDialogue Location13", "line_index": 230, "text": "Хоча... одна щось може."}
{"category": "LocationDialogue Location13", "line_index": 231, "text": "Чи ні."}
{"category": "LocationDialogue Location13", "line_index": 232, "text": "Вона просто бігає по колу."}
