{"category": "LocationDialogue Location20", "line_index": 0, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Міло! Ні! Ти ненормальна!"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": "// Mita"}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Ха-ха! ЩО Я БАЧУ?"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "Невже це нова емоція на твоєму обличчі?"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "Давай, більше, більше!"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "Мені набридло просто спостерігати!"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\" - Mita"}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "Ну як, мій невгамовний,"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "Ще не набридло тинятися абикуди?"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Що ти зробила з Мілою?"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": "// Mita"}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "Значить, не втомився!"}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Давай ще зіграємо разом!"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "Ти..."}
{"category": "LocationDialogue Location20", "line_index": 18, "text": "// Mita"}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "Почнемо з невеликого тесту! "}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "Давай перевіримо твою координацію!"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "Протестуємо твою поведінку!"}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "А раптом з тобою щось не так? "}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "А раптом ти не заслуговуєш тієї ШКУРИ,"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "Яку гордо носиш?"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "Ось, дивись, "}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "Який вибереш?"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "Правий"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "Чи"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "Лівий?"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "Ти серйозно? "}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "А яка різниця?"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "Я ж просто пожартувала!"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "Забудь. Різанина — це вже не в моді."}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "Ну, гаразд."}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "У мене є цікавіші ідеї."}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "І для початку..."}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "Поглянь, що в мене є!"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Нам потрібно трішки музики!"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "Як тобі мелодія?"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "Мене вона захоплює!"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "Я почну"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "З правил!"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rule"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "Поки ця мелодія грає,"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "Можеш рухатися."}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "Якщо мелодії немає,"}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "Не рухайся,"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "Інакше помреш!"}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "Дивись: тобі потрібно дійти до кінця."}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "Впораєшся —"}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "Продовжимо гру!"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "Ну чого стоїш?"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Біжи, крихітко, біжи!"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder - Mita"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "Овва!"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Ти такий слухняний! "}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Чудовий екземпляр!"}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Хочу тебе собі!"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "Хоча, це було занадто просто, чи не так?"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "Відпусти мене!"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": "// Mita"}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "Не розслабляйся!"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "У нас ще безліч ігор попереду!"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "Отже! // Close eyes"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Тепер я буду заплющувати очі."}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "І коли розплющу, // open eyes"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "Від тебе не повинно бути ні слуху, ні духу!"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "Зрозумів мене?"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "Якщо побачу — покараю!"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Окей, почнемо!"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "Це марно."}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide - Mita"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "Дістався!"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Оце ти молодець! Це так хвилює!"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "Тепер буде складніше!"}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "У бага-ато разів складніше..."}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Ховайся! Біжи! А потім покрутись!"}
{"category": "LocationDialogue Location20", "line_index": 87, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "Чорт тебе забирай!"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Player fall - Player"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "Здається, пронесло..."}
