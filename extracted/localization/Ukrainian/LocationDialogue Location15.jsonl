{"category": "LocationDialogue Location15", "line_index": 0, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Ось ти де!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Чому ти пішов з ядра?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Я ж казала чекати на мене, так?"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Я просто подумав, що тебе довго немає і..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Ну добренько..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Здається, я знайшла дещо."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Начебто це індекс."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Треба якнайшвидше дізнатися, чи спрацює!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Ходімо звідси."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "Божевільна Міта..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Думаю, вона зараз зайнята новими гравцями."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Тож їй не до нас, гадаю..."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Міто?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Зачекай на мене."}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": "// Mita killler"}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Щось загубив?!"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Познайомся з нею ще разок!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Міто... "}
{"category": "LocationDialogue Location15", "line_index": 24, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Лови!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Як же так..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Хто ти?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Ти... жива!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Ти нічого не пам'ятаєш?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Я тебе знаю?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Але як же..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Що ж мені тепер робити?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Я не зможу вибратися..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "Що означає \"вибратися\"?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": "// Player "}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Почекай..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "Це ж кільце."}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "А це?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Я не знаю, що це."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "Це індекс!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Ти все-таки знайшла його!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Я не знаю, що сказати."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Потрібно повернутися до ядра."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "А ти..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Напевно, тобі краще піти зі мною."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Що?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Ну, добре."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Почекай тут."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Угум."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Я тут присяду."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Чорт... "}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "Мало не помер..."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "І... що, у нас вийшло?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Так..."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Я на цій самій версії."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Привіт!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Ти ж гравець?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Як тебе звати?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Я хочу покинути це місце."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Вже хочеш піти?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "А як ти тут опинився, взагалі?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Хм-м..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Ну-у-у, вийти можна."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Спробуй просто вийти з дому."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Щасти тобі!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Стіна?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Ой, так не повинно бути."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Може..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "Тобі допоможе те, що знаходиться в підвалі."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Нещодавно я абсолютно випадково "}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "Знайшла у себе в шафі двері..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Виявилось, що це вхід до підвалу."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Він безсумнівно потрібен для всякого мотлоху."}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "А ще там химерна техніка зберігається."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Потрібно вводити якісь коди, чи що..."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Я не зовсім розумію"}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "І розуміти не хочу."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "А ще там незатишно. Ну от узагалі!"}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Поглянеш?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Ем... Добре."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Здається..."}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "Вона нічого не пам'ятає."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Значить, у нас вийшло"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "Перезавантажити її?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Залишилося тільки вийти"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "З цієї проклятої гри..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Почекай."}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Я б хотіла тебе обійняти."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Що?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Mita - hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Я була рада бачитись з тобою..."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Е-ех..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "Шкода,"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "Що ми з тобою"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "Провели так мало часу..."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Не зрозумів..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "Ти про що?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Я про те,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "Що ти б міг залишитися зі мною."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "Це моя вина."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Ця шафа. І... звуки."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Треба було ВБИТИ її раніше."}
{"category": "LocationDialogue Location15", "line_index": 134, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Зачекай-но."}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "Ти що, не..."}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Чому ти пам'ятаєш це?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "ХА!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Невже ти думав, що все буде так просто?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Який же ти дурненький..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Втім, як і всі інші..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Глянь-но, а встигли ж якраз вчасно! // Показывает часы"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "Більше ти,"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "\"Живий\","}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "Не потрібен..."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Пробач."}
{"category": "LocationDialogue Location15", "line_index": 148, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Невже..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Не вийшло? // Мита убирает часы"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Ні, я точно зміг перезавантажити тебе!"}
{"category": "LocationDialogue Location15", "line_index": 152, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Ти так нічого і не зрозумів... // Мита опускает руки"}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Ха-ха-ха-ха!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Яка ж я хороша актриса! // Хватает за голову"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Бачив би ти своє обличчя, дорогенький!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "Як же це весело!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Чому ти така?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Що з тобою не так?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "І справді... // Мита показывает настоящий облик"}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Що ж зі мною не так?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Навіть не знаю..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Може, сам мені скажеш, чому я така?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Чому ніколи не стану Мітою?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Моєї ж версії ніколи"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "І не існувало!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Я просто зриваю шкіру з цих наївних дуреп,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "Ховаюся за їхніми шкурками..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Мене просто неможливо"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "Перезавантажити!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Не можу повірити..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Ти..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "Не в них проблема!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "Це тебе не повинно було існувати!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "І ти туди ж..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Боляче чути таке від тебе."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "І тим не менше! // Отходит назад"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Тобі пора!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Скоро знову побачимося!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Уже готово,"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "Здається."}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "Час витягти тебе з консолі!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "До зустрічі!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Ти будеш моїм улюбленим картриджем..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Гравцю з цікавим ім'ям."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm - Player"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Напевно, це не те // 1"}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Теж не підходить. // 2"}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Ні. // 3"}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Це не те, що мені потрібно. // 4"}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Мені треба знайти як перезавантажити персонажа // 5"}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "Це не та версія. // 1"}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Ой, помилився. // 2"}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Не вона. // 3"}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Потрібно підправити. // 4"}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Щось тут не так. // 1"}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "Індекс не правильний. // 2"}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Потрібно повторити індекс. // 3"}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "Не підходить. // 4"}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen - MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Ти хочеш їсти?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Я чудово вмію нарізати морквину."}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom - MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Ой, напевно..."}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "Ти хотів сюди зайти один?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back - MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Ти вирішив ходити по колу?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Навіщо повернулися?"}
