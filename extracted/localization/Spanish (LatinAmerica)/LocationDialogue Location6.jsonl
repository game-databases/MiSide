{"category": "LocationDialogue Location6", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "¿Mita?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "¿Cómo llegaste aquí?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Eres Mita, ¿verdad?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Pero hay algo diferente en ti..."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "Ya veo, eres observador."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "Y estás en lo correcto."}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "No soy la Mita que conociste antes."}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Ten cuidado, planea algo "}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "siniestro."}
{"category": "LocationDialogue Location6", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "Eh, ¿qué quieres decir?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "No hay tiempo:"}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "¡si esto funciona, te lo diré todo!"}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Trae la llave, está al lado del sofá."}
{"category": "LocationDialogue Location6", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Pero..."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "¡Pregunta después!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Dame la llave."}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Toma este anillo."}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "¿Eh?"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Quieres salir de aquí, ¿o no?"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "Um, sí..."}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Entonces póntelo."}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "Es un artefacto útil,"}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "lo necesitarás pronto."}
{"category": "LocationDialogue Location6", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Está bien..."}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "Por cierto, soy"}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Un nombre interesante,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player]."}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "Soy... Mita."}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// MitaKind quest 1"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "¡Oye!"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "¿Ves esa consola? Tómala."}
{"category": "LocationDialogue Location6", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "¿Estamos... viendo una grabación?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "¿Quién es ese con ella?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "Está ocurriendo ahora."}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "Es otro jugador."}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Está... usándolo."}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Ella quizás"}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "te convierta en un cartucho también."}
{"category": "LocationDialogue Location6", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "¡Necesito salir de aquí ahora!"}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "Y tú también."}
{"category": "LocationDialogue Location6", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "Sí, es verdad."}
{"category": "LocationDialogue Location6", "line_index": 64, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "Entonces, estás diciendo..."}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "que ella lo está utilizando."}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "Si saco el cartucho, ¿qué pasa? "}
{"category": "LocationDialogue Location6", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "El cartucho podría dañarse"}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "irremediablemente."}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "Lo que significa que..."}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "el jugador moriría."}
{"category": "LocationDialogue Location6", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "..."}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "¿Qué pasaría si sólo lo apago?"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "Eso... podría funcionar..."}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "vale la pena intentarlo. ¿Ves el botón rojo?"}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Está en la consola."}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "Lo encontré."}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "Presiónalo."}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// MitaKind quest 2"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Debo quedarme aquí."}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "Tengo preguntas que hacerle"}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "para saber más sobre ella."}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "Aunque, no creo que me responda..."}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// MitaKind quest 3"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "La verdad, esta es mi versión."}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "Estaba acompañando a un jugador,"}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "cuando algo cambió de repente."}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "Entonces... ella apareció."}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "Convirtió al jugador en un cartucho"}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "y me encerró, en este lugar."}
{"category": "LocationDialogue Location6", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Espera, ¿lo convirtió en un cartucho?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "¿Cómo puede hacer eso?"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "¿Por qué?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "¿Para qué necesita a los jugadores?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "Claramente está loca..."}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Sólo está jugando con nosotros, usándonos para su beneficio."}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "Convirtiendo a jugadores en cartuchos..."}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Algunos jamás notaron lo que ocurría..."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "y los que sí lo hicieron, ni se resistieron... ¡Ah!"}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "Esto se tornó oscuro..."}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "¡Tienes que ayudarnos!"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "¿Yo? ¿Pero cómo?"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "¡Te necesito, [player]!"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "¡Si nos ayudas, yo te ayudaré!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Es nuestra única oportunidad."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "El anillo te guiará... a la versión correcta."}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "Te veré ahí."}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// MitaKind quest 4"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "Aún no logro entender"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "lo que vi allá arriba..."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Esa Mita..."}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "¿estaba intentando matarme?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "¿Matarte?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Ella tiene en mente algo mucho peor para ti..."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "Debes darte prisa."}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Hide!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "Ay, no ¡escóndete!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Espera, ¡¿qué?!"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Deprisa, ¡aquí viene!"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "¡Sigue el anillo! Te mantendrá seguro."}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "Bien, ¿me dirás dónde está?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "¡¡Ni loca!!"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "Vas a matarlo, ¿verdad?"}
{"category": "LocationDialogue Location6", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Ah... ¿entonces no vas a decirme?"}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Está bien, amo los desafíos."}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "Debe estar por aquí."}
{"category": "LocationDialogue Location6", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "¿Por qué eres tan cruel con nosotras?"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "¡Al menos dime por qué estás haciendo esto!"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "Además..."}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "¿Para qué necesitas a los jugadores?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "¡Ellos no son tus juguetes!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "Dime, ¡¿qué es lo que te pasó?!"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "¡JA! ¡cierra la boca, muñeca!"}
