{"category": "LocationDialogue Location15", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "¡Por fin te encontré!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "¿Por qué dejaste el núcleo?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "¡Te pedí que me esperaras ahí!"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Creí que te había pasado algo..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Bueno, está bien..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Encontré algo que podría sernos útil..."}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "creo que es un índice."}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "¡Tenemos que revisar si funciona!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "¡Vamos! Te sacaré de aquí."}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "La Mita Loca..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "parece estar ocupada con un nuevo jugador."}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Ojalá eso la mantenga entretenida y no se fije en nosotros..."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "¿Mita?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "¡Espérame!"}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "¿Se te perdió algo, mi amor?"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "¡¿Por qué no la saludas una vez más?!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "¡Mita...!"}
{"category": "LocationDialogue Location15", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "¡Atrápala!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "¿Cómo es posible...?"}
{"category": "LocationDialogue Location15", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "¿Quién eres?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Tú... ¡estás viva!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "¿Me recuerdas?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Disculpa, ¿te conozco?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "No..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "¿qué debo hacer ahora?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "No podré salir..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "¿A qué te refieres con... 'salir'?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Espera..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "¿Es el anillo...?"}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "¿Y eso?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Ah... sinceramente no tengo idea."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "¡Es el índice!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "¡Lo encontraste!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "La verdad, no comprendo que está pasando, cariño."}
{"category": "LocationDialogue Location15", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Debemos regresar al núcleo."}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "Y tú..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "tal vez deberías venir conmigo..."}
{"category": "LocationDialogue Location15", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "¿Qué?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Sí... claro."}
{"category": "LocationDialogue Location15", "line_index": 60, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Espera aquí."}
{"category": "LocationDialogue Location15", "line_index": 62, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Sí."}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Me sentaré justo aquí."}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Carajo..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "estuvo cerca."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "¿Lo... logramos?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Bien."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Estoy en la versión correcta."}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "¡Hola!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Eres un jugador, ¿verdad?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "¿Cuál es tu nombre?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Quiero dejar este lugar..."}
{"category": "LocationDialogue Location15", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "¿Ya te vas?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "¿Cómo llegaste aquí en primer lugar?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Oh bueno..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Está bien, puedes irte..."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Prueba con la puerta principal."}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "¡Buena suerte!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "¿Una pared?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Hmm, algo está mal."}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Tal vez..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "haya algo en el sótano que te ayude."}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Recientemente descubrí "}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "una puerta en mi armario..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Lleva a un sótano."}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Pero está lleno de basura,"}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "y varios dispositivos complicados."}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Uno te pide ingresar un código o algo así."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "La verdad, no lo entiendo bien."}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "Y no sé si quiero hacerlo."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "Es... un lugar muy inquietante."}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "¿Quieres echar un vistazo?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Uh... está bien."}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Creo"}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "que no recuerda nada..."}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "¿Lo logramos?"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "¿La restablecimos?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Entonces lo único que falta"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "es salir de este maldito juego..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "¡Espera!"}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Me gustaría... darte un abrazo."}
{"category": "LocationDialogue Location15", "line_index": 116, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "¿Eh?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Fue lindo conocerte."}
{"category": "LocationDialogue Location15", "line_index": 120, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Ah..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "pero es una pena"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "que tú y yo... hayamos pasado"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "tan poco tiempo juntos."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Eh..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "¿de qué estás hablando?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Quiero decir,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "que pudiste haberte quedado conmigo..."}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "Pero fue mi culpa..."}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Ese armario y... los sonidos."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Debí haberla... ¡¡MATADO ANTES!!"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Espera un momento,"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "¿acaso...?"}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "¿Cómo puedes recordar eso?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "¡JA!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "¿Pensaste que sería tan fácil?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Ay, qué iluso eres... jajaja."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Igual que los demás jugadores..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "Y justo a tiempo. ¡Mira!"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "Tu yo REAL"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "ya no es"}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "necesario."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Qué lástima, ¡upsie!"}
{"category": "LocationDialogue Location15", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "De verdad..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "¿no funcionó...?"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "No... te reinicié, estoy seguro que lo hice..."}
{"category": "LocationDialogue Location15", "line_index": 152, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "¿Aún no lo entiendes...?"}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "¡JAJAJAJAJAJAJAJAJA!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "¡SOY TAN BUENA ACTRIZ!"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "¡Debiste ver tu cara, cariño!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "¡Esto es... TAN divertido!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "¡¿Por qué eres así?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "¡¿Cuál es tu problema?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "Sí..."}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "¿cuál es mi problema?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "No lo sé..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "¿por qué no me lo dices TÚ?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Dime por qué nunca seré una Mita real."}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "¿Sabes? Mi versión..."}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "¡¡JAMÁS EXISTIÓ EN PRIMER LUGAR!!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Yo sólo despelleje a esas muñecas,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "y me escondí bajo su piel..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "¡No hay forma de que"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "PUEDAS REINICIARME! ¡¡JAJAJAJA!!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "No puedo creerlo..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Tú..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "¡No hay nada de malo con ellas!"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "¡Tú eres quien no debería existir!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "Y ahora tú también..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Ah... me duele escuchar... eso de ti."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "¡Pero bueno!"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "¡Es hora de que te vayas!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "¡Nos volveremos a ver!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "¡Ahora sí!"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "¡¡HA LLEGADO EL MOMENTO"}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "DE SACARTE DE LA CONSOLA!!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "¡Adiosito!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Tú serás mi cartucho favorito..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "el jugador con un nombre interesante."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Ese probablemente no es."}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Ese tampoco es el correcto."}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "No, mal."}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Ese no es."}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Debo de encontrar la opción de reiniciar personaje."}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "Esa es la versión incorrecta."}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Oops, error mio."}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Esa no es."}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Debo intentar con otra."}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "No es correcto."}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "Índice equivocado."}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Debo cambiar el índice."}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "Ese no es."}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Oye... ¿tienes hambre?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Resulta que soy muy buena cortando zanahorias, cariño. :)"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "¡Ay! Supongo que..."}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "Preferías estar solito aquí, ¿verdad?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "¿Estamos caminando en círculos?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "¿Por qué regresamos aquí?"}
