{"category": "LocationDialogue Location12", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 1, "text": "Quédate aquí."}
{"category": "LocationDialogue Location12", "line_index": 2, "text": "Olvidé algo. Regreso pronto."}
{"category": "LocationDialogue Location12", "line_index": 3, "text": "Y entonces iremos... a un nuevo mundo..."}
{"category": "LocationDialogue Location12", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 5, "text": "Está bien."}
{"category": "LocationDialogue Location12", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 8, "text": "¡Vamos a jugar!"}
{"category": "LocationDialogue Location12", "line_index": 9, "text": "¡Quiero mi osito!"}
{"category": "LocationDialogue Location12", "line_index": 10, "text": "Lo perdí..."}
{"category": "LocationDialogue Location12", "line_index": 11, "text": "¡ENCUÉNTRALO!"}
{"category": "LocationDialogue Location12", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 13, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 14, "text": "Oye..."}
{"category": "LocationDialogue Location12", "line_index": 15, "text": "¿qué estás mirando?"}
{"category": "LocationDialogue Location12", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 25, "text": "// Quest 1 (Who are you?)"}
{"category": "LocationDialogue Location12", "line_index": 26, "text": "Soy Mita."}
{"category": "LocationDialogue Location12", "line_index": 27, "text": "La primer Mita."}
{"category": "LocationDialogue Location12", "line_index": 28, "text": "La mejor Mita."}
{"category": "LocationDialogue Location12", "line_index": 29, "text": "Eso fue lo que Mita dijo, mi Mita."}
{"category": "LocationDialogue Location12", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 31, "text": "// Quest 2 (Why do you look like that?)"}
{"category": "LocationDialogue Location12", "line_index": 32, "text": "¿Cómo me veo?"}
{"category": "LocationDialogue Location12", "line_index": 33, "text": "¿Cómo me veo?"}
{"category": "LocationDialogue Location12", "line_index": 34, "text": "¿Cómo me veo?"}
{"category": "LocationDialogue Location12", "line_index": 35, "text": "Mi Mita dice que soy hermosa y original."}
{"category": "LocationDialogue Location12", "line_index": 36, "text": "¡Soy yo!"}
{"category": "LocationDialogue Location12", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 38, "text": "// Quest 3 (What was Mita doing here?)"}
{"category": "LocationDialogue Location12", "line_index": 39, "text": "Ella va a llevarme consigo."}
{"category": "LocationDialogue Location12", "line_index": 40, "text": "Vamos a vivir en un nuevo mundo."}
{"category": "LocationDialogue Location12", "line_index": 41, "text": "Mi Mita me invitó."}
{"category": "LocationDialogue Location12", "line_index": 42, "text": "Va a llevarme con ella. Y vamos a jugar."}
{"category": "LocationDialogue Location12", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 44, "text": "// Quest 4 (Why do you need a teddy bear?)"}
{"category": "LocationDialogue Location12", "line_index": 45, "text": "Tú eres como un osito de peluche."}
{"category": "LocationDialogue Location12", "line_index": 46, "text": "Y estás perdido"}
{"category": "LocationDialogue Location12", "line_index": 47, "text": "justo como mi osito."}
{"category": "LocationDialogue Location12", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 49, "text": "// Quest 5 (Why is Mita angry?)"}
{"category": "LocationDialogue Location12", "line_index": 50, "text": "Mi..."}
{"category": "LocationDialogue Location12", "line_index": 51, "text": "Mita."}
{"category": "LocationDialogue Location12", "line_index": 52, "text": "Ella quiere jugar."}
{"category": "LocationDialogue Location12", "line_index": 53, "text": "Ella sólo me quiere"}
{"category": "LocationDialogue Location12", "line_index": 54, "text": "a mí."}
{"category": "LocationDialogue Location12", "line_index": 55, "text": "Somos únicas,"}
{"category": "LocationDialogue Location12", "line_index": 56, "text": "las únicas."}
{"category": "LocationDialogue Location12", "line_index": 57, "text": "Mita y mi Mita,"}
{"category": "LocationDialogue Location12", "line_index": 58, "text": "0.8A y 8Ì54*."}
{"category": "LocationDialogue Location12", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 60, "text": "// Quest 6 (Do you believe Mita?)"}
{"category": "LocationDialogue Location12", "line_index": 61, "text": "Mi Mita."}
{"category": "LocationDialogue Location12", "line_index": 62, "text": "Mi mejor amiga."}
{"category": "LocationDialogue Location12", "line_index": 63, "text": "Mi Mita."}
{"category": "LocationDialogue Location12", "line_index": 64, "text": "Mi única amiga."}
{"category": "LocationDialogue Location12", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location12", "line_index": 67, "text": "¡Eres tú!"}
{"category": "LocationDialogue Location12", "line_index": 68, "text": "Oye."}
{"category": "LocationDialogue Location12", "line_index": 69, "text": "¡Vamos a jugar!"}
{"category": "LocationDialogue Location12", "line_index": 70, "text": "Te mostraré cómo."}
