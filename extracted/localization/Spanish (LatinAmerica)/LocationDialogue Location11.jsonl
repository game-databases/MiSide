{"category": "LocationDialogue Location11", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "¡Hola!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "¡Oops!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Lo siento,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "casi te mato."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Um... quiero decir"}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "el refrigerador casi te mata."}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Yo no tuve que ver con eso."}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "¡Lo juro!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "¡De verdad!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Sí, claro, ¡te creo!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Pero hablando en serio,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "este lugar es peligroso..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "especialmente para tí."}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "Tú sí que eres valiente, ¿eh?"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Es divertido ver"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "cómo te las arreglas"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "en estos lugares..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "¡Corre, querido!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "¡Voy a alcanzarte!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "¡Esfuérzate más!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Jajaja, ¡qué divertido!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Veo que te diriges al teleférico."}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "Es el camino más largo"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "entre versiones..."}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "¿Me pregunto cómo vas"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "a lidiar con aquellos "}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "que habitan en la niebla?"}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "¿Qué haces?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Por favor..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "¡No mires!"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "¡Tonto!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "¡Eres un tonto...!"}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "Ah, muy bien..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "¡Buena suerte!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "¿Quién eres?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Puedo sentirte..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Sé que puedes oírme,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "eres un jugador,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "¿verdad?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Ayúdame a encontrar..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "a encontrar un..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "un..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "no puedo recordar..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "¿Qué está pasando aquí?"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Quise... olvidarlo todo de nuevo..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Rompí todos mis espejos,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "arruiné todas las fotos..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "pero ahora..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "me arrepiento."}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "Fui estúpida..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Sé que todos cometen errores..."}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Pero, ¿qué puedes hacer"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "cuando todo se sale de control?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Ojalá pudiera devolver el tiempo atrás..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Dicen que puede... curarlo todo..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "¿Pero qué es el tiempo?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Yo... yo... ya no creo en nada..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "Pero si el tiempo puede curar,"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "o al menos llevarme con él,"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "lejos de este mundo..."}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "Por favor..."}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "acelera el tiempo."}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "Para que pueda matarme"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "de una vez por todas."}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Ella puede amar..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "¿he amado... yo también... alguna vez?"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Pero mi amor es diferente;"}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "su amor es... realmente vibrante,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "despreciable..."}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "ardiente..."}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "implacable..."}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "envidioso..."}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "furioso..."}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "loco..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Me llamaban emocional..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "Te preocupas demasiado, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "Saldrás adelante, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "No estás sola, Mita..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Eso decían ¿pero qué queda?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Tristeza,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "desesperación..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "y miedo."}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Es inútil..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "no puedo recordar..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "nada en absoluto..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Sólo los ecos interminables..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "No puedo lidiar con el hecho"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "de que estoy atrapada aquí..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Siempre he estado aquí,"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "¿pero por qué?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "No puedo recordar..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "¿Terminará alguna vez?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "No lo sé..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mita get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "¿Esto es un..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "dibujo...?"}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Ahora lo recuerdo,"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "gracias..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Pero mi rostro..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "No tengo rostro..."}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "Es... SU culpa."}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Tomó una parte de mí..."}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "y la tiró..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Ella es fuerte..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "y bastante... astuta."}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "No tengo derecho a detenerte, jugador."}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Mira en el armario..."}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "¡Oye!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "¡Estás en mi camino!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "¿Vas a quedarte ahí parado?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "¡Sólo quítate de en medio!"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "¡Déjame pasar!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "¡Sólo por que seas grande no significa que seas todopoderoso!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "¿¡Por qué me estás siguiendo!?"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "¡Lárgate! "}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - radio voice"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Un momento... ¿eres un jugador?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "¿Qué estás haciendo aquí?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "¿Quién está ahí?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "De verdad eres otro jugador."}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "¡Yo soy Mitáfono!"}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Soy quien controla los teleféricos."}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "¿Si te das cuenta"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "de que te diriges a tu propia perdición?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Tal vez,"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "pero es el único camino que tengo."}
{"category": "LocationDialogue Location11", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Ya veo."}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Presiona el botón y colócate detrás del cañón."}
{"category": "LocationDialogue Location11", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "¿El cañón?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "¡Sí!"}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "¿Creíste que pasarías así de fácil?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Tienes que superar este minijuego de monstruos,"}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "¡así que prepárate para disparar!"}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Bien, en marcha."}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "¡Increíble!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Lo lograste."}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Ahora, sal de aquí."}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "¡Rápido, rápido!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 2"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "¿Por qué sigues aquí?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Te dije que te fueras."}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 3"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "No lo entiendo..."}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "¿por qué sigues ahí parado?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "¿En serio estás jugando?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "¡Vamos...!"}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "¡Vuelve prontoooo!"}
