{"category": "LocationDialogue Location8", "line_index": 0, "text": "// The first meeting"}
{"category": "LocationDialogue Location8", "line_index": 1, "text": "¿Quién eres?"}
{"category": "LocationDialogue Location8", "line_index": 2, "text": "¿Quieres algo?"}
{"category": "LocationDialogue Location8", "line_index": 3, "text": "¿Puedes... hablar?"}
{"category": "LocationDialogue Location8", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 6, "text": "Espera..."}
{"category": "LocationDialogue Location8", "line_index": 7, "text": "¿Quieres irte?"}
{"category": "LocationDialogue Location8", "line_index": 8, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 9, "text": "Sí..."}
{"category": "LocationDialogue Location8", "line_index": 10, "text": "me tengo que ir"}
{"category": "LocationDialogue Location8", "line_index": 11, "text": "a la versión anterior."}
{"category": "LocationDialogue Location8", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 13, "text": "¿La versión anterior?"}
{"category": "LocationDialogue Location8", "line_index": 14, "text": "¿Por qué te vas"}
{"category": "LocationDialogue Location8", "line_index": 15, "text": "a otro lugar?"}
{"category": "LocationDialogue Location8", "line_index": 16, "text": "¿Por qué no te"}
{"category": "LocationDialogue Location8", "line_index": 17, "text": "quedas y te conviertes"}
{"category": "LocationDialogue Location8", "line_index": 18, "text": "en mi segundo amigo?"}
{"category": "LocationDialogue Location8", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 20, "text": "// Skipping all dialogs"}
{"category": "LocationDialogue Location8", "line_index": 21, "text": "Ya veo..."}
{"category": "LocationDialogue Location8", "line_index": 22, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 23, "text": "// Standing by the window (Random)"}
{"category": "LocationDialogue Location8", "line_index": 24, "text": "Las puertas no son las salidas."}
{"category": "LocationDialogue Location8", "line_index": 25, "text": "Parece que tienes prisa..."}
{"category": "LocationDialogue Location8", "line_index": 26, "text": "Correr en círculos no... va a ayudarte."}
{"category": "LocationDialogue Location8", "line_index": 27, "text": "¿Tanto quieres escapar?"}
{"category": "LocationDialogue Location8", "line_index": 28, "text": "Mira las ventanas..."}
{"category": "LocationDialogue Location8", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 30, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 31, "text": "// Quest 1 (Aren't you Mita?)"}
{"category": "LocationDialogue Location8", "line_index": 32, "text": "Jugador... tú eres un jugador ¿verdad?"}
{"category": "LocationDialogue Location8", "line_index": 33, "text": "Podemos jugar juntos."}
{"category": "LocationDialogue Location8", "line_index": 34, "text": "Si puedo... recuperar algo de fuerza,"}
{"category": "LocationDialogue Location8", "line_index": 35, "text": "¿jugarías conmigo?"}
{"category": "LocationDialogue Location8", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 37, "text": "// Quest 2 (What happened to you?)"}
{"category": "LocationDialogue Location8", "line_index": 38, "text": "No estoy segura, de hecho no lo sé..."}
{"category": "LocationDialogue Location8", "line_index": 39, "text": "No creo que algo malo haya pasado..."}
{"category": "LocationDialogue Location8", "line_index": 40, "text": "Pero... parece que todo lo bueno se va..."}
{"category": "LocationDialogue Location8", "line_index": 41, "text": "Al menos aún... me queda un amigo."}
{"category": "LocationDialogue Location8", "line_index": 42, "text": "¿Por qué todos... me abandonan?"}
{"category": "LocationDialogue Location8", "line_index": 43, "text": "¿Es que no soy... suficiente?"}
{"category": "LocationDialogue Location8", "line_index": 44, "text": "Me duele... el corazón."}
{"category": "LocationDialogue Location8", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 46, "text": "// Quest 3 (Become a second friend?)"}
{"category": "LocationDialogue Location8", "line_index": 47, "text": "Amigos..."}
{"category": "LocationDialogue Location8", "line_index": 48, "text": "Tengo muy pocos."}
{"category": "LocationDialogue Location8", "line_index": 49, "text": "Y sólo me queda uno..."}
{"category": "LocationDialogue Location8", "line_index": 50, "text": "Me siento triste, Jugador."}
{"category": "LocationDialogue Location8", "line_index": 51, "text": "¿Quieres ser... mi amigo?"}
{"category": "LocationDialogue Location8", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 53, "text": "Me encantaría,"}
{"category": "LocationDialogue Location8", "line_index": 54, "text": "pero debo seguir avanzando..."}
{"category": "LocationDialogue Location8", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 56, "text": "Mi corazón me duele..."}
{"category": "LocationDialogue Location8", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 58, "text": "// Quest 4 (Is this your house?) - MitaLittle"}
{"category": "LocationDialogue Location8", "line_index": 59, "text": "¿Mi casa?"}
{"category": "LocationDialogue Location8", "line_index": 60, "text": "Jugador... has cambiado..."}
{"category": "LocationDialogue Location8", "line_index": 61, "text": "Tus brazos son más cortos, y no te ves tan enojado..."}
{"category": "LocationDialogue Location8", "line_index": 62, "text": "Jugador, eres más amable, y suave."}
{"category": "LocationDialogue Location8", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 64, "text": "No sé..."}
{"category": "LocationDialogue Location8", "line_index": 65, "text": "de qué me hablas."}
{"category": "LocationDialogue Location8", "line_index": 66, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 67, "text": "Está bien..."}
{"category": "LocationDialogue Location8", "line_index": 68, "text": "porque ya no me va a doler, ¿verdad?"}
{"category": "LocationDialogue Location8", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 70, "text": "// Quest 5 (How do I leave this place?)"}
{"category": "LocationDialogue Location8", "line_index": 71, "text": "Jugador, ¿en serio tú... vas a abandonarme?"}
{"category": "LocationDialogue Location8", "line_index": 72, "text": "¿Es acaso este..."}
{"category": "LocationDialogue Location8", "line_index": 73, "text": "mi destino?"}
{"category": "LocationDialogue Location8", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 75, "text": "Yo..."}
{"category": "LocationDialogue Location8", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 77, "text": "Las puertas no te ayudarán."}
{"category": "LocationDialogue Location8", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location8", "line_index": 79, "text": "// Hold player (Random)"}
{"category": "LocationDialogue Location8", "line_index": 80, "text": "¿Por qué tienes que irte?"}
{"category": "LocationDialogue Location8", "line_index": 81, "text": "No te vayas..."}
{"category": "LocationDialogue Location8", "line_index": 82, "text": "Juega conmigo..."}
{"category": "LocationDialogue Location8", "line_index": 83, "text": "Jugador..."}
