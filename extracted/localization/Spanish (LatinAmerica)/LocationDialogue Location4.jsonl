{"category": "LocationDialogue Location4", "line_index": 0, "text": "¿Mita?"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "Ah, ¿ya despertaste?"}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "¿Cómo llegaste aquí?"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": "Estabas junto a mí hace un momento."}
{"category": "LocationDialogue Location4", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 5, "text": "No,"}
{"category": "LocationDialogue Location4", "line_index": 6, "text": "te congelaste frente al espejo."}
{"category": "LocationDialogue Location4", "line_index": 7, "text": "Así que me fui. "}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "¿Por qué cambiaron los cuartos? "}
{"category": "LocationDialogue Location4", "line_index": 9, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "Reorganicé el lugar "}
{"category": "LocationDialogue Location4", "line_index": 11, "text": "para hacerte sentir como en casa."}
{"category": "LocationDialogue Location4", "line_index": 12, "text": "Aquí,"}
{"category": "LocationDialogue Location4", "line_index": 13, "text": "podemos cambiar los cuartos"}
{"category": "LocationDialogue Location4", "line_index": 14, "text": "como queramos."}
{"category": "LocationDialogue Location4", "line_index": 15, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 16, "text": "No te hubieras molestado."}
{"category": "LocationDialogue Location4", "line_index": 17, "text": "Me estaba acostumbrando al diseño."}
{"category": "LocationDialogue Location4", "line_index": 18, "text": "De cualquier manera, creo que te sentirás más cómodo así."}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Mita card game"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "Bien,"}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "¿jugamos?"}
{"category": "LocationDialogue Location4", "line_index": 22, "text": "El juego funciona así: "}
{"category": "LocationDialogue Location4", "line_index": 23, "text": "La ficha indica un atributo,"}
{"category": "LocationDialogue Location4", "line_index": 24, "text": "por ejemplo, salud: "}
{"category": "LocationDialogue Location4", "line_index": 25, "text": "Cada uno juega una carta,"}
{"category": "LocationDialogue Location4", "line_index": 26, "text": "y si tu carta tiene un nivel más alto"}
{"category": "LocationDialogue Location4", "line_index": 27, "text": "de salud"}
{"category": "LocationDialogue Location4", "line_index": 28, "text": "que la mía,"}
{"category": "LocationDialogue Location4", "line_index": 29, "text": "tú ganas."}
{"category": "LocationDialogue Location4", "line_index": 30, "text": "Toma tus cartas."}
{"category": "LocationDialogue Location4", "line_index": 31, "text": "Es mi turno."}
{"category": "LocationDialogue Location4", "line_index": 32, "text": "¡Wow!"}
{"category": "LocationDialogue Location4", "line_index": 33, "text": "¡Tengo muy buenas cartas!"}
{"category": "LocationDialogue Location4", "line_index": 34, "text": "¡Iré primero!"}
{"category": "LocationDialogue Location4", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 44, "text": "¡Bien!"}
{"category": "LocationDialogue Location4", "line_index": 45, "text": "¡Tu turno!"}
{"category": "LocationDialogue Location4", "line_index": 46, "text": "Uh-huh."}
{"category": "LocationDialogue Location4", "line_index": 47, "text": "¡Tu turno!"}
{"category": "LocationDialogue Location4", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 49, "text": "¡Gana quien tenga más salud!"}
{"category": "LocationDialogue Location4", "line_index": 50, "text": "¡Es hora del ataque!"}
{"category": "LocationDialogue Location4", "line_index": 51, "text": "¡Enfócate en la defensa!"}
{"category": "LocationDialogue Location4", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 54, "text": "Muy bien, ¡tú ganas!"}
{"category": "LocationDialogue Location4", "line_index": 55, "text": "¡Ganaste!"}
{"category": "LocationDialogue Location4", "line_index": 56, "text": "Me ganaste."}
{"category": "LocationDialogue Location4", "line_index": 57, "text": "Ay tú..."}
{"category": "LocationDialogue Location4", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 59, "text": "¡Yo gano!"}
{"category": "LocationDialogue Location4", "line_index": 60, "text": "¡Soy la ganadora!"}
{"category": "LocationDialogue Location4", "line_index": 61, "text": "¡Yo gano esta vez!"}
{"category": "LocationDialogue Location4", "line_index": 62, "text": "¡Ajá, te tengo!"}
{"category": "LocationDialogue Location4", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 64, "text": "Es un empate."}
{"category": "LocationDialogue Location4", "line_index": 65, "text": "¡Seguimos igual!"}
{"category": "LocationDialogue Location4", "line_index": 66, "text": "¡Empatamos!"}
{"category": "LocationDialogue Location4", "line_index": 67, "text": "Sacamos lo mismo..."}
{"category": "LocationDialogue Location4", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 79, "text": "// The card game is interrupted"}
{"category": "LocationDialogue Location4", "line_index": 80, "text": "¿Qué es ese sonido?"}
{"category": "LocationDialogue Location4", "line_index": 81, "text": "Viene del armario."}
{"category": "LocationDialogue Location4", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 83, "text": "¿Sonido?"}
{"category": "LocationDialogue Location4", "line_index": 84, "text": "¿Qué sonido?"}
{"category": "LocationDialogue Location4", "line_index": 85, "text": "Yo no escuché nada."}
{"category": "LocationDialogue Location4", "line_index": 86, "text": "¿Qué es lo que escuchaste?"}
{"category": "LocationDialogue Location4", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 88, "text": "Golpes, como si alguien estuviese ahí."}
{"category": "LocationDialogue Location4", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 90, "text": "Pero es que..."}
{"category": "LocationDialogue Location4", "line_index": 91, "text": "no hay nadie ahí..."}
{"category": "LocationDialogue Location4", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 93, "text": "Me gustaría ir a revisar."}
{"category": "LocationDialogue Location4", "line_index": 94, "text": "Me tiene un poco asustado."}
{"category": "LocationDialogue Location4", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 96, "text": "¿Pero por qué...?"}
{"category": "LocationDialogue Location4", "line_index": 97, "text": "Otra vez..."}
{"category": "LocationDialogue Location4", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 105, "text": "¡¿Qué pasa contigo?!"}
{"category": "LocationDialogue Location4", "line_index": 106, "text": "Es mi armario..."}
{"category": "LocationDialogue Location4", "line_index": 107, "text": "Sólo hay ropa interior..."}
{"category": "LocationDialogue Location4", "line_index": 108, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 109, "text": "¿Me estás escondiendo algo?"}
{"category": "LocationDialogue Location4", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 111, "text": "¿Por qué no me crees y listo?"}
{"category": "LocationDialogue Location4", "line_index": 112, "text": "¿Qué estoy haciendo mal?"}
{"category": "LocationDialogue Location4", "line_index": 113, "text": "Lo que quiero..."}
{"category": "LocationDialogue Location4", "line_index": 114, "text": "lo único que quiero... es que estés conmigo."}
{"category": "LocationDialogue Location4", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 116, "text": "También me gustaría, pero aún así..."}
{"category": "LocationDialogue Location4", "line_index": 117, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 118, "text": "¡¿Por qué estás tan enfocado en el armario?!"}
{"category": "LocationDialogue Location4", "line_index": 119, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 120, "text": "¡Sólo quiero saber qué es ese sonido!"}
{"category": "LocationDialogue Location4", "line_index": 121, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 122, "text": "Es porque"}
{"category": "LocationDialogue Location4", "line_index": 123, "text": "este mundo"}
{"category": "LocationDialogue Location4", "line_index": 124, "text": "¿sólo tiene estos cuatro cuartos?"}
{"category": "LocationDialogue Location4", "line_index": 125, "text": "¿No es suficiente para ti?"}
{"category": "LocationDialogue Location4", "line_index": 126, "text": "Por favor... ¿puedes quedarte conmigo?"}
{"category": "LocationDialogue Location4", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 129, "text": "// Don't stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 130, "text": "Lo entiendo."}
{"category": "LocationDialogue Location4", "line_index": 131, "text": "Esto otra vez..."}
{"category": "LocationDialogue Location4", "line_index": 132, "text": "Si tanto quieres revisar el armario,"}
{"category": "LocationDialogue Location4", "line_index": 133, "text": "entonces hazlo,"}
{"category": "LocationDialogue Location4", "line_index": 134, "text": "¡descubre que hay dentro!"}
{"category": "LocationDialogue Location4", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 139, "text": "¿Pero qué...?"}
{"category": "LocationDialogue Location4", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 141, "text": "Eso pasa a veces."}
{"category": "LocationDialogue Location4", "line_index": 142, "text": "El cuarto no tuvo mucho tiempo para cargar."}
{"category": "LocationDialogue Location4", "line_index": 143, "text": "Espera un momento."}
{"category": "LocationDialogue Location4", "line_index": 144, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 145, "text": "Esto es muy raro."}
{"category": "LocationDialogue Location4", "line_index": 146, "text": "¿Estamos dentro de un teléfono?"}
{"category": "LocationDialogue Location4", "line_index": 147, "text": "Quizás uno muy lento."}
{"category": "LocationDialogue Location4", "line_index": 148, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 149, "text": "Para nada."}
{"category": "LocationDialogue Location4", "line_index": 150, "text": "Es sólo,"}
{"category": "LocationDialogue Location4", "line_index": 151, "text": "que este mundo no es perfecto..."}
{"category": "LocationDialogue Location4", "line_index": 152, "text": "Estamos siendo cargados"}
{"category": "LocationDialogue Location4", "line_index": 153, "text": "con el núcleo del mundo."}
{"category": "LocationDialogue Location4", "line_index": 154, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 155, "text": "¿El núcleo del mundo?"}
{"category": "LocationDialogue Location4", "line_index": 156, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 157, "text": "Típico, ¿no?"}
{"category": "LocationDialogue Location4", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 159, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 160, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 161, "text": "¡Cierto! Podemos jugar un videojuego"}
{"category": "LocationDialogue Location4", "line_index": 162, "text": "en la consola"}
{"category": "LocationDialogue Location4", "line_index": 163, "text": "o sólo jugar a las cartas."}
{"category": "LocationDialogue Location4", "line_index": 164, "text": "Elige tú."}
{"category": "LocationDialogue Location4", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 167, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 168, "text": "// Mita play fight"}
{"category": "LocationDialogue Location4", "line_index": 169, "text": "¿Quieres pelear?"}
{"category": "LocationDialogue Location4", "line_index": 170, "text": "Tienes que ganar "}
{"category": "LocationDialogue Location4", "line_index": 171, "text": "cuatro veces."}
{"category": "LocationDialogue Location4", "line_index": 172, "text": "¡Vamos!"}
{"category": "LocationDialogue Location4", "line_index": 173, "text": "No te preocupes,"}
{"category": "LocationDialogue Location4", "line_index": 174, "text": "te lo pondré fácil de momento."}
{"category": "LocationDialogue Location4", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 176, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 177, "text": "Peleas bien."}
{"category": "LocationDialogue Location4", "line_index": 178, "text": "¡Pero no te confíes!"}
{"category": "LocationDialogue Location4", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 180, "text": "¡Wow!"}
{"category": "LocationDialogue Location4", "line_index": 181, "text": "Bien, muy bien."}
{"category": "LocationDialogue Location4", "line_index": 182, "text": "Voy a ponerme seria."}
{"category": "LocationDialogue Location4", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 184, "text": "¡Genial!"}
{"category": "LocationDialogue Location4", "line_index": 185, "text": "¡Veamos si puedes "}
{"category": "LocationDialogue Location4", "line_index": 186, "text": "vencerme ahora!"}
{"category": "LocationDialogue Location4", "line_index": 187, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 188, "text": "Eres"}
{"category": "LocationDialogue Location4", "line_index": 189, "text": "bastante"}
{"category": "LocationDialogue Location4", "line_index": 190, "text": "¡increíble! ¡tienes mucho talento!"}
{"category": "LocationDialogue Location4", "line_index": 191, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 193, "text": "¿Qué te pasa?"}
{"category": "LocationDialogue Location4", "line_index": 194, "text": "Vamos, muévete."}
{"category": "LocationDialogue Location4", "line_index": 195, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 196, "text": "Bueno,"}
{"category": "LocationDialogue Location4", "line_index": 197, "text": "eso fue todo. Hasta aquí llegaste por cierto."}
{"category": "LocationDialogue Location4", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 199, "text": "Vamos,"}
{"category": "LocationDialogue Location4", "line_index": 200, "text": "¡ve en serio o serás un perdedor por siempre!"}
{"category": "LocationDialogue Location4", "line_index": 201, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 202, "text": "¿Qué te pasó?"}
{"category": "LocationDialogue Location4", "line_index": 203, "text": "Me la dejaste muy fácil."}
{"category": "LocationDialogue Location4", "line_index": 204, "text": "No diste todo lo que tenías"}
{"category": "LocationDialogue Location4", "line_index": 205, "text": "¡por eso fue que te gané!"}
{"category": "LocationDialogue Location4", "line_index": 206, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 208, "text": "Bien, ahora."}
{"category": "LocationDialogue Location4", "line_index": 209, "text": "¿Jugamos a las cartas?"}
{"category": "LocationDialogue Location4", "line_index": 210, "text": "Están en el dormitorio."}
{"category": "LocationDialogue Location4", "line_index": 211, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 214, "text": "// Door > [ERROR]"}
{"category": "LocationDialogue Location4", "line_index": 215, "text": "Eh, ¿qué pasó?"}
{"category": "LocationDialogue Location4", "line_index": 216, "text": "¿Dónde está...?"}
{"category": "LocationDialogue Location4", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 218, "text": "Oh."}
{"category": "LocationDialogue Location4", "line_index": 219, "text": "Lo siento..."}
{"category": "LocationDialogue Location4", "line_index": 220, "text": "Descargué algo"}
{"category": "LocationDialogue Location4", "line_index": 221, "text": "de internet."}
{"category": "LocationDialogue Location4", "line_index": 222, "text": "Quería que afuera"}
{"category": "LocationDialogue Location4", "line_index": 223, "text": "estuviera hermoso."}
{"category": "LocationDialogue Location4", "line_index": 224, "text": "Pero resulta"}
{"category": "LocationDialogue Location4", "line_index": 225, "text": "que había algo mal con el archivo."}
{"category": "LocationDialogue Location4", "line_index": 226, "text": "Lo arreglaré después."}
{"category": "LocationDialogue Location4", "line_index": 227, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 228, "text": "¿Es... por eso que no podemos dejar la casa?"}
{"category": "LocationDialogue Location4", "line_index": 229, "text": "Sí, es por eso."}
{"category": "LocationDialogue Location4", "line_index": 230, "text": "// Mita shy"}
{"category": "LocationDialogue Location4", "line_index": 231, "text": "Oye..."}
{"category": "LocationDialogue Location4", "line_index": 232, "text": "¿Qué pasa contigo?"}
{"category": "LocationDialogue Location4", "line_index": 233, "text": "¿Quieres algo?"}
{"category": "LocationDialogue Location4", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 236, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 237, "text": "// Wall Clock"}
{"category": "LocationDialogue Location4", "line_index": 238, "text": "Este reloj de aquí,"}
{"category": "LocationDialogue Location4", "line_index": 239, "text": "¿qué hora está mostrando?"}
{"category": "LocationDialogue Location4", "line_index": 240, "text": "¿El tiempo dentro del juego..."}
{"category": "LocationDialogue Location4", "line_index": 241, "text": "o está sincronizado con mi teléfono?"}
{"category": "LocationDialogue Location4", "line_index": 242, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 243, "text": "Bueno, um..."}
{"category": "LocationDialogue Location4", "line_index": 244, "text": "La verdad no lo sé."}
{"category": "LocationDialogue Location4", "line_index": 245, "text": "Pero el tiempo no importa aquí..."}
{"category": "LocationDialogue Location4", "line_index": 246, "text": "Sin importar si es temprano o tarde,"}
{"category": "LocationDialogue Location4", "line_index": 247, "text": "una chica fuerte como yo"}
{"category": "LocationDialogue Location4", "line_index": 248, "text": "está siempre llena de energía."}
{"category": "LocationDialogue Location4", "line_index": 249, "text": "¡Nunca me canso!"}
{"category": "LocationDialogue Location4", "line_index": 250, "text": "Podemos tener una eterna primavera,"}
{"category": "LocationDialogue Location4", "line_index": 251, "text": "¡o una tarde interminable!"}
{"category": "LocationDialogue Location4", "line_index": 252, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 253, "text": "Eso es interesante..."}
{"category": "LocationDialogue Location4", "line_index": 254, "text": "y a la vez da algo de miedo..."}
{"category": "LocationDialogue Location4", "line_index": 255, "text": "Estar atrapado en el mismo momento, por siempre..."}
{"category": "LocationDialogue Location4", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 258, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 259, "text": "// Photos of Mita"}
{"category": "LocationDialogue Location4", "line_index": 260, "text": "Lindas fotos."}
{"category": "LocationDialogue Location4", "line_index": 261, "text": "Supongo que son tuyas."}
{"category": "LocationDialogue Location4", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 263, "text": "Sip."}
{"category": "LocationDialogue Location4", "line_index": 264, "text": "También me gustan."}
{"category": "LocationDialogue Location4", "line_index": 265, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 266, "text": "¿Quién las tomó?"}
{"category": "LocationDialogue Location4", "line_index": 267, "text": "¿Hay más gente en este mundo?"}
{"category": "LocationDialogue Location4", "line_index": 268, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 269, "text": "Digamos que sí."}
{"category": "LocationDialogue Location4", "line_index": 270, "text": "Luego los conocerás."}
{"category": "LocationDialogue Location4", "line_index": 271, "text": "Sólo que aún no, por ahora... sólo quiero estar..."}
{"category": "LocationDialogue Location4", "line_index": 272, "text": "contigo a solas."}
{"category": "LocationDialogue Location4", "line_index": 273, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 275, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 276, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 277, "text": "// Portal"}
{"category": "LocationDialogue Location4", "line_index": 278, "text": "¿A dónde se fue el portal?"}
{"category": "LocationDialogue Location4", "line_index": 279, "text": "O como sea que lo llamaste antes..."}
{"category": "LocationDialogue Location4", "line_index": 280, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 281, "text": "Usé un..."}
{"category": "LocationDialogue Location4", "line_index": 282, "text": "truco de magia"}
{"category": "LocationDialogue Location4", "line_index": 283, "text": "y lo moví"}
{"category": "LocationDialogue Location4", "line_index": 284, "text": "a otro lugar."}
{"category": "LocationDialogue Location4", "line_index": 285, "text": "Ya no lo necesitamos."}
{"category": "LocationDialogue Location4", "line_index": 286, "text": "Sólo nos estorbaría."}
{"category": "LocationDialogue Location4", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 288, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 289, "text": "// Mirror in the bedroom"}
{"category": "LocationDialogue Location4", "line_index": 290, "text": "Mirar un espejo"}
{"category": "LocationDialogue Location4", "line_index": 291, "text": "sin ver un reflejo da miedo."}
{"category": "LocationDialogue Location4", "line_index": 292, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 293, "text": "Podría activarlos"}
{"category": "LocationDialogue Location4", "line_index": 294, "text": "si de verdad lo quieres."}
{"category": "LocationDialogue Location4", "line_index": 295, "text": "¿Qué prefieres?"}
{"category": "LocationDialogue Location4", "line_index": 296, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 297, "text": "Pues claro,"}
{"category": "LocationDialogue Location4", "line_index": 298, "text": "o activarlos... ¿trae consecuencias?"}
{"category": "LocationDialogue Location4", "line_index": 299, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 300, "text": "Sí."}
{"category": "LocationDialogue Location4", "line_index": 301, "text": "Nos moveríamos más lento y entrecortados."}
{"category": "LocationDialogue Location4", "line_index": 302, "text": "¿Has visto una caricatura con bajos fotogramas?"}
{"category": "LocationDialogue Location4", "line_index": 303, "text": "Sería algo así para nosotros."}
{"category": "LocationDialogue Location4", "line_index": 304, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 305, "text": "Entiendo."}
{"category": "LocationDialogue Location4", "line_index": 306, "text": "Entonces es mejor tenerlos apagados..."}
{"category": "LocationDialogue Location4", "line_index": 307, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 308, "text": "Oye, [player],"}
{"category": "LocationDialogue Location4", "line_index": 309, "text": "te gustan los reflejos, ¿no?"}
{"category": "LocationDialogue Location4", "line_index": 310, "text": "¿Tienes miedo de ver una sonrisa en esa cara tuya?"}
{"category": "LocationDialogue Location4", "line_index": 311, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 312, "text": "¿Eh? No realmente..."}
{"category": "LocationDialogue Location4", "line_index": 313, "text": "Sólo estoy cansado"}
{"category": "LocationDialogue Location4", "line_index": 314, "text": "después de todo el trabajo."}
{"category": "LocationDialogue Location4", "line_index": 315, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 316, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 317, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 318, "text": "// Blue sneakers"}
{"category": "LocationDialogue Location4", "line_index": 319, "text": "¿Son tuyos?"}
{"category": "LocationDialogue Location4", "line_index": 320, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 321, "text": "No, son tuyos."}
{"category": "LocationDialogue Location4", "line_index": 322, "text": "¿No lo recuerdas?"}
{"category": "LocationDialogue Location4", "line_index": 323, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 324, "text": "No recuerdo tener zapatos como esos."}
{"category": "LocationDialogue Location4", "line_index": 325, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 326, "text": "Ahora los tienes."}
{"category": "LocationDialogue Location4", "line_index": 327, "text": "Puedes ponértelos,"}
{"category": "LocationDialogue Location4", "line_index": 328, "text": "cuando salgamos."}
{"category": "LocationDialogue Location4", "line_index": 329, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 330, "text": "¿Qué hay sobre la ropa?"}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "Todo lo que tengo en este mundo"}
{"category": "LocationDialogue Location4", "line_index": 332, "text": "son las prendas que estoy vistiendo."}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "¿Hay alguna manera de conseguir nuevas?"}
{"category": "LocationDialogue Location4", "line_index": 334, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 335, "text": "Claro que sí."}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "Aunque, he visto lo que llevas puesto"}
{"category": "LocationDialogue Location4", "line_index": 337, "text": "y la verdad, no tienes buen gusto."}
{"category": "LocationDialogue Location4", "line_index": 338, "text": "De todas formas, te ayudaré a conseguir algo."}
{"category": "LocationDialogue Location4", "line_index": 339, "text": "Sólo que no ahora."}
{"category": "LocationDialogue Location4", "line_index": 340, "text": "Es una promesa."}
{"category": "LocationDialogue Location4", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 342, "text": "Está bien."}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Games on TV"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "¿Qué quieres jugar?"}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Game milk"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "¡Este es un juego de lucha!"}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "¡A ver quién se amarga primero!"}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "¡Qué buen juego!"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": "Ya hemos tenido suficiente leche por hoy, hagamos otra cosa."}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Game penguins"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "En este juego, eres un pingüino,"}
{"category": "LocationDialogue Location4", "line_index": 354, "text": "deslizándote por ahí."}
{"category": "LocationDialogue Location4", "line_index": 355, "text": "Sí, ese es el juego."}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Stay with Mita"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "Espera, ¿qué?"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "¿Lo dices en serio? Yo pensaba que..."}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "¡Estoy muy feliz!"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "Y un poco confundida..."}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "Pero..."}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "Por favor, quédate conmigo"}
{"category": "LocationDialogue Location4", "line_index": 364, "text": "por y para siempre."}
{"category": "LocationDialogue Location4", "line_index": 365, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 367, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 368, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 369, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 370, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 372, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 373, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 374, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 375, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 376, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 377, "text": "// A game about penguins"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "Es súper simple:"}
{"category": "LocationDialogue Location4", "line_index": 379, "text": "sólo recoge bolas de nieve."}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "Quien recoja más, ¡gana!"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "Juguemos dos rondas, ¿bien?"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// The first map"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "Wow, ¿cómo conseguiste tantas?"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "¡Jiji! ¡tengo más bolas de nieve!"}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "¡Más te vale remontar!"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "¡Ja, 1 a 1!"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// The second map"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "¡Eres todo un pingüino!"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "Creo que... deberías romper el hielo..."}
{"category": "LocationDialogue Location4", "line_index": 390, "text": "Ah, eres tan lento."}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "¿Aún piensas en ganar?"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "Wow, ¡un empate! ¡eso sí que es raro!"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// The game is over"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "¿Quieres jugar algo más?"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "¿O ya tuviste suficiente?"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "¿Para qué necesitas eso?"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "¿Tan bueno eres jugando?"}
