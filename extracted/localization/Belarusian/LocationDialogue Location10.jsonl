{"category": "LocationDialogue Location10", "line_index": 0, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 1, "text": "Стой-стой!"}
{"category": "LocationDialogue Location10", "line_index": 2, "text": "Толькі размаўляй цішэй"}
{"category": "LocationDialogue Location10", "line_index": 3, "text": "Далей ісці небяспечна"}
{"category": "LocationDialogue Location10", "line_index": 4, "text": "І наогул..."}
{"category": "LocationDialogue Location10", "line_index": 5, "text": "Ты як тут апынуўся?"}
{"category": "LocationDialogue Location10", "line_index": 6, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 7, "text": "Эм..."}
{"category": "LocationDialogue Location10", "line_index": 8, "text": "Пярсцёнак адчыняе патрэбныя мне дзверы,"}
{"category": "LocationDialogue Location10", "line_index": 9, "text": "Я дакладна не ведаю, як гэта працуе..."}
{"category": "LocationDialogue Location10", "line_index": 10, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 11, "text": "Пярсцёнак?"}
{"category": "LocationDialogue Location10", "line_index": 12, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 13, "text": "Што з гэтым месцам?"}
{"category": "LocationDialogue Location10", "line_index": 14, "text": "Чаму тут так цёмна?"}
{"category": "LocationDialogue Location10", "line_index": 15, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 16, "text": "Я пазней табе раскажу"}
{"category": "LocationDialogue Location10", "line_index": 17, "text": "Ідзі да выхаду"}
{"category": "LocationDialogue Location10", "line_index": 18, "text": "Сустрэнеш мяне ў гульнявым аўтамаце"}
{"category": "LocationDialogue Location10", "line_index": 19, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 20, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 21, "text": "// MitaShorthairs (Паказвае, куды ісці)"}
{"category": "LocationDialogue Location10", "line_index": 22, "text": "Ідзі-ідзі, не затрымлівайся!"}
{"category": "LocationDialogue Location10", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 24, "text": "// After mini-game"}
{"category": "LocationDialogue Location10", "line_index": 25, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 26, "text": "Ну што, ты зразумеў сэнс гэтай гульні?"}
{"category": "LocationDialogue Location10", "line_index": 27, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 28, "text": "За маёй скурай косткі, а за вашай — манекен?"}
{"category": "LocationDialogue Location10", "line_index": 29, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 30, "text": "Ого!"}
{"category": "LocationDialogue Location10", "line_index": 31, "text": "Страхотна..."}
{"category": "LocationDialogue Location10", "line_index": 32, "text": "Баюся, гэта дакладна так!"}
{"category": "LocationDialogue Location10", "line_index": 33, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 34, "text": "Зразумеў, але навошта мне гэтая інфармацыя?"}
{"category": "LocationDialogue Location10", "line_index": 35, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 36, "text": "Думаеш, я табе проста так сказала,"}
{"category": "LocationDialogue Location10", "line_index": 37, "text": "Што ісці далей — небяспечна?"}
{"category": "LocationDialogue Location10", "line_index": 38, "text": "Там ты сустрэнеш гэтых манекенаў..."}
{"category": "LocationDialogue Location10", "line_index": 39, "text": "Тых, якіх адкінулі, якія \"не ўдаліся\"."}
{"category": "LocationDialogue Location10", "line_index": 40, "text": "Яны яшчэ больш — а яно табе трэба?"}
{"category": "LocationDialogue Location10", "line_index": 41, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 42, "text": "А што мне рабіць?"}
{"category": "LocationDialogue Location10", "line_index": 43, "text": "Куды адкрыюцца дзверы,"}
{"category": "LocationDialogue Location10", "line_index": 44, "text": "Туды і пайду"}
{"category": "LocationDialogue Location10", "line_index": 45, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 46, "text": "Ну ты даеш!"}
{"category": "LocationDialogue Location10", "line_index": 47, "text": "Тады не паварочвайся да іх спінай"}
{"category": "LocationDialogue Location10", "line_index": 48, "text": "І май іх на воку!"}
{"category": "LocationDialogue Location10", "line_index": 49, "text": "Яны саромеюцца, калі глядзіш на іх,"}
{"category": "LocationDialogue Location10", "line_index": 50, "text": "Настолькі, што дранцвеюць"}
{"category": "LocationDialogue Location10", "line_index": 51, "text": "Думаю, гэта дапаможа!"}
{"category": "LocationDialogue Location10", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 59, "text": "// quest 1 - MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 60, "text": "Яны толькі атрымалі скіны"}
{"category": "LocationDialogue Location10", "line_index": 61, "text": "Цяпер ім трэба час,"}
{"category": "LocationDialogue Location10", "line_index": 62, "text": "Каб крыху асвядоміцца"}
{"category": "LocationDialogue Location10", "line_index": 63, "text": "Потым мне трэба адвесці кожную"}
{"category": "LocationDialogue Location10", "line_index": 64, "text": "У яе ўласны дом"}
{"category": "LocationDialogue Location10", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 66, "text": "// quest 2 - MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 67, "text": "Міты ў прынцыпе \"нараджаюцца\" ў цемры"}
{"category": "LocationDialogue Location10", "line_index": 68, "text": "Таму спачатку ім трэба яшчэ крыху пастаяць у цемры..."}
{"category": "LocationDialogue Location10", "line_index": 69, "text": "Уяўляеш,"}
{"category": "LocationDialogue Location10", "line_index": 70, "text": "Як ім балюча адразу выходзіць на святло?"}
{"category": "LocationDialogue Location10", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 72, "text": "// quest 3 - MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 73, "text": "А ты яшчэ не зразумеў?"}
{"category": "LocationDialogue Location10", "line_index": 74, "text": "Я дапамагаю бядачкам Мітам асвойтацца!"}
{"category": "LocationDialogue Location10", "line_index": 75, "text": "Хто ім дапаможа, калі не я!"}
{"category": "LocationDialogue Location10", "line_index": 76, "text": "Ты штось?"}
{"category": "LocationDialogue Location10", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 78, "text": "// quest 4 - Player"}
{"category": "LocationDialogue Location10", "line_index": 79, "text": "Навошта гэты канвеер?"}
{"category": "LocationDialogue Location10", "line_index": 80, "text": "Хіба на ўсіх стане месца?"}
{"category": "LocationDialogue Location10", "line_index": 81, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 82, "text": "Пачакай, а ты хоць разумееш,"}
{"category": "LocationDialogue Location10", "line_index": 83, "text": "Які парадак у нашым свеце?"}
{"category": "LocationDialogue Location10", "line_index": 84, "text": "І тое, што ён бясконцы?"}
{"category": "LocationDialogue Location10", "line_index": 85, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 86, "text": "Бясконцы?"}
{"category": "LocationDialogue Location10", "line_index": 87, "text": "Хм-м..."}
{"category": "LocationDialogue Location10", "line_index": 88, "text": "Але як?"}
{"category": "LocationDialogue Location10", "line_index": 89, "text": "Калі апошняя версія 1.9"}
{"category": "LocationDialogue Location10", "line_index": 90, "text": "Значыць, і светаў усяго 19 штук"}
{"category": "LocationDialogue Location10", "line_index": 91, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 92, "text": "Цю! Здаецца, ты зусім"}
{"category": "LocationDialogue Location10", "line_index": 93, "text": "Няправільна ўяўляеш гэты свет"}
{"category": "LocationDialogue Location10", "line_index": 94, "text": "Я магу табе на гэтай школьнай дошцы"}
{"category": "LocationDialogue Location10", "line_index": 95, "text": "Усё расказаць"}
{"category": "LocationDialogue Location10", "line_index": 96, "text": "Хочаш?"}
{"category": "LocationDialogue Location10", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 98, "text": "// quest 5 - Player"}
{"category": "LocationDialogue Location10", "line_index": 99, "text": "Думаецца,"}
{"category": "LocationDialogue Location10", "line_index": 100, "text": "Я цябе сустракаў у найноўшых версіях"}
{"category": "LocationDialogue Location10", "line_index": 101, "text": "Ці мне падалося..."}
{"category": "LocationDialogue Location10", "line_index": 102, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 103, "text": "Магчыма!"}
{"category": "LocationDialogue Location10", "line_index": 104, "text": "Мая версія — 1.5"}
{"category": "LocationDialogue Location10", "line_index": 105, "text": "Быў там?"}
{"category": "LocationDialogue Location10", "line_index": 106, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 107, "text": "Так"}
{"category": "LocationDialogue Location10", "line_index": 108, "text": "У першы раз, калі я сюды трапіў,"}
{"category": "LocationDialogue Location10", "line_index": 109, "text": "Я апынуўся там!"}
{"category": "LocationDialogue Location10", "line_index": 110, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 111, "text": "Ого!"}
{"category": "LocationDialogue Location10", "line_index": 112, "text": "Як так..."}
{"category": "LocationDialogue Location10", "line_index": 113, "text": "Цікава, у які індэкс дома ты трапіў..."}
{"category": "LocationDialogue Location10", "line_index": 114, "text": "Існуе я, якая любіць вечна ныць"}
{"category": "LocationDialogue Location10", "line_index": 115, "text": "Таксама існуе я, якая любіць заўжды гуляць"}
{"category": "LocationDialogue Location10", "line_index": 116, "text": "І існуе я, якая вечна забываецца і запужвае"}
{"category": "LocationDialogue Location10", "line_index": 117, "text": "Вой, пералічваць можна доўга..."}
{"category": "LocationDialogue Location10", "line_index": 118, "text": "Памятаеш што-небудзь?"}
{"category": "LocationDialogue Location10", "line_index": 119, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 120, "text": "Было цёмна"}
{"category": "LocationDialogue Location10", "line_index": 121, "text": "І надпісы!"}
{"category": "LocationDialogue Location10", "line_index": 122, "text": "Нешта накшталт"}
{"category": "LocationDialogue Location10", "line_index": 123, "text": "\"Давай гуляць\""}
{"category": "LocationDialogue Location10", "line_index": 124, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 125, "text": "Вой..."}
{"category": "LocationDialogue Location10", "line_index": 126, "text": "Сарамата!"}
{"category": "LocationDialogue Location10", "line_index": 127, "text": "Гэта ўсё-ткі тая,"}
{"category": "LocationDialogue Location10", "line_index": 128, "text": "Каторая запужвае і забываецца"}
{"category": "LocationDialogue Location10", "line_index": 129, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 130, "text": "// MSHairs wants to tell you [No] - Player"}
{"category": "LocationDialogue Location10", "line_index": 131, "text": "Не трэ"}
{"category": "LocationDialogue Location10", "line_index": 132, "text": "Як-небудзь і без гэтага абыдуся"}
{"category": "LocationDialogue Location10", "line_index": 133, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 134, "text": "Хм, акей"}
{"category": "LocationDialogue Location10", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 136, "text": "// MSHairs wants to tell you [Yes] - Player"}
{"category": "LocationDialogue Location10", "line_index": 137, "text": "Добра, расказвай"}
{"category": "LocationDialogue Location10", "line_index": 138, "text": "Спадзяюся, гэта не будзе як у школе"}
{"category": "LocationDialogue Location10", "line_index": 139, "text": "І я не засну з нудоты"}
{"category": "LocationDialogue Location10", "line_index": 140, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 141, "text": "Ты калі хочаш — ідзі"}
{"category": "LocationDialogue Location10", "line_index": 142, "text": "А калі табе цікава,"}
{"category": "LocationDialogue Location10", "line_index": 143, "text": "То слухай"}
{"category": "LocationDialogue Location10", "line_index": 144, "text": "Гулец спампаваў MiSide на тэлефон // She went to the blackboard"}
{"category": "LocationDialogue Location10", "line_index": 145, "text": "Сядзіць задаволены і гуляе"}
{"category": "LocationDialogue Location10", "line_index": 146, "text": "Такім чынам ён стварыў новы дом"}
{"category": "LocationDialogue Location10", "line_index": 147, "text": "І новую Міту. // Points to the board"}
{"category": "LocationDialogue Location10", "line_index": 148, "text": "Тут у нас двухмерны фармат"}
{"category": "LocationDialogue Location10", "line_index": 149, "text": "Вось версіі, // Points to versions"}
{"category": "LocationDialogue Location10", "line_index": 150, "text": "Яны пазначаныя лініямі. // Points to lines"}
{"category": "LocationDialogue Location10", "line_index": 151, "text": "На гэтых лініях стаяць домікі. // Points to circles"}
{"category": "LocationDialogue Location10", "line_index": 152, "text": "То-бок, спампаваў гульню з версіяй 1.14 —"}
{"category": "LocationDialogue Location10", "line_index": 153, "text": "Значыць на гэтай версіі з'яўлецца"}
{"category": "LocationDialogue Location10", "line_index": 154, "text": "Новае жыццё, Міта і яе дамок"}
{"category": "LocationDialogue Location10", "line_index": 155, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 156, "text": "Нішто сабе..."}
{"category": "LocationDialogue Location10", "line_index": 157, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 158, "text": "Можаш спытаць пра канкрэтныя рэчы,"}
{"category": "LocationDialogue Location10", "line_index": 159, "text": "Якія тут нарысаваныя"}
{"category": "LocationDialogue Location10", "line_index": 160, "text": "Спрабую патлумачыць"}
{"category": "LocationDialogue Location10", "line_index": 161, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 162, "text": "// He asks about the only circle - Player"}
{"category": "LocationDialogue Location10", "line_index": 163, "text": "Чаму тут толькі адзін круг?"}
{"category": "LocationDialogue Location10", "line_index": 164, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 165, "text": "Гэта версія была выпушчаная адзін раз"}
{"category": "LocationDialogue Location10", "line_index": 166, "text": "Яна больш ніяк не распаўсюджваецца,"}
{"category": "LocationDialogue Location10", "line_index": 167, "text": "Таму яна адзіная"}
{"category": "LocationDialogue Location10", "line_index": 168, "text": "Таксама асаблівасць гэтых версій у тым,"}
{"category": "LocationDialogue Location10", "line_index": 169, "text": "Што міма прайсці немагчыма"}
{"category": "LocationDialogue Location10", "line_index": 170, "text": "У гэтай версіі 1.1 жыве Сонная Міта"}
{"category": "LocationDialogue Location10", "line_index": 171, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 172, "text": "Сонная?"}
{"category": "LocationDialogue Location10", "line_index": 173, "text": "Гэта таму, што ўсе праз яе праходзяць,"}
{"category": "LocationDialogue Location10", "line_index": 174, "text": "І не даюць выспацца?"}
{"category": "LocationDialogue Location10", "line_index": 175, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 176, "text": "Не"}
{"category": "LocationDialogue Location10", "line_index": 177, "text": "Я магу проста прайсці міма яе дзвярэй,"}
{"category": "LocationDialogue Location10", "line_index": 178, "text": "Нават не зазірнуўшы да яе"}
{"category": "LocationDialogue Location10", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 180, "text": "// He asks about the shaded circle - Player"}
{"category": "LocationDialogue Location10", "line_index": 181, "text": "Чаму гэты шарык замаляваны?"}
{"category": "LocationDialogue Location10", "line_index": 182, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 183, "text": "Наогул, гэты малюнак тут"}
{"category": "LocationDialogue Location10", "line_index": 184, "text": "Дзякуючы Гожай Міце:"}
{"category": "LocationDialogue Location10", "line_index": 185, "text": "Гэта яна намалявала"}
{"category": "LocationDialogue Location10", "line_index": 186, "text": "Мы з ёй спрачаліся,"}
{"category": "LocationDialogue Location10", "line_index": 187, "text": "Як хутчэй дайсці да версіі 1.11"}
{"category": "LocationDialogue Location10", "line_index": 188, "text": "// Playerі"}
{"category": "LocationDialogue Location10", "line_index": 189, "text": "І хто выйграў спрэчку?"}
{"category": "LocationDialogue Location10", "line_index": 190, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 191, "text": "Вядома ж я!"}
{"category": "LocationDialogue Location10", "line_index": 192, "text": "Глядзі, мы тут, // Points to the version 1"}
{"category": "LocationDialogue Location10", "line_index": 193, "text": "Версія 1.15"}
{"category": "LocationDialogue Location10", "line_index": 194, "text": "Індэкс дома — 809 // Points to the circle 1"}
{"category": "LocationDialogue Location10", "line_index": 195, "text": "Нам трэба дайсі да версіі 1.11 // Points to the version 2"}
{"category": "LocationDialogue Location10", "line_index": 196, "text": "У індэкс дома 805 // Points to the circle 2"}
{"category": "LocationDialogue Location10", "line_index": 197, "text": "Спачатку яе дарога была такая. // Draws a line to a circle 1"}
{"category": "LocationDialogue Location10", "line_index": 198, "text": "Але мы шукалі яшчэ карацейшую"}
{"category": "LocationDialogue Location10", "line_index": 199, "text": "Потым Міта прапанавала вось такую // Draws a line to a circle 2"}
{"category": "LocationDialogue Location10", "line_index": 200, "text": "Але я проста намалявала самую простую дарогу"}
{"category": "LocationDialogue Location10", "line_index": 201, "text": "Гэта ж відавочна!"}
{"category": "LocationDialogue Location10", "line_index": 202, "text": "Глядзі. // Draws a line to a circle 3"}
{"category": "LocationDialogue Location10", "line_index": 203, "text": "Адсюль можна наўпрост трапіць у патрэбную версію"}
{"category": "LocationDialogue Location10", "line_index": 204, "text": "Хаця здавалася, што будзе замінаць вось гэты дом, // Draws a line to a circle 3"}
{"category": "LocationDialogue Location10", "line_index": 205, "text": "Які не дазволіў бы прайсці"}
{"category": "LocationDialogue Location10", "line_index": 206, "text": "Дарэчы, твой пярсцёнак працуе паводле таго ж прынцыпа"}
{"category": "LocationDialogue Location10", "line_index": 207, "text": "Куды цябе накіравалі?"}
{"category": "LocationDialogue Location10", "line_index": 208, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 209, "text": "Я іду да ядра"}
{"category": "LocationDialogue Location10", "line_index": 210, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 211, "text": "Да ядра?"}
{"category": "LocationDialogue Location10", "line_index": 212, "text": "Цікава..."}
{"category": "LocationDialogue Location10", "line_index": 213, "text": "Калі ты ідзеш кароткай дарогай,"}
{"category": "LocationDialogue Location10", "line_index": 214, "text": "Значыць, ты таксама наведаеш версію 1.11"}
{"category": "LocationDialogue Location10", "line_index": 215, "text": "Потым канечне пройдзеш да Соннай Міты"}
{"category": "LocationDialogue Location10", "line_index": 216, "text": "Думаю, Міта, што накіравала цябе,"}
{"category": "LocationDialogue Location10", "line_index": 217, "text": "Склала такую ж дарогу"}
{"category": "LocationDialogue Location10", "line_index": 218, "text": "Ці яна не ўцяміла, і ты наведаеш яшчэ версію,"}
{"category": "LocationDialogue Location10", "line_index": 219, "text": "Альбо яна геній,"}
{"category": "LocationDialogue Location10", "line_index": 220, "text": "Якая змагла прыдумаць яшчэ карацейшы шлях!"}
{"category": "LocationDialogue Location10", "line_index": 221, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 222, "text": "Зразумеў, напэўна"}
{"category": "LocationDialogue Location10", "line_index": 223, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 224, "text": "// He asks about the inscription - Player"}
{"category": "LocationDialogue Location10", "line_index": 225, "text": "А гэта?"}
{"category": "LocationDialogue Location10", "line_index": 226, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 227, "text": "Гэта для Бойкай Міты"}
{"category": "LocationDialogue Location10", "line_index": 228, "text": "Праз некалькі гадзін яна прыйдзе сюды"}
{"category": "LocationDialogue Location10", "line_index": 229, "text": "Хай прыбярэ гэтыя кардонкі!"}
{"category": "LocationDialogue Location10", "line_index": 230, "text": "І паставіць сюды канапу ўжо!"}
{"category": "LocationDialogue Location10", "line_index": 231, "text": "А то ўся дупа баліць!"}
{"category": "LocationDialogue Location10", "line_index": 232, "text": "// Player"}
{"category": "LocationDialogue Location10", "line_index": 233, "text": "Эм-м..."}
{"category": "LocationDialogue Location10", "line_index": 234, "text": "Я магу дапамагчы?"}
{"category": "LocationDialogue Location10", "line_index": 235, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 236, "text": "Не, гэта для Бойкай Міты"}
{"category": "LocationDialogue Location10", "line_index": 237, "text": "Яна дужая"}
{"category": "LocationDialogue Location10", "line_index": 238, "text": ""}
{"category": "LocationDialogue Location10", "line_index": 239, "text": "// He asks about the drawings - Player"}
{"category": "LocationDialogue Location10", "line_index": 240, "text": "Гэта проста малюнак?"}
{"category": "LocationDialogue Location10", "line_index": 241, "text": "Ці"}
{"category": "LocationDialogue Location10", "line_index": 242, "text": "Таксама штосьці значыць?"}
{"category": "LocationDialogue Location10", "line_index": 243, "text": "// MitaShorthairs"}
{"category": "LocationDialogue Location10", "line_index": 244, "text": "Ну так"}
{"category": "LocationDialogue Location10", "line_index": 245, "text": "Проста малюначак"}
