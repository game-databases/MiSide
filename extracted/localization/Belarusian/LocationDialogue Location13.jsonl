{"category": "LocationDialogue Location13", "line_index": 0, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 1, "text": "Пярсцёнак!"}
{"category": "LocationDialogue Location13", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 3, "text": "// Answer 1 (Дзе ты была ўвесь гэты час?) - MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 4, "text": "Я шукала спосаб давесці цябе да ядра"}
{"category": "LocationDialogue Location13", "line_index": 5, "text": "Цэлым і спраўным"}
{"category": "LocationDialogue Location13", "line_index": 6, "text": "Такі быў план спачатку, так?"}
{"category": "LocationDialogue Location13", "line_index": 7, "text": "Пры гэтым мне трэба было пазбегчы сустрэчы"}
{"category": "LocationDialogue Location13", "line_index": 8, "text": "З Вар'яткай Мітай, так?"}
{"category": "LocationDialogue Location13", "line_index": 9, "text": "А яшчэ адкапаць хоць якую інфармацыю"}
{"category": "LocationDialogue Location13", "line_index": 10, "text": "Пра бэкэнд гэтага клятага сусвету, так?!"}
{"category": "LocationDialogue Location13", "line_index": 11, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 12, "text": "Эм... Відаць, так"}
{"category": "LocationDialogue Location13", "line_index": 13, "text": "Але як жа ты так наладзіла маршрут у пярсцёнку,"}
{"category": "LocationDialogue Location13", "line_index": 14, "text": "Што я адразу трапіў у версію з памылкамі"}
{"category": "LocationDialogue Location13", "line_index": 15, "text": "І адной небяспекай?"}
{"category": "LocationDialogue Location13", "line_index": 16, "text": "Я змог адтуль збегчы,"}
{"category": "LocationDialogue Location13", "line_index": 17, "text": "Толькі скокнуўшы ў бяскнонцую цемру"}
{"category": "LocationDialogue Location13", "line_index": 18, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 19, "text": "Прабач, я зусім забылася ўдакладніць,"}
{"category": "LocationDialogue Location13", "line_index": 20, "text": "Што акурат трэба было зрабіць..."}
{"category": "LocationDialogue Location13", "line_index": 21, "text": "Але на гэта я і разлічвала!"}
{"category": "LocationDialogue Location13", "line_index": 22, "text": "Што ты скочыш вонкі"}
{"category": "LocationDialogue Location13", "line_index": 23, "text": "І як я бачу, ты даў рады!"}
{"category": "LocationDialogue Location13", "line_index": 24, "text": "Малайчына які!"}
{"category": "LocationDialogue Location13", "line_index": 25, "text": "Цяпер ідзём згодна з планам, разумееш?"}
{"category": "LocationDialogue Location13", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 27, "text": "// Answer 2 (Як ты сюды трапіла?) - MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 28, "text": "Табе, відаць, давялося шмат перажыць,"}
{"category": "LocationDialogue Location13", "line_index": 29, "text": "Раз ты ажно пазабыўся на дэталі нашай размовы"}
{"category": "LocationDialogue Location13", "line_index": 30, "text": "Я — Міта, я магу пераходзіць паміж версіямі"}
{"category": "LocationDialogue Location13", "line_index": 31, "text": "без праблем, памятаеш?"}
{"category": "LocationDialogue Location13", "line_index": 32, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 33, "text": "Не ўсе Міты гэта могуць рабіць,"}
{"category": "LocationDialogue Location13", "line_index": 34, "text": "Я ж бачыў!"}
{"category": "LocationDialogue Location13", "line_index": 35, "text": "І яны яўна пакутуюць"}
{"category": "LocationDialogue Location13", "line_index": 36, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 37, "text": "Стоп. Іх версіі зламаныя,"}
{"category": "LocationDialogue Location13", "line_index": 38, "text": "Светы грузнуць у памылках, я ж казала"}
{"category": "LocationDialogue Location13", "line_index": 39, "text": "Вось жа халера..."}
{"category": "LocationDialogue Location13", "line_index": 40, "text": "Ты ж сам знаеш, хто гэта ўсё зрабіў — "}
{"category": "LocationDialogue Location13", "line_index": 41, "text": "Вар'ятка Міта"}
{"category": "LocationDialogue Location13", "line_index": 42, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 43, "text": "Так, я пераканаўся ў гэтым..."}
{"category": "LocationDialogue Location13", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 45, "text": "// Answer 3 (Што гэта за Міта была толькі што?) - MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 46, "text": "Гэта Жудасная Міта"}
{"category": "LocationDialogue Location13", "line_index": 47, "text": "Агрэсіўная і тупая"}
{"category": "LocationDialogue Location13", "line_index": 48, "text": "Паразмаўляць з ёй не выйдзе"}
{"category": "LocationDialogue Location13", "line_index": 49, "text": "Яе свет круціцца вакол Вар'яткі Міты"}
{"category": "LocationDialogue Location13", "line_index": 50, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 51, "text": "Так, я заўважыў"}
{"category": "LocationDialogue Location13", "line_index": 52, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 53, "text": "Давай, нам трэба разабрацца з ядром"}
{"category": "LocationDialogue Location13", "line_index": 54, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 55, "text": "// Answer 4 (Як працуе пярсцёнак?) - Player"}
{"category": "LocationDialogue Location13", "line_index": 56, "text": "Гэта праз пярсцёнак"}
{"category": "LocationDialogue Location13", "line_index": 57, "text": "Прыйшлося ісці да ядра такой дарогай?"}
{"category": "LocationDialogue Location13", "line_index": 58, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 59, "text": "Так"}
{"category": "LocationDialogue Location13", "line_index": 60, "text": "Калі б атрымалася сабраць партал,"}
{"category": "LocationDialogue Location13", "line_index": 61, "text": "То можна было б у імгненне"}
{"category": "LocationDialogue Location13", "line_index": 62, "text": "Цябе сюды перамясціць"}
{"category": "LocationDialogue Location13", "line_index": 63, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 64, "text": "Ну, хоць нейкія плюсы будуць ад пярсцёнка?"}
{"category": "LocationDialogue Location13", "line_index": 65, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 66, "text": "Вядома!"}
{"category": "LocationDialogue Location13", "line_index": 67, "text": "Яго лёгка насіць"}
{"category": "LocationDialogue Location13", "line_index": 68, "text": "Таксама ён запамінае версіі,"}
{"category": "LocationDialogue Location13", "line_index": 69, "text": "Якія ты наведаў"}
{"category": "LocationDialogue Location13", "line_index": 70, "text": "І ты можаш вярнуцца ў іх зноў"}
{"category": "LocationDialogue Location13", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 72, "text": "// Answer 5 (Навошта я патрэбны Вар'ятцы Міце?) - Player"}
{"category": "LocationDialogue Location13", "line_index": 73, "text": "Навошта я патрэбны Вар'ятцы Міце?"}
{"category": "LocationDialogue Location13", "line_index": 74, "text": "Яна гуляе са мною ў небяспечныя гульні,"}
{"category": "LocationDialogue Location13", "line_index": 75, "text": "Але я дагэтуль жывы"}
{"category": "LocationDialogue Location13", "line_index": 76, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 77, "text": "Я мяркую,"}
{"category": "LocationDialogue Location13", "line_index": 78, "text": "Яна хоча знайсці такога гульца,"}
{"category": "LocationDialogue Location13", "line_index": 79, "text": "Які прыме яе такой, якая яна ёсць"}
{"category": "LocationDialogue Location13", "line_index": 80, "text": "Усё-ткі Міта ёсць Міта!"}
{"category": "LocationDialogue Location13", "line_index": 81, "text": "Хаця відавочна, што такое наўрад ці магчыма"}
{"category": "LocationDialogue Location13", "line_index": 82, "text": "Таму яна і выкарыстоўвае картрыджы:"}
{"category": "LocationDialogue Location13", "line_index": 83, "text": "Так ад яе ніхто і ніколі не ўцячэ"}
{"category": "LocationDialogue Location13", "line_index": 84, "text": "Вось так, мяркую"}
{"category": "LocationDialogue Location13", "line_index": 85, "text": "Вернемся да важнага"}
{"category": "LocationDialogue Location13", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 87, "text": "// Answer 6 (гэта ядро)- Player"}
{"category": "LocationDialogue Location13", "line_index": 88, "text": "Гэта яно?"}
{"category": "LocationDialogue Location13", "line_index": 89, "text": "Ядро?"}
{"category": "LocationDialogue Location13", "line_index": 90, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 91, "text": "Ядро"}
{"category": "LocationDialogue Location13", "line_index": 92, "text": "Як я ўжо спрабавала патлумачыць,"}
{"category": "LocationDialogue Location13", "line_index": 93, "text": "Гульцы не ёсць часткай гэтага свету"}
{"category": "LocationDialogue Location13", "line_index": 94, "text": "Таму ім не трэба ніякага асаблівага дазволу тут"}
{"category": "LocationDialogue Location13", "line_index": 95, "text": "Гэта... толькі мае дагадкі"}
{"category": "LocationDialogue Location13", "line_index": 96, "text": "Але я цалкам упэўненая,"}
{"category": "LocationDialogue Location13", "line_index": 97, "text": "Што ўнутры гэтага пакоя"}
{"category": "LocationDialogue Location13", "line_index": 98, "text": "Развязанне ўсіх нашых праблем!"}
{"category": "LocationDialogue Location13", "line_index": 99, "text": "[player], паспрабуй зайсці"}
{"category": "LocationDialogue Location13", "line_index": 100, "text": "І праўда зайшоў..."}
{"category": "LocationDialogue Location13", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 102, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 103, "text": "Асцярожна, [player]!"}
{"category": "LocationDialogue Location13", "line_index": 104, "text": "Яно сочыць за табою"}
{"category": "LocationDialogue Location13", "line_index": 105, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 106, "text": "Хто гэта?"}
{"category": "LocationDialogue Location13", "line_index": 107, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 108, "text": "Не ўпэўнена, што разумею..."}
{"category": "LocationDialogue Location13", "line_index": 109, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 110, "text": "Цудоўна..."}
{"category": "LocationDialogue Location13", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 112, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 113, "text": "Ну што там?"}
{"category": "LocationDialogue Location13", "line_index": 114, "text": "Гэй!"}
{"category": "LocationDialogue Location13", "line_index": 115, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 116, "text": "Здаецца, я знайшоў!"}
{"category": "LocationDialogue Location13", "line_index": 117, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 118, "text": "Хват! Гэта цудоўна!"}
{"category": "LocationDialogue Location13", "line_index": 119, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 120, "text": "Трэба пазначыць версію"}
{"category": "LocationDialogue Location13", "line_index": 121, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 122, "text": "Так, я даведалася, што яе версія..."}
{"category": "LocationDialogue Location13", "line_index": 123, "text": "00.98"}
{"category": "LocationDialogue Location13", "line_index": 124, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 125, "text": "Ёсць!"}
{"category": "LocationDialogue Location13", "line_index": 126, "text": "Добра, а індэкс які?"}
{"category": "LocationDialogue Location13", "line_index": 127, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 128, "text": "Індэкс?"}
{"category": "LocationDialogue Location13", "line_index": 129, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 130, "text": "Трэба пазначыць індэкс"}
{"category": "LocationDialogue Location13", "line_index": 131, "text": "Дай згадаю: ты не ведаеш?"}
{"category": "LocationDialogue Location13", "line_index": 132, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 133, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 134, "text": "Пачакай, гэта ж лагічна:"}
{"category": "LocationDialogue Location13", "line_index": 135, "text": "У кожнай Міты ёсць свой індэкс"}
{"category": "LocationDialogue Location13", "line_index": 136, "text": "Не ўсю ж версію перазапускаць..."}
{"category": "LocationDialogue Location13", "line_index": 137, "text": "Якая лухта!"}
{"category": "LocationDialogue Location13", "line_index": 138, "text": "Як я пра гэта не падумала?.."}
{"category": "LocationDialogue Location13", "line_index": 139, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 144, "text": "// Answer 1 (Што з табою?) - MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 145, "text": "Са мной усё ў парадку"}
{"category": "LocationDialogue Location13", "line_index": 146, "text": "Не беручы пад увагу ўсе нашыя беды"}
{"category": "LocationDialogue Location13", "line_index": 147, "text": "Усё файна, змянілася прыкладна нічога..."}
{"category": "LocationDialogue Location13", "line_index": 148, "text": "Трэба падумаць"}
{"category": "LocationDialogue Location13", "line_index": 149, "text": "Засада поўная"}
{"category": "LocationDialogue Location13", "line_index": 150, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 151, "text": "// Answer 2 (Можа, ёсць спосаб яго даведацца?) - MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 152, "text": "Я..."}
{"category": "LocationDialogue Location13", "line_index": 153, "text": "Думаю... Лухта!"}
{"category": "LocationDialogue Location13", "line_index": 154, "text": "Гэта Вар'яцтва, ха!"}
{"category": "LocationDialogue Location13", "line_index": 155, "text": "Усё адно, што шукаць як сляпы ў торбе"}
{"category": "LocationDialogue Location13", "line_index": 156, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 157, "text": "Ты чаго?"}
{"category": "LocationDialogue Location13", "line_index": 158, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 159, "text": "Глючныя месцы часам багатыя на інфармацыю,"}
{"category": "LocationDialogue Location13", "line_index": 160, "text": "Нібы вантробы свету вонкі вывернула!"}
{"category": "LocationDialogue Location13", "line_index": 161, "text": "Логі, логі, логі, даныя?"}
{"category": "LocationDialogue Location13", "line_index": 162, "text": "А раптам вывернула?"}
{"category": "LocationDialogue Location13", "line_index": 163, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 164, "text": "Га? Што такое?"}
{"category": "LocationDialogue Location13", "line_index": 165, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 166, "text": "Я знаю адно месца!"}
{"category": "LocationDialogue Location13", "line_index": 167, "text": "Чакай тут"}
{"category": "LocationDialogue Location13", "line_index": 168, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 169, "text": "Ты куды?"}
{"category": "LocationDialogue Location13", "line_index": 170, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 171, "text": "// Answer 3 (А што калі атакавацьь вар'ятку міту?) - Player"}
{"category": "LocationDialogue Location13", "line_index": 172, "text": "Ты казала, што любая Міта"}
{"category": "LocationDialogue Location13", "line_index": 173, "text": "Перазагружаецца пасля смерці"}
{"category": "LocationDialogue Location13", "line_index": 174, "text": "А што калі мы..."}
{"category": "LocationDialogue Location13", "line_index": 175, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 176, "text": "Што калі мы заб'ём Вар'ятку Міту?"}
{"category": "LocationDialogue Location13", "line_index": 177, "text": "Ты сур'ёзна?"}
{"category": "LocationDialogue Location13", "line_index": 178, "text": "І як ты сабраўся атакаваць дзяўчынку з бензапілой?"}
{"category": "LocationDialogue Location13", "line_index": 179, "text": "І пачакй: нажом яна не толькі моркву рэжа!"}
{"category": "LocationDialogue Location13", "line_index": 180, "text": "І чамусьці яна страх якая моцная!"}
{"category": "LocationDialogue Location13", "line_index": 181, "text": "Нават дзіўна, што мы яшчэ жывыя..."}
{"category": "LocationDialogue Location13", "line_index": 182, "text": "Давай, нам трэба разабрацца з ядром"}
{"category": "LocationDialogue Location13", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 184, "text": "// core console entry"}
{"category": "LocationDialogue Location13", "line_index": 185, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 186, "text": "Трэба пацвердзіць уваход"}
{"category": "LocationDialogue Location13", "line_index": 187, "text": "Але які ён?"}
{"category": "LocationDialogue Location13", "line_index": 188, "text": "Міта, ты ведаеш?"}
{"category": "LocationDialogue Location13", "line_index": 189, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 190, "text": "Можа, ён недзе там указаны?"}
{"category": "LocationDialogue Location13", "line_index": 191, "text": "Пашукаеш?"}
{"category": "LocationDialogue Location13", "line_index": 192, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 193, "text": "// core console - nope programm - Player"}
{"category": "LocationDialogue Location13", "line_index": 194, "text": "Напэўна, гэта не тое. // 1"}
{"category": "LocationDialogue Location13", "line_index": 195, "text": "Таксама не пасуе. // 2"}
{"category": "LocationDialogue Location13", "line_index": 196, "text": "Не. // 3"}
{"category": "LocationDialogue Location13", "line_index": 197, "text": "Гэта не тое, што мне трэба. // 4"}
{"category": "LocationDialogue Location13", "line_index": 198, "text": "Мне трэба знайсці перазагрузку персанажа. // 5"}
{"category": "LocationDialogue Location13", "line_index": 199, "text": "// core console - nope version"}
{"category": "LocationDialogue Location13", "line_index": 200, "text": "Гэта не тая версія. // 1"}
{"category": "LocationDialogue Location13", "line_index": 201, "text": "Вой, памыліўся. // 2"}
{"category": "LocationDialogue Location13", "line_index": 202, "text": "Не яна. // 3"}
{"category": "LocationDialogue Location13", "line_index": 203, "text": "Трэба падправіць. // 4"}
{"category": "LocationDialogue Location13", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location13", "line_index": 205, "text": "Штосьці не так. // 1"}
{"category": "LocationDialogue Location13", "line_index": 206, "text": "Індэкс няправільны. // 2"}
{"category": "LocationDialogue Location13", "line_index": 207, "text": "Трэба паўтарыць індэкс. // 3"}
{"category": "LocationDialogue Location13", "line_index": 208, "text": "Не падыходзіць. // 4"}
{"category": "LocationDialogue Location13", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location13", "line_index": 210, "text": "// Answer 4 (Little people - Chibi) - Player"}
{"category": "LocationDialogue Location13", "line_index": 211, "text": "Ведаеш, я сустрэў на сваёй дарозе"}
{"category": "LocationDialogue Location13", "line_index": 212, "text": "Мініяцюрных чалавечкаў"}
{"category": "LocationDialogue Location13", "line_index": 213, "text": "Хто яны?"}
{"category": "LocationDialogue Location13", "line_index": 214, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 215, "text": "Цібі?"}
{"category": "LocationDialogue Location13", "line_index": 216, "text": "Не знаю, як патлумачыць..."}
{"category": "LocationDialogue Location13", "line_index": 217, "text": "Гэта такі феномен нашага свету"}
{"category": "LocationDialogue Location13", "line_index": 218, "text": "Цібі-праекцыя ёсць у кожнай Міты"}
{"category": "LocationDialogue Location13", "line_index": 219, "text": "Хаця і ў гульцоў яны могуць з'яўляцца..."}
{"category": "LocationDialogue Location13", "line_index": 220, "text": "Міты іх могуць выклікаць, ты ведаў?"}
{"category": "LocationDialogue Location13", "line_index": 221, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 222, "text": "Гэта як?"}
{"category": "LocationDialogue Location13", "line_index": 223, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 224, "text": "Зара, глядзі!"}
{"category": "LocationDialogue Location13", "line_index": 225, "text": "// Player"}
{"category": "LocationDialogue Location13", "line_index": 226, "text": "Нішто сабе фокусы..."}
{"category": "LocationDialogue Location13", "line_index": 227, "text": "// MitaKind"}
{"category": "LocationDialogue Location13", "line_index": 228, "text": "Але з маімі цібікамі звычайна штосьці не так: "}
{"category": "LocationDialogue Location13", "line_index": 229, "text": "Большасць з іх нараджаюцца мёртвымі"}
{"category": "LocationDialogue Location13", "line_index": 230, "text": "Хаця... адна штосьці можа"}
{"category": "LocationDialogue Location13", "line_index": 231, "text": "Ці не"}
{"category": "LocationDialogue Location13", "line_index": 232, "text": "Яна проста бегае кругамі"}
