{"category": "LocationDialogue Location6", "line_index": 0, "text": " // Player"}
{"category": "LocationDialogue Location6", "line_index": 1, "text": "Міта?"}
{"category": "LocationDialogue Location6", "line_index": 2, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 3, "text": "Як ты сюды трапіў?"}
{"category": "LocationDialogue Location6", "line_index": 4, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 5, "text": "Ты жа Міта?"}
{"category": "LocationDialogue Location6", "line_index": 6, "text": "Толькі нейкая не такая..."}
{"category": "LocationDialogue Location6", "line_index": 7, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 8, "text": "Я-я-ясна..."}
{"category": "LocationDialogue Location6", "line_index": 9, "text": "Слухай, сапраўды,"}
{"category": "LocationDialogue Location6", "line_index": 10, "text": "Я не тая Міта, якую ты бачыў"}
{"category": "LocationDialogue Location6", "line_index": 11, "text": "Сцеражыся, у яе на цябе вельмі"}
{"category": "LocationDialogue Location6", "line_index": 12, "text": "Нядобрыя планы"}
{"category": "LocationDialogue Location6", "line_index": 13, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 14, "text": "Якія планы?"}
{"category": "LocationDialogue Location6", "line_index": 15, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 16, "text": "Блі-ін!"}
{"category": "LocationDialogue Location6", "line_index": 17, "text": "Калі атрымаецца, я ўсё раскажу..."}
{"category": "LocationDialogue Location6", "line_index": 18, "text": "Знайдзі ключ каля канапы"}
{"category": "LocationDialogue Location6", "line_index": 19, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 20, "text": "Але..."}
{"category": "LocationDialogue Location6", "line_index": 21, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 22, "text": "Пытанні пазней!"}
{"category": "LocationDialogue Location6", "line_index": 23, "text": "Давай ключ мне"}
{"category": "LocationDialogue Location6", "line_index": 24, "text": "Вось пярсцёнак"}
{"category": "LocationDialogue Location6", "line_index": 25, "text": "Га? // Player"}
{"category": "LocationDialogue Location6", "line_index": 26, "text": "Ты ж хочаш збегчы адсюль, так? // MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 27, "text": "Ну так... // Player"}
{"category": "LocationDialogue Location6", "line_index": 28, "text": "Тады надзявай. // MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 29, "text": "Гэта карысны атрэфакт. // MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 30, "text": "Думаю, ён спатрэбіцца табе неўзабаве. // MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 31, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 32, "text": "Добра"}
{"category": "LocationDialogue Location6", "line_index": 33, "text": "Дарэчы, я"}
{"category": "LocationDialogue Location6", "line_index": 34, "text": "[player] // [not]"}
{"category": "LocationDialogue Location6", "line_index": 35, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 36, "text": "Так трымаць,"}
{"category": "LocationDialogue Location6", "line_index": 37, "text": "[player] // [not]"}
{"category": "LocationDialogue Location6", "line_index": 38, "text": "А я... Міта. // MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 47, "text": "// MitaKind quest 1 - MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 48, "text": "Глядзі:"}
{"category": "LocationDialogue Location6", "line_index": 49, "text": "Кансоль — вазьмі яе"}
{"category": "LocationDialogue Location6", "line_index": 50, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 51, "text": "Гэта запіс?"}
{"category": "LocationDialogue Location6", "line_index": 52, "text": "А хто гэта з ёй?"}
{"category": "LocationDialogue Location6", "line_index": 53, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 54, "text": "Гэта не запіс,"}
{"category": "LocationDialogue Location6", "line_index": 55, "text": "А іншы гулец"}
{"category": "LocationDialogue Location6", "line_index": 56, "text": "Яна яго зараз выкарыстоўвае"}
{"category": "LocationDialogue Location6", "line_index": 57, "text": "Ведай, што ты таксама"}
{"category": "LocationDialogue Location6", "line_index": 58, "text": "рызыкуеш стаць картрыджам..."}
{"category": "LocationDialogue Location6", "line_index": 59, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 60, "text": "Мне трэба як мага хутчэй выбрацца адсюль"}
{"category": "LocationDialogue Location6", "line_index": 61, "text": "І табе таксама"}
{"category": "LocationDialogue Location6", "line_index": 62, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 63, "text": "Так, канечне"}
{"category": "LocationDialogue Location6", "line_index": 64, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 65, "text": "Ты кажаш,"}
{"category": "LocationDialogue Location6", "line_index": 66, "text": "Яна выкарыстоўвае гульца"}
{"category": "LocationDialogue Location6", "line_index": 67, "text": "А што, калі я выдзеру картрыдж з кансолі? "}
{"category": "LocationDialogue Location6", "line_index": 68, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 69, "text": "Думаю, такое абыходжанне можа прывесці "}
{"category": "LocationDialogue Location6", "line_index": 70, "text": "да непапраўнага пашкоджання картрыджа"}
{"category": "LocationDialogue Location6", "line_index": 71, "text": "Гэта значыць...// Player"}
{"category": "LocationDialogue Location6", "line_index": 72, "text": "гулец загіне.// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 73, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 74, "text": "... // [not]"}
{"category": "LocationDialogue Location6", "line_index": 75, "text": "А калі проста выключыць кансоль?// Player"}
{"category": "LocationDialogue Location6", "line_index": 76, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 77, "text": "Думаю, гэта можа дапамагчы"}
{"category": "LocationDialogue Location6", "line_index": 78, "text": "Варта паспрабаваць. Там ёсць чырвоная кнопка!"}
{"category": "LocationDialogue Location6", "line_index": 79, "text": "Бачыш?"}
{"category": "LocationDialogue Location6", "line_index": 80, "text": "Знайшоў. // Player"}
{"category": "LocationDialogue Location6", "line_index": 81, "text": "Паспрабуй націснуць.// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 82, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 83, "text": "// MitaKind quest 2 - MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 84, "text": "Мне трэба тут затрымацца"}
{"category": "LocationDialogue Location6", "line_index": 85, "text": "Хачу задаць ёй некалькі пытанняў,"}
{"category": "LocationDialogue Location6", "line_index": 86, "text": "даведацца пра яе больш"}
{"category": "LocationDialogue Location6", "line_index": 87, "text": "Хаця яна наўрад ці патрымае адэкватны дыялог"}
{"category": "LocationDialogue Location6", "line_index": 88, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 89, "text": "// MitaKind quest 3 - MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 90, "text": "Наогул, гэта мая версія,"}
{"category": "LocationDialogue Location6", "line_index": 91, "text": "Я была з адным гульцом..."}
{"category": "LocationDialogue Location6", "line_index": 92, "text": "раптоўна штосьці змянілася ў свеце,"}
{"category": "LocationDialogue Location6", "line_index": 93, "text": "і тут з'явілася яна..."}
{"category": "LocationDialogue Location6", "line_index": 94, "text": "Гульца пераўтварыла ў картрыдж,"}
{"category": "LocationDialogue Location6", "line_index": 95, "text": "а мяне закрыла тут"}
{"category": "LocationDialogue Location6", "line_index": 96, "text": "// Player"}
{"category": "LocationDialogue Location6", "line_index": 97, "text": "Пераўтварыла ў картрыдж?"}
{"category": "LocationDialogue Location6", "line_index": 98, "text": "Яна так можа?!"}
{"category": "LocationDialogue Location6", "line_index": 99, "text": "Навошта ёй гэта?"}
{"category": "LocationDialogue Location6", "line_index": 100, "text": "Для чаго ёй гульцы?"}
{"category": "LocationDialogue Location6", "line_index": 101, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 102, "text": "Яна звар'яцела, гэта відавочна!"}
{"category": "LocationDialogue Location6", "line_index": 103, "text": "Яна так забаўляецца, ёй весела, чорцікі!"}
{"category": "LocationDialogue Location6", "line_index": 104, "text": "Гулец становіцца картрыджам"}
{"category": "LocationDialogue Location6", "line_index": 105, "text": "Хтосьці можа нічога не разумець..."}
{"category": "LocationDialogue Location6", "line_index": 106, "text": "А некаторыя ж асэнсоўваюць, але не супраціўляюцца"}
{"category": "LocationDialogue Location6", "line_index": 107, "text": "Мне гэта зусім не падабаецца.// Player"}
{"category": "LocationDialogue Location6", "line_index": 108, "text": "Слухай, ты павінен дапамагчы нам!// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 109, "text": "Я? Якім чынам?// Player"}
{"category": "LocationDialogue Location6", "line_index": 110, "text": "Ты мне патрэбны, гулец!// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 111, "text": "Ты дапаможаш нам, а я пастараюся дапамагчы табе!"}
{"category": "LocationDialogue Location6", "line_index": 112, "text": "Іншага шанца можа і не быць..."}
{"category": "LocationDialogue Location6", "line_index": 113, "text": "Пярсцёнак табе ўкажа шлях да патрэбнай версіі"}
{"category": "LocationDialogue Location6", "line_index": 114, "text": "Там мы і сустрэнемся."}
{"category": "LocationDialogue Location6", "line_index": 115, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 116, "text": "// MKind quest 4 - Player"}
{"category": "LocationDialogue Location6", "line_index": 117, "text": "Я не ў сілах цалкам асэнсаваць,"}
{"category": "LocationDialogue Location6", "line_index": 118, "text": "Што я бачыў наверсе..."}
{"category": "LocationDialogue Location6", "line_index": 119, "text": "Гэтая Міта…"}
{"category": "LocationDialogue Location6", "line_index": 120, "text": "Яна хоча забіць мяне?"}
{"category": "LocationDialogue Location6", "line_index": 121, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 122, "text": "Забіць?"}
{"category": "LocationDialogue Location6", "line_index": 123, "text": "Баюся, у яе ёсць ідэі горш..."}
{"category": "LocationDialogue Location6", "line_index": 124, "text": "Таму табе трэба спяшацца!"}
{"category": "LocationDialogue Location6", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 126, "text": "// Hide!"}
{"category": "LocationDialogue Location6", "line_index": 127, "text": "Вось блін! Хавайся!"}
{"category": "LocationDialogue Location6", "line_index": 128, "text": "Што?// Player"}
{"category": "LocationDialogue Location6", "line_index": 129, "text": "Хутчэй! Яна ідзе сюды!// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 130, "text": "Давярай кальцу: яно выведзе цябе адсюль!"}
{"category": "LocationDialogue Location6", "line_index": 131, "text": ""}
{"category": "LocationDialogue Location6", "line_index": 132, "text": "// MitaKiller"}
{"category": "LocationDialogue Location6", "line_index": 133, "text": "Ну як, скажаш, дзе ён?"}
{"category": "LocationDialogue Location6", "line_index": 134, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 135, "text": "З якой радасці?"}
{"category": "LocationDialogue Location6", "line_index": 136, "text": "Ты яўна не станеш яго забіваць, верна?"}
{"category": "LocationDialogue Location6", "line_index": 137, "text": "// MitaKiller"}
{"category": "LocationDialogue Location6", "line_index": 138, "text": "Значыць, не скажаш..."}
{"category": "LocationDialogue Location6", "line_index": 139, "text": "Ну нічога, мне падабаецца, што ён хаваецца"}
{"category": "LocationDialogue Location6", "line_index": 140, "text": "Я ведаю, што ён тут"}
{"category": "LocationDialogue Location6", "line_index": 141, "text": "// MitaKind"}
{"category": "LocationDialogue Location6", "line_index": 142, "text": "Чаму ты такая агрэсіўная?"}
{"category": "LocationDialogue Location6", "line_index": 143, "text": "Нават не распавядаеш, у чым справа!"}
{"category": "LocationDialogue Location6", "line_index": 144, "text": "Да і наогул..."}
{"category": "LocationDialogue Location6", "line_index": 145, "text": "Навошта табе гэтыя гульцы?"}
{"category": "LocationDialogue Location6", "line_index": 146, "text": "Яны ж не цацкі!"}
{"category": "LocationDialogue Location6", "line_index": 147, "text": "На што ты так абураная?"}
{"category": "LocationDialogue Location6", "line_index": 148, "text": "// MitaKiller"}
{"category": "LocationDialogue Location6", "line_index": 149, "text": "Хах, заваліся, лялька!"}
