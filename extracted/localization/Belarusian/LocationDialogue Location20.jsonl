{"category": "LocationDialogue Location20", "line_index": 0, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 1, "text": "Міла! Не! Ты хворая!"}
{"category": "LocationDialogue Location20", "line_index": 2, "text": "// Mita"}
{"category": "LocationDialogue Location20", "line_index": 3, "text": "Ха-ха! ШТО Я БАЧУ?"}
{"category": "LocationDialogue Location20", "line_index": 4, "text": "Гэта новая эмоцыя на тваім твары?"}
{"category": "LocationDialogue Location20", "line_index": 5, "text": "Давай, больш, больш!"}
{"category": "LocationDialogue Location20", "line_index": 6, "text": "Мне надакучыла проста назіраць!"}
{"category": "LocationDialogue Location20", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 8, "text": "// Mita arena \"Hello\" - Mita"}
{"category": "LocationDialogue Location20", "line_index": 9, "text": "Ну як, мой няўрымслівы,"}
{"category": "LocationDialogue Location20", "line_index": 10, "text": "Яшчэ не стаміўся бадзяцца абы-дзе?"}
{"category": "LocationDialogue Location20", "line_index": 11, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 12, "text": "Што ты зрабіла з Мілай?"}
{"category": "LocationDialogue Location20", "line_index": 13, "text": "// Mita"}
{"category": "LocationDialogue Location20", "line_index": 14, "text": "Значыць, не стаміўся!"}
{"category": "LocationDialogue Location20", "line_index": 15, "text": "Давай яшчэ згуляем разам!"}
{"category": "LocationDialogue Location20", "line_index": 16, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 17, "text": "Ты..."}
{"category": "LocationDialogue Location20", "line_index": 18, "text": "// Mita"}
{"category": "LocationDialogue Location20", "line_index": 19, "text": "Пачнём з невялікага тэста!"}
{"category": "LocationDialogue Location20", "line_index": 20, "text": "Давай праверым тваю каардынацыю!"}
{"category": "LocationDialogue Location20", "line_index": 21, "text": "Пратэстуем твае паводзіны! "}
{"category": "LocationDialogue Location20", "line_index": 22, "text": "А раптам і з табою штосьці не так?"}
{"category": "LocationDialogue Location20", "line_index": 23, "text": "А раптам ты не заслугоўваеш той ШКУРЫ,"}
{"category": "LocationDialogue Location20", "line_index": 24, "text": "Якую ганарліва носіш?"}
{"category": "LocationDialogue Location20", "line_index": 25, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 26, "text": "// Show knifes"}
{"category": "LocationDialogue Location20", "line_index": 27, "text": "Вось, глядзі,"}
{"category": "LocationDialogue Location20", "line_index": 28, "text": "Які абярэш?"}
{"category": "LocationDialogue Location20", "line_index": 29, "text": "Правы"}
{"category": "LocationDialogue Location20", "line_index": 30, "text": "альбо"}
{"category": "LocationDialogue Location20", "line_index": 31, "text": "Левы?"}
{"category": "LocationDialogue Location20", "line_index": 32, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 33, "text": "// Throw knifes"}
{"category": "LocationDialogue Location20", "line_index": 34, "text": "Ты сур'ёзна?"}
{"category": "LocationDialogue Location20", "line_index": 35, "text": "А якая розніца?"}
{"category": "LocationDialogue Location20", "line_index": 36, "text": "Я ж проста пажартавала!"}
{"category": "LocationDialogue Location20", "line_index": 37, "text": "Забі. Разаніна — гэта мінулае стагоддзе"}
{"category": "LocationDialogue Location20", "line_index": 38, "text": "Ну добра"}
{"category": "LocationDialogue Location20", "line_index": 39, "text": "Я маю цікавейшыя ідэі"}
{"category": "LocationDialogue Location20", "line_index": 40, "text": "І для пачатку..."}
{"category": "LocationDialogue Location20", "line_index": 41, "text": "// Show recorder"}
{"category": "LocationDialogue Location20", "line_index": 42, "text": "Паглядзі, што ў мяне ёсць!"}
{"category": "LocationDialogue Location20", "line_index": 43, "text": "Нам трэба крышачку музыкі!"}
{"category": "LocationDialogue Location20", "line_index": 44, "text": "Як табе мелодыя?"}
{"category": "LocationDialogue Location20", "line_index": 45, "text": "Яна мяне прыводзіць у захапленне!"}
{"category": "LocationDialogue Location20", "line_index": 46, "text": "Я пачну"}
{"category": "LocationDialogue Location20", "line_index": 47, "text": "З правіл!"}
{"category": "LocationDialogue Location20", "line_index": 48, "text": "// Show rule"}
{"category": "LocationDialogue Location20", "line_index": 49, "text": "Пакуль гэтая мелодыя гучыць,"}
{"category": "LocationDialogue Location20", "line_index": 50, "text": "Можаш рухацца"}
{"category": "LocationDialogue Location20", "line_index": 51, "text": "Калі мелодыі няма,"}
{"category": "LocationDialogue Location20", "line_index": 52, "text": "Не рухайся,"}
{"category": "LocationDialogue Location20", "line_index": 53, "text": "Іначай загінеш!"}
{"category": "LocationDialogue Location20", "line_index": 54, "text": "Глядзі: табе трэба дайсці да канца"}
{"category": "LocationDialogue Location20", "line_index": 55, "text": "Справішся —"}
{"category": "LocationDialogue Location20", "line_index": 56, "text": "Працягнем гульню!"}
{"category": "LocationDialogue Location20", "line_index": 57, "text": "Ну чаго стаіш?"}
{"category": "LocationDialogue Location20", "line_index": 58, "text": "Бяжы, міленькі, бяжы!"}
{"category": "LocationDialogue Location20", "line_index": 59, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 60, "text": "// Ready recorder - Mita"}
{"category": "LocationDialogue Location20", "line_index": 61, "text": "Оў!"}
{"category": "LocationDialogue Location20", "line_index": 62, "text": "Ты такі паслухмяны!"}
{"category": "LocationDialogue Location20", "line_index": 63, "text": "Цудоўны экзэмпляр!"}
{"category": "LocationDialogue Location20", "line_index": 64, "text": "Хачу цябе сабе!"}
{"category": "LocationDialogue Location20", "line_index": 65, "text": "Хаця гэта было супер проста, праўда ж?"}
{"category": "LocationDialogue Location20", "line_index": 66, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 67, "text": "Адпусці мяне!"}
{"category": "LocationDialogue Location20", "line_index": 68, "text": "// Mita"}
{"category": "LocationDialogue Location20", "line_index": 69, "text": "Не расслабляцца!"}
{"category": "LocationDialogue Location20", "line_index": 70, "text": "У нас яшчэ шмат гульняў наперадзе!"}
{"category": "LocationDialogue Location20", "line_index": 71, "text": "І вось! // Close eyes"}
{"category": "LocationDialogue Location20", "line_index": 72, "text": "Цяпер я буду заплюшчваць вочы"}
{"category": "LocationDialogue Location20", "line_index": 73, "text": "І калі расплюшчу, // open eyes"}
{"category": "LocationDialogue Location20", "line_index": 74, "text": "Ад цябе не павінна быць ні слыху ні дыху!"}
{"category": "LocationDialogue Location20", "line_index": 75, "text": "Зразумеў мяне?"}
{"category": "LocationDialogue Location20", "line_index": 76, "text": "Калі пабачу — пакараю!"}
{"category": "LocationDialogue Location20", "line_index": 77, "text": "Акей, пачнём!"}
{"category": "LocationDialogue Location20", "line_index": 78, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 79, "text": "Гэта дарэмна"}
{"category": "LocationDialogue Location20", "line_index": 80, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 81, "text": "// Ready hide - Mita"}
{"category": "LocationDialogue Location20", "line_index": 82, "text": "Дабраўся!"}
{"category": "LocationDialogue Location20", "line_index": 83, "text": "Ну ты малайчына! Гэта ўзрушвае!"}
{"category": "LocationDialogue Location20", "line_index": 84, "text": "Цяпер будзе складаней!"}
{"category": "LocationDialogue Location20", "line_index": 85, "text": "У шма-а-ат разоў складаней..."}
{"category": "LocationDialogue Location20", "line_index": 86, "text": "Хавайся! Бяжы! А потым пакруціся!"}
{"category": "LocationDialogue Location20", "line_index": 87, "text": "// Player"}
{"category": "LocationDialogue Location20", "line_index": 88, "text": "Каб цябе чорт узяў!"}
{"category": "LocationDialogue Location20", "line_index": 89, "text": ""}
{"category": "LocationDialogue Location20", "line_index": 90, "text": "// Player fall - Player"}
{"category": "LocationDialogue Location20", "line_index": 91, "text": "Здаецца, пранесла..."}
