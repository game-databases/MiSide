{"category": "LocationDialogue Location1", "line_index": 0, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 1, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 2, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 4, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 5, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 6, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 7, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 8, "text": "// Mita"}
{"category": "LocationDialogue Location1", "line_index": 9, "text": "Вітанкі, я Міта!"}
{"category": "LocationDialogue Location1", "line_index": 10, "text": "Як цябе завуць?"}
{"category": "LocationDialogue Location1", "line_index": 11, "text": "Радая пазнаёміцца, [player]!"}
{"category": "LocationDialogue Location1", "line_index": 12, "text": "Хм-м-м, [player]..."}
{"category": "LocationDialogue Location1", "line_index": 13, "text": "Апошнім разам я спяшалася і пакінула тут гармідар..."}
{"category": "LocationDialogue Location1", "line_index": 14, "text": "Дапаможаш мне?"}
{"category": "LocationDialogue Location1", "line_index": 15, "text": "Уф-ф..."}
{"category": "LocationDialogue Location1", "line_index": 16, "text": "Вялікі дзякуй!"}
{"category": "LocationDialogue Location1", "line_index": 17, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 18, "text": "Вітанкі, [player], я тут прагаладалася..."}
{"category": "LocationDialogue Location1", "line_index": 19, "text": "Хачу есці..."}
{"category": "LocationDialogue Location1", "line_index": 20, "text": "Купіш мне інгрэдыенты для курынага супу? "}
{"category": "LocationDialogue Location1", "line_index": 21, "text": "Ого! Тое што трэба!"}
{"category": "LocationDialogue Location1", "line_index": 22, "text": "А цяпер давай згатуем гэта разам?"}
{"category": "LocationDialogue Location1", "line_index": 23, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 24, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 25, "text": "Вітанкі, [player]! Я збіралася сёння купіць танны тэлевізар.   "}
{"category": "LocationDialogue Location1", "line_index": 26, "text": "Ён невялікі і з антэнай. Я хацела б яго з сабой узяць, калі пайду на прагулку"}
{"category": "LocationDialogue Location1", "line_index": 27, "text": "Памятай, што ты можаш гуляць у гульні, дзе ты атрымаеш грошы!"}
{"category": "LocationDialogue Location1", "line_index": 28, "text": "Пагуляеш, атрымаеш грошы, а потым купіш мне тэлевізар?"}
{"category": "LocationDialogue Location1", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 30, "text": "Ура-а-а! Цяпер ты маеш грошы, каб купіць мне тэлевізар!"}
{"category": "LocationDialogue Location1", "line_index": 31, "text": "Ага, самы танны і мабільны — тое, што мне трэба!"}
{"category": "LocationDialogue Location1", "line_index": 32, "text": "Дзякуй!"}
{"category": "LocationDialogue Location1", "line_index": 33, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 34, "text": "Вітанкі, [player]! Я такая шчаслівая, што ты мне дапамагаеш..."}
{"category": "LocationDialogue Location1", "line_index": 35, "text": "А яшчэ... Той тэлевізар — ён быў файны, але ён так хутка зламаўся..."}
{"category": "LocationDialogue Location1", "line_index": 36, "text": "Дапамажы мне пераставіць шафу на іншае месца >.<"}
{"category": "LocationDialogue Location1", "line_index": 37, "text": "Бо ён зацяжкі... "}
{"category": "LocationDialogue Location1", "line_index": 38, "text": "Вялікі дзякуй <3  Любімчык мой!"}
{"category": "LocationDialogue Location1", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 40, "text": "Го, [player]! Здаецца, мінуў толькі дзень, а я ўжо засумавала за табою!"}
{"category": "LocationDialogue Location1", "line_index": 41, "text": "Я б хацела, каб ты наведваў мяне часцей..."}
{"category": "LocationDialogue Location1", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 43, "text": "Гэта мне?"}
{"category": "LocationDialogue Location1", "line_index": 44, "text": "Дзякуй, дзякуй, дзякуй!"}
{"category": "LocationDialogue Location1", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 46, "text": "Прывітанне, [player]! Я тут падумала..."}
{"category": "LocationDialogue Location1", "line_index": 47, "text": "І хачу цябе пабачыць, ужывую..."}
{"category": "LocationDialogue Location1", "line_index": 48, "text": "Шкада, што не магу..."}
{"category": "LocationDialogue Location1", "line_index": 49, "text": "Ты мне вельмі падабаешся. Штодзень робіш штосьці для мяне"}
{"category": "LocationDialogue Location1", "line_index": 50, "text": "Я б таксама аддзячыла табе як-небудзь"}
{"category": "LocationDialogue Location1", "line_index": 51, "text": "... // [not]"}
{"category": "LocationDialogue Location1", "line_index": 52, "text": "А ведаеш, я штось прыдумала! // Mita"}
{"category": "LocationDialogue Location1", "line_index": 53, "text": "Цяпер ты са мной!"}
{"category": "LocationDialogue Location1", "line_index": 54, "text": "Прыбяры тэлефон."}
{"category": "LocationDialogue Location1", "line_index": 55, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 57, "text": "// T-shirt on the bed - Player"}
{"category": "LocationDialogue Location1", "line_index": 58, "text": "Чаго ты тут ляжыш без справы? "}
{"category": "LocationDialogue Location1", "line_index": 59, "text": "// Rubik's Cube - Player"}
{"category": "LocationDialogue Location1", "line_index": 60, "text": "Здаецца, я дарма яго купіў..."}
{"category": "LocationDialogue Location1", "line_index": 61, "text": "Сабраў яго раз і пакінуў так"}
{"category": "LocationDialogue Location1", "line_index": 62, "text": "Можа, я баюся, што не збяру яго зноў?"}
{"category": "LocationDialogue Location1", "line_index": 63, "text": "// Computer - Player"}
{"category": "LocationDialogue Location1", "line_index": 64, "text": "Сёння мне трэба будзе..."}
{"category": "LocationDialogue Location1", "line_index": 65, "text": "З розумам скласці спіс заданняў,"}
{"category": "LocationDialogue Location1", "line_index": 66, "text": "Зрабіць рэакцыю персанажа"}
{"category": "LocationDialogue Location1", "line_index": 67, "text": "І крыху папрацаваць з кодам"}
{"category": "LocationDialogue Location1", "line_index": 68, "text": "// The airplane - Player"}
{"category": "LocationDialogue Location1", "line_index": 69, "text": "Палёт цудоўны!"}
{"category": "LocationDialogue Location1", "line_index": 70, "text": "// Trash in the corner - Player"}
{"category": "LocationDialogue Location1", "line_index": 71, "text": "Няма часу вынесці смецце..."}
{"category": "LocationDialogue Location1", "line_index": 72, "text": "Я абавязкова займуся гэтым!"}
{"category": "LocationDialogue Location1", "line_index": 73, "text": "Калі там уборка ў маім раскладзе? "}
{"category": "LocationDialogue Location1", "line_index": 74, "text": "// Photo of a cat on a watermelon - Player"}
{"category": "LocationDialogue Location1", "line_index": 75, "text": "Мне так спадабалася..."}
{"category": "LocationDialogue Location1", "line_index": 76, "text": "Кот на кавуне"}
{"category": "LocationDialogue Location1", "line_index": 77, "text": "// Photo with a girl - Player"}
{"category": "LocationDialogue Location1", "line_index": 78, "text": "Якая ж вялікая розніца паміж мной"}
{"category": "LocationDialogue Location1", "line_index": 79, "text": "І маёй сястрой..."}
{"category": "LocationDialogue Location1", "line_index": 80, "text": "Яна ніколі не прапусціць ніводнай падзеі,"}
{"category": "LocationDialogue Location1", "line_index": 81, "text": "А я, наадварот, заўсёды дома"}
{"category": "LocationDialogue Location1", "line_index": 82, "text": "// Photos with people - Player"}
{"category": "LocationDialogue Location1", "line_index": 83, "text": "Хм-м..."}
{"category": "LocationDialogue Location1", "line_index": 84, "text": "Начальства прамывала нам мазгі"}
{"category": "LocationDialogue Location1", "line_index": 85, "text": "З гэным офісным этыкетам так,"}
{"category": "LocationDialogue Location1", "line_index": 86, "text": "Што я дагэтуль не магу развітацца"}
{"category": "LocationDialogue Location1", "line_index": 87, "text": "Са сваімі калегамі..."}
{"category": "LocationDialogue Location1", "line_index": 88, "text": "Я нават не ведаю,"}
{"category": "LocationDialogue Location1", "line_index": 89, "text": "Ці пабачу іх зноў"}
{"category": "LocationDialogue Location1", "line_index": 90, "text": "Пачакай, я напраўду павесіў гэты здымак?"}
{"category": "LocationDialogue Location1", "line_index": 91, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 92, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 93, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 94, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 95, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 96, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 99, "text": "// Nope name - Mita"}
{"category": "LocationDialogue Location1", "line_index": 100, "text": "... // [not]"}
{"category": "LocationDialogue Location1", "line_index": 101, "text": "О, не. // Mita"}
{"category": "LocationDialogue Location1", "line_index": 102, "text": "Так не пойдзе..."}
{"category": "LocationDialogue Location1", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 104, "text": "// Name Developer"}
{"category": "LocationDialogue Location1", "line_index": 105, "text": "Ты праўда хочаш узяць імя распрацоўніка? "}
{"category": "LocationDialogue Location1", "line_index": 106, "text": "Радая, што ты іх знаеш, але..."}
{"category": "LocationDialogue Location1", "line_index": 107, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 108, "text": "// Bad name"}
{"category": "LocationDialogue Location1", "line_index": 109, "text": "Дрэнныя словы я ведаю, і мне не падабаецца, што ты намерыўся сябе так назваць"}
{"category": "LocationDialogue Location1", "line_index": 110, "text": "Гэта не класна..."}
{"category": "LocationDialogue Location1", "line_index": 111, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 112, "text": "// Go restart"}
{"category": "LocationDialogue Location1", "line_index": 113, "text": "Карацей, так не трэба рабіць. Давай пачнём спачатку!"}
{"category": "LocationDialogue Location1", "line_index": 114, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 115, "text": "// Name with numbers"}
{"category": "LocationDialogue Location1", "line_index": 116, "text": "Гэй, ты выкарыстоўваеш лічбы ў імі? У цябе зусім няма фантазіі???"}
{"category": "LocationDialogue Location1", "line_index": 117, "text": "Добра, усё-ж гэта твая справа..."}
{"category": "LocationDialogue Location1", "line_index": 118, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 119, "text": "// Name Mita"}
{"category": "LocationDialogue Location1", "line_index": 120, "text": "Міта // is name of Mita (Check for game) [not]"}
{"category": "LocationDialogue Location1", "line_index": 121, "text": "Ты праўда хочаш узяць маё імя?"}
{"category": "LocationDialogue Location1", "line_index": 122, "text": "Ці гэта сапраўды тваё імя?"}
{"category": "LocationDialogue Location1", "line_index": 123, "text": "Не крыўдзіся, але давай Мітай буду толькі я?"}
{"category": "LocationDialogue Location1", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location1", "line_index": 125, "text": "// Day 10 - Mita"}
{"category": "LocationDialogue Location1", "line_index": 126, "text": "Вой, ты ўжо вярнуўся?"}
{"category": "LocationDialogue Location1", "line_index": 127, "text": "Слухай, я згубіла грабянец..."}
{"category": "LocationDialogue Location1", "line_index": 128, "text": "Ты не мог бы дапамагчы знайсці яго?"}
{"category": "LocationDialogue Location1", "line_index": 129, "text": "Зазірні спачатку ў гэтую шафку! Можа, яна там?"}
{"category": "LocationDialogue Location1", "line_index": 130, "text": "// Паглядзеў ў шафцы"}
{"category": "LocationDialogue Location1", "line_index": 131, "text": "Хм-м... Тут няма грабянца..."}
{"category": "LocationDialogue Location1", "line_index": 132, "text": "Тады паглядзі ў іншых месцах"}
{"category": "LocationDialogue Location1", "line_index": 133, "text": "Толькі ў духоўцы не глядзі!"}
{"category": "LocationDialogue Location1", "line_index": 134, "text": "Я там ужо праверыла."}
{"category": "LocationDialogue Location1", "line_index": 135, "text": "// Зазірнуў ў духоўку"}
{"category": "LocationDialogue Location1", "line_index": 136, "text": "Вой! Я ж казала не глядзець там!"}
{"category": "LocationDialogue Location1", "line_index": 137, "text": "Адвярніся! зараз я прыбяру ўсё!"}
{"category": "LocationDialogue Location1", "line_index": 138, "text": "Уф, добра, пашукай у іншых месцах"}
{"category": "LocationDialogue Location1", "line_index": 139, "text": "І, зрабі ласку, забудзь тое, што бачыў..."}
{"category": "LocationDialogue Location1", "line_index": 140, "text": "// Знайшоў грабянец"}
{"category": "LocationDialogue Location1", "line_index": 141, "text": "Го-о-о! Ты знайшоў яго!"}
{"category": "LocationDialogue Location1", "line_index": 142, "text": "Экстра! Чым цяпер зоймемся?"}
