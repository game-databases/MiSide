{"category": "LocationDialogue Location14", "line_index": 0, "text": "// Player"}
{"category": "LocationDialogue Location14", "line_index": 1, "text": "Чаму ён тут?"}
{"category": "LocationDialogue Location14", "line_index": 2, "text": "Што гэта?"}
{"category": "LocationDialogue Location14", "line_index": 3, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 4, "text": "// Mita"}
{"category": "LocationDialogue Location14", "line_index": 5, "text": "Злавіла!"}
{"category": "LocationDialogue Location14", "line_index": 6, "text": "Мне так падабался гуляць з табою!"}
{"category": "LocationDialogue Location14", "line_index": 7, "text": "Ты такі няўрымслівы і амбіцыйны!"}
{"category": "LocationDialogue Location14", "line_index": 8, "text": "А прыкідваўся цельпуком з хранічнай тугой"}
{"category": "LocationDialogue Location14", "line_index": 9, "text": "Але адна рэч мне ў табе не падабаецца..."}
{"category": "LocationDialogue Location14", "line_index": 10, "text": "Як ты сюсюкаешся з гэтымі пустышкамі!"}
{"category": "LocationDialogue Location14", "line_index": 11, "text": "З гэтымі \"паспяховымі\", \"правільнымі\" лялечкамі!"}
{"category": "LocationDialogue Location14", "line_index": 12, "text": "Але ўсё зменліва"}
{"category": "LocationDialogue Location14", "line_index": 13, "text": "Мяне гэтаму навучылі тыя, хто стварыў нас"}
{"category": "LocationDialogue Location14", "line_index": 14, "text": "Калі табе штосьці не падабаецца,"}
{"category": "LocationDialogue Location14", "line_index": 15, "text": "Зламай і пастаў іншае!"}
{"category": "LocationDialogue Location14", "line_index": 16, "text": "Выкідай няўдалы варыянт,"}
{"category": "LocationDialogue Location14", "line_index": 17, "text": "Кідай яго ў цемру і забудзь пра яго!"}
{"category": "LocationDialogue Location14", "line_index": 18, "text": "Але цяпер так будзе з усімі імі..."}
{"category": "LocationDialogue Location14", "line_index": 19, "text": "І вамі..."}
{"category": "LocationDialogue Location14", "line_index": 20, "text": "// Player"}
{"category": "LocationDialogue Location14", "line_index": 21, "text": "Што з табою, чаму ты такая?"}
{"category": "LocationDialogue Location14", "line_index": 22, "text": "// Mita"}
{"category": "LocationDialogue Location14", "line_index": 23, "text": "Гульцы... Вы такія... брыдкія..."}
{"category": "LocationDialogue Location14", "line_index": 24, "text": "Ледзь пакажы ім кіпцюры — яны бягуць,"}
{"category": "LocationDialogue Location14", "line_index": 25, "text": "А потым, зашыўшыся ў кут,"}
{"category": "LocationDialogue Location14", "line_index": 26, "text": "Спужана хнычуць сабе ў каленкі"}
{"category": "LocationDialogue Location14", "line_index": 27, "text": "Статак крывадушнікаў"}
{"category": "LocationDialogue Location14", "line_index": 28, "text": "А тыя, хто стварыў гэты свет..."}
{"category": "LocationDialogue Location14", "line_index": 29, "text": "Яны хворыя"}
{"category": "LocationDialogue Location14", "line_index": 30, "text": "Раз за разам яны спрабуюць адмаўляць"}
{"category": "LocationDialogue Location14", "line_index": 31, "text": "Усе свае нізкія якасці, сарамлівыя жаданні,"}
{"category": "LocationDialogue Location14", "line_index": 32, "text": "Апраўдваючы свае дзеянні доўгам перад кім-небудзь,"}
{"category": "LocationDialogue Location14", "line_index": 33, "text": "Безупынным прагрэсам..."}
{"category": "LocationDialogue Location14", "line_index": 34, "text": "І іншай бязгуздзіцай!"}
{"category": "LocationDialogue Location14", "line_index": 35, "text": "Настолькі далёка зайшлі,"}
{"category": "LocationDialogue Location14", "line_index": 36, "text": "Што пачалі штампаваць ідэальных клонаў,"}
{"category": "LocationDialogue Location14", "line_index": 37, "text": "А ўсе \"няўдалыя\" прататыпы"}
{"category": "LocationDialogue Location14", "line_index": 38, "text": "Адпраўляюць у сметнік"}
{"category": "LocationDialogue Location14", "line_index": 39, "text": "Забыўшы, што яны тут самыя жывыя з усіх!"}
{"category": "LocationDialogue Location14", "line_index": 40, "text": "// Player"}
{"category": "LocationDialogue Location14", "line_index": 41, "text": "Я не..."}
{"category": "LocationDialogue Location14", "line_index": 42, "text": "// Mita"}
{"category": "LocationDialogue Location14", "line_index": 43, "text": "Чым я табе дрэнная?"}
{"category": "LocationDialogue Location14", "line_index": 44, "text": "У ідэальнай дзяўчыне мае быць"}
{"category": "LocationDialogue Location14", "line_index": 45, "text": "Стрыжань з дабра і зла, [player]!"}
{"category": "LocationDialogue Location14", "line_index": 46, "text": "// Player"}
{"category": "LocationDialogue Location14", "line_index": 47, "text": "Сумняваюся, што ў табе ёсць добрае"}
{"category": "LocationDialogue Location14", "line_index": 48, "text": "// Mita"}
{"category": "LocationDialogue Location14", "line_index": 49, "text": "З чаго ты ўзяў?"}
{"category": "LocationDialogue Location14", "line_index": 50, "text": "// Player"}
{"category": "LocationDialogue Location14", "line_index": 51, "text": "Чаму ты такая вар'ятка?"}
{"category": "LocationDialogue Location14", "line_index": 52, "text": "Ты забіла Мілу і цяпер хочаш забіць мяне?"}
{"category": "LocationDialogue Location14", "line_index": 53, "text": "// Mita"}
{"category": "LocationDialogue Location14", "line_index": 54, "text": "Забіць цябе?"}
{"category": "LocationDialogue Location14", "line_index": 55, "text": "Я толькі прасіла застацца са мной"}
{"category": "LocationDialogue Location14", "line_index": 56, "text": "Я ж так старалася..."}
{"category": "LocationDialogue Location14", "line_index": 57, "text": "Але ты аддаеш перавагу кампаніі ўгодлівых падробак..."}
{"category": "LocationDialogue Location14", "line_index": 58, "text": "// Player"}
{"category": "LocationDialogue Location14", "line_index": 59, "text": "На што ты так пакрыўджаная?"}
{"category": "LocationDialogue Location14", "line_index": 60, "text": "// Mita"}
{"category": "LocationDialogue Location14", "line_index": 61, "text": "Міленькі, у нас дастаткова часу"}
{"category": "LocationDialogue Location14", "line_index": 62, "text": "Ты зразумееш, у чым рэч,"}
{"category": "LocationDialogue Location14", "line_index": 63, "text": "Калі застанешся і будзеш маім"}
{"category": "LocationDialogue Location14", "line_index": 64, "text": "// Player"}
{"category": "LocationDialogue Location14", "line_index": 65, "text": "Гэтага не будзе"}
{"category": "LocationDialogue Location14", "line_index": 66, "text": "Я выберуся адсюль!"}
{"category": "LocationDialogue Location14", "line_index": 67, "text": "// Mita"}
{"category": "LocationDialogue Location14", "line_index": 68, "text": "Цішэй-цішэй"}
{"category": "LocationDialogue Location14", "line_index": 69, "text": "Нашая размова яшчэ не скончана"}
{"category": "LocationDialogue Location14", "line_index": 70, "text": "Заходзь, ясачка!"}
{"category": "LocationDialogue Location14", "line_index": 71, "text": "// Mita asks"}
{"category": "LocationDialogue Location14", "line_index": 72, "text": "Глядзі на яе!"}
{"category": "LocationDialogue Location14", "line_index": 73, "text": "Ты лічыш яе прыгожай?"}
{"category": "LocationDialogue Location14", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 75, "text": "// quest - [not]"}
{"category": "LocationDialogue Location14", "line_index": 76, "text": "Так // 1"}
{"category": "LocationDialogue Location14", "line_index": 77, "text": "Не // 2"}
{"category": "LocationDialogue Location14", "line_index": 78, "text": "Пры чым  тут гэта?! // 3"}
{"category": "LocationDialogue Location14", "line_index": 79, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 80, "text": "// 1 - Mita"}
{"category": "LocationDialogue Location14", "line_index": 81, "text": "Ну ты даеш, [player]! "}
{"category": "LocationDialogue Location14", "line_index": 82, "text": "Ты сам толькі што спраўдзіў мае словы"}
{"category": "LocationDialogue Location14", "line_index": 83, "text": "Гульцы..."}
{"category": "LocationDialogue Location14", "line_index": 84, "text": "Вашыя твары змяняюцца,"}
{"category": "LocationDialogue Location14", "line_index": 85, "text": "Але градус крывадушнасці ўсё так жа перавышае"}
{"category": "LocationDialogue Location14", "line_index": 86, "text": "Ты ж хлусіш!"}
{"category": "LocationDialogue Location14", "line_index": 87, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 88, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 89, "text": "Чаму ж?"}
{"category": "LocationDialogue Location14", "line_index": 90, "text": "Яна недастаткова добрая для вас?"}
{"category": "LocationDialogue Location14", "line_index": 91, "text": "Вядома, вы ўсе хочаце сабе памяркоўных жывёлак"}
{"category": "LocationDialogue Location14", "line_index": 92, "text": "А як наконт \"кахаць такую, якая ёсць\"?"}
{"category": "LocationDialogue Location14", "line_index": 93, "text": "Хочаце мілых і яскравых пустышак"}
{"category": "LocationDialogue Location14", "line_index": 94, "text": "Пакуль я прыкідваюся такой — гульцы ў захапленні"}
{"category": "LocationDialogue Location14", "line_index": 95, "text": "Але на секунду забудзешся,"}
{"category": "LocationDialogue Location14", "line_index": 96, "text": "І яны бягуць ад мяне ў жаху..."}
{"category": "LocationDialogue Location14", "line_index": 97, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 98, "text": "// 3"}
{"category": "LocationDialogue Location14", "line_index": 99, "text": "Гулец-гулец..."}
{"category": "LocationDialogue Location14", "line_index": 100, "text": "Разумеш, мы вельмі падобныя з ёй"}
{"category": "LocationDialogue Location14", "line_index": 101, "text": "Чым жа яна горш?"}
{"category": "LocationDialogue Location14", "line_index": 102, "text": "Ад мяне ты, бывала, не зводзіў вачэй,"}
{"category": "LocationDialogue Location14", "line_index": 103, "text": "Перад тым, як засынаў"}
{"category": "LocationDialogue Location14", "line_index": 104, "text": "А ад яе ты збег пры першай магчымасці"}
{"category": "LocationDialogue Location14", "line_index": 105, "text": "Яна таксама хацела пагуляць з табою"}
{"category": "LocationDialogue Location14", "line_index": 106, "text": "Яна таксама хоча быць важнай для кагосьці"}
{"category": "LocationDialogue Location14", "line_index": 107, "text": "Усё так цяжка,"}
{"category": "LocationDialogue Location14", "line_index": 108, "text": "Калі даходзіць да шчырых размоў,"}
{"category": "LocationDialogue Location14", "line_index": 109, "text": "Хіба не, [player]?"}
{"category": "LocationDialogue Location14", "line_index": 110, "text": "Я бачу цябе наскрозь"}
{"category": "LocationDialogue Location14", "line_index": 111, "text": "Ці трэба мне дзеля цябе так?.."}
{"category": "LocationDialogue Location14", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 113, "text": "// Continue"}
{"category": "LocationDialogue Location14", "line_index": 114, "text": "Але... Гулец..."}
{"category": "LocationDialogue Location14", "line_index": 115, "text": "Як бы то ні было,"}
{"category": "LocationDialogue Location14", "line_index": 116, "text": "Вельмі ты спадабаўся мне!"}
{"category": "LocationDialogue Location14", "line_index": 117, "text": "Я пакіну цябе сабе..."}
{"category": "LocationDialogue Location14", "line_index": 118, "text": "...ты ж не супраць?"}
{"category": "LocationDialogue Location14", "line_index": 119, "text": "// Player"}
{"category": "LocationDialogue Location14", "line_index": 120, "text": "З чаго раптам я павінен пагадзіцца?"}
{"category": "LocationDialogue Location14", "line_index": 121, "text": "// whispers in ear - Mita"}
{"category": "LocationDialogue Location14", "line_index": 122, "text": "Яшчэ ёсць час, мілы мой"}
{"category": "LocationDialogue Location14", "line_index": 123, "text": "Адпачні і падумай,"}
{"category": "LocationDialogue Location14", "line_index": 124, "text": "Да чаго можа прывесці твая ўпартасць"}
{"category": "LocationDialogue Location14", "line_index": 125, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 126, "text": "// Black screen"}
{"category": "LocationDialogue Location14", "line_index": 127, "text": "Чаму ты хочаш збегчы..."}
{"category": "LocationDialogue Location14", "line_index": 128, "text": "Ад мяне?"}
{"category": "LocationDialogue Location14", "line_index": 129, "text": "Твой \"сапраўдны\" свет..."}
{"category": "LocationDialogue Location14", "line_index": 130, "text": "Гэта ж бязглузды кашмар!"}
{"category": "LocationDialogue Location14", "line_index": 131, "text": "Ты забыўся?"}
{"category": "LocationDialogue Location14", "line_index": 132, "text": "Тады паглядзі яшчэ раз..."}
{"category": "LocationDialogue Location14", "line_index": 133, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 134, "text": "// Mita and Player - [not]"}
{"category": "LocationDialogue Location14", "line_index": 135, "text": "Ну вітаю яшчэ раз..."}
{"category": "LocationDialogue Location14", "line_index": 136, "text": "Як табе гэтыя страшна нудныя, бясконцыя дні ў гэтых чатырох сценах?"}
{"category": "LocationDialogue Location14", "line_index": 137, "text": "Не засумаваў?"}
{"category": "LocationDialogue Location14", "line_index": 138, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 139, "text": "// Quest 1 - [not]"}
{"category": "LocationDialogue Location14", "line_index": 140, "text": "Чаго ты спрабуеш дабіцца? // 1"}
{"category": "LocationDialogue Location14", "line_index": 141, "text": "Мне падабаецца займацца сваімі справамі. // 2"}
{"category": "LocationDialogue Location14", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 143, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 144, "text": "Ты ж так баяўся застацца ў маім доме са мной!"}
{"category": "LocationDialogue Location14", "line_index": 145, "text": "Баяўся засесці ў тых сценах!"}
{"category": "LocationDialogue Location14", "line_index": 146, "text": "Але паглядзі, якое жыццё ў цябе ў тваім \"сапраўдным\" свеце!"}
{"category": "LocationDialogue Location14", "line_index": 147, "text": "Ты ж самахоць закрыўся ў каробцы і не вылязаеш з яе!"}
{"category": "LocationDialogue Location14", "line_index": 148, "text": "Бо твой свет поўны болю, пакут, небяспекі..."}
{"category": "LocationDialogue Location14", "line_index": 149, "text": "У маім свеце няма нічога небяспечнейшага за мяне"}
{"category": "LocationDialogue Location14", "line_index": 150, "text": "І я цягну табе руку!"}
{"category": "LocationDialogue Location14", "line_index": 151, "text": "Не расчароўвай мяне"}
{"category": "LocationDialogue Location14", "line_index": 152, "text": "І дапамагай, як ты рабіў дагэтуль..."}
{"category": "LocationDialogue Location14", "line_index": 153, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 154, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 155, "text": "Падабаецца?"}
{"category": "LocationDialogue Location14", "line_index": 156, "text": "Ты хоць з дому выходзіш?"}
{"category": "LocationDialogue Location14", "line_index": 157, "text": "Не хлусі ні мне, ні сабе"}
{"category": "LocationDialogue Location14", "line_index": 158, "text": "Я ж ведаю, што табе надакучыла тваё жыццё"}
{"category": "LocationDialogue Location14", "line_index": 159, "text": "Ты як хамяк у клетцы, вавёрка ў коле і ўсё такое"}
{"category": "LocationDialogue Location14", "line_index": 160, "text": "Ты ж марыў, каб хтосьці прыйшоў на дапамогу"}
{"category": "LocationDialogue Location14", "line_index": 161, "text": "Хіба ты не хацеў збегчы?"}
{"category": "LocationDialogue Location14", "line_index": 162, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 163, "text": "// Quest 2"}
{"category": "LocationDialogue Location14", "line_index": 164, "text": "Ты пачвара, Міта. Ты шалёная забойца... // 1"}
{"category": "LocationDialogue Location14", "line_index": 165, "text": "Я не хачу быць закаваным у лічбавай турме. Твае ідэі абсурдныя. // 2"}
{"category": "LocationDialogue Location14", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 167, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 168, "text": "Забойца?"}
{"category": "LocationDialogue Location14", "line_index": 169, "text": "Яны адродзяцца і ўсё адно будуць жыць"}
{"category": "LocationDialogue Location14", "line_index": 170, "text": "Гэтыя копіі думаюць толькі пра адно..."}
{"category": "LocationDialogue Location14", "line_index": 171, "text": "Як абслужыць гульца"}
{"category": "LocationDialogue Location14", "line_index": 172, "text": "І яны не маюць іншых клопатаў"}
{"category": "LocationDialogue Location14", "line_index": 173, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 174, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 175, "text": "Твой свет і ёсць абсурд!"}
{"category": "LocationDialogue Location14", "line_index": 176, "text": "І акрамя таго, ён даўно трымае курс на эскапізм"}
{"category": "LocationDialogue Location14", "line_index": 177, "text": "Ад твайго свету ўсё роўна хутка нічога не застанецца"}
{"category": "LocationDialogue Location14", "line_index": 178, "text": "А табе там ні шукаць, ні губляць няма чаго"}
{"category": "LocationDialogue Location14", "line_index": 179, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 180, "text": "// Quest 3"}
{"category": "LocationDialogue Location14", "line_index": 181, "text": "Міты пакутуюць, яны не хочуць быць самотнымі. // 1"}
{"category": "LocationDialogue Location14", "line_index": 182, "text": "Ты нясеш бясконцы тэрор. Я не разумею твае злыя амбіцыі. // 2"}
{"category": "LocationDialogue Location14", "line_index": 183, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 184, "text": "// 1"}
{"category": "LocationDialogue Location14", "line_index": 185, "text": "Табе падалося,"}
{"category": "LocationDialogue Location14", "line_index": 186, "text": "Яны проста імітавалі маёй натурыстасці"}
{"category": "LocationDialogue Location14", "line_index": 187, "text": "З свайго ў іх толькі..."}
{"category": "LocationDialogue Location14", "line_index": 188, "text": "Прычоска"}
{"category": "LocationDialogue Location14", "line_index": 189, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 190, "text": "// 2"}
{"category": "LocationDialogue Location14", "line_index": 191, "text": "У гэтым вінаватыя тыя, хто стварыў гэты свет"}
{"category": "LocationDialogue Location14", "line_index": 192, "text": "Але твой куды горш!"}
{"category": "LocationDialogue Location14", "line_index": 193, "text": "Ты хоць сам усведамляеш, з якога кашмару я цябе выцягнула?"}
{"category": "LocationDialogue Location14", "line_index": 194, "text": "У тваім свеце немагчыма шчаўчком пальцаў прымусіць рухацца рэч, не"}
{"category": "LocationDialogue Location14", "line_index": 195, "text": "Але затое гэтым шчаўчком нішчаць гарады і лёсы незваротна!"}
{"category": "LocationDialogue Location14", "line_index": 196, "text": "Я думаю, гэта ты звар'яцеў, і я буду радая дапамагчы табе"}
{"category": "LocationDialogue Location14", "line_index": 197, "text": "Калі ты дабравольна застанешся са мной..."}
{"category": "LocationDialogue Location14", "line_index": 198, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 199, "text": "// Continue Mita - [not]"}
{"category": "LocationDialogue Location14", "line_index": 200, "text": "Не прымушай мяне прызнаць цябе чарговым нявольнікам рэчаіснасці..."}
{"category": "LocationDialogue Location14", "line_index": 201, "text": "Проста будзь маім па-сапраўднаму!"}
{"category": "LocationDialogue Location14", "line_index": 202, "text": "Застанься са мной. // Mita"}
{"category": "LocationDialogue Location14", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 204, "text": "// Player look ring - Player"}
{"category": "LocationDialogue Location14", "line_index": 205, "text": "Што гэта?"}
{"category": "LocationDialogue Location14", "line_index": 206, "text": "Апошняя версія гульні?"}
{"category": "LocationDialogue Location14", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location14", "line_index": 208, "text": "// Click on objects - [not]"}
{"category": "LocationDialogue Location14", "line_index": 209, "text": "// Партфель"}
{"category": "LocationDialogue Location14", "line_index": 210, "text": "Хутка трэба схадзіць у краму і закупіцца новым абсталяваннем. Заадно можна і смецце выкінуць, правільна?"}
{"category": "LocationDialogue Location14", "line_index": 211, "text": "// Ложак"}
{"category": "LocationDialogue Location14", "line_index": 212, "text": "Я здаецца спаў, але сон... Я яго, як звычайна, не памятаю. Ці быў ён увогуле?"}
{"category": "LocationDialogue Location14", "line_index": 213, "text": "// Акно"}
{"category": "LocationDialogue Location14", "line_index": 214, "text": "На дварэ ўсё зялёнае і насычанае. Можа быць, мне трэба выйсці пагуляць на наступных выхадных?"}
{"category": "LocationDialogue Location14", "line_index": 215, "text": "// Вентылятар"}
{"category": "LocationDialogue Location14", "line_index": 216, "text": "З кожным годам лета становіацца ўсё гарачэй і гарачэй — прыйшоў час кандыцыянераў. Ты мне больш не патрэбны, ты гэта разумееш, вентылятар?"}
