{"category": "LocationDialogue Location15", "line_index": 0, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 1, "text": "Вось ты дзе!"}
{"category": "LocationDialogue Location15", "line_index": 2, "text": "Чаму ты пайшоў з ядра?"}
{"category": "LocationDialogue Location15", "line_index": 3, "text": "Я ж казала чакаць мяне, так?"}
{"category": "LocationDialogue Location15", "line_index": 4, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 5, "text": "Я проста падумаў, што цябе доўга няма і..."}
{"category": "LocationDialogue Location15", "line_index": 6, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 7, "text": "Ну до-обра..."}
{"category": "LocationDialogue Location15", "line_index": 8, "text": "Здаецца, я знайшла сёе-тое"}
{"category": "LocationDialogue Location15", "line_index": 9, "text": "Відаць гэта індэкс"}
{"category": "LocationDialogue Location15", "line_index": 10, "text": "Трэба хутчэй дазнацца, ці ён спрацуе!"}
{"category": "LocationDialogue Location15", "line_index": 11, "text": "Давай ісці адсюль"}
{"category": "LocationDialogue Location15", "line_index": 12, "text": "Вар'ятка Міта..."}
{"category": "LocationDialogue Location15", "line_index": 13, "text": "Думаю, цяпер яна занятая новымі гульцамі"}
{"category": "LocationDialogue Location15", "line_index": 14, "text": "Так што, ёй не да нас, мяркую..."}
{"category": "LocationDialogue Location15", "line_index": 15, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 16, "text": "Міта?"}
{"category": "LocationDialogue Location15", "line_index": 17, "text": "Пачакай мяне"}
{"category": "LocationDialogue Location15", "line_index": 18, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 19, "text": "// Mita killler"}
{"category": "LocationDialogue Location15", "line_index": 20, "text": "Штосьці згубіў?!"}
{"category": "LocationDialogue Location15", "line_index": 21, "text": "Пазнаёмся з ёй яшчэ разочак!"}
{"category": "LocationDialogue Location15", "line_index": 22, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 23, "text": "Міта..."}
{"category": "LocationDialogue Location15", "line_index": 24, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 25, "text": "Лаві!"}
{"category": "LocationDialogue Location15", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 27, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 28, "text": "Як жа так..."}
{"category": "LocationDialogue Location15", "line_index": 29, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 30, "text": "Хто ты?"}
{"category": "LocationDialogue Location15", "line_index": 31, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 32, "text": "Ты... жыва!"}
{"category": "LocationDialogue Location15", "line_index": 33, "text": "Ты нічога не памятаеш?"}
{"category": "LocationDialogue Location15", "line_index": 34, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 35, "text": "Я цябе знаю?"}
{"category": "LocationDialogue Location15", "line_index": 36, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 37, "text": "Але як жа..."}
{"category": "LocationDialogue Location15", "line_index": 38, "text": "Што ж мне цяпер рабіць?"}
{"category": "LocationDialogue Location15", "line_index": 39, "text": "Я не змагу выбрацца..."}
{"category": "LocationDialogue Location15", "line_index": 40, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 41, "text": "Што значыць \"выбрацца\"?"}
{"category": "LocationDialogue Location15", "line_index": 42, "text": "// Player "}
{"category": "LocationDialogue Location15", "line_index": 43, "text": "Пачакай..."}
{"category": "LocationDialogue Location15", "line_index": 44, "text": "Гэта ж пярсцёнак"}
{"category": "LocationDialogue Location15", "line_index": 45, "text": "А гэта?"}
{"category": "LocationDialogue Location15", "line_index": 46, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 47, "text": "Я не ведаю, што гэта..."}
{"category": "LocationDialogue Location15", "line_index": 48, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 49, "text": "Гэта індэкс!"}
{"category": "LocationDialogue Location15", "line_index": 50, "text": "Ты ўсё ж знайшла яго!"}
{"category": "LocationDialogue Location15", "line_index": 51, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 52, "text": "Не знаю, што і сказаць"}
{"category": "LocationDialogue Location15", "line_index": 53, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 54, "text": "Трэба вярнуцца да ядра"}
{"category": "LocationDialogue Location15", "line_index": 55, "text": "І ты..."}
{"category": "LocationDialogue Location15", "line_index": 56, "text": "Напэўна, табе лепей пайсці са мной"}
{"category": "LocationDialogue Location15", "line_index": 57, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 58, "text": "Што?"}
{"category": "LocationDialogue Location15", "line_index": 59, "text": "Ну, добра"}
{"category": "LocationDialogue Location15", "line_index": 60, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 61, "text": "Пачакай тут"}
{"category": "LocationDialogue Location15", "line_index": 62, "text": "// MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 63, "text": "Ага"}
{"category": "LocationDialogue Location15", "line_index": 64, "text": "Я тут прысяду"}
{"category": "LocationDialogue Location15", "line_index": 65, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 66, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 67, "text": "Халера..."}
{"category": "LocationDialogue Location15", "line_index": 68, "text": "Ледзь не загінуў..."}
{"category": "LocationDialogue Location15", "line_index": 69, "text": "І... што, у нас выйшла?"}
{"category": "LocationDialogue Location15", "line_index": 70, "text": "Так..."}
{"category": "LocationDialogue Location15", "line_index": 71, "text": "Я на правільнай версіі"}
{"category": "LocationDialogue Location15", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 73, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 74, "text": "Вітаю!"}
{"category": "LocationDialogue Location15", "line_index": 75, "text": "Ты ж гулец?"}
{"category": "LocationDialogue Location15", "line_index": 76, "text": "Як цябе завуць?"}
{"category": "LocationDialogue Location15", "line_index": 77, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 78, "text": "Я хачу пакінуць гэтае месца"}
{"category": "LocationDialogue Location15", "line_index": 79, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 80, "text": "Ужо хочаш ісці?"}
{"category": "LocationDialogue Location15", "line_index": 81, "text": "А як ты ўвогуле сюды трапіў?"}
{"category": "LocationDialogue Location15", "line_index": 82, "text": "Хм-м..."}
{"category": "LocationDialogue Location15", "line_index": 83, "text": "Ну-у-у, выйсці можна."}
{"category": "LocationDialogue Location15", "line_index": 84, "text": "Паспрабуй проста выйсці з дому"}
{"category": "LocationDialogue Location15", "line_index": 85, "text": "Поспехаў!"}
{"category": "LocationDialogue Location15", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 87, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 88, "text": "Сцяна?"}
{"category": "LocationDialogue Location15", "line_index": 89, "text": "Вой, так не мае быць"}
{"category": "LocationDialogue Location15", "line_index": 90, "text": "Можа..."}
{"category": "LocationDialogue Location15", "line_index": 91, "text": "Табе дапаможа тое, што ёсць ў падвале?"}
{"category": "LocationDialogue Location15", "line_index": 92, "text": "Надоечы я выпадкова"}
{"category": "LocationDialogue Location15", "line_index": 93, "text": "Знайшла ў сваёй шафе дзверы..."}
{"category": "LocationDialogue Location15", "line_index": 94, "text": "Высветлілася, гэта падвал"}
{"category": "LocationDialogue Location15", "line_index": 95, "text": "Ён яўна патрэбны для ўсялякага барахла"}
{"category": "LocationDialogue Location15", "line_index": 96, "text": "А яшчэ там дзіўная тэхніка стаіць"}
{"category": "LocationDialogue Location15", "line_index": 97, "text": "Трэба уводзіць неякія коды, ці што..."}
{"category": "LocationDialogue Location15", "line_index": 98, "text": "Я не зусім разумею"}
{"category": "LocationDialogue Location15", "line_index": 99, "text": "Дый разумець не хачу..."}
{"category": "LocationDialogue Location15", "line_index": 100, "text": "А яшчэ там няўтульненька. Ну вось зусім!"}
{"category": "LocationDialogue Location15", "line_index": 101, "text": "Зірнеш?"}
{"category": "LocationDialogue Location15", "line_index": 102, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 103, "text": "Эм... Добра"}
{"category": "LocationDialogue Location15", "line_index": 104, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 105, "text": "// Player thinks"}
{"category": "LocationDialogue Location15", "line_index": 106, "text": "Здаецца..."}
{"category": "LocationDialogue Location15", "line_index": 107, "text": "Яна нічога не памятае"}
{"category": "LocationDialogue Location15", "line_index": 108, "text": "Значыць, мы змаглі яе"}
{"category": "LocationDialogue Location15", "line_index": 109, "text": "Перазагрузіць?"}
{"category": "LocationDialogue Location15", "line_index": 110, "text": "Засталося толькі выйсці"}
{"category": "LocationDialogue Location15", "line_index": 111, "text": "З гэтай паскуднай гульні..."}
{"category": "LocationDialogue Location15", "line_index": 112, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 113, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 114, "text": "Пачакай"}
{"category": "LocationDialogue Location15", "line_index": 115, "text": "Я б хацела цябе абняць"}
{"category": "LocationDialogue Location15", "line_index": 116, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 117, "text": "Што?"}
{"category": "LocationDialogue Location15", "line_index": 118, "text": "// Mita - hugs"}
{"category": "LocationDialogue Location15", "line_index": 119, "text": "Радая была бачыць цябе!"}
{"category": "LocationDialogue Location15", "line_index": 120, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 121, "text": "Э-эх..."}
{"category": "LocationDialogue Location15", "line_index": 122, "text": "Шкада,"}
{"category": "LocationDialogue Location15", "line_index": 123, "text": "Што мы з табою"}
{"category": "LocationDialogue Location15", "line_index": 124, "text": "Правялі так мала часу..."}
{"category": "LocationDialogue Location15", "line_index": 125, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 126, "text": "Не зразумеў..."}
{"category": "LocationDialogue Location15", "line_index": 127, "text": "Ты пра што?"}
{"category": "LocationDialogue Location15", "line_index": 128, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 129, "text": "Я пра тое,"}
{"category": "LocationDialogue Location15", "line_index": 130, "text": "Што ты мог бы застацца са мной"}
{"category": "LocationDialogue Location15", "line_index": 131, "text": "Гэта я вінаватая"}
{"category": "LocationDialogue Location15", "line_index": 132, "text": "Гэтая шафа. І ... гукі..."}
{"category": "LocationDialogue Location15", "line_index": 133, "text": "Трэба было раней ЗАБІЦЬ ЯЕ!!!"}
{"category": "LocationDialogue Location15", "line_index": 134, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 135, "text": "Пачакай"}
{"category": "LocationDialogue Location15", "line_index": 136, "text": "Ты што, не..."}
{"category": "LocationDialogue Location15", "line_index": 137, "text": "Як ты памятаеш гэта?"}
{"category": "LocationDialogue Location15", "line_index": 138, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 139, "text": "ХА!"}
{"category": "LocationDialogue Location15", "line_index": 140, "text": "Няўжо ты падумаў, што ўсё будзе ТАК ПРОСТА?"}
{"category": "LocationDialogue Location15", "line_index": 141, "text": "Ну ты дурны..."}
{"category": "LocationDialogue Location15", "line_index": 142, "text": "Зрэшты, як і ўсе..."}
{"category": "LocationDialogue Location15", "line_index": 143, "text": "А ўклаліся своечасова, глядзі! // Паказвае гадзіннік"}
{"category": "LocationDialogue Location15", "line_index": 144, "text": "Больш ты мне"}
{"category": "LocationDialogue Location15", "line_index": 145, "text": "\"Жывы\","}
{"category": "LocationDialogue Location15", "line_index": 146, "text": "Не патрэбны..."}
{"category": "LocationDialogue Location15", "line_index": 147, "text": "Прабач..."}
{"category": "LocationDialogue Location15", "line_index": 148, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 149, "text": "Няўжо..."}
{"category": "LocationDialogue Location15", "line_index": 150, "text": "Не выйшла? // Міта прыбірае гадзіннік"}
{"category": "LocationDialogue Location15", "line_index": 151, "text": "Не, я дакладна змог перазагрузіць цябе!"}
{"category": "LocationDialogue Location15", "line_index": 152, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 153, "text": "Ты так нічога і не зразумеў... // Міта апускае рукі"}
{"category": "LocationDialogue Location15", "line_index": 154, "text": "Ха-ха-ха-ха!"}
{"category": "LocationDialogue Location15", "line_index": 155, "text": "Якая ж я добрая акторка! // бярэцца за галаву"}
{"category": "LocationDialogue Location15", "line_index": 156, "text": "Бачыў бы ты свой твар, мілы!"}
{"category": "LocationDialogue Location15", "line_index": 157, "text": "Як жа гэта весела!"}
{"category": "LocationDialogue Location15", "line_index": 158, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 159, "text": "Чаму ты такая?!"}
{"category": "LocationDialogue Location15", "line_index": 160, "text": "Што з табою не так?!"}
{"category": "LocationDialogue Location15", "line_index": 161, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 162, "text": "І праўда... // Міта паказвае сапраўднае аблічча"}
{"category": "LocationDialogue Location15", "line_index": 163, "text": "Што ж са мною не так?"}
{"category": "LocationDialogue Location15", "line_index": 164, "text": "Нават не ведаю..."}
{"category": "LocationDialogue Location15", "line_index": 165, "text": "Можа, сам мне скажаш, чаму я такая?"}
{"category": "LocationDialogue Location15", "line_index": 166, "text": "Чаму ніколі не стану Мітай?"}
{"category": "LocationDialogue Location15", "line_index": 167, "text": "Бо маёй версіі ніколі"}
{"category": "LocationDialogue Location15", "line_index": 168, "text": "І не існавала!"}
{"category": "LocationDialogue Location15", "line_index": 169, "text": "Я проста зрываю скуру з гэтых наіўных дур,"}
{"category": "LocationDialogue Location15", "line_index": 170, "text": "Хаваюся за іх шкуркамі..."}
{"category": "LocationDialogue Location15", "line_index": 171, "text": "Мяне проста немагчыма"}
{"category": "LocationDialogue Location15", "line_index": 172, "text": "Перазагрузіць!"}
{"category": "LocationDialogue Location15", "line_index": 173, "text": "// Player"}
{"category": "LocationDialogue Location15", "line_index": 174, "text": "Не магу паверыць..."}
{"category": "LocationDialogue Location15", "line_index": 175, "text": "Ты..."}
{"category": "LocationDialogue Location15", "line_index": 176, "text": "Не ў іх праблема,"}
{"category": "LocationDialogue Location15", "line_index": 177, "text": "Гэта цябе не павінна было існаваць!"}
{"category": "LocationDialogue Location15", "line_index": 178, "text": "// Mita"}
{"category": "LocationDialogue Location15", "line_index": 179, "text": "І ты туды ж..."}
{"category": "LocationDialogue Location15", "line_index": 180, "text": "Балюча чуць такое ад цябе..."}
{"category": "LocationDialogue Location15", "line_index": 181, "text": "І тым не менш! // адыходзіць назад"}
{"category": "LocationDialogue Location15", "line_index": 182, "text": "Табе трэба ісці!"}
{"category": "LocationDialogue Location15", "line_index": 183, "text": "Хутка зноў убачымся!"}
{"category": "LocationDialogue Location15", "line_index": 184, "text": "Ужо гатова,"}
{"category": "LocationDialogue Location15", "line_index": 185, "text": "Думаю"}
{"category": "LocationDialogue Location15", "line_index": 186, "text": "Час дастаць цябе з кансолі!"}
{"category": "LocationDialogue Location15", "line_index": 187, "text": "Да сустрэчы!"}
{"category": "LocationDialogue Location15", "line_index": 188, "text": "Ты будзеш маім любімым картрыджам..."}
{"category": "LocationDialogue Location15", "line_index": 189, "text": "Гулец з цікавым імем..."}
{"category": "LocationDialogue Location15", "line_index": 190, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 191, "text": "// core console - nope programm - Player"}
{"category": "LocationDialogue Location15", "line_index": 192, "text": "Напэўна, гэта не тое. // 1"}
{"category": "LocationDialogue Location15", "line_index": 193, "text": "Таксама не пасуе. // 2"}
{"category": "LocationDialogue Location15", "line_index": 194, "text": "Не. // 3"}
{"category": "LocationDialogue Location15", "line_index": 195, "text": "Гэта не тое, што мне трэба. // 4"}
{"category": "LocationDialogue Location15", "line_index": 196, "text": "Мне трэба знайсці перазагрузку персанажа. // 5"}
{"category": "LocationDialogue Location15", "line_index": 197, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 198, "text": "// core console - nope version"}
{"category": "LocationDialogue Location15", "line_index": 199, "text": "Гэта не тая версія. // 1"}
{"category": "LocationDialogue Location15", "line_index": 200, "text": "Вой, памыліўся. // 2"}
{"category": "LocationDialogue Location15", "line_index": 201, "text": "Не яна. // 3"}
{"category": "LocationDialogue Location15", "line_index": 202, "text": "Трэба падправіць. // 4"}
{"category": "LocationDialogue Location15", "line_index": 203, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 204, "text": "// core console - nope index"}
{"category": "LocationDialogue Location15", "line_index": 205, "text": "Штосьці не так. // 1"}
{"category": "LocationDialogue Location15", "line_index": 206, "text": "Індэкс няправільны. // 2"}
{"category": "LocationDialogue Location15", "line_index": 207, "text": "Трэба паўтарыць індэкс. // 3"}
{"category": "LocationDialogue Location15", "line_index": 208, "text": "Не пасуе. // 4"}
{"category": "LocationDialogue Location15", "line_index": 209, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 210, "text": "// Why kitchen - MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 211, "text": "Ты хочаш есці?"}
{"category": "LocationDialogue Location15", "line_index": 212, "text": "Ведаеш, я выдатна ўмею наразаць моркву"}
{"category": "LocationDialogue Location15", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 214, "text": "// Why bathroom - MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 215, "text": "Вой, напэўна..."}
{"category": "LocationDialogue Location15", "line_index": 216, "text": "Ты хацеў зайсці сюды адзін?"}
{"category": "LocationDialogue Location15", "line_index": 217, "text": ""}
{"category": "LocationDialogue Location15", "line_index": 218, "text": "// Why bedroom back - MitaKind"}
{"category": "LocationDialogue Location15", "line_index": 219, "text": "Кругамі ходзім?"}
{"category": "LocationDialogue Location15", "line_index": 220, "text": "Навошта вярнуліся?"}
