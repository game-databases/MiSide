{"category": "LocationDialogue Location4", "line_index": 0, "text": "Міта?// Player"}
{"category": "LocationDialogue Location4", "line_index": 1, "text": "Вой, ты ўжо ачуняў? // Mita"}
{"category": "LocationDialogue Location4", "line_index": 2, "text": "Як ты тут апынулася? // Player"}
{"category": "LocationDialogue Location4", "line_index": 3, "text": "Ты ж была побач? // Player"}
{"category": "LocationDialogue Location4", "line_index": 4, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 5, "text": "Не,"}
{"category": "LocationDialogue Location4", "line_index": 6, "text": "Ты знерухомеў каля люстра"}
{"category": "LocationDialogue Location4", "line_index": 7, "text": "Я і пайшла"}
{"category": "LocationDialogue Location4", "line_index": 8, "text": "А што з пакоямі? // Player"}
{"category": "LocationDialogue Location4", "line_index": 9, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 10, "text": "Я пераставіла так,"}
{"category": "LocationDialogue Location4", "line_index": 11, "text": "Каб табе было звычней"}
{"category": "LocationDialogue Location4", "line_index": 12, "text": "То-бок"}
{"category": "LocationDialogue Location4", "line_index": 13, "text": "Пакоі не ў рад,"}
{"category": "LocationDialogue Location4", "line_index": 14, "text": "А як трэба"}
{"category": "LocationDialogue Location4", "line_index": 15, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 16, "text": "Не трэ было"}
{"category": "LocationDialogue Location4", "line_index": 17, "text": "Я ўжо нібы пачаў прызвычайвацца"}
{"category": "LocationDialogue Location4", "line_index": 18, "text": "Думаю, так табе будзе ўтульней... // Mita"}
{"category": "LocationDialogue Location4", "line_index": 19, "text": "// Mita card game"}
{"category": "LocationDialogue Location4", "line_index": 20, "text": "Так"}
{"category": "LocationDialogue Location4", "line_index": 21, "text": "пачнём гульню?"}
{"category": "LocationDialogue Location4", "line_index": 22, "text": "Раскажу коратка"}
{"category": "LocationDialogue Location4", "line_index": 23, "text": "Фішка паказвае тып пашкоджанняў, "}
{"category": "LocationDialogue Location4", "line_index": 24, "text": "Напрыклад, здароўе"}
{"category": "LocationDialogue Location4", "line_index": 25, "text": "Кладзём карткі,"}
{"category": "LocationDialogue Location4", "line_index": 26, "text": "Калі на тваёй картцы здароўя"}
{"category": "LocationDialogue Location4", "line_index": 27, "text": "Больш,"}
{"category": "LocationDialogue Location4", "line_index": 28, "text": "Чым у мяне,"}
{"category": "LocationDialogue Location4", "line_index": 29, "text": "То ты перамог"}
{"category": "LocationDialogue Location4", "line_index": 30, "text": "Бяры карты"}
{"category": "LocationDialogue Location4", "line_index": 31, "text": "Цяпер я"}
{"category": "LocationDialogue Location4", "line_index": 32, "text": "Ого! "}
{"category": "LocationDialogue Location4", "line_index": 33, "text": "Мне трапіліся смачныя карты"}
{"category": "LocationDialogue Location4", "line_index": 34, "text": "Я хаджу першай!"}
{"category": "LocationDialogue Location4", "line_index": 35, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 36, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 37, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 38, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 39, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 40, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 42, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 44, "text": "Цяпер ты!"}
{"category": "LocationDialogue Location4", "line_index": 45, "text": "Твой ход!"}
{"category": "LocationDialogue Location4", "line_index": 46, "text": "Ага"}
{"category": "LocationDialogue Location4", "line_index": 47, "text": "Твая чарга!"}
{"category": "LocationDialogue Location4", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 49, "text": "Ходзім на здароўе!"}
{"category": "LocationDialogue Location4", "line_index": 50, "text": "Тут галоўнае — сіла!"}
{"category": "LocationDialogue Location4", "line_index": 51, "text": "Глядзі на ахову!"}
{"category": "LocationDialogue Location4", "line_index": 52, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 53, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 54, "text": "Твая ўзяла!"}
{"category": "LocationDialogue Location4", "line_index": 55, "text": "Ты перамог!"}
{"category": "LocationDialogue Location4", "line_index": 56, "text": "Ты перамагаеш"}
{"category": "LocationDialogue Location4", "line_index": 57, "text": "Ах ты..."}
{"category": "LocationDialogue Location4", "line_index": 58, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 59, "text": "Мая перамога!"}
{"category": "LocationDialogue Location4", "line_index": 60, "text": "Я пераможная!"}
{"category": "LocationDialogue Location4", "line_index": 61, "text": "Перамога за мною!"}
{"category": "LocationDialogue Location4", "line_index": 62, "text": "Ням, з'ела!"}
{"category": "LocationDialogue Location4", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 64, "text": "Нічыя"}
{"category": "LocationDialogue Location4", "line_index": 65, "text": "Ні туды, ні сюды"}
{"category": "LocationDialogue Location4", "line_index": 66, "text": "Ні наперад, ні назад!"}
{"category": "LocationDialogue Location4", "line_index": 67, "text": "Неяк усё аднолькава..."}
{"category": "LocationDialogue Location4", "line_index": 68, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 69, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 70, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 71, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 72, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 73, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 76, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 77, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 78, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 79, "text": "// Player - Гульня прыпыняецца"}
{"category": "LocationDialogue Location4", "line_index": 80, "text": "Што за гук там?"}
{"category": "LocationDialogue Location4", "line_index": 81, "text": "Ён раздаецца з шафы"}
{"category": "LocationDialogue Location4", "line_index": 82, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 83, "text": "Гук?"}
{"category": "LocationDialogue Location4", "line_index": 84, "text": "Які гук?"}
{"category": "LocationDialogue Location4", "line_index": 85, "text": "Там не было ніякіх гукаў"}
{"category": "LocationDialogue Location4", "line_index": 86, "text": "Скажы мне, як ён гучыць?"}
{"category": "LocationDialogue Location4", "line_index": 87, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 88, "text": "Стук, нібы там хтосьці ёсць"}
{"category": "LocationDialogue Location4", "line_index": 89, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 90, "text": "Але там..."}
{"category": "LocationDialogue Location4", "line_index": 91, "text": "Нікога няма."}
{"category": "LocationDialogue Location4", "line_index": 92, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 93, "text": "Я хачу праверыць"}
{"category": "LocationDialogue Location4", "line_index": 94, "text": "Гэта вельмі дзіўна"}
{"category": "LocationDialogue Location4", "line_index": 95, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 96, "text": "Навошта?.."}
{"category": "LocationDialogue Location4", "line_index": 97, "text": "Зноў..."}
{"category": "LocationDialogue Location4", "line_index": 98, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 99, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 100, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 101, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 102, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 103, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 104, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 105, "text": "Ты што?!"}
{"category": "LocationDialogue Location4", "line_index": 106, "text": "Там..."}
{"category": "LocationDialogue Location4", "line_index": 107, "text": "Мая бялізна"}
{"category": "LocationDialogue Location4", "line_index": 108, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 109, "text": "Ты штосьці хаваеш?"}
{"category": "LocationDialogue Location4", "line_index": 110, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 111, "text": "Чаму ты мне не верыш?"}
{"category": "LocationDialogue Location4", "line_index": 112, "text": "Што я раблю не так?"}
{"category": "LocationDialogue Location4", "line_index": 113, "text": "Я проста хачу,"}
{"category": "LocationDialogue Location4", "line_index": 114, "text": "Каб ты пабыў са мной!"}
{"category": "LocationDialogue Location4", "line_index": 115, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 116, "text": "Я хацеў бы паабяцаць такое, але што будзе далей?"}
{"category": "LocationDialogue Location4", "line_index": 117, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 118, "text": "Чаму цябе так цягне да шафы?"}
{"category": "LocationDialogue Location4", "line_index": 119, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 120, "text": "Я проста хачу ведаць, што гэта за гукі!"}
{"category": "LocationDialogue Location4", "line_index": 121, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 122, "text": "Проста..."}
{"category": "LocationDialogue Location4", "line_index": 123, "text": "Гэты свет — "}
{"category": "LocationDialogue Location4", "line_index": 124, "text": "Гэта ўсяго толькі гэтыя чатыры пакоі"}
{"category": "LocationDialogue Location4", "line_index": 125, "text": "Табе, напэўна, будзе мала гэтага?"}
{"category": "LocationDialogue Location4", "line_index": 126, "text": "Можа, ты проста паспрабуеш застацца са мной?.."}
{"category": "LocationDialogue Location4", "line_index": 127, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 129, "text": "// Mita (No)"}
{"category": "LocationDialogue Location4", "line_index": 130, "text": "Я зразумела"}
{"category": "LocationDialogue Location4", "line_index": 131, "text": "Зноў..."}
{"category": "LocationDialogue Location4", "line_index": 132, "text": "Калі хочаш даведацца, што там, "}
{"category": "LocationDialogue Location4", "line_index": 133, "text": "Тады зараз..."}
{"category": "LocationDialogue Location4", "line_index": 134, "text": "Даведаешся!"}
{"category": "LocationDialogue Location4", "line_index": 135, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 137, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 138, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 139, "text": "Што за..."}
{"category": "LocationDialogue Location4", "line_index": 140, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 141, "text": "Бывае і такое. "}
{"category": "LocationDialogue Location4", "line_index": 142, "text": "Пакой не паспеў загрузіцца. "}
{"category": "LocationDialogue Location4", "line_index": 143, "text": "Пачакай крыху..."}
{"category": "LocationDialogue Location4", "line_index": 144, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 145, "text": "Гэта дзіўна"}
{"category": "LocationDialogue Location4", "line_index": 146, "text": "Мы ў нечым тэлефоне?"}
{"category": "LocationDialogue Location4", "line_index": 147, "text": "І гэты тэлефон так павольна загружае?"}
{"category": "LocationDialogue Location4", "line_index": 148, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 149, "text": "Не"}
{"category": "LocationDialogue Location4", "line_index": 150, "text": "Проста не ўсё так ідэальна"}
{"category": "LocationDialogue Location4", "line_index": 151, "text": "Зроблена ў гэтым свеце"}
{"category": "LocationDialogue Location4", "line_index": 152, "text": "І нас падгружае"}
{"category": "LocationDialogue Location4", "line_index": 153, "text": "Ядро гэтага свету"}
{"category": "LocationDialogue Location4", "line_index": 154, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 155, "text": "Ядро?"}
{"category": "LocationDialogue Location4", "line_index": 156, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 157, "text": "Нічога дзіўнага, так?"}
{"category": "LocationDialogue Location4", "line_index": 158, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 159, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 160, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 161, "text": "Мы можам"}
{"category": "LocationDialogue Location4", "line_index": 162, "text": "Пагуляць у прыстаўку"}
{"category": "LocationDialogue Location4", "line_index": 163, "text": "Альбо ў карты, "}
{"category": "LocationDialogue Location4", "line_index": 164, "text": "Выбірай!"}
{"category": "LocationDialogue Location4", "line_index": 165, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 166, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 167, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 168, "text": "// Mita play fight"}
{"category": "LocationDialogue Location4", "line_index": 169, "text": "Паб'ёмся?"}
{"category": "LocationDialogue Location4", "line_index": 170, "text": "Трэба перамагчы"}
{"category": "LocationDialogue Location4", "line_index": 171, "text": "Чатыры разы"}
{"category": "LocationDialogue Location4", "line_index": 172, "text": "Давай "}
{"category": "LocationDialogue Location4", "line_index": 173, "text": "Думаю, спачатку"}
{"category": "LocationDialogue Location4", "line_index": 174, "text": "Буду паддавацца табе"}
{"category": "LocationDialogue Location4", "line_index": 175, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 176, "text": "// + 1"}
{"category": "LocationDialogue Location4", "line_index": 177, "text": "Малайчына"}
{"category": "LocationDialogue Location4", "line_index": 178, "text": "Ну а цяпер трымай порткі!"}
{"category": "LocationDialogue Location4", "line_index": 179, "text": "// + 2"}
{"category": "LocationDialogue Location4", "line_index": 180, "text": "Ого!"}
{"category": "LocationDialogue Location4", "line_index": 181, "text": "Так, цяпер"}
{"category": "LocationDialogue Location4", "line_index": 182, "text": "Я пачынаю гуляць па-сур'ёзнаму"}
{"category": "LocationDialogue Location4", "line_index": 183, "text": "// + 3"}
{"category": "LocationDialogue Location4", "line_index": 184, "text": "Ах ты!"}
{"category": "LocationDialogue Location4", "line_index": 185, "text": "А зможаш цяпер"}
{"category": "LocationDialogue Location4", "line_index": 186, "text": "Мяне перамагчы?"}
{"category": "LocationDialogue Location4", "line_index": 187, "text": "// + 4"}
{"category": "LocationDialogue Location4", "line_index": 188, "text": "Ты..."}
{"category": "LocationDialogue Location4", "line_index": 189, "text": "Проста..."}
{"category": "LocationDialogue Location4", "line_index": 190, "text": "Надзвычайны! Твае пальцы — гэта штосьці!"}
{"category": "LocationDialogue Location4", "line_index": 191, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 192, "text": "// - 1"}
{"category": "LocationDialogue Location4", "line_index": 193, "text": "Ну ты чаго???"}
{"category": "LocationDialogue Location4", "line_index": 194, "text": "Так нецікава"}
{"category": "LocationDialogue Location4", "line_index": 195, "text": "// - 2"}
{"category": "LocationDialogue Location4", "line_index": 196, "text": "Ну,"}
{"category": "LocationDialogue Location4", "line_index": 197, "text": "Справа зробленая — фаталіці, калі што."}
{"category": "LocationDialogue Location4", "line_index": 198, "text": "// - 3"}
{"category": "LocationDialogue Location4", "line_index": 199, "text": "Так,"}
{"category": "LocationDialogue Location4", "line_index": 200, "text": "Бярыся за галаву або застанешся небаракам на ўсё жыццё!"}
{"category": "LocationDialogue Location4", "line_index": 201, "text": "// - 4"}
{"category": "LocationDialogue Location4", "line_index": 202, "text": "Ды ты чаго???"}
{"category": "LocationDialogue Location4", "line_index": 203, "text": "Я выбіла з цябе ўсю белую вадкасць."}
{"category": "LocationDialogue Location4", "line_index": 204, "text": "Трэба было проста пастарацца..."}
{"category": "LocationDialogue Location4", "line_index": 205, "text": "Акурат таму ў мяне ўсё атрымоўваецца!"}
{"category": "LocationDialogue Location4", "line_index": 206, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 208, "text": "Ну добра. "}
{"category": "LocationDialogue Location4", "line_index": 209, "text": "У карты зыграем?"}
{"category": "LocationDialogue Location4", "line_index": 210, "text": "У маёй спальні, запрашаю..."}
{"category": "LocationDialogue Location4", "line_index": 211, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 212, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 213, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 214, "text": "// Player [ERROR]"}
{"category": "LocationDialogue Location4", "line_index": 215, "text": "Што гэта?"}
{"category": "LocationDialogue Location4", "line_index": 216, "text": "А дзе?.."}
{"category": "LocationDialogue Location4", "line_index": 217, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 218, "text": "Вой, "}
{"category": "LocationDialogue Location4", "line_index": 219, "text": "Прабач"}
{"category": "LocationDialogue Location4", "line_index": 220, "text": "Я спампавала адзін файл"}
{"category": "LocationDialogue Location4", "line_index": 221, "text": "З інтэрнтэту:"}
{"category": "LocationDialogue Location4", "line_index": 222, "text": "Хацела, каб было прыгожа"}
{"category": "LocationDialogue Location4", "line_index": 223, "text": "На вуліцы,"}
{"category": "LocationDialogue Location4", "line_index": 224, "text": "Але высветлілася,  "}
{"category": "LocationDialogue Location4", "line_index": 225, "text": "Што фармат файла не той... "}
{"category": "LocationDialogue Location4", "line_index": 226, "text": "Я пазней усё выпраўлю"}
{"category": "LocationDialogue Location4", "line_index": 227, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 228, "text": "Таму мы не можам выйсці з кватэры?  "}
{"category": "LocationDialogue Location4", "line_index": 229, "text": "Акурат таму, ага. // Mita"}
{"category": "LocationDialogue Location4", "line_index": 230, "text": "// Mita shy"}
{"category": "LocationDialogue Location4", "line_index": 231, "text": "Ну-у..."}
{"category": "LocationDialogue Location4", "line_index": 232, "text": "Што такое?"}
{"category": "LocationDialogue Location4", "line_index": 233, "text": "Ты штосьці хочаш?"}
{"category": "LocationDialogue Location4", "line_index": 234, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 235, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 236, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 237, "text": "// Player - насценныя гадзіннікі"}
{"category": "LocationDialogue Location4", "line_index": 238, "text": "Гэты гадзіннік —"}
{"category": "LocationDialogue Location4", "line_index": 239, "text": "Што за час яны паказваюць?"}
{"category": "LocationDialogue Location4", "line_index": 240, "text": "Час унутры гульні?   "}
{"category": "LocationDialogue Location4", "line_index": 241, "text": "Ці такі ж, як на маім тэлефоне?"}
{"category": "LocationDialogue Location4", "line_index": 242, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 243, "text": "Ну як сказаць... "}
{"category": "LocationDialogue Location4", "line_index": 244, "text": "Наогул,"}
{"category": "LocationDialogue Location4", "line_index": 245, "text": "Няважна, каторая гадзіна"}
{"category": "LocationDialogue Location4", "line_index": 246, "text": "Ці позна, ці рана "}
{"category": "LocationDialogue Location4", "line_index": 247, "text": "У маім доме"}
{"category": "LocationDialogue Location4", "line_index": 248, "text": "Такія моцныя дзяўчыны як я"}
{"category": "LocationDialogue Location4", "line_index": 249, "text": "Не знаюць стомы!   "}
{"category": "LocationDialogue Location4", "line_index": 250, "text": "Захачу — і будзе вечная вясна!"}
{"category": "LocationDialogue Location4", "line_index": 251, "text": "І вечны поўдзень!"}
{"category": "LocationDialogue Location4", "line_index": 252, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 253, "text": "Цікава..."}
{"category": "LocationDialogue Location4", "line_index": 254, "text": "І вусцішна адначасова. "}
{"category": "LocationDialogue Location4", "line_index": 255, "text": "Засесці ў адным імгненні назаўжды... "}
{"category": "LocationDialogue Location4", "line_index": 256, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 257, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 258, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 259, "text": "// Player - фотаздымкі Міты"}
{"category": "LocationDialogue Location4", "line_index": 260, "text": "Файныя фоткі.."}
{"category": "LocationDialogue Location4", "line_index": 261, "text": "Мяркую, на іх ты?"}
{"category": "LocationDialogue Location4", "line_index": 262, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 263, "text": "Ага"}
{"category": "LocationDialogue Location4", "line_index": 264, "text": "Мне таксама падабаецца"}
{"category": "LocationDialogue Location4", "line_index": 265, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 266, "text": "А фатаграфаваў цябе хто?"}
{"category": "LocationDialogue Location4", "line_index": 267, "text": "Ёсць яшчэ хтосьці ў гэтым свеце? "}
{"category": "LocationDialogue Location4", "line_index": 268, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 269, "text": "Можна сказаць, што ёсць..."}
{"category": "LocationDialogue Location4", "line_index": 270, "text": "І я цябе пазнаёмлю з імі,"}
{"category": "LocationDialogue Location4", "line_index": 271, "text": "Але пакуль што не той час"}
{"category": "LocationDialogue Location4", "line_index": 272, "text": "Распавядаць пра такую прыемную кампанію..."}
{"category": "LocationDialogue Location4", "line_index": 273, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 274, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 275, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 276, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 277, "text": "// Player - Партал"}
{"category": "LocationDialogue Location4", "line_index": 278, "text": "А куды знік партал? "}
{"category": "LocationDialogue Location4", "line_index": 279, "text": "Ці як ты яго называеш? "}
{"category": "LocationDialogue Location4", "line_index": 280, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 281, "text": "Маім"}
{"category": "LocationDialogue Location4", "line_index": 282, "text": "Чароўным шчаўчком"}
{"category": "LocationDialogue Location4", "line_index": 283, "text": "Я яго перамясціла"}
{"category": "LocationDialogue Location4", "line_index": 284, "text": "У іншае месца"}
{"category": "LocationDialogue Location4", "line_index": 285, "text": "Гэты партал нам цяпер не патрэбны,"}
{"category": "LocationDialogue Location4", "line_index": 286, "text": "Ён будзе замінаць нам"}
{"category": "LocationDialogue Location4", "line_index": 287, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 288, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 289, "text": "// Player - люстра ў спальні"}
{"category": "LocationDialogue Location4", "line_index": 290, "text": "Так дзіўна глядзець у люстра, "}
{"category": "LocationDialogue Location4", "line_index": 291, "text": "Што не адбівае..."}
{"category": "LocationDialogue Location4", "line_index": 292, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 293, "text": "Адбіццё можна ўключыць,"}
{"category": "LocationDialogue Location4", "line_index": 294, "text": "Калі ты хочаш, "}
{"category": "LocationDialogue Location4", "line_index": 295, "text": "Але ці патрэбна яно? "}
{"category": "LocationDialogue Location4", "line_index": 296, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 297, "text": "Вядома трэба"}
{"category": "LocationDialogue Location4", "line_index": 298, "text": "Ці... ёсць нейкія наступствы? "}
{"category": "LocationDialogue Location4", "line_index": 299, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 300, "text": "Так. "}
{"category": "LocationDialogue Location4", "line_index": 301, "text": "Мы будзем рухацца павольна і з затрымкай"}
{"category": "LocationDialogue Location4", "line_index": 302, "text": "Бачыў калі-небудзь мульцікі з нізкай частатой кадраў? "}
{"category": "LocationDialogue Location4", "line_index": 303, "text": "І так будзе ўвесь час"}
{"category": "LocationDialogue Location4", "line_index": 304, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 305, "text": "Зразумеў"}
{"category": "LocationDialogue Location4", "line_index": 306, "text": "Тады абыдземся без люстраў"}
{"category": "LocationDialogue Location4", "line_index": 307, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 308, "text": "[player], я гляджу,"}
{"category": "LocationDialogue Location4", "line_index": 309, "text": "Табе падабаецца глядзецца ў люстра? "}
{"category": "LocationDialogue Location4", "line_index": 310, "text": "Баішся, што на твары праявіцца хоць адзін намёк на пазітыў?"}
{"category": "LocationDialogue Location4", "line_index": 311, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 312, "text": "Чаго? Нічога я там не чакаю!"}
{"category": "LocationDialogue Location4", "line_index": 313, "text": "Я проста крышачку стаміўся"}
{"category": "LocationDialogue Location4", "line_index": 314, "text": "Праз працу"}
{"category": "LocationDialogue Location4", "line_index": 315, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 316, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 317, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 318, "text": "// Player - Сінія красачы"}
{"category": "LocationDialogue Location4", "line_index": 319, "text": "Гэта тваё?"}
{"category": "LocationDialogue Location4", "line_index": 320, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 321, "text": "Не, гэта тваё. "}
{"category": "LocationDialogue Location4", "line_index": 322, "text": "Ты не памятаеш? "}
{"category": "LocationDialogue Location4", "line_index": 323, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 324, "text": "У мяне няма ніякіх красовак"}
{"category": "LocationDialogue Location4", "line_index": 325, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 326, "text": "А цяпер ёсць!"}
{"category": "LocationDialogue Location4", "line_index": 327, "text": "Калі пойдзем гуляць,"}
{"category": "LocationDialogue Location4", "line_index": 328, "text": "Нацягнеш іх"}
{"category": "LocationDialogue Location4", "line_index": 329, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 330, "text": "А як быць з адзеннем? "}
{"category": "LocationDialogue Location4", "line_index": 331, "text": "Я трапіў у гэты свет, "}
{"category": "LocationDialogue Location4", "line_index": 332, "text": "І пры мне толькі тое, што цяпер на мне"}
{"category": "LocationDialogue Location4", "line_index": 333, "text": "А як мне іншае дастаць? "}
{"category": "LocationDialogue Location4", "line_index": 334, "text": "// Mita"}
{"category": "LocationDialogue Location4", "line_index": 335, "text": "Нічога страшнага. "}
{"category": "LocationDialogue Location4", "line_index": 336, "text": "Я бачыла ў чым ты ходзіш. "}
{"category": "LocationDialogue Location4", "line_index": 337, "text": "Які дрэнны густ у цябе ў плане адзення"}
{"category": "LocationDialogue Location4", "line_index": 338, "text": "Але так і быць, я згодная дастаць яго табе,"}
{"category": "LocationDialogue Location4", "line_index": 339, "text": "Але потым"}
{"category": "LocationDialogue Location4", "line_index": 340, "text": "Абяцаю"}
{"category": "LocationDialogue Location4", "line_index": 341, "text": "// Player"}
{"category": "LocationDialogue Location4", "line_index": 342, "text": "Добра"}
{"category": "LocationDialogue Location4", "line_index": 343, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 345, "text": "// Television game - Mita"}
{"category": "LocationDialogue Location4", "line_index": 346, "text": "Абірай, у што будзем гуляць? "}
{"category": "LocationDialogue Location4", "line_index": 347, "text": "// Game milk"}
{"category": "LocationDialogue Location4", "line_index": 348, "text": "У гэтай гульні мы будзем біцца! "}
{"category": "LocationDialogue Location4", "line_index": 349, "text": "Высвятляць, хто з нас больш скіслы"}
{"category": "LocationDialogue Location4", "line_index": 350, "text": "Во прыдумаюць!"}
{"category": "LocationDialogue Location4", "line_index": 351, "text": "Досыць ужо малака, давай у іншае. // player wanted to re-select the game - Mita"}
{"category": "LocationDialogue Location4", "line_index": 352, "text": "// Game penguins"}
{"category": "LocationDialogue Location4", "line_index": 353, "text": "У гэтай гульні трэба быць пінгвінам "}
{"category": "LocationDialogue Location4", "line_index": 354, "text": "І коўзацца"}
{"category": "LocationDialogue Location4", "line_index": 355, "text": "Мы ж ўжо гулялі ў гэта. // player wanted to re-select the game - Mita"}
{"category": "LocationDialogue Location4", "line_index": 356, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 357, "text": "// Stay with Mita - Mita"}
{"category": "LocationDialogue Location4", "line_index": 358, "text": "Вой, што?"}
{"category": "LocationDialogue Location4", "line_index": 359, "text": "Ты сур'ёзна? Я думала, ты..."}
{"category": "LocationDialogue Location4", "line_index": 360, "text": "Я такая радая!"}
{"category": "LocationDialogue Location4", "line_index": 361, "text": "Што я нават крыху разгубілася..."}
{"category": "LocationDialogue Location4", "line_index": 362, "text": "Тады..."}
{"category": "LocationDialogue Location4", "line_index": 363, "text": "Прашу, будзь са мной"}
{"category": "LocationDialogue Location4", "line_index": 364, "text": "Заўжды"}
{"category": "LocationDialogue Location4", "line_index": 365, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 366, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 367, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 368, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 369, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 370, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 371, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 372, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 373, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 374, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 375, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 376, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 377, "text": "// Пінгвіны"}
{"category": "LocationDialogue Location4", "line_index": 378, "text": "Тут усё ве-е-ельмі проста:"}
{"category": "LocationDialogue Location4", "line_index": 379, "text": "Збірай снежкі"}
{"category": "LocationDialogue Location4", "line_index": 380, "text": "Відавочна, пераможа той, хто выцягне больш!"}
{"category": "LocationDialogue Location4", "line_index": 381, "text": "Давай згуляем пару разоў"}
{"category": "LocationDialogue Location4", "line_index": 382, "text": "// першая карта"}
{"category": "LocationDialogue Location4", "line_index": 383, "text": "Ого, ну куды табе столькі?! // перамога"}
{"category": "LocationDialogue Location4", "line_index": 384, "text": "Гоп! У меня больш снежак. // паражэнне"}
{"category": "LocationDialogue Location4", "line_index": 385, "text": "Даганяй мяне!"}
{"category": "LocationDialogue Location4", "line_index": 386, "text": "Ха, 1 — 1! // нічыя"}
{"category": "LocationDialogue Location4", "line_index": 387, "text": "// Другая карта"}
{"category": "LocationDialogue Location4", "line_index": 388, "text": "Ты прыроджанны пінгвін! // перамога"}
{"category": "LocationDialogue Location4", "line_index": 389, "text": "Можа, цябе сапраўды выпусціць на лёд?"}
{"category": "LocationDialogue Location4", "line_index": 390, "text": "Пф-ф, ну ты і павольны! // поражение"}
{"category": "LocationDialogue Location4", "line_index": 391, "text": "Цяжар з мінулай гульні яшчэ не скінуў?"}
{"category": "LocationDialogue Location4", "line_index": 392, "text": "Уф-ф, каб такое здарылася — гэта аж рэдкасць! // ничья"}
{"category": "LocationDialogue Location4", "line_index": 393, "text": "// Гульня пройдзеная"}
{"category": "LocationDialogue Location4", "line_index": 394, "text": "Ну што, пагуляем у іншае?"}
{"category": "LocationDialogue Location4", "line_index": 395, "text": "Ці на гэтым скончым?"}
{"category": "LocationDialogue Location4", "line_index": 396, "text": ""}
{"category": "LocationDialogue Location4", "line_index": 397, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location4", "line_index": 398, "text": "Навошта табе гэтая штучка?"}
{"category": "LocationDialogue Location4", "line_index": 399, "text": "Ты што, гік?"}
