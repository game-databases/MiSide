{"category": "LocationDialogue Location3", "line_index": 0, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 1, "text": "Вітаю, [player]!"}
{"category": "LocationDialogue Location3", "line_index": 2, "text": "Вось мы і сустрэліся!"}
{"category": "LocationDialogue Location3", "line_index": 3, "text": "Я вельмі радая гэтаму!"}
{"category": "LocationDialogue Location3", "line_index": 4, "text": "Ведаю, у цябе ёсць пытанні"}
{"category": "LocationDialogue Location3", "line_index": 5, "text": "Ну, як бачыш..."}
{"category": "LocationDialogue Location3", "line_index": 6, "text": "Я зрабіла гэтую асаблівую прыладу,"}
{"category": "LocationDialogue Location3", "line_index": 7, "text": "Каб ты хутчэй трапіў сюды, да мяне"}
{"category": "LocationDialogue Location3", "line_index": 8, "text": "Але чамусьці ты апынуўся ў іншай версіі гульні,"}
{"category": "LocationDialogue Location3", "line_index": 9, "text": "У якой я..."}
{"category": "LocationDialogue Location3", "line_index": 10, "text": "Вой, доўга расказваць!"}
{"category": "LocationDialogue Location3", "line_index": 11, "text": "Карацей, прыемна цябе бачыць!"}
{"category": "LocationDialogue Location3", "line_index": 12, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 13, "text": "// Answer 1 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 14, "text": "Так, гэта я"}
{"category": "LocationDialogue Location3", "line_index": 15, "text": "А ты [player]?"}
{"category": "LocationDialogue Location3", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 17, "text": "// Answer 2 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 18, "text": "Ты ўжо хочаш назад?.."}
{"category": "LocationDialogue Location3", "line_index": 19, "text": "Ну... Думаю, гэта можна зрабіць. Але як жа я?"}
{"category": "LocationDialogue Location3", "line_index": 20, "text": "Давай пабудзем разам..."}
{"category": "LocationDialogue Location3", "line_index": 21, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 22, "text": "// Answer 3 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 23, "text": "Зараз я табе раскажу... "}
{"category": "LocationDialogue Location3", "line_index": 24, "text": "І вось ты тут!"}
{"category": "LocationDialogue Location3", "line_index": 25, "text": "Зразумеў?"}
{"category": "LocationDialogue Location3", "line_index": 26, "text": "Я не зразумеў // Player"}
{"category": "LocationDialogue Location3", "line_index": 27, "text": "Ну-у, нічога страшнага. // Mita"}
{"category": "LocationDialogue Location3", "line_index": 28, "text": "Галоўнае, што мы разам!"}
{"category": "LocationDialogue Location3", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 30, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 31, "text": "Ты галодны?"}
{"category": "LocationDialogue Location3", "line_index": 32, "text": "Можа разам пагатуем?"}
{"category": "LocationDialogue Location3", "line_index": 33, "text": "Вось"}
{"category": "LocationDialogue Location3", "line_index": 34, "text": "Дапамажы можа мне з морквай?"}
{"category": "LocationDialogue Location3", "line_index": 35, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 36, "text": "А адкуль тут гародніна?"}
{"category": "LocationDialogue Location3", "line_index": 37, "text": "Бо тут толькі што нічога не было!"}
{"category": "LocationDialogue Location3", "line_index": 38, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 39, "text": "[player], ну мы ж у гульні!"}
{"category": "LocationDialogue Location3", "line_index": 40, "text": "Давай, да-па-ма-гай!"}
{"category": "LocationDialogue Location3", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 42, "text": "Дзяк"}
{"category": "LocationDialogue Location3", "line_index": 43, "text": "А ты можаш прынесці нажніцы?"}
{"category": "LocationDialogue Location3", "line_index": 44, "text": "Яны ў ваннай"}
{"category": "LocationDialogue Location3", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 46, "text": "Для пачатку сядай"}
{"category": "LocationDialogue Location3", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 48, "text": "// Kitchen"}
{"category": "LocationDialogue Location3", "line_index": 49, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 50, "text": "Будзеш соус?"}
{"category": "LocationDialogue Location3", "line_index": 51, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 52, "text": "Эмм... Не"}
{"category": "LocationDialogue Location3", "line_index": 53, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 54, "text": "А шкада"}
{"category": "LocationDialogue Location3", "line_index": 55, "text": "З ім ежа смачнейшая..."}
{"category": "LocationDialogue Location3", "line_index": 56, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 57, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 58, "text": "Дзякуй"}
{"category": "LocationDialogue Location3", "line_index": 59, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 60, "text": "Ты ўжо ўсё з'еў?"}
{"category": "LocationDialogue Location3", "line_index": 61, "text": "А мая порцыя здаецца"}
{"category": "LocationDialogue Location3", "line_index": 62, "text": "Бясконцай..."}
{"category": "LocationDialogue Location3", "line_index": 63, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 64, "text": "// Help"}
{"category": "LocationDialogue Location3", "line_index": 65, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 66, "text": "Што здарылася?"}
{"category": "LocationDialogue Location3", "line_index": 67, "text": "Скажы, што бачыш і адчуваеш"}
{"category": "LocationDialogue Location3", "line_index": 68, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 69, "text": "Сэрца коле,"}
{"category": "LocationDialogue Location3", "line_index": 70, "text": "У вачах шуміць"}
{"category": "LocationDialogue Location3", "line_index": 71, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 72, "text": "Так!"}
{"category": "LocationDialogue Location3", "line_index": 73, "text": "Я ведаю, што з табою. "}
{"category": "LocationDialogue Location3", "line_index": 74, "text": "Можаш падняцца?"}
{"category": "LocationDialogue Location3", "line_index": 75, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 76, "text": "// Bathroom"}
{"category": "LocationDialogue Location3", "line_index": 77, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 78, "text": "Што гэта?"}
{"category": "LocationDialogue Location3", "line_index": 79, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 80, "text": "Таблеткі"}
{"category": "LocationDialogue Location3", "line_index": 81, "text": "Табе стане адразу лягчэй"}
{"category": "LocationDialogue Location3", "line_index": 82, "text": "Уставай перад люстрам..."}
{"category": "LocationDialogue Location3", "line_index": 83, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 84, "text": "Прымай"}
{"category": "LocationDialogue Location3", "line_index": 85, "text": "Я чакаю"}
{"category": "LocationDialogue Location3", "line_index": 86, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 87, "text": "// Black room"}
{"category": "LocationDialogue Location3", "line_index": 88, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 89, "text": "Ну як?"}
{"category": "LocationDialogue Location3", "line_index": 90, "text": "Становіцца лепей?"}
{"category": "LocationDialogue Location3", "line_index": 91, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 92, "text": "Так"}
{"category": "LocationDialogue Location3", "line_index": 93, "text": "Так хутка падзейнічала?"}
{"category": "LocationDialogue Location3", "line_index": 94, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 95, "text": "[player], мы ж у гульні"}
{"category": "LocationDialogue Location3", "line_index": 96, "text": "І тут усё куды прасцей"}
{"category": "LocationDialogue Location3", "line_index": 97, "text": "Ты прыкладаеш невялікія намаганні,"}
{"category": "LocationDialogue Location3", "line_index": 98, "text": "Аднак вынік зазвычай больш абсяжны"}
{"category": "LocationDialogue Location3", "line_index": 99, "text": "Гэта гульнявая умоўнасць"}
{"category": "LocationDialogue Location3", "line_index": 100, "text": "Спрошчанасць"}
{"category": "LocationDialogue Location3", "line_index": 101, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 102, "text": "Напрыклад?"}
{"category": "LocationDialogue Location3", "line_index": 103, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 104, "text": "Морква."}
{"category": "LocationDialogue Location3", "line_index": 105, "text": "Ты рэзаў адну,"}
{"category": "LocationDialogue Location3", "line_index": 106, "text": "А будуць гатовыя адразу тры"}
{"category": "LocationDialogue Location3", "line_index": 107, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 108, "text": "Слухай, гэта ўсё так знянацку, "}
{"category": "LocationDialogue Location3", "line_index": 109, "text": "І мяне вельмі пужае гэтая сітуацыя... "}
{"category": "LocationDialogue Location3", "line_index": 110, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 111, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 112, "text": "Штосьці не так?"}
{"category": "LocationDialogue Location3", "line_index": 113, "text": "// player"}
{"category": "LocationDialogue Location3", "line_index": 114, "text": "Я знайшоў нейкія картрыджы ў вентыляцыі"}
{"category": "LocationDialogue Location3", "line_index": 115, "text": "На іх былі наклейкі з імёнамі"}
{"category": "LocationDialogue Location3", "line_index": 116, "text": "Што гэта?"}
{"category": "LocationDialogue Location3", "line_index": 117, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 118, "text": "Картрыджы?"}
{"category": "LocationDialogue Location3", "line_index": 119, "text": "Якія?"}
{"category": "LocationDialogue Location3", "line_index": 120, "text": "Давай пагаворым пра гэта, "}
{"category": "LocationDialogue Location3", "line_index": 121, "text": "Але крыху пазней"}
{"category": "LocationDialogue Location3", "line_index": 122, "text": "Спачатку паямо"}
{"category": "LocationDialogue Location3", "line_index": 123, "text": "Перадай нажніцы"}
{"category": "LocationDialogue Location3", "line_index": 124, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 125, "text": "// Addon ==========================="}
{"category": "LocationDialogue Location3", "line_index": 126, "text": "Пярсцёнак?"}
{"category": "LocationDialogue Location3", "line_index": 127, "text": "// Player - люстра"}
{"category": "LocationDialogue Location3", "line_index": 128, "text": "А чаму люстра без адбіцця?"}
{"category": "LocationDialogue Location3", "line_index": 129, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 130, "text": "Ах, дакладна,"}
{"category": "LocationDialogue Location3", "line_index": 131, "text": "Я забылася ўключыць адбіццё... "}
{"category": "LocationDialogue Location3", "line_index": 132, "text": "Ну вось,"}
{"category": "LocationDialogue Location3", "line_index": 133, "text": "Цяпер ёсць"}
{"category": "LocationDialogue Location3", "line_index": 134, "text": "Дарэчы,"}
{"category": "LocationDialogue Location3", "line_index": 135, "text": "Раней я ўвогуле не ведала, што такое адбіццё"}
{"category": "LocationDialogue Location3", "line_index": 136, "text": "У нашым свеце яго не было"}
{"category": "LocationDialogue Location3", "line_index": 137, "text": "Да нейкага там абнаўлення..."}
{"category": "LocationDialogue Location3", "line_index": 138, "text": "Няўжо ў вашым свеце так шмат"}
{"category": "LocationDialogue Location3", "line_index": 139, "text": "Адбіцця?"}
{"category": "LocationDialogue Location3", "line_index": 140, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 141, "text": "Ну-у, так"}
{"category": "LocationDialogue Location3", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 143, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 144, "text": "Памятаеш,"}
{"category": "LocationDialogue Location3", "line_index": 145, "text": "Ты прынёс тры рэчы"}
{"category": "LocationDialogue Location3", "line_index": 146, "text": "На гэты сканер?"}
{"category": "LocationDialogue Location3", "line_index": 147, "text": "Так вось..."}
{"category": "LocationDialogue Location3", "line_index": 148, "text": "Гэтыя рэчы"}
{"category": "LocationDialogue Location3", "line_index": 149, "text": "Звязаныя з гэтай версіяй свету"}
{"category": "LocationDialogue Location3", "line_index": 150, "text": "І цяпер ты тут!"}
{"category": "LocationDialogue Location3", "line_index": 151, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 152, "text": "// Player - пераносны тэлевізар"}
{"category": "LocationDialogue Location3", "line_index": 153, "text": "Гэта ж той тэлевізар,"}
{"category": "LocationDialogue Location3", "line_index": 154, "text": "Які я набыў"}
{"category": "LocationDialogue Location3", "line_index": 155, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 156, "text": "Ага"}
{"category": "LocationDialogue Location3", "line_index": 157, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 158, "text": "Ты сказала,"}
{"category": "LocationDialogue Location3", "line_index": 159, "text": "Што ён зламаўся"}
{"category": "LocationDialogue Location3", "line_index": 160, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 161, "text": "Ну, я хацела зрабіць табе"}
{"category": "LocationDialogue Location3", "line_index": 162, "text": "Сюрпрыз!"}
{"category": "LocationDialogue Location3", "line_index": 163, "text": "Каб ты трапіў сюды"}
{"category": "LocationDialogue Location3", "line_index": 164, "text": "Таму я крыху ўтаіла праўду"}
{"category": "LocationDialogue Location3", "line_index": 165, "text": "Цяпер экранчык паказвае інфармацыю. "}
{"category": "LocationDialogue Location3", "line_index": 166, "text": "І, дарэчы, так,"}
{"category": "LocationDialogue Location3", "line_index": 167, "text": "Я крышачку інжынер! "}
{"category": "LocationDialogue Location3", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 169, "text": "// Player - школьная форма"}
{"category": "LocationDialogue Location3", "line_index": 170, "text": "Што гэта,"}
{"category": "LocationDialogue Location3", "line_index": 171, "text": "Школьная форма?"}
{"category": "LocationDialogue Location3", "line_index": 172, "text": "Навошта яна табе?"}
{"category": "LocationDialogue Location3", "line_index": 173, "text": "Хіба ты можаш хадзіць у школу?"}
{"category": "LocationDialogue Location3", "line_index": 174, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 175, "text": "У школу?"}
{"category": "LocationDialogue Location3", "line_index": 176, "text": "Не, мне гэта не трэба"}
{"category": "LocationDialogue Location3", "line_index": 177, "text": "Але форма міленькая,"}
{"category": "LocationDialogue Location3", "line_index": 178, "text": "І яна дазваляе мне"}
{"category": "LocationDialogue Location3", "line_index": 179, "text": "Выглядаць міленька"}
{"category": "LocationDialogue Location3", "line_index": 180, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 181, "text": "// Player - камп'ютар"}
{"category": "LocationDialogue Location3", "line_index": 182, "text": "А гэты камп'ютар працуе?"}
{"category": "LocationDialogue Location3", "line_index": 183, "text": "Ці ён дэкаратыўны?"}
{"category": "LocationDialogue Location3", "line_index": 184, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 185, "text": "Канечне"}
{"category": "LocationDialogue Location3", "line_index": 186, "text": "Усё, што тут ёсць"}
{"category": "LocationDialogue Location3", "line_index": 187, "text": "Працуе як у тваім свеце. "}
{"category": "LocationDialogue Location3", "line_index": 188, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 189, "text": "У сваім свеце"}
{"category": "LocationDialogue Location3", "line_index": 190, "text": "Я часта сяджу за камп'ютарам..."}
{"category": "LocationDialogue Location3", "line_index": 191, "text": "Працую"}
{"category": "LocationDialogue Location3", "line_index": 192, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 193, "text": "Я ведаю"}
{"category": "LocationDialogue Location3", "line_index": 194, "text": "І праз сваёй працы "}
{"category": "LocationDialogue Location3", "line_index": 195, "text": "Ты так мала звяртаў"}
{"category": "LocationDialogue Location3", "line_index": 196, "text": "На мяне ўвагі"}
{"category": "LocationDialogue Location3", "line_index": 197, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 198, "text": "Ну, жыць жа на штосьці трэба. "}
{"category": "LocationDialogue Location3", "line_index": 199, "text": "А адкуль ты знаеш?"}
{"category": "LocationDialogue Location3", "line_index": 200, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 201, "text": "Камера тэлефону часам уключалася... "}
{"category": "LocationDialogue Location3", "line_index": 202, "text": "Прабач,"}
{"category": "LocationDialogue Location3", "line_index": 203, "text": "Але я назірала"}
{"category": "LocationDialogue Location3", "line_index": 204, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 205, "text": "Ведаеш, гэта крыху няправільна... "}
{"category": "LocationDialogue Location3", "line_index": 206, "text": "Ну хай"}
{"category": "LocationDialogue Location3", "line_index": 207, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 208, "text": "// Player - парасон"}
{"category": "LocationDialogue Location3", "line_index": 209, "text": "Колькі б я ні гуляў,"}
{"category": "LocationDialogue Location3", "line_index": 210, "text": "Дажджу ніколі не было"}
{"category": "LocationDialogue Location3", "line_index": 211, "text": "Тады навошта парасон?"}
{"category": "LocationDialogue Location3", "line_index": 212, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 213, "text": "Дождж вельмі рэдкі — "}
{"category": "LocationDialogue Location3", "line_index": 214, "text": "Ты яго яшчэ не заспеў"}
{"category": "LocationDialogue Location3", "line_index": 215, "text": "Магчыма, аднойчы сустрэнеш яго,"}
{"category": "LocationDialogue Location3", "line_index": 216, "text": "І парасон табе прыдасца"}
{"category": "LocationDialogue Location3", "line_index": 217, "text": "Можа потым даведаемся"}
{"category": "LocationDialogue Location3", "line_index": 218, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 219, "text": "// Player - Электрашчыток"}
{"category": "LocationDialogue Location3", "line_index": 220, "text": "А навошта электрашчыт тут?"}
{"category": "LocationDialogue Location3", "line_index": 221, "text": "І калі мы ў гульні, "}
{"category": "LocationDialogue Location3", "line_index": 222, "text": "То навошта ён?"}
{"category": "LocationDialogue Location3", "line_index": 223, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 224, "text": "Па-першае,"}
{"category": "LocationDialogue Location3", "line_index": 225, "text": "Мы ў гульні,"}
{"category": "LocationDialogue Location3", "line_index": 226, "text": "Таму бессэнсоўна пытаць "}
{"category": "LocationDialogue Location3", "line_index": 227, "text": "\"Навошта?\"."}
{"category": "LocationDialogue Location3", "line_index": 228, "text": "Але шчыток і сапраўды"}
{"category": "LocationDialogue Location3", "line_index": 229, "text": "Перазапускае электрычнасць"}
{"category": "LocationDialogue Location3", "line_index": 230, "text": "Усё зроблена паводле вобраза"}
{"category": "LocationDialogue Location3", "line_index": 231, "text": "Твайго свету"}
{"category": "LocationDialogue Location3", "line_index": 232, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 233, "text": "// Player - дзверы на выхад"}
{"category": "LocationDialogue Location3", "line_index": 234, "text": "Мы можам выйсці?"}
{"category": "LocationDialogue Location3", "line_index": 235, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 236, "text": "Вой..."}
{"category": "LocationDialogue Location3", "line_index": 237, "text": "Пакуль што не"}
{"category": "LocationDialogue Location3", "line_index": 238, "text": "Давай пазней"}
{"category": "LocationDialogue Location3", "line_index": 239, "text": "Спачатку пабудзем тут, "}
{"category": "LocationDialogue Location3", "line_index": 240, "text": "Дома"}
{"category": "LocationDialogue Location3", "line_index": 241, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 242, "text": "// Player - кнігі"}
{"category": "LocationDialogue Location3", "line_index": 243, "text": "Тут столькі кніг"}
{"category": "LocationDialogue Location3", "line_index": 244, "text": "Ты іх чытаеш?"}
{"category": "LocationDialogue Location3", "line_index": 245, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 246, "text": "Я ўжо ўсё прачытала"}
{"category": "LocationDialogue Location3", "line_index": 247, "text": "Калі я тут сама,"}
{"category": "LocationDialogue Location3", "line_index": 248, "text": "Мне ве-е-ельмі сумна"}
{"category": "LocationDialogue Location3", "line_index": 249, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 250, "text": "// Player - тэлевізар на кухні"}
{"category": "LocationDialogue Location3", "line_index": 251, "text": "Навошта табе другі тэлевізар,"}
{"category": "LocationDialogue Location3", "line_index": 252, "text": "Дый яшчэ стары?"}
{"category": "LocationDialogue Location3", "line_index": 253, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 254, "text": "Табе ён не падабаецца? "}
{"category": "LocationDialogue Location3", "line_index": 255, "text": "Магу прыбраць"}
{"category": "LocationDialogue Location3", "line_index": 256, "text": "А так..."}
{"category": "LocationDialogue Location3", "line_index": 257, "text": "Ён для утульнасці: "}
{"category": "LocationDialogue Location3", "line_index": 258, "text": "Аздабляе кухню"}
{"category": "LocationDialogue Location3", "line_index": 259, "text": "А яшчэ ён спраўны!"}
{"category": "LocationDialogue Location3", "line_index": 260, "text": "Можна паглядзець"}
{"category": "LocationDialogue Location3", "line_index": 261, "text": "Старыя мульцікі!"}
{"category": "LocationDialogue Location3", "line_index": 262, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 263, "text": "// Player - тэлефон"}
{"category": "LocationDialogue Location3", "line_index": 264, "text": "Мой тэлефон"}
{"category": "LocationDialogue Location3", "line_index": 265, "text": "Ён знік у мяне з кішэні! "}
{"category": "LocationDialogue Location3", "line_index": 266, "text": "Як ён тут з'явіўся?"}
{"category": "LocationDialogue Location3", "line_index": 267, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 268, "text": "Ну-у-у... Гэта няважна..."}
{"category": "LocationDialogue Location3", "line_index": 269, "text": "У мяне ёсць ідэя"}
{"category": "LocationDialogue Location3", "line_index": 270, "text": "Гатовы зрабіць сэлфі? "}
{"category": "LocationDialogue Location3", "line_index": 271, "text": "Глядзі"}
{"category": "LocationDialogue Location3", "line_index": 272, "text": "Цудоўная фотка! "}
{"category": "LocationDialogue Location3", "line_index": 273, "text": "На памяць"}
{"category": "LocationDialogue Location3", "line_index": 274, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 275, "text": "У мяне пытанне:"}
{"category": "LocationDialogue Location3", "line_index": 276, "text": "А калі"}
{"category": "LocationDialogue Location3", "line_index": 277, "text": "Я запушчу на ім гульню,"}
{"category": "LocationDialogue Location3", "line_index": 278, "text": "Я пабачу сябе?"}
{"category": "LocationDialogue Location3", "line_index": 279, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 280, "text": "Там нікога не будзе"}
{"category": "LocationDialogue Location3", "line_index": 281, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 282, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 283, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 284, "text": "// Player - тэлевізар"}
{"category": "LocationDialogue Location3", "line_index": 285, "text": "А колькі каналаў"}
{"category": "LocationDialogue Location3", "line_index": 286, "text": "Тут існуе?"}
{"category": "LocationDialogue Location3", "line_index": 287, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 288, "text": "Ну гэта ж не антэна, "}
{"category": "LocationDialogue Location3", "line_index": 289, "text": "А інтэрнет"}
{"category": "LocationDialogue Location3", "line_index": 290, "text": "Так што тут даступна ўсё,"}
{"category": "LocationDialogue Location3", "line_index": 291, "text": "Што ты можаш глядзець у інтэрнэце"}
{"category": "LocationDialogue Location3", "line_index": 292, "text": "Пачакай!"}
{"category": "LocationDialogue Location3", "line_index": 293, "text": "Вой!"}
{"category": "LocationDialogue Location3", "line_index": 294, "text": "Што гэта?"}
{"category": "LocationDialogue Location3", "line_index": 295, "text": "Нейкія кацяняты?"}
{"category": "LocationDialogue Location3", "line_index": 296, "text": "Го, глядзі!"}
{"category": "LocationDialogue Location3", "line_index": 297, "text": "А ведаеш што..."}
{"category": "LocationDialogue Location3", "line_index": 298, "text": "Зараз!"}
{"category": "LocationDialogue Location3", "line_index": 299, "text": "Хочаш соку?"}
{"category": "LocationDialogue Location3", "line_index": 300, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 301, "text": "Дзіўная рэклама..."}
{"category": "LocationDialogue Location3", "line_index": 302, "text": "Сок памёр?"}
{"category": "LocationDialogue Location3", "line_index": 303, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 304, "text": "Але. І гэты сок..."}
{"category": "LocationDialogue Location3", "line_index": 305, "text": "Ён ну, з соку"}
{"category": "LocationDialogue Location3", "line_index": 306, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 307, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 308, "text": "М-м, на смак..."}
{"category": "LocationDialogue Location3", "line_index": 309, "text": "Мне падабаецца,"}
{"category": "LocationDialogue Location3", "line_index": 310, "text": "Але я не магу рассмакаваць яго"}
{"category": "LocationDialogue Location3", "line_index": 311, "text": "Незразумела"}
{"category": "LocationDialogue Location3", "line_index": 312, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 313, "text": "Ну добра"}
{"category": "LocationDialogue Location3", "line_index": 314, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 315, "text": "// Mita shy"}
{"category": "LocationDialogue Location3", "line_index": 316, "text": "Ты ч-чаго?"}
{"category": "LocationDialogue Location3", "line_index": 317, "text": "Перастань!"}
{"category": "LocationDialogue Location3", "line_index": 318, "text": "Ты бянтэжыш"}
{"category": "LocationDialogue Location3", "line_index": 319, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 320, "text": "// Player - Статуэтка Аніты"}
{"category": "LocationDialogue Location3", "line_index": 321, "text": "Страхотная статуэтка"}
{"category": "LocationDialogue Location3", "line_index": 322, "text": "Табе"}
{"category": "LocationDialogue Location3", "line_index": 323, "text": "Падабаюцца такія рэчы?"}
{"category": "LocationDialogue Location3", "line_index": 324, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 325, "text": "Страхотная?"}
{"category": "LocationDialogue Location3", "line_index": 326, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 327, "text": "Але"}
{"category": "LocationDialogue Location3", "line_index": 328, "text": "Падобна на штосьці праклятае... "}
{"category": "LocationDialogue Location3", "line_index": 329, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 330, "text": "Ну... Яна дакладна не праклятая"}
{"category": "LocationDialogue Location3", "line_index": 331, "text": "І не страхотная"}
{"category": "LocationDialogue Location3", "line_index": 332, "text": "А вельмі нават мілая!"}
{"category": "LocationDialogue Location3", "line_index": 333, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 334, "text": "Магчыма, маеш рацыю..."}
{"category": "LocationDialogue Location3", "line_index": 335, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 336, "text": "Міта! // Player"}
{"category": "LocationDialogue Location3", "line_index": 337, "text": "Што адбываецца? // Player"}
{"category": "LocationDialogue Location3", "line_index": 338, "text": "// Mita kitchen"}
{"category": "LocationDialogue Location3", "line_index": 339, "text": "Можам пагутарыць,"}
{"category": "LocationDialogue Location3", "line_index": 340, "text": "Перад тым, як есці"}
{"category": "LocationDialogue Location3", "line_index": 341, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 342, "text": "// Start Eat - Mita"}
{"category": "LocationDialogue Location3", "line_index": 343, "text": "І табе!"}
{"category": "LocationDialogue Location3", "line_index": 344, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 345, "text": "// Quest 1 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 346, "text": "Яшчэ б"}
{"category": "LocationDialogue Location3", "line_index": 347, "text": "Ты можаш застацца тут"}
{"category": "LocationDialogue Location3", "line_index": 348, "text": "Я не супраць"}
{"category": "LocationDialogue Location3", "line_index": 349, "text": "І вельмі нават"}
{"category": "LocationDialogue Location3", "line_index": 350, "text": "ЗА!"}
{"category": "LocationDialogue Location3", "line_index": 351, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 352, "text": "// Quest 2 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 353, "text": "Цябе цягне назад?"}
{"category": "LocationDialogue Location3", "line_index": 354, "text": "Але чаму?"}
{"category": "LocationDialogue Location3", "line_index": 355, "text": "Тут жа так"}
{"category": "LocationDialogue Location3", "line_index": 356, "text": "Цёпла, добра ж"}
{"category": "LocationDialogue Location3", "line_index": 357, "text": "І тут ёсць я!"}
{"category": "LocationDialogue Location3", "line_index": 358, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 359, "text": "Не-не,"}
{"category": "LocationDialogue Location3", "line_index": 360, "text": "Можна і застацца"}
{"category": "LocationDialogue Location3", "line_index": 361, "text": "Але я хвалююся:"}
{"category": "LocationDialogue Location3", "line_index": 362, "text": "Што калі дома нешта забыў... зрабіць"}
{"category": "LocationDialogue Location3", "line_index": 363, "text": "Я апынуўся тут неспадзеўкі"}
{"category": "LocationDialogue Location3", "line_index": 364, "text": "І зусім не гатовы "}
{"category": "LocationDialogue Location3", "line_index": 365, "text": "Да гэтага"}
{"category": "LocationDialogue Location3", "line_index": 366, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 367, "text": "Прабач, не падумала"}
{"category": "LocationDialogue Location3", "line_index": 368, "text": "// Quest 3 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 369, "text": "Хочаш збегчы"}
{"category": "LocationDialogue Location3", "line_index": 370, "text": "І забыць усё?"}
{"category": "LocationDialogue Location3", "line_index": 371, "text": "// player"}
{"category": "LocationDialogue Location3", "line_index": 372, "text": "Не!"}
{"category": "LocationDialogue Location3", "line_index": 373, "text": "Я проста падумаў,"}
{"category": "LocationDialogue Location3", "line_index": 374, "text": "Што ўсё вельмі насычана і ненатуральна"}
{"category": "LocationDialogue Location3", "line_index": 375, "text": "Хаця..."}
{"category": "LocationDialogue Location3", "line_index": 376, "text": "Ты здаешся сапраўднай"}
{"category": "LocationDialogue Location3", "line_index": 377, "text": "// Mita "}
{"category": "LocationDialogue Location3", "line_index": 378, "text": "Здаюся?"}
{"category": "LocationDialogue Location3", "line_index": 379, "text": "Бо я і ёсць сапраўдная!"}
{"category": "LocationDialogue Location3", "line_index": 380, "text": "Дурненькі!"}
{"category": "LocationDialogue Location3", "line_index": 381, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 382, "text": "// Quest 4 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 383, "text": "Гэта асаблівасць"}
{"category": "LocationDialogue Location3", "line_index": 384, "text": "Гэтага свету"}
{"category": "LocationDialogue Location3", "line_index": 385, "text": "Табе здаецца нязвычным,"}
{"category": "LocationDialogue Location3", "line_index": 386, "text": "Але ты не будзеш бачыць рэчы,"}
{"category": "LocationDialogue Location3", "line_index": 387, "text": "Што знаходзяцца ўдалечыні"}
{"category": "LocationDialogue Location3", "line_index": 388, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 389, "text": "Ды здаецца гэта нават і незаўважна"}
{"category": "LocationDialogue Location3", "line_index": 390, "text": "Выглядае стылёва"}
{"category": "LocationDialogue Location3", "line_index": 391, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 392, "text": "Так і ёсць,"}
{"category": "LocationDialogue Location3", "line_index": 393, "text": "Усё, абы не лагала"}
{"category": "LocationDialogue Location3", "line_index": 394, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 395, "text": "\"Не лагала\"?"}
{"category": "LocationDialogue Location3", "line_index": 396, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 397, "text": "Угу, ёсць памылкі. "}
{"category": "LocationDialogue Location3", "line_index": 398, "text": "Спадзяюся, ты іх не сустрэнеш. "}
{"category": "LocationDialogue Location3", "line_index": 399, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 400, "text": "// Quest 5 - Mita"}
{"category": "LocationDialogue Location3", "line_index": 401, "text": "Нажніцы і ножык?"}
{"category": "LocationDialogue Location3", "line_index": 402, "text": "Магу і нажом адкрыць соус"}
{"category": "LocationDialogue Location3", "line_index": 403, "text": "Але я хацела..."}
{"category": "LocationDialogue Location3", "line_index": 404, "text": "Каб тут ўсё было гатова, "}
{"category": "LocationDialogue Location3", "line_index": 405, "text": "Да таго моманту, калі ты вернешся"}
{"category": "LocationDialogue Location3", "line_index": 406, "text": "Люблю рабіць неспадзянкі"}
{"category": "LocationDialogue Location3", "line_index": 407, "text": "Каб не было відаць доўгай падрыхтоўкі"}
{"category": "LocationDialogue Location3", "line_index": 408, "text": "Воооось"}
{"category": "LocationDialogue Location3", "line_index": 409, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 410, "text": "// Glasses - Player"}
{"category": "LocationDialogue Location3", "line_index": 411, "text": "Ты акуляры носіш?"}
{"category": "LocationDialogue Location3", "line_index": 412, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 413, "text": "Не"}
{"category": "LocationDialogue Location3", "line_index": 414, "text": "Але надзець іх магу"}
{"category": "LocationDialogue Location3", "line_index": 415, "text": "Ну як, мне пасуе?"}
{"category": "LocationDialogue Location3", "line_index": 416, "text": "// Mita Yes"}
{"category": "LocationDialogue Location3", "line_index": 417, "text": "Ну вось"}
{"category": "LocationDialogue Location3", "line_index": 418, "text": "Цяпер буду ў іх хадзіць"}
{"category": "LocationDialogue Location3", "line_index": 419, "text": "// Mita No"}
{"category": "LocationDialogue Location3", "line_index": 420, "text": "Ну-у-у,"}
{"category": "LocationDialogue Location3", "line_index": 421, "text": "Добра..."}
{"category": "LocationDialogue Location3", "line_index": 422, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 423, "text": "// Use the sauce - Player"}
{"category": "LocationDialogue Location3", "line_index": 424, "text": "Добра"}
{"category": "LocationDialogue Location3", "line_index": 425, "text": "А што за соус такі?"}
{"category": "LocationDialogue Location3", "line_index": 426, "text": "// Mita"}
{"category": "LocationDialogue Location3", "line_index": 427, "text": "Гэта любоўны соус! "}
{"category": "LocationDialogue Location3", "line_index": 428, "text": "Утрымлівае водар кахання"}
{"category": "LocationDialogue Location3", "line_index": 429, "text": "І кантрасны погляд на свет..."}
{"category": "LocationDialogue Location3", "line_index": 430, "text": "Незвычайна гучыць, праўда?"}
{"category": "LocationDialogue Location3", "line_index": 431, "text": "// Player"}
{"category": "LocationDialogue Location3", "line_index": 432, "text": "Ё такое..."}
{"category": "LocationDialogue Location3", "line_index": 433, "text": ""}
{"category": "LocationDialogue Location3", "line_index": 434, "text": "// Tetris - Mita"}
{"category": "LocationDialogue Location3", "line_index": 435, "text": "Гэта ў цябе прыстаўка такая?"}
{"category": "LocationDialogue Location3", "line_index": 436, "text": "Прыкольна"}
