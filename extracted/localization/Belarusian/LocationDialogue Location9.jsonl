{"category": "LocationDialogue Location9", "line_index": 0, "text": "// Mita Chibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 1, "text": "Гэй, ты!"}
{"category": "LocationDialogue Location9", "line_index": 2, "text": "Вітанкі!"}
{"category": "LocationDialogue Location9", "line_index": 3, "text": "Хочаш выбрацца?"}
{"category": "LocationDialogue Location9", "line_index": 4, "text": "Тады дапамажы мне знайсці ключ!"}
{"category": "LocationDialogue Location9", "line_index": 5, "text": "// Key Search - MitaChibi  - [not]"}
{"category": "LocationDialogue Location9", "line_index": 6, "text": "Блін! Тут няма ключа!"}
{"category": "LocationDialogue Location9", "line_index": 7, "text": "Тут пуста!"}
{"category": "LocationDialogue Location9", "line_index": 8, "text": "Зусім нічога!"}
{"category": "LocationDialogue Location9", "line_index": 9, "text": "Знайшла!"}
{"category": "LocationDialogue Location9", "line_index": 10, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 11, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 12, "text": "Я думала, ты ніжэйшы будзеш!"}
{"category": "LocationDialogue Location9", "line_index": 13, "text": "А ты вунь які вялікі!"}
{"category": "LocationDialogue Location9", "line_index": 14, "text": "Як сястрычка!"}
{"category": "LocationDialogue Location9", "line_index": 15, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 16, "text": "Эм… сястрычка?"}
{"category": "LocationDialogue Location9", "line_index": 17, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 18, "text": "Ага, сястрычка"}
{"category": "LocationDialogue Location9", "line_index": 19, "text": "Нібы не сустракаў яе!"}
{"category": "LocationDialogue Location9", "line_index": 20, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 21, "text": "Сустракаў? Слаба сказана..."}
{"category": "LocationDialogue Location9", "line_index": 22, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 23, "text": "Ты дурны?"}
{"category": "LocationDialogue Location9", "line_index": 24, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 25, "text": "Эм-м..."}
{"category": "LocationDialogue Location9", "line_index": 26, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 27, "text": "Дурны, значыць..."}
{"category": "LocationDialogue Location9", "line_index": 28, "text": "Давай, пакажы, дзе шукаць ключ!"}
{"category": "LocationDialogue Location9", "line_index": 29, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 30, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 31, "text": "Вось!"}
{"category": "LocationDialogue Location9", "line_index": 32, "text": "Закінь жалеза ў руру!"}
{"category": "LocationDialogue Location9", "line_index": 33, "text": "Дзякуй!"}
{"category": "LocationDialogue Location9", "line_index": 34, "text": "А цяпер апусці дровы для мяне!"}
{"category": "LocationDialogue Location9", "line_index": 35, "text": "Дзякую!"}
{"category": "LocationDialogue Location9", "line_index": 36, "text": "Цяпер дапамажы тут!"}
{"category": "LocationDialogue Location9", "line_index": 37, "text": "Гатова! Зараз..."}
{"category": "LocationDialogue Location9", "line_index": 38, "text": "Глядзі, як прыгожа..."}
{"category": "LocationDialogue Location9", "line_index": 39, "text": "Націскай давай!"}
{"category": "LocationDialogue Location9", "line_index": 40, "text": "Хоба!"}
{"category": "LocationDialogue Location9", "line_index": 41, "text": "Ну ўсё, забірай!"}
{"category": "LocationDialogue Location9", "line_index": 42, "text": "Ключык твой!"}
{"category": "LocationDialogue Location9", "line_index": 43, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 45, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 46, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 48, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 49, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 50, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 51, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 52, "text": "// quest 1 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 53, "text": "Я ChibiMita.fbx!"}
{"category": "LocationDialogue Location9", "line_index": 54, "text": "З кучкай радкоў,"}
{"category": "LocationDialogue Location9", "line_index": 55, "text": "Найпрасцейшай арматурай,"}
{"category": "LocationDialogue Location9", "line_index": 56, "text": "І найцудоўнейшымі валасамі!"}
{"category": "LocationDialogue Location9", "line_index": 57, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 58, "text": "// quest 2 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 59, "text": "Спадару вялікі дурню,"}
{"category": "LocationDialogue Location9", "line_index": 60, "text": "Ты вельмі міла выглядаеш,"}
{"category": "LocationDialogue Location9", "line_index": 61, "text": "Калі задаеш дурненькія пытанні"}
{"category": "LocationDialogue Location9", "line_index": 62, "text": "Аднак,"}
{"category": "LocationDialogue Location9", "line_index": 63, "text": "Я бачу цябе ўпершыню!"}
{"category": "LocationDialogue Location9", "line_index": 64, "text": "Але... // Player"}
{"category": "LocationDialogue Location9", "line_index": 65, "text": "Хай гэта будзе на сумленні таго, // MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 66, "text": "Хто скраў мой цудоўны вобраз!"}
{"category": "LocationDialogue Location9", "line_index": 67, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 68, "text": "// quest 3 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 69, "text": "Ты не зразумеў?"}
{"category": "LocationDialogue Location9", "line_index": 70, "text": "Гэта прапускны пункт!"}
{"category": "LocationDialogue Location9", "line_index": 71, "text": "Прад'явіце свае звіліны!"}
{"category": "LocationDialogue Location9", "line_index": 72, "text": "Праходзьце, не затрымлівайцеся!"}
{"category": "LocationDialogue Location9", "line_index": 73, "text": "Я праводжу аблудных глупствам згубленых!"}
{"category": "LocationDialogue Location9", "line_index": 74, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 75, "text": "// quest 4 - MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 76, "text": "А хто ты такі, "}
{"category": "LocationDialogue Location9", "line_index": 77, "text": "Каб НЕ дапамагаць табе?"}
{"category": "LocationDialogue Location9", "line_index": 78, "text": "// Player"}
{"category": "LocationDialogue Location9", "line_index": 79, "text": "Што?"}
{"category": "LocationDialogue Location9", "line_index": 80, "text": "// MitaChibi - [not]"}
{"category": "LocationDialogue Location9", "line_index": 81, "text": "Дурненькі..."}
{"category": "LocationDialogue Location9", "line_index": 82, "text": "Вываліўся аднекуль!"}
{"category": "LocationDialogue Location9", "line_index": 83, "text": "Табе тут быць не варта,"}
{"category": "LocationDialogue Location9", "line_index": 84, "text": "Вось і дапамагаю!"}
{"category": "LocationDialogue Location9", "line_index": 85, "text": ""}
{"category": "LocationDialogue Location9", "line_index": 86, "text": "Бывай-бывай, дурненькі! // Mita [not]"}
