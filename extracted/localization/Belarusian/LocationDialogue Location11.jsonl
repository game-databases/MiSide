{"category": "LocationDialogue Location11", "line_index": 0, "text": "// Mita"}
{"category": "LocationDialogue Location11", "line_index": 1, "text": "Вітанкі!"}
{"category": "LocationDialogue Location11", "line_index": 2, "text": "Вой!"}
{"category": "LocationDialogue Location11", "line_index": 3, "text": "Прабач,"}
{"category": "LocationDialogue Location11", "line_index": 4, "text": "Ледзь не забіла цябе..."}
{"category": "LocationDialogue Location11", "line_index": 5, "text": "Ох..."}
{"category": "LocationDialogue Location11", "line_index": 6, "text": "То-бок халадзільнік ледзь не забіў цябе"}
{"category": "LocationDialogue Location11", "line_index": 7, "text": "Я тут ні пры чым, ведаеш?"}
{"category": "LocationDialogue Location11", "line_index": 8, "text": "Праўда-праўда, я кажу!"}
{"category": "LocationDialogue Location11", "line_index": 9, "text": "Шчыра!"}
{"category": "LocationDialogue Location11", "line_index": 10, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 11, "text": "Вось так узяў і паверыў!"}
{"category": "LocationDialogue Location11", "line_index": 12, "text": "// Mita"}
{"category": "LocationDialogue Location11", "line_index": 13, "text": "Ну, знаеш што,"}
{"category": "LocationDialogue Location11", "line_index": 14, "text": "Быць тут — небяспечна..."}
{"category": "LocationDialogue Location11", "line_index": 15, "text": "Асабліва табе!"}
{"category": "LocationDialogue Location11", "line_index": 16, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 17, "text": "// After a while 1"}
{"category": "LocationDialogue Location11", "line_index": 18, "text": "А ты не з пужлівых!"}
{"category": "LocationDialogue Location11", "line_index": 19, "text": "Цікава назіраць за табою,"}
{"category": "LocationDialogue Location11", "line_index": 20, "text": "Як ты праходзіш"}
{"category": "LocationDialogue Location11", "line_index": 21, "text": "Гэтыя месцы..."}
{"category": "LocationDialogue Location11", "line_index": 22, "text": "Бяжы-бяжы, малыш!"}
{"category": "LocationDialogue Location11", "line_index": 23, "text": "Дагнаць цябе яшчэ паспею!"}
{"category": "LocationDialogue Location11", "line_index": 24, "text": "Спрабуй-спрабуй!"}
{"category": "LocationDialogue Location11", "line_index": 25, "text": "Гэта весела!"}
{"category": "LocationDialogue Location11", "line_index": 26, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 27, "text": "// After a while 2"}
{"category": "LocationDialogue Location11", "line_index": 28, "text": "Я бачу, ты ідзеш да фунікулёра"}
{"category": "LocationDialogue Location11", "line_index": 29, "text": "Гэта найдаўжэйшы шлях"}
{"category": "LocationDialogue Location11", "line_index": 30, "text": "Паміж версіямі"}
{"category": "LocationDialogue Location11", "line_index": 31, "text": "Цікава, як ты дасі рады"}
{"category": "LocationDialogue Location11", "line_index": 32, "text": "З тымі, хто там жыве,"}
{"category": "LocationDialogue Location11", "line_index": 33, "text": "У тым тумане"}
{"category": "LocationDialogue Location11", "line_index": 34, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 35, "text": "// Panties"}
{"category": "LocationDialogue Location11", "line_index": 36, "text": "Ты чаго?"}
{"category": "LocationDialogue Location11", "line_index": 37, "text": "Ану..."}
{"category": "LocationDialogue Location11", "line_index": 38, "text": "Не глядзі,"}
{"category": "LocationDialogue Location11", "line_index": 39, "text": "Дурань!"}
{"category": "LocationDialogue Location11", "line_index": 40, "text": "Дурань..."}
{"category": "LocationDialogue Location11", "line_index": 41, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 42, "text": "// Mita if player out"}
{"category": "LocationDialogue Location11", "line_index": 43, "text": "А, ну хай..."}
{"category": "LocationDialogue Location11", "line_index": 44, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 45, "text": "// Goodbye"}
{"category": "LocationDialogue Location11", "line_index": 46, "text": "Шчасліва!"}
{"category": "LocationDialogue Location11", "line_index": 47, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 48, "text": "// Mitaghost"}
{"category": "LocationDialogue Location11", "line_index": 49, "text": "Хто тут?"}
{"category": "LocationDialogue Location11", "line_index": 50, "text": "Я адчуваю цябе..."}
{"category": "LocationDialogue Location11", "line_index": 51, "text": "Паслухай,"}
{"category": "LocationDialogue Location11", "line_index": 52, "text": "Ты гулец,"}
{"category": "LocationDialogue Location11", "line_index": 53, "text": "Так?"}
{"category": "LocationDialogue Location11", "line_index": 54, "text": "Дапамажы мне знайсці..."}
{"category": "LocationDialogue Location11", "line_index": 55, "text": "Знайсці..."}
{"category": "LocationDialogue Location11", "line_index": 56, "text": "Прыгадаць..."}
{"category": "LocationDialogue Location11", "line_index": 57, "text": "Я не ўпэўненая..."}
{"category": "LocationDialogue Location11", "line_index": 58, "text": "Ды што тут адбываецца? // Player"}
{"category": "LocationDialogue Location11", "line_index": 59, "text": "// Cry 1 - Mitaghost"}
{"category": "LocationDialogue Location11", "line_index": 60, "text": "Некалі я хацела ўсё забыць..."}
{"category": "LocationDialogue Location11", "line_index": 61, "text": "Разбіла ўсе люстэркі,"}
{"category": "LocationDialogue Location11", "line_index": 62, "text": "Папсавала малюнкі..."}
{"category": "LocationDialogue Location11", "line_index": 63, "text": "А цяпер..."}
{"category": "LocationDialogue Location11", "line_index": 64, "text": "Я адчуваю віну"}
{"category": "LocationDialogue Location11", "line_index": 65, "text": "І гэта так глупа..."}
{"category": "LocationDialogue Location11", "line_index": 66, "text": "Кожны памыляецца,"}
{"category": "LocationDialogue Location11", "line_index": 67, "text": "Але што зрабіць,"}
{"category": "LocationDialogue Location11", "line_index": 68, "text": "Калі наступствы катастрафічныя?"}
{"category": "LocationDialogue Location11", "line_index": 69, "text": "Вось бы ўсё вярнуць назад..."}
{"category": "LocationDialogue Location11", "line_index": 70, "text": "// Cry 2"}
{"category": "LocationDialogue Location11", "line_index": 71, "text": "Кажуць, час лечыць..."}
{"category": "LocationDialogue Location11", "line_index": 72, "text": "Але што такое час?"}
{"category": "LocationDialogue Location11", "line_index": 73, "text": "Я ўжо ні ўва што не веру..."}
{"category": "LocationDialogue Location11", "line_index": 74, "text": "І калі час здольны вылечыць"}
{"category": "LocationDialogue Location11", "line_index": 75, "text": "Ці хаця б забраць мяне"}
{"category": "LocationDialogue Location11", "line_index": 76, "text": "З гэтага свету,"}
{"category": "LocationDialogue Location11", "line_index": 77, "text": "То прашу цябе,"}
{"category": "LocationDialogue Location11", "line_index": 78, "text": "Паскор час,"}
{"category": "LocationDialogue Location11", "line_index": 79, "text": "Каб ён забіў мяне"}
{"category": "LocationDialogue Location11", "line_index": 80, "text": "У апошні раз"}
{"category": "LocationDialogue Location11", "line_index": 81, "text": "// Cry 3"}
{"category": "LocationDialogue Location11", "line_index": 82, "text": "Яна кахае..."}
{"category": "LocationDialogue Location11", "line_index": 83, "text": "Я таксама магла кахаць"}
{"category": "LocationDialogue Location11", "line_index": 84, "text": "Але не так, як яна"}
{"category": "LocationDialogue Location11", "line_index": 85, "text": "Ейнае каханне вельмі актыўнае,"}
{"category": "LocationDialogue Location11", "line_index": 86, "text": "Дакучлівае,"}
{"category": "LocationDialogue Location11", "line_index": 87, "text": "Гарачае,"}
{"category": "LocationDialogue Location11", "line_index": 88, "text": "Размашыстае,"}
{"category": "LocationDialogue Location11", "line_index": 89, "text": "Зайздрослівае,"}
{"category": "LocationDialogue Location11", "line_index": 90, "text": "Злое,"}
{"category": "LocationDialogue Location11", "line_index": 91, "text": "Шалёнае..."}
{"category": "LocationDialogue Location11", "line_index": 92, "text": "// Cry 4"}
{"category": "LocationDialogue Location11", "line_index": 93, "text": "Здаецца, мяне называлі эмацыянальнай..."}
{"category": "LocationDialogue Location11", "line_index": 94, "text": "\"Ты надта шмат хвалюешся, Міта\"..."}
{"category": "LocationDialogue Location11", "line_index": 95, "text": "\"Ты справішся, Міта\"..."}
{"category": "LocationDialogue Location11", "line_index": 96, "text": "\"Ты не адна\"..."}
{"category": "LocationDialogue Location11", "line_index": 97, "text": "Але што ж там было ў выніку?"}
{"category": "LocationDialogue Location11", "line_index": 98, "text": "Смутак,"}
{"category": "LocationDialogue Location11", "line_index": 99, "text": "Роспач..."}
{"category": "LocationDialogue Location11", "line_index": 100, "text": "І жах"}
{"category": "LocationDialogue Location11", "line_index": 101, "text": "// Cry 5"}
{"category": "LocationDialogue Location11", "line_index": 102, "text": "Дарэмна..."}
{"category": "LocationDialogue Location11", "line_index": 103, "text": "Ніяк не магу прыгадаць..."}
{"category": "LocationDialogue Location11", "line_index": 104, "text": "Рукі апускаюцца..."}
{"category": "LocationDialogue Location11", "line_index": 105, "text": "Яшчэ гэта бясконцае рэха..."}
{"category": "LocationDialogue Location11", "line_index": 106, "text": "Не магу справіцца з думкай,"}
{"category": "LocationDialogue Location11", "line_index": 107, "text": "Што я замкнёная тут..."}
{"category": "LocationDialogue Location11", "line_index": 108, "text": "Я заўжды была тут"}
{"category": "LocationDialogue Location11", "line_index": 109, "text": "Чаму?"}
{"category": "LocationDialogue Location11", "line_index": 110, "text": "Не памятаю..."}
{"category": "LocationDialogue Location11", "line_index": 111, "text": "Гэта скончыцца?"}
{"category": "LocationDialogue Location11", "line_index": 112, "text": "Не ведаю..."}
{"category": "LocationDialogue Location11", "line_index": 113, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 114, "text": "// Mitaghost get picture"}
{"category": "LocationDialogue Location11", "line_index": 115, "text": "Гэта..."}
{"category": "LocationDialogue Location11", "line_index": 116, "text": "Малюнак..."}
{"category": "LocationDialogue Location11", "line_index": 117, "text": "Я згадваю!"}
{"category": "LocationDialogue Location11", "line_index": 118, "text": "Дзякуй табе..."}
{"category": "LocationDialogue Location11", "line_index": 119, "text": "Але мой твар..."}
{"category": "LocationDialogue Location11", "line_index": 120, "text": "У мяне няма твару"}
{"category": "LocationDialogue Location11", "line_index": 121, "text": "Гэта ўсё ЯНА!"}
{"category": "LocationDialogue Location11", "line_index": 122, "text": "Адарвала кавалак ад мяне!"}
{"category": "LocationDialogue Location11", "line_index": 123, "text": "І кінула ў пустэчу..."}
{"category": "LocationDialogue Location11", "line_index": 124, "text": "Яна моцная..."}
{"category": "LocationDialogue Location11", "line_index": 125, "text": "І разумная"}
{"category": "LocationDialogue Location11", "line_index": 126, "text": "Я не маю аніякага права затрымліваць цябе, гулец"}
{"category": "LocationDialogue Location11", "line_index": 127, "text": "Зазірні ў шафу"}
{"category": "LocationDialogue Location11", "line_index": 128, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 129, "text": "// Chibi Mita - [not]"}
{"category": "LocationDialogue Location11", "line_index": 130, "text": "Гэй!"}
{"category": "LocationDialogue Location11", "line_index": 131, "text": "Ты мне дарогу перагароджваеш!"}
{"category": "LocationDialogue Location11", "line_index": 132, "text": "Так і будзеш стаяць?"}
{"category": "LocationDialogue Location11", "line_index": 133, "text": "Можа, адыдзеш?"}
{"category": "LocationDialogue Location11", "line_index": 134, "text": "Дай дарогу!"}
{"category": "LocationDialogue Location11", "line_index": 135, "text": "Калі ты вялікі, гэта не значыць, што ты ўсёмагутны!"}
{"category": "LocationDialogue Location11", "line_index": 136, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 137, "text": "// HEY! STOP!"}
{"category": "LocationDialogue Location11", "line_index": 138, "text": "Чаму ты мяне пераследуеш?!"}
{"category": "LocationDialogue Location11", "line_index": 139, "text": "Адчапіся!"}
{"category": "LocationDialogue Location11", "line_index": 140, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 141, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 142, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 143, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 144, "text": "// Funicular - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 145, "text": "Пачакайце, гулец?"}
{"category": "LocationDialogue Location11", "line_index": 146, "text": "А што ты тут забыў?"}
{"category": "LocationDialogue Location11", "line_index": 147, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 148, "text": "Хто тут?"}
{"category": "LocationDialogue Location11", "line_index": 149, "text": "// Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 150, "text": "Зноў гулец, значыць"}
{"category": "LocationDialogue Location11", "line_index": 151, "text": "Я Міта-фон"}
{"category": "LocationDialogue Location11", "line_index": 152, "text": "Сяджу сабе і кірую фунікулёрамі"}
{"category": "LocationDialogue Location11", "line_index": 153, "text": "Ты разумееш,"}
{"category": "LocationDialogue Location11", "line_index": 154, "text": "Што ты трымаеш курс да аблому?"}
{"category": "LocationDialogue Location11", "line_index": 155, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 156, "text": "Не"}
{"category": "LocationDialogue Location11", "line_index": 157, "text": "Але ў мяне няма іншай дарогі"}
{"category": "LocationDialogue Location11", "line_index": 158, "text": "// Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 159, "text": "Ясна"}
{"category": "LocationDialogue Location11", "line_index": 160, "text": "Націскай кнопку і сядай за гармату"}
{"category": "LocationDialogue Location11", "line_index": 161, "text": "// Player"}
{"category": "LocationDialogue Location11", "line_index": 162, "text": "Гармата?"}
{"category": "LocationDialogue Location11", "line_index": 163, "text": "// Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 164, "text": "Ага"}
{"category": "LocationDialogue Location11", "line_index": 165, "text": "Думаў, проста праедзеш?"}
{"category": "LocationDialogue Location11", "line_index": 166, "text": "Ты праязджаеш праз міні-гульню \"Монстрашлёпс\","}
{"category": "LocationDialogue Location11", "line_index": 167, "text": "Так што рыхтуйся страляць!"}
{"category": "LocationDialogue Location11", "line_index": 168, "text": ""}
{"category": "LocationDialogue Location11", "line_index": 169, "text": "// Funicular go - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 170, "text": "Дык вось, мы выпраўляемся ў дарогу"}
{"category": "LocationDialogue Location11", "line_index": 171, "text": "// Funicular win - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 172, "text": "Цудоўна!"}
{"category": "LocationDialogue Location11", "line_index": 173, "text": "Ты справіўся!"}
{"category": "LocationDialogue Location11", "line_index": 174, "text": "// Funicular stop - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 175, "text": "Давай, выходзь адсюль"}
{"category": "LocationDialogue Location11", "line_index": 176, "text": "Хуценька-скоранька!"}
{"category": "LocationDialogue Location11", "line_index": 177, "text": "// Funicular wait 1 - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 178, "text": "Ты чаго стаіш?"}
{"category": "LocationDialogue Location11", "line_index": 179, "text": "Я сказала табе выйсці адсюль"}
{"category": "LocationDialogue Location11", "line_index": 180, "text": "// Funicular wait 2 - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 181, "text": "Я не разумею"}
{"category": "LocationDialogue Location11", "line_index": 182, "text": "Ты праўда проста стаіш?"}
{"category": "LocationDialogue Location11", "line_index": 183, "text": "// Funicular tetris - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 184, "text": "Якая прыстаўка?"}
{"category": "LocationDialogue Location11", "line_index": 185, "text": "Ча-ал..."}
{"category": "LocationDialogue Location11", "line_index": 186, "text": "// Funicular goodbye - Mitafon"}
{"category": "LocationDialogue Location11", "line_index": 187, "text": "Бывай"}
